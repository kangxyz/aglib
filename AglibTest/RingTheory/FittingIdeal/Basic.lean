module

public import Aglib.RingTheory.FittingIdeal.BaseChange

/-! Focused consumer of the Fitting-ideal foundation (Picard plan row F12; Stacks Project,
Tags 07Z7–07ZB): minor ideals, the presentation-free Fitting ideals `Module.fittingIdeal`, their
basic properties and base change. -/

@[expose] public section

open TensorProduct

section

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]

/-- Independence of the presentation (Stacks 07Z8), for an arbitrary finite index type. -/
example {ι : Type*} [Finite ι] {f : (ι → R) →ₗ[R] M} (hf : Function.Surjective f) (k : ℕ) :
    Module.fittingIdeal R M k = (LinearMap.ker f).minorIdeal (Nat.card ι - k) :=
  Module.fittingIdeal_eq_minorIdeal_ker hf k

/-- Matrix form, with an arbitrary type `J` of relations (Stacks 07Z8, 07Z9). -/
example {ι J : Type*} [Finite ι] {f : (ι → R) →ₗ[R] M} (hf : Function.Surjective f)
    {A : Matrix ι J R} (hA : Submodule.span R (Set.range A.transpose) = LinearMap.ker f)
    (k : ℕ) : Module.fittingIdeal R M k = A.minorIdeal (Nat.card ι - k) :=
  Module.fittingIdeal_eq_minorIdeal hf hA k

example (k : ℕ) : Module.fittingIdeal R M k ≤ Module.fittingIdeal R M (k + 1) :=
  Module.fittingIdeal_le_succ k

/-- Generated by `k` elements gives `Fitt_k = R` (Stacks 07ZA (1)). -/
example {v : Fin 3 → M} (hv : Submodule.span R (Set.range v) = ⊤) :
    Module.fittingIdeal R M 3 = ⊤ :=
  Module.fittingIdeal_eq_top_of_span_eq_top hv (by simp)

example : Module.fittingIdeal R M 0 ≤ Module.annihilator R M :=
  Module.fittingIdeal_zero_le_annihilator

example {n : ℕ} {v : Fin n → M} (hv : Submodule.span R (Set.range v) = ⊤) :
    Module.annihilator R M ^ n ≤ Module.fittingIdeal R M 0 :=
  Module.annihilator_pow_le_fittingIdeal_zero hv

example {N : Type*} [AddCommGroup N] [Module R N] (e : M ≃ₗ[R] N) (k : ℕ) :
    Module.fittingIdeal R M k = Module.fittingIdeal R N k :=
  Module.fittingIdeal_congr e k

/-- Base change (Stacks 07ZA (3)). -/
example [Module.Finite R M] (S : Type*) [CommRing S] [Algebra R S] (k : ℕ) :
    Module.fittingIdeal S (S ⊗[R] M) k = (Module.fittingIdeal R M k).map (algebraMap R S) :=
  Module.fittingIdeal_baseChange S k

/-- Localization at a submonoid. -/
example [Module.Finite R M] (p : Submonoid R) (k : ℕ) :
    Module.fittingIdeal (Localization p) (LocalizedModule p M) k =
      (Module.fittingIdeal R M k).map (algebraMap R (Localization p)) :=
  Module.fittingIdeal_of_isLocalizedModule p (LocalizedModule.mkLinearMap p M) k

end

/-- `Fitt_1(ℤ²) = 0` and `Fitt_2(ℤ²) = ℤ` (Stacks 07ZB). -/
example : Module.fittingIdeal ℤ (Fin 2 → ℤ) 1 = ⊥ := by
  rw [Module.fittingIdeal_pi]
  simp

example : Module.fittingIdeal ℤ (Fin 2 → ℤ) 2 = ⊤ := by
  rw [Module.fittingIdeal_pi]
  simp

/-- `Fitt_0(ℤ/6) = (6)` (Stacks 07ZA (8)). -/
example : Module.fittingIdeal ℤ (ℤ ⧸ Ideal.span {(6 : ℤ)}) 0 = Ideal.span {6} :=
  Module.fittingIdeal_zero_quotient _

