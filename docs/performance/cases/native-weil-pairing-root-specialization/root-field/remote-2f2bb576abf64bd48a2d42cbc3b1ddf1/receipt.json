    "\nfrom pathlib import Path\nimport base64, hashlib, json, os, re, subprocess, sys\nmodule, source_digest, baseline_sha, candidate_sha, payload = sys.argv[1:]\nsource = Path(module.replace(\".\", \"/\") + \".lean\")\nsource_bytes = source.read_bytes()\nassert hashlib.sha256(source_bytes).hexdigest() == baseline_sha\nmanifest = json.loads((Path.cwd().parent / \"SOURCE.json\").read_bytes())\nassert manifest[\"content_sha256\"] == source_digest\ncandidate = base64.b64decode(payload, validate=True)\nassert hashlib.sha256(candidate).hexdigest() == candidate_sha\nimports = rb\"^(?:public |private |meta )*import .+$\"\nassert re.findall(imports, candidate, re.M) == re.findall(imports, source_bytes, re.M)\nroot = Path(os.environ[\"LEAN\"]).parents[2]\nscratch = root / \"root-field-native-groups\"\nscratch.mkdir()\nprobe = scratch / source.name\nprobe.write_bytes(candidate)\np = subprocess.run([os.environ[\"LAKE\"], \"--no-build\", \"setup-file\", str(source)],\n                   capture_output=True, text=True)\nif p.returncode:\n    print(p.stdout, p.stderr, flush=True)\n    raise SystemExit(p.returncode)\nsetup = json.loads(p.stdout)\nassert setup[\"name\"] == module and setup.get(\"isModule\") is True\nconfig = scratch / \"setup.json\"\nconfig.write_text(p.stdout)\nprint(json.dumps({\"candidate_sha256\": candidate_sha,\n                  \"setup_sha256\": hashlib.sha256(config.read_bytes()).hexdigest(),\n                  \"sealed_basis\": source_digest, \"baseline_sha256\": baseline_sha,\n                  \"native_options\": setup.get(\"options\")}), flush=True)\nproc = subprocess.run([os.environ[\"LAKE\"], \"env\", os.environ[\"LEAN\"], \"--setup\", str(config), str(probe)])\nassert source.read_bytes() == source_bytes\nraise SystemExit(proc.returncode)\n",
