+/-- The original native comparison, with its whole construction shared before specialization. -/
+def Construction.compInverseComparison (e : B ≌ D) {S : A ⥤ B} {T : A ⥤ D}
+    (α : S ⋙ e.functor ≅ T) : T ⋙ e.inverse ≅ S :=
+  Iso.compInverseIso (H := e) α.symm
+
+/-- The original inverse map followed by the original unit inverse. -/
+theorem Construction.compInverseComparison_hom_app (e : B ≌ D)
+    {S : A ⥤ B} {T : A ⥤ D} (α : S ⋙ e.functor ≅ T) (X : A) :
+    (Construction.compInverseComparison e α).hom.app X =
+      e.inverse.map (α.inv.app X) ≫ e.unitIso.inv.app (S.obj X) := by
+  simp [Construction.compInverseComparison, Iso.compInverseIso]
+
+/-- The whole counit equation of this same native comparison. -/
+def Construction.CompInverseCounitEq (e : B ≌ D)
+    {S : A ⥤ B} {T : A ⥤ D} (α : S ⋙ e.functor ≅ T) (X : A) : Prop :=
+  e.functor.map ((Construction.compInverseComparison e α).hom.app X) ≫ α.hom.app X =
+    e.counitIso.hom.app (T.obj X)
+
+/-- Counit naturality proves the whole comparison law before any concrete fibre is selected. -/
+theorem Construction.compInverseComparison_counit (e : B ≌ D)
+    {S : A ⥤ B} {T : A ⥤ D} (α : S ⋙ e.functor ≅ T) (X : A) :
+    Construction.CompInverseCounitEq e α X := by
+  change e.functor.map ((Construction.compInverseComparison e α).hom.app X) ≫
+    α.hom.app X = e.counitIso.hom.app (T.obj X)
+  rw [Construction.compInverseComparison_hom_app, e.functor.map_comp,
+    ← e.counit_app_functor (S.obj X)]
+  have hn : e.functor.map (e.inverse.map (α.inv.app X)) ≫
+      e.counitIso.hom.app (e.functor.obj (S.obj X)) =
+    e.counitIso.hom.app (T.obj X) ≫ α.inv.app X :=
+    e.counitIso.hom.naturality (α.inv.app X)
+  calc
+    _ = (e.counitIso.hom.app (T.obj X) ≫ α.inv.app X) ≫ α.hom.app X :=
+      congrArg (fun k => k ≫ α.hom.app X) hn
+    _ = e.counitIso.hom.app (T.obj X) ≫ (α.inv.app X ≫ α.hom.app X) :=
+      Category.assoc _ _ _
+    _ = e.counitIso.hom.app (T.obj X) ≫ 𝟙 (T.obj X) :=
+      congrArg (fun k => e.counitIso.hom.app (T.obj X) ≫ k) (α.inv_hom_id_app X)
+    _ = _ := Category.comp_id _
+
+/-- Normalize the actual product-comonad structure map as a whole morphism. -/
+theorem Construction.star_obj_hom_fst [HasBinaryProducts B] (P H : B) :
+    ((Over.star P).obj H).hom = (prod.fst : P ⨯ H ⟶ P) := by
+  rw [Over.star_obj_hom]
+  exact prod.lift_fst _ _
+
+/-- Coefficient naturality keeps the actual product-over-P map and projection. -/
+theorem Construction.star_map_snd [HasBinaryProducts B] (P : B)
+    {H H' : B} (f : H ⟶ H') :
+    ((Over.star P).map f).left ≫ (prod.snd : P ⨯ H' ⟶ H') =
+      (prod.snd : P ⨯ H ⟶ H) ≫ f := by
+  rw [Over.star_map_left]
+  exact prod.map_snd _ _
+
+end ComparisonConstruction
 
