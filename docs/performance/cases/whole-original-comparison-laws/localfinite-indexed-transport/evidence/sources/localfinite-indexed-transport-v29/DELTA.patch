+/-- Derive and consume the original indexed source transport inside the generic
+comparison factory. The native inputs contain only the original composition law
+at the equal target index; the transported source equation is not a parameter. -/
+theorem originalExtSourceComparison_bijective_of_transport_values
+    {I : Type uIndex} (K : I → C₀ ⥤ C₃)
+    {i j : I} (h : i = j)
+    [(K i).Additive] [PreservesFiniteLimits (K i)] [PreservesFiniteColimits (K i)]
+    (c₀ : K i ≅ G ⋙ L') (d₁ : K j ≅ L ⋙ H)
+    (s : (k : I) → U₃ ⟶ (K k).obj U₀)
+    (hleft : s i ≫ c₀.hom.app U₀ = e'.inv ≫ L'.map sG)
+    (hright : s j ≫ d₁.hom.app U₀ = sH ≫ H.map e.inv)
+    (β : R ⋙ G ⟶ H ⋙ R')
+    (hβ : β = (mateEquiv adj adj'
+      (TwoSquare.mk G L L' H (c₀.symm ≪≫ eqToIso (congrArg K h) ≪≫ d₁).hom)).natTrans)
+    (pG : (N : C₀) → (n : ℕ) → Ext.{e₀} U₀ N n →+ Ext.{e₂} U₂ (G.obj N) n)
+    (hpG : pG = fun N n => G.extPrecompMap sG N n)
+    (pH : (M : C₁) → (n : ℕ) → Ext.{e₁} U₁ M n →+ Ext.{e₃} U₃ (H.obj M) n)
+    (hpH : pH = fun M n => H.extPrecompMap sH M n)
+    (M : C₁) (n : ℕ) [IsIso (β.app M)]
+    (hG : Function.Bijective (pG (R.obj M) n)) :
+    Function.Bijective (pH M n) := by
+  have ht : s i ≫ (eqToIso (congrArg K h) ≪≫ d₁).hom.app U₀ =
+      sH ≫ H.map e.inv := by
+    cases h
+    simpa only [eqToIso_refl, Iso.refl_trans] using hright
+  exact originalExtSourceComparison_bijective_of_mate_values adj adj' G H e e'
+    (K i) c₀ (eqToIso (congrArg K h) ≪≫ d₁) sG sH (s i) hleft ht
+    β hβ pG hpG pH hpH M n hG
+
 end CategoryTheory.Adjunction
