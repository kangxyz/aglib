+    "instWEqualsLocallyBijectiveOfHasWeakSheafifyOfHasSheafComposeOfPreserves\
+      SheafificationOfReflectsIsomorphismsForget"
+  let standardCount ← IO.mkRef (0 : Nat)
+  let genericCount ← IO.mkRef (0 : Nat)
