-private theorem moduleExchange_isIso_of_torsion_homology
-    [HasDerivedCategory.{wAX} (AbelianSheaf.{u, u + 1} X)]
-    [HasDerivedCategory.{wAS} (AbelianSheaf.{u, u + 1} S)]
-    [HasDerivedCategory.{wAX'} (AbelianSheaf.{u, u + 1} X')]
