']),'style_source_vector_sha256':p['source_vector_sha256'],'commands':results,'style_binary_sha256':bh,'boundary':'Actual existing native source predicates only. No production frontend/client/kernel/tests/replay or source writes. Success is reused in the one final1714 environment, not repeated.'};(run/'PUB1714-STYLE-ONE.json').write_text(json.dumps(result,indent=2)+'\\n');sys.exit(0 if all(x['exit']==0 for x in results)else 1)\n",
