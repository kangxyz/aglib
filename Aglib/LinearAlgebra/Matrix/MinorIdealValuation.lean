module

public import Aglib.RingTheory.FittingIdeal.Minors
public import Mathlib.RingTheory.DiscreteValuationRing.Basic
public import Mathlib.Order.WellFounded

/-! # A minor attaining the order of a nonzero minor ideal

Well-ordering of the native DVR valuation selects an element of an arbitrary generating
set which generates its whole nonzero ideal. Applied to determinants, this constructs
an actual minor attaining the ideal order without assuming a finite relation family.
-/

@[expose] public section

variable {R : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]

namespace IsDiscreteValuationRing

/-- A nonzero ideal generated by any set in a DVR is generated by an element of that set. -/
theorem exists_mem_span_singleton_eq (s : Set R) (h : Ideal.span s ≠ ⊥) :
    ∃ x ∈ s, x ≠ 0 ∧ Ideal.span {x} = Ideal.span s := by
  have hs : s.Nonempty := by
    by_contra hs
    apply h
    rw [Set.not_nonempty_iff_eq_empty.mp hs]
    exact Ideal.span_empty
  obtain ⟨v, ⟨x, hx, rfl⟩, hmin⟩ :=
    wellFounded_lt.has_min ((addVal R) '' s) (hs.image (addVal R))
  have hspan : Ideal.span {x} = Ideal.span s := by
    apply le_antisymm ((Ideal.span_singleton_le_iff_mem _).mpr (Ideal.subset_span hx))
    apply Ideal.span_le.mpr
    intro y hy
    apply Ideal.mem_span_singleton.mpr
    apply addVal_le_iff_dvd.mp
    exact le_of_not_gt (hmin _ ⟨y, hy, rfl⟩)
  refine ⟨x, hx, ?_, hspan⟩
  intro hxzero
  apply h
  rw [← hspan, hxzero]
  exact Ideal.span_singleton_zero

end IsDiscreteValuationRing

namespace Matrix

/-- A nonzero minor ideal over a DVR is generated by an actual nonzero selected minor. -/
theorem exists_minor_span_singleton_eq {m n : Type*} (A : Matrix m n R) (r : ℕ)
    (h : A.minorIdeal r ≠ ⊥) :
    ∃ (e : Fin r → m) (c : Fin r → n),
      (A.submatrix e c).det ≠ 0 ∧ Ideal.span {(A.submatrix e c).det} = A.minorIdeal r := by
  obtain ⟨x, ⟨e, c, rfl⟩, hx, hspan⟩ :=
    IsDiscreteValuationRing.exists_mem_span_singleton_eq
      {x | ∃ (e : Fin r → m) (c : Fin r → n), (A.submatrix e c).det = x} h
  exact ⟨e, c, hx, hspan⟩

end Matrix
