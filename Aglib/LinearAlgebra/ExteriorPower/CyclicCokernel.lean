module

public import Mathlib.LinearAlgebra.ExteriorPower.Basic

/-!
# Exterior images with a cyclic annihilated cokernel

Let `f : P →ₗ[R] Q`. If the quotient by its image is generated by the class
of `q`, and `π • q` is in that image, multiplication by `π` carries every
native exterior power of `Q` into the image of the original exterior map.

The proof uses wedges of entries in `range f ∪ {q}`. Repeated copies of `q`
vanish by alternation, and a single copy absorbs `π`. This includes the
empty wedge and characteristic two. No finite-generation, freeness, or
torsion-free assumption is imposed on either module.
-/

@[expose] public section

universe u v w

namespace exteriorPower

variable {R : Type u} [CommRing R]
  {P : Type v} {Q : Type w}
  [AddCommGroup P] [Module R P] [AddCommGroup Q] [Module R Q]

/-- A wedge of original image elements belongs to the range of the native exterior map. -/
theorem ιMulti_mem_range_map_of_forall_mem_range (f : P →ₗ[R] Q) (n : ℕ)
    (v : Fin n → Q) (hv : ∀ i, v i ∈ LinearMap.range f) :
    ιMulti R n v ∈ LinearMap.range (map n f) := by
  classical
  have hp : ∀ i, ∃ p : P, f p = v i := hv
  choose p hp using hp
  refine ⟨ιMulti R n p, ?_⟩
  rw [map_apply_ιMulti]
  exact congrArg (ιMulti R n) (funext hp)

/-- On a wedge of image elements and one possible extra generator, its annihilator
in the original quotient suffices. Two occurrences of the extra generator vanish. -/
theorem smul_ιMulti_mem_range_map_of_mem_or_eq (f : P →ₗ[R] Q) (q : Q) (π : R)
    (hπ : π • q ∈ LinearMap.range f) (n : ℕ) (v : Fin n → Q)
    (hv : ∀ i, v i ∈ LinearMap.range f ∨ v i = q) :
    π • ιMulti R n v ∈ LinearMap.range (map n f) := by
  classical
  by_cases hall : ∀ i, v i ∈ LinearMap.range f
  · exact (LinearMap.range (map n f)).smul_mem π
      (ιMulti_mem_range_map_of_forall_mem_range f n v hall)
  obtain ⟨i, hi⟩ := not_forall.mp hall
  have hvi : v i = q := (hv i).resolve_left hi
  by_cases htwo : ∃ j, j ≠ i ∧ v j ∉ LinearMap.range f
  · obtain ⟨j, hji, hj⟩ := htwo
    have hvj : v j = q := (hv j).resolve_left hj
    have hz : ιMulti R n v = 0 :=
      (ιMulti R n).map_eq_zero_of_eq v (hvi.trans hvj.symm) hji.symm
    rw [hz, smul_zero]
    exact (LinearMap.range (map n f)).zero_mem
  · have hupdate : ∀ j, Function.update v i (π • v i) j ∈ LinearMap.range f := by
      intro j
      by_cases hji : j = i
      · subst j
        rw [Function.update_self, hvi]
        exact hπ
      · rw [Function.update_of_ne hji]
        by_contra hj
        exact htwo ⟨j, hji, hj⟩
    have hmem := ιMulti_mem_range_map_of_forall_mem_range f n
      (Function.update v i (π • v i)) hupdate
    simpa only [AlternatingMap.map_update_smul, Function.update_eq_self] using hmem

/-- If the original cokernel is generated by one class killed by `π`, then `π`
carries every native exterior power into the image of the original exterior map.
The statement includes degree zero and arbitrary modules over a commutative ring. -/
theorem smul_mem_range_map_of_cyclic_cokernel (f : P →ₗ[R] Q) (q : Q) (π : R)
    (hgen : ∀ v : Q, ∃ p : P, ∃ a : R, v = f p + a • q)
    (hπ : π • q ∈ LinearMap.range f) (n : ℕ) (α : ⋀[R]^n Q) :
    π • α ∈ LinearMap.range (map n f) := by
  classical
  let s : Set Q := (LinearMap.range f : Set Q) ∪ {q}
  have hs : Submodule.span R s = ⊤ := by
    apply top_unique
    intro v _
    obtain ⟨p, a, hv⟩ := hgen v
    rw [hv]
    apply Submodule.add_mem
    · exact Submodule.subset_span (Or.inl ⟨p, rfl⟩)
    · exact Submodule.smul_mem _ a (Submodule.subset_span (Or.inr rfl))
  have hα : α ∈ Submodule.span R
      (ιMulti R n '' {v : Fin n → Q | Set.range v ⊆ s}) := by
    rw [ιMulti_span_of_span R n Q hs]
    trivial
  induction hα using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨v, hv, rfl⟩ := hz
    apply smul_ιMulti_mem_range_map_of_mem_or_eq f q π hπ n v
    intro i
    have hi : v i ∈ s := hv ⟨i, rfl⟩
    exact hi
  | zero =>
    simpa only [smul_zero] using (LinearMap.range (map n f)).zero_mem
  | add a b _ _ ha hb =>
    rw [smul_add]
    exact (LinearMap.range (map n f)).add_mem ha hb
  | smul a z _ hz =>
    rw [smul_comm π a z]
    exact (LinearMap.range (map n f)).smul_mem a hz

end exteriorPower
