module

public import Aglib.AlgebraicGeometry.Curves.Picard.DivisorInverse
public import Aglib.AlgebraicGeometry.Curves.Picard.Degree.ProperCurveProductFormula

/-! # Actual degree-zero Picard classes are generated by point differences

Use the native divisor/Picard equivalence and the proved proper product formula.
Over algebraically closed constants every closed-point weight is one. No
representability, divisibility, or cohomological finiteness premise is added.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace
open AlgebraicGeometry.Scheme.Modules.Invertible
open AlgebraicGeometry.Scheme.OverField.Curve.Divisors

universe u

namespace AlgebraicGeometry.Scheme.OverField.Curve.Picard

variable (X : Scheme.{u}) [IsIntegral X] [IsNoetherian X]
  [∀ x : ClosedPoint X, IsDiscreteValuationRing (X.presheaf.stalk x.val)]

/-- Additivity of the actual divisor-to-line-bundle map on its original finite support. -/
theorem divisorToPicard_eq_sum_points (hdim : topologicalKrullDim X ≤ 1) (D : Divisor X) :
    DivisorClass.divisorToPicard X hdim D =
      ∑ x ∈ D.support, D x • DivisorClass.divisorToPicard X hdim (Finsupp.single x 1) := by
  classical
  let r := DivisorClass.divisorToPicard X hdim
  calc
    r D = r (D.sum Finsupp.single) := congrArg r (Finsupp.sum_single D).symm
    _ = ∑ x ∈ D.support, D x • r (Finsupp.single x 1) := by
      rw [Finsupp.sum, map_sum]
      apply Finset.sum_congr rfl
      intro x hx
      rw [← map_zsmul]
      congr 1
      simp [Finsupp.smul_single]

/-- Every actual degree-zero Picard class is a finite sum of differences of
closed-point divisor classes from a fixed closed point. -/
theorem exists_sum_pointDifferences_of_picardDegree_eq_zero
    {k : Type u} [Field k] [IsAlgClosed k] (p : X ⟶ Spec (.of k)) [IsProper p]
    (hdim : topologicalKrullDim X = 1) (o : ClosedPoint X) (L : PicardGroup X)
    (hL : Degree.picardDegree X p hdim.le
      (Degree.properCurveProductFormula k X p hdim) L = 0) :
    ∃ D : Divisor X,
      L = ∑ x ∈ D.support, D x •
        (DivisorClass.divisorToPicard X hdim.le (Finsupp.single x 1) -
          DivisorClass.divisorToPicard X hdim.le (Finsupp.single o 1)) := by
  classical
  obtain ⟨a, ha⟩ := DivisorClass.divisorClassToPicard_surjective X hdim.le L
  obtain ⟨D, rfl⟩ := Quotient.exists_rep a
  have hD : DivisorClass.divisorToPicard X hdim.le D = L := ha
  have hdeg : Degree.degDiv X p D = 0 := by
    calc
      Degree.degDiv X p D =
          Degree.picardDegree X p hdim.le
            (Degree.properCurveProductFormula k X p hdim)
            (DivisorClass.divisorToPicard X hdim.le D) :=
        (Degree.picardDegree_divisor X p hdim.le
          (Degree.properCurveProductFormula k X p hdim) D).symm
      _ = 0 := (congrArg
        (Degree.picardDegree X p hdim.le (Degree.properCurveProductFormula k X p hdim))
        hD).trans hL
  have hsum : ∑ x ∈ D.support, D x = 0 := by
    simpa only [Degree.degDiv_apply, Degree.weight_eq_one, mul_one] using hdeg
  refine ⟨D, ?_⟩
  rw [← hD, divisorToPicard_eq_sum_points X hdim.le D]
  simp only [smul_sub, Finset.sum_sub_distrib, ← Finset.sum_smul, hsum, zero_smul, sub_zero]

end AlgebraicGeometry.Scheme.OverField.Curve.Picard
