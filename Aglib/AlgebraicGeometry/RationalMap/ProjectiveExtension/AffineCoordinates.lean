module

public import Aglib.AlgebraicGeometry.RationalMap.ProjectiveExtension.Basic
public import Aglib.AlgebraicGeometry.Blowup.IdealFrames
public import Aglib.AlgebraicGeometry.Modules.QuasiCoherent.Affine.Free.Sections
public import Mathlib.LinearAlgebra.Finsupp.LinearCombination

/-!
# The original affine coordinate row

Sheafification of the literal linear-combination map gives an epimorphic
row onto the ideal sheaf generated by the original ring coordinates. Its
inclusion equation retains multiplication by each original scalar.
-/

@[expose] public noncomputable section

set_option autoImplicit false
set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open CategoryTheory CategoryTheory.Limits
open AlgebraicGeometry.Scheme.Modules AlgebraicGeometry.Scheme.Modules.Invertible

universe u

namespace AlgebraicGeometry.Scheme.RationalCoordinates

variable (A : Type u) [CommRing A] {I : Type u} (v : I → A)

/-- The original ring coordinate ideal. -/
abbrev affineCoordinateIdeal : Ideal A := Ideal.span (Set.range v)

/-- Linear combination into its literal span ideal. -/
def affineCoordinateRow : (I →₀ A) →ₗ[A] affineCoordinateIdeal A v :=
  (Finsupp.linearCombination A v).codRestrict _ (fun l ↦ by
    change Finsupp.linearCombination A v l ∈ Submodule.span A (Set.range v)
    rw [← Finsupp.range_linearCombination]
    exact ⟨l, rfl⟩)

/-- Every element of the actual span is the image of the original row. -/
theorem affineCoordinateRow_surjective : Function.Surjective (affineCoordinateRow A v) := by
  intro x
  have hx : (x : A) ∈ LinearMap.range (Finsupp.linearCombination A v) := by
    rw [Finsupp.range_linearCombination]
    exact x.property
  obtain ⟨l, hl⟩ := hx
  exact ⟨l, Subtype.ext hl⟩

/-- The native ideal module of the affine quotient centre is the sheafification
of the same ring ideal, with the canonical kernel and image comparisons. -/
def affineCoordinateIdealIso :
    tilde (R := .of A) (ModuleCat.of A (affineCoordinateIdeal A v)) ≅
      Hom.idealModule (Blowup.affineCenter A (affineCoordinateIdeal A v)).subschemeι := by
  let J := affineCoordinateIdeal A v
  let q := Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))
  let : IsClosedImmersion q := IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
  exact (tilde.functor (.of A)).mapIso
      (LinearEquiv.ofEq _ _ (Ideal.mk_ker (I := J)).symm).toModuleIso ≪≫
    Hom.affineIdealIso (CommRingCat.ofHom (Ideal.Quotient.mk J)) ≪≫
    Blowup.IdealFrames.imageIdealIso q

/-- The affine ideal comparison keeps the literal subtype inclusion. -/
@[reassoc]
theorem affineCoordinateIdealIso_inclusion :
    (affineCoordinateIdealIso A v).hom ≫
      Hom.idealInclusion (Blowup.affineCenter A (affineCoordinateIdeal A v)).subschemeι =
        tilde.map (R := .of A) (ModuleCat.ofHom (affineCoordinateIdeal A v).subtype) := by
  let J := affineCoordinateIdeal A v
  let q := Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))
  let : IsClosedImmersion q := IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
  let e := (LinearEquiv.ofEq _ _ (Ideal.mk_ker (I := J)).symm).toModuleIso
  change (((tilde.functor (.of A)).mapIso e ≪≫
    Hom.affineIdealIso (CommRingCat.ofHom (Ideal.Quotient.mk J))) ≪≫
    Blowup.IdealFrames.imageIdealIso q).hom ≫ Hom.idealInclusion q.imageι = _
  simp only [Iso.trans_hom, Functor.mapIso_hom, Category.assoc]
  rw [Blowup.IdealFrames.imageIdealIso_hom_inclusion, Hom.affineIdealIso_hom_inclusion]
  change (tilde.functor (.of A)).map e.hom ≫
    (tilde.functor (.of A)).map (ModuleCat.ofHom (RingHom.ker (Ideal.Quotient.mk J)).subtype) = _
  rw [← Functor.map_comp]
  rfl

/-- The sheafified original row onto the actual closed-ideal module. -/
def affineCoordinateSheafRow : SheafOfModules.free I ⟶
    Hom.idealModule (Blowup.affineCenter A (affineCoordinateIdeal A v)).subschemeι :=
  (tildeFinsupp (R := .of A) I).inv ≫
    tilde.map (R := .of A) (ModuleCat.ofHom (affineCoordinateRow A v)) ≫
      (affineCoordinateIdealIso A v).hom

instance affineCoordinateSheafRow_epi : Epi (affineCoordinateSheafRow A v) := by
  let : (tilde.functor (.of A)).PreservesEpimorphisms :=
    Functor.preservesEpimorphisms_of_adjunction (tilde.adjunction (R := .of A))
  have : Epi (ModuleCat.ofHom (affineCoordinateRow A v)) :=
    (ModuleCat.epi_iff_surjective _).mpr (affineCoordinateRow_surjective A v)
  have : Epi (tilde.map (R := .of A) (ModuleCat.ofHom (affineCoordinateRow A v))) :=
    (tilde.functor (.of A)).map_epi _
  dsimp only [affineCoordinateSheafRow]
  infer_instance

/-- Each original affine coordinate, with the original index. -/
def affineCoordinate (i : I) : SheafOfModules.unit (Spec (.of A)).ringCatSheaf ⟶
    Hom.idealModule (Blowup.affineCenter A (affineCoordinateIdeal A v)).subschemeι :=
  SheafOfModules.ιFree i ≫ affineCoordinateSheafRow A v

instance affineCoordinate_epi : Epi (Sigma.desc (affineCoordinate A v)) := by
  have h : Sigma.desc (affineCoordinate A v) = affineCoordinateSheafRow A v := by
    apply Sigma.hom_ext
    intro i
    exact Sigma.ι_comp_desc (affineCoordinate A v) i
  rw [h]
  infer_instance

/-- Inclusion of the original section is multiplication by the same scalar. -/
@[reassoc]
theorem affineCoordinate_inclusion (i : I) :
    affineCoordinate A v i ≫
      Hom.idealInclusion (Blowup.affineCenter A (affineCoordinateIdeal A v)).subschemeι =
        tilde.map (R := .of A) (ModuleCat.ofHom (LinearMap.toSpanSingleton A A (v i))) := by
  simp only [affineCoordinate, affineCoordinateSheafRow, Category.assoc]
  rw [affineCoordinateIdealIso_inclusion]
  rw [← tildeFinsupp_hom_ιFree, Category.assoc, Iso.hom_inv_id_assoc,
    ← tilde.map_comp_assoc, ← tilde.map_comp]
  congr 1
  ext
  simp [affineCoordinateRow]

end AlgebraicGeometry.Scheme.RationalCoordinates
