/-!
# GeometricCoverModels

General constructions and comparisons for this native mathematical family.
-/

@[expose] public section

noncomputable section
set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite
open _root_.AlgebraicGeometry.Scheme.FiniteEtale (Fiber baseChange baseChangeComp)
open AlgebraicGeometry.Scheme.EtaleFundamentalGroups

namespace AlgebraicGeometry.Scheme.FiniteEtale.GeometricKernel

universe u
variable (K Ω : Type u) [Field K] [Field Ω] [Algebra K Ω] [Algebra.IsAlgebraic K Ω]
  {X : Scheme.{u}} (p : X ⟶ Spec (CommRingCat.of K))

/-- The separable closure of `K` inside the finite field stage generated by `s`. -/
abbrev finiteSepField (s : Finset Ω) := separableClosure K (FieldLimit.finiteField K Ω s)

/-- The point of the finite separable cover induced by its inclusion through the field stage
into `Ω`. -/
def finiteSepPoint (s : Finset Ω) :
    Fiber (Spec.algebraMap K Ω) (SeparableStage.finiteSeparableFieldCover K (finiteSepField K Ω
      s)) :=
  Over.homMk
    (Spec.map (CommRingCat.ofHom (FieldLimit.finiteField K Ω s).val.toRingHom) ≫
      Spec.algebraMap (finiteSepField K Ω s) (FieldLimit.finiteField K Ω s)) (by
      change (_ ≫ _) ≫ Spec.algebraMap K (finiteSepField K Ω s) = Spec.algebraMap K Ω
      rw [Category.assoc, SeparableStage.specTower]
      exact FieldLimit.fieldStructure_fac K Ω (op s))

/-- The projection from the geometric base change to the base change over the field stage
generated by `s`. -/
def standardStageProjection (s : Finset Ω) :
    pullback p (Spec.algebraMap K Ω) ⟶ pullback p (Spec.algebraMap K (FieldLimit.finiteField K Ω
      s)) :=
  FieldLimit.fieldProjection K Ω p (op s) ≫
    (pullbackSymmetry p (Spec.algebraMap K (FieldLimit.finiteField K Ω s))).inv

set_option linter.unusedSectionVars false in
-- Preserve the original auto-included hypotheses and binder order.
-- Keep the original supplied class/data inputs and binder order of this interface.
@[reassoc, nolint unusedArguments] theorem standardStageProjection_base (s : Finset Ω) :
    standardStageProjection K Ω p s ≫
      pullback.fst p (Spec.algebraMap K (FieldLimit.finiteField K Ω s)) =
      pullback.fst p (Spec.algebraMap K Ω) := by
  rw [standardStageProjection, Category.assoc, pullbackSymmetry_inv_comp_fst]
  exact FieldLimit.fieldProjection_base K Ω p (op s)

set_option linter.unusedSectionVars false in
-- Preserve the original auto-included hypotheses and binder order.
-- Keep the original supplied class/data inputs and binder order of this interface.
@[reassoc, nolint unusedArguments] theorem standardStageProjection_field (s : Finset Ω) :
    standardStageProjection K Ω p s ≫
      pullback.snd p (Spec.algebraMap K (FieldLimit.finiteField K Ω s)) =
      pullback.snd p (Spec.algebraMap K Ω) ≫
        Spec.map (CommRingCat.ofHom (FieldLimit.finiteField K Ω s).val.toRingHom) := by
  rw [standardStageProjection, Category.assoc, pullbackSymmetry_inv_comp_snd]
  exact FieldLimit.fieldProjection_field K Ω p (op s)

theorem geometricStage_sep_projection (s : Finset Ω) :
    geometricStageRight (Spec.algebraMap K Ω) p
        (SeparableStage.finiteSeparableFieldCover K (finiteSepField K Ω s)) (finiteSepPoint K Ω s) ≫
      (pullbackSymmetry (Spec.algebraMap K (finiteSepField K Ω s)) p).hom =
    standardStageProjection K Ω p s ≫
      SeparableStage.extensionProjection K (finiteSepField K Ω s) (FieldLimit.finiteField K Ω s)
        p := by
  apply pullback.hom_ext
  · rw [Category.assoc, pullbackSymmetry_hom_comp_fst]
    have hs : geometricStageRight (Spec.algebraMap K Ω) p
        (SeparableStage.finiteSeparableFieldCover K (finiteSepField K Ω s)) (finiteSepPoint K Ω s) ≫
        pullback.snd (Spec.algebraMap K (finiteSepField K Ω s)) p =
      pullback.fst p (Spec.algebraMap K Ω) := pullback.lift_snd _ _ _
    rw [hs, Category.assoc, SeparableStage.extensionProjection_base, standardStageProjection_base]
  · rw [Category.assoc, pullbackSymmetry_hom_comp_snd]
    have hf : geometricStageRight (Spec.algebraMap K Ω) p
        (SeparableStage.finiteSeparableFieldCover K (finiteSepField K Ω s)) (finiteSepPoint K Ω s) ≫
        pullback.fst (Spec.algebraMap K (finiteSepField K Ω s)) p =
      pullback.snd p (Spec.algebraMap K Ω) ≫
        (Spec.map (CommRingCat.ofHom (FieldLimit.finiteField K Ω s).val.toRingHom) ≫
          Spec.algebraMap (finiteSepField K Ω s) (FieldLimit.finiteField K Ω s)) :=
      pullback.lift_fst _ _ _
    rw [hf, Category.assoc, SeparableStage.extensionProjection_field,
      standardStageProjection_field_assoc]

variable [CompactSpace X] [QuasiSeparatedSpace X]

/-- Every actual geometric cover has an actual finite separable stage model.
The finite-field object producer and finite purely inseparable equivalence
are applied here, so there is no retained model-descent premise. -/
theorem exists_stageModel (Y : Scheme.FiniteEtale (pullback p (Spec.algebraMap K Ω))) :
    ∃ M : StageModel (Spec.algebraMap K Ω) p, Nonempty (M.obj (Spec.algebraMap K Ω) p ≅ Y) := by
  obtain ⟨s, Z, eZ⟩ := FieldCoverDescent.qcqsCoverDescent K Ω p Y
  let E := FieldLimit.finiteField K Ω s
  let S := finiteSepField K Ω s
  let eE := pullbackSymmetry p (Spec.algebraMap K E)
  let eS := pullbackSymmetry (Spec.algebraMap K S) p
  let Ystd := (baseChange eE.hom).obj Z
  let U := SeparableStage.maximalSeparableModel K E p Ystd
  let M : StageModel (Spec.algebraMap K Ω) p :=
    ⟨SeparableStage.finiteSeparableFieldCover K S, finiteSepPoint K Ω s, (baseChange eS.hom).obj U⟩
  let r := geometricStageRight (Spec.algebraMap K Ω) p M.base M.point
  let t := standardStageProjection K Ω p s
  let d := SeparableStage.extensionProjection K S E p
  have hr : r ≫ eS.hom = t ≫ d := geometricStage_sep_projection K Ω p s
  have ht : t ≫ eE.hom = FieldLimit.fieldProjection K Ω p (op s) := by
    change (_ ≫ eE.inv) ≫ eE.hom = _
    rw [Category.assoc, eE.inv_hom_id, Category.comp_id]
  refine ⟨M, ⟨?_⟩⟩
  exact ((baseChangeComp eS.hom r).app U).symm ≪≫
    eqToIso (congrArg (fun f ↦ (baseChange f).obj U) hr) ≪≫
    (baseChangeComp d t).app U ≪≫
    (baseChange t).mapIso (SeparableStage.maximalSeparableModelIso K E p Ystd) ≪≫
    ((baseChangeComp eE.hom t).app Z).symm ≪≫
    eqToIso (congrArg (fun f ↦ (baseChange f).obj Z) ht) ≪≫ eZ

/-- Injectivity of the SAME original geometric kernel map, with its actual
cover-extension premise now discharged on all qcqs schemes over all fields. -/
theorem geometricKernelHom_injective_actual
    (o : Spec (CommRingCat.of K) ⟶ X) (ho : o ≫ p = 𝟙 _) :
    Function.Injective (geometricKernelHom K p o ho) :=
  kernelHom_injective_of_stageModels (Spec.algebraMap K (AlgebraicClosure K)) p o ho
    (exists_stageModel K (AlgebraicClosure K) p)

end AlgebraicGeometry.Scheme.FiniteEtale.GeometricKernel

