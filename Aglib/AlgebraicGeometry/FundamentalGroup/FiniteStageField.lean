/-!
# FiniteStageField

General constructions and comparisons for this native mathematical family.
-/

@[expose] public section

noncomputable section
set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open AlgebraicGeometry.Scheme.FiniteEtale
open _root_.AlgebraicGeometry.Scheme.FiniteEtale (Fiber)
open AlgebraicGeometry.Scheme.EtaleFundamentalGroups
namespace AlgebraicGeometry.Scheme.FiniteEtale.GeometricKernel
universe u

section GeneralBase
variable {Ω : Type u} [Field Ω] {B X : Scheme.{u}}
  (b : Spec (CommRingCat.of Ω) ⟶ B) (p : X ⟶ B)
  (o : B ⟶ X) (ho : o ≫ p = 𝟙 B)
  (Z : Scheme.FiniteEtale B) (q : Fiber b Z)

@[reassoc] theorem stagePoint_to_base :
    stagePoint b p o ho Z q ≫ pullback.fst Z.obj.hom p = q.left := by
  dsimp only [stagePoint, stageCoverPoint]
  rw [pointedFiberEquiv_left (pointedProjection b p o ho) Z q]
  exact pullback.lift_fst _ _ _

/-- The pointed map from the geometric stage point to `q.left` induced by the first pullback
projection. -/
def stageToBase : Under.mk (stagePoint b p o ho Z q) ⟶ Under.mk q.left :=
  Under.homMk (pullback.fst Z.obj.hom p) (stagePoint_to_base b p o ho Z q)

/-- The pointed map from `q.left` to `b` induced by the structure map of `Z`. -/
def basePointInclusion : Under.mk q.left ⟶ Under.mk b := Under.homMk Z.obj.hom (Over.w q)

theorem stageToBase_square :
    stageToBase b p o ho Z q ≫ basePointInclusion b Z q =
      stagePointedProjection b p o ho Z q ≫ pointedProjection b p o ho :=
  Under.UnderMorphism.ext pullback.condition

/-- Restriction to a finite base stage still has trivial field projection. -/
theorem kernelStageAut_projection (n : ProjectionKernel b p o ho) :
    pointedMap (stageToBase b p o ho Z q) (kernelStageAut b p o ho n Z q) = 1 := by
  apply PointLift.pointedMap_injective Z.obj.hom q.left b (Over.w q)
  change pointedMap (basePointInclusion b Z q)
    (pointedMap (stageToBase b p o ho Z q) (kernelStageAut b p o ho n Z q)) =
      pointedMap (basePointInclusion b Z q) 1
  rw [map_one, ← MonoidHom.comp_apply, ← pointedMap_comp, stageToBase_square,
    pointedMap_comp, MonoidHom.comp_apply, pointedMap_kernelStageAut]
  exact n.property

/-- The given geometric base is literally a second base change of the finite
base stage. This explicit isomorphism controls its first projection. -/
def geometricStagePullbackIso :
    pullback p b ≅ pullback (pullback.fst Z.obj.hom p) q.left :=
  pullbackSymmetry p b ≪≫ (pullback.congrHom (Over.w q).symm rfl) ≪≫
    (pullbackRightPullbackFstIso Z.obj.hom p q.left).symm ≪≫
      pullbackSymmetry q.left (pullback.fst Z.obj.hom p)

@[reassoc] theorem geometricStagePullbackIso_fst :
    (geometricStagePullbackIso b p Z q).hom ≫ pullback.fst (pullback.fst Z.obj.hom p) q.left =
      geometricStageRight b p Z q := by
  apply pullback.hom_ext
  · simp [geometricStagePullbackIso, geometricStageRight, Category.assoc]
  · simp [geometricStagePullbackIso, geometricStageRight, Category.assoc]

@[reassoc] theorem geometricStagePullbackIso_snd :
    (geometricStagePullbackIso b p Z q).hom ≫ pullback.snd (pullback.fst Z.obj.hom p) q.left =
      pullback.snd p b := by
  simp [geometricStagePullbackIso, Category.assoc]

end GeneralBase

section Scalars
variable (K Ω : Type u) [Field K] [Field Ω] [Algebra K Ω] [Algebra.IsAlgebraic K Ω]
  (s : Finset Ω)

/-- The algebra structure on `Ω` induced by the inclusion of the finite separable intermediate
field through the field generated by `s`. -/
@[instance_reducible] def finiteSepOmegaAlgebra : Algebra (finiteSepField K Ω s) Ω :=
  ((FieldLimit.finiteField K Ω s).val.toRingHom.comp
    (algebraMap (finiteSepField K Ω s) (FieldLimit.finiteField K Ω s))).toAlgebra

attribute [local instance] finiteSepOmegaAlgebra

instance finiteSepOmegaTower : IsScalarTower K (finiteSepField K Ω s) Ω := by
  apply IsScalarTower.of_algebraMap_eq
  intro x
  change algebraMap K Ω x = ((FieldLimit.finiteField K Ω s).val
    (algebraMap (finiteSepField K Ω s) (FieldLimit.finiteField K Ω s)
      (algebraMap K (finiteSepField K Ω s) x)))
  rw [← IsScalarTower.algebraMap_apply K (finiteSepField K Ω s) (FieldLimit.finiteField K Ω s)]
  exact ((FieldLimit.finiteField K Ω s).val.commutes x).symm

instance finiteSepOmegaIsAlgebraic : Algebra.IsAlgebraic (finiteSepField K Ω s) Ω :=
  Algebra.IsAlgebraic.tower_top (K := K) (finiteSepField K Ω s)

theorem finiteSepPoint_left : (finiteSepPoint K Ω s).left =
    Spec.algebraMap (finiteSepField K Ω s) Ω := by
  change Spec.map _ ≫ Spec.map _ = Spec.map _
  rw [← Spec.map_comp]
  rfl

end Scalars

end AlgebraicGeometry.Scheme.FiniteEtale.GeometricKernel

