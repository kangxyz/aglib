module

public import Aglib.AlgebraicGeometry.Descent.Modules.ZariskiStack
public import Aglib.AlgebraicGeometry.Descent.Modules.Fppf.CompTransCoherence
public import Aglib.AlgebraicGeometry.Descent.Modules.Fppf.Precoverage
public import Aglib.CategoryTheory.Sites.Descent.Composition
public import Aglib.AlgebraicGeometry.Descent.Modules.Fppf.Prestack

/-!
# Quasi-coherent sheaves form fpqc and fppf stacks

This file proves that `Scheme.Modules.quasicoherentPseudofunctor` is a stack for the fpqc topology,
hence for the fppf topology. The inputs are Zariski descent
(`isStack_quasicoherentPseudofunctor_zariskiTopology`), faithfully flat descent on affine schemes
(`isStackFor_quasicoherentPseudofunctor_singleton_specMap`), the fpqc prestack instance
`isPrestack_quasicoherentPseudofunctor_fpqcTopology` of [Prestack](Prestack.lean) (which Mathlib's
refinement lemma `Pseudofunctor.IsStackFor.of_le'` needs), and effective descent along composites
of covering presieves for prestacks, `Pseudofunctor.IsStackFor.bind` of
[Composition](../../../../CategoryTheory/Sites/Descent/Composition.lean).

* `isStackFor_ofArrows_of_finite_of_isAffine_of_flat_of_union_range_eq_univ`: a finite jointly
  surjective family of flat morphisms `g l : X l ⟶ Spec A` from affine schemes. The morphism
  `(∐ X).isoSpec.inv ≫ Sigma.desc g` is `Spec.map φ` for a faithfully flat `φ`
  (Mathlib's `flat_and_surjective_SpecMap_iff`); the presieve of the family generates the same
  sieve as the bind of the singleton of `Spec.map φ` with the pullbacks of the sieve of the family,
  which contain the Zariski cover of `∐ X` by its summands;
* `isStackFor_of_mem_fpqcPrecoverage_spec`: an fpqc covering presieve of an affine scheme
  `Spec A`; it is refined by a finite affine flat cover (Mathlib's `QuasiCompactCover.exists_hom`,
  Stacks, Tag 022B for quasi-compact covers), and Mathlib's `IsStackFor.of_le'` applies;
* `isStackFor_of_mem_fpqcPrecoverage`: an fpqc covering presieve of an arbitrary scheme; the bind
  of the Zariski family of `affineOpenCover` with the pullbacks of the generated sieve (which are
  generated by the base-changed presieves, Mathlib's `Sieve.pullbackArrows_comm`) refines it;
* the instance `isStack_quasicoherentPseudofunctor_fpqcTopology`, through Mathlib's
  `IsStack.of_precoverage` for `fpqcPrecoverage`;
* the instance `isStack_quasicoherentPseudofunctor_fppfTopology`, through
  `fppfTopology_le_fpqcTopology`.

The statement is Vistoli, *Notes on Grothendieck topologies, fibered categories and descent
theory*, arXiv:math/0412512v4, §4.2.2, Theorem 4.23 (p. 86). Its proof goes through Lemma 4.25
(p. 86): a Zariski stack with effective descent along every flat surjective morphism of affine
schemes is an fpqc stack. The proof here follows that reduction, but replaces the splitting and
gluing steps of Lemma 4.25 by the composition theorem `IsStackFor.bind` and Mathlib's
quasi-compact refinement. Stacks Project, Tag 023T, states this for fpqc coverings (families);
Mathlib's `IsStack.of_precoverage` passes from the coverings of `fpqcPrecoverage` to the covering
sieves of `fpqcTopology`.
-/
@[expose] public section

noncomputable section

universe u

open CategoryTheory Opposite Bicategory Pseudofunctor Limits

namespace AlgebraicGeometry.Scheme.Modules

/-- **Finite affine families.** Quasi-coherent sheaves satisfy effective descent along a finite
jointly surjective family of flat morphisms `g l : X l ⟶ Spec A` from affine
schemes. -/
theorem isStackFor_ofArrows_of_finite_of_isAffine_of_flat_of_union_range_eq_univ {ι : Type*}
    [Finite ι] {A : CommRingCat.{u}} {X : ι → Scheme.{u}} [∀ l, IsAffine (X l)]
    (g : ∀ l, X l ⟶ Spec A) [∀ l, Flat (g l)]
    (hg : ⋃ l, Set.range (g l) = Set.univ) :
    quasicoherentPseudofunctor.{u}.IsStackFor (Presieve.ofArrows _ g) := by
  classical
  let e := (∐ X).isoSpec
  let q : Spec Γ(∐ X, ⊤) ⟶ Spec A := e.inv ≫ Sigma.desc g
  have : Surjective (Sigma.desc g) := Surjective.sigmaDesc_of_union_range_eq_univ hg
  obtain ⟨φ, hφ⟩ := Spec.map_surjective q
  have : Flat (Spec.map φ) := by rw [hφ]; infer_instance
  have : Surjective (Spec.map φ) := by rw [hφ]; infer_instance
  have hff : φ.hom.FaithfullyFlat := (flat_and_surjective_SpecMap_iff φ).1 ⟨‹_›, ‹_›⟩
  -- the pulled-back sieve of the family contains the Zariski cover of `∐ X` by its summands
  have hZar : ((Sieve.ofArrows _ g).pullback (Spec.map φ)) ∈
      Scheme.zariskiTopology (Spec Γ(∐ X, ⊤)) := by
    refine Scheme.zariskiTopology.superset_covering ?_
      (Scheme.zariskiTopology.pullback_stable e.inv (sigmaOpenCover X).mem_grothendieckTopology)
    rintro Z t ⟨W, a, _, ⟨l⟩, hat⟩
    refine ⟨_, a, _, ⟨l⟩, ?_⟩
    rw [hφ]
    simp only [q, ← reassoc_of% hat]
    exact congrArg (a ≫ ·) (Sigma.ι_comp_desc g l).symm
  have key := (isStackFor_quasicoherentPseudofunctor_singleton_specMap φ hff).bind
    (J := Scheme.fpqcTopology)
    (Precoverage.generate_mem_toGrothendieck (Hom.singleton_mem_fpqcPrecoverage (Spec.map φ)))
    (fun Y f _ ↦ ((Sieve.ofArrows _ g).pullback f).arrows)
    (by
      rintro Y f ⟨⟩
      exact quasicoherentPseudofunctor.isStackFor' _ hZar)
    (by
      rintro Y f ⟨⟩
      rw [Sieve.generate_sieve]
      exact zariskiTopology_le_fpqcTopology _ hZar)
  refine (quasicoherentPseudofunctor.isStackFor_iff_of_sieve_eq ?_).1 key
  refine le_antisymm ?_ ?_
  · rw [Sieve.generate_le_iff]
    rintro Z _ ⟨Y, t, f, ⟨⟩, ht, rfl⟩
    exact ht
  · rw [Sieve.generate_le_iff]
    rintro Z _ ⟨l⟩
    apply Sieve.le_generate
    refine ⟨_, Sigma.ι X l ≫ e.hom, Spec.map φ, ⟨⟩, ?_, ?_⟩
    · refine ⟨_, 𝟙 _, _, ⟨l⟩, ?_⟩
      rw [hφ]
      simp only [q, Category.assoc, Iso.hom_inv_id_assoc, Sigma.ι_comp_desc, Category.id_comp]
    · rw [hφ]
      simp only [q, Category.assoc, Iso.hom_inv_id_assoc, Sigma.ι_comp_desc]

/-- **Affine base.** Quasi-coherent sheaves satisfy effective descent along every fpqc covering
presieve of an affine scheme `Spec A`. -/
theorem isStackFor_of_mem_fpqcPrecoverage_spec {A : CommRingCat.{u}} {R : Presieve (Spec A)}
    (hR : R ∈ Scheme.fpqcPrecoverage (Spec A)) :
    quasicoherentPseudofunctor.{u}.IsStackFor R := by
  obtain ⟨𝒰, h𝒰, rfl⟩ := (mem_propQCPrecoverage_iff_exists_quasiCompactCover (P := @Flat)).1 hR
  have : MorphismProperty.RespectsLeft @Flat @IsOpenImmersion :=
    ⟨fun i hi f hf ↦ by
      have : IsOpenImmersion i := hi
      have : Flat f := hf
      exact inferInstanceAs (Flat (i ≫ f))⟩
  have := h𝒰
  obtain ⟨𝒱, f, hfin, -⟩ := QuasiCompactCover.exists_hom 𝒰
  have : ∀ j, Flat (𝒱.f j) := 𝒱.map_prop
  have h𝒱 := isStackFor_ofArrows_of_finite_of_isAffine_of_flat_of_union_range_eq_univ 𝒱.f
    (Set.eq_univ_of_forall fun x ↦ Set.mem_iUnion.2 ⟨𝒱.idx x, 𝒱.covers x⟩)
  -- Mathlib's instances for `precoverage P` do not apply at `P := @Flat` (the type of `@Flat`
  -- is `MorphismProperty Scheme` only after unfolding), so they are supplied by hand.
  have : JointlySurjective (Scheme.precoverage.{u} @Flat) := instJointlySurjectivePrecoverage
  have : Finite 𝒱.cover.I₀ := hfin
  have : ∀ j, QuasiCompact (𝒱.cover.f j) := fun j ↦ inferInstanceAs (QuasiCompact (𝒱.f j))
  have h₁ : 𝒱.cover.presieve₀ ∈ propQCPrecoverage @Flat (Spec A) :=
    ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr QuasiCompactCover.of_finite, 𝒱.cover.mem₀⟩
  have hmem : Sieve.generate (Presieve.ofArrows _ 𝒱.f) ∈ Scheme.fpqcTopology (Spec A) :=
    Precoverage.generate_mem_toGrothendieck h₁
  refine (quasicoherentPseudofunctor.IsStackFor_generate_iff _).1
    (((quasicoherentPseudofunctor.IsStackFor_generate_iff _).2 h𝒱).of_le' _ hmem ?_)
  rw [Sieve.generate_le_iff]
  rintro _ _ ⟨j⟩
  exact ⟨_, f.h₀ j, _, ⟨f.s₀ j⟩, f.w₀ j⟩

/-- **Arbitrary base.** Quasi-coherent sheaves satisfy effective descent along every fpqc
covering presieve. -/
theorem isStackFor_of_mem_fpqcPrecoverage {T : Scheme.{u}} {R : Presieve T}
    (hR : R ∈ Scheme.fpqcPrecoverage T) :
    quasicoherentPseudofunctor.{u}.IsStackFor R := by
  let 𝒰 := T.affineOpenCover
  have hR₀ : Sieve.generate (Presieve.ofArrows _ 𝒰.f) ∈ Scheme.zariskiTopology T :=
    𝒰.openCover.mem_grothendieckTopology
  have hRJ : Sieve.generate R ∈ Scheme.fpqcTopology T := Precoverage.generate_mem_toGrothendieck hR
  have key := (quasicoherentPseudofunctor.isStackFor _ hR₀).bind (J := Scheme.fpqcTopology)
    (zariskiTopology_le_fpqcTopology _ hR₀)
    (fun Y g _ ↦ ((Sieve.generate R).pullback g).arrows)
    (by
      rintro Y g ⟨j⟩
      rw [← Sieve.pullbackArrows_comm, IsStackFor_generate_iff]
      exact isStackFor_of_mem_fpqcPrecoverage_spec
        (Precoverage.pullbackArrows_mem (𝒰.f j) hR))
    (fun Y g _ ↦ by
      rw [Sieve.generate_sieve]
      exact Scheme.fpqcTopology.pullback_stable g hRJ)
  refine (quasicoherentPseudofunctor.IsStackFor_generate_iff _).1
    (((quasicoherentPseudofunctor.IsStackFor_generate_iff _).2 key).of_le' _
      (J := Scheme.fpqcTopology) ?_ ?_)
  · refine Scheme.fpqcTopology.superset_covering ?_
      (Scheme.fpqcTopology.intersection_covering hRJ (zariskiTopology_le_fpqcTopology _ hR₀))
    rintro Z h ⟨hR', W, a, _, ⟨j⟩, rfl⟩
    apply Sieve.le_generate
    exact ⟨_, a, _, ⟨j⟩, hR', rfl⟩
  · rw [Sieve.generate_le_iff]
    rintro Z _ ⟨Y, t, g, -, ht, rfl⟩
    exact ht

/-- **Quasi-coherent sheaves form an fpqc stack**: Mathlib's `IsStack.of_precoverage` for
`fpqcPrecoverage`. -/
instance isStack_quasicoherentPseudofunctor_fpqcTopology :
    quasicoherentPseudofunctor.{u}.IsStack Scheme.fpqcTopology :=
  IsStack.of_precoverage fun _ _ hR ↦ isStackFor_of_mem_fpqcPrecoverage hR

/-- **Quasi-coherent sheaves form an fppf stack**: the fppf topology is coarser than the fpqc
topology. -/
instance isStack_quasicoherentPseudofunctor_fppfTopology :
    quasicoherentPseudofunctor.{u}.IsStack Scheme.fppfTopology :=
  IsStack.of_le _ fppfTopology_le_fpqcTopology

end AlgebraicGeometry.Scheme.Modules
