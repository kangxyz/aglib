module

public import Aglib.AlgebraicGeometry.Descent.FiniteType.OverlapDiagrams
public import Mathlib.Algebra.Category.Ring.Constructions

/-!
# Generation of overlap rings from a genuine chart pullback

The overlap-to-chart transition squares are cartesian even though the
overlap-to-product transition squares need not be. The genuine square
supplies generation by the old overlap ring and the new chart ring; the
latter factors through the new product ring. This yields precisely the
weaker generation condition needed for eventual surjectivity.
-/

@[expose] public section

noncomputable section

set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false

open CategoryTheory Limits

universe u

namespace AlgebraicGeometry.Scheme.RelativeOverlap

variable {I : Type u} [Category.{u} I] (D : I ⥤ Scheme.{u}) (i : I)

/-- Inclusions between inverse-image-open systems have actual cartesian
transition squares. This statement is about chart inclusions, not diagonals. -/
lemma isPullback_chartInclusion {U V : (D.obj i).Opens} (hUV : U ≤ V)
    {j k : Over i} (q : j ⟶ k) :
    IsPullback ((opensDiagram D i U).map q) ((chartInclusion D i hUV).app j)
      ((chartInclusion D i hUV).app k) ((opensDiagram D i V).map q) := by
  have (l : Over i) : IsOpenImmersion ((chartInclusion D i hUV).app l) :=
    inferInstanceAs (IsOpenImmersion ((D.obj l.left).homOfLE (fun _ hx ↦ hUV hx)))
  apply IsOpenImmersion.isPullback
  · exact ((chartInclusion D i hUV).naturality q).symm
  · have hm : (opensDiagram D i V).map q ≫
          ((D.map k.hom ⁻¹ᵁ V).ι ≫ D.map k.hom) =
        (D.map j.hom ⁻¹ᵁ V).ι ≫ D.map j.hom := by
      change (D.map q.left).resLE _ _ _ ≫ _ = _
      rw [← Category.assoc, Scheme.Hom.resLE_comp_ι, Category.assoc,
        ← D.map_comp, Over.w q]
    simpa only [chartInclusion, Scheme.opensRange_homOfLE, Scheme.Hom.comp_preimage] using
      congrArg (fun z : (opensDiagram D i V).obj j ⟶ D.obj i ↦ z ⁻¹ᵁ U) hm


/-- The chart-ring map factors through the actual product-ring map. -/
lemma overlapMap_appTop_factor {S : Scheme.{u}} (t : D ⟶ (Functor.const I).obj S)
    (U V : (D.obj i).Opens) (j : Over i) :
    (pullback.fst ((chartStructure D t i U).app j)
      ((chartStructure D t i V).app j)).appTop ≫ ((overlapMap D t i U V).app j).appTop =
      ((chartInclusion D i (U := U ⊓ V) (V := U) inf_le_left).app j).appTop := by
  change (pullback.fst ((D.map j.hom ⁻¹ᵁ U).ι ≫ t.app j.left)
      ((D.map j.hom ⁻¹ᵁ V).ι ≫ t.app j.left)).appTop ≫
      (toProduct (t.app j.left) (D.map j.hom ⁻¹ᵁ U) (D.map j.hom ⁻¹ᵁ V)).appTop =
    ((D.obj j.left).homOfLE (inf_le_left :
      D.map j.hom ⁻¹ᵁ U ⊓ D.map j.hom ⁻¹ᵁ V ≤ D.map j.hom ⁻¹ᵁ U)).appTop
  simpa only [Scheme.Hom.comp_appTop] using congrArg Scheme.Hom.appTop
    (toProduct_fst (t.app j.left) (D.map j.hom ⁻¹ᵁ U) (D.map j.hom ⁻¹ᵁ V))

/-- The new overlap ring is generated by the old overlap ring and the new
product-ring image. Only the old overlap and the first chart need be affine. -/
lemma closure_range_overlapMap_eq_top
    [∀ {j k} (q : j ⟶ k), IsAffineHom (D.map q)]
    {S : Scheme.{u}} (t : D ⟶ (Functor.const I).obj S)
    (U V : (D.obj i).Opens) (hU : IsAffineOpen U)
    {j k : Over i} (q : j ⟶ k)
    [IsAffine ((opensDiagram D i (U ⊓ V)).obj k)] :
    Subring.closure
      (Set.range ((opensDiagram D i (U ⊓ V)).map q).appTop ∪
        Set.range ((overlapMap D t i U V).app j).appTop) = ⊤ := by
  have (l : Over i) : IsAffine ((opensDiagram D i U).obj l) := hU.preimage (D.map l.hom)
  let H := isPullback_chartInclusion D i (U := U ⊓ V) (V := U) inf_le_left q
  have hgenerate := CommRingCat.closure_range_union_range_eq_top_of_isPushout
    (isPushout_appTop_of_isPullback H)
  have hrange :
      Set.range ((chartInclusion D i (U := U ⊓ V) (V := U) inf_le_left).app j).appTop ⊆
        Set.range ((overlapMap D t i U V).app j).appTop := by
    rintro _ ⟨x, rfl⟩
    refine ⟨(pullback.fst ((chartStructure D t i U).app j)
      ((chartStructure D t i V).app j)).appTop x, ?_⟩
    exact congr($(overlapMap_appTop_factor D i t U V j).hom x)
  apply top_unique
  rw [← hgenerate]
  exact Subring.closure_mono
    (Set.union_subset Set.subset_union_left (hrange.trans Set.subset_union_right))

end AlgebraicGeometry.Scheme.RelativeOverlap
