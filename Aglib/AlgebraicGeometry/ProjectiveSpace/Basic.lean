module

public import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Basic
public import Mathlib.RingTheory.MvPolynomial.Homogeneous
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import Mathlib.Order.CompleteLattice.Finset

/-!
# Polynomial projective space and its coordinate cover

Projective space is Mathlib's actual `Proj` of the polynomial ring with its total-degree grading.
The variables generate the irrelevant ideal, so their principal opens give the standard affine
cover. Every nonempty finite intersection has the canonical homogeneous-localization description.
The variable type is unrestricted; a finite variable type gives a finite cover.
-/

@[expose] public section

noncomputable section

set_option backward.isDefEq.respectTransparency false

open CategoryTheory TopologicalSpace

universe u

attribute [local instance] MvPolynomial.gradedAlgebra

namespace MvPolynomial

variable (R : Type u) [CommRing R] (ι : Type u)

/-- For the total-degree grading, the irrelevant ideal is the ideal generated by the variables. -/
theorem irrelevant_homogeneousSubmodule_eq_idealOfVars :
    (HomogeneousIdeal.irrelevant (homogeneousSubmodule ι R)).toIdeal = idealOfVars ι R := by
  apply le_antisymm
  · apply (HomogeneousIdeal.toIdeal_irrelevant_le _).mpr
    intro n hn p hp
    change p ∈ idealOfVars ι R
    rw [← pow_one (idealOfVars ι R), mem_pow_idealOfVars_iff]
    intro d hd
    have hdeg : d.degree = n := by
      simpa [Finsupp.degree_eq_weight_one, ← Pi.one_def] using hp (mem_support_iff.mp hd)
    simpa [hdeg] using Nat.succ_le_iff.mpr hn
  · apply Ideal.span_le.mpr
    rintro p ⟨i, rfl⟩
    exact HomogeneousIdeal.mem_irrelevant_of_mem _ Nat.zero_lt_one (isHomogeneous_X R i)

end MvPolynomial

namespace AlgebraicGeometry

/-- Projective space with homogeneous coordinates indexed by `ι`, using the actual polynomial
`Proj`. In particular, `ProjectiveSpace R (Fin (n + 1))` is projective `n`-space over `R`. -/
abbrev ProjectiveSpace (R : Type u) [CommRing R] (ι : Type u) : Scheme.{u} :=
  Proj (MvPolynomial.homogeneousSubmodule ι R)

namespace ProjectiveSpace

variable (R : Type u) [CommRing R] (ι : Type u)

/-- The standard open on which the homogeneous coordinate indexed by `i` does not vanish. -/
def coordinateOpen (i : ι) : (ProjectiveSpace R ι).Opens :=
  Proj.basicOpen (MvPolynomial.homogeneousSubmodule ι R) (MvPolynomial.X i)

/-- The standard coordinate opens cover polynomial projective space. -/
theorem iSup_coordinateOpen_eq_top : (⨆ i, coordinateOpen R ι i) = ⊤ :=
  Proj.iSup_basicOpen_eq_top _ _
    (MvPolynomial.irrelevant_homogeneousSubmodule_eq_idealOfVars R ι).le

/-- Each standard coordinate open is affine. -/
theorem isAffineOpen_coordinateOpen (i : ι) : IsAffineOpen (coordinateOpen R ι i) :=
  Proj.isAffineOpen_basicOpen _ _ (MvPolynomial.isHomogeneous_X R i) Nat.zero_lt_one

/-- The standard affine open cover uses the native homogeneous localizations and open immersions. -/
def coordinateAffineOpenCover : (ProjectiveSpace R ι).AffineOpenCover :=
  Proj.affineOpenCoverOfIrrelevantLESpan _ (fun i : ι => MvPolynomial.X i)
    (fun i => MvPolynomial.isHomogeneous_X R i) (fun _ => Nat.zero_lt_one)
    (MvPolynomial.irrelevant_homogeneousSubmodule_eq_idealOfVars R ι).le

/-- The product of the coordinates belonging to a finite set. -/
def coordinateProduct (s : Finset ι) : MvPolynomial ι R :=
  ∏ i ∈ s, MvPolynomial.X i

/-- The product of `s.card` coordinates is homogeneous of degree `s.card`. -/
theorem isHomogeneous_coordinateProduct (s : Finset ι) :
    (coordinateProduct R ι s).IsHomogeneous s.card := by
  simpa [coordinateProduct] using
    MvPolynomial.IsHomogeneous.prod s (fun i : ι => MvPolynomial.X i)
      (fun _ => 1) (fun i _ => MvPolynomial.isHomogeneous_X R i)

/-- A finite coordinate intersection is the principal open of the coordinate product. -/
theorem basicOpen_coordinateProduct (s : Finset ι) :
    Proj.basicOpen (MvPolynomial.homogeneousSubmodule ι R) (coordinateProduct R ι s) =
      ⨅ i ∈ s, coordinateOpen R ι i := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [coordinateProduct]
  | @insert i s hi ih =>
    simp only [coordinateProduct, Finset.prod_insert hi, Proj.basicOpen_mul] at *
    rw [ih]
    exact (Finset.iInf_insert i s (coordinateOpen R ι)).symm

/-- Every nonempty finite coordinate intersection is affine, over any commutative base ring. -/
theorem isAffineOpen_coordinateIntersection (s : Finset ι) (hs : s.Nonempty) :
    IsAffineOpen (⨅ i ∈ s, coordinateOpen R ι i) := by
  rw [← basicOpen_coordinateProduct]
  exact Proj.isAffineOpen_basicOpen _ _ (isHomogeneous_coordinateProduct R ι s)
    (Finset.card_pos.mpr hs)

/-- Sections on a nonempty finite coordinate intersection are the degree-zero homogeneous
localization, through Mathlib's canonical section map. -/
def coordinateProductSectionsIso (s : Finset ι) (hs : s.Nonempty) :
    CommRingCat.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule ι R)
      (coordinateProduct R ι s)) ≅
        Γ(ProjectiveSpace R ι,
          Proj.basicOpen (MvPolynomial.homogeneousSubmodule ι R) (coordinateProduct R ι s)) :=
  Proj.basicOpenIsoAway _ _ (isHomogeneous_coordinateProduct R ι s) (Finset.card_pos.mpr hs)

end ProjectiveSpace

end AlgebraicGeometry
