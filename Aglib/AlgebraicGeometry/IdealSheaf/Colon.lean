/-!
# Ideal quotients and actual stalk ideals

Localization commutes with an ideal quotient by a finitely generated ideal.
On a locally Noetherian scheme this constructs the ideal quotient on all
affine opens, with its actual stalk formula.
-/

@[expose] public section

noncomputable section

universe u v

namespace IsLocalization

variable {R : Type u} [CommRing R] (M : Submonoid R)
  (S : Type v) [CommRing S] [Algebra R S] [IsLocalization M S]

include M

/-- An ideal quotient by one element commutes with localization. -/
theorem map_colon_singleton (I : Ideal R) (a : R) :
    (I.colon {a}).map (algebraMap R S) =
      (I.map (algebraMap R S)).colon {algebraMap R S a} := by
  ext z
  obtain ⟨x, s, rfl⟩ := IsLocalization.exists_mk'_eq M z
  rw [IsLocalization.mk'_mem_map_algebraMap_iff M S,
    Submodule.mem_colon_singleton, smul_eq_mul,
    mul_comm (IsLocalization.mk' S x s),
    IsLocalization.mul_mk'_eq_mk'_of_mul,
    IsLocalization.mk'_mem_map_algebraMap_iff M S]
  simp only [Submodule.mem_colon_singleton, smul_eq_mul, mul_comm a x, mul_assoc]

private theorem map_colon_finset (I : Ideal R) (s : Finset R) :
    (I.colon (s : Set R)).map (algebraMap R S) =
      (I.map (algebraMap R S)).colon ((algebraMap R S) '' (s : Set R)) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp only [Finset.coe_empty, Set.image_empty, Submodule.colon_empty, Ideal.map_top]
  | @insert a s ha ih =>
    rw [Finset.coe_insert, Set.insert_eq, Set.image_union, Set.image_singleton,
      Submodule.colon_union, Submodule.colon_union, IsLocalization.map_inf M S,
      map_colon_singleton M S, ih]

/-- The quotient by a finitely generated ideal commutes with every localization. -/
theorem map_colon_of_fg (I K : Ideal R) (hK : K.FG) :
    (I.colon (K : Set R)).map (algebraMap R S) =
      (I.map (algebraMap R S)).colon (K.map (algebraMap R S) : Set S) := by
  obtain ⟨s, rfl⟩ := hK
  rw [Ideal.colon_span, Ideal.map_span, Ideal.colon_span]
  exact map_colon_finset M S I s

end IsLocalization

namespace Ideal

/-- A ring isomorphism preserves the ideal quotient with its actual maps. -/
theorem map_colon_of_bijective {R : Type u} {S : Type v} [CommRing R] [CommRing S]
    (f : R →+* S) (hf : Function.Bijective f) (I K : Ideal R) :
    (I.colon (K : Set R)).map f = (I.map f).colon (K.map f : Set S) := by
  have hmem (L : Ideal R) (a : R) : f a ∈ L.map f ↔ a ∈ L := by
    change a ∈ (L.map f).comap f ↔ a ∈ L
    rw [Ideal.comap_map_of_bijective f hf]
  ext b
  obtain ⟨a, rfl⟩ := hf.surjective b
  rw [hmem, Submodule.mem_colon, Submodule.mem_colon]
  constructor
  · intro h c hc
    obtain ⟨d, hd, rfl⟩ := (Ideal.mem_map_iff_of_surjective f hf.surjective).mp hc
    simpa only [smul_eq_mul, ← map_mul, hmem] using h d hd
  · intro h d hd
    have hd' := h (f d) (Ideal.mem_map_of_mem f hd)
    simpa only [smul_eq_mul, ← map_mul, hmem] using hd'

/-- Division by a principal ideal recovers every ideal contained in it. -/
theorem span_singleton_mul_colon_of_le {R : Type u} [CommRing R]
    (J : Ideal R) (a : R) (hJ : J ≤ Ideal.span {a}) :
    Ideal.span {a} * J.colon (Ideal.span {a} : Set R) = J := by
  rw [Ideal.colon_span]
  apply le_antisymm
  · apply Ideal.span_singleton_mul_le_iff.mpr
    intro b hb
    simpa only [Submodule.mem_colon_singleton, smul_eq_mul, mul_comm] using hb
  · intro b hb
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp (hJ hb)
    apply Ideal.mem_span_singleton_mul.mpr
    refine ⟨c, ?_, hc.symm⟩
    apply Submodule.mem_colon_singleton.mpr
    simpa only [smul_eq_mul, mul_comm, ← hc] using hb

end Ideal

open CategoryTheory Opposite TopologicalSpace

namespace AlgebraicGeometry.Scheme.IdealSheafData

variable {X Y : Scheme.{u}}

/-- The ideal in the actual local ring generated by germs of local sections of
the original ideal sheaf. -/
def stalkIdeal (I : X.IdealSheafData) (x : X) : Ideal (X.presheaf.stalk x) :=
  ⨆ (U : X.affineOpens) (hx : x ∈ U.1),
    (I.ideal U).map (X.presheaf.germ U.1 x hx).hom

/-- On every affine neighbourhood, the actual stalk ideal is extension along
the original germ. -/
theorem stalkIdeal_eq_map (I : X.IdealSheafData) (U : X.affineOpens)
    (x : X) (hx : x ∈ U.1) :
    I.stalkIdeal x = (I.ideal U).map (X.presheaf.germ U.1 x hx).hom := by
  apply le_antisymm
  · refine iSup_le fun V ↦ iSup_le fun hxV ↦ ?_
    obtain ⟨_, ⟨W, hW, rfl⟩, hxW, hWle⟩ :=
      X.isBasis_affineOpens.exists_subset_of_mem_open
        (show x ∈ (U.1 ⊓ V.1) from ⟨hx, hxV⟩) (U.1 ⊓ V.1).isOpen
    have hWU : W ≤ U.1 := le_trans hWle inf_le_left
    have hWV : W ≤ V.1 := le_trans hWle inf_le_right
    have hu := congrArg
      (fun K : Ideal Γ(X, W) ↦ K.map (X.presheaf.germ W x hxW).hom)
      (I.map_ideal (U := ⟨W, hW⟩) (V := U) hWU)
    have hv := congrArg
      (fun K : Ideal Γ(X, W) ↦ K.map (X.presheaf.germ W x hxW).hom)
      (I.map_ideal (U := ⟨W, hW⟩) (V := V) hWV)
    simp only [Ideal.map_map, ← CommRingCat.hom_comp, TopCat.Presheaf.germ_res'] at hu hv
    exact (hv.trans hu.symm).le
  · exact le_iSup_of_le U (le_iSup_of_le hx le_rfl)

/-- Inclusion of actual ideal sheaves can be checked in the original local rings. -/
theorem le_iff_stalkIdeal_le {I J : X.IdealSheafData} :
    I ≤ J ↔ ∀ x, I.stalkIdeal x ≤ J.stalkIdeal x := by
  constructor
  · intro h x
    refine iSup_le fun U ↦ iSup_le fun hx ↦ ?_
    rw [J.stalkIdeal_eq_map U x hx]
    exact Ideal.map_mono (h U)
  · intro h U
    rw [U.2.ideal_le_iff]
    intro x hx
    simpa only [I.stalkIdeal_eq_map U x hx, J.stalkIdeal_eq_map U x hx] using h x

/-- Equality of actual ideal sheaves is detected in their original stalk rings. -/
theorem ext_stalkIdeal {I J : X.IdealSheafData}
    (h : ∀ x, I.stalkIdeal x = J.stalkIdeal x) : I = J :=
  (le_iff_stalkIdeal_le.mpr fun x ↦ (h x).le).antisymm
    (le_iff_stalkIdeal_le.mpr fun x ↦ (h x).ge)

@[simp]
theorem stalkIdeal_top (x : X) :
    (⊤ : X.IdealSheafData).stalkIdeal x = ⊤ := by
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
  rw [stalkIdeal_eq_map _ ⟨U, hU⟩ x hxU]
  exact Ideal.map_top _

@[simp]
theorem stalkIdeal_mul (I K : X.IdealSheafData) (x : X) :
    (I * K).stalkIdeal x = I.stalkIdeal x * K.stalkIdeal x := by
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
  rw [stalkIdeal_eq_map _ ⟨U, hU⟩ x hxU,
    I.stalkIdeal_eq_map ⟨U, hU⟩ x hxU, K.stalkIdeal_eq_map ⟨U, hU⟩ x hxU]
  exact Ideal.map_mul _ _ _

@[simp]
theorem stalkIdeal_pow (I : X.IdealSheafData) (r : ℕ) (x : X) :
    (I ^ r).stalkIdeal x = I.stalkIdeal x ^ r := by
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
  rw [stalkIdeal_eq_map _ ⟨U, hU⟩ x hxU, I.stalkIdeal_eq_map ⟨U, hU⟩ x hxU]
  exact Ideal.map_pow _ _ _

/-- Pullback on actual stalk ideals is extension along the actual stalk map. -/
theorem stalkIdeal_comap (I : X.IdealSheafData) (f : Y ⟶ X) (y : Y) :
    (I.comap f).stalkIdeal y = (I.stalkIdeal (f y)).map (f.stalkMap y).hom := by
  obtain ⟨_, ⟨U, hU, rfl⟩, hfyU, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ (f y)) isOpen_univ
  obtain ⟨_, ⟨V, hV, rfl⟩, hyV, hVU⟩ :=
    Y.isBasis_affineOpens.exists_subset_of_mem_open
      (show y ∈ f ⁻¹ᵁ U from hfyU) (f ⁻¹ᵁ U).isOpen
  rw [stalkIdeal_eq_map _ ⟨V, hV⟩ y hyV,
    I.stalkIdeal_eq_map ⟨U, hU⟩ (f y) hfyU,
    I.ideal_comap_eq_map_appLE f ⟨U, hU⟩ ⟨V, hV⟩ hVU,
    Ideal.map_map, Ideal.map_map]
  have hh : f.appLE U V hVU ≫ Y.presheaf.germ V y hyV =
      X.presheaf.germ U (f y) hfyU ≫ f.stalkMap y := by
    simp only [Scheme.Hom.appLE, Category.assoc, TopCat.Presheaf.germ_res', f.germ_stalkMap]
  exact congrArg (fun φ : Γ(X, U) ⟶ Y.presheaf.stalk y ↦ (I.ideal ⟨U, hU⟩).map φ.hom) hh

/-- Pullback preserves multiplication of the original ideal sheaves. -/
theorem comap_mul (I K : X.IdealSheafData) (f : Y ⟶ X) :
    (I * K).comap f = I.comap f * K.comap f := by
  apply ext_stalkIdeal
  intro y
  simp only [stalkIdeal_comap, stalkIdeal_mul, Ideal.map_mul]

/-- Pullback preserves every power of the original ideal sheaf. -/
theorem comap_pow (I : X.IdealSheafData) (r : ℕ) (f : Y ⟶ X) :
    (I ^ r).comap f = I.comap f ^ r := by
  apply ext_stalkIdeal
  intro y
  simp only [stalkIdeal_comap, stalkIdeal_pow, Ideal.map_pow]

/-- The original quotient is supported at a point precisely when its actual
local ideal is proper. -/
theorem stalkIdeal_ne_top_iff_mem_support (I : X.IdealSheafData) (x : X) :
    I.stalkIdeal x ≠ ⊤ ↔ x ∈ I.support := by
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
  let P := (hU.primeIdealOf ⟨x, hxU⟩).asIdeal
  let : Algebra Γ(X, U) (X.presheaf.stalk x) := X.presheaf.algebra_section_stalk ⟨x, hxU⟩
  have : IsLocalization.AtPrime (X.presheaf.stalk x) P := hU.isLocalization_stalk ⟨x, hxU⟩
  have hs : x ∈ I.support ↔ I.ideal ⟨U, hU⟩ ≤ P := by
    simpa only [hU.fromSpec_primeIdealOf] using
      I.fromSpec_mem_support_iff ⟨U, hU⟩ (hU.primeIdealOf ⟨x, hxU⟩)
  rw [I.stalkIdeal_eq_map ⟨U, hU⟩ x hxU, hs]
  change (I.ideal ⟨U, hU⟩).map (algebraMap Γ(X, U) (X.presheaf.stalk x)) ≠ ⊤ ↔ _
  rw [IsLocalization.map_algebraMap_ne_top_iff_disjoint P.primeCompl]
  constructor
  · intro h a ha
    by_contra hn
    exact Set.disjoint_left.mp h (show a ∈ P.primeCompl from hn) ha
  · intro h
    exact Set.disjoint_left.mpr fun a ha hI ↦ ha (h hI)

/-- Outside the actual support the stalk ideal is the unit ideal. -/
theorem stalkIdeal_eq_top_of_notMem_support (I : X.IdealSheafData) (x : X)
    (hx : x ∉ I.support) : I.stalkIdeal x = ⊤ :=
  not_ne_iff.mp fun h ↦ hx ((I.stalkIdeal_ne_top_iff_mem_support x).mp h)

variable [IsLocallyNoetherian X]

/-- The genuine quotient of two ideal sheaves, constructed by localization of
the sectionwise ideal quotients. -/
def colon (I K : X.IdealSheafData) : X.IdealSheafData where
  ideal U := (I.ideal U).colon (K.ideal U : Set Γ(X, U))
  map_ideal_basicOpen U f := by
    let : Algebra Γ(X, U) Γ(X, X.affineBasicOpen f) :=
      (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom.toAlgebra
    have : IsLocalization.Away f Γ(X, X.basicOpen f) :=
      U.2.isLocalization_of_eq_basicOpen _ _ rfl
    have : IsNoetherianRing Γ(X, U) := IsLocallyNoetherian.component_noetherian U
    exact (IsLocalization.map_colon_of_fg (.powers f) Γ(X, X.basicOpen f)
      (I.ideal U) (K.ideal U) (K.ideal U).fg_of_isNoetherianRing).trans
      (by
        rw [RingHom.algebraMap_toAlgebra, I.map_ideal_basicOpen, K.map_ideal_basicOpen]
        rfl)

@[simp]
theorem colon_ideal (I K : X.IdealSheafData) (U : X.affineOpens) :
    (I.colon K).ideal U = (I.ideal U).colon (K.ideal U : Set Γ(X, U)) := rfl

/-- Formation of the genuine ideal quotient commutes with the original stalks. -/
theorem stalkIdeal_colon (I K : X.IdealSheafData) (x : X) :
    (I.colon K).stalkIdeal x = (I.stalkIdeal x).colon (K.stalkIdeal x : Set _) := by
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
  let : Algebra Γ(X, U) (X.presheaf.stalk x) := X.presheaf.algebra_section_stalk ⟨x, hxU⟩
  have : IsLocalization.AtPrime (X.presheaf.stalk x)
      (hU.primeIdealOf ⟨x, hxU⟩).asIdeal := hU.isLocalization_stalk ⟨x, hxU⟩
  have : IsNoetherianRing Γ(X, U) := IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
  rw [(I.colon K).stalkIdeal_eq_map ⟨U, hU⟩ x hxU,
    I.stalkIdeal_eq_map ⟨U, hU⟩ x hxU, K.stalkIdeal_eq_map ⟨U, hU⟩ x hxU]
  exact IsLocalization.map_colon_of_fg (hU.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl
    (X.presheaf.stalk x) (I.ideal ⟨U, hU⟩) (K.ideal ⟨U, hU⟩)
    (K.ideal ⟨U, hU⟩).fg_of_isNoetherianRing

/-- Ideal quotients pull back along morphisms whose actual stalk maps are
isomorphisms, including every open immersion. -/
theorem comap_colon_of_isIso_stalkMap [IsLocallyNoetherian Y]
    (I K : X.IdealSheafData) (f : Y ⟶ X)
    (hf : ∀ y, IsIso (f.stalkMap y)) :
    (I.colon K).comap f = (I.comap f).colon (K.comap f) := by
  apply ext_stalkIdeal
  intro y
  let : IsIso (f.stalkMap y) := hf y
  rw [stalkIdeal_comap, stalkIdeal_colon, stalkIdeal_colon,
    stalkIdeal_comap, stalkIdeal_comap]
  exact Ideal.map_colon_of_bijective (f.stalkMap y).hom
    (ConcreteCategory.bijective_of_isIso (f.stalkMap y)) _ _

/-- In particular, the quotient is compatible with actual open restrictions. -/
theorem comap_colon_of_isOpenImmersion [IsLocallyNoetherian Y]
    (I K : X.IdealSheafData) (f : Y ⟶ X) [IsOpenImmersion f] :
    (I.colon K).comap f = (I.comap f).colon (K.comap f) :=
  comap_colon_of_isIso_stalkMap I K f fun _ ↦ inferInstance

end AlgebraicGeometry.Scheme.IdealSheafData
