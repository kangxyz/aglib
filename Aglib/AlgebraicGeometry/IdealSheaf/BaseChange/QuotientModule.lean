module

public import Aglib.AlgebraicGeometry.IdealSheaf.BaseChange.Epimorphism
public import Aglib.AlgebraicGeometry.IdealSheaf.Comap
public import Aglib.AlgebraicGeometry.IdealSheaf.LocallyClosed
public import Aglib.AlgebraicGeometry.IdealSheaf.QuotientModule
public import Aglib.AlgebraicGeometry.Modules.Pullback.Free
public import Aglib.Algebra.Category.ModuleCat.Sheaf.Epimorphisms

/-!
# Pullback of the structure module of a closed subscheme, without flatness

Let `f : Y ⟶ X` be any morphism of schemes and `I : X.IdealSheafData`, with closed immersions
`i = I.subschemeι` and `i' = (I.comap f).subschemeι`. The structure module of `V(I)` on `X` is
`I.quotientModule = 𝒪_X / I = cokernel (idealInclusion i)`, the cokernel of the actual ideal
inclusion (`IdealSheaf/QuotientModule`).

* `Scheme.Hom.surjective_idealPullbackMap_app_of_le_map`: for any commutative square and opens
  `V ≤ b ⁻¹ᵁ U`, the ideal comparison `b^* I_i ⟶ I_{i'}` (`Scheme.Hom.idealPullbackMap`) is
  surjective on sections over `V` once `ker (i'.app V)` lies in the ideal generated by the image
  of `ker (i.app U)`. The generator `b.appLE U V x` of that ideal is the image of the section of
  `b^* I_i` given by the adjunction unit at `x`.
* `Scheme.IdealSheafData.surjective_idealPullbackMap_app`: this applies to `i` and `i'` on affine
  opens `V ≤ f ⁻¹ᵁ U`, where `(I.comap f).ideal V = I(U) · Γ(Y, V)`
  (`ideal_comap_eq_map_appLE`): the comparison is surjective on affine sections.
* `Scheme.IdealSheafData.epi_idealPullbackMap`: `f^* I ⟶ I'` is an epimorphism, the instance of
  `Scheme.Hom.idealPullbackMap_epi_of_isPullback` (`IdealSheaf/BaseChange/Epimorphism`) at the
  cartesian square of `I.comap f` (Mathlib's `isPullback_of_isClosedImmersion`). Hence the
  factorisation `f^* I ⟶ I' ⟶ 𝒪_Y` of
  `pullbackIdealToUnit I f : f^* I ⟶ f^* 𝒪_X ≅ 𝒪_Y` is its image factorisation
  (`pullbackIdealMonoFactorisationIsImage`, `pullbackIdealImageIso`): the image of
  `f^* I ⟶ 𝒪_Y` is the ideal module of `I.comap f`.
* `Scheme.IdealSheafData.quotientModulePullbackIso`: `f^* 𝒪_W ≅ 𝒪_{W.comap f}`, by right
  exactness of the pullback (`PreservesCokernel.iso`) and `cokernelEpiComp`; it is compatible with
  the projections (`pullback_map_toQuotientModule_quotientModulePullbackIso_hom`). In the
  pushforward presentation `𝒪_W ≅ i_* 𝒪_W` it reads `f^* i_* 𝒪_W ≅ i'_* 𝒪_{W.comap f}`
  (`pushforwardUnitPullbackIso`).

There is no hypothesis beyond `IdealSheafData` (a quasi-coherent ideal): no flatness, Noetherian
or cartesian-square hypothesis. The ideal of the base change of a closed immersion is the image
of the pulled-back ideal (Stacks Project, Tag 01JU, Lemma 26.17.6 (1)), whose source is the
statement that this image cuts out the fiber product (Stacks Project, Tag 01HQ, Lemma 26.4.7); and
`f^*` is right exact (Stacks Project, Tag 01AJ, Lemma 17.3.3).
-/

@[expose] public section

noncomputable section
set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open CategoryTheory Limits Opposite TopologicalSpace
open AlgebraicGeometry.Scheme.Hom

universe u

namespace AlgebraicGeometry

namespace Scheme.Hom

variable {X Y D D' : Scheme.{u}} (i : D ⟶ X) (i' : D' ⟶ Y) (b : Y ⟶ X) (a : D' ⟶ D)
  (h : a ≫ i = i' ≫ b)

/-- The adjunction unit followed by the pushforward of the ideal comparison and the ideal
inclusion is the ideal inclusion followed by the structure-module map of `b`. -/
@[reassoc]
theorem unit_pushforward_map_idealPullbackMap_inclusion :
    (Scheme.Modules.pullbackPushforwardAdjunction b).unit.app (idealModule i) ≫
      (Scheme.Modules.pushforward b).map (idealPullbackMap i i' b a h ≫ idealInclusion i') =
    idealInclusion i ≫ structureModuleMap b :=
  ((Scheme.Modules.pullbackPushforwardAdjunction b).homEquiv_unit _ _ _).symm.trans
    ((((Scheme.Modules.pullbackPushforwardAdjunction b).homEquiv_naturality_right _ _).trans
      (congrArg (· ≫ (Scheme.Modules.pushforward b).map (idealInclusion i'))
        (idealPullbackMap_adjoint i i' b a h))).trans
      (idealPushforwardMap_inclusion i i' b a h))

/-- Elementwise form of `unit_pushforward_map_idealPullbackMap_inclusion`: the section of
`b^* I_i` on `b ⁻¹ᵁ U` given by the adjunction unit at a section `m` of `I_i` on `U` maps to
`b.app U` of the section `m` of `𝒪_X`. -/
theorem idealInclusion_idealPullbackMap_unit_apply (U : X.Opens)
    (m : (idealModule i).val.obj (op U)) :
    (idealInclusion i').val.app (op (b ⁻¹ᵁ U))
        ((idealPullbackMap i i' b a h).val.app (op (b ⁻¹ᵁ U))
          (((Scheme.Modules.pullbackPushforwardAdjunction b).unit.app (idealModule i)).val.app
            (op U) m)) =
      b.app U ((idealInclusion i).val.app (op U) m) :=
  congrArg (fun φ => φ.val.app (op U) m)
    (unit_pushforward_map_idealPullbackMap_inclusion i i' b a h)

/-- **Surjectivity criterion for the ideal comparison on sections**: for a commutative square
`a ≫ i = i' ≫ b` and opens `U` of `X` and `V ≤ b ⁻¹ᵁ U` of `Y`, if `ker (i'.app V)` lies in the
ideal generated by the image of `ker (i.app U)` under `b.appLE U V`, then the ideal comparison
`b^* I_i ⟶ I_{i'}` is surjective on sections over `V`. -/
theorem surjective_idealPullbackMap_app_of_le_map (U : X.Opens) (V : Y.Opens)
    (hVU : V ≤ b ⁻¹ᵁ U)
    (hle : RingHom.ker (i'.app V).hom ≤
      Ideal.map (b.appLE U V hVU).hom (RingHom.ker (i.app U).hom)) :
    Function.Surjective ((idealPullbackMap i i' b a h).val.app (op V)) := by
  have hinj : Function.Injective ((idealInclusion i').val.app (op V)) := by
    intro n₁ n₂ hn
    apply (idealSectionsEquiv i' V).injective
    apply Subtype.ext
    rw [idealSectionsEquiv_val, idealSectionsEquiv_val]
    exact hn
  let J : Ideal Γ(Y, V) :=
    { carrier := {r | ∃ p, (idealInclusion i').val.app (op V)
          ((idealPullbackMap i i' b a h).val.app (op V) p) = r}
      add_mem' := by
        rintro _ _ ⟨p₁, rfl⟩ ⟨p₂, rfl⟩
        exact ⟨p₁ + p₂, by rw [map_add, map_add]⟩
      zero_mem' := ⟨0, by rw [map_zero, map_zero]⟩
      smul_mem' := by
        rintro c _ ⟨p, rfl⟩
        exact ⟨(show Y.ringCatSheaf.obj.obj (op V) from c) • p,
          by rw [map_smul, map_smul]⟩ }
  have hgen : Ideal.map (b.appLE U V hVU).hom (RingHom.ker (i.app U).hom) ≤ J := by
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    obtain ⟨m, rfl⟩ : ∃ m, (idealInclusion i).val.app (op U) m = x :=
      ⟨(idealSectionsEquiv i U).symm ⟨x, hx⟩, by
        rw [← idealSectionsEquiv_val, LinearEquiv.apply_symm_apply]⟩
    refine ⟨((Scheme.Modules.pullback b).obj (idealModule i)).val.map (homOfLE hVU).op
      (((Scheme.Modules.pullbackPushforwardAdjunction b).unit.app (idealModule i)).val.app
        (op U) m), ?_⟩
    rw [PresheafOfModules.naturality_apply, PresheafOfModules.naturality_apply,
      idealInclusion_idealPullbackMap_unit_apply]
    rfl
  intro n
  have hn : (idealInclusion i').val.app (op V) n ∈ J := by
    apply hgen
    apply hle
    rw [← idealSectionsEquiv_val]
    exact ((idealSectionsEquiv i' V) n).2
  obtain ⟨p, hp⟩ := hn
  exact ⟨p, hinj hp⟩

end Scheme.Hom

namespace Scheme.IdealSheafData

variable {X Y : Scheme.{u}}

/-- **Surjectivity of the ideal comparison on affine sections**: for `f : Y ⟶ X`, a closed
subscheme `I` and affine opens `U` of `X` and `V ≤ f ⁻¹ᵁ U` of `Y`, the ideal comparison
`f^* I ⟶ I_{I.comap f}` is surjective on sections over `V`, since
`(I.comap f).ideal V = I(U) · Γ(Y, V)`. -/
theorem surjective_idealPullbackMap_app (I : X.IdealSheafData) (f : Y ⟶ X)
    (a : (I.comap f).subscheme ⟶ I.subscheme)
    (h : a ≫ I.subschemeι = (I.comap f).subschemeι ≫ f)
    (U : X.affineOpens) (V : Y.affineOpens) (hVU : V.1 ≤ f ⁻¹ᵁ U.1) :
    Function.Surjective
      ((idealPullbackMap I.subschemeι (I.comap f).subschemeι f a h).val.app (op V.1)) := by
  refine surjective_idealPullbackMap_app_of_le_map _ _ f a h U.1 V.1 hVU ?_
  rw [ker_subschemeι_app (I.comap f) V, ker_subschemeι_app I U,
    ideal_comap_eq_map_appLE I f U V hVU]

/-- **The ideal comparison of a pulled-back closed subscheme is an epimorphism**: for any
`f : Y ⟶ X` and closed subscheme `I`, the canonical map `f^* I ⟶ I_{I.comap f}` is an
epimorphism. This is `Scheme.Hom.idealPullbackMap_epi_of_isPullback` for the cartesian square of
`I.comap f` (Mathlib's `isPullback_of_isClosedImmersion`). -/
theorem epi_idealPullbackMap (I : X.IdealSheafData) (f : Y ⟶ X)
    (a : (I.comap f).subscheme ⟶ I.subscheme)
    (h : a ≫ I.subschemeι = (I.comap f).subschemeι ≫ f) :
    Epi (idealPullbackMap I.subschemeι (I.comap f).subschemeι f a h) :=
  idealPullbackMap_epi_of_isPullback _ _ f a h
    (isPullback_of_isClosedImmersion (I.comap f).subschemeι I.subschemeι a f h.symm
      (by simp)).flip

/-- The ideal comparison of the canonical square of the pulled-back closed subscheme, through
Mathlib's `subschemeMap`, is an epimorphism. -/
instance epi_idealPullbackMap_subschemeMap (I : X.IdealSheafData) (f : Y ⟶ X) :
    Epi (idealPullbackMap I.subschemeι (I.comap f).subschemeι f
      (subschemeMap (I.comap f) I f (I.le_map_comap f))
      (subschemeMap_subschemeι (I.comap f) I f (I.le_map_comap f))) :=
  epi_idealPullbackMap I f _ _

/-- The pulled-back ideal inclusion `f^* I ⟶ f^* 𝒪_X ≅ 𝒪_Y`. -/
def pullbackIdealToUnit (I : X.IdealSheafData) (f : Y ⟶ X) :
    (Scheme.Modules.pullback f).obj (idealModule I.subschemeι) ⟶
      (show Y.Modules from SheafOfModules.unit Y.ringCatSheaf) :=
  (Scheme.Modules.pullback f).map (idealInclusion I.subschemeι) ≫
    (Scheme.Modules.pullbackUnitIso f).hom

/-- The epi–mono factorisation `f^* I ⟶ I_{I.comap f} ⟶ 𝒪_Y` of the pulled-back ideal
inclusion `f^* I ⟶ f^* 𝒪_X ≅ 𝒪_Y`. -/
@[simps]
def pullbackIdealMonoFactorisation (I : X.IdealSheafData) (f : Y ⟶ X) :
    MonoFactorisation (pullbackIdealToUnit I f) where
  I := idealModule (I.comap f).subschemeι
  m := idealInclusion (I.comap f).subschemeι
  e := idealPullbackMap I.subschemeι (I.comap f).subschemeι f
    (subschemeMap (I.comap f) I f (I.le_map_comap f))
    (subschemeMap_subschemeι (I.comap f) I f (I.le_map_comap f))
  fac := idealPullbackMap_inclusion _ _ _ _ _

/-- **The image of the pulled-back ideal is the ideal of the pulled-back closed subscheme**
(Stacks Project, Tag 01JU, Lemma 26.17.6 (1), whose source is Tag 01HQ, Lemma 26.4.7): the
factorisation `f^* I ⟶ I_{I.comap f} ⟶ 𝒪_Y` is an image factorisation, since its first map is an
epimorphism (`epi_idealPullbackMap`). -/
def pullbackIdealMonoFactorisationIsImage (I : X.IdealSheafData) (f : Y ⟶ X) :
    IsImage (pullbackIdealMonoFactorisation I f) :=
  haveI : Epi (pullbackIdealMonoFactorisation I f).e := epi_idealPullbackMap I f _ _
  haveI : StrongEpi (pullbackIdealMonoFactorisation I f).e := strongEpi_of_epi _
  StrongEpiMonoFactorisation.toMonoIsImage
    (StrongEpiMonoFactorisation.mk (pullbackIdealMonoFactorisation I f))

/-- The image of `f^* I ⟶ f^* 𝒪_X ≅ 𝒪_Y` is the ideal module of `I.comap f`. -/
def pullbackIdealImageIso (I : X.IdealSheafData) (f : Y ⟶ X) :
    Limits.image (pullbackIdealToUnit I f) ≅ idealModule (I.comap f).subschemeι :=
  IsImage.isoExt (Image.isImage _) (pullbackIdealMonoFactorisationIsImage I f)

@[reassoc (attr := simp)]
theorem pullbackIdealImageIso_hom_inclusion (I : X.IdealSheafData) (f : Y ⟶ X) :
    (pullbackIdealImageIso I f).hom ≫ idealInclusion (I.comap f).subschemeι =
      Limits.image.ι (pullbackIdealToUnit I f) :=
  IsImage.isoExt_hom_m _ _

/-- **The structure module of a closed subscheme under pullback, without flatness**: for any
`f : Y ⟶ X` and closed subscheme `W ⊆ X`, `f^* 𝒪_W ≅ 𝒪_{W.comap f}`, where `𝒪_W = 𝒪_X / I_W` is
the cokernel of the actual ideal inclusion. -/
def quotientModulePullbackIso (W : X.IdealSheafData) (f : Y ⟶ X) :
    (Scheme.Modules.pullback f).obj W.quotientModule ≅ (W.comap f).quotientModule :=
  haveI : PreservesColimitsOfSize.{0, 0} (Scheme.Modules.pullback f) :=
    (Scheme.Modules.pullbackPushforwardAdjunction f).leftAdjoint_preservesColimits
  PreservesCokernel.iso (Scheme.Modules.pullback f) (idealInclusion W.subschemeι) ≪≫
    cokernel.mapIso _ (idealPullbackMap W.subschemeι (W.comap f).subschemeι f
        (subschemeMap (W.comap f) W f (W.le_map_comap f))
        (subschemeMap_subschemeι (W.comap f) W f (W.le_map_comap f)) ≫
          idealInclusion (W.comap f).subschemeι) (Iso.refl _)
      (Scheme.Modules.pullbackUnitIso f)
      (by rw [Iso.refl_hom, Category.id_comp]; exact (idealPullbackMap_inclusion _ _ _ _ _).symm) ≪≫
    cokernelEpiComp (idealPullbackMap W.subschemeι (W.comap f).subschemeι f
        (subschemeMap (W.comap f) W f (W.le_map_comap f))
        (subschemeMap_subschemeι (W.comap f) W f (W.le_map_comap f)))
      (idealInclusion (W.comap f).subschemeι)

/-- `quotientModulePullbackIso` is compatible with the projections `𝒪 ⟶ 𝒪 / I`. -/
@[reassoc (attr := simp)]
theorem pullback_map_toQuotientModule_quotientModulePullbackIso_hom (W : X.IdealSheafData)
    (f : Y ⟶ X) :
    (Scheme.Modules.pullback f).map W.toQuotientModule ≫ (W.quotientModulePullbackIso f).hom =
      (Scheme.Modules.pullbackUnitIso f).hom ≫ (W.comap f).toQuotientModule := by
  change (Scheme.Modules.pullback f).map (cokernel.π (idealInclusion W.subschemeι)) ≫
      (W.quotientModulePullbackIso f).hom =
    (Scheme.Modules.pullbackUnitIso f).hom ≫ cokernel.π (idealInclusion (W.comap f).subschemeι)
  simp [quotientModulePullbackIso, cokernel.map]

/-- **The pushforward presentation**: for any `f : Y ⟶ X` and closed subscheme `W ⊆ X`, the
pullback of `i_* 𝒪_W`, `i = W.subschemeι`, is `i'_* 𝒪_{W.comap f}`, `i' = (W.comap f).subschemeι`
(`quotientModuleIsoPushforward` on both sides). -/
def pushforwardUnitPullbackIso (W : X.IdealSheafData) (f : Y ⟶ X) :
    (Scheme.Modules.pullback f).obj ((Scheme.Modules.pushforward W.subschemeι).obj
        (SheafOfModules.unit W.subscheme.ringCatSheaf)) ≅
      (Scheme.Modules.pushforward (W.comap f).subschemeι).obj
        (SheafOfModules.unit (W.comap f).subscheme.ringCatSheaf) :=
  (Scheme.Modules.pullback f).mapIso W.quotientModuleIsoPushforward.symm ≪≫
    W.quotientModulePullbackIso f ≪≫ (W.comap f).quotientModuleIsoPushforward

end Scheme.IdealSheafData

end AlgebraicGeometry
