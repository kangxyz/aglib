module

public import Aglib.AlgebraicGeometry.IdealSheaf.Glue
public import Aglib.AlgebraicGeometry.Descent.IdealSheaf.Pullback
public import Mathlib.AlgebraicGeometry.Morphisms.Immersion

/-!
# Pullback of ideal sheaves on affine opens, and locally closed subschemes

For a morphism `g : Y ⟶ X`, affine opens `U` of `X` and `V` of `Y` with `V ≤ g ⁻¹ᵁ U`, the ideal of
the pulled-back ideal sheaf on `V` is generated by the image of the ideal on `U`
(`Scheme.IdealSheafData.ideal_comap_eq_map_appLE`): this is the affine description of the inverse
image ideal sheaf `g⁻¹ I · 𝒪_Y`: the base change of a closed immersion is cut out by the image of
`g^* I → 𝒪_Y` (Stacks Project, Tag 01JU, Lemma 26.17.6 (1)). A point `fromSpec p` of an affine
open `V` lies in the support of `I` if and only if `I.ideal V ⊆ p` (`fromSpec_mem_support_iff`).

The second half describes the morphisms into closed and locally closed subschemes through the
pullback of ideal sheaves:

* `exists_lift_subschemeι_iff`: `g` factors through the closed subscheme `V(I)` if and only if
  `I.comap g = ⊥`;
* `range_subset_compl_support_iff`: `g` lands in the complement of `V(J)` if and only if
  `J.comap g = ⊤`;
* `locallyClosedι I J`: the immersion of the open subscheme of `V(I)` complementary to `V(J)`,
  and `exists_lift_locallyClosedι_iff`: `g` factors through it if and only if `I.comap g = ⊥` and
  `J.comap g = ⊤`.
* `comap_iSup_eq_bot_iff`, `comap_mul_eq_top_iff`, `comap_finset_prod_eq_top_iff`: the pullback
  of a supremum vanishes iff every pullback does, and the pullback of a (finite) product is the unit
  ideal sheaf iff the pullback of every factor is.

These are the scheme-level forms of the universal property of a locally closed subscheme cut out
by a pair of quasi-coherent ideal sheaves; they are used for the Fitting strata of the flattening
stratification.
-/

@[expose] public section

noncomputable section

universe u

open CategoryTheory Opposite Limits TopologicalSpace

namespace AlgebraicGeometry

variable {X Y : Scheme.{u}}

/-- For an open immersion `j` and opens `A ≤ j ⁻¹ᵁ B` with `B ≤ j ''ᵁ A`, the restriction map
`j.appLE B A` is surjective. -/
lemma Scheme.Hom.appLE_surjective_of_le_image (j : Y ⟶ X) [IsOpenImmersion j] {B : X.Opens}
    {A : Y.Opens} (h : A ≤ j ⁻¹ᵁ B) (hB : B ≤ j ''ᵁ A) :
    Function.Surjective (j.appLE B A h).hom := by
  have hA : A ≤ j ⁻¹ᵁ (j ''ᵁ A) := (j.preimage_image_eq A).ge
  have e1 : X.presheaf.map (homOfLE hB).op ≫ j.appLE B A h = j.appLE (j ''ᵁ A) A hA :=
    j.map_appLE h (homOfLE hB).op
  have e2 := j.appIso_inv_appLE hA
  intro y
  refine ⟨(X.presheaf.map (homOfLE hB).op).hom ((j.appIso A).inv.hom y), ?_⟩
  have h1 := congrArg (fun φ => φ.hom ((j.appIso A).inv.hom y)) e1
  have h2 := congrArg (fun φ => φ.hom y) e2
  simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h1 h2
  rw [h1, h2]
  simp

namespace Scheme.IdealSheafData

/-- Along an open immersion `j`, for affine opens `A` of the source and `B` of the target with
`A ≤ j ⁻¹ᵁ B` and `B ≤ j ''ᵁ A`, the pulled-back ideal on `A` is the image of the ideal on `B`. -/
lemma ideal_comap_eq_map_appLE_of_isOpenImmersion (I : X.IdealSheafData) (j : Y ⟶ X)
    [IsOpenImmersion j] (B : X.affineOpens) (A : Y.affineOpens) (h : A.1 ≤ j ⁻¹ᵁ B.1)
    (hB : B.1 ≤ j ''ᵁ A.1) :
    (I.comap j).ideal A = (I.ideal B).map (j.appLE B A h).hom := by
  apply le_antisymm
  · have hs := j.appLE_surjective_of_le_image h hB
    rw [← Ideal.map_comap_of_surjective _ hs ((I.comap j).ideal A)]
    exact Ideal.map_mono (ideal_comap_appLE_ideal_comap_le I j B A h hB)
  · exact Ideal.map_le_iff_le_comap.mpr (ideal_le_comap_appLE_ideal_comap I j B A h)

/-- `appLE` along equal morphisms. -/
private lemma appLE_congr_of_eq {φ ψ : Y ⟶ X} (e : φ = ψ) (U : X.Opens) (V : Y.Opens)
    (h : V ≤ φ ⁻¹ᵁ U) (h' : V ≤ ψ ⁻¹ᵁ U) : φ.appLE U V h = ψ.appLE U V h' := by
  subst e
  rfl

/-- `appLE ⊤ ⊤` is `appTop`. -/
private lemma appLE_top_top {Z W : Scheme.{u}} (f : Z ⟶ W) (e : (⊤ : Z.Opens) ≤ f ⁻¹ᵁ ⊤) :
    f.appLE ⊤ ⊤ e = f.appTop :=
  (show f.appLE ⊤ ⊤ e = f.appLE ⊤ (f ⁻¹ᵁ ⊤) le_rfl from rfl).trans f.appLE_eq_app

/-- **Pullback of an ideal sheaf on affine opens.** For `g : Y ⟶ X` and affine opens `U` of `X`
and `V` of `Y` with `V ≤ g ⁻¹ᵁ U`, the ideal of `I.comap g` on `V` is generated by the image of
`I.ideal U` under `g.appLE U V`. -/
lemma ideal_comap_eq_map_appLE (I : X.IdealSheafData) (g : Y ⟶ X) (U : X.affineOpens)
    (V : Y.affineOpens) (h : V.1 ≤ g ⁻¹ᵁ U.1) :
    (I.comap g).ideal V = (I.ideal U).map (g.appLE U V h).hom := by
  have : IsAffine V.1.toScheme := V.2
  have : IsAffine U.1.toScheme := U.2
  have hV : (⊤ : V.1.toScheme.Opens) ≤ V.1.ι ⁻¹ᵁ V.1 := V.1.ι_preimage_self.ge
  have hU : (⊤ : U.1.toScheme.Opens) ≤ U.1.ι ⁻¹ᵁ U.1 := U.1.ι_preimage_self.ge
  have hc : (I.comap g).comap V.1.ι = (I.comap U.1.ι).comap (g.resLE U.1 V.1 h) := by
    rw [← comap_comp, ← comap_comp, Scheme.Hom.resLE_comp_ι]
  have hA := ideal_comap_top_of_isAffine (I.comap U.1.ι) (g.resLE U.1 V.1 h)
  rw [← hc, ideal_comap_eq_map_appLE_of_isOpenImmersion (I.comap g) V.1.ι V
      ⟨⊤, isAffineOpen_top _⟩ hV V.1.ι_image_top.ge,
    ideal_comap_eq_map_appLE_of_isOpenImmersion I U.1.ι U ⟨⊤, isAffineOpen_top _⟩ hU
      U.1.ι_image_top.ge, Ideal.map_map] at hA
  have hA' : Ideal.map (V.1.ι.appLE V.1 ⊤ hV).hom ((I.comap g).ideal V) =
      Ideal.map ((U.1.ι.appLE U.1 ⊤ hU ≫ (g.resLE U.1 V.1 h).appTop).hom) (I.ideal U) := hA
  have key : U.1.ι.appLE U.1 ⊤ hU ≫ (g.resLE U.1 V.1 h).appTop =
      g.appLE U.1 V.1 h ≫ V.1.ι.appLE V.1 ⊤ hV := by
    have e : (⊤ : V.1.toScheme.Opens) ≤ g.resLE U.1 V.1 h ⁻¹ᵁ ⊤ := le_top
    rw [← appLE_top_top _ e, Scheme.Hom.appLE_comp_appLE, Scheme.Hom.appLE_comp_appLE]
    exact appLE_congr_of_eq (g.resLE_comp_ι h) U.1 ⊤ _ _
  rw [key, CommRingCat.hom_comp, ← Ideal.map_map] at hA'
  have hb : Function.Bijective (V.1.ι.appLE V.1 ⊤ hV).hom :=
    ConcreteCategory.bijective_of_isIso (V.1.ι.appLE V.1 ⊤ V.1.ι_preimage_self.ge)
  rw [← Ideal.comap_map_of_bijective _ hb (I := (I.comap g).ideal V), hA',
    Ideal.comap_map_of_bijective _ hb]

/-- The affine opens `V` of `Y` lying over some affine open `U` of `X` cover `Y`. -/
lemma iSup_affineOpens_le_preimage_eq_top (g : Y ⟶ X) :
    ⨆ p : {p : X.affineOpens × Y.affineOpens // p.2.1 ≤ g ⁻¹ᵁ p.1.1}, p.1.2.1 = ⊤ := by
  refine top_le_iff.mp fun t _ => ?_
  obtain ⟨_, ⟨U, hU, rfl⟩, hgt, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ (g t)) isOpen_univ
  obtain ⟨_, ⟨V, hV, rfl⟩, htV, hVle⟩ :=
    Y.isBasis_affineOpens.exists_subset_of_mem_open (show t ∈ g ⁻¹ᵁ U from hgt) (g ⁻¹ᵁ U).isOpen
  exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨(⟨U, hU⟩, ⟨V, hV⟩), hVle⟩, htV⟩

/-- A pulled-back ideal sheaf vanishes if and only if, for all affine opens `V ≤ g ⁻¹ᵁ U`, the
image of `I.ideal U` in `Γ(Y, V)` vanishes. -/
lemma comap_eq_bot_iff_forall (I : X.IdealSheafData) (g : Y ⟶ X) :
    I.comap g = ⊥ ↔ ∀ (U : X.affineOpens) (V : Y.affineOpens) (h : V.1 ≤ g ⁻¹ᵁ U.1),
      (I.ideal U).map (g.appLE U V h).hom = ⊥ := by
  refine ⟨fun hI U V h => by rw [← ideal_comap_eq_map_appLE, hI]; rfl, fun H => ?_⟩
  refine ext_of_iSup_eq_top _ (iSup_affineOpens_le_preimage_eq_top g) fun p => ?_
  rw [ideal_comap_eq_map_appLE _ g p.1.1 p.1.2 p.2, H]
  rfl

/-- A pulled-back ideal sheaf is the unit ideal sheaf if and only if, for all affine opens
`V ≤ g ⁻¹ᵁ U`, the image of `I.ideal U` generates the unit ideal of `Γ(Y, V)`. -/
lemma comap_eq_top_iff_forall (I : X.IdealSheafData) (g : Y ⟶ X) :
    I.comap g = ⊤ ↔ ∀ (U : X.affineOpens) (V : Y.affineOpens) (h : V.1 ≤ g ⁻¹ᵁ U.1),
      (I.ideal U).map (g.appLE U V h).hom = ⊤ := by
  refine ⟨fun hI U V h => by rw [← ideal_comap_eq_map_appLE, hI]; rfl, fun H => ?_⟩
  refine ext_of_iSup_eq_top _ (iSup_affineOpens_le_preimage_eq_top g) fun p => ?_
  rw [ideal_comap_eq_map_appLE _ g p.1.1 p.1.2 p.2, H]
  rfl

/-- A point `hV.fromSpec p` of an affine open `V` lies in the support of an ideal sheaf `I` if and
only if `I.ideal V ⊆ p`. -/
lemma fromSpec_mem_support_iff (I : X.IdealSheafData) (V : X.affineOpens)
    (p : PrimeSpectrum Γ(X, V)) :
    (show IsAffineOpen V.1 from V.2).fromSpec p ∈ I.support ↔ I.ideal V ≤ p.asIdeal := by
  have hV : IsAffineOpen V.1 := V.2
  have hmem : hV.fromSpec p ∈ V.1 := hV.range_fromSpec.subset ⟨p, rfl⟩
  rw [mem_support_iff_of_mem (U := V) hmem, ← SetLike.coe_subset_coe,
    ← PrimeSpectrum.mem_zeroLocus]
  constructor
  · intro h
    have h' : hV.fromSpec p ∈ hV.fromSpec '' PrimeSpectrum.zeroLocus (I.ideal V : Set Γ(X, V)) := by
      rw [hV.fromSpec_image_zeroLocus]
      exact ⟨h, hmem⟩
    obtain ⟨q, hq, hqp⟩ := h'
    exact hV.fromSpec.isOpenEmbedding.injective hqp ▸ hq
  · intro h
    have h' : hV.fromSpec p ∈ hV.fromSpec '' PrimeSpectrum.zeroLocus (I.ideal V : Set Γ(X, V)) :=
      ⟨p, h, rfl⟩
    rw [hV.fromSpec_image_zeroLocus] at h'
    exact h'.1

/-- The ideal sheaf of a closed subscheme pulls back to zero on it. -/
lemma comap_subschemeι_self (I : X.IdealSheafData) : I.comap I.subschemeι = ⊥ :=
  le_bot_iff.mp ((le_map_iff_comap_le (I := ⊥) (f := I.subschemeι) (J := I)).mp
    (by rw [map_bot, ker_subschemeι]))

/-- A morphism factors through the closed subscheme `V(I)` if and only if the pullback of `I`
vanishes. -/
lemma exists_lift_subschemeι_iff (I : X.IdealSheafData) (g : Y ⟶ X) :
    (∃ g' : Y ⟶ I.subscheme, g' ≫ I.subschemeι = g) ↔ I.comap g = ⊥ := by
  constructor
  · rintro ⟨g', rfl⟩
    rw [comap_comp, comap_subschemeι_self, comap_bot]
  · intro h
    have H : I.subschemeι.ker ≤ g.ker := by
      rw [ker_subschemeι, ← map_bot, le_map_iff_comap_le, h]
    exact ⟨IsClosedImmersion.lift I.subschemeι g H, IsClosedImmersion.lift_fac _ _ _⟩

/-- A morphism lands in the complement of the support of `J` if and only if the pullback of `J`
is the unit ideal sheaf. -/
lemma range_subset_compl_support_iff (J : X.IdealSheafData) (g : Y ⟶ X) :
    Set.range g ⊆ (J.support.compl : Set X) ↔ J.comap g = ⊤ := by
  rw [← support_eq_bot_iff, support_comap, ← SetLike.coe_set_eq, Closeds.coe_preimage,
    Closeds.coe_bot, Set.eq_empty_iff_forall_notMem, Set.range_subset_iff, Closeds.coe_compl]
  rfl

/-- The open subscheme of `V(I)` complementary to `V(J)`. -/
def locallyClosedOpen (I J : X.IdealSheafData) : I.subscheme.Opens :=
  (J.comap I.subschemeι).support.compl

/-- The locally closed subscheme `V(I) \ V(J)` of `X`, as an open subscheme of `V(I)`. -/
abbrev locallyClosed (I J : X.IdealSheafData) : Scheme.{u} :=
  (locallyClosedOpen I J).toScheme

/-- The immersion of the locally closed subscheme `V(I) \ V(J)` into `X`. -/
def locallyClosedι (I J : X.IdealSheafData) : locallyClosed I J ⟶ X :=
  (locallyClosedOpen I J).ι ≫ I.subschemeι

instance (I J : X.IdealSheafData) : IsImmersion (locallyClosedι I J) := by
  unfold locallyClosedι
  infer_instance

/-- The ideal `J` pulls back to the unit ideal sheaf on `V(I) \ V(J)`. -/
lemma comap_locallyClosedOpenι (I J : X.IdealSheafData) :
    (J.comap I.subschemeι).comap (locallyClosedOpen I J).ι = ⊤ := by
  rw [← range_subset_compl_support_iff, Scheme.Opens.range_ι]
  rfl

/-- **Universal property of `V(I) \ V(J)`.** A morphism `g` factors through the locally closed
subscheme `V(I) \ V(J)` if and only if `I.comap g = ⊥` and `J.comap g = ⊤`. -/
lemma exists_lift_locallyClosedι_iff (I J : X.IdealSheafData) (g : Y ⟶ X) :
    (∃ g' : Y ⟶ locallyClosed I J, g' ≫ locallyClosedι I J = g) ↔
      I.comap g = ⊥ ∧ J.comap g = ⊤ := by
  constructor
  · rintro ⟨g', rfl⟩
    refine ⟨(exists_lift_subschemeι_iff I _).mp ⟨g' ≫ (locallyClosedOpen I J).ι, ?_⟩, ?_⟩
    · rw [locallyClosedι, Category.assoc]
    · rw [locallyClosedι, comap_comp, comap_comp, comap_locallyClosedOpenι, comap_top]
  · rintro ⟨hI, hJ⟩
    obtain ⟨g', hg'⟩ := (exists_lift_subschemeι_iff I g).mpr hI
    have h2 : (J.comap I.subschemeι).comap g' = ⊤ := by rw [← comap_comp, hg', hJ]
    have h3 := (range_subset_compl_support_iff _ g').mpr h2
    refine ⟨IsOpenImmersion.lift (locallyClosedOpen I J).ι g'
      (by rw [Scheme.Opens.range_ι]; exact h3), ?_⟩
    rw [locallyClosedι, ← Category.assoc, IsOpenImmersion.lift_fac, hg']

/-- The image of the locally closed subscheme `V(I) \ V(J)` is the set-theoretic difference of the
supports. -/
lemma range_locallyClosedι (I J : X.IdealSheafData) :
    Set.range (locallyClosedι I J) = (I.support : Set X) \ J.support := by
  ext x
  constructor
  · rintro ⟨w, rfl⟩
    have hw : (locallyClosedOpen I J).ι w ∈ ((locallyClosedOpen I J : I.subscheme.Opens) :
        Set I.subscheme) := (locallyClosedOpen I J).range_ι ▸ ⟨w, rfl⟩
    change (locallyClosedOpen I J).ι w ∉ (J.comap I.subschemeι).support at hw
    rw [support_comap] at hw
    refine ⟨?_, hw⟩
    rw [← range_subschemeι]
    exact ⟨_, rfl⟩
  · rintro ⟨hx, hJ⟩
    obtain ⟨z, rfl⟩ : x ∈ Set.range I.subschemeι := by
      rw [range_subschemeι]
      exact hx
    have hz : z ∈ ((locallyClosedOpen I J : I.subscheme.Opens) : Set I.subscheme) := by
      change z ∉ (J.comap I.subschemeι).support
      rw [support_comap]
      exact hJ
    obtain ⟨w, hw⟩ : z ∈ Set.range (locallyClosedOpen I J).ι := by
      rw [Scheme.Opens.range_ι]
      exact hz
    exact ⟨w, by rw [locallyClosedι, Scheme.Hom.comp_apply, hw]⟩

/-- The pullback of a supremum of ideal sheaves vanishes exactly when every pullback does. -/
lemma comap_iSup_eq_bot_iff {ι : Sort*} (J : ι → X.IdealSheafData) (g : Y ⟶ X) :
    (⨆ i, J i).comap g = ⊥ ↔ ∀ i, (J i).comap g = ⊥ := by
  have key : ∀ K : X.IdealSheafData, K.comap g = ⊥ ↔ K ≤ (⊥ : Y.IdealSheafData).map g :=
    fun K => le_bot_iff.symm.trans (map_gc g K ⊥)
  rw [key, iSup_le_iff]
  exact forall_congr' fun i => (key (J i)).symm

/-- The pullback of a product of two ideal sheaves is the unit ideal sheaf exactly when both
pullbacks are. -/
lemma comap_mul_eq_top_iff (K L : X.IdealSheafData) (g : Y ⟶ X) :
    (K * L).comap g = ⊤ ↔ K.comap g = ⊤ ∧ L.comap g = ⊤ := by
  rw [← range_subset_compl_support_iff, ← range_subset_compl_support_iff,
    ← range_subset_compl_support_iff, support_mul, Closeds.coe_compl, Closeds.coe_compl,
    Closeds.coe_compl, Closeds.coe_sup, Set.compl_union, Set.subset_inter_iff]

/-- The pullback of a finite product of ideal sheaves is the unit ideal sheaf exactly when every
factor pulls back to the unit ideal sheaf. -/
lemma comap_finset_prod_eq_top_iff {ι : Type*} (s : Finset ι) (K : ι → X.IdealSheafData)
    (g : Y ⟶ X) : (∏ j ∈ s, K j).comap g = ⊤ ↔ ∀ j ∈ s, (K j).comap g = ⊤ := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    rw [Finset.prod_empty]
    exact ⟨fun _ j hj => absurd hj (Finset.notMem_empty j), fun _ => comap_top g⟩
  | insert a s ha ih =>
    rw [Finset.prod_insert ha, comap_mul_eq_top_iff, ih, Finset.forall_mem_insert]

end Scheme.IdealSheafData

end AlgebraicGeometry
