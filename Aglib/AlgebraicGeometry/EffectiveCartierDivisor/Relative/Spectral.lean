/-!
# Spectral fibrewise criterion for relative effective Cartier divisors

For ring maps `ψ : R ⟶ A` and `φ : A ⟶ B` with `Spec A ⟶ Spec R` flat and locally of finite
presentation, `Spec B ⟶ Spec A` a closed immersion and `Spec B ⟶ Spec R` flat and locally of
finite presentation, suppose the actual ideal of `Spec B` pulls back to a locally rank-one
module along every morphism into a fibre of `Spec A ⟶ Spec R`
(`Scheme.Hom.FiberPullbackRankOne`). Then the ideal is locally rank one
(`spectralIdeal_isLocallyRankOne_of_fiberPullbackRankOne`). This is the affine core of
Kleiman's Lemma 3.4, (ii) ⇒ (i), in the arbitrary-base form of Stacks Project, Tag 062Y
("In particular").

The proof follows Kleiman, *The Picard scheme*, arXiv:math/0504020v1, pp. 22-23. At a field
point the ideal is a line, so Nakayama's lemma gives a local generator `a`. On every fibre the
ideal is the image of the tensored ideal (quotient flatness), generated by `1 ⊗ a`; it is an
invertible module, so `1 ⊗ a` is regular there. The proved arbitrary-base criterion
`Algebra.regular_and_flat_of_fibre_regular` then makes `a` regular.
-/

@[expose] public section

noncomputable section
set_option autoImplicit false
set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u

open CategoryTheory Limits AlgebraicGeometry Opposite TopologicalSpace
open AlgebraicGeometry.Scheme
open AlgebraicGeometry.Scheme.Modules
open AlgebraicGeometry.Scheme.Modules.Invertible
open TensorProduct

namespace AlgebraicGeometry.Scheme.Hom

/-- A field fibre of the actual spectral ideal is one-dimensional when the ideal pulls back to a
line along the field point. -/
def fieldTensorIdealBasisOfRankOne {A B : CommRingCat.{u}} (φ : A ⟶ B)
    (K : Type u) [Field K] [Algebra A K]
    (hx : IsLocallyRankOne (Spec (.of K))
      ((Scheme.Modules.pullback (Spec.map (CommRingCat.ofHom (algebraMap A K)))).obj
        (idealModule (Spec.map φ)))) :
    Module.Basis PUnit.{u + 1} K (K ⊗[A] RingHom.ker φ.hom) := by
  let x : Spec (.of K) ⟶ Spec A := Spec.map (CommRingCat.ofHom (algebraMap A K))
  let I := ModuleCat.of A (RingHom.ker φ.hom)
  let e : (Scheme.Modules.pullback x).obj (idealModule (Spec.map φ)) ≅
      tilde (ModuleCat.of K (K ⊗[A] RingHom.ker φ.hom)) :=
    (Scheme.Modules.pullback x).mapIso (affineIdealIso φ).symm ≪≫
      ((tildePullbackIso (CommRingCat.ofHom (algebraMap A K))).app I) ≪≫
        (tilde.functor (.of K)).mapIso (ModuleCat.extendScalarsAlgebraIso A K I)
  exact basisOfTildeRankOne K _ (isLocallyRankOne_of_iso _ e hx)

/-- Nakayama's lemma for the actual spectral ideal: if it is finitely generated and pulls back to
a line at the residue field of a prime `P`, it is cyclic on a principal neighbourhood of `P`. -/
theorem exists_away_surjective_idealGenerator_of_fieldPoint {A B : CommRingCat.{u}}
    (φ : A ⟶ B) (hfg : (RingHom.ker φ.hom).FG) (P : Ideal A) [P.IsPrime]
    (hx : IsLocallyRankOne (Spec (.of (IsLocalRing.ResidueField (Localization.AtPrime P))))
      ((Scheme.Modules.pullback (Spec.map (CommRingCat.ofHom
        (algebraMap A (IsLocalRing.ResidueField (Localization.AtPrime P)))))).obj
          (idealModule (Spec.map φ)))) :
    ∃ s : A, s ∉ P ∧ ∃ a : RingHom.ker φ.hom,
      Function.Surjective (LocalizedModule.map (Submonoid.powers s)
        (LinearMap.toSpanSingleton A (RingHom.ker φ.hom) a)) := by
  let I := RingHom.ker φ.hom
  let Aₚ := Localization.AtPrime P
  let K := IsLocalRing.ResidueField Aₚ
  let M := LocalizedModule P.primeCompl I
  have : Module.Finite A I := Module.Finite.of_fg hfg
  have : Module.Finite Aₚ M := inferInstance
  let b := fieldTensorIdealBasisOfRankOne φ K hx
  let e : K ⊗[Aₚ] M ≃ₗ[K] K ⊗[A] I :=
    (AlgebraTensorModule.congr (LinearEquiv.refl K K)
      (LocalizedModule.equivTensorProduct P.primeCompl I)).trans
      (AlgebraTensorModule.cancelBaseChange A Aₚ K K I)
  obtain ⟨f, hf⟩ :=
    _root_.IsLocalRing.exists_surjective_unit_of_residue_basis Aₚ M (b.map e.symm)
  exact _root_.Module.exists_away_surjective_unit_of_localized_surjective_unit A I P f hf

section Regular

attribute [local instance] Algebra.TensorProduct.rightAlgebra

/-- On a field base change of a quotient-flat principal ideal, the pulled-back ideal is a line
bundle exactly when it is invertible; then the base-changed generator `1 ⊗ a` is regular. -/
theorem isSMulRegular_one_tmul_of_idealPullback_rankOne
    (R A B K : Type u) [CommRing R] [CommRing A] [CommRing B] [CommRing K]
    [Algebra R A] [Algebra R B] [Algebra A B] [IsScalarTower R A B] [Algebra R K]
    [Module.Flat R B] (hsurj : Function.Surjective (algebraMap A B)) (a : A)
    (hker : RingHom.ker (algebraMap A B) = Ideal.span {a})
    (hK : IsLocallyRankOne (Spec (.of (K ⊗[R] A)))
      ((Scheme.Modules.pullback (Spec.map (CommRingCat.ofHom (algebraMap A (K ⊗[R] A))))).obj
        (idealModule (Spec.map (CommRingCat.ofHom (algebraMap A B)))))) :
    IsSMulRegular (K ⊗[R] A) ((1 : K) ⊗ₜ[R] a) := by
  have := flatQuotient_spectralIdealPullbackMap_isIso R A B K hsurj
  have h1 : IsLocallyRankOne (Spec (.of (K ⊗[R] A)))
      (idealModule (Spec.map (CommRingCat.ofHom (_root_.Algebra.tensorQuotientMap R A B K)))) :=
    isLocallyRankOne_of_iso _ (asIso (idealPullbackMap
      (Spec.map (CommRingCat.ofHom (algebraMap A B)))
      (Spec.map (CommRingCat.ofHom (_root_.Algebra.tensorQuotientMap R A B K)))
      (Spec.map (CommRingCat.ofHom (algebraMap A (K ⊗[R] A))))
      (Spec.map (CommRingCat.ofHom (algebraMap B (K ⊗[R] B))))
      (tensorQuotientSpecSquare R A B K))) hK
  have h2 := isLocallyRankOne_of_iso _ (affineIdealIso _).symm h1
  have hinv := invertible_of_tilde_isLocallyRankOne _ h2
  have hspan := _root_.Algebra.flatQuotient_principal_tensorKernel R A B K hsurj a hker
  have : Module.Invertible (K ⊗[R] A) (Ideal.span {(1 : K) ⊗ₜ[R] a}) :=
    Module.Invertible.congr
      (M := RingHom.ker (_root_.Algebra.tensorQuotientMap R A B K)) (LinearEquiv.ofEq _ _ hspan)
  exact Ideal.isSMulRegular_of_invertible_span_singleton _

/-- A principal generator of the actual spectral ideal is regular when the ideal pulls back to a
locally rank-one module along every morphism into a fibre. The base can be non-Noetherian. -/
theorem isSMulRegular_of_fiberPullbackRankOne {R A B : CommRingCat.{u}} (ψ : R ⟶ A)
    (φ : A ⟶ B) [Flat (Spec.map ψ)] [LocallyOfFinitePresentation (Spec.map ψ)]
    [IsClosedImmersion (Spec.map φ)] [Flat (Spec.map φ ≫ Spec.map ψ)]
    (hM : FiberPullbackRankOne (Spec.map ψ) (idealModule (Spec.map φ)) Set.univ)
    (a : A) (hker : RingHom.ker φ.hom = Ideal.span {a}) : IsSMulRegular A a := by
  have hflat : ψ.hom.Flat := Flat.SpecMap_iff.mp inferInstance
  have hfp := (LocallyOfFinitePresentation.SpecMap_iff ψ).mp inferInstance
  have hflatB : (ψ ≫ φ).hom.Flat := by
    apply Flat.SpecMap_iff.mp
    rw [Spec.map_comp]
    infer_instance
  have hsurj := IsClosedImmersion.surjective_of_specMap φ
  algebraize [ψ.hom, φ.hom, (ψ ≫ φ).hom]
  have : IsScalarTower R A B := IsScalarTower.of_algebraMap_eq' rfl
  let : Module.Flat R A := hflat
  let : Algebra.FinitePresentation R A := hfp
  let : Module.Flat R B := hflatB
  refine (_root_.Algebra.regular_and_flat_of_fibre_regular (R := R) (S := A) a
    (fun P _ ↦ ?_)).1
  apply isSMulRegular_one_tmul_of_idealPullback_rankOne R A B P.ResidueField hsurj a hker
  have hsq := (tensorSpecProjection_isPullback R A P.ResidueField).w
  exact hM.of_comp_eq _ P.ResidueField (Spec.map (CommRingCat.ofHom (algebraMap R _)))
    (Set.mem_univ _) _ hsq.symm

end Regular

/-- The affine core of the fibrewise criterion (Kleiman, Lemma 3.4; Stacks Project, Tag 062Y):
the actual spectral ideal is locally rank one when it pulls back to locally rank-one modules
along all morphisms into the fibres. -/
theorem spectralIdeal_isLocallyRankOne_of_fiberPullbackRankOne {R A B : CommRingCat.{u}}
    (ψ : R ⟶ A) (φ : A ⟶ B) [Flat (Spec.map ψ)] [LocallyOfFinitePresentation (Spec.map ψ)]
    [IsClosedImmersion (Spec.map φ)] [Flat (Spec.map φ ≫ Spec.map ψ)]
    [LocallyOfFinitePresentation (Spec.map φ ≫ Spec.map ψ)]
    (hM : FiberPullbackRankOne (Spec.map ψ) (idealModule (Spec.map φ)) Set.univ) :
    IsLocallyRankOne (Spec A) (idealModule (Spec.map φ)) := by
  apply affineIdeal_rankOne_of_localizedBasis φ
  intro P
  obtain ⟨s, hs, a, ha⟩ := exists_away_surjective_idealGenerator_of_fieldPoint φ
    (spectralIdeal_fg ψ φ) P.asIdeal (hM.fieldPoint _ _ (Set.mem_univ _))
  have hspan := _root_.Ideal.idealMap_eq_span_of_localized_surjective (RingHom.ker φ.hom)
    (.powers s) a ha
  let loc := CommRingCat.ofHom (algebraMap A (Localization.Away s))
  let φs := CommRingCat.ofHom
    (IsLocalization.Away.map (Localization.Away s) (Localization.Away (φ s)) φ.hom s)
  have : Flat (Spec.map (ψ ≫ loc)) := by
    rw [Spec.map_comp]
    infer_instance
  have : LocallyOfFinitePresentation (Spec.map (ψ ≫ loc)) := by
    rw [Spec.map_comp]
    infer_instance
  have := _root_.AlgebraicGeometry.Scheme.isClosedImmersion_specMap_localizationAway φ s
  have := _root_.AlgebraicGeometry.Scheme.flat_specMap_localizationAway_comp ψ φ s
  have hsq := _root_.AlgebraicGeometry.Scheme.isPullback_specMap_localizationAway φ s
  have hw : Spec.map (CommRingCat.ofHom (algebraMap B (Localization.Away (φ s)))) ≫
      Spec.map φ = Spec.map φs ≫ Spec.map loc := hsq.w.symm
  have hiso : IsIso (idealPullbackMap (Spec.map φ) (Spec.map φs) (Spec.map loc)
      (Spec.map (CommRingCat.ofHom (algebraMap B (Localization.Away (φ s))))) hw) :=
    idealPullbackMap_isIso_of_isOpenImmersion _ _ _ _ _ hsq.flip
  have hM' : FiberPullbackRankOne (Spec.map (ψ ≫ loc)) (idealModule (Spec.map φs)) Set.univ :=
    (hM.pullback (Spec.map loc) (Spec.map (ψ ≫ loc)) (𝟙 _)
      (by rw [Spec.map_comp, Category.comp_id])).of_iso (asIso (idealPullbackMap (Spec.map φ)
        (Spec.map φs) (Spec.map loc)
        (Spec.map (CommRingCat.ofHom (algebraMap B (Localization.Away (φ s))))) hw))
  have hreg : IsSMulRegular (Localization.Away s) (algebraMap A (Localization.Away s) a.val) :=
    isSMulRegular_of_fiberPullbackRankOne (ψ ≫ loc) φs hM' _
      ((CommRingCat.ker_localizationAway_map φ s).trans hspan)
  let b := _root_.Ideal.regularPrincipalIdealBasis
    ((RingHom.ker φ.hom).map (algebraMap A (Localization.Away s)))
    (algebraMap A (Localization.Away s) a.val) hreg hspan
  let e := (IsLocalizedModule.iso (.powers s)
    (Algebra.idealMap (Localization.Away s) (RingHom.ker φ.hom))).extendScalarsOfIsLocalization
      (.powers s) (Localization.Away s)
  exact ⟨s, hs, ⟨b.map e.symm⟩⟩

end AlgebraicGeometry.Scheme.Hom
