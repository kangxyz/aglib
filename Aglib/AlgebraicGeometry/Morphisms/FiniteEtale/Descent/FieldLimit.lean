module

public import Aglib.AlgebraicGeometry.Morphisms.FiniteEtale.Descent.LimitMorphisms
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
public import Mathlib.Algebra.Category.Ring.FilteredColimits

/-!
# The actual inverse system of finite field extensions

An algebraic field extension is the filtered union of the fields generated by
its finite subsets. This file constructs the ring colimit and its spectrum
limit, using the actual inclusions of intermediate fields.
-/

@[expose] public section

noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite

namespace AlgebraicGeometry.Scheme.FiniteEtale.FieldLimit

universe u

variable (K Ω : Type u) [Field K] [Field Ω] [Algebra K Ω]

/-- The intermediate field of `Ω` generated over `K` by the finite set `s`. -/
abbrev finiteField (s : Finset Ω) : IntermediateField K Ω :=
  IntermediateField.adjoin K (s : Set Ω)

instance finiteField_finite [Algebra.IsAlgebraic K Ω] (s : Finset Ω) :
    Module.Finite K (finiteField K Ω s) :=
  IntermediateField.finiteDimensional_adjoin fun x _ ↦
    (Algebra.IsAlgebraic.isAlgebraic x).isIntegral

/-- The diagram of fields generated by finite subsets of `Ω`, with inclusion ring maps. -/
def ringDiagram : Finset Ω ⥤ CommRingCat.{u} where
  obj s := CommRingCat.of (finiteField K Ω s)
  map {s t} f := CommRingCat.ofHom (IntermediateField.inclusion
    (IntermediateField.adjoin.mono K (s : Set Ω) (t : Set Ω)
      (Finset.coe_subset.mpr (leOfHom f)))).toRingHom
  map_id _ := rfl
  map_comp _ _ := rfl

/-- The cocone of inclusions of the finitely generated intermediate fields into `Ω`. -/
def ringCocone : Cocone (ringDiagram K Ω) where
  pt := CommRingCat.of Ω
  ι :=
    { app s := CommRingCat.ofHom (finiteField K Ω s).val.toRingHom
      naturality _ _ _ := rfl }

/-- The underlying set-valued cocone of the intermediate-field inclusions into `Ω`. -/
def ringTypeCocone : (ringDiagram K Ω ⋙ CategoryTheory.forget CommRingCat).CoconeTypes :=
  (ringDiagram K Ω ⋙ CategoryTheory.forget CommRingCat).coconeTypesEquiv.symm
    ((CategoryTheory.forget CommRingCat).mapCocone (ringCocone K Ω))

/-- The element `x` regarded as an element of the intermediate field `K(x)`. -/
def singleElement (x : Ω) : finiteField K Ω {x} := by
  refine ⟨x, ?_⟩
  simpa only [finiteField, Finset.coe_singleton] using
    IntermediateField.mem_adjoin_simple_self K x

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
theorem ringTypeCocone_isColimit : (ringTypeCocone K Ω).IsColimit := by
  refine ⟨?_, ?_⟩
  · rw [Functor.CoconeTypes.descColimitType_injective_iff_of_isFiltered']
    intro s x y h
    refine ⟨s, 𝟙 s, ?_⟩
    exact Subtype.ext h
  · intro x
    refine ⟨Functor.ιColimitType (ringDiagram K Ω ⋙ CategoryTheory.forget CommRingCat) {x}
      (singleElement K Ω x), ?_⟩
    exact Functor.descColimitType_ιColimitType_apply _ _ _ _

/-- The union cocone has the actual colimit universal property as commutative
rings. The algebraicity assumption is unnecessary for this universal property;
it is used separately to make each stage finite over `K`. -/
def ringCoconeIsColimit : IsColimit (ringCocone K Ω) := by
  let : ReflectsColimit (ringDiagram K Ω) (CategoryTheory.forget CommRingCat) :=
    reflectsColimit_of_reflectsIsomorphisms _ _
  apply isColimitOfReflects (CategoryTheory.forget CommRingCat)
  exact ((Functor.CoconeTypes.isColimit_iff (ringTypeCocone K Ω)).mp
    (ringTypeCocone_isColimit K Ω)).some

/-- The inverse diagram obtained by applying `Spec` to the intermediate-field inclusions. -/
def specDiagram : (Finset Ω)ᵒᵖ ⥤ Scheme.{u} :=
  (ringDiagram K Ω).op ⋙ Scheme.Spec

/-- The cone from `Spec Ω` to the spectra of the finitely generated intermediate fields. -/
def specCone : Cone (specDiagram K Ω) :=
  Scheme.Spec.mapCone (ringCocone K Ω).op

/-- The limit structure on the spectrum cone, induced by the ring colimit. -/
def specConeIsLimit : IsLimit (specCone K Ω) :=
  isLimitOfPreserves Scheme.Spec (ringCoconeIsColimit K Ω).op

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- The natural structural maps from the intermediate-field spectra to `Spec K`. -/
def fieldStructure : specDiagram K Ω ⟶
    (Functor.const (Finset Ω)ᵒᵖ).obj (Spec (CommRingCat.of K)) where
  app s := Spec.algebraMap K (finiteField K Ω s.unop)
  naturality s t f := by
    dsimp [specDiagram, ringDiagram]
    change Spec.map _ ≫ Spec.map _ = Spec.map _
    rw [← Spec.map_comp]
    congr 1

/-- The intermediate-field spectrum diagram regarded as a diagram over `Spec K`. -/
def fieldDiagram : (Finset Ω)ᵒᵖ ⥤ Over (Spec (CommRingCat.of K)) :=
  Over.lift (specDiagram K Ω) (fieldStructure K Ω)

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
theorem fieldStructure_fac (s : (Finset Ω)ᵒᵖ) :
    (specCone K Ω).π.app s ≫ (fieldStructure K Ω).app s = Spec.algebraMap K Ω := by
  change Spec.map _ ≫ Spec.map _ = Spec.map _
  rw [← Spec.map_comp]
  congr 1

/-- The cone from `Spec Ω` to the intermediate-field spectra in the category over `Spec K`. -/
def fieldCone : Cone (fieldDiagram K Ω) :=
  Over.liftCone (specDiagram K Ω) (fieldStructure K Ω) (specCone K Ω)
    (Spec.algebraMap K Ω) (fieldStructure_fac K Ω)

/-- The limit structure on the intermediate-field cone over `Spec K`. -/
def fieldConeIsLimit : IsLimit (fieldCone K Ω) :=
  Over.isLimitLiftCone (specDiagram K Ω) (fieldStructure K Ω) (specCone K Ω)
    (Spec.algebraMap K Ω) (fieldStructure_fac K Ω) (specConeIsLimit K Ω)

variable {X : Scheme.{u}} (p : X ⟶ Spec (CommRingCat.of K))

/-- The actual finite-field base changes, regarded as schemes over `X`. -/
def schemeDiagram : (Finset Ω)ᵒᵖ ⥤ Over X :=
  fieldDiagram K Ω ⋙ Over.pullback p

/-- The cone over `X` obtained by pulling back the intermediate-field cone along `p`. -/
def schemeCone : Cone (schemeDiagram K Ω p) :=
  (Over.pullback p).mapCone (fieldCone K Ω)

/-- Base change preserves this actual inverse limit. -/
def schemeConeIsLimit : IsLimit (schemeCone K Ω p) :=
  isLimitOfPreserves (Over.pullback p) (fieldConeIsLimit K Ω)

variable [Algebra.IsAlgebraic K Ω]

instance stage_isFinite (s : (Finset Ω)ᵒᵖ) :
    IsFinite ((schemeDiagram K Ω p).obj s).hom := by
  have : IsFinite (Spec.algebraMap K (finiteField K Ω s.unop)) :=
    (IsFinite.SpecMap_iff _).mpr (RingHom.finite_algebraMap.mpr inferInstance)
  change IsFinite (pullback.snd (Spec.algebraMap K (finiteField K Ω s.unop)) p)
  infer_instance

instance transition_isFinite {s t : (Finset Ω)ᵒᵖ} (f : s ⟶ t) :
    IsFinite ((schemeDiagram K Ω p).map f).left := by
  have : IsFinite (((schemeDiagram K Ω p).map f).left ≫
      ((schemeDiagram K Ω p).obj t).hom) := by
    rw [Over.w]
    infer_instance
  exact IsFinite.of_comp _ ((schemeDiagram K Ω p).obj t).hom

instance stage_compact [CompactSpace X] (s : (Finset Ω)ᵒᵖ) :
    CompactSpace ((schemeDiagram K Ω p).obj s).left :=
  QuasiCompact.compactSpace_of_compactSpace ((schemeDiagram K Ω p).obj s).hom

instance stage_quasiSeparated [QuasiSeparatedSpace X] (s : (Finset Ω)ᵒᵖ) :
    QuasiSeparatedSpace ((schemeDiagram K Ω p).obj s).left :=
  quasiSeparatedSpace_of_quasiSeparated ((schemeDiagram K Ω p).obj s).hom

variable [CompactSpace X] [QuasiSeparatedSpace X]

/-- Morphisms from the actual algebraic field base change to a locally finitely
presented scheme over `X` descend to a finite intermediate field. -/
theorem exists_finite_field_overHom (Y : Over X) [LocallyOfFinitePresentation Y.hom]
    (q : (schemeCone K Ω p).pt ⟶ Y) :
    ∃ (s : (Finset Ω)ᵒᵖ) (g : (schemeDiagram K Ω p).obj s ⟶ Y),
      (schemeCone K Ω p).π.app s ≫ g = q :=
  LimitDescent.exists_overHom (schemeDiagram K Ω p) (schemeCone K Ω p)
    (schemeConeIsLimit K Ω p) Y q

/-- Clopen decompositions descend to an actual finite intermediate field,
with the preimage identity along the actual base-change projection. -/
theorem exists_clopen_finite_field
    (U : ((schemeCone K Ω p).pt.left).Opens)
    (hU : IsClosed (U : Set (schemeCone K Ω p).pt.left)) :
    ∃ (s : (Finset Ω)ᵒᵖ) (V : ((schemeDiagram K Ω p).obj s).left.Opens),
      IsClosed (V : Set ((schemeDiagram K Ω p).obj s).left) ∧
      ((schemeCone K Ω p).π.app s).left ⁻¹ᵁ V = U := by
  let D := schemeDiagram K Ω p ⋙ Over.forget X
  let c := (Over.forget X).mapCone (schemeCone K Ω p)
  have hc : IsLimit c := isLimitOfPreserves (Over.forget X) (schemeConeIsLimit K Ω p)
  have (s : (Finset Ω)ᵒᵖ) : CompactSpace (D.obj s) := stage_compact K Ω p s
  have (s : (Finset Ω)ᵒᵖ) : QuasiSeparatedSpace (D.obj s) := stage_quasiSeparated K Ω p s
  have {s t : (Finset Ω)ᵒᵖ} (f : s ⟶ t) : IsAffineHom (D.map f) :=
    inferInstanceAs (IsAffineHom ((schemeDiagram K Ω p).map f).left)
  exact LimitDescent.exists_clopen_preimage_eq D c hc U hU

/-- Projection from the standard-order field pullback used by
`GeometricKernel.geometricBaseChange` to a finite intermediate-field stage. -/
def fieldProjection (s : (Finset Ω)ᵒᵖ) :
    pullback p (Spec.algebraMap K Ω) ⟶ ((schemeDiagram K Ω p).obj s).left :=
  (pullbackSymmetry p (Spec.algebraMap K Ω)).hom ≫ ((schemeCone K Ω p).π.app s).left

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
omit [Algebra.IsAlgebraic K Ω] [CompactSpace X] [QuasiSeparatedSpace X] in
@[reassoc] theorem fieldProjection_base (s : (Finset Ω)ᵒᵖ) :
    fieldProjection K Ω p s ≫ ((schemeDiagram K Ω p).obj s).hom =
      pullback.fst p (Spec.algebraMap K Ω) := by
  rw [fieldProjection, Category.assoc, Over.w]
  exact pullbackSymmetry_hom_comp_snd _ _

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- Finite field-extension descent of an actual morphism from the exact
standard-order base change to a locally finitely presented `X`-scheme. -/
theorem exists_finite_field_hom (Y : Over X) [LocallyOfFinitePresentation Y.hom]
    (q : pullback p (Spec.algebraMap K Ω) ⟶ Y.left)
    (hq : q ≫ Y.hom = pullback.fst p (Spec.algebraMap K Ω)) :
    ∃ (s : (Finset Ω)ᵒᵖ) (g : ((schemeDiagram K Ω p).obj s).left ⟶ Y.left),
      g ≫ Y.hom = ((schemeDiagram K Ω p).obj s).hom ∧ fieldProjection K Ω p s ≫ g = q := by
  let e := pullbackSymmetry p (Spec.algebraMap K Ω)
  let q' : (schemeCone K Ω p).pt ⟶ Y := Over.homMk (e.inv ≫ q) (by
    rw [Category.assoc, hq]
    exact pullbackSymmetry_inv_comp_fst _ _)
  obtain ⟨s, g, hg⟩ := exists_finite_field_overHom K Ω p Y q'
  refine ⟨s, g.left, Over.w g, ?_⟩
  have H := congrArg (fun f ↦ e.hom ≫ f.left) hg
  simpa only [fieldProjection, e, Over.comp_left, q', Over.homMk_left, Category.assoc,
    Iso.hom_inv_id_assoc] using H

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- Every clopen of the exact standard-order algebraic field base change
descends along `fieldProjection` to a clopen at a finite intermediate field. -/
theorem exists_clopen_finite_field_standard
    (U : (pullback p (Spec.algebraMap K Ω)).Opens)
    (hU : IsClosed (U : Set ↥(pullback p (Spec.algebraMap K Ω)))) :
    ∃ (s : (Finset Ω)ᵒᵖ) (V : ((schemeDiagram K Ω p).obj s).left.Opens),
      IsClosed (V : Set ((schemeDiagram K Ω p).obj s).left) ∧
      fieldProjection K Ω p s ⁻¹ᵁ V = U := by
  let e := pullbackSymmetry p (Spec.algebraMap K Ω)
  let U' : ((schemeCone K Ω p).pt.left).Opens := e.inv ⁻¹ᵁ U
  have hU' : IsClosed (U' : Set (schemeCone K Ω p).pt.left) :=
    hU.preimage e.inv.continuous
  obtain ⟨s, V, hV, hv⟩ := exists_clopen_finite_field K Ω p U' hU'
  refine ⟨s, V, hV, ?_⟩
  change (e.hom ≫ ((schemeCone K Ω p).π.app s).left) ⁻¹ᵁ V = U
  rw [Scheme.Hom.comp_preimage, hv]
  change e.hom ⁻¹ᵁ e.inv ⁻¹ᵁ U = U
  rw [← Scheme.Hom.comp_preimage, e.hom_inv_id]
  rfl

end AlgebraicGeometry.Scheme.FiniteEtale.FieldLimit

