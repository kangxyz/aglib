module

public import Aglib.AlgebraicGeometry.Blowup.UnitLocus
public import Aglib.AlgebraicGeometry.Blowup.BaseChange
public import Aglib.AlgebraicGeometry.Blowup.AffineCenter.Support

/-!
# The boundary in the actual saturated blowup charts

The image of the centre ideal in the chart at `a` is exactly the principal
ideal generated by the original image of `a`. Thus the inverse image of the
centre complement in this chart is the literal principal open `D(a)`.
Neither a domain hypothesis nor a chosen abstract line-module frame occurs.
-/

@[expose] public noncomputable section

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open CategoryTheory AlgebraicGeometry

universe u

namespace AlgebraicGeometry.Scheme.Blowup.UnitLocus

variable {A : Type u} [CommRing A] (I : Ideal A) (a : I)

/-- Every original generator is the pivot times its original chart ratio,
so the image ideal is exactly the principal pivot ideal. -/
theorem map_ideal_eq_span_pivot :
    I.map (algebraMap A (affineBlowupAlgebra A I a)) =
      Ideal.span {algebraMap A (affineBlowupAlgebra A I a) a} := by
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    intro b hb
    change algebraMap A (affineBlowupAlgebra A I a) b ∈
      Ideal.span {algebraMap A (affineBlowupAlgebra A I a) a}
    rw [← ratio_mul_den I a ⟨b, hb⟩]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_singleton _))
  · apply Ideal.span_le.mpr
    exact Set.singleton_subset_iff.mpr (Ideal.mem_map_of_mem _ a.property)

variable {I} {B : BlowupDatum (affineCenter A I)} (H : AffineAtlas A I B)

/-- The actual pulled centre on the chart is the original principal pivot
ideal sheaf, with no independently selected Cartier equation. -/
theorem centre_on_chart (a : I) :
    (affineCenter A I).comap (H.chart a ≫ B.map) =
      affineCenter (affineBlowupAlgebra A I a)
        (Ideal.span {algebraMap A (affineBlowupAlgebra A I a) a}) := by
  rw [H.triangle]
  exact (BaseChange.affineCenter_comap
    (algebraMap A (affineBlowupAlgebra A I a)) I).trans
    (congrArg (affineCenter (affineBlowupAlgebra A I a)) (map_ideal_eq_span_pivot I a))

/-- On every actual saturated chart, the inverse image of the entire centre
complement is the literal principal open of the original pivot. -/
theorem chart_preimage_complement (a : I) :
    (H.chart a ≫ B.map) ⁻¹ᵁ (affineCenter A I).support.compl =
      PrimeSpectrum.basicOpen (algebraMap A (affineBlowupAlgebra A I a) a) := by
  ext x
  change (H.chart a ≫ B.map) x ∉ ((affineCenter A I).support : Set _) ↔ _
  rw [H.triangle, support_affineCenter]
  change (¬ ∀ b, b ∈ I → algebraMap A (affineBlowupAlgebra A I a) b ∈ x.asIdeal) ↔
    algebraMap A (affineBlowupAlgebra A I a) a ∉ x.asIdeal
  constructor
  · intro h ha
    apply h
    intro b hb
    have hb' := Ideal.mem_map_of_mem (algebraMap A (affineBlowupAlgebra A I a)) hb
    rw [map_ideal_eq_span_pivot I a] at hb'
    exact (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ha)) hb'
  · intro ha h
    exact ha (h a a.property)

end AlgebraicGeometry.Scheme.Blowup.UnitLocus
