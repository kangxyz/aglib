/-!
# The actual affine Rees Proj, saturated charts and Cartier centre

The scheme is native `Proj (reesAlgebra.grading I)` of the existing Rees ring.
Its structural morphism has target the original `Spec A`. The affine cover uses
exactly `Localization.Away.saturatedChart A I a`, with the original scalar maps,
ratios and overlap localizations. The inverse-image ideal of the actual centre
`Spec (A / I)` is locally free of rank one, proved by multiplication by `a` on
each saturated chart and the native ideal-module comparison.

Properness uses Noetherianity of the original commutative base ring. The chart
and Cartier proofs need no extra hypothesis, so zero/unit ideals, zero rings,
and zero or nilpotent denominators remain included.

These are new native constructions using `ReesAlgebra.Grading` and
`ReesAlgebra.Away` and the pinned Mathlib Proj interfaces. The final-object
universal property for arbitrary test schemes, global gluing and flat base
change are separate remaining obligations. No `BlowupDatum` or general
blowup theorem-family supplier is asserted here.
-/

@[expose] public noncomputable section
set_option autoImplicit false
open Polynomial CategoryTheory AlgebraicGeometry
universe u
namespace reesAlgebra
variable {A : Type u} [CommRing A]

private lemma homogeneous_succ_mem_span (I : Ideal A) (n : ℕ) (b : A) (hb : b ∈ I ^ (n + 1)) :
    (homogeneous I (n + 1) ⟨b, hb⟩ : reesAlgebra I) ∈ Ideal.span (Set.range (degreeOne I)) := by
  refine Submodule.smul_induction_on'
    (p := fun b hb => (homogeneous I (n + 1) ⟨b, by rwa [pow_succ']⟩ : reesAlgebra I) ∈
      Ideal.span (Set.range (degreeOne I))) (by rwa [pow_succ'] at hb) ?_ ?_
  · intro x hx y hy
    have he : (homogeneous I (n + 1) ⟨x * y, by rw [pow_succ']; exact Ideal.mul_mem_mul hx hy⟩ :
        reesAlgebra I) = degreeOne I ⟨x, hx⟩ * homogeneous I n ⟨y, hy⟩ := by
      apply Subtype.ext
      change monomial (n + 1) (x * y) = monomial 1 x * monomial n y
      rw [monomial_mul_monomial, Nat.add_comm n 1]
    change (homogeneous I (n + 1) ⟨x * y, _⟩ : reesAlgebra I) ∈ _
    rw [he]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨⟨x, hx⟩, rfl⟩)
  · intro x hx y hy ihx ihy
    have he : (homogeneous I (n + 1) ⟨x + y, by rw [pow_succ']; exact Ideal.add_mem _ hx hy⟩ :
        reesAlgebra I) = homogeneous I (n + 1) ⟨x, by rwa [pow_succ']⟩ +
          homogeneous I (n + 1) ⟨y, by rwa [pow_succ']⟩ := by
      apply Subtype.ext
      exact map_add (monomial (n + 1)) x y
    rw [he]
    exact Ideal.add_mem _ ihx ihy

/-- The actual Rees irrelevant ideal is generated by the degree-one ideal elements. -/
lemma irrelevant_eq_span_degreeOne (I : Ideal A) :
    (HomogeneousIdeal.irrelevant (grading I)).toIdeal = Ideal.span (Set.range (degreeOne I)) := by
  apply le_antisymm
  · rw [HomogeneousIdeal.toIdeal_irrelevant_le]
    intro n hn p hp
    obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hn)
    have he : p = (homogeneous I (k + 1)
        ⟨(p : A[X]).coeff (k + 1), p.property _⟩ : reesAlgebra I) := by
      apply Subtype.ext
      exact eq_monomial_coeff hp
    rw [he]
    exact homogeneous_succ_mem_span I _ _ _
  · rw [Ideal.span_le]
    rintro _ ⟨a, rfl⟩
    exact HomogeneousIdeal.mem_irrelevant_of_mem _ (by decide : 0 < (1 : ℕ)) (degreeOne_mem I a)

/-- Over a Noetherian original base, the Rees ring is finite type over its actual degree zero. -/
instance finiteType_zero [IsNoetherianRing A] (I : Ideal A) :
    Algebra.FiniteType (grading I 0) (reesAlgebra I) := by
  apply (RingHom.finiteType_algebraMap (A := grading I 0) (B := reesAlgebra I)).mp
  apply RingHom.FiniteType.of_comp_finiteType (f := (degreeZeroEquiv I).symm.toRingHom)
  have he : (algebraMap (grading I 0) (reesAlgebra I)).comp
      (degreeZeroEquiv I).symm.toRingHom = algebraMap A (reesAlgebra I) :=
    RingHom.ext fun r => degreeZeroEquiv_symm_coe I r
  rw [he]
  exact RingHom.finiteType_algebraMap.mpr inferInstance

end reesAlgebra
namespace AlgebraicGeometry.Scheme.Blowup
open reesAlgebra
variable {A : Type u} [CommRing A]

/-- Native Proj of the original Rees algebra with its polynomial grading. -/
abbrev affineProj (I : Ideal A) : Scheme := Proj (grading I)

/-- The actual structural morphism to the spectrum of the original base ring. -/
def affineProjMap (I : Ideal A) : affineProj I ⟶ Spec (.of A) :=
  Proj.toSpecZero (grading I) ≫ Spec.map (CommRingCat.ofHom (degreeZeroEquiv I).symm.toRingHom)

/-- The saturated chart inclusion, through the canonical homogeneous-localization equivalence. -/
def affineProjChart (I : Ideal A) (a : I) :
    Spec (.of (affineBlowupAlgebra A I a)) ⟶ affineProj I :=
  Spec.map (CommRingCat.ofHom (awayEquiv I a).toRingHom) ≫
    Proj.awayι (grading I) (degreeOne I a) (degreeOne_mem I a) (by decide)

instance (I : Ideal A) (a : I) : IsOpenImmersion (affineProjChart I a) := by
  have : IsIso (Spec.map (CommRingCat.ofHom (awayEquiv I a).toRingHom)) :=
    (Scheme.Spec.mapIso (awayEquiv I a).toRingEquiv.toCommRingCatIso.op).isIso_hom
  unfold affineProjChart
  infer_instance

/-- The chart map retains the original scalar-map triangle. -/
lemma affineProjChart_map (I : Ideal A) (a : I) :
    affineProjChart I a ≫ affineProjMap I = affineChartMap A I a := by
  simp only [affineProjChart, affineProjMap, Category.assoc, Proj.awayι_toSpecZero_assoc,
    ← Spec.map_comp]
  congr 1
  ext r
  exact congrArg Subtype.val (awayEquiv_base I a r)

/-- The saturated chart is precisely the corresponding degree-one Proj basic open. -/
lemma affineProjChart_opensRange (I : Ideal A) (a : I) :
    (affineProjChart I a).opensRange = Proj.basicOpen (grading I) (degreeOne I a) := by
  have : IsIso (Spec.map (CommRingCat.ofHom (awayEquiv I a).toRingHom)) :=
    (Scheme.Spec.mapIso (awayEquiv I a).toRingEquiv.toCommRingCatIso.op).isIso_hom
  change (Spec.map (CommRingCat.ofHom (awayEquiv I a).toRingHom) ≫
    Proj.awayι (grading I) (degreeOne I a) (degreeOne_mem I a) (by decide)).opensRange = _
  rw [Scheme.Hom.opensRange_comp_of_isIso, Proj.opensRange_awayι]

/-- Every point is in a saturated chart indexed by an original element of the ideal. -/
lemma affineProjChart_covers (I : Ideal A) (x : affineProj I) :
    ∃ a : I, x ∈ Set.range (affineProjChart I a) := by
  have h := Proj.iSup_basicOpen_eq_top (grading I) (degreeOne I)
    (irrelevant_eq_span_degreeOne I).le
  have hx : x ∈ (⨆ a : I, Proj.basicOpen (grading I) (degreeOne I a)) := by rw [h]; trivial
  obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
  refine ⟨a, ?_⟩
  change x ∈ (affineProjChart I a).opensRange
  rwa [affineProjChart_opensRange]

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
instance [IsNoetherianRing A] (I : Ideal A) : IsProper (affineProjMap I) := by
  have : IsIso (CommRingCat.ofHom (R := A) (S := grading I 0)
      (degreeZeroEquiv I).symm.toRingHom) := by
    apply (ConcreteCategory.isIso_iff_bijective _).mpr
    exact (degreeZeroEquiv I).symm.bijective
  unfold affineProjMap
  infer_instance

end AlgebraicGeometry.Scheme.Blowup

namespace AlgebraicGeometry.Scheme.Blowup
open reesAlgebra HomogeneousLocalization
variable {A : Type u} [CommRing A]

/-- The native Proj overlap element is the literal ratio in the saturated chart. -/
lemma awayEquiv_localizationElem (I : Ideal A) (a b : I) :
    awayEquiv I a (Away.isLocalizationElem (degreeOne_mem I a) (degreeOne_mem I b)) =
      ratio A I a b := by
  apply Subtype.ext
  simpa only [Away.isLocalizationElem, pow_one, ratio, Localization.Away.fraction] using
    awayEquiv_ratio I a b

/-- Intersecting two Proj charts inverts the original ratio `b/a`. -/
lemma affineProjChart_preimage (I : Ideal A) (a b : I) :
    affineProjChart I a ⁻¹ᵁ Proj.basicOpen (grading I) (degreeOne I b) =
      PrimeSpectrum.basicOpen (ratio A I a b) := by
  rw [affineProjChart, Scheme.Hom.comp_preimage,
    Proj.awayι_preimage_basicOpen (grading I) (degreeOne_mem I a) (by decide)
      (degreeOne_mem I b) (by decide)]
  ext x
  change Away.isLocalizationElem (degreeOne_mem I a) (degreeOne_mem I b) ∉
    Ideal.comap (awayEquiv I a).toRingHom x.asIdeal ↔ ratio A I a b ∉ x.asIdeal
  change awayEquiv I a _ ∉ x.asIdeal ↔ _
  rw [awayEquiv_localizationElem]

/-- The literal overlap localization has image exactly the intersection of the two charts. -/
lemma affineProjChart_overlap (I : Ideal A) (a b : I) :
    Set.range (affineOverlapMap A I a b ≫ affineProjChart I a) =
      Set.range (affineProjChart I a) ∩ Set.range (affineProjChart I b) := by
  change Set.range ((affineProjChart I a) ∘ (affineOverlapMap A I a b)) = _
  rw [Set.range_comp]
  have hloc : Set.range (affineOverlapMap A I a b) =
      (PrimeSpectrum.basicOpen (ratio A I a b) : Set (PrimeSpectrum (affineBlowupAlgebra A I a))) :=
    PrimeSpectrum.localization_away_comap_range _ _
  rw [hloc, ← affineProjChart_preimage]
  change (affineProjChart I a) '' ((affineProjChart I a) ⁻¹'
    (Proj.basicOpen (grading I) (degreeOne I b) : Set (affineProj I))) = _
  rw [Set.image_preimage_eq_inter_range]
  rw [Set.inter_comm]
  exact congrArg (Set.range (affineProjChart I a) ∩ ·)
    (congrArg SetLike.coe (affineProjChart_opensRange I b)).symm

/-- The extension of the original ideal to its saturated chart is generated by `a`. -/
lemma chartIdeal_eq_span (I : Ideal A) (a : I) :
    I.map (algebraMap A (affineBlowupAlgebra A I a)) =
      Ideal.span {algebraMap A (affineBlowupAlgebra A I a) a} := by
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    intro b hb
    apply Ideal.mem_span_singleton.mpr
    refine ⟨ratio A I a ⟨b, hb⟩, ?_⟩
    apply Subtype.ext
    change algebraMap A (Localization.Away (a : A)) b =
      algebraMap A (Localization.Away (a : A)) a * Localization.Away.fraction (a : A) b
    rw [mul_comm]
    exact (Localization.Away.fraction_mul_self _ _).symm
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    exact Ideal.mem_map_of_mem _ a.property

/-- The chart denominator is regular because it becomes a unit in the ambient localization. -/
lemma chartDen_mul_injective (I : Ideal A) (a : I) :
    Function.Injective fun x : affineBlowupAlgebra A I a =>
      algebraMap A (affineBlowupAlgebra A I a) a * x := by
  intro x y h
  apply Subtype.ext
  have h' := congrArg Subtype.val h
  exact (IsLocalization.Away.algebraMap_isUnit
    (S := Localization.Away (a : A)) (a : A)).mul_right_injective h'

/-- Multiplication by the original denominator identifies the chart ring with its extended ideal. -/
def chartIdealEquiv (I : Ideal A) (a : I) :
    affineBlowupAlgebra A I a ≃ₗ[affineBlowupAlgebra A I a]
      I.map (algebraMap A (affineBlowupAlgebra A I a)) := by
  let S := affineBlowupAlgebra A I a
  let α : S := algebraMap A S a
  let J := I.map (algebraMap A S)
  let m : S →ₗ[S] J :=
    { toFun x := ⟨α * x, J.mul_mem_right x (Ideal.mem_map_of_mem _ a.property)⟩
      map_add' x y := Subtype.ext (mul_add α x y)
      map_smul' r x := Subtype.ext (by change α * (r * x) = r * (α * x); ring) }
  exact LinearEquiv.ofBijective m ⟨fun x y h => chartDen_mul_injective I a (congrArg Subtype.val h),
    fun ⟨x, hx⟩ => by
      change x ∈ I.map (algebraMap A (affineBlowupAlgebra A I a)) at hx
      rw [chartIdeal_eq_span] at hx
      obtain ⟨r, hr⟩ := Ideal.mem_span_singleton.mp hx
      exact ⟨r, Subtype.ext hr.symm⟩⟩

end AlgebraicGeometry.Scheme.Blowup

namespace AlgebraicGeometry.Scheme.Blowup
open CategoryTheory Limits
open AlgebraicGeometry.Scheme.Hom AlgebraicGeometry.Scheme.Modules
open AlgebraicGeometry.Scheme.Modules.Invertible
variable {A : Type u} [CommRing A]

set_option backward.defeqAttrib.useBackward true in
set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- A free rank-one ring ideal gives local rank one of the actual quotient-centre ideal module. -/
lemma affineCenter_rankOne_of_equiv (S : Type u) [CommRing S] (J : Ideal S)
    (eJ : S ≃ₗ[S] J) :
    IsLocallyRankOne (Spec (.of S)) (idealModule (affineCenter S J).subschemeι) := by
  let φ : CommRingCat.of S ⟶ CommRingCat.of (S ⧸ J) :=
    CommRingCat.ofHom (Ideal.Quotient.mk J)
  let q : Spec (.of (S ⧸ J)) ⟶ Spec (.of S) := Spec.map φ
  have : IsClosedImmersion q := IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
  have he : J = RingHom.ker φ.hom := Ideal.mk_ker.symm
  let e : ModuleCat.of S S ≅ ModuleCat.of S (RingHom.ker φ.hom) :=
    (eJ.trans (LinearEquiv.ofEq _ _ he)).toModuleIso
  -- Explicit bundles and intermediate sheaf types avoid expanding the ideal construction
  -- during instance unification and keep this proof within the standard heartbeat budget.
  have hfree : IsLocallyRankOne (Spec (.of S)) (tilde (ModuleCat.of S S)) :=
    tilde_isLocallyRankOne (R := CommRingCat.of S) (ModuleCat.of S S)
  let eT : tilde (ModuleCat.of S S) ≅ tilde (ModuleCat.of S (RingHom.ker φ.hom)) :=
    (tilde.functor (CommRingCat.of S)).mapIso e
  let eI : tilde (ModuleCat.of S (RingHom.ker φ.hom)) ≅ idealModule q :=
    affineIdealIso (R := CommRingCat.of S) φ
  have hq : IsLocallyRankOne (Spec (.of S)) (idealModule q) :=
    isLocallyRankOne_of_iso (Spec (.of S)) (eT ≪≫ eI) hfree
  have h : inv q.toImage ≫ q = q.imageι ≫ 𝟙 _ := by
    rw [Category.comp_id, IsIso.inv_comp_eq]
    exact q.toImage_imageι.symm
  have : IsIso (idealPullbackMap q q.imageι (𝟙 _) (inv q.toImage) h) :=
    idealPullbackMap_isIso_of_iso_square _ _ _ _ _
  exact isLocallyRankOne_of_iso _
    (asIso (idealPullbackMap q q.imageι (𝟙 _) (inv q.toImage) h))
      (pullback_locallyRankOne (𝟙 _) _ hq)

/-- The actual affine centre has Cartier inverse image on each saturated chart. -/
lemma affineChartMap_cartier (I : Ideal A) (a : I) :
    cartierPullback (affineCenter A I) (affineChartMap A I a) := by
  unfold cartierPullback affineChartMap
  rw [BaseChange.affineCenter_comap]
  exact affineCenter_rankOne_of_equiv _ _ (chartIdealEquiv I a)

set_option backward.defeqAttrib.useBackward true in
set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- The actual inverse-image centre on the Rees Proj is Cartier, by its saturated open cover. -/
lemma affineProjMap_cartier (I : Ideal A) :
    cartierPullback (affineCenter A I) (affineProjMap I) := by
  let J := (affineCenter A I).comap (affineProjMap I)
  change IsLocallyRankOne (affineProj I) (idealModule J.subschemeι)
  apply isLocallyRankOne_of_forall_isLocallyRankOneAt
  intro x
  obtain ⟨a, ha⟩ := affineProjChart_covers I x
  let f := affineProjChart I a
  let i := J.subschemeι
  let i' := (J.comap f).subschemeι
  let g := (J.comap f).subschemeMap J f (J.le_map_comap f)
  have h : g ≫ i = i' ≫ f := Scheme.IdealSheafData.subschemeMap_subschemeι _ _ _ _
  have H : IsPullback g i' i f :=
    (isPullback_of_isClosedImmersion i' i g f h.symm (by simp [i, i'])).flip
  have : IsIso (idealPullbackMap i i' f g h) :=
    idealPullbackMap_isIso_of_isOpenImmersion _ _ _ _ _ H
  have hloc : IsLocallyRankOne (Spec (.of (affineBlowupAlgebra A I a))) (idealModule i') := by
    have hc := affineChartMap_cartier I a
    rw [← affineProjChart_map] at hc
    unfold cartierPullback at hc
    rw [Scheme.IdealSheafData.comap_comp] at hc
    exact hc
  exact ⟨_, f, inferInstance, ha,
    isLocallyRankOne_of_iso _ (asIso (idealPullbackMap i i' f g h)).symm hloc⟩

end AlgebraicGeometry.Scheme.Blowup

namespace AlgebraicGeometry.Scheme.Blowup
variable {A : Type u} [CommRing A]

/-- Nilpotent denominators give empty actual saturated chart spectra. -/
lemma affineChart_isEmpty_of_isNilpotent (I : Ideal A) (a : I)
    (ha : IsNilpotent (a : A)) : IsEmpty (Spec (.of (affineBlowupAlgebra A I a))) := by
  let : Subsingleton (Localization.Away (a : A)) :=
    IsLocalization.subsingleton (M := Submonoid.powers (a : A))
      (S := Localization.Away (a : A)) ha
  exact inferInstanceAs (IsEmpty (PrimeSpectrum (affineBlowupAlgebra A I a)))

/-- An ideal all of whose elements are nilpotent has empty Rees Proj. -/
lemma affineProj_isEmpty_of_isNilpotent (I : Ideal A)
    (hI : ∀ a : I, IsNilpotent (a : A)) : IsEmpty (affineProj I) := by
  constructor
  intro x
  obtain ⟨a, y, rfl⟩ := affineProjChart_covers I x
  let := affineChart_isEmpty_of_isNilpotent I a (hI a)
  exact isEmptyElim y

instance : IsEmpty (affineProj (⊥ : Ideal A)) :=
  affineProj_isEmpty_of_isNilpotent _ fun a => by
    have ha : (a : A) = 0 := a.property
    rw [ha]
    exact ⟨1, zero_pow one_ne_zero⟩

end AlgebraicGeometry.Scheme.Blowup

namespace AlgebraicGeometry.Scheme.Blowup
variable {A : Type u} [CommRing A]

/-- The actual saturated affine open cover of the native Rees Proj. -/
def affineProjCover (I : Ideal A) : (affineProj I).AffineOpenCover where
  I₀ := I
  X a := CommRingCat.of (affineBlowupAlgebra A I a)
  f := affineProjChart I
  idx x := (affineProjChart_covers I x).choose
  covers x := (affineProjChart_covers I x).choose_spec

end AlgebraicGeometry.Scheme.Blowup
