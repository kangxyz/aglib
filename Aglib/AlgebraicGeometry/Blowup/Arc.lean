public import Aglib.AlgebraicGeometry.Blowup.Construction
public import Aglib.AlgebraicGeometry.Blowup.Properness
public import Aglib.RingTheory.Blowup.ArcTermination
public import Mathlib.AlgebraicGeometry.Stalk

/-!
# One closed arc step through the original point blowup

The original maximal ideal is the centre. Its proved equality with `(t) + ker f`
supplies the literal saturated chart without changing the blowup scheme or its
blowdown. The chart lift is the universal lift, remains a closed immersion, and
its original scheme stalk has the exact `arcLocalRing` quotient and scalar maps.
No regularity of the centre is assumed.
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry TopologicalSpace
open Localization.Away

universe u

namespace AlgebraicGeometry.Scheme.Blowup.Arc

section ChartAlgebra

variable {C R : Type u} [CommRing C] [CommRing R]

/-- The original exceptional parameter belongs to the actual arc centre. -/
def pivot (f : C →+* R) (t : C) : arcCenterIdeal f t :=
  ⟨t, by
    change t ∈ Ideal.span ({t} : Set C) ⊔ RingHom.ker f
    exact Submodule.mem_sup_left (Ideal.subset_span rfl)⟩

/-- The inverse-image centre on the original quotient is the literal principal
ideal generated by the image of the exceptional parameter. -/
theorem map_arcCenterIdeal (f : C →+* R) (t : C) :
    (arcCenterIdeal f t).map f = Ideal.span {f t} := by
  have hk : (RingHom.ker f).map f = ⊥ := by
    apply bot_unique
    rw [Ideal.map_le_iff_le_comap]
    exact le_rfl
  rw [arcCenterIdeal, Ideal.map_sup, Ideal.map_span, Set.image_singleton, hk, sup_bot_eq]

/-- Multiplication by a nonzero element identifies the original domain with
its actual principal ideal. -/
def principalIdealEquiv {S : Type u} [CommRing S] [IsDomain S] (a : S) (ha : a ≠ 0) :
    S ≃ₗ[S] Ideal.span {a} := by
  let J : Ideal S := Ideal.span {a}
  let m : S →ₗ[S] J :=
    { toFun x := ⟨a * x, J.mul_mem_right x (Ideal.mem_span_singleton_self a)⟩
      map_add' x y := Subtype.ext (mul_add a x y)
      map_smul' r x := Subtype.ext (by change a * (r * x) = r * (a * x); ring) }
  exact LinearEquiv.ofBijective m
    ⟨fun x y h => mul_left_cancel₀ ha (congrArg Subtype.val h), fun ⟨x, hx⟩ => by
      obtain ⟨r, hr⟩ := Ideal.mem_span_singleton.mp hx
      exact ⟨r, Subtype.ext hr.symm⟩⟩

end ChartAlgebra

/-- The same affine prime, explicitly retained as a native scheme point. -/
def spectrumPoint (A : CommRingCat.{u}) (q : PrimeSpectrum A) : Spec A := q

/-- The original local-ring closed point with its native scheme carrier. -/
def specClosedPoint (A : CommRingCat.{u}) [IsLocalRing A] : Spec A :=
  IsLocalRing.closedPoint A

theorem isClosed_specClosedPoint (A : CommRingCat.{u}) [IsLocalRing A] :
    IsClosed ({specClosedPoint A} : Set (Spec A)) :=
  IsLocalRing.isClosed_singleton_closedPoint A

/-- The native affine stalk iso has an explicitly typed scheme point. -/
def spectrumStalkIso (A : CommRingCat.{u}) (q : PrimeSpectrum A) :
    (Spec A).presheaf.stalk (spectrumPoint A q) ≅
      CommRingCat.of (Localization.AtPrime q.asIdeal) := Spec.stalkIso A q

/-- Compose three original arrow equations without reconstructing their objects. -/
theorem compose_eq_paste {A P Q G R : CommRingCat.{u}}
    (l : A ⟶ P) (e : P ⟶ Q) (ψ : Q ⟶ R) (u : A ⟶ G)
    (g : G ⟶ Q) (v : G ⟶ R) (f : A ⟶ R)
    (h₁ : l ≫ e = u ≫ g) (h₂ : g ≫ ψ = v) (h₃ : u ≫ v = f) :
    l ≫ e ≫ ψ = f := by
  rw [← Category.assoc, h₁, Category.assoc, h₂, h₃]

/-- Paste the stalk quotient with one fixed source for all original arrows. -/
theorem hom_comp_paste {P Q D R : CommRingCat.{u}}
    (i : P ⟶ D) (j : P ⟶ Q) (e : Q ⟶ D) (H : D ⟶ R)
    (ψ : Q ⟶ R) (χ : P ⟶ R)
    (hi : i = j ≫ e) (he : e ≫ H = ψ) (hχ : j ≫ ψ = χ) : i ≫ H = χ := by
  rw [hi, Category.assoc, he, hχ]

/-- Evaluate the original global/germ/stalk arrows with fixed categorical types. -/
theorem coefficient_paste {C G Q S T A U D : CommRingCat.{u}}
    (c : C ⟶ G) (b : G ⟶ Q) (g : Q ⟶ S) (j : S ⟶ T) (e : T ⟶ D)
    (a : Q ⟶ A) (ga : A ⟶ T) (γ : A ⟶ U)
    (l : U ⟶ D) (base : C ⟶ U)
    (hg : g ≫ j = a ≫ ga) (he : ga ≫ e = γ ≫ l)
    (hb : c ≫ b ≫ a ≫ γ = base) : (c ≫ b ≫ g) ≫ j ≫ e = base ≫ l := by
  simp only [Category.assoc]
  rw [← Category.assoc g j e, hg, Category.assoc, he]
  simpa only [Category.assoc] using congrArg (fun k => k ≫ l) hb

/-- A closed map sends a closed singleton to the same actual image singleton. -/
theorem isClosed_map_point {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y]
    (g : X → Y) (hg : IsClosedMap g) (x : X) (hx : IsClosed ({x} : Set X)) :
    IsClosed ({g x} : Set Y) :=
  Eq.mp (congrArg (fun s : Set Y => IsClosed s)
    (show g '' {x} = {g x} from Set.image_singleton)) (hg _ hx)

/-- Global-section and germ maps give the original scalar map on a stalk. -/
@[reassoc]
theorem germ_stalkMap_top {X Y : Scheme.{u}} (g : X ⟶ Y) (x : X) :
    Y.presheaf.germ ⊤ (g x) (Opens.mem_top (g x)) ≫ g.stalkMap x =
      g.appTop ≫ X.presheaf.germ ⊤ x (Opens.mem_top x) := by
  simpa only [Scheme.Hom.appTop, Opens.map_top] using g.germ_stalkMap ⊤ x (Opens.mem_top (g x))

/-- The native localization arrow, fixed before any actual chart is supplied. -/
def localizationBase (A : CommRingCat.{u}) (q : PrimeSpectrum A) :
    A ⟶ CommRingCat.of (Localization.AtPrime q.asIdeal) :=
  CommRingCat.ofHom (algebraMap A (Localization.AtPrime q.asIdeal))

@[reassoc]
theorem localizationBase_stalkIso_inv (A : CommRingCat.{u}) (q : PrimeSpectrum A) :
    localizationBase A q ≫ (spectrumStalkIso A q).inv =
      (Scheme.ΓSpecIso A).inv ≫ (Spec A).presheaf.germ ⊤ (spectrumPoint A q) (Opens.mem_top _) :=
  Spec.algebraMap_stalkIso_inv (R := A) q

theorem germ_localizationBase (A : CommRingCat.{u}) (q : PrimeSpectrum A) :
    (Spec A).presheaf.germ ⊤ (spectrumPoint A q) (Opens.mem_top _) ≫ (spectrumStalkIso A q).hom =
      (Scheme.ΓSpecIso A).hom ≫ localizationBase A q :=
  Spec.germ_stalkMapIso_hom (R := A) q

/-- The quotient calculation is performed with the original affine ring,
prime and native localization fixed as abstract categorical objects. -/
theorem stalkQuotient_of_base {A R : CommRingCat.{u}} [IsLocalRing R]
    (φ : A ⟶ R)
    (H : CommRingCat.of (Localization.AtPrime
      (PrimeSpectrum.comap φ.hom (IsLocalRing.closedPoint R)).asIdeal) ⟶ R)
    (hbase : localizationBase A (PrimeSpectrum.comap φ.hom
      (IsLocalRing.closedPoint R)) ≫ H = φ) :
    (spectrumStalkIso A (PrimeSpectrum.comap φ.hom (IsLocalRing.closedPoint R))).inv ≫
      Scheme.stalkClosedPointTo (Spec.map φ) = H := by
  let q := PrimeSpectrum.comap φ.hom (IsLocalRing.closedPoint R)
  have hg : (Spec A).presheaf.germ ⊤ (spectrumPoint A q) (Opens.mem_top _) ≫
      Scheme.stalkClosedPointTo (Spec.map φ) = (Scheme.ΓSpecIso A).hom ≫ φ :=
    Scheme.germ_stalkClosedPointTo_Spec φ
  have hpre : localizationBase A q ≫ (spectrumStalkIso A q).inv ≫
      Scheme.stalkClosedPointTo (Spec.map φ) = φ :=
    compose_eq_paste _ _ _ _ _ _ _ (localizationBase_stalkIso_inv A q) hg (by simp)
  apply CommRingCat.hom_ext
  apply IsLocalization.ringHom_ext q.asIdeal.primeCompl
  ext a
  have h₁ := congrArg (fun k : A ⟶ R => k.hom a) hpre
  have h₂ := congrArg (fun k : A ⟶ R => k.hom a) hbase
  exact h₁.trans h₂.symm

/-- Paste the exact native localization comparison through an explicit iso. -/
theorem inverse_quotient_paste {P Q D R : CommRingCat.{u}}
    (E : P ≅ Q) (e : Q ≅ D) (ψ : P ⟶ R) (H : D ⟶ R)
    (h : E.inv ≫ ψ = e.hom ≫ H) : (E ≪≫ e).inv ≫ ψ = H := by
  rw [Iso.trans_inv, Category.assoc, h, Iso.inv_hom_id_assoc]

theorem hom_quotient_of_inv {P D R : CommRingCat.{u}}
    (E : P ≅ D) (ψ : P ⟶ R) (H : D ⟶ R) (h : E.inv ≫ ψ = H) :
    E.hom ≫ H = ψ := by
  rw [← h, Iso.hom_inv_id_assoc]

/-- Keep the actual germ and both native base arrows fixed during pasting. -/
theorem germ_iso_paste {G A P Q D : CommRingCat.{u}}
    (g : G ⟶ P) (u : G ⟶ A) (E : P ≅ Q) (e : Q ≅ D)
    (l : A ⟶ Q) (ld : A ⟶ D)
    (hg : g ≫ E.hom = u ≫ l) (hl : l ≫ e.hom = ld) :
    g ≫ (E ≪≫ e).hom = u ≫ ld := by
  rw [Iso.trans_hom, ← Category.assoc, hg, Category.assoc, hl]

/-- The native open-chart stalk iso and its original arrow equation are one
shared witness, formed before the concrete chart is supplied. -/
def openChartStalkWitness {X Y : Scheme.{u}}
    (j : X ⟶ Y) [IsOpenImmersion j] (q : X)
    (D : CommRingCat.{u}) (E : X.presheaf.stalk q ≅ D) :
    {e : Y.presheaf.stalk (j q) ≅ D // e.hom = j.stalkMap q ≫ E.hom} := by
  let : IsIso (j.stalkMap q) :=
    (IsOpenImmersion.iff_isIso_stalkMap.mp (inferInstanceAs (IsOpenImmersion j))).2 q
  exact ⟨asIso (j.stalkMap q) ≪≫ E, rfl⟩

/-- One native atlas chart with its actual immersion and base triangle. -/
def atlasChartWitness {A : Type u} [CommRing A] (I : Ideal A)
    (B : BlowupDatum (affineCenter A I)) (a : I) :
    {j : Spec (.of (affineBlowupAlgebra A I a)) ⟶ B.Y //
      IsOpenImmersion j ∧ j ≫ B.map = affineChartMap A I a} :=
  ⟨(affineAtlas B).chart a, (affineAtlas B).openImmersion a, (affineAtlas B).triangle a⟩

theorem closedPointTo_comp {R : CommRingCat.{u}} [IsLocalRing R]
    {X Y : Scheme.{u}} (α : Spec R ⟶ X) (j : X ⟶ Y) :
    Scheme.stalkClosedPointTo (α ≫ j) = j.stalkMap (α (specClosedPoint R)) ≫
      Scheme.stalkClosedPointTo α :=
  Scheme.stalkClosedPointTo_comp α j

/-- Equality of centres induces the original scalar-compatible chart equivalence. -/
def chartIdealEquiv {A : Type u} [CommRing A] (I J : Ideal A) (h : I = J) (t : A) :
    affineBlowupAlgebra A I t ≃ₐ[A] affineBlowupAlgebra A J t := by
  subst J
  exact AlgEquiv.refl (R := A) (A₁ := affineBlowupAlgebra A I t)

/-- All actual arrows and their original equations for one affine-chart arc
step. The point is always the image of the original local source closed point. -/
structure ClosedArcChartData {C R A D : CommRingCat.{u}}
    [IsLocalRing C] [IsLocalRing R] {Y : Scheme.{u}}
    (b : Y ⟶ Spec C) (j : Spec A ⟶ Y) (φ : A ⟶ R) (f : C ⟶ R)
    (h : C ⟶ D) (H : D ⟶ R) where
  /-- The arc on `Y` represented by the specified affine chart map. -/
  arc : Spec R ⟶ Y
  value : arc = Spec.map φ ≫ j
  base : arc ≫ b = Spec.map f
  point_chart : arc (specClosedPoint R) = j (Spec.map φ (specClosedPoint R))
  /-- The comparison from the stalk at the arc's closed point to the specified ring `D`. -/
  stalk : Y.presheaf.stalk (arc (specClosedPoint R)) ≅ D
  stalk_quotient : stalk.hom ≫ H = Scheme.stalkClosedPointTo arc
  /-- The original base coefficient map into the stalk at the arc's closed point. -/
  coefficient : C ⟶ Y.presheaf.stalk (arc (specClosedPoint R))
  coefficient_value : coefficient = (Scheme.ΓSpecIso C).inv ≫ b.appTop ≫
    Y.presheaf.germ ⊤ (arc (specClosedPoint R)) (Opens.mem_top _)
  coefficient_stalk : coefficient ≫ stalk.hom = h
  coefficient_quotient : coefficient ≫ Scheme.stalkClosedPointTo arc = f
  coefficient_stalk_apply : ∀ c : C, stalk.hom.hom (coefficient.hom c) = h.hom c
  coefficient_quotient_apply : ∀ c : C,
    (Scheme.stalkClosedPointTo arc).hom (coefficient.hom c) = f.hom c
  map_point : IsLocalHom f.hom → b (arc (specClosedPoint R)) = specClosedPoint C
  closed : IsSeparated b → IsClosedImmersion (Spec.map f) → IsClosedImmersion arc
  point_closed : IsSeparated b → IsClosedImmersion (Spec.map f) →
    IsClosed ({arc (specClosedPoint R)} : Set Y)

/-- Construct the actual composite lift, point, open-chart stalk comparison,
original coefficient arrow, and all their equations together over fixed objects.
The equations supplied here are actual chart/base and affine-stalk equations. -/
def closedArcChartData {C R A D : CommRingCat.{u}}
    [IsLocalRing C] [IsLocalRing R] {Y : Scheme.{u}}
    (b : Y ⟶ Spec C) (j : Spec A ⟶ Y) [IsOpenImmersion j]
    (c : C ⟶ A) (φ : A ⟶ R) (f : C ⟶ R)
    (l : A ⟶ D) (h : C ⟶ D) (H : D ⟶ R)
    (E : (Spec A).presheaf.stalk (Spec.map φ (specClosedPoint R)) ≅ D)
    (hj : j ≫ b = Spec.map c) (hcφ : c ≫ φ = f) (hcl : c ≫ l = h)
    (hhH : h ≫ H = f)
    (hE : E.hom ≫ H = Scheme.stalkClosedPointTo (Spec.map φ))
    (hEgerm : (Spec A).presheaf.germ ⊤ (Spec.map φ (specClosedPoint R))
      (Opens.mem_top _) ≫ E.hom = (Scheme.ΓSpecIso A).hom ≫ l) :
    ClosedArcChartData b j φ f h H := by
  let α : Spec R ⟶ Y := Spec.map φ ≫ j
  let q : Spec A := Spec.map φ (specClosedPoint R)
  let w := openChartStalkWitness j q D E
  let e : Y.presheaf.stalk (α (specClosedPoint R)) ≅ D := w.val
  let J : Y.presheaf.stalk (α (specClosedPoint R)) ⟶ (Spec A).presheaf.stalk q :=
    j.stalkMap q
  have he : e.hom = J ≫ E.hom := w.property
  have hb : α ≫ b = Spec.map f := by
    change (Spec.map φ ≫ j) ≫ b = Spec.map f
    rw [Category.assoc, hj, ← Spec.map_comp, hcφ]
  have hJ : J ≫ Scheme.stalkClosedPointTo (Spec.map φ) = Scheme.stalkClosedPointTo α :=
    (closedPointTo_comp (Spec.map φ) j).symm
  have heH : e.hom ≫ H = Scheme.stalkClosedPointTo α :=
    hom_comp_paste e.hom J E.hom H _ _ he hE hJ
  let coef : C ⟶ Y.presheaf.stalk (α (specClosedPoint R)) :=
    (Scheme.ΓSpecIso C).inv ≫ b.appTop ≫
      Y.presheaf.germ ⊤ (α (specClosedPoint R)) (Opens.mem_top _)
  have hg : Y.presheaf.germ ⊤ (α (specClosedPoint R)) (Opens.mem_top _) ≫
      J = j.appTop ≫ (Spec A).presheaf.germ ⊤ q (Opens.mem_top _) :=
    germ_stalkMap_top j q
  have hglobal : (Scheme.ΓSpecIso C).inv ≫ b.appTop ≫ j.appTop ≫
      (Scheme.ΓSpecIso A).hom = c := by
    rw [← Scheme.Hom.comp_appTop_assoc, hj, Scheme.ΓSpecIso_naturality,
      Iso.inv_hom_id_assoc]
  have hcoef : coef ≫ e.hom = h := by
    calc
      coef ≫ e.hom = coef ≫ J ≫ E.hom :=
        congrArg (fun k : Y.presheaf.stalk (α (specClosedPoint R)) ⟶ D => coef ≫ k) he
      _ = c ≫ l := coefficient_paste _ _ _ J _ _ _ _ _ _ hg hEgerm hglobal
      _ = h := hcl
  have hcoefH : coef ≫ Scheme.stalkClosedPointTo α = f := by
    rw [← heH, ← Category.assoc, hcoef, hhH]
  have hclosed : IsSeparated b → IsClosedImmersion (Spec.map f) →
      IsClosedImmersion α := by
    intro hsep hclosedf
    let := hsep
    let : IsClosedImmersion (α ≫ b) := by rw [hb]; exact hclosedf
    exact IsClosedImmersion.of_comp α b
  have hpointClosed : IsSeparated b → IsClosedImmersion (Spec.map f) →
      IsClosed ({α (specClosedPoint R)} : Set Y) := by
    intro hsep hclosedf
    let : IsClosedImmersion α := hclosed hsep hclosedf
    exact isClosed_map_point α α.isClosedEmbedding.isClosedMap
      (specClosedPoint R) (isClosed_specClosedPoint R)
  have hmapPoint : IsLocalHom f.hom → b (α (specClosedPoint R)) = specClosedPoint C := by
    intro hlocal
    let := hlocal
    calc
      b (α (specClosedPoint R)) = (α ≫ b) (specClosedPoint R) :=
        (Scheme.Hom.comp_apply _ _ _).symm
      _ = Spec.map f (specClosedPoint R) :=
        congrArg (fun g : Spec R ⟶ Spec C => g (specClosedPoint R)) hb
      _ = specClosedPoint C := Spec_closedPoint
  exact {
    arc := α
    value := rfl
    base := hb
    point_chart := Scheme.Hom.comp_apply (Spec.map φ) j (specClosedPoint R)
    stalk := e
    stalk_quotient := heH
    coefficient := coef
    coefficient_value := rfl
    coefficient_stalk := hcoef
    coefficient_quotient := hcoefH
    coefficient_stalk_apply := fun x =>
      congrArg (fun k : C ⟶ D => k.hom x) hcoef
    coefficient_quotient_apply := fun x =>
      congrArg (fun k : C ⟶ R => k.hom x) hcoefH
    map_point := hmapPoint
    closed := hclosed
    point_closed := hpointClosed }

section LocalStalk

variable {C R : Type u} [CommRing C] [CommRing R] [IsDomain R] [IsLocalRing R]

/-- The actual prime selected by the original chart quotient and DVR point. -/
def chartPoint (f : C →+* R) (t : C) (ht : f t ≠ 0) : PrimeSpectrum (arcChart f t) :=
  PrimeSpectrum.comap (arcMap f t ht) (IsLocalRing.closedPoint R)

/-- The selected chart prime with the native scheme point carrier. -/
def chartSchemePoint (f : C →+* R) (t : C) (ht : f t ≠ 0) : Spec (.of (arcChart f t)) :=
  spectrumPoint (.of (arcChart f t)) (chartPoint f t ht)

/-- The two literal native localization presentations have identical ring
operations. This explicit identity equivalence keeps their instance heads. -/
def localRingEquiv (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    Localization.AtPrime (chartPoint f t ht).asIdeal ≃+* arcLocalRing f t ht where
  toFun := id
  invFun := id
  left_inv _ := rfl
  right_inv _ := rfl
  map_mul' _ _ := rfl
  map_add' _ _ := rfl

/-- The original chart-to-local-ring homomorphism as one fixed native arrow. -/
def chartLocalBase (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    CommRingCat.of (arcChart f t) ⟶ CommRingCat.of (arcLocalRing f t ht) :=
  CommRingCat.ofHom (algebraMap (arcChart f t) (arcLocalRing f t ht))

/-- The original coefficient homomorphism with its native localization target. -/
def localScalar (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    CommRingCat.of C ⟶ CommRingCat.of (arcLocalRing f t ht) :=
  CommRingCat.ofHom (arcLocalBase f t ht)

/-- The original quotient to the same DVR with its native localization source. -/
def localQuotient (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    CommRingCat.of (arcLocalRing f t ht) ⟶ CommRingCat.of R :=
  CommRingCat.ofHom (arcLocalMap f t ht)

theorem localRingEquiv_base (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    localizationBase (.of (arcChart f t)) (chartPoint f t ht) ≫
        (localRingEquiv f t ht).toCommRingCatIso.hom = chartLocalBase f t ht := by
  apply CommRingCat.hom_ext
  ext a
  rfl

/-- The native affine stalk comparison followed by the explicit original
localization-presentation comparison. -/
def affineStalkIso (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    (Spec (.of (arcChart f t))).presheaf.stalk (chartSchemePoint f t ht) ≅
      CommRingCat.of (arcLocalRing f t ht) :=
  spectrumStalkIso (.of (arcChart f t)) (chartPoint f t ht) ≪≫
    (localRingEquiv f t ht).toCommRingCatIso

theorem affineStalkIso_germ (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    (Spec (.of (arcChart f t))).presheaf.germ ⊤ (chartSchemePoint f t ht) (Opens.mem_top _) ≫
        (affineStalkIso f t ht).hom =
      (Scheme.ΓSpecIso (.of (arcChart f t))).hom ≫ chartLocalBase f t ht :=
  germ_iso_paste _ _ _ _ _ _
    (germ_localizationBase (.of (arcChart f t)) (chartPoint f t ht))
    (localRingEquiv_base f t ht)

/-- The original coefficient composite is literally the existing scalar map. -/
theorem chartLocalBase_scalar (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    CommRingCat.ofHom (algebraMap C (arcChart f t)) ≫ chartLocalBase f t ht =
      localScalar f t ht := rfl

/-- Localization uniqueness identifies the actual local quotient after the
explicit native presentation comparison; the target remains the same `R`. -/
theorem localMap_stalkIso_inv (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    (affineStalkIso f t ht).inv ≫
        Scheme.stalkClosedPointTo (Spec.map (CommRingCat.ofHom (arcMap f t ht))) =
      localQuotient f t ht := by
  let A : CommRingCat := .of (arcChart f t)
  let φ : A ⟶ CommRingCat.of R := CommRingCat.ofHom (arcMap f t ht)
  let e : CommRingCat.of (Localization.AtPrime (chartPoint f t ht).asIdeal) ≅
      CommRingCat.of (arcLocalRing f t ht) := (localRingEquiv f t ht).toCommRingCatIso
  let H : CommRingCat.of (arcLocalRing f t ht) ⟶ CommRingCat.of R :=
    localQuotient f t ht
  have hbase : localizationBase A (chartPoint f t ht) ≫ e.hom ≫ H = φ := by
    rw [← Category.assoc, localRingEquiv_base]
    apply CommRingCat.hom_ext
    ext a
    exact arcLocalMap_base f t ht a
  exact inverse_quotient_paste _ e _ H (stalkQuotient_of_base φ (e.hom ≫ H) hbase)

/-- The actual open chart identifies its selected scheme stalk with the
already defined local arc ring, using the same shared native stalk witness. -/
def chartStalkIso (f : C →+* R) (t : C) (ht : f t ≠ 0)
    {Y : Scheme.{u}} (j : Spec (.of (arcChart f t)) ⟶ Y) [IsOpenImmersion j] :
    Y.presheaf.stalk (j (chartSchemePoint f t ht)) ≅ CommRingCat.of (arcLocalRing f t ht) :=
  (openChartStalkWitness j (chartSchemePoint f t ht) _ (affineStalkIso f t ht)).val

theorem chartStalkIso_hom (f : C →+* R) (t : C) (ht : f t ≠ 0)
    {Y : Scheme.{u}} (j : Spec (.of (arcChart f t)) ⟶ Y) [IsOpenImmersion j] :
    (chartStalkIso f t ht j).hom = j.stalkMap (chartSchemePoint f t ht) ≫
      (affineStalkIso f t ht).hom :=
  (openChartStalkWitness j (chartSchemePoint f t ht) _ (affineStalkIso f t ht)).property

theorem chartStalkIso_quotient (f : C →+* R) (t : C) (ht : f t ≠ 0)
    {Y : Scheme.{u}} (j : Spec (.of (arcChart f t)) ⟶ Y) [IsOpenImmersion j] :
    (chartStalkIso f t ht j).hom ≫ localQuotient f t ht =
      Scheme.stalkClosedPointTo
        (Spec.map (CommRingCat.ofHom (arcMap f t ht)) ≫ j) := by
  rw [chartStalkIso_hom, Category.assoc,
    hom_quotient_of_inv _ _ _ (localMap_stalkIso_inv f t ht)]
  exact (closedPointTo_comp (X := Spec (.of (arcChart f t)))
    (Spec.map (CommRingCat.ofHom (arcMap f t ht))) j).symm

/-- The same original affine comparison with its native arc-image source. -/
def affineStalkIsoAtImage (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    (Spec (.of (arcChart f t))).presheaf.stalk
      (Spec.map (CommRingCat.ofHom (arcMap f t ht)) (specClosedPoint (.of R))) ≅
        CommRingCat.of (arcLocalRing f t ht) := affineStalkIso f t ht

theorem affineStalkIsoAtImage_quotient (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    (affineStalkIsoAtImage f t ht).hom ≫ localQuotient f t ht =
      Scheme.stalkClosedPointTo (Spec.map (CommRingCat.ofHom (arcMap f t ht))) :=
  hom_quotient_of_inv _ _ _ (localMap_stalkIso_inv f t ht)

theorem affineStalkIsoAtImage_germ (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    (Spec (.of (arcChart f t))).presheaf.germ ⊤
        (Spec.map (CommRingCat.ofHom (arcMap f t ht)) (specClosedPoint (.of R)))
          (Opens.mem_top _) ≫ (affineStalkIsoAtImage f t ht).hom =
      (Scheme.ΓSpecIso (.of (arcChart f t))).hom ≫ chartLocalBase f t ht :=
  affineStalkIso_germ f t ht

end LocalStalk

section ClosedPoint

variable {C R : Type u} [CommRing C] [IsLocalRing C]
  [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]

/-- The ordinary original closed-point blowup, with its actual maximal-ideal
centre. This construction imposes no regularity on that closed point. -/
def pointBlowup (C : Type u) [CommRing C] [IsLocalRing C] :
    BlowupDatum (affineCenter C (IsLocalRing.maximalIdeal C)) :=
  blowupDatum (affineCenter C (IsLocalRing.maximalIdeal C))

/-- The original surjection and uniformizer identify the arc centre with the
original maximal ideal. -/
theorem center_eq (f : C →+* R) (hf : Function.Surjective f)
    (t : C) (ht : Irreducible (f t)) : arcCenterIdeal f t = IsLocalRing.maximalIdeal C :=
  arcCenterIdeal_eq_maximalIdeal f t hf ht.maximalIdeal_eq

variable (B : BlowupDatum (affineCenter C (IsLocalRing.maximalIdeal C)))
  (f : C →+* R) (hf : Function.Surjective f) (t : C) (ht : Irreducible (f t))

/-- The original parameter belongs to the original source maximal ideal. -/
def maximalPivot : IsLocalRing.maximalIdeal C :=
  ⟨t, fun hu => ht.not_isUnit (hu.map f)⟩

/-- The original maximal-ideal chart and arc chart are equivalent over C by
exactly the proved equality of their original centre ideals. -/
def chartRingEquiv :
    affineBlowupAlgebra C (IsLocalRing.maximalIdeal C) (maximalPivot f t ht) ≃ₐ[C]
      arcChart f t :=
  chartIdealEquiv (IsLocalRing.maximalIdeal C) (arcCenterIdeal f t)
    (center_eq f hf t ht).symm t

/-- The original atlas chart has the literal original datum B as target. -/
def nativeChart :
    Spec (.of (affineBlowupAlgebra C (IsLocalRing.maximalIdeal C) (maximalPivot f t ht))) ⟶
      B.Y := (atlasChartWitness (IsLocalRing.maximalIdeal C) B (maximalPivot f t ht)).val

instance nativeChart_isOpenImmersion : IsOpenImmersion (nativeChart B f t ht) :=
  (atlasChartWitness (IsLocalRing.maximalIdeal C) B (maximalPivot f t ht)).property.1

omit [IsDomain R] [IsDiscreteValuationRing R] in
theorem nativeChart_map : nativeChart B f t ht ≫ B.map =
    affineChartMap C (IsLocalRing.maximalIdeal C) (maximalPivot f t ht) :=
  (atlasChartWitness (IsLocalRing.maximalIdeal C) B (maximalPivot f t ht)).property.2

/-- The actual scalar-compatible chart comparison as a typed native ring iso. -/
def chartRingIso :
    CommRingCat.of (affineBlowupAlgebra C (IsLocalRing.maximalIdeal C) (maximalPivot f t ht)) ≅
      CommRingCat.of (arcChart f t) := (chartRingEquiv f hf t ht).toRingEquiv.toCommRingCatIso

/-- The original saturated `t`-chart on the original closed-point blowup. -/
def chart : Spec (.of (arcChart f t)) ⟶ B.Y :=
  Spec.map (chartRingIso f hf t ht).hom ≫ nativeChart B f t ht

instance chart_isOpenImmersion : IsOpenImmersion (chart B f hf t ht) := by
  let : IsIso (Spec.map (chartRingIso f hf t ht).hom) := inferInstance
  change IsOpenImmersion
    (Spec.map (chartRingIso f hf t ht).hom ≫ nativeChart B f t ht)
  infer_instance

/-- The chart keeps its exact original scalar map to `Spec C`. -/
@[reassoc]
theorem chart_map : chart B f hf t ht ≫ B.map =
    Spec.map (CommRingCat.ofHom (algebraMap C (arcChart f t))) := by
  have hscalar : CommRingCat.ofHom (algebraMap C
      (affineBlowupAlgebra C (IsLocalRing.maximalIdeal C) (maximalPivot f t ht))) ≫
      (chartRingIso f hf t ht).hom =
        CommRingCat.ofHom (algebraMap C (arcChart f t)) := by
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro c
    change (chartRingEquiv f hf t ht)
      (algebraMap C (affineBlowupAlgebra C (IsLocalRing.maximalIdeal C)
        (maximalPivot f t ht)) c) = algebraMap C (arcChart f t) c
    exact (chartRingEquiv f hf t ht).commutes c
  calc
    chart B f hf t ht ≫ B.map =
        Spec.map (chartRingIso f hf t ht).hom ≫
          affineChartMap C (IsLocalRing.maximalIdeal C) (maximalPivot f t ht) := by
      rw [chart, Category.assoc, nativeChart_map]
    _ = _ := by rw [affineChartMap, ← Spec.map_comp, hscalar]

/-- One specialization constructs all actual lift/point/stalk/coefficient
values and their original equations together. -/
def stepData : ClosedArcChartData
    (C := .of C) (R := .of R) (A := .of (arcChart f t))
    (D := .of (arcLocalRing f t ht.ne_zero)) B.map (chart B f hf t ht)
    (CommRingCat.ofHom (arcMap f t ht.ne_zero)) (CommRingCat.ofHom f)
    (localScalar f t ht.ne_zero) (localQuotient f t ht.ne_zero) := by
  have hcφ : CommRingCat.ofHom (algebraMap C (arcChart f t)) ≫
      CommRingCat.ofHom (arcMap f t ht.ne_zero) = CommRingCat.ofHom f := by
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro c
    exact arcMap_base f t ht.ne_zero c
  have hhH : localScalar f t ht.ne_zero ≫ localQuotient f t ht.ne_zero =
      CommRingCat.ofHom f := by
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro c
    exact arcLocalMap_arcLocalBase f t ht.ne_zero c
  exact closedArcChartData
    (C := .of C) (R := .of R) (A := .of (arcChart f t))
    (D := .of (arcLocalRing f t ht.ne_zero)) B.map (chart B f hf t ht)
    (CommRingCat.ofHom (algebraMap C (arcChart f t)))
    (CommRingCat.ofHom (arcMap f t ht.ne_zero)) (CommRingCat.ofHom f)
    (chartLocalBase f t ht.ne_zero) (localScalar f t ht.ne_zero)
    (localQuotient f t ht.ne_zero) (affineStalkIsoAtImage f t ht.ne_zero)
    (chart_map B f hf t ht) hcφ (chartLocalBase_scalar f t ht.ne_zero) hhH
    (affineStalkIsoAtImage_quotient f t ht.ne_zero) (affineStalkIsoAtImage_germ f t ht.ne_zero)

/-- The original-chart arc lift is the actual arrow of the shared witness. -/
def lift : Spec (.of R) ⟶ B.Y := (stepData B f hf t ht).arc

theorem lift_value : lift B f hf t ht =
    Spec.map (CommRingCat.ofHom (arcMap f t ht.ne_zero)) ≫ chart B f hf t ht :=
  (stepData B f hf t ht).value

/-- The actual constructed lift has the original base triangle. -/
@[reassoc]
theorem lift_map : lift B f hf t ht ≫ B.map = Spec.map (CommRingCat.ofHom f) :=
  (stepData B f hf t ht).base

include hf t ht in
/-- The actual inverse-image centre is Cartier on the original DVR. Its
principal ideal is proved free directly, without a nonflat module comparison. -/
theorem cartier_specMap :
    cartierPullback (affineCenter C (IsLocalRing.maximalIdeal C))
      (Spec.map (CommRingCat.ofHom f)) := by
  unfold cartierPullback
  rw [← center_eq f hf t ht, BaseChange.affineCenter_comap, map_arcCenterIdeal]
  exact affineCenter_rankOne_of_equiv R _ (principalIdealEquiv (f t) ht.ne_zero)

/-- The explicit original-chart lift is the actual universal blowup lift. -/
theorem lift_eq_universalLift :
    lift B f hf t ht = BlowupDatum.lift B
      (Spec.map (CommRingCat.ofHom f)) (cartier_specMap f hf t ht) :=
  BlowupDatum.hom_ext B (cartier_specMap f hf t ht) (lift_map B f hf t ht)
    (BlowupDatum.lift_map B (Spec.map (CommRingCat.ofHom f)) (cartier_specMap f hf t ht))

/-- The exact point on the original blowup selected by the original arc. -/
def point : B.Y := (stepData B f hf t ht).arc (specClosedPoint (.of R))

@[simp]
theorem lift_closedPoint : lift B f hf t ht (specClosedPoint (.of R)) =
    point B f hf t ht := rfl

/-- The point is on the original chart at the image of the original DVR point. -/
theorem point_chart : point B f hf t ht = chart B f hf t ht
    (Spec.map (CommRingCat.ofHom (arcMap f t ht.ne_zero)) (specClosedPoint (.of R))) :=
  (stepData B f hf t ht).point_chart

/-- The original arc-selected point lies above the original closed point. -/
theorem map_point : B.map (point B f hf t ht) = specClosedPoint (.of C) :=
  (stepData B f hf t ht).map_point (IsLocalHom.of_surjective f hf)

/-- The actual original scheme stalk is the already constructed local arc ring. -/
def stalkIso : B.Y.presheaf.stalk (point B f hf t ht) ≅
    CommRingCat.of (arcLocalRing f t ht.ne_zero) := (stepData B f hf t ht).stalk

/-- The corresponding ring equivalence retains the same actual stalk map. -/
def stalkEquiv : B.Y.presheaf.stalk (point B f hf t ht) ≃+* arcLocalRing f t ht.ne_zero :=
  (stalkIso B f hf t ht).commRingCatIsoToRingEquiv

/-- The stalk comparison commutes with the quotient to the SAME original DVR. -/
theorem stalkIso_quotient :
    (stalkIso B f hf t ht).hom ≫ localQuotient f t ht.ne_zero =
      Scheme.stalkClosedPointTo (lift B f hf t ht) :=
  (stepData B f hf t ht).stalk_quotient

/-- The original coefficient arrow is projected with its actual value equation. -/
def coefficient : CommRingCat.of C ⟶ B.Y.presheaf.stalk (point B f hf t ht) :=
  (stepData B f hf t ht).coefficient

theorem coefficient_value : coefficient B f hf t ht =
    (Scheme.ΓSpecIso (.of C)).inv ≫ B.map.appTop ≫
      B.Y.presheaf.germ ⊤ (point B f hf t ht) (Opens.mem_top _) :=
  (stepData B f hf t ht).coefficient_value

/-- The stalk comparison keeps the original scalar homomorphism. -/
theorem coefficient_stalkIso : coefficient B f hf t ht ≫ (stalkIso B f hf t ht).hom =
    localScalar f t ht.ne_zero :=
  (stepData B f hf t ht).coefficient_stalk

/-- The original coefficient map followed by the actual quotient is the
original surjection, using the same shared witness. -/
theorem coefficient_quotient :
    coefficient B f hf t ht ≫ Scheme.stalkClosedPointTo (lift B f hf t ht) =
      CommRingCat.ofHom f := (stepData B f hf t ht).coefficient_quotient

/-- The distinguished parameter uses the original coefficient and scalar maps. -/
theorem stalkIso_parameter :
    (stalkIso B f hf t ht).hom.hom ((coefficient B f hf t ht).hom t) =
      arcLocalBase f t ht.ne_zero t :=
  (stepData B f hf t ht).coefficient_stalk_apply t

/-- The distinguished parameter still maps to the original DVR uniformizer. -/
theorem quotient_parameter :
    (Scheme.stalkClosedPointTo (lift B f hf t ht)).hom ((coefficient B f hf t ht).hom t) =
      f t := (stepData B f hf t ht).coefficient_quotient_apply t

section Noetherian

variable [IsNoetherianRing C]

/-- The actual lifted arc remains a closed immersion because the original
quotient arc is closed and the actual point blowdown is separated. -/
theorem lift_isClosedImmersion : IsClosedImmersion (lift B f hf t ht) := by
  let : IsProper B.map := B.isProper_of_spectrum
  exact (stepData B f hf t ht).closed inferInstance
    (IsClosedImmersion.spec_of_surjective _ hf)

/-- The next original-scheme centre is the closed point of the same witness. -/
theorem point_isClosed : IsClosed ({point B f hf t ht} : Set B.Y) := by
  let : IsProper B.map := B.isProper_of_spectrum
  exact (stepData B f hf t ht).point_closed inferInstance
    (IsClosedImmersion.spec_of_surjective _ hf)

include hf t ht in
/-- The actual constructed ordinary closed-point blowup admits this closed
arc lift with its original base triangle. -/
theorem exists_closedLift :
    ∃ g : Spec (.of R) ⟶ (pointBlowup C).Y,
      g ≫ (pointBlowup C).map = Spec.map (CommRingCat.ofHom f) ∧ IsClosedImmersion g :=
  ⟨lift (pointBlowup C) f hf t ht, lift_map (pointBlowup C) f hf t ht,
    lift_isClosedImmersion (pointBlowup C) f hf t ht⟩

end Noetherian
end ClosedPoint

end AlgebraicGeometry.Scheme.Blowup.Arc
