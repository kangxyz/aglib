module

public import Aglib.AlgebraicGeometry.ProjectiveSpace.AwayAlgebra
public import Aglib.RingTheory.Grassmannian.CoordinateChart

/-!
# Coordinate rings of `Gr(R^m, 1)` and of projective space

Let `e : ι ≃ Fin m` label the homogeneous coordinates of `ProjectiveSpace R ι`. The chart of
Mathlib's Grassmannian of rank-one quotients of `R^m` at the basis vector `e_{e i}` has the
coordinate ring `ChartRing R (coordinateTuple R I)`, generated by the coordinates `Φ_{0 j}` with
the single relation `Φ_{0, e i} = 1`; the standard chart `D₊(Xᵢ)` of projective space has the
coordinate ring `coordinateRing R ι i`, generated by the ratios `X_k / X_i`. This file identifies
the two rings (`chartToCoordinate`, `coordinateToChart`, sending `Φ_{0 j}` to `X_{e⁻¹ j} / X_i`),
and identifies the overlap rings: the localization of the chart ring at the transition
determinant `Φ_{0, e l}` with the degree-zero localization at `X_i X_l` (`overlapChartEquiv`).
In the overlap ring, the chart points computed from the charts at `e i` and at `e l` agree
(`ofChartSection_overlap`), because the two chart sections differ by the unit `X_i / X_l`.

The `R`-algebra structure on the projective chart rings is `awayAlgebra`
(`Aglib.AlgebraicGeometry.ProjectiveSpace.AwayAlgebra`); the general facts about chart sections
and rank-one coordinate charts are in `Aglib.RingTheory.Grassmannian.CoordinateChart`.

## Main definitions and results

- `AlgebraicGeometry.ProjectiveSpace.chartRatioSection`: the chart section
  `v ↦ Σ_j v_j X_{e⁻¹ j} / X_i`.
- `AlgebraicGeometry.ProjectiveSpace.chartToCoordinate`,
  `AlgebraicGeometry.ProjectiveSpace.coordinateToChart`, the two inverse laws, and the algebra
  isomorphism `chartCoordinateEquiv`.
- `AlgebraicGeometry.ProjectiveSpace.ofChartSection_overlap`: the chart sections from the charts
  at `e i` and `e l` differ by the unit `X_i / X_l` on `D₊(Xᵢ Xₗ)`, so their chart points agree.
- `AlgebraicGeometry.ProjectiveSpace.overlapChartEquiv`.
-/

@[expose] public section

noncomputable section

set_option backward.isDefEq.respectTransparency false

open CategoryTheory MvPolynomial HomogeneousLocalization TensorProduct

universe u v w

attribute [local instance] MvPolynomial.gradedAlgebra

namespace AlgebraicGeometry.ProjectiveSpace

open Module.Grassmannian

variable (R : Type u) [CommRing R] {ι : Type u}

variable {m : ℕ} (e : ι ≃ Fin m)

/-- The chart section of the Grassmannian chart attached to the standard chart `D₊(Xᵢ)`:
`v ↦ Σ_j v_j X_{e⁻¹ j} / X_i`. -/
def chartRatioSection (i : ι) : (Fin m → R) →ₗ[R] (Fin 1 → coordinateRing R ι i) :=
  LinearMap.pi fun _ ↦
    ∑ j, (LinearMap.proj j : (Fin m → R) →ₗ[R] R).smulRight
      (coordinateRatio R ι i (e.symm j))

theorem chartRatioSection_apply (i : ι) (v : Fin m → R) (a : Fin 1) :
    chartRatioSection R e i v a =
      ∑ j, algebraMap R (coordinateRing R ι i) (v j) * coordinateRatio R ι i (e.symm j) := by
  simp only [chartRatioSection, LinearMap.pi_apply, LinearMap.sum_apply,
    LinearMap.smulRight_apply, LinearMap.proj_apply]
  exact Finset.sum_congr rfl fun j _ ↦ Algebra.smul_def _ _

theorem chartRatioSection_single (i : ι) (j : Fin m) (a : Fin 1) :
    chartRatioSection R e i (Pi.single j 1) a = coordinateRatio R ι i (e.symm j) := by
  rw [chartRatioSection_apply, Finset.sum_eq_single j (fun j' _ hj' ↦ by
    rw [Pi.single_eq_of_ne hj', map_zero, zero_mul]) (fun h ↦ (h (Finset.mem_univ j)).elim),
    Pi.single_eq_same, map_one, one_mul]

theorem chartRatioSection_mem (I : Fin 1 → Fin m) (i : ι) (h : I 0 = e i) :
    chartRatioSection R e i ∈ chartSections R (coordinateRing R ι i) (coordinateTuple R I) := by
  intro b
  ext a
  have hb : b = 0 := Subsingleton.elim _ _
  have ha : a = 0 := Subsingleton.elim _ _
  subst hb ha
  rw [coordinateTuple, chartRatioSection_single, h, Equiv.symm_apply_apply, coordinateRatio_self,
    Pi.single_eq_same]

/-- The coordinate ring of the Grassmannian chart at `I`, with `I 0 = e i`, maps to the
standard chart ring at `i` by `Φ_{0 j} ↦ X_{e⁻¹ j} / X_i`. -/
def chartToCoordinate (I : Fin 1 → Fin m) (i : ι) (h : I 0 = e i) :
    ChartRing R (coordinateTuple R I) →ₐ[R] coordinateRing R ι i :=
  chartSectionToAlgHom (chartRatioSection R e i) (chartRatioSection_mem R e I i h)

@[simp]
theorem chartToCoordinate_coordinate (I : Fin 1 → Fin m) (i : ι) (h : I 0 = e i) (a : Fin 1)
    (j : Fin m) :
    chartToCoordinate R e I i h (chartCoordinate _ a j) = coordinateRatio R ι i (e.symm j) := by
  rw [chartToCoordinate, chartSectionToAlgHom_coordinate, chartRatioSection_single]

/-- The linear section of `chartToCoordinate` is `chartRatioSection`. -/
theorem algHomToChartSection_chartToCoordinate (I : Fin 1 → Fin m) (i : ι) (h : I 0 = e i) :
    algHomToChartSection _ (coordinateTuple R I) (chartToCoordinate R e I i h) =
      chartRatioSection R e i :=
  algHomToChartSection_chartSectionToAlgHom _ _

/-- The standard chart ring at `i` maps to the coordinate ring of the Grassmannian chart at `I`
by `X_k / X_i ↦ Φ_{0, e k}`. -/
def coordinateToChart (I : Fin 1 → Fin m) (i : ι) :
    coordinateRing R ι i →ₐ[R] ChartRing R (coordinateTuple R I) where
  toRingHom := (MvPolynomial.aeval (R := R) fun j : {j : ι // j ≠ i} ↦
      chartCoordinate (coordinateTuple R I) 0 (e j.1)).toRingHom.comp
    (coordinateRingToPolynomial R ι i)
  commutes' r := by
    change MvPolynomial.aeval _ (coordinateRingToPolynomial R ι i
      (coordinateRingCoefficient R ι i r)) = _
    rw [coordinateRingToPolynomial_coefficient, MvPolynomial.aeval_C]

theorem coordinateToChart_ratio (I : Fin 1 → Fin m) (i : ι) (h : I 0 = e i) (k : ι) :
    coordinateToChart R e I i (coordinateRatio R ι i k) =
      chartCoordinate (coordinateTuple R I) 0 (e k) := by
  by_cases hk : k = i
  · subst hk
    rw [coordinateRatio_self, map_one, ← h, chartCoordinate_coordinateTuple_self]
  · change MvPolynomial.aeval _ (coordinateRingToPolynomial R ι i (coordinateRatio R ι i k)) = _
    rw [show coordinateRatio R ι i k =
      coordinateRatio R ι i (⟨k, hk⟩ : {j : ι // j ≠ i}).1 from rfl,
      coordinateRingToPolynomial_ratio, MvPolynomial.aeval_X]

theorem chartToCoordinate_comp_coordinateToChart (I : Fin 1 → Fin m) (i : ι) (h : I 0 = e i) :
    (chartToCoordinate R e I i h).comp (coordinateToChart R e I i) = AlgHom.id R _ :=
  coordinateRing_algHom_ext R fun k ↦ by
    rw [AlgHom.comp_apply, coordinateToChart_ratio R e I i h, chartToCoordinate_coordinate,
      Equiv.symm_apply_apply, AlgHom.id_apply]

theorem coordinateToChart_comp_chartToCoordinate (I : Fin 1 → Fin m) (i : ι) (h : I 0 = e i) :
    (coordinateToChart R e I i).comp (chartToCoordinate R e I i h) = AlgHom.id R _ :=
  chartRing_algHom_ext fun a j ↦ by
    have ha : a = 0 := Subsingleton.elim _ _
    subst ha
    rw [AlgHom.comp_apply, chartToCoordinate_coordinate, coordinateToChart_ratio R e I i h,
      Equiv.apply_symm_apply, AlgHom.id_apply]

/-- **The chart rings agree.** The coordinate ring of the Grassmannian chart at `I`, with
`I 0 = e i`, is the standard chart ring at `i`, itself the polynomial ring in the coordinates other
than `i` (`coordinateRingEquivPolynomial`). -/
def chartCoordinateEquiv (I : Fin 1 → Fin m) (i : ι) (h : I 0 = e i) :
    ChartRing R (coordinateTuple R I) ≃ₐ[R] coordinateRing R ι i :=
  AlgEquiv.ofAlgHom (chartToCoordinate R e I i h) (coordinateToChart R e I i)
    (chartToCoordinate_comp_coordinateToChart R e I i h)
    (coordinateToChart_comp_chartToCoordinate R e I i h)

@[simp]
theorem chartToCoordinate_coordinateToChart (I : Fin 1 → Fin m) (i : ι) (h : I 0 = e i)
    (y : coordinateRing R ι i) :
    chartToCoordinate R e I i h (coordinateToChart R e I i y) = y :=
  AlgHom.congr_fun (chartToCoordinate_comp_coordinateToChart R e I i h) y

@[simp]
theorem coordinateToChart_chartToCoordinate (I : Fin 1 → Fin m) (i : ι) (h : I 0 = e i)
    (z : ChartRing R (coordinateTuple R I)) :
    coordinateToChart R e I i (chartToCoordinate R e I i h z) = z :=
  AlgHom.congr_fun (coordinateToChart_comp_chartToCoordinate R e I i h) z

section Overlap

variable (i l : ι)

variable (I J : Fin 1 → Fin m) (hI : I 0 = e i) (hJ : J 0 = e l)

/-- In the overlap ring, the chart points computed from the Grassmannian charts at `I` (through
`D₊(Xᵢ)`) and at `J` (through `D₊(Xₗ)`) agree. -/
theorem ofChartSection_overlap :
    ofChartSection (algHomToChartSection _ (coordinateTuple R I)
        ((overlapLeft R i l).comp (chartToCoordinate R e I i hI)))
        (algHomToChartSection_mem _ _) =
      ofChartSection (algHomToChartSection _ (coordinateTuple R J)
        ((overlapRight R i l).comp (chartToCoordinate R e J l hJ)))
        (algHomToChartSection_mem _ _) := by
  refine ofChartSection_eq_of_smul _ _ (overlapRight R i l (coordinateRatio R ι l i))
    (isUnit_overlapRight_ratio R i l) fun v ↦ funext fun a ↦ ?_
  simp only [algHomToChartSection_apply, AlgHom.comp_apply, chartToCoordinate_coordinate,
    Pi.smul_apply, smul_eq_mul, Algebra.smul_def, Finset.mul_sum,
    overlapRight_ratio R i l (e.symm _)]
  exact Finset.sum_congr rfl fun j _ ↦ mul_left_comm _ _ _

/-- The composite `ChartRing_I → B_i → B_{il}`. -/
abbrev chartToOverlap : ChartRing R (coordinateTuple R I) →ₐ[R]
    Away (homogeneousSubmodule ι R) (X i * X l) :=
  (overlapLeft R i l).comp (chartToCoordinate R e I i hI)

include hJ in
theorem chartToOverlap_transitionDet :
    chartToOverlap R e i l I hI (chartTransitionDet (coordinateTuple R I) (coordinateTuple R J)) =
      overlapLeft R i l (coordinateRatio R ι i l) := by
  rw [chartTransitionDet_coordinateTuple, AlgHom.comp_apply, chartToCoordinate_coordinate, hJ,
    Equiv.symm_apply_apply]

include hJ in
theorem isUnit_chartToOverlap_transitionDet :
    IsUnit (chartToOverlap R e i l I hI
      (chartTransitionDet (coordinateTuple R I) (coordinateTuple R J))) := by
  rw [chartToOverlap_transitionDet R e i l I J hI hJ]
  exact isUnit_overlapLeft_ratio R i l

/-- The localization of the chart ring at the transition determinant maps to the overlap ring
`B_{il}`. -/
def overlapChartToCoordinate :
    Localization.Away (chartTransitionDet (coordinateTuple R I) (coordinateTuple R J)) →+*
      Away (homogeneousSubmodule ι R) (X i * X l) :=
  IsLocalization.Away.lift (chartTransitionDet (coordinateTuple R I) (coordinateTuple R J))
    (g := (chartToOverlap R e i l I hI).toRingHom)
    (isUnit_chartToOverlap_transitionDet R e i l I J hI hJ)

include hI hJ in
/-- The ratio `X_l / X_i` maps to a unit of the localization of the chart ring. -/
theorem isUnit_coordinateToChart_ratio :
    IsUnit ((algebraMap (ChartRing R (coordinateTuple R I))
      (Localization.Away (chartTransitionDet (coordinateTuple R I) (coordinateTuple R J)))).comp
        (coordinateToChart R e I i).toRingHom (overlapElem R i l)) := by
  rw [overlapElem_eq, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
    coordinateToChart_ratio R e I i hI, ← hJ, ← chartTransitionDet_coordinateTuple]
  exact IsLocalization.Away.algebraMap_isUnit _

/-- The overlap ring `B_{il}` maps to the localization of the chart ring at the transition
determinant. -/
def overlapCoordinateToChart :
    Away (homogeneousSubmodule ι R) (X i * X l) →+*
      Localization.Away (chartTransitionDet (coordinateTuple R I) (coordinateTuple R J)) :=
  letI := (awayMap (homogeneousSubmodule ι R) (isHomogeneous_X R l)
    (rfl : X (R := R) i * X l = X i * X l)).toAlgebra
  haveI := Away.isLocalization_mul (𝒜 := homogeneousSubmodule ι R) (isHomogeneous_X R i)
    (isHomogeneous_X R l) (rfl : X (R := R) i * X l = X i * X l) one_ne_zero
  IsLocalization.Away.lift (overlapElem R i l) (isUnit_coordinateToChart_ratio R e i l I J hI hJ)

theorem overlapCoordinateToChart_overlapLeft (y : coordinateRing R ι i) :
    overlapCoordinateToChart R e i l I J hI hJ (overlapLeft R i l y) =
      algebraMap _ _ (coordinateToChart R e I i y) := by
  let _ := (awayMap (homogeneousSubmodule ι R) (isHomogeneous_X R l)
    (rfl : X (R := R) i * X l = X i * X l)).toAlgebra
  have := Away.isLocalization_mul (𝒜 := homogeneousSubmodule ι R) (isHomogeneous_X R i)
    (isHomogeneous_X R l) (rfl : X (R := R) i * X l = X i * X l) one_ne_zero
  exact IsLocalization.Away.lift_eq (overlapElem R i l) _ y

theorem overlapChartToCoordinate_algebraMap (z : ChartRing R (coordinateTuple R I)) :
    overlapChartToCoordinate R e i l I J hI hJ (algebraMap _ _ z) =
      overlapLeft R i l (chartToCoordinate R e I i hI z) :=
  IsLocalization.Away.lift_eq _ _ z

theorem overlapChartToCoordinate_comp_overlapCoordinateToChart :
    (overlapChartToCoordinate R e i l I J hI hJ).comp (overlapCoordinateToChart R e i l I J hI hJ) =
      RingHom.id _ := by
  let _ := (awayMap (homogeneousSubmodule ι R) (isHomogeneous_X R l)
    (rfl : X (R := R) i * X l = X i * X l)).toAlgebra
  have := Away.isLocalization_mul (𝒜 := homogeneousSubmodule ι R) (isHomogeneous_X R i)
    (isHomogeneous_X R l) (rfl : X (R := R) i * X l = X i * X l) one_ne_zero
  apply IsLocalization.ringHom_ext (Submonoid.powers (overlapElem R i l))
  refine RingHom.ext fun y ↦ ?_
  change overlapChartToCoordinate R e i l I J hI hJ
      (overlapCoordinateToChart R e i l I J hI hJ (overlapLeft R i l y)) = overlapLeft R i l y
  rw [overlapCoordinateToChart_overlapLeft, overlapChartToCoordinate_algebraMap,
    chartToCoordinate_coordinateToChart]

theorem overlapCoordinateToChart_comp_overlapChartToCoordinate :
    (overlapCoordinateToChart R e i l I J hI hJ).comp (overlapChartToCoordinate R e i l I J hI hJ) =
      RingHom.id _ := by
  apply IsLocalization.ringHom_ext (Submonoid.powers
    (chartTransitionDet (coordinateTuple R I) (coordinateTuple R J)))
  refine RingHom.ext fun z ↦ ?_
  rw [RingHom.comp_apply, RingHom.comp_apply, overlapChartToCoordinate_algebraMap,
    overlapCoordinateToChart_overlapLeft, coordinateToChart_chartToCoordinate, RingHom.comp_apply,
    RingHom.id_apply]

/-- The overlap of the Grassmannian charts at `I` and `J`, the localization of the chart ring at
the transition determinant, is the overlap ring `B_{il} = (MvPolynomial ι R)_{(Xᵢ Xₗ)}`. -/
def overlapChartEquiv :
    Localization.Away (chartTransitionDet (coordinateTuple R I) (coordinateTuple R J)) ≃+*
      Away (homogeneousSubmodule ι R) (X i * X l) :=
  RingEquiv.ofRingHom (overlapChartToCoordinate R e i l I J hI hJ)
    (overlapCoordinateToChart R e i l I J hI hJ)
    (overlapChartToCoordinate_comp_overlapCoordinateToChart R e i l I J hI hJ)
    (overlapCoordinateToChart_comp_overlapChartToCoordinate R e i l I J hI hJ)

theorem overlapChartEquiv_toRingHom :
    (overlapChartEquiv R e i l I J hI hJ).toRingHom = overlapChartToCoordinate R e i l I J hI hJ :=
  rfl

end Overlap

end AlgebraicGeometry.ProjectiveSpace
