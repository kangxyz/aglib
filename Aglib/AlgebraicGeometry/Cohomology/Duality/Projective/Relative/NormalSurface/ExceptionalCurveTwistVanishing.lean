/-- The residue field retains the native quotient ring operations. -/
local instance exceptionalTwistResidueField (A : Type u) [CommRing A] [IsLocalRing A] :
    Field (A ⧸ IsLocalRing.maximalIdeal A) := Ideal.Quotient.field _

set_option backward.isDefEq.respectTransparency false in
private theorem epi_globalSectionsEval_of_generatingSections
    {X : Scheme.{u}} {M : X.Modules} (σ : M.GeneratingSections) :
    Epi (Modules.globalSectionsEval M) := by
  let s : σ.I → (𝟙_ X.Modules ⟶ M) :=
    fun i => Sigma.ι (fun _ : σ.I => 𝟙_ X.Modules) i ≫ σ.π
  let f : SheafOfModules.free σ.I ⟶
      ∐ fun _ : (𝟙_ X.Modules ⟶ M) => 𝟙_ X.Modules :=
    Sigma.desc fun i => Sigma.ι (fun _ : (𝟙_ X.Modules ⟶ M) => 𝟙_ X.Modules) (s i)
  apply epi_of_epi_fac (f := f) (h := σ.π)
  apply Sigma.hom_ext
  intro i
  simp only [f, Sigma.ι_comp_desc_assoc, s]
  exact Modules.ι_globalSectionsEval M _

private theorem exceptionalPowerLayer_finrank_ge_two
    (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    (hd : ringKrullDim A = 2) (q : ℕ) (hq : q ≠ 0) :
    2 ≤ Module.finrank (A ⧸ IsLocalRing.maximalIdeal A)
      (exceptionalPowerLayer A q) := by
  let m := IsLocalRing.maximalIdeal A
  have hmins : (m ^ q).minimalPrimes = m.minimalPrimes := by
    calc
      (m ^ q).minimalPrimes = (m ^ q).radical.minimalPrimes :=
        Ideal.radical_minimalPrimes.symm
      _ = m.minimalPrimes :=
        congrArg Ideal.minimalPrimes ((Ideal.radical_pow (I := m) hq).trans
          (Ideal.IsPrime.radical (I := m) inferInstance))
  have hheight : (m ^ q).height = m.height := by
    rw [Ideal.height_eq_inf_minimalPrimes, hmins, ← Ideal.height_eq_inf_minimalPrimes]
  have hproper : m ^ q ≠ ⊤ := by
    intro he
    have hm : m = ⊤ := top_le_iff.mp (he ▸ Ideal.pow_le_self hq)
    exact Ideal.IsPrime.ne_top' hm
  have h := (m ^ q).height_le_spanFinrank hproper
  rw [hheight] at h
  have hd' : ringKrullDim A ≤ (m ^ q).spanFinrank :=
    le_of_eq_of_le IsLocalRing.maximalIdeal_height_eq_ringKrullDim.symm
      (WithBot.coe_le_coe.mpr h)
  rw [hd, IsLocalRing.spanFinrank_eq_finrank_quotient (m ^ q)
    (m ^ q).fg_of_isNoetherianRing] at hd'
  exact_mod_cast hd'

private theorem exceptionalPowerSections_finrank_ge_two
    (A : Type u) [CommRing A] [IsLocalRing A] [IsDomain A]
    [IsNoetherianRing A] [IsIntegrallyClosed A]
    (hd : ringKrullDim A = 2) (hA : IsNagataRing.{u, 0} A)
    (hRat : NormalModificationH1Vanishing A) (q : ℕ) (hq : q ≠ 0) :
    2 ≤ Module.finrank (A ⧸ IsLocalRing.maximalIdeal A)
      (exceptionalPowerSections A hd q) := by
  rw [← (exceptionalPowerTheta A hd hA hRat q).finrank_eq]
  exact exceptionalPowerLayer_finrank_ge_two A hd q hq


/-- No positive original exceptional ideal power is the structure sheaf. -/
theorem exceptionalPower_not_trivial
    (A : Type u) [CommRing A] [IsLocalRing A] [IsDomain A]
    [IsNoetherianRing A] [IsIntegrallyClosed A]
    (hd : ringKrullDim A = 2) (hA : IsNagataRing.{u, 0} A)
    (hRat : NormalModificationH1Vanishing A) (q : ℕ) (hq : q ≠ 0) :
    ¬ Nonempty (exceptionalPower A hd q ≅ originalUnit (exceptionalCurve A hd)) := by
  rintro ⟨e⟩
  let E := exceptionalCurve A hd
  let κ := A ⧸ IsLocalRing.maximalIdeal A
  let : Field κ := Ideal.Quotient.field (IsLocalRing.maximalIdeal A)
  let c : κ →+* Γ(E, ⊤) := exceptionalCoefficients A hd
  let F := Cohomology.moduleGlobalSectionsFunctorOfHom E c
  let eS : exceptionalPowerSections A hd q ≃ₗ[κ] F.obj (originalUnit E) :=
    (F.mapIso e).toLinearEquiv
  let N : ModuleCat.{u} κ := F.obj (originalUnit E)
  let cL : κ →ₗ[κ] N :=
    { toFun := fun a => (show N from c a)
      map_add' := fun a b => c.map_add a b
      map_smul' := fun a b => by
        change c (a * b) = c a * c b
        exact c.map_mul a b }
  let eC : κ ≃ₗ[κ] N := LinearEquiv.ofBijective cL
    (exceptionalCoefficients_bijective A hd hA hRat)
  have hdim : Module.finrank κ (exceptionalPowerSections A hd q) = 1 :=
    (eS.trans eC.symm).finrank_eq.trans (Module.finrank_self κ)
  have htwo := exceptionalPowerSections_finrank_ge_two A hd hA hRat q hq
  rw [hdim] at htwo
  omega

private def positiveTwistingPowerIso
    (k : Type u) [CommRing k] (ι : Type u) :
    (q : ℕ) →
      (tensorPowerLineBundle (ProjectiveSpace k ι) (twistingLineBundle k ι 1) q).val ≅
        twistingSheaf k ι (q : ℤ)
  | 0 => PowerPullback.freeUnitIso _ ≪≫ (twistingZeroIso k ι).symm
  | q + 1 => tensorSheafIso _ (Iso.refl _) (positiveTwistingPowerIso k ι q) ≪≫
      twistingTensorIso k ι 1 (q : ℤ) ≪≫
        eqToIso (congrArg (twistingSheaf k ι) (by omega))

private def exceptionalPositiveTwistIso
    (A : Type u) [CommRing A] [IsLocalRing A]
    (hd : ringKrullDim A = 2) (ι : Type u)
    (j : exceptionalCurve A hd ⟶ ProjectiveSpace (A ⧸ IsLocalRing.maximalIdeal A) ι)
    (e : (Modules.pullback j).obj
      (twistingSheaf (A ⧸ IsLocalRing.maximalIdeal A) ι 1) ≅ (exceptionalLine A hd).val)
    (q : ℕ) :
    (Modules.pullback j).obj
      (twistingSheaf (A ⧸ IsLocalRing.maximalIdeal A) ι (q : ℤ)) ≅
        exceptionalPower A hd q :=
  (Modules.pullback j).mapIso (positiveTwistingPowerIso _ ι q).symm ≪≫
    PowerPullback.pullbackPowerIso j (twistingLineBundle _ ι 1) q ≪≫
    TrivializedPower.powerIso _ e q ≪≫ (exceptionalPowerTensorIso A hd q).symm

set_option backward.isDefEq.respectTransparency false in
private def exceptionalPositivePowerGeneratingSections
    (A : Type u) [CommRing A] [IsLocalRing A]
    (hd : ringKrullDim A = 2) (ι : Type u)
    (j : exceptionalCurve A hd ⟶ ProjectiveSpace (A ⧸ IsLocalRing.maximalIdeal A) ι)
    (e : (Modules.pullback j).obj
      (twistingSheaf (A ⧸ IsLocalRing.maximalIdeal A) ι 1) ≅ (exceptionalLine A hd).val)
    (q : ℕ) : (exceptionalPower A hd q).GeneratingSections := by
  let : PreservesColimitsOfSize.{u, u} (Modules.pullback j) :=
    (pullbackPushforwardAdjunction j).leftAdjoint_preservesColimits
  exact ((coordinatePowerGeneratingSections (A ⧸ IsLocalRing.maximalIdeal A) ι q).map
    (Modules.pullback j) (pullbackUnitIso j).symm).ofEpi
      (exceptionalPositiveTwistIso A hd ι j e q).hom

theorem exceptionalStructuralH0_bijective
    (A : Type u) [CommRing A] [IsLocalRing A] [IsDomain A]
    [IsNoetherianRing A] [IsIntegrallyClosed A]
    (hd : ringKrullDim A = 2) (hA : IsNagataRing.{u, 0} A)
    (hRat : NormalModificationH1Vanishing A) (ι : Type u)
    (j : exceptionalCurve A hd ⟶ ProjectiveSpace (A ⧸ IsLocalRing.maximalIdeal A) ι)
    (hj : j ≫ toSpec (A ⧸ IsLocalRing.maximalIdeal A) ι = exceptionalStructureMap A hd) :
    Function.Bijective (cmCurveSerreStructuralH0Map (A ⧸ IsLocalRing.maximalIdeal A) ι j) := by
  let E := exceptionalCurve A hd
  let κ := A ⧸ IsLocalRing.maximalIdeal A
  let c := cmCurveSerreScalar κ ι j
  have hc : c = exceptionalCoefficients A hd := by
    change (j ≫ toSpec κ ι).appTop.hom.comp (Scheme.ΓSpecIso (.of κ)).inv.hom = _
    rw [hj]
    rfl
  let H := moduleH0EquivOfHom E c (cmCurveSerreUnit E)
  have heq : H ∘ cmCurveSerreStructuralH0Map κ ι j = c := by
    funext a
    exact cmCurveSerreStructuralH0Map_sections κ ι j a
  have hb : Function.Bijective (H ∘ cmCurveSerreStructuralH0Map κ ι j) := by
    rw [heq, hc]
    exact exceptionalCoefficients_bijective A hd hA hRat
  exact (H.bijective.of_comp_iff' _).mp hb

/-- Every positive original exceptional ideal power has vanishing coefficient-canonical H1,
using the supplied projective embedding and its original O(1) comparison. -/
theorem exceptionalCoefficientPositivePower_h1_subsingleton
    (A : Type u) [CommRing A] [IsLocalRing A] [IsDomain A]
    [IsNoetherianRing A] [IsIntegrallyClosed A]
    (hd : ringKrullDim A = 2) (hA : IsNagataRing.{u, 0} A)
    (hRat : NormalModificationH1Vanishing A) (ι : Type u)
    (j : exceptionalCurve A hd ⟶ ProjectiveSpace (A ⧸ IsLocalRing.maximalIdeal A) ι)
    [IsClosedImmersion j] (m : ℕ) (em : ι ≃ Fin (m + 1)) (hm : 1 ≤ m)
    (hj : j ≫ toSpec (A ⧸ IsLocalRing.maximalIdeal A) ι = exceptionalStructureMap A hd)
    (e : (Modules.pullback j).obj
      (twistingSheaf (A ⧸ IsLocalRing.maximalIdeal A) ι 1) ≅ (exceptionalLine A hd).val)
    (V : ModuleCat.{u} (A ⧸ IsLocalRing.maximalIdeal A))
    [Module.Finite (A ⧸ IsLocalRing.maximalIdeal A) V]
    (hV : Module.finrank (A ⧸ IsLocalRing.maximalIdeal A) V = 1)
    (q : ℕ) (hq : q ≠ 0) :
    Subsingleton (cmCurveSerreCohomology (A ⧸ IsLocalRing.maximalIdeal A) ι j
      (exceptionalPower A hd q ⊗
        cmCurveCoefficientCanonicalModule (A ⧸ IsLocalRing.maximalIdeal A) ι j m V) 1) := by
  let E := exceptionalCurve A hd
  let κ := A ⧸ IsLocalRing.maximalIdeal A
  let L : LineBundle E := ⟨exceptionalPower A hd q,
    pullback_locallyRankOne _ _ (ordinaryIdealPower_locallyRankOne A hd q)⟩
  let : Epi (Modules.globalSectionsEval L.val) :=
    epi_globalSectionsEval_of_generatingSections
      (exceptionalPositivePowerGeneratingSections A hd ι j e q)
  exact cmCurveCoefficientTwist_h1_subsingleton_of_generated_nontrivial κ ι j m em V hV
    (exceptionalCurve_closedPoint_cmParameter A hd hA hRat) hm
    (exceptionalStructuralH0_bijective A hd hA hRat ι j hj) L
    (exceptionalPower_not_trivial A hd hA hRat q hq)

end AlgebraicGeometry.Scheme.RationalSingularities.MaximalIdealBlowup
