module

public import Aglib.AlgebraicGeometry.Cohomology.GrothendieckExistence.AffineQuotientTransport
public import Aglib.AlgebraicGeometry.Modules.QuasiCoherent.Affine.FiniteTypeComparison
public import Aglib.AlgebraicGeometry.Modules.Coherent.AdicSystem.QuotientCongr

/-! # Original affine coordinates for arbitrary ideal-sheaf quotients -/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry.Scheme.Modules.Coherent

universe u
variable (B : CommRingCat.{u})

/-- The original ideal on an affine scheme in its specified coordinate ring. -/
def affineIdeal (K : (Spec B).IdealSheafData) : Ideal B :=
  (K.ideal ⟨⊤, isAffineOpen_top _⟩).map (Scheme.ΓSpecIso B).hom.hom

@[simp]
theorem affineIdeal_pow (K : (Spec B).IdealSheafData) (n : ℕ) :
    affineIdeal B (K ^ n) = affineIdeal B K ^ n := by
  simp [affineIdeal, Ideal.map_pow]

/-- Arbitrary affine ideal sheaves are generated by their own chart ideal.
No descent from a different external base ring is asserted. -/
@[simp]
theorem idealThickeningIdealSheaf_affineIdeal (K : (Spec B).IdealSheafData) :
    idealThickeningIdealSheaf (𝟙 (Spec B)) (affineIdeal B K) = K := by
  apply IdealSheafData.ext_of_isAffine
  simp [idealThickeningIdealSheaf_ideal, affineIdeal, idealThickeningBaseScalar,
    Ideal.map_map, ← CommRingCat.hom_comp]

/-- Spec global sections of the native quotient by a ring-generated ideal. -/
def generatedSpecQuotientEquiv (J : Ideal B) (M : (Spec B).Modules)
    [M.IsQuasicoherent] (n : ℕ) :
    (moduleSpecΓFunctor.obj M ⧸
      (J ^ n • (⊤ : Submodule B (moduleSpecΓFunctor.obj M)))) ≃ₗ[B]
      moduleSpecΓFunctor.obj
        ((idealSheafQuotientFunctor (Spec B) (idealThickeningIdealSheaf (𝟙 _) J ^ n)).obj M) := by
  let e := (identityBaseSpecSectionsIso B M).toLinearEquiv
  let q := generatedIdealQuotientModuleSectionsEquiv (𝟙 (Spec B)) J M
    ⟨⊤, isAffineOpen_top _⟩ n
  let d := (identityBaseSpecSectionsIso B
    ((idealSheafQuotientFunctor (Spec B)
      (idealThickeningIdealSheaf (𝟙 _) J ^ n)).obj M)).toLinearEquiv
  exact ((idealQuotientCoordinates (J ^ n) e.symm).trans q).trans d

theorem generatedSpecQuotientEquiv_mk (J : Ideal B) (M : (Spec B).Modules)
    [M.IsQuasicoherent] (n : ℕ) (x : moduleSpecΓFunctor.obj M) :
    generatedSpecQuotientEquiv B J M n (Submodule.Quotient.mk x) =
      moduleSpecΓFunctor.map
        ((idealSheafQuotientUnit (Spec B) (idealThickeningIdealSheaf (𝟙 _) J ^ n)).app M) x := by
  have hu := generatedIdealQuotientModuleSectionsEquiv_mk (𝟙 (Spec B)) J M
    ⟨⊤, isAffineOpen_top _⟩ n ((identityBaseSpecSectionsIso B M).inv x)
  exact congrArg (fun z => (identityBaseSpecSectionsIso B
    ((idealSheafQuotientFunctor (Spec B)
      (idealThickeningIdealSheaf (𝟙 _) J ^ n)).obj M)).hom z) hu

/-- Whole arbitrary-ideal coordinate comparison retaining the original unit. -/
def affineQuotientComparison (K : (Spec B).IdealSheafData) (M : (Spec B).Modules)
    [M.IsQuasicoherent] (n : ℕ) :
    {d : (moduleSpecΓFunctor.obj M ⧸
        (affineIdeal B K ^ n • (⊤ : Submodule B (moduleSpecΓFunctor.obj M)))) ≃ₗ[B]
      moduleSpecΓFunctor.obj ((idealSheafQuotientFunctor (Spec B) (K ^ n)).obj M) //
      ∀ x, d (Submodule.Quotient.mk x) =
        moduleSpecΓFunctor.map ((idealSheafQuotientUnit (Spec B) (K ^ n)).app M) x} :=
  quotientCoordinatesTransport moduleSpecΓFunctor
    (fun T => (idealSheafQuotientFunctor (Spec B) T).obj M)
    (fun T => (idealSheafQuotientUnit (Spec B) T).app M) (affineIdeal B K ^ n)
    (generatedSpecQuotientEquiv B (affineIdeal B K) M n)
    (generatedSpecQuotientEquiv_mk B (affineIdeal B K) M n)
    (congrArg (fun L => L ^ n) (idealThickeningIdealSheaf_affineIdeal B K))

/-- Quotient coordinates for the original arbitrary ideal sheaf. -/
def affineQuotientEquiv (K : (Spec B).IdealSheafData) (M : (Spec B).Modules)
    [M.IsQuasicoherent] (n : ℕ) :
    (moduleSpecΓFunctor.obj M ⧸
      (affineIdeal B K ^ n • (⊤ : Submodule B (moduleSpecΓFunctor.obj M)))) ≃ₗ[B]
        moduleSpecΓFunctor.obj ((idealSheafQuotientFunctor (Spec B) (K ^ n)).obj M) :=
  (affineQuotientComparison B K M n).val

/-- The original unit equation is part of the same coordinate construction. -/
theorem affineQuotientEquiv_mk (K : (Spec B).IdealSheafData)
    (M : (Spec B).Modules) [M.IsQuasicoherent] (n : ℕ)
    (x : moduleSpecΓFunctor.obj M) :
    affineQuotientEquiv B K M n (Submodule.Quotient.mk x) =
      moduleSpecΓFunctor.map ((idealSheafQuotientUnit (Spec B) (K ^ n)).app M) x :=
  (affineQuotientComparison B K M n).property x

end AlgebraicGeometry.Scheme.Modules.Coherent
