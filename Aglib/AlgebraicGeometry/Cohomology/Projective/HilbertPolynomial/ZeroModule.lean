module

public import Aglib.AlgebraicGeometry.Cohomology.Projective.HilbertPolynomial.Basic
public import Aglib.AlgebraicGeometry.Cohomology.Projective.Regularity.GlobalGeneration
public import Aglib.AlgebraicGeometry.Cohomology.Projective.Regularity.Monotone
public import Aglib.AlgebraicGeometry.ProjectiveSpace.Tensor.Equivalence

/-!
# Only the zero module has zero Hilbert polynomial

Let `k` be a field, `ι ≃ Fin (n + 1)` and `F` a coherent (`affineLocallyFiniteType`) module on
`P^n_k = ProjectiveSpace k ι`. Then the Hilbert polynomial of `F` vanishes exactly when `F` is zero
(`Scheme.Cohomology.projectiveHilbertPolynomial_eq_zero_iff`).

The converse direction is `χ(O(m) ⊗ 0) = 0`. For the direct one, `F` is `m`-regular for some `m`
(`exists_isProjectiveRegular`), so `H^q(O(m) ⊗ F) = 0` for `q ≥ 1` (the vanishing half of
Nitsure, *Construction of Hilbert and Quot schemes*, arXiv:math/0504590v1, Lemma 2.1 (c), p. 10)
and `h^0(O(m) ⊗ F) = χ(O(m) ⊗ F) = P_F(m) = 0` (`projectiveHilbertFunction_eq_eval`; compare
Stacks, Tag 08AE: `P_F(d) = h^0(F(d))` for `d ≫ 0`). By the generation half of Lemma 2.1 (c)
(`IsProjectiveRegular.epi_globalSectionsEval`), `O(m) ⊗ F` is generated by its global sections,
which are all zero, so `O(m) ⊗ F = 0`; tensoring by `O(-m)` (`twistingTensorEquivalence`) gives
`F = 0`. Stacks has no direct statement of the equivalence; it is assembled here from the
regularity and Hilbert-polynomial interfaces. Stacks, Tag 0BEN (Lemma 33.45.2, the leading term of
`χ(F ⊗ L^n)`) and Tag 0BEV (Lemma 33.45.9, positivity of intersection numbers with ample invertible
sheaves) give an indirect route to `P_F ≠ 0` for `F ≠ 0`.

Present consumer: `HilbertScheme/Nonempty` (a nonempty closed subscheme of `P^n_k` has nonzero
Hilbert polynomial), used by the surjectivity of `p : D ⟶ H` in Nitsure, proof of Thm 6.8, p. 33.
-/

@[expose] public section

noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory
open AlgebraicGeometry.ProjectiveSpace
open AlgebraicGeometry.Scheme.Modules
open AlgebraicGeometry.Scheme.Modules.QuasiCoherent
open scoped Polynomial

universe u

namespace AlgebraicGeometry.Scheme.Cohomology

variable (k : Type u) [Field k] (ι : Type u)

/-- **The zero module has zero Hilbert polynomial.** -/
theorem projectiveHilbertPolynomial_eq_zero_of_isZero {F : (ProjectiveSpace k ι).Modules}
    (hF : IsZero F) : projectiveHilbertPolynomial k ι F = 0 :=
  projectiveHilbertPolynomial_eq_of_eval k ι F fun m => by
    rw [Polynomial.eval_zero, Int.cast_eq_zero]
    exact projectiveEulerChar_of_isZero k ι
      ((moduleTensorLeftFunctor (ProjectiveSpace k ι) (twistingSheaf k ι m)).map_isZero hF)

-- Global sections are morphisms out of `𝟙_` in `globalSectionsEval` and out of
-- `SheafOfModules.unit` in `unitHom_eq_zero_of_subsingleton`; they agree after unfolding.
set_option backward.isDefEq.respectTransparency false in
/-- **A coherent module with zero Hilbert polynomial is zero.** If `F` is `m`-regular, the twist
`O(m) ⊗ F` has no higher cohomology, so `h^0(O(m) ⊗ F) = P_F(m) = 0`; being globally generated,
`O(m) ⊗ F` is zero, and so is `F`. -/
theorem isZero_of_projectiveHilbertPolynomial_eq_zero (n : ℕ) (e : ι ≃ Fin (n + 1))
    {F : (ProjectiveSpace k ι).Modules} (hF : affineLocallyFiniteType (ProjectiveSpace k ι) F)
    (h : projectiveHilbertPolynomial k ι F = 0) : IsZero F := by
  have : Finite ι := Finite.of_equiv _ e.symm
  obtain ⟨m, hm⟩ := exists_isProjectiveRegular k ι n e F hF
  have hM : affineLocallyFiniteType (ProjectiveSpace k ι)
      ((moduleTensorLeftFunctor (ProjectiveSpace k ι) (twistingSheaf k ι m)).obj F) :=
    twistingTensor_affineLocallyFiniteType k ι m F hF
  have : ((moduleTensorLeftFunctor (ProjectiveSpace k ι) (twistingSheaf k ι m)).obj
      F).IsQuasicoherent := quasicoherent_of_affineCharts _ (fun R j _ => (hM R j).1)
  -- `χ(O(m) ⊗ F) = h^0(O(m) ⊗ F)`, the higher cohomology vanishing by regularity.
  have hχ : projectiveHilbertFunction k ι F m = projectiveCohomologyDim k ι
      ((moduleTensorLeftFunctor (ProjectiveSpace k ι) (twistingSheaf k ι m)).obj F) 0 := by
    unfold projectiveHilbertFunction
    rw [projectiveEulerChar_eq_sum_range k ι n e, Finset.sum_range_succ']
    have hpos (q : ℕ) : projectiveCohomologyDim k ι
        ((moduleTensorLeftFunctor (ProjectiveSpace k ι) (twistingSheaf k ι m)).obj F) (q + 1) =
          0 :=
      projectiveCohomologyDim_eq_zero_of_subsingleton
        (IsProjectiveRegular.cohomology_subsingleton_of_le_of_coherent k ι n e hF hm le_rfl
          (Nat.succ_pos q))
    simp only [hpos, Nat.cast_zero, mul_zero, Finset.sum_const_zero, zero_add, pow_zero,
      one_mul]
  have hP := projectiveHilbertFunction_eq_eval k ι n e F hF m
  rw [h, Polynomial.eval_zero, hχ] at hP
  have h0 : projectiveCohomologyDim k ι
      ((moduleTensorLeftFunctor (ProjectiveSpace k ι) (twistingSheaf k ι m)).obj F) 0 = 0 := by
    exact_mod_cast hP
  have hsub := subsingleton_of_projectiveCohomologyDim_eq_zero n e hM h0
  -- `O(m) ⊗ F` is generated by its global sections, which all vanish.
  have hev := IsProjectiveRegular.epi_globalSectionsEval k ι n e hF hm le_rfl
  have hzero : globalSectionsEval
      ((moduleTensorLeftFunctor (ProjectiveSpace k ι) (twistingSheaf k ι m)).obj F) = 0 := by
    refine Sigma.hom_ext _ _ fun s => ?_
    rw [ι_globalSectionsEval, comp_zero]
    exact unitHom_eq_zero_of_subsingleton hsub s
  rw [hzero] at hev
  have hMz := IsZero.of_epi_zero (∐ fun _ : (𝟙_ (ProjectiveSpace k ι).Modules ⟶
      (moduleTensorLeftFunctor (ProjectiveSpace k ι) (twistingSheaf k ι m)).obj F) =>
        𝟙_ (ProjectiveSpace k ι).Modules)
    ((moduleTensorLeftFunctor (ProjectiveSpace k ι) (twistingSheaf k ι m)).obj F)
  -- Tensoring by `O(-m)` recovers `F`.
  exact ((moduleTensorLeftFunctor (ProjectiveSpace k ι) (twistingSheaf k ι (-m))).map_isZero
    hMz).of_iso ((twistingTensorEquivalence k ι m).unitIso.app F)

/-- **The Hilbert polynomial of a coherent module on `P^n_k` vanishes exactly when the module is
zero.** -/
theorem projectiveHilbertPolynomial_eq_zero_iff (n : ℕ) (e : ι ≃ Fin (n + 1))
    {F : (ProjectiveSpace k ι).Modules} (hF : affineLocallyFiniteType (ProjectiveSpace k ι) F) :
    projectiveHilbertPolynomial k ι F = 0 ↔ IsZero F :=
  ⟨isZero_of_projectiveHilbertPolynomial_eq_zero k ι n e hF,
    projectiveHilbertPolynomial_eq_zero_of_isZero k ι⟩

end AlgebraicGeometry.Scheme.Cohomology
