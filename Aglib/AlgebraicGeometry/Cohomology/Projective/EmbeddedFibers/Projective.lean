/-!
# Fibres of a projective embedding computed on projective space over the residue field

Let `i : X ⟶ P^N_A = ProjectiveSpace A ι` be a closed immersion, `f = i ≫ toSpec A ι`, and
`k : Spec K ⟶ Spec A` a field point, with ring map `σ = fieldPointRingHom k : A →+* K`. The fibre
`X_K = X ×_{Spec A} Spec K` embeds in `P^N_K` by `embeddedFiberι i k`, the base change of `i`
along `ProjectiveSpace.map σ ι : P^N_K ⟶ P^N_A` (`isPullback_embeddedFiberι`); it is a closed
immersion. The twist `O_{X_K}(n)` is the pullback of `O(n)` on `P^N_K`
(`embeddedFiberTwistingIso`, from `twistingPullbackIso`). For a coherent `M` on `X_K`:

* **Bridge** (`embeddedFiberTwistDim_eq_projectiveCohomologyDim`):
  `h^q(X_K, O(n) ⊗ M) = h^q(P^N_K, O(n) ⊗ ι_* M)`, through the cohomology equivalence of a
  projective embedding (`projectiveEmbeddingCohomologyLinearEquiv`) and the projection formula
  of a closed immersion (`closedImmersionProjectionFormulaIso`). Consequently
  `χ(X_K, O(n) ⊗ M)` is the Hilbert function of `ι_* M` on `P^N_K`
  (`embeddedFiberTwistEulerChar_eq_projectiveHilbertFunction`), a polynomial in `n`
  (`exists_embeddedFiberTwistEulerChar_eq_eval`; Stacks, Tag 08AC).
* **Finitely many vanishing conditions** (`embeddedFiberTwistDim_vanishing_iff`): with
  `ι ≃ Fin (N + 1)`, `h^q(X_K, O(n) ⊗ M) = 0` for all `q ≥ 1` and `n ≥ m` if and only if it holds
  for `1 ≤ q ≤ N` and `m ≤ n < m + N`. The second condition makes `ι_* M` `(m + N)`-regular, and
  regularity passes to larger twists (Nitsure, *Construction of Hilbert and Quot schemes*,
  arXiv:math/0504590v1, Lemma 2.1 (b), p. 10; Stacks, Tag 08A6).
* **Serre vanishing** (`exists_embeddedFiberTwistDim_eq_zero`): `h^q(X_K, O(n) ⊗ M) = 0` for
  `q ≥ 1` and `n ≫ 0`.
* **Sections of large twists** (`exists_embeddedFiberTwistDim_zero_ne_zero`): if `M` is not zero,
  then `h^0(X_K, O(n) ⊗ M) ≠ 0` for `n ≫ 0`, since `O(n) ⊗ ι_* M` is generated by its global
  sections for `n` at least a regularity bound (Nitsure, Lemma 2.1 (c), p. 10; Stacks,
  Tag 08A8).

These are the inputs on the fibres `X_t` of Kleiman, *The Picard scheme*,
arXiv:math/0504020v1, proof of Thm 4.8, pp. 28–29: the Hilbert polynomial of (4.8.1), the
reduction of (4.8.3) to finitely many `(i, n)` (Kleiman uses Serre's theorem there), and the
vanishing and nonvanishing for `m ≫ 0` that make the strata cover.
-/

@[expose] public section

noncomputable section

set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open AlgebraicGeometry.Scheme.Modules AlgebraicGeometry.Scheme.Modules.QuasiCoherent
open AlgebraicGeometry.ProjectiveSpace

namespace AlgebraicGeometry.Scheme.Cohomology

/-- A locally rank-one module is affine-locally of finite type. -/
theorem affineLocallyFiniteType_of_isLocallyRankOne {Y : Scheme.{u}} {M : Y.Modules}
    (h : Invertible.IsLocallyRankOne Y M) : affineLocallyFiniteType Y M := by
  have : M.IsFinitePresentation := Invertible.lineBundle_isFinitePresentation Y ⟨M, h⟩
  exact affineLocallyFiniteType_of_finitePresentation M

/-- A twist of a locally rank-one module is locally rank one. -/
theorem isLocallyRankOne_pulledTwist {A : Type u} [CommRing A] {ι : Type u} {Y : Scheme.{u}}
    (h : Y ⟶ ProjectiveSpace A ι) (n : ℤ) {M : Y.Modules}
    (hM : Invertible.IsLocallyRankOne Y M) : Invertible.IsLocallyRankOne Y (pulledTwist h n M) :=
  Invertible.tensorSheaf_locallyRankOne Y _ _ (isLocallyRankOne_pulledTwistingSheaf h n) hM

/-- With vanishing higher cohomology, `h^0(X_K, O(n) ⊗ M) = χ(X_K, O(n) ⊗ M)`. -/
theorem embeddedFiberTwistDim_zero_eq_eulerChar {A : Type u} [CommRing A] {ι : Type u}
    {X : Scheme.{u}} (i : X ⟶ ProjectiveSpace A ι) {K : Type u} [Field K]
    (k : Spec (.of K) ⟶ Spec (.of A)) (M : (pullback (i ≫ toSpec A ι) k).Modules) (n : ℤ)
    (h : ∀ q : ℕ, 0 < q → embeddedFiberTwistDim i k M n q = 0) :
    (embeddedFiberTwistDim i k M n 0 : ℤ) = embeddedFiberTwistEulerChar i k M n := by
  rw [embeddedFiberTwistEulerChar_eq, finsum_eq_single _ 0]
  · simp
  · intro q hq
    simp [h q (Nat.pos_of_ne_zero hq)]

section Embedding

variable {A : Type u} [CommRing A] {ι : Type u} {X : Scheme.{u}} (i : X ⟶ ProjectiveSpace A ι)
  {K : Type u} [Field K] (k : Spec (.of K) ⟶ Spec (.of A))

/-- The ring map `A →+* K` of a field point `k : Spec K ⟶ Spec A`. -/
abbrev fieldPointRingHom : A →+* K :=
  (Spec.preimage k).hom

theorem specMap_fieldPointRingHom :
    Spec.map (CommRingCat.ofHom (fieldPointRingHom k)) = k := by
  simp [fieldPointRingHom]

/-- Projective space over `K` is the base change of projective space over `A` along `k`. -/
theorem isPullback_map_fieldPointRingHom :
    IsPullback (ProjectiveSpace.map (fieldPointRingHom k) ι) (toSpec K ι) (toSpec A ι) k := by
  simpa only [specMap_fieldPointRingHom] using isPullback_map (fieldPointRingHom k) ι

/-- The embedding `X_K ⟶ P^N_K` of the fibre `X_K = X ×_{Spec A} Spec K`, the base change of
`i`. -/
def embeddedFiberι : pullback (i ≫ toSpec A ι) k ⟶ ProjectiveSpace K ι :=
  (isPullback_map_fieldPointRingHom k).lift (pullback.fst (i ≫ toSpec A ι) k ≫ i)
    (pullback.snd (i ≫ toSpec A ι) k)
    (by rw [Category.assoc, (IsPullback.of_hasPullback (i ≫ toSpec A ι) k).w])

@[reassoc (attr := simp)]
theorem embeddedFiberι_map :
    embeddedFiberι i k ≫ ProjectiveSpace.map (fieldPointRingHom k) ι =
      pullback.fst (i ≫ toSpec A ι) k ≫ i :=
  IsPullback.lift_fst _ _ _ _

@[reassoc (attr := simp)]
theorem embeddedFiberι_toSpec :
    embeddedFiberι i k ≫ toSpec K ι = pullback.snd (i ≫ toSpec A ι) k :=
  IsPullback.lift_snd _ _ _ _

/-- The fibre `X_K` is the base change of `X ⟶ P^N_A` along `P^N_K ⟶ P^N_A`. -/
theorem isPullback_embeddedFiberι :
    IsPullback (pullback.fst (i ≫ toSpec A ι) k) (embeddedFiberι i k) i
      (ProjectiveSpace.map (fieldPointRingHom k) ι) :=
  IsPullback.of_bot' (IsPullback.of_hasPullback (i ≫ toSpec A ι) k)
    (isPullback_map_fieldPointRingHom k)

instance [IsClosedImmersion i] : IsClosedImmersion (embeddedFiberι i k) :=
  MorphismProperty.of_isPullback (isPullback_embeddedFiberι i k) inferInstance

/-- `O_{X_K}(n)`, the pullback of `O(n)` along `X_K ⟶ X ⟶ P^N_A`, is the pullback of `O(n)` on
`P^N_K` along the fibre embedding. -/
def embeddedFiberTwistingIso (n : ℤ) :
    pulledTwistingSheaf (pullback.fst (i ≫ toSpec A ι) k ≫ i) n ≅
      (Scheme.Modules.pullback (embeddedFiberι i k)).obj (twistingSheaf K ι n) :=
  (Scheme.Modules.pullbackCongr (embeddedFiberι_map i k).symm).app _ ≪≫
    ((Scheme.Modules.pullbackComp _ _).app _).symm ≪≫
    (Scheme.Modules.pullback (embeddedFiberι i k)).mapIso
      (twistingPullbackIso (fieldPointRingHom k) ι n)

/-- A dimension over `K` for a structural ring map equal to that of `b`. -/
theorem moduleCohomologyDimension_eq_finrank {Y : Scheme.{u}} (b : Y ⟶ Spec (.of K))
    {α : K →+* Γ(Y, ⊤)} (h : b.appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom = α)
    (M : Y.Modules) (q : ℕ) :
    moduleCohomologyDimension b M q =
      @Module.finrank K (Sheaf.H.{u + 1} (moduleAddSheaf Y M) q) _ _
        (moduleCohomologyModuleOfHom Y α M q) := by
  subst h
  rfl

/-- **The bridge to projective space over the residue field.** For a closed immersion
`i : X ⟶ P^N_A` and a coherent `M` on `X_K`, `h^q(X_K, O(n) ⊗ M)` is the dimension of
`H^q(P^N_K, O(n) ⊗ ι_* M)` for the fibre embedding `ι : X_K ⟶ P^N_K`. -/
theorem embeddedFiberTwistDim_eq_projectiveCohomologyDim [IsClosedImmersion i]
    (M : (pullback (i ≫ toSpec A ι) k).Modules)
    (hM : affineLocallyFiniteType (pullback (i ≫ toSpec A ι) k) M) (n : ℤ) (q : ℕ) :
    embeddedFiberTwistDim i k M n q =
      projectiveCohomologyDim K ι ((moduleTensorLeftFunctor (ProjectiveSpace K ι)
        (twistingSheaf K ι n)).obj
          ((Scheme.Modules.pushforward (embeddedFiberι i k)).obj M)) q := by
  let j := embeddedFiberι i k
  let E := (Scheme.Modules.pullback j).obj (twistingSheaf K ι n)
  let N := (moduleTensorLeftFunctor (pullback (i ≫ toSpec A ι) k) E).obj M
  have hE : affineLocallyFiniteType _ E := affineLocallyFiniteType_of_isLocallyRankOne
    (Invertible.pullback_locallyRankOne j _ (isLocallyRankOne_twistingSheaf K ι n))
  have hN : affineLocallyFiniteType _ N := affineLocallyFiniteType_tensor _ _ hE hM
  have : N.IsQuasicoherent := quasicoherent_of_affineCharts _ (fun B a _ => (hN B a).1)
  have hP := Coherent.Pushforward.ClosedImmersion.affineLocallyFiniteType_pushforward j hN
  have : ((Scheme.Modules.pushforward j).obj N).IsQuasicoherent :=
    quasicoherent_of_affineCharts _ (fun B a _ => (hP B a).1)
  have h1 : embeddedFiberTwistDim i k M n q =
      moduleCohomologyDimension (pullback.snd (i ≫ toSpec A ι) k) N q :=
    moduleCohomologyDimension_congr _
      ((moduleTensorRightFunctor _ M).mapIso (embeddedFiberTwistingIso i k n)) q
  have h2 : moduleCohomologyDimension (pullback.snd (i ≫ toSpec A ι) k) N q =
      projectiveCohomologyDim K ι ((Scheme.Modules.pushforward j).obj N) q := by
    have hα : (pullback.snd (i ≫ toSpec A ι) k).appTop.hom.comp
          (Scheme.ΓSpecIso (.of K)).inv.hom =
        j.appTop.hom.comp ((toSpec K ι).appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom) := by
      rw [← embeddedFiberι_toSpec i k]
      exact projectiveEmbedding_structuralScalars K ι (embeddedFiberι i k)
    rw [moduleCohomologyDimension_eq_finrank _ hα]
    unfold projectiveCohomologyDim
    let := moduleCohomologyModuleOfHom (ProjectiveSpace K ι) (projectiveConstants K ι)
      ((Scheme.Modules.pushforward j).obj N) q
    let := moduleCohomologyModuleOfHom (pullback (i ≫ toSpec A ι) k)
      (j.appTop.hom.comp (projectiveConstants K ι)) N q
    exact (projectiveEmbeddingCohomologyLinearEquiv K ι j N q).finrank_eq.symm
  rw [h1, h2]
  exact (projectiveCohomologyDim_congr K ι (closedImmersionProjectionFormulaIso j _ M) q).symm

/-- The pushforward of a coherent module along the fibre embedding is coherent. -/
theorem affineLocallyFiniteType_pushforward_embeddedFiberι [IsClosedImmersion i]
    {M : (pullback (i ≫ toSpec A ι) k).Modules}
    (hM : affineLocallyFiniteType (pullback (i ≫ toSpec A ι) k) M) :
    affineLocallyFiniteType (ProjectiveSpace K ι)
      ((Scheme.Modules.pushforward (embeddedFiberι i k)).obj M) :=
  Coherent.Pushforward.ClosedImmersion.affineLocallyFiniteType_pushforward _ hM

/-- **The fibre Euler characteristic is a Hilbert function**: `χ(X_K, O(n) ⊗ M)` is the Hilbert
function of `ι_* M` on `P^N_K`. -/
theorem embeddedFiberTwistEulerChar_eq_projectiveHilbertFunction [IsClosedImmersion i]
    (M : (pullback (i ≫ toSpec A ι) k).Modules)
    (hM : affineLocallyFiniteType (pullback (i ≫ toSpec A ι) k) M) (n : ℤ) :
    embeddedFiberTwistEulerChar i k M n =
      projectiveHilbertFunction K ι
        ((Scheme.Modules.pushforward (embeddedFiberι i k)).obj M) n := by
  rw [embeddedFiberTwistEulerChar_eq]
  unfold projectiveHilbertFunction projectiveEulerChar
  congr 1
  funext q
  rw [embeddedFiberTwistDim_eq_projectiveCohomologyDim i k M hM n q]

/-- **The fibre Euler characteristic is polynomial in the twist** (Stacks, Tag 08AC): for a
coherent `M` on `X_K` there is `φ ∈ ℚ[X]` with `χ(X_K, O(n) ⊗ M) = φ(n)` for every `n : ℤ`. -/
theorem exists_embeddedFiberTwistEulerChar_eq_eval [IsClosedImmersion i] (N : ℕ)
    (e : ι ≃ Fin (N + 1)) (M : (pullback (i ≫ toSpec A ι) k).Modules)
    (hM : affineLocallyFiniteType (pullback (i ≫ toSpec A ι) k) M) :
    ∃ φ : Polynomial ℚ, ∀ n : ℤ, (embeddedFiberTwistEulerChar i k M n : ℚ) = φ.eval (n : ℚ) := by
  refine ⟨projectiveHilbertPolynomial K ι
    ((Scheme.Modules.pushforward (embeddedFiberι i k)).obj M), fun n => ?_⟩
  rw [embeddedFiberTwistEulerChar_eq_projectiveHilbertFunction i k M hM n]
  exact projectiveHilbertFunction_eq_eval K ι N e _
    (affineLocallyFiniteType_pushforward_embeddedFiberι i k hM) n

/-- The twisted module `O(n) ⊗ ι_* M` on `P^N_K` is coherent. -/
theorem affineLocallyFiniteType_twist_pushforward_embeddedFiberι [IsClosedImmersion i]
    [Finite ι] {M : (pullback (i ≫ toSpec A ι) k).Modules}
    (hM : affineLocallyFiniteType (pullback (i ≫ toSpec A ι) k) M) (n : ℤ) :
    affineLocallyFiniteType (ProjectiveSpace K ι)
      ((moduleTensorLeftFunctor (ProjectiveSpace K ι) (twistingSheaf K ι n)).obj
        ((Scheme.Modules.pushforward (embeddedFiberι i k)).obj M)) :=
  twistingTensor_affineLocallyFiniteType K ι n _
    (affineLocallyFiniteType_pushforward_embeddedFiberι i k hM)

/-- On the fibre, `h^q(X_K, O(n) ⊗ M) = 0` exactly when the cohomology vanishes, since it is
finite-dimensional for coherent coefficients (`moduleCohomology_finite_of_projectiveEmbedding`).
Stated at a variable field, so that residue fields enter only by instantiation. -/
theorem embeddedFiberTwistDim_eq_zero_iff [IsClosedImmersion i] (N : ℕ) (e : ι ≃ Fin (N + 1))
    (M : (pullback (i ≫ toSpec A ι) k).Modules) (n : ℤ)
    (hM : affineLocallyFiniteType (pullback (i ≫ toSpec A ι) k)
      (pulledTwist (pullback.fst (i ≫ toSpec A ι) k ≫ i) n M)) (q : ℕ) :
    embeddedFiberTwistDim i k M n q = 0 ↔
      Subsingleton (Sheaf.H.{u + 1} (moduleAddSheaf _
        (pulledTwist (pullback.fst (i ≫ toSpec A ι) k ≫ i) n M)) q) := by
  let α := (pullback.snd (i ≫ toSpec A ι) k).appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom
  let := moduleCohomologyModuleOfHom _ α (pulledTwist (pullback.fst (i ≫ toSpec A ι) k ≫ i) n M) q
  have : Module.Finite K (Sheaf.H.{u + 1} (moduleAddSheaf _
      (pulledTwist (pullback.fst (i ≫ toSpec A ι) k ≫ i) n M)) q) :=
    moduleCohomology_finite_of_projectiveEmbedding K ι (embeddedFiberι i k) N e _
      (embeddedFiberι_toSpec i k) _ hM q
  exact Module.finrank_eq_zero_iff_of_free K _

/-- **Finitely many vanishing conditions** by Castelnuovo–Mumford regularity (Nitsure,
arXiv:math/0504590v1, Lemma 2.1 (b), p. 10): for `ι ≃ Fin (N + 1)` and coherent `M` on `X_K`,
the vanishing of `h^q(X_K, O(n) ⊗ M)` for all `q ≥ 1` and `n ≥ m` is equivalent to its vanishing
for `1 ≤ q ≤ N` and `m ≤ n < m + N`. -/
theorem embeddedFiberTwistDim_vanishing_iff [IsClosedImmersion i] (N : ℕ) (e : ι ≃ Fin (N + 1))
    (M : (pullback (i ≫ toSpec A ι) k).Modules)
    (hM : affineLocallyFiniteType (pullback (i ≫ toSpec A ι) k) M) (m : ℤ) :
    (∀ q : ℕ, 0 < q → ∀ n : ℤ, m ≤ n → embeddedFiberTwistDim i k M n q = 0) ↔
      (∀ q : ℕ, 0 < q → q ≤ N → ∀ n : ℤ, m ≤ n → n < m + N →
        embeddedFiberTwistDim i k M n q = 0) := by
  have : Finite ι := Finite.of_equiv _ e.symm
  refine ⟨fun h q hq _ n hn _ => h q hq n hn, fun h q hq n hn => ?_⟩
  let F := (Scheme.Modules.pushforward (embeddedFiberι i k)).obj M
  have hF : affineLocallyFiniteType (ProjectiveSpace K ι) F :=
    affineLocallyFiniteType_pushforward_embeddedFiberι i k hM
  have htw (d : ℤ) := affineLocallyFiniteType_twist_pushforward_embeddedFiberι i k hM d
  have hqc (d : ℤ) : ((moduleTensorLeftFunctor (ProjectiveSpace K ι)
      (twistingSheaf K ι d)).obj F).IsQuasicoherent :=
    quasicoherent_of_affineCharts _ (fun B a _ => (htw d B a).1)
  rw [embeddedFiberTwistDim_eq_projectiveCohomologyDim i k M hM n q]
  by_cases hqN : N < q
  · have := hqc n
    exact projectiveCohomologyDim_eq_zero_of_subsingleton
      (projectiveCohomology_subsingleton_of_gt K ι N e _ q hqN)
  by_cases hnN : n < m + N
  · rw [← embeddedFiberTwistDim_eq_projectiveCohomologyDim i k M hM n q]
    exact h q hq (by omega) n hn hnN
  -- `F` is `(m + N)`-regular.
  have hreg : IsProjectiveRegular K ι F (m + N) := by
    intro p hp
    by_cases hpN : N < p
    · have := hqc (m + N - p)
      exact projectiveCohomology_subsingleton_of_gt K ι N e _ p hpN
    · apply subsingleton_of_projectiveCohomologyDim_eq_zero N e (htw (m + N - p))
      rw [← embeddedFiberTwistDim_eq_projectiveCohomologyDim i k M hM (m + N - p) p]
      exact h p hp (by omega) (m + N - p) (by omega) (by omega)
  exact projectiveCohomologyDim_eq_zero_of_subsingleton
    (IsProjectiveRegular.cohomology_subsingleton_of_le_of_coherent K ι N e hF hreg
      (by omega) hq)

/-- **Serre vanishing on the fibre**: for coherent `M` on `X_K` there is `B` with
`h^q(X_K, O(n) ⊗ M) = 0` for every `n ≥ B` and `q ≥ 1`. -/
theorem exists_embeddedFiberTwistDim_eq_zero [IsClosedImmersion i] (N : ℕ)
    (e : ι ≃ Fin (N + 1)) (M : (pullback (i ≫ toSpec A ι) k).Modules)
    (hM : affineLocallyFiniteType (pullback (i ≫ toSpec A ι) k) M) :
    ∃ B : ℤ, ∀ n : ℤ, B ≤ n → ∀ q : ℕ, 0 < q → embeddedFiberTwistDim i k M n q = 0 := by
  obtain ⟨B, hB⟩ := projectiveSerreVanishing K ι N e _
    (affineLocallyFiniteType_pushforward_embeddedFiberι i k hM)
  refine ⟨B, fun n hn q hq => ?_⟩
  rw [embeddedFiberTwistDim_eq_projectiveCohomologyDim i k M hM n q]
  exact projectiveCohomologyDim_eq_zero_of_subsingleton (hB n hn q (by omega))

/-- Tensoring with a twisting sheaf reflects zero modules. -/
theorem isZero_of_isZero_twistingTensor {R : Type u} [CommRing R] (d : ℤ)
    {F : (ProjectiveSpace R ι).Modules}
    (h : IsZero ((moduleTensorLeftFunctor (ProjectiveSpace R ι) (twistingSheaf R ι d)).obj F)) :
    IsZero F := by
  let L : Invertible.LineBundle (ProjectiveSpace R ι) :=
    ⟨twistingSheaf R ι d, isLocallyRankOne_twistingSheaf R ι d⟩
  let E := Invertible.lineBundleDualTensorEquivalence (ProjectiveSpace R ι) L
  exact IsZero.of_full_of_faithful_of_isZero E.inverse F h

/-- **Sections of large twists**: for a coherent `M` on `X_K` that is not zero, there is `B` with
`h^0(X_K, O(n) ⊗ M) ≠ 0` for every `n ≥ B` (Nitsure, arXiv:math/0504590v1, Lemma 2.1 (c),
p. 10: large twists are generated by global sections). -/
theorem exists_embeddedFiberTwistDim_zero_ne_zero [IsClosedImmersion i] (N : ℕ)
    (e : ι ≃ Fin (N + 1)) (M : (pullback (i ≫ toSpec A ι) k).Modules)
    (hM : affineLocallyFiniteType (pullback (i ≫ toSpec A ι) k) M) (hM0 : ¬ IsZero M) :
    ∃ B : ℤ, ∀ n : ℤ, B ≤ n → embeddedFiberTwistDim i k M n 0 ≠ 0 := by
  have : Finite ι := Finite.of_equiv _ e.symm
  let F := (Scheme.Modules.pushforward (embeddedFiberι i k)).obj M
  have hF : affineLocallyFiniteType (ProjectiveSpace K ι) F :=
    affineLocallyFiniteType_pushforward_embeddedFiberι i k hM
  have hF0 : ¬ IsZero F := by
    intro hz
    have := Coherent.Pushforward.ClosedImmersion.pushforwardFaithful (embeddedFiberι i k)
    exact hM0 ((IsZero.iff_id_eq_zero M).mpr
      ((Scheme.Modules.pushforward (embeddedFiberι i k)).map_injective (hz.eq_of_src _ _)))
  obtain ⟨B, hB⟩ := exists_isProjectiveRegular K ι N e F hF
  refine ⟨B, fun n hn h0 => hF0 ?_⟩
  apply isZero_of_isZero_twistingTensor n
  have hev := IsProjectiveRegular.epi_globalSectionsEval K ι N e hF hB hn
  rw [embeddedFiberTwistDim_eq_projectiveCohomologyDim i k M hM n 0] at h0
  have hsub := subsingleton_of_projectiveCohomologyDim_eq_zero N e
    (affineLocallyFiniteType_twist_pushforward_embeddedFiberι i k hM n) h0
  have hzero : globalSectionsEval ((moduleTensorLeftFunctor (ProjectiveSpace K ι)
      (twistingSheaf K ι n)).obj F) = 0 := by
    apply Sigma.hom_ext
    intro s
    rw [ι_globalSectionsEval, comp_zero]
    exact unitHom_eq_zero_of_subsingleton hsub s
  rw [hzero] at hev
  exact @IsZero.of_epi_zero _ _ _ _ _ hev

end Embedding

end AlgebraicGeometry.Scheme.Cohomology
