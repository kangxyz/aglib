module

public import Aglib.AlgebraicGeometry.Cohomology.Projective.Regularity.Surjectivity
public import Aglib.AlgebraicGeometry.ProjectiveSpace.TwistPresentation.Epimorphism

/-!
# Regular twists are globally generated

If an affine-locally finite-type module `F` on projective `n`-space is `m`-regular, then
`O(r) ⊗ F` is generated by its global sections for every `r ≥ m`. This is the generation half
of Nitsure, arXiv:math/0504590v1, Lemma 2.1 (c), p. 10 (Stacks, Tag 08A8, Lemma 33.35.12,
states it for coherent sheaves over a field); the vanishing half, `H^i(O(r) ⊗ F) = 0` for
`i ≥ 1`, is `IsProjectiveRegular.cohomology_subsingleton_of_le` (`Regularity/Monotone`), and
Lemma 2.1 (c) is the conjunction of the two. The base is an arbitrary commutative ring.

Global sections are written as morphisms `𝟙_ ⟶ M` out of the monoidal unit, and generation means
that the evaluation `globalSectionsEval M : ⨁_{s : 𝟙_ ⟶ M} 𝟙_ ⟶ M`
(`Modules/Generators/GlobalSections`) is an epimorphism; the generating family is packaged as
Mathlib's `SheafOfModules.GeneratingSections`. Finitely many global sections already suffice
(`IsProjectiveRegular.exists_generatingSections_isFiniteType`).

The proof combines Nitsure, Lemma 2.1 (a) (`IsProjectiveRegular.surjective_coordinateMul`) with
the large-twist presentation `exists_uniformNegativeTwistEpimorphism`: `O(N) ⊗ F` is globally
generated for some `N ≥ r`, and global generation descends from `O(1 + c) ⊗ F` to `O(c) ⊗ F` for
`c ≥ m`. Indeed every global section of `O(1 + c) ⊗ F` is `∑ᵢ Xᵢ sᵢ` with global sections `sᵢ` of
`O(c) ⊗ F`, so `O(1) ⊗ ev` is an epimorphism for the evaluation `ev` of `O(c) ⊗ F`, and tensoring
by `O(1)` reflects epimorphisms (`epi_of_twisting_whiskerLeft`). Nitsure and Stacks prove the
step the same way, from a large twist and Lemma 2.1 (a).
-/

@[expose] public section

noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory Opposite
open AlgebraicGeometry.ProjectiveSpace
open AlgebraicGeometry.Scheme.Modules
open AlgebraicGeometry.Scheme.Modules.QuasiCoherent

universe u

namespace AlgebraicGeometry.Scheme.Cohomology

variable (R : Type u) [CommRing R] (ι : Type u)

-- The twist of the negative twist is identified with the unit through `twistingTensorIso`,
-- whose source is spelled with the twist tensor functor.
set_option backward.isDefEq.respectTransparency false in
/-- If `F` is a quotient of a coproduct of copies of `O(-N)`, then `O(N) ⊗ F` is globally
generated. -/
theorem epi_globalSectionsEval_of_negativeTwist (N : ℤ) {I : Type u}
    {M : (ProjectiveSpace R ι).Modules} (π : (∐ fun _ : I => twistingSheaf R ι (-N)) ⟶ M)
    [Epi π] :
    Epi (globalSectionsEval
      ((moduleTensorLeftFunctor (ProjectiveSpace R ι) (twistingSheaf R ι N)).obj M)) := by
  let E := twistingTensorEquivalence R ι N
  let u : E.functor.obj (twistingSheaf R ι (-N)) ≅ 𝟙_ (ProjectiveSpace R ι).Modules :=
    twistingTensorIso R ι N (-N) ≪≫ eqToIso (congrArg (twistingSheaf R ι) (add_neg_cancel N)) ≪≫
      twistingZeroIso R ι
  have hfac : (Sigma.desc fun a : I => u.hom ≫
      Sigma.ι (fun _ : (𝟙_ _ ⟶ E.functor.obj M) => 𝟙_ (ProjectiveSpace R ι).Modules)
        (u.inv ≫ E.functor.map (Sigma.ι (fun _ : I => twistingSheaf R ι (-N)) a ≫ π))) ≫
        globalSectionsEval (E.functor.obj M) = sigmaComparison E.functor _ ≫ E.functor.map π := by
    apply Sigma.hom_ext
    intro a
    rw [Sigma.ι_comp_desc_assoc, Category.assoc, ι_globalSectionsEval, Iso.hom_inv_id_assoc,
      ι_comp_sigmaComparison_assoc, ← E.functor.map_comp]
  have : Epi (sigmaComparison E.functor _ ≫ E.functor.map π) := inferInstance
  exact epi_of_epi_fac hfac

-- The coordinate multiplications are spelled with the twist tensor functor, the monoidal
-- comparison with `⊗`; they agree only after unfolding.
set_option backward.isDefEq.respectTransparency false in
/-- For a quasicoherent `m`-regular module and `c ≥ m`, global generation descends from
`O(1 + c) ⊗ F` to `O(c) ⊗ F`. -/
theorem epi_globalSectionsEval_of_succ (n : ℕ) (e : ι ≃ Fin (n + 1))
    {F : (ProjectiveSpace R ι).Modules} [F.IsQuasicoherent]
    {m c : ℤ} (h : IsProjectiveRegular R ι F m) (hc : m ≤ c)
    (hsucc : Epi (globalSectionsEval ((moduleTensorLeftFunctor (ProjectiveSpace R ι)
      (twistingSheaf R ι (((1 : ℕ) : ℤ) + c))).obj F))) :
    Epi (globalSectionsEval ((moduleTensorLeftFunctor (ProjectiveSpace R ι)
      (twistingSheaf R ι c)).obj F)) := by
  let : Fintype ι := Fintype.ofEquiv _ e.symm
  have hΨ := epi_sigmaDesc_globalSectionsEval_comp (fun i : ι =>
    (twistingTensorMultiply R ι ((1 : ℕ) : ℤ) c (coordinateSection R ι i)).app F)
    (IsProjectiveRegular.surjective_coordinateMul R ι n e h hc)
  have hfac : (Sigma.desc fun i : ι => unitMultiply (coordinateUnitHom R ι i)
      (∐ fun _ : (𝟙_ (ProjectiveSpace R ι).Modules ⟶ (moduleTensorLeftFunctor
        (ProjectiveSpace R ι) (twistingSheaf R ι c)).obj F) =>
          𝟙_ (ProjectiveSpace R ι).Modules)) ≫
      (twistingSheaf R ι ((1 : ℕ) : ℤ) ◁ globalSectionsEval ((moduleTensorLeftFunctor
        (ProjectiveSpace R ι) (twistingSheaf R ι c)).obj F) ≫
        (α_ (twistingSheaf R ι ((1 : ℕ) : ℤ)) (twistingSheaf R ι c) F).inv ≫
          twistingTensorMap R ι ((1 : ℕ) : ℤ) c ▷ F) =
      Sigma.desc fun i : ι => globalSectionsEval ((moduleTensorLeftFunctor (ProjectiveSpace R ι)
        (twistingSheaf R ι c)).obj F) ≫
          (twistingTensorMultiply R ι ((1 : ℕ) : ℤ) c (coordinateSection R ι i)).app F := by
    apply Sigma.hom_ext
    intro i
    rw [Sigma.ι_comp_desc_assoc, Sigma.ι_comp_desc, ← unitMultiply_naturality_assoc,
      twistingTensorMultiply_app_eq_unitMultiply]
    rfl
  have h2 := epi_of_epi_fac hfac
  have : IsIso (twistingTensorMap R ι ((1 : ℕ) : ℤ) c) :=
    (twistingTensorIso R ι ((1 : ℕ) : ℤ) c).isIso_hom
  have h3 : Epi (twistingSheaf R ι ((1 : ℕ) : ℤ) ◁ globalSectionsEval
      ((moduleTensorLeftFunctor (ProjectiveSpace R ι) (twistingSheaf R ι c)).obj F)) := by
    have h4 := epi_comp (twistingSheaf R ι ((1 : ℕ) : ℤ) ◁ globalSectionsEval
      ((moduleTensorLeftFunctor (ProjectiveSpace R ι) (twistingSheaf R ι c)).obj F) ≫
        (α_ (twistingSheaf R ι ((1 : ℕ) : ℤ)) (twistingSheaf R ι c) F).inv ≫
          twistingTensorMap R ι ((1 : ℕ) : ℤ) c ▷ F)
      (inv ((α_ (twistingSheaf R ι ((1 : ℕ) : ℤ)) (twistingSheaf R ι c) F).inv ≫
          twistingTensorMap R ι ((1 : ℕ) : ℤ) c ▷ F))
    simpa only [Category.assoc, IsIso.hom_inv_id, Category.comp_id] using h4
  exact epi_of_twisting_whiskerLeft R ι _ _ h3

-- The coordinate multiplications are spelled with the twist tensor functor, the monoidal
-- comparison with `⊗`; they agree only after unfolding.
set_option backward.isDefEq.respectTransparency false in
/-- A morphism `ev : E ⟶ O(c) ⊗ F` is an epimorphism when the coordinate multiples
`ev ≫ Xᵢ : E ⟶ O(1 + c) ⊗ F` are jointly an epimorphism. -/
theorem epi_of_sigmaDesc_coordinateMul_comp [Finite ι] {F : (ProjectiveSpace R ι).Modules} (c : ℤ)
    {E : (ProjectiveSpace R ι).Modules}
    (ev : E ⟶ (moduleTensorLeftFunctor (ProjectiveSpace R ι) (twistingSheaf R ι c)).obj F)
    (h : Epi (Sigma.desc fun i : ι =>
      ev ≫ (twistingTensorMultiply R ι ((1 : ℕ) : ℤ) c (coordinateSection R ι i)).app F)) :
    Epi ev := by
  have hfac : (Sigma.desc fun i : ι => unitMultiply (coordinateUnitHom R ι i) E) ≫
      (twistingSheaf R ι ((1 : ℕ) : ℤ) ◁ ev ≫
        (α_ (twistingSheaf R ι ((1 : ℕ) : ℤ)) (twistingSheaf R ι c) F).inv ≫
          twistingTensorMap R ι ((1 : ℕ) : ℤ) c ▷ F) =
      Sigma.desc fun i : ι =>
        ev ≫ (twistingTensorMultiply R ι ((1 : ℕ) : ℤ) c (coordinateSection R ι i)).app F := by
    apply Sigma.hom_ext
    intro i
    rw [Sigma.ι_comp_desc_assoc, Sigma.ι_comp_desc, ← unitMultiply_naturality_assoc,
      twistingTensorMultiply_app_eq_unitMultiply]
    rfl
  have h2 := epi_of_epi_fac hfac
  have : IsIso (twistingTensorMap R ι ((1 : ℕ) : ℤ) c) :=
    (twistingTensorIso R ι ((1 : ℕ) : ℤ) c).isIso_hom
  have h3 : Epi (twistingSheaf R ι ((1 : ℕ) : ℤ) ◁ ev) := by
    have h4 := epi_comp (twistingSheaf R ι ((1 : ℕ) : ℤ) ◁ ev ≫
        (α_ (twistingSheaf R ι ((1 : ℕ) : ℤ)) (twistingSheaf R ι c) F).inv ≫
          twistingTensorMap R ι ((1 : ℕ) : ℤ) c ▷ F)
      (inv ((α_ (twistingSheaf R ι ((1 : ℕ) : ℤ)) (twistingSheaf R ι c) F).inv ≫
          twistingTensorMap R ι ((1 : ℕ) : ℤ) c ▷ F))
    simpa only [Category.assoc, IsIso.hom_inv_id, Category.comp_id] using h4
  exact epi_of_twisting_whiskerLeft R ι _ _ h3

-- The twist of the negative twist is identified with the unit through `twistingTensorIso`,
-- whose source is spelled with the twist tensor functor.
set_option backward.isDefEq.respectTransparency false in
/-- If `F` is a quotient of a finite coproduct of copies of `O(-N)`, then `O(N) ⊗ F` is generated
by finitely many global sections. -/
theorem exists_finite_epi_sigmaDesc_of_negativeTwist (N : ℤ) {I : Type u} [Finite I]
    {M : (ProjectiveSpace R ι).Modules} (π : (∐ fun _ : I => twistingSheaf R ι (-N)) ⟶ M)
    [Epi π] :
    ∃ (J : Type u) (_ : Finite J) (s : J → (𝟙_ (ProjectiveSpace R ι).Modules ⟶
      (moduleTensorLeftFunctor (ProjectiveSpace R ι) (twistingSheaf R ι N)).obj M)),
      Epi (Sigma.desc s) := by
  let E := twistingTensorEquivalence R ι N
  let u : E.functor.obj (twistingSheaf R ι (-N)) ≅ 𝟙_ (ProjectiveSpace R ι).Modules :=
    twistingTensorIso R ι N (-N) ≪≫ eqToIso (congrArg (twistingSheaf R ι) (add_neg_cancel N)) ≪≫
      twistingZeroIso R ι
  refine ⟨I, inferInstance, fun a =>
    u.inv ≫ E.functor.map (Sigma.ι (fun _ : I => twistingSheaf R ι (-N)) a ≫ π), ?_⟩
  have hfac : (Sigma.desc fun a : I =>
      u.hom ≫ Sigma.ι (fun _ : I => 𝟙_ (ProjectiveSpace R ι).Modules) a) ≫
      (Sigma.desc fun a : I =>
        u.inv ≫ E.functor.map (Sigma.ι (fun _ : I => twistingSheaf R ι (-N)) a ≫ π)) =
      sigmaComparison E.functor _ ≫ E.functor.map π := by
    apply Sigma.hom_ext
    intro a
    rw [Sigma.ι_comp_desc_assoc, Category.assoc, Sigma.ι_comp_desc, Iso.hom_inv_id_assoc,
      ι_comp_sigmaComparison_assoc, ← E.functor.map_comp]
  have : Epi (sigmaComparison E.functor _ ≫ E.functor.map π) := inferInstance
  exact epi_of_epi_fac hfac

/-- For a quasicoherent `m`-regular module and `c ≥ m`, generation by finitely many global
sections descends from `O(1 + c) ⊗ F` to `O(c) ⊗ F`. -/
theorem exists_finite_epi_sigmaDesc_of_succ (n : ℕ) (e : ι ≃ Fin (n + 1))
    {F : (ProjectiveSpace R ι).Modules} [F.IsQuasicoherent]
    {m c : ℤ} (h : IsProjectiveRegular R ι F m) (hc : m ≤ c)
    (hsucc : ∃ (K : Type u) (_ : Finite K) (b : K → (𝟙_ (ProjectiveSpace R ι).Modules ⟶
      (moduleTensorLeftFunctor (ProjectiveSpace R ι)
        (twistingSheaf R ι (((1 : ℕ) : ℤ) + c))).obj F)), Epi (Sigma.desc b)) :
    ∃ (J : Type u) (_ : Finite J) (s : J → (𝟙_ (ProjectiveSpace R ι).Modules ⟶
      (moduleTensorLeftFunctor (ProjectiveSpace R ι) (twistingSheaf R ι c)).obj F)),
      Epi (Sigma.desc s) := by
  have : Finite ι := Finite.of_equiv _ e.symm
  obtain ⟨K, hK, b, hb⟩ := hsucc
  obtain ⟨s, hs⟩ := exists_finite_sections_comp (fun i : ι =>
    (twistingTensorMultiply R ι ((1 : ℕ) : ℤ) c (coordinateSection R ι i)).app F)
    (IsProjectiveRegular.surjective_coordinateMul R ι n e h hc) b
  exact ⟨K × ι, inferInstance, s, epi_of_sigmaDesc_coordinateMul_comp R ι c _ hs⟩

/-- **Nitsure, Lemma 2.1 (c)**, generation half, with a finite generating family
(arXiv:math/0504590v1, p. 10; Stacks, Tag 08A8, Lemma 33.35.12): if an affine-locally
finite-type module `F` is `m`-regular, then for every `r ≥ m`, `O(r) ⊗ F` is generated by finitely
many global sections, in the sense of Mathlib's `SheafOfModules.GeneratingSections`. With
`IsProjectiveRegular.cohomology_subsingleton_of_le_of_coherent` this is Lemma 2.1 (c). The base
is an arbitrary commutative ring. -/
theorem IsProjectiveRegular.exists_generatingSections_isFiniteType (n : ℕ)
    (e : ι ≃ Fin (n + 1)) {F : (ProjectiveSpace R ι).Modules}
    (hF : affineLocallyFiniteType (ProjectiveSpace R ι) F)
    {m r : ℤ} (h : IsProjectiveRegular R ι F m) (hr : m ≤ r) :
    ∃ σ : SheafOfModules.GeneratingSections ((moduleTensorLeftFunctor (ProjectiveSpace R ι)
      (twistingSheaf R ι r)).obj F), σ.IsFiniteType := by
  have : Finite ι := Finite.of_equiv _ e.symm
  have : F.IsQuasicoherent := quasicoherent_of_affineCharts _ (fun A j _ => (hF A j).1)
  obtain ⟨N, hN, I, hI, π, hπ, -⟩ := exists_uniformNegativeTwistEpimorphism R ι F hF r.toNat
  have hbase := exists_finite_epi_sigmaDesc_of_negativeTwist R ι (N : ℤ) π
  have key : ∀ k : ℕ, (∃ (J : Type u) (_ : Finite J) (s : J → (𝟙_ (ProjectiveSpace R ι).Modules ⟶
      (moduleTensorLeftFunctor (ProjectiveSpace R ι) (twistingSheaf R ι (r + k))).obj F)),
        Epi (Sigma.desc s)) →
      ∃ (J : Type u) (_ : Finite J) (s : J → (𝟙_ (ProjectiveSpace R ι).Modules ⟶
        (moduleTensorLeftFunctor (ProjectiveSpace R ι) (twistingSheaf R ι r)).obj F)),
        Epi (Sigma.desc s) := by
    intro k
    induction k with
    | zero =>
      intro hk
      rw [Nat.cast_zero, add_zero] at hk
      exact hk
    | succ k ih =>
      intro hk
      apply ih
      apply exists_finite_epi_sigmaDesc_of_succ R ι n e h (c := r + k) (by omega)
      have hdeg : r + ((k + 1 : ℕ) : ℤ) = ((1 : ℕ) : ℤ) + (r + k) := by push_cast; ring
      rw [hdeg] at hk
      exact hk
  have h1 : r ≤ (r.toNat : ℤ) := Int.self_le_toNat r
  have h2 : (r.toNat : ℤ) ≤ N := by exact_mod_cast hN
  have h0 : 0 ≤ (N : ℤ) - r := by omega
  have hdeg : r + ((((N : ℤ) - r).toNat : ℕ) : ℤ) = (N : ℤ) := by
    rw [Int.toNat_of_nonneg h0]
    ring
  obtain ⟨J, hJ, s, hs⟩ := key ((N : ℤ) - r).toNat (by rw [hdeg]; exact hbase)
  exact exists_generatingSections_isFiniteType_of_epi s

/-- **Nitsure, Lemma 2.1 (c)**, generation half (arXiv:math/0504590v1, p. 10; Stacks, Tag 08A8,
Lemma 33.35.12): if an affine-locally finite-type module `F` is `m`-regular, then `O(r) ⊗ F` is
generated by its global sections for every `r ≥ m`: the evaluation of all global sections is an
epimorphism. Lemma 2.1 (c) is the conjunction of this and the vanishing
`H^i(O(r) ⊗ F) = 0` for `i ≥ 1` (`IsProjectiveRegular.cohomology_subsingleton_of_le_of_coherent`).
The base is an arbitrary commutative ring, and `ι` is labelled by `Fin (n + 1)`. -/
theorem IsProjectiveRegular.epi_globalSectionsEval (n : ℕ) (e : ι ≃ Fin (n + 1))
    {F : (ProjectiveSpace R ι).Modules}
    (hF : affineLocallyFiniteType (ProjectiveSpace R ι) F)
    {m r : ℤ} (h : IsProjectiveRegular R ι F m) (hr : m ≤ r) :
    Epi (globalSectionsEval ((moduleTensorLeftFunctor (ProjectiveSpace R ι)
      (twistingSheaf R ι r)).obj F)) := by
  have : Finite ι := Finite.of_equiv _ e.symm
  have : F.IsQuasicoherent := quasicoherent_of_affineCharts _ (fun A j _ => (hF A j).1)
  obtain ⟨N, hN, I, hI, π, hπ, -⟩ := exists_uniformNegativeTwistEpimorphism R ι F hF r.toNat
  have hbase := epi_globalSectionsEval_of_negativeTwist R ι (N : ℤ) π
  have key : ∀ k : ℕ, Epi (globalSectionsEval ((moduleTensorLeftFunctor (ProjectiveSpace R ι)
      (twistingSheaf R ι (r + k))).obj F)) → Epi (globalSectionsEval
        ((moduleTensorLeftFunctor (ProjectiveSpace R ι) (twistingSheaf R ι r)).obj F)) := by
    intro k
    induction k with
    | zero =>
      intro hk
      rw [Nat.cast_zero, add_zero] at hk
      exact hk
    | succ k ih =>
      intro hk
      apply ih
      apply epi_globalSectionsEval_of_succ R ι n e h (c := r + k) (by omega)
      have hdeg : r + ((k + 1 : ℕ) : ℤ) = ((1 : ℕ) : ℤ) + (r + k) := by push_cast; ring
      rw [hdeg] at hk
      exact hk
  have h1 : r ≤ (r.toNat : ℤ) := Int.self_le_toNat r
  have h2 : (r.toNat : ℤ) ≤ N := by exact_mod_cast hN
  have h0 : 0 ≤ (N : ℤ) - r := by omega
  apply key ((N : ℤ) - r).toNat
  have hdeg : r + ((((N : ℤ) - r).toNat : ℕ) : ℤ) = (N : ℤ) := by
    rw [Int.toNat_of_nonneg h0]
    ring
  rw [hdeg]
  exact hbase

-- The free module sheaf is the coproduct of copies of `SheafOfModules.unit`, which is `𝟙_` only
-- after unfolding the monoidal structure.
set_option backward.isDefEq.respectTransparency false in
/-- **Nitsure, Lemma 2.1 (c)**, generation half, with Mathlib's generating sections
(arXiv:math/0504590v1, p. 10; Stacks, Tag 08A8, Lemma 33.35.12): for `r ≥ m`, the global
sections of `O(r) ⊗ F` generate it. -/
theorem IsProjectiveRegular.nonempty_generatingSections (n : ℕ) (e : ι ≃ Fin (n + 1))
    {F : (ProjectiveSpace R ι).Modules}
    (hF : affineLocallyFiniteType (ProjectiveSpace R ι) F)
    {m r : ℤ} (h : IsProjectiveRegular R ι F m) (hr : m ≤ r) :
    Nonempty (SheafOfModules.GeneratingSections ((moduleTensorLeftFunctor (ProjectiveSpace R ι)
      (twistingSheaf R ι r)).obj F)) := by
  have hev := IsProjectiveRegular.epi_globalSectionsEval R ι n e hF h hr
  refine ⟨⟨𝟙_ (ProjectiveSpace R ι).Modules ⟶ (moduleTensorLeftFunctor (ProjectiveSpace R ι)
    (twistingSheaf R ι r)).obj F, SheafOfModules.freeHomEquiv _ (globalSectionsEval _), ?_⟩⟩
  rw [Equiv.symm_apply_apply]
  exact hev

end AlgebraicGeometry.Scheme.Cohomology
