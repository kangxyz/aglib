module

public import Aglib.AlgebraicGeometry.EtaleCohomology.Constructible.FiniteCogenerators.Global.ModuleImages
public import Aglib.AlgebraicGeometry.EtaleCohomology.Constructible.FiniteCogenerators.Global.RelativeAffine
public import Mathlib.AlgebraicGeometry.Morphisms.Integral
public import Mathlib.RingTheory.IntegralClosure.IsIntegralClosure.Basic

/-! # Actual global algebras generated by finite-type module images

The original module-section images generate subalgebras of the original
inverse-image section rings. Their restriction equations give a genuine
presheaf, their principal-open denominator clearing gives an affine-basis
relative gluing, and integrality makes each actual structural ring map finite.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry.Scheme.EtaleCohomology.Constructible.FiniteCogenerators.Global

universe u

open Scheme.Modules
open Scheme.Modules.QuasiCoherent

variable {Y X : Scheme.{u}} (f : Y ⟶ X) {J : Type u}
  (M : J → X.Modules) (i : ∀ j, M j ⟶ pushforwardStructureSheaf f)

/-- Original section subalgebras generated by the actual global module images. -/
def generatedSectionRing (U : X.Opens) : CommRingCat.{u} :=
  letI := (f.app U).hom.toAlgebra
  .of (Algebra.adjoin Γ(X, U) (sectionGenerators f M i U))

/-- The literal original inclusion into the original ambient section ring. -/
def generatedSectionInclusion (U : X.Opens) :
    generatedSectionRing f M i U ⟶ Γ(Y, f ⁻¹ᵁ U) :=
  letI := (f.app U).hom.toAlgebra
  CommRingCat.ofHom (Algebra.adjoin Γ(X, U) (sectionGenerators f M i U)).val.toRingHom

instance generatedSectionInclusion_mono (U : X.Opens) :
    Mono (generatedSectionInclusion f M i U) := by
  apply (ConcreteCategory.mono_iff_injective_of_preservesPullback _).mpr
  intro x y h
  exact Subtype.ext h

/-- Original section restriction, restricted to the original generated subalgebras. -/
def generatedSectionRestriction {U V : X.Opens} (a : V ⟶ U) :
    generatedSectionRing f M i U ⟶ generatedSectionRing f M i V := by
  letI : Algebra Γ(X, U) Γ(Y, f ⁻¹ᵁ U) := (f.app U).hom.toAlgebra
  letI : Algebra Γ(X, V) Γ(Y, f ⁻¹ᵁ V) := (f.app V).hom.toAlgebra
  letI : Algebra Γ(X, U) Γ(X, V) := (X.presheaf.map a.op).hom.toAlgebra
  letI : Algebra Γ(Y, f ⁻¹ᵁ U) Γ(Y, f ⁻¹ᵁ V) :=
    (Y.presheaf.map (homOfLE (f.preimage_mono a.le)).op).hom.toAlgebra
  letI : Algebra Γ(X, U) Γ(Y, f ⁻¹ᵁ V) :=
    ((X.presheaf.map a.op) ≫ f.app V).hom.toAlgebra
  haveI : IsScalarTower Γ(X, U) Γ(X, V) Γ(Y, f ⁻¹ᵁ V) :=
    IsScalarTower.of_algebraMap_eq' rfl
  haveI : IsScalarTower Γ(X, U) Γ(Y, f ⁻¹ᵁ U) Γ(Y, f ⁻¹ᵁ V) :=
    IsScalarTower.of_algebraMap_eq' (by
      change ((X.presheaf.map a.op) ≫ f.app V).hom =
        (f.app U ≫ Y.presheaf.map (homOfLE (f.preimage_mono a.le)).op).hom
      exact congrArg CommRingCat.Hom.hom (f.naturality a.op))
  exact CommRingCat.ofHom (adjoinMap Γ(X, U) Γ(X, V) Γ(Y, f ⁻¹ᵁ U) Γ(Y, f ⁻¹ᵁ V)
    (sectionGenerators f M i U) (sectionGenerators f M i V)
    (fun x hx => Algebra.subset_adjoin (sectionGenerators_restrict f M i a hx)))

/-- The original restriction equation for the literal subalgebra inclusion. -/
@[reassoc]
theorem generatedSectionRestriction_inclusion {U V : X.Opens} (a : V ⟶ U) :
    generatedSectionRestriction f M i a ≫ generatedSectionInclusion f M i V =
      generatedSectionInclusion f M i U ≫ (relativeSectionDiagram f).map a.op := by
  ext x
  rfl

/-- The actual generated section-ring presheaf. Only its affine basis will
be used for relative realization; no all-open sheaf assertion is made. -/
def generatedSectionDiagram : X.Opensᵒᵖ ⥤ CommRingCat.{u} where
  obj U := generatedSectionRing f M i U.unop
  map a := generatedSectionRestriction f M i a.unop
  map_id U := by
    apply (cancel_mono (generatedSectionInclusion f M i U.unop)).mp
    exact (generatedSectionRestriction_inclusion f M i (𝟙 U.unop)).trans
      ((congrArg (fun k => generatedSectionInclusion f M i U.unop ≫ k)
        ((relativeSectionDiagram f).map_id U)).trans
          ((Category.comp_id _).trans (Category.id_comp _).symm))
  map_comp {U V W} a b := by
    apply (cancel_mono (generatedSectionInclusion f M i W.unop)).mp
    let r := generatedSectionRestriction f M i a.unop
    let s := generatedSectionRestriction f M i b.unop
    let c := generatedSectionInclusion f M i U.unop
    let d := generatedSectionInclusion f M i V.unop
    let e := generatedSectionInclusion f M i W.unop
    let p := (relativeSectionDiagram f).map a
    let q := (relativeSectionDiagram f).map b
    have hr : r ≫ d = c ≫ p := generatedSectionRestriction_inclusion f M i a.unop
    have hs : s ≫ e = d ≫ q := generatedSectionRestriction_inclusion f M i b.unop
    have hright : (r ≫ s) ≫ e = c ≫ (relativeSectionDiagram f).map (a ≫ b) :=
      (Category.assoc r s e).trans
        ((congrArg (fun k => r ≫ k) hs).trans
          ((Category.assoc r d q).symm.trans
            ((congrArg (fun k => k ≫ q) hr).trans
              ((Category.assoc c p q).trans
                (congrArg (fun k => c ≫ k) ((relativeSectionDiagram f).map_comp a b).symm)))))
    exact (generatedSectionRestriction_inclusion f M i (a ≫ b).unop).trans hright.symm

/-- The original pointwise algebra inclusion as an actual natural transformation. -/
def generatedSectionEmbedding : generatedSectionDiagram f M i ⟶ relativeSectionDiagram f where
  app U := generatedSectionInclusion f M i U.unop
  naturality {_U _V} a := generatedSectionRestriction_inclusion f M i a.unop

/-- The original structure map into the original generated section subalgebra. -/
def generatedSectionStructuralApp (U : X.Opens) : Γ(X, U) ⟶ generatedSectionRing f M i U :=
  letI := (f.app U).hom.toAlgebra
  CommRingCat.ofHom (algebraMap Γ(X, U)
    (Algebra.adjoin Γ(X, U) (sectionGenerators f M i U)))

@[reassoc]
theorem generatedSectionStructuralApp_inclusion (U : X.Opens) :
    generatedSectionStructuralApp f M i U ≫ generatedSectionInclusion f M i U = f.app U := by
  ext x
  rfl

/-- The original structural natural transformation is proved by the literal
inclusion equations, before any concrete relative gluing is constructed. -/
def generatedSectionStructuralMap : X.presheaf ⟶ generatedSectionDiagram f M i where
  app U := generatedSectionStructuralApp f M i U.unop
  naturality {U V} a := by
    apply (cancel_mono (generatedSectionInclusion f M i V.unop)).mp
    let p := X.presheaf.map a
    let c := generatedSectionStructuralApp f M i U.unop
    let d := generatedSectionStructuralApp f M i V.unop
    let e := generatedSectionInclusion f M i U.unop
    let h := generatedSectionInclusion f M i V.unop
    let r := generatedSectionRestriction f M i a.unop
    let q := (relativeSectionDiagram f).map a
    have hd : d ≫ h = f.app V.unop := generatedSectionStructuralApp_inclusion f M i V.unop
    have hc : c ≫ e = f.app U.unop := generatedSectionStructuralApp_inclusion f M i U.unop
    have hr : r ≫ h = e ≫ q := generatedSectionRestriction_inclusion f M i a.unop
    have hleft : (p ≫ d) ≫ h = f.app U.unop ≫ q :=
      (Category.assoc p d h).trans
        ((congrArg (fun k => p ≫ k) hd).trans (f.naturality a))
    have hright : (c ≫ r) ≫ h = f.app U.unop ≫ q :=
      (Category.assoc c r h).trans
        ((congrArg (fun k => c ≫ k) hr).trans
          ((Category.assoc c e q).symm.trans (congrArg (fun k => k ≫ q) hc)))
    exact hleft.trans hright.symm

/-- The generated structural map includes to exactly the original f.app map. -/
theorem generatedSectionStructuralMap_embedding :
    generatedSectionStructuralMap f M i ≫ generatedSectionEmbedding f M i =
      relativeSectionMap f := by
  apply NatTrans.ext
  funext U
  exact generatedSectionStructuralApp_inclusion f M i U.unop

open AffineZariskiSite

/-- The actual generated algebra localizes on the original affine basis. -/
theorem generatedSectionStructuralMap_coequifibered [IsAffineHom f]
    [∀ j, (M j).IsQuasicoherent] :
    ((toOpensFunctor X).op.whiskerLeft (generatedSectionStructuralMap f M i)).Coequifibered := by
  refine coequifibered_iff_forall_isLocalizationAway.mpr fun U r => ?_
  let D := X.basicOpen r
  let a : D ⟶ U.1 := homOfLE (X.basicOpen_le r)
  let R := Γ(X, U.1)
  let S := Γ(X, D)
  let A := Γ(Y, f ⁻¹ᵁ U.1)
  let B := Γ(Y, f ⁻¹ᵁ D)
  let : Algebra R A := (f.app U.1).hom.toAlgebra
  let : Algebra S B := (f.app D).hom.toAlgebra
  let : Algebra R S := (X.presheaf.map a.op).hom.toAlgebra
  let : Algebra A B := ((relativeSectionDiagram f).map a.op).hom.toAlgebra
  let : Algebra R B := ((X.presheaf.map a.op) ≫ f.app D).hom.toAlgebra
  have : IsScalarTower R S B := IsScalarTower.of_algebraMap_eq' rfl
  have : IsScalarTower R A B := IsScalarTower.of_algebraMap_eq' (by
    change ((X.presheaf.map a.op) ≫ f.app D).hom =
      (f.app U.1 ≫ Y.presheaf.map (homOfLE (f.preimage_mono a.le)).op).hom
    exact congrArg CommRingCat.Hom.hom (f.naturality a.op))
  have : IsLocalization.Away r S := U.2.isLocalization_basicOpen r
  have : IsLocalization.Away (algebraMap R A r) B :=
    (coequifibered_iff_forall_isLocalizationAway.mp
      (relativeSectionMap_coequifibered f)) U r
  have hs : ∀ x ∈ sectionGenerators f M i U.1,
      algebraMap A B x ∈ Algebra.adjoin S (sectionGenerators f M i D) := by
    intro x hx
    exact Algebra.subset_adjoin (sectionGenerators_restrict f M i a hx)
  have ht : ∀ x ∈ sectionGenerators f M i D,
      ∃ (n : ℕ) (z : A), z ∈ Algebra.adjoin R (sectionGenerators f M i U.1) ∧
        x * algebraMap R B r ^ n = algebraMap A B z := by
    intro x hx
    obtain ⟨n, z, hz, heq⟩ := sectionGenerators_clear_power f M i U r hx
    refine ⟨n, z, Algebra.subset_adjoin hz, ?_⟩
    exact (mul_comm _ _).trans heq.symm
  exact adjoin_isLocalization R S A B r
    (sectionGenerators f M i U.1) (sectionGenerators f M i D) hs ht

/-- The actual structural affine ring map is finite for an integral ambient
algebra and a finite family of finite-type original module images. -/
theorem generatedSectionStructuralApp_finite [IsIntegralHom f] [Finite J]
    (hM : ∀ j, affineLocallyFiniteType X (M j)) (U : X.affineOpens) :
    (generatedSectionStructuralApp f M i U.1).hom.Finite := by
  let R := Γ(X, U.1)
  let A := Γ(Y, f ⁻¹ᵁ U.1)
  let : Algebra R A := (f.app U.1).hom.toAlgebra
  let C := Algebra.adjoin R (sectionGenerators f M i U.1)
  have : Algebra.FiniteType R C := sectionGenerators_finiteType f M i hM U
  have : Algebra.IsIntegral R A :=
    algebraMap_isIntegral_iff.mp (IsIntegralHom.isIntegral_app f U.1 U.2)
  have : Algebra.IsIntegral R C := ⟨fun z =>
    (isIntegral_algHom_iff C.val Subtype.val_injective).mp
      (Algebra.IsIntegral.isIntegral z.1)⟩
  change (algebraMap R C).Finite
  exact RingHom.finite_algebraMap.mpr (Algebra.IsIntegral.finite (R := R) (A := C))

/-- Actual finite-type module data supplies the original relative gluing;
the quasicoherence premises are derived rather than additional inputs. -/
def generatedSectionData [IsAffineHom f]
    (hM : ∀ j, affineLocallyFiniteType X (M j)) :
    (directedCover X).RelativeGluingData := by
  haveI (j : J) : (M j).IsQuasicoherent :=
    quasicoherent_of_affineCharts (M j) (fun R a _ => (hM j R a).1)
  exact relativeGluingData (generatedSectionStructuralMap_coequifibered f M i)

instance [IsAffineHom f] (hM : ∀ j, affineLocallyFiniteType X (M j)) :
    ((generatedSectionData f M i hM).functor ⋙ Scheme.forget).IsLocallyDirected :=
  Cover.RelativeGluingData.instIsLocallyDirectedI₀CompFunctorForgetOfIsThin ..

end AlgebraicGeometry.Scheme.EtaleCohomology.Constructible.FiniteCogenerators.Global
