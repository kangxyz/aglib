module

public import Aglib.AlgebraicGeometry.EtaleCohomology.Constructible.FiniteCogenerators.Global.FiniteDataCapture
public import Aglib.AlgebraicGeometry.EtaleCohomology.Constructible.FiniteCogenerators.Global.ChartMap
public import Aglib.AlgebraicGeometry.EtaleCohomology.Constructible.FiniteCogenerators.Global.StageMaps

/-! # Actual finite global models containing original affine stages

Finite-type module images capture the supplied actual finite stage generators.
The generated relative algebra gives a finite morphism over the whole base,
with its integral-surjective original comparison and original chart equations.
This complete geometric packet is constructed before coefficient transport.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

namespace AlgebraicGeometry.Scheme.EtaleCohomology.Constructible.FiniteCogenerators.Global

universe u

open AffineZariskiSite Scheme.Modules Scheme.Modules.QuasiCoherent

/-- A finite global model containing the actual original affine stages, with
the whole original relative comparison and its actual chart equations. -/
structure FiniteStageModel {X Y : Scheme.{u}} (f : Y ⟶ X) [IsIntegralHom f]
    {I : Type u} (U : I → X.AffineZariskiSite)
    (s : ∀ k, Finset Γ(Y, f ⁻¹ᵁ (U k).1)) where
  /-- The total space of the finite global model containing the supplied affine stages `s`. -/
  source : Scheme.{u}
  /-- The finite structural morphism from the global model `source` to the original base `X`. -/
  morphism : source ⟶ X
  [finite_morphism : IsFinite morphism]
  /-- The comparison from `f` to `morphism` in `Over X`, with integral surjective underlying
  map from the original source `Y` to `source`. -/
  comparison : Over.mk f ⟶ Over.mk morphism
  [comparison_surjective : Surjective comparison.left]
  [comparison_integral : IsIntegralHom comparison.left]
  /-- For each original affine chart `U k`, the subalgebra of sections of `Y` defining the
  corresponding chart of `source` and containing the stage generated by `s k`. -/
  subalgebra : ∀ k,
    letI := (f.app (U k).1).hom.toAlgebra
    Subalgebra Γ(X, (U k).1) Γ(Y, f ⁻¹ᵁ (U k).1)
  stage_le : ∀ k,
    letI := (f.app (U k).1).hom.toAlgebra
    Algebra.FiniteTypeSubalgebraLimit.stage Γ(X, (U k).1) Γ(Y, f ⁻¹ᵁ (U k).1) (s k) ≤
      subalgebra k
  /-- For each `k`, the isomorphism over `Spec Γ(X, (U k).1)` from the spectrum of
  `subalgebra k` to the pullback of `morphism` along `(U k).2.fromSpec`. -/
  chartIso : ∀ k,
    letI := (f.app (U k).1).hom.toAlgebra
    Over.mk (Spec.algebraMap Γ(X, (U k).1) (subalgebra k)) ≅
      (Over.pullback (U k).2.fromSpec).obj (Over.mk morphism)
  comparison_chart : ∀ k,
    letI := (f.app (U k).1).hom.toAlgebra
    (relativeAffineChartObjectIso f (U k)).hom ≫
        (Over.pullback (U k).2.fromSpec).map comparison =
      subalgebraOverMap Γ(X, (U k).1) Γ(Y, f ⁻¹ᵁ (U k).1) (subalgebra k) ≫
        (chartIso k).hom

attribute [instance] FiniteStageModel.finite_morphism
  FiniteStageModel.comparison_surjective FiniteStageModel.comparison_integral

/-- The actual finite generated global algebra contains any supplied finite
family of original local stages; none of the output data is a premise. -/
theorem nonempty_finiteStageModel
    {X Y : Scheme.{u}} [CompactSpace X] [QuasiSeparatedSpace X]
    (f : Y ⟶ X) [IsIntegralHom f] {I : Type u} [Finite I]
    (U : I → X.AffineZariskiSite) (s : ∀ k, Finset Γ(Y, f ⁻¹ᵁ (U k).1)) :
    Nonempty (FiniteStageModel f U s) := by
  classical
  obtain ⟨N, inc, hinc, hcap⟩ := exists_finiteType_images_containing_stages f
    (fun k : I => ⟨(U k).1, (U k).2⟩) s
  let J : Type u := Σ k, {x // x ∈ s k}
  have : Finite J := inferInstance
  let M (q : J) : X.Modules := (N q).obj
  let i (q : J) : M q ⟶ pushforwardStructureSheaf f := inc q
  let hM (q : J) : affineLocallyFiniteType X (M q) := (N q).property
  have (q : J) : (M q).IsQuasicoherent :=
    quasicoherent_of_affineCharts (M q) (fun R t _ => (hM q R t).1)
  let Z : Scheme.{u} := generatedAlgebraScheme f M i hM
  let g : Z ⟶ X := generatedAlgebraMorphism f M i hM
  let G : X.AffineZariskiSiteᵒᵖ ⥤ CommRingCat.{u} :=
    (toOpensFunctor X).op ⋙ generatedSectionDiagram f M i
  let bg : (toOpensFunctor X).op ⋙ X.presheaf ⟶ G :=
    (toOpensFunctor X).op.whiskerLeft (generatedSectionStructuralMap f M i)
  have hg : bg.Coequifibered := generatedSectionStructuralMap_coequifibered f M i
  let φ : G ⟶ (toOpensFunctor X).op ⋙ relativeSectionDiagram f :=
    (toOpensFunctor X).op.whiskerLeft (generatedSectionEmbedding f M i)
  have hφ : bg ≫ φ = (toOpensFunctor X).op.whiskerLeft (relativeSectionMap f) := by
    apply NatTrans.ext
    funext V
    exact generatedSectionStructuralApp_inclusion f M i V.unop.1
  let H : Over.mk f ⟶ Over.mk g := relativeMapFromAffineOver f hg φ hφ
  refine ⟨{
    source := Z
    morphism := g
    finite_morphism := inferInstanceAs (IsFinite (generatedAlgebraMorphism f M i hM))
    comparison := H
    comparison_surjective :=
      inferInstanceAs (Surjective (generatedAlgebraComparison f M i hM))
    comparison_integral :=
      inferInstanceAs (IsIntegralHom (generatedAlgebraComparison f M i hM))
    subalgebra := fun k =>
      letI := (f.app (U k).1).hom.toAlgebra
      Algebra.adjoin Γ(X, (U k).1) (sectionGenerators f M i (U k).1)
    stage_le := hcap
    chartIso := fun k => relativeGluingChartObjectIso hg (U k)
    comparison_chart := ?_ }⟩
  intro k
  let R : CommRingCat.{u} := Γ(X, (U k).1)
  let A : CommRingCat.{u} := Γ(Y, f ⁻¹ᵁ (U k).1)
  let : Algebra R A := (f.app (U k).1).hom.toAlgebra
  let C : Subalgebra R A := Algebra.adjoin R (sectionGenerators f M i (U k).1)
  let c := relativeGluingChartObjectIso hg (U k)
  let r : Over.mk (Spec.algebraMap R A) ⟶ Over.mk (Spec.algebraMap R C) :=
    subalgebraOverMap R A C
  have hr : relativeChartMapOver f hg φ hφ (U k) = r := by
    apply Over.OverMorphism.ext
    rfl
  exact (relativeMapFromAffineOver_pullback_chart f hg φ hφ (U k)).trans
    (congrArg (fun z => z ≫ c.hom) hr)

/-- Choose the produced actual finite global model and its original charts. -/
def finiteStageModel
    {X Y : Scheme.{u}} [CompactSpace X] [QuasiSeparatedSpace X]
    (f : Y ⟶ X) [IsIntegralHom f] {I : Type u} [Finite I]
    (U : I → X.AffineZariskiSite) (s : ∀ k, Finset Γ(Y, f ⁻¹ᵁ (U k).1)) :
    FiniteStageModel f U s :=
  Classical.choice (nonempty_finiteStageModel f U s)

end AlgebraicGeometry.Scheme.EtaleCohomology.Constructible.FiniteCogenerators.Global
