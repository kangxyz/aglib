module

public import Aglib.AlgebraicGeometry.Surfaces.Resolution.NormalizedPointBlowupChain
public import Aglib.AlgebraicGeometry.Surfaces.Resolution.WeakTransform
public import Aglib.AlgebraicGeometry.Surfaces.Birational.NormalizedBlowupCover

/-!
# The actual exceptional generator on a normalized point blowup

The actual maximal ideal at the image of a point on the exceptional fibre
extends to the principal ideal generated by a nonzero nonunit in the
actual new stalk. Its divisibility equations use the original stalk map.
-/

@[expose] public noncomputable section

set_option autoImplicit false
set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open CategoryTheory TopologicalSpace

namespace AlgebraicGeometry.Scheme.NormalizedPointDomination

universe u

open Blowup Modules Modules.Invertible

private theorem exists_nonzero_stalkGenerator
    {X : Scheme.{u}} [IsIntegral X] (I : X.IdealSheafData)
    (hI : IsLocallyRankOne X (Hom.idealModule I.subschemeι)) (x : X) :
    ∃ d : X.presheaf.stalk x, d ≠ 0 ∧ I.stalkIdeal x = Ideal.span {d} := by
  obtain ⟨U, hU, hx, t, ht, hgen⟩ :=
    Hom.exists_affine_regular_idealGenerator_of_isLocallyRankOne I.subschemeι hI x
  let : Nonempty U := ⟨⟨x, hx⟩⟩
  let d := X.presheaf.germ U x hx t
  have ht0 : t ≠ 0 := by
    intro hz
    have h10 : (1 : Γ(X, U)) = 0 := ht (by simp only [hz, zero_smul])
    exact one_ne_zero h10
  have hd : d ≠ 0 := fun hz ↦
    ht0 (germ_injective_of_isIntegral X x hx (by simpa only [map_zero] using hz))
  refine ⟨d, hd, ?_⟩
  rw [I.ker_subschemeι_app ⟨U, hU⟩] at hgen
  rw [I.stalkIdeal_eq_map ⟨U, hU⟩ x hx, hgen, Ideal.map_span, Set.image_singleton]

/-- The original point ideal becomes locally rank one on its actual normalized
blowup, by the ordinary blowup's Cartier ideal and dominant pullback. -/
theorem pointIdeal_isLocallyRankOne_normalizedPointBlowup
    (X : Scheme.{u}) [IsIntegral X] (x : X)
    (hx : IsClosed ({x} : Set X)) (hne : x ≠ genericPoint X) :
    IsLocallyRankOne (normalizedPointBlowup X x hx hne)
      (Hom.idealModule (((X.fromSpecResidueField x).ker).comap
        (normalizedPointBlowupMap X x hx hne)).subschemeι) := by
  let I := (X.fromSpecResidueField x).ker
  let B := blowupDatum I
  let : IsIntegral B.Y := pointBlowup_isIntegral X x hx hne
  let : IsDominant B.map := pointBlowup_isDominant X x hx hne
  let ν := (B.Y.fromSpecStalk (genericPoint B.Y)).fromNormalization
  let : IsDominant ν := genericNormalization_isDominant B.Y
  have havoid : genericPoint B.Y ∉ ((I.comap B.map).support : Set B.Y) := by
    rw [IdealSheafData.support_comap]
    change B.map (genericPoint B.Y) ∉ I.support
    rw [map_genericPoint_of_isDominant B.Y B.map]
    exact genericPoint_not_mem_pointCentre x hx hne
  change IsLocallyRankOne _ (Hom.idealModule (I.comap (ν ≫ B.map)).subschemeι)
  rw [IdealSheafData.comap_comp]
  exact Birational.NormalizedBlowupCover.imageIdeal_isLocallyRankOne
    (I.comap B.map) ν havoid B.cartier

/-- At a point over the actual centre, the original maximal ideal extends to
an actual principal ideal with nonzero nonunit generator. No regularity or
finite normalization premise is used. -/
theorem normalizedPoint_stalkGenerator
    (X : Scheme.{u}) [IsIntegral X] (x : X)
    (hx : IsClosed ({x} : Set X)) (hne : x ≠ genericPoint X)
    (y : normalizedPointBlowup X x hx hne)
    (hy : normalizedPointBlowupMap X x hx hne y = x) :
    ∃ d : (normalizedPointBlowup X x hx hne).presheaf.stalk y,
      d ≠ 0 ∧ ¬ IsUnit d ∧
      (IsLocalRing.maximalIdeal (X.presheaf.stalk (normalizedPointBlowupMap X x hx hne y))).map
        ((normalizedPointBlowupMap X x hx hne).stalkMap y).hom = Ideal.span {d} := by
  let N := normalizedPointBlowup X x hx hne
  let r := normalizedPointBlowupMap X x hx hne
  let : IsIntegral N := normalizedPointBlowup_isIntegral X x hx hne
  let I := (X.fromSpecResidueField x).ker
  let E := I.comap r
  obtain ⟨d, hd, hgen⟩ := exists_nonzero_stalkGenerator E
    (pointIdeal_isLocallyRankOne_normalizedPointBlowup X x hx hne) y
  have hcentre : I.stalkIdeal (r y) = IsLocalRing.maximalIdeal (X.presheaf.stalk (r y)) := by
    dsimp [I, r]
    rw [hy]
    exact pointCentre_stalkIdeal x hx
  have hext : E.stalkIdeal y =
      (IsLocalRing.maximalIdeal (X.presheaf.stalk (r y))).map (r.stalkMap y).hom := by
    rw [IdealSheafData.stalkIdeal_comap, hcentre]
  have hyE : y ∈ E.support := by
    rw [IdealSheafData.support_comap]
    change r y ∈ I.support
    rw [hy]
    change x ∈ ((X.fromSpecResidueField x).ker.support : Set X)
    rw [Hom.support_ker, range_fromSpecResidueField]
    exact subset_closure (Set.mem_singleton x)
  have hneTop : E.stalkIdeal y ≠ ⊤ := (E.stalkIdeal_ne_top_iff_mem_support y).mpr hyE
  refine ⟨d, hd, ?_, hext.symm.trans hgen⟩
  intro hu
  exact hneTop (hgen.trans (Ideal.span_singleton_eq_top.mpr hu))

/-- Every pair of original maximal-ideal elements admits simultaneous division
by the same nonzero nonunit exceptional generator in the actual new stalk. -/
theorem normalizedPoint_stalk_factor_pair
    (X : Scheme.{u}) [IsIntegral X] (x : X)
    (hx : IsClosed ({x} : Set X)) (hne : x ≠ genericPoint X)
    (y : normalizedPointBlowup X x hx hne)
    (hy : normalizedPointBlowupMap X x hx hne y = x)
    (a b : X.presheaf.stalk (normalizedPointBlowupMap X x hx hne y))
    (ha : a ∈ IsLocalRing.maximalIdeal _)
    (hb : b ∈ IsLocalRing.maximalIdeal _) :
    ∃ d a' b' : (normalizedPointBlowup X x hx hne).presheaf.stalk y,
      d ≠ 0 ∧ ¬ IsUnit d ∧
      (normalizedPointBlowupMap X x hx hne).stalkMap y a = a' * d ∧
      (normalizedPointBlowupMap X x hx hne).stalkMap y b = b' * d := by
  obtain ⟨d, hd, hdu, hgen⟩ := normalizedPoint_stalkGenerator X x hx hne y hy
  have ha' := Ideal.mem_map_of_mem ((normalizedPointBlowupMap X x hx hne).stalkMap y).hom ha
  have hb' := Ideal.mem_map_of_mem ((normalizedPointBlowupMap X x hx hne).stalkMap y).hom hb
  rw [hgen, Ideal.mem_span_singleton] at ha' hb'
  obtain ⟨a', ha'⟩ := ha'
  obtain ⟨b', hb'⟩ := hb'
  exact ⟨d, a', b', hd, hdu, ha'.trans (mul_comm d a'), hb'.trans (mul_comm d b')⟩

end AlgebraicGeometry.Scheme.NormalizedPointDomination
