noncomputable section
open CategoryTheory Limits AlgebraicGeometry
universe u
namespace AlgebraicGeometry.Scheme.PowerNode
variable {R S : Type u} [CommRing R] [CommRing S] [Algebra R S]

/-- The canonical node scalar-extension comparison with the node projection first. -/
def specializationIso (c : R) :
    Spec (.of (PlaneNode.Ring (algebraMap R S c))) ≅
      pullback (Spec.map (CommRingCat.ofHom (algebraMap R (PlaneNode.Ring c))))
        (Spec.map (CommRingCat.ofHom (algebraMap R S))) :=
  baseChangeIso S c ≪≫ pullbackSymmetry _ _

@[reassoc] theorem specializationIso_hom_fst (c : R) :
    (specializationIso (S := S) c).hom ≫ pullback.fst _ _ =
      Spec.map (CommRingCat.ofHom (PlaneNode.coefficientMap S c).toRingHom) := by
  simp only [specializationIso, Iso.trans_hom, Category.assoc,
    pullbackSymmetry_hom_comp_fst, baseChangeIso_hom_snd]

@[reassoc] theorem specializationIso_hom_snd (c : R) :
    (specializationIso (S := S) c).hom ≫ pullback.snd _ _ =
      Spec.map (CommRingCat.ofHom (algebraMap S (PlaneNode.Ring (algebraMap R S c)))) := by
  simp only [specializationIso, Iso.trans_hom, Category.assoc,
    pullbackSymmetry_hom_comp_snd, baseChangeIso_hom_fst]

end AlgebraicGeometry.Scheme.PowerNode
end

section NodeCrossBranches

/-! The two actual affine-line branches of UV=0, with their coordinate kernels. -/
noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open CategoryTheory Limits AlgebraicGeometry Polynomial
open AlgebraicGeometry.Scheme AlgebraicGeometry.Scheme.Hom
open PlaneNode _root_.PowerNode.Rees
universe u
namespace AlgebraicGeometry.Scheme.PowerNode.Resolution.Cross
variable (k : Type u) [Field k]

/-- The coordinate ring of the split cross `UV = 0` over `k`. -/
abbrev ring := PlaneNode.Ring (0 : k)
/-- The affine split cross over `k`. -/
abbrev scheme : Scheme.{u} := Spec (.of (ring k))
/-- The affine line over `k` used to parametrize each branch of the cross. -/
abbrev line : Scheme.{u} := Spec (.of k[X])

/-- Restriction to the left branch, sending `U` to `X` and `V` to zero. -/
def leftHom : ring k →ₐ[k] k[X] := PlaneNode.lift 0 Polynomial.X 0 (by simp)
/-- Restriction to the right branch, sending `U` to zero and `V` to `X`. -/
def rightHom : ring k →ₐ[k] k[X] := PlaneNode.lift 0 0 Polynomial.X (by simp)
/-- Evaluation at the origin of the cross, sending both node coordinates to zero. -/
def originHom : ring k →ₐ[k] k := PlaneNode.lift 0 0 0 (by simp)

/-- The ideal generated by `V`, cutting out the left branch of the cross. -/
def leftIdeal : Ideal (ring k) := Ideal.span {PlaneNode.V (0 : k)}
/-- The ideal generated by `U`, cutting out the right branch of the cross. -/
def rightIdeal : Ideal (ring k) := Ideal.span {PlaneNode.U (0 : k)}

/-- Restriction from the quotient by the left-branch ideal to its polynomial coordinate ring. -/
def leftQuotientHom : ring k ⧸ leftIdeal k →ₐ[k] k[X] :=
  Ideal.Quotient.liftₐ _ (leftHom k) (by
    change Ideal.span _ ≤ RingHom.ker _
    apply Ideal.span_le.mpr
    intro z hz
    rcases Set.mem_singleton_iff.mp hz with rfl
    simp [leftHom])

/-- Restriction from the quotient by the right-branch ideal to its polynomial coordinate ring. -/
def rightQuotientHom : ring k ⧸ rightIdeal k →ₐ[k] k[X] :=
  Ideal.Quotient.liftₐ _ (rightHom k) (by
    change Ideal.span _ ≤ RingHom.ker _
    apply Ideal.span_le.mpr
    intro z hz
    rcases Set.mem_singleton_iff.mp hz with rfl
    simp [rightHom])

@[simp] lemma leftQuotientHom_mk (z : ring k) :
    leftQuotientHom k (Ideal.Quotient.mk (leftIdeal k) z) = leftHom k z := rfl
@[simp] lemma rightQuotientHom_mk (z : ring k) :
    rightQuotientHom k (Ideal.Quotient.mk (rightIdeal k) z) = rightHom k z := rfl

lemma quotient_left_v : Ideal.Quotient.mk (leftIdeal k) (PlaneNode.V (0 : k)) = 0 :=
  Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))
lemma quotient_right_u : Ideal.Quotient.mk (rightIdeal k) (PlaneNode.U (0 : k)) = 0 :=
  Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))

/-- Identify the quotient by `(V)` with `k[X]` using the surviving coordinate `U`. -/
def leftQuotientEquiv : (ring k ⧸ leftIdeal k) ≃ₐ[k] k[X] :=
  AlgEquiv.ofAlgHom (leftQuotientHom k)
    (aeval (Ideal.Quotient.mk (leftIdeal k) (PlaneNode.U (0 : k))))
    (by
      apply Polynomial.algHom_ext
      rw [AlgHom.comp_apply, aeval_X, AlgHom.id_apply]
      exact (leftQuotientHom_mk k _).trans (PlaneNode.lift_U ..))
    (by
      apply Ideal.Quotient.algHom_ext
      apply PlaneNode.hom_ext
      · change aeval _ (leftQuotientHom k (Ideal.Quotient.mk _ (PlaneNode.U (0 : k)))) = _
        rw [leftQuotientHom_mk, leftHom, PlaneNode.lift_U, aeval_X]
        rfl
      · change aeval _ (leftQuotientHom k (Ideal.Quotient.mk _ (PlaneNode.V (0 : k)))) = _
        rw [leftQuotientHom_mk, leftHom, PlaneNode.lift_V, map_zero]
        exact (quotient_left_v k).symm)

/-- Identify the quotient by `(U)` with `k[X]` using the surviving coordinate `V`. -/
def rightQuotientEquiv : (ring k ⧸ rightIdeal k) ≃ₐ[k] k[X] :=
  AlgEquiv.ofAlgHom (rightQuotientHom k)
    (aeval (Ideal.Quotient.mk (rightIdeal k) (PlaneNode.V (0 : k))))
    (by
      apply Polynomial.algHom_ext
      rw [AlgHom.comp_apply, aeval_X, AlgHom.id_apply]
      simp [rightHom])
    (by
      apply Ideal.Quotient.algHom_ext
      apply PlaneNode.hom_ext
      · change aeval _ (rightQuotientHom k (Ideal.Quotient.mk _ (PlaneNode.U (0 : k)))) = _
        rw [rightQuotientHom_mk, rightHom, PlaneNode.lift_U, map_zero]
        exact (quotient_right_u k).symm
      · change aeval _ (rightQuotientHom k (Ideal.Quotient.mk _ (PlaneNode.V (0 : k)))) = _
        rw [rightQuotientHom_mk, rightHom, PlaneNode.lift_V, aeval_X]
        rfl)

lemma leftHom_ker : RingHom.ker (leftHom k).toRingHom = leftIdeal k := by
  ext z
  change leftHom k z = 0 ↔ z ∈ leftIdeal k
  rw [← Ideal.Quotient.eq_zero_iff_mem]
  exact ⟨fun h => (leftQuotientEquiv k).injective (by simpa [leftQuotientEquiv,
    leftQuotientHom] using h), fun h => by
      have := congrArg (leftQuotientEquiv k) h
      simpa [leftQuotientEquiv, leftQuotientHom] using this⟩

lemma rightHom_ker : RingHom.ker (rightHom k).toRingHom = rightIdeal k := by
  ext z
  change rightHom k z = 0 ↔ z ∈ rightIdeal k
  rw [← Ideal.Quotient.eq_zero_iff_mem]
  exact ⟨fun h => (rightQuotientEquiv k).injective (by simpa [rightQuotientEquiv,
    rightQuotientHom] using h), fun h => by
      have := congrArg (rightQuotientEquiv k) h
      simpa [rightQuotientEquiv, rightQuotientHom] using this⟩

lemma leftHom_surjective : Function.Surjective (leftHom k) := by
  intro p
  obtain ⟨z, hz⟩ := (leftQuotientEquiv k).surjective p
  obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective z
  exact ⟨q, hz⟩
lemma rightHom_surjective : Function.Surjective (rightHom k) := by
  intro p
  obtain ⟨z, hz⟩ := (rightQuotientEquiv k).surjective p
  obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective z
  exact ⟨q, hz⟩

/-- The actual reduced affine-line component morphisms. -/
def left : line k ⟶ scheme k := Spec.map (CommRingCat.ofHom (leftHom k).toRingHom)
/-- The right-branch inclusion from the affine line into the cross. -/
def right : line k ⟶ scheme k := Spec.map (CommRingCat.ofHom (rightHom k).toRingHom)
/-- The residue-field point at the intersection of the two branches of the cross. -/
def origin : Spec (.of k) ⟶ scheme k := Spec.map (CommRingCat.ofHom (originHom k).toRingHom)
/-- The zero point of the affine line, used as the endpoint of either branch. -/
def endpoint : Spec (.of k) ⟶ line k := Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom 0))

instance left_closedImmersion : IsClosedImmersion (left k) :=
  IsClosedImmersion.spec_of_surjective _ (leftHom_surjective k)
instance right_closedImmersion : IsClosedImmersion (right k) :=
  IsClosedImmersion.spec_of_surjective _ (rightHom_surjective k)

@[reassoc] lemma left_endpoint : endpoint k ≫ left k = origin k := by
  rw [endpoint, left, origin, ← Spec.map_comp]
  congr 1
  apply CommRingCat.hom_ext
  have h : (aeval (0 : k)).comp (leftHom k) = originHom k := by
    apply PlaneNode.hom_ext <;> simp [leftHom, originHom]
  exact congrArg AlgHom.toRingHom h

@[reassoc] lemma right_endpoint : endpoint k ≫ right k = origin k := by
  rw [endpoint, right, origin, ← Spec.map_comp]
  congr 1
  apply CommRingCat.hom_ext
  have h : (aeval (0 : k)).comp (rightHom k) = originHom k := by
    apply PlaneNode.hom_ext <;> simp [rightHom, originHom]
  exact congrArg AlgHom.toRingHom h

end AlgebraicGeometry.Scheme.PowerNode.Resolution.Cross

end -- noncomputable section
end NodeCrossBranches


section NodeResolutionSpecialFibres

noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open CategoryTheory Limits AlgebraicGeometry Polynomial
open AlgebraicGeometry.Scheme AlgebraicGeometry.Scheme.Hom
open PlaneNode _root_.PowerNode.Rees
open AlgebraicGeometry.Scheme.Blowup AlgebraicGeometry.Scheme.PowerNode.BlowupAtlas
  AlgebraicGeometry.Scheme
universe u
namespace AlgebraicGeometry.Scheme.PowerNode.Resolution
variable {R : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
variable {π : R} {n : ℕ}

/-- The actual residue-field base morphism. -/
abbrev residueBase : Spec (.of (IsLocalRing.ResidueField R)) ⟶ Spec (.of R) :=
  AlgebraicGeometry.Scheme.LocalRing.residueSpecMap R

/-- The residue-field fibre of the exponent-`n` node over the base ring. -/
abbrev targetSpecialFibre (π : R) (n : ℕ) : Scheme.{u} :=
  AlgebraicGeometry.Scheme.LocalRing.ResidueFiber.obj (base (π := π) (n := n))
/-- The residue-field fibre of the constructed modification source over the base ring. -/
abbrev sourceSpecialFibre (D : Data π n) : Scheme.{u} :=
  AlgebraicGeometry.Scheme.LocalRing.ResidueFiber.obj (D.map ≫ base)

/-- The map from the source special fibre to the target special fibre induced by `D.map`. -/
def specialFibreMap (D : Data π n) : sourceSpecialFibre D ⟶ targetSpecialFibre π n :=
  (pullbackRightPullbackFstIso base residueBase D.map).inv ≫
    pullback.snd D.map (pullback.fst base residueBase)

@[reassoc] lemma specialFibreMap_fst (D : Data π n) :
    specialFibreMap D ≫ pullback.fst base residueBase =
      pullback.fst (D.map ≫ base) residueBase ≫ D.map := by
  simp [specialFibreMap]
@[reassoc] lemma specialFibreMap_snd (D : Data π n) :
    specialFibreMap D ≫ pullback.snd base residueBase =
      pullback.snd (D.map ≫ base) residueBase := by
  simp [specialFibreMap]

instance specialFibreMap_proper (D : Data π n) : IsProper (specialFibreMap D) := by
  dsimp [specialFibreMap]; infer_instance

lemma specialFibreMap_surjective (D : Data π n) (hπ : π ≠ 0) :
    Surjective (specialFibreMap D) := by
  let := map_surjective D hπ
  dsimp [specialFibreMap]; infer_instance

/-- The target special fibre is literally the scalar-specialized node. -/
def targetSpecialFibreIso (π : R) (n : ℕ) : targetSpecialFibre π n ≅
    Spec (.of (PlaneNode.Ring (algebraMap R (IsLocalRing.ResidueField R) (π^n)))) :=
  (Scheme.PowerNode.specializationIso (S := IsLocalRing.ResidueField R) (π^n)).symm

/-- Change the displayed node parameter by an actual coefficient equality. -/
def nodeParameterIso {k : Type u} [CommRing k] {a b : k} (h : a = b) :
    Spec (.of (PlaneNode.Ring a)) ≅ Spec (.of (PlaneNode.Ring b)) :=
  eqToIso (congrArg (fun c => Spec (.of (PlaneNode.Ring c))) h)

@[reassoc] lemma nodeParameterIso_inv_base {k : Type u} [CommRing k]
    {a b : k} (h : a = b) :
    (nodeParameterIso h).inv ≫ Spec.map (CommRingCat.ofHom (algebraMap k (PlaneNode.Ring a))) =
      Spec.map (CommRingCat.ofHom (algebraMap k (PlaneNode.Ring b))) := by
  subst b
  simp [nodeParameterIso]

/-- Identify the source and target special fibres of the exponent-zero identity modification. -/
def zeroSourceTargetIso (π : R) : sourceSpecialFibre (zero π) ≅ targetSpecialFibre π 0 :=
  pullback.congrHom (Category.id_comp _) rfl

/-- Identify the source and target special fibres of the exponent-one identity modification. -/
def oneSourceTargetIso (π : R) (hπ : Irreducible π) :
    sourceSpecialFibre (one π hπ) ≅ targetSpecialFibre π 1 :=
  pullback.congrHom (Category.id_comp _) rfl

@[reassoc] lemma zeroSourceTargetIso_inv_snd (π : R) :
    (zeroSourceTargetIso π).inv ≫ pullback.snd ((zero π).map ≫ base) residueBase =
      pullback.snd (base (π := π) (n := 0)) residueBase := by
  dsimp only [zeroSourceTargetIso]
  rw [pullback.congrHom_inv]
  change pullback.lift _ _ _ ≫ pullback.snd _ _ = _
  rw [pullback.lift_snd, Category.comp_id]

@[reassoc] lemma oneSourceTargetIso_inv_snd (π : R) (hπ : Irreducible π) :
    (oneSourceTargetIso π hπ).inv ≫ pullback.snd ((one π hπ).map ≫ base) residueBase =
      pullback.snd (base (π := π) (n := 1)) residueBase := by
  dsimp only [oneSourceTargetIso]
  rw [pullback.congrHom_inv]
  change pullback.lift _ _ _ ≫ pullback.snd _ _ = _
  rw [pullback.lift_snd, Category.comp_id]

/-- At n=0 the fibre is UV=1, kept separate from the nodal cross. -/
def zeroSpecialFibreIso (π : R) : sourceSpecialFibre (zero π) ≅
    Spec (.of (PlaneNode.Ring (1 : IsLocalRing.ResidueField R))) :=
  zeroSourceTargetIso π ≪≫ targetSpecialFibreIso π 0 ≪≫ nodeParameterIso (by simp)

/-- At n=1 the actual source has the split cross as its special fibre. -/
def oneSpecialFibreIso (π : R) (hπ : Irreducible π) :
    sourceSpecialFibre (one π hπ) ≅ Cross.scheme (IsLocalRing.ResidueField R) :=
  oneSourceTargetIso π hπ ≪≫ targetSpecialFibreIso π 1 ≪≫ nodeParameterIso (by
    simp only [pow_one, IsLocalRing.ResidueField.algebraMap_eq,
      IsDiscreteValuationRing.uniformizer_residue_zero π hπ])

@[reassoc] lemma targetSpecialFibreIso_inv_snd (π : R) (n : ℕ) :
    (targetSpecialFibreIso π n).inv ≫ pullback.snd base residueBase =
      Spec.map (CommRingCat.ofHom
        (algebraMap (IsLocalRing.ResidueField R)
          (PlaneNode.Ring (algebraMap R (IsLocalRing.ResidueField R) (π^n))))) :=
  Scheme.PowerNode.specializationIso_hom_snd (π^n)

@[reassoc] lemma zeroSpecialFibreIso_inv_snd (π : R) :
    (zeroSpecialFibreIso π).inv ≫ pullback.snd ((zero π).map ≫ base) residueBase =
      Spec.map (CommRingCat.ofHom
        (algebraMap (IsLocalRing.ResidueField R) (PlaneNode.Ring (1 : IsLocalRing.ResidueField
          R)))) := by
  simp only [zeroSpecialFibreIso, Iso.trans_inv, Category.assoc,
    zeroSourceTargetIso_inv_snd, targetSpecialFibreIso_inv_snd,
    nodeParameterIso_inv_base]

@[reassoc] lemma oneSpecialFibreIso_inv_snd (π : R) (hπ : Irreducible π) :
    (oneSpecialFibreIso π hπ).inv ≫ pullback.snd ((one π hπ).map ≫ base) residueBase =
      Spec.map (CommRingCat.ofHom
        (algebraMap (IsLocalRing.ResidueField R) (Cross.ring (IsLocalRing.ResidueField R)))) := by
  simp only [oneSpecialFibreIso, Iso.trans_inv, Category.assoc,
    oneSourceTargetIso_inv_snd, targetSpecialFibreIso_inv_snd,
    nodeParameterIso_inv_base]

/-- Actual end component maps into the same exponent-one fibre. -/
def oneLeftComponent (π : R) (hπ : Irreducible π) :
    Cross.line (IsLocalRing.ResidueField R) ⟶ sourceSpecialFibre (one π hπ) :=
  Cross.left _ ≫ (oneSpecialFibreIso π hπ).inv

/-- The right affine-line component of the exponent-one modification special fibre. -/
def oneRightComponent (π : R) (hπ : Irreducible π) :
    Cross.line (IsLocalRing.ResidueField R) ⟶ sourceSpecialFibre (one π hπ) :=
  Cross.right _ ≫ (oneSpecialFibreIso π hπ).inv

/-- The intersection point of the two components of the exponent-one modification special fibre. -/
def oneNode (π : R) (hπ : Irreducible π) :
    Spec (.of (IsLocalRing.ResidueField R)) ⟶ sourceSpecialFibre (one π hπ) :=
  Cross.origin _ ≫ (oneSpecialFibreIso π hπ).inv

instance oneLeftComponent_closedImmersion (π : R) (hπ : Irreducible π) :
    IsClosedImmersion (oneLeftComponent π hπ) := by
  dsimp [oneLeftComponent]; infer_instance
instance oneRightComponent_closedImmersion (π : R) (hπ : Irreducible π) :
    IsClosedImmersion (oneRightComponent π hπ) := by
  dsimp [oneRightComponent]; infer_instance

@[reassoc] lemma oneLeftComponent_endpoint (π : R) (hπ : Irreducible π) :
    Cross.endpoint _ ≫ oneLeftComponent π hπ = oneNode π hπ := by
  rw [oneLeftComponent, Cross.left_endpoint_assoc, oneNode]
@[reassoc] lemma oneRightComponent_endpoint (π : R) (hπ : Irreducible π) :
    Cross.endpoint _ ≫ oneRightComponent π hπ = oneNode π hπ := by
  rw [oneRightComponent, Cross.right_endpoint_assoc, oneNode]

end AlgebraicGeometry.Scheme.PowerNode.Resolution

end -- noncomputable section
end NodeResolutionSpecialFibres


section NodeCrossComponents

noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open CategoryTheory Limits AlgebraicGeometry Polynomial Topology
open PlaneNode _root_.PowerNode.Rees
universe u
namespace AlgebraicGeometry.Scheme.PowerNode.Resolution.Cross
variable (k : Type u) [Field k]

lemma left_range : Set.range (left k) = {p | PlaneNode.V (0 : k) ∈ p.asIdeal} := by
  change Set.range (PrimeSpectrum.comap (leftHom k).toRingHom) = _
  rw [range_comap_of_surjective _ _ (leftHom_surjective k), leftHom_ker]
  ext p
  simp [leftIdeal, PrimeSpectrum.mem_zeroLocus]
  rfl

lemma right_range : Set.range (right k) = {p | PlaneNode.U (0 : k) ∈ p.asIdeal} := by
  change Set.range (PrimeSpectrum.comap (rightHom k).toRingHom) = _
  rw [range_comap_of_surjective _ _ (rightHom_surjective k), rightHom_ker]
  ext p
  simp [rightIdeal, PrimeSpectrum.mem_zeroLocus]
  rfl

/-- Every point belongs to one of the two actual component images. -/
lemma components_cover (p : scheme k) : p ∈ Set.range (left k) ∨ p ∈ Set.range (right k) := by
  rw [left_range, right_range]
  obtain h | h := p.isPrime.mem_or_mem (show PlaneNode.U (0 : k) * PlaneNode.V (0 : k) ∈ p.asIdeal
    by
    rw [PlaneNode.relation, map_zero]
    exact p.asIdeal.zero_mem)
  · exact Or.inr h
  · exact Or.inl h

lemma left_range_irreducible : IsIrreducible (Set.range (left k)) := by
  simpa only [Set.image_univ] using
    (IrreducibleSpace.isIrreducible_univ (line k)).image (left k) (left k).continuous.continuousOn
lemma right_range_irreducible : IsIrreducible (Set.range (right k)) := by
  simpa only [Set.image_univ] using
    (IrreducibleSpace.isIrreducible_univ (line k)).image (right k) (right k).continuous.continuousOn

lemma left_not_subset_right : ¬ Set.range (left k) ⊆ Set.range (right k) := by
  intro h
  have hm := h (show left k (⟨⊥, inferInstance⟩ : line k) ∈ Set.range (left k) from ⟨_, rfl⟩)
  rw [right_range] at hm
  change leftHom k (PlaneNode.U (0 : k)) ∈ (⊥ : Ideal k[X]) at hm
  simp [leftHom] at hm

lemma right_not_subset_left : ¬ Set.range (right k) ⊆ Set.range (left k) := by
  intro h
  have hm := h (show right k (⟨⊥, inferInstance⟩ : line k) ∈ Set.range (right k) from ⟨_, rfl⟩)
  rw [left_range] at hm
  change rightHom k (PlaneNode.V (0 : k)) ∈ (⊥ : Ideal k[X]) at hm
  simp [rightHom] at hm

lemma irreducible_subset_component {s : Set (scheme k)} (hs : IsIrreducible s) :
    s ⊆ Set.range (left k) ∨ s ⊆ Set.range (right k) :=
  isPreirreducible_iff_isClosed_union_isClosed.mp hs.2 _ _
    (left k).isClosedEmbedding.isClosed_range (right k).isClosedEmbedding.isClosed_range
    (fun p _ => components_cover k p)

lemma left_mem_irreducibleComponents : Set.range (left k) ∈ irreducibleComponents (scheme k) := by
  refine ⟨left_range_irreducible k, ?_⟩
  intro s hs hle
  rcases irreducible_subset_component k hs with h | h
  · exact h
  · exact False.elim (left_not_subset_right k (hle.trans h))
lemma right_mem_irreducibleComponents : Set.range (right k) ∈ irreducibleComponents (scheme k) := by
  refine ⟨right_range_irreducible k, ?_⟩
  intro s hs hle
  rcases irreducible_subset_component k hs with h | h
  · exact False.elim (right_not_subset_left k (hle.trans h))
  · exact h

/-- Exact irreducible-component correspondence, rather than a component-count certificate. -/
theorem irreducibleComponents_eq : irreducibleComponents (scheme k) =
    {Set.range (left k), Set.range (right k)} := by
  ext s
  constructor
  · intro hs
    rcases irreducible_subset_component k hs.1 with h | h
    · exact Or.inl (Set.Subset.antisymm h (hs.2 (left_range_irreducible k) h))
    · exact Or.inr (Set.Subset.antisymm h (hs.2 (right_range_irreducible k) h))
  · rintro (rfl | rfl)
    · exact left_mem_irreducibleComponents k
    · exact right_mem_irreducibleComponents k

end AlgebraicGeometry.Scheme.PowerNode.Resolution.Cross

end -- noncomputable section
end NodeCrossComponents


section NodeCrossIntersection

noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open CategoryTheory Limits AlgebraicGeometry Polynomial
open AlgebraicGeometry.Scheme AlgebraicGeometry.Scheme.Hom
open PlaneNode _root_.PowerNode.Rees
universe u
namespace AlgebraicGeometry.Scheme.PowerNode.Resolution.Cross
variable (k : Type u) [Field k]

/-- The two component quotient maps have pushout k, retaining the actual
origin evaluations. This computes the intersection scheme, including its nilpotents. -/
lemma coordinate_square_isPushout :
    IsPushout (CommRingCat.ofHom (leftHom k).toRingHom)
      (CommRingCat.ofHom (rightHom k).toRingHom)
      (CommRingCat.ofHom (evalRingHom (0 : k)))
      (CommRingCat.ofHom (evalRingHom (0 : k))) := by
  let l := CommRingCat.ofHom (leftHom k).toRingHom
  let r := CommRingCat.ofHom (rightHom k).toRingHom
  let e := CommRingCat.ofHom (evalRingHom (0 : k))
  have hw : l ≫ e = r ≫ e := by
    apply CommRingCat.hom_ext
    have h : (aeval (0 : k)).comp (leftHom k) = (aeval (0 : k)).comp (rightHom k) := by
      apply PlaneNode.hom_ext <;> simp [leftHom, rightHom]
    exact congrArg AlgHom.toRingHom h
  apply IsPushout.of_isColimit (c := PushoutCocone.mk e e hw)
  refine PushoutCocone.IsColimit.mk _
    (fun s => CommRingCat.ofHom (s.inl.hom.comp Polynomial.C)) ?_ ?_ ?_
  · intro s
    apply CommRingCat.hom_ext
    apply Polynomial.ringHom_ext
    · intro a; simp [e]
    · have h := congrArg
        (fun f : CommRingCat.of (ring k) ⟶ s.pt => f.hom (PlaneNode.U (0 : k))) s.condition
      simpa [l, r, e, leftHom, rightHom] using h.symm
  · intro s
    apply CommRingCat.hom_ext
    apply Polynomial.ringHom_ext
    · intro a
      have h := congrArg (fun f : CommRingCat.of (ring k) ⟶ s.pt => f.hom (algebraMap k (ring k)
        a)) s.condition
      simpa [l, r, e] using h
    · have h := congrArg
        (fun f : CommRingCat.of (ring k) ⟶ s.pt => f.hom (PlaneNode.V (0 : k))) s.condition
      simpa [l, r, e, leftHom, rightHom] using h
  · intro s m hm _
    apply CommRingCat.hom_ext
    ext a
    have h := congrArg (fun f : CommRingCat.of k[X] ⟶ s.pt => f.hom (Polynomial.C a)) hm
    simpa [e] using h

/-- The two actual closed affine-line components intersect scheme-theoretically
in precisely Spec k, with the normalized origin on both lines. -/
theorem intersection_isPullback :
    IsPullback (endpoint k) (endpoint k) (left k) (right k) :=
  isPullback_SpecMap_of_isPushout _ _ _ _ (coordinate_square_isPushout k)

/-- An explicit isomorphism from the reduced point to the literal intersection fibre product. -/
def intersectionIso : Spec (.of k) ≅ pullback (left k) (right k) :=
  (intersection_isPullback k).isoPullback

@[reassoc] lemma intersectionIso_hom_fst :
    (intersectionIso k).hom ≫ pullback.fst (left k) (right k) = endpoint k := by
  simp [intersectionIso]
@[reassoc] lemma intersectionIso_hom_snd :
    (intersectionIso k).hom ≫ pullback.snd (left k) (right k) = endpoint k := by
  simp [intersectionIso]

end AlgebraicGeometry.Scheme.PowerNode.Resolution.Cross

end -- noncomputable section
end NodeCrossIntersection


section NodeFibreReduced

noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open CategoryTheory AlgebraicGeometry Polynomial
open PlaneNode _root_.PowerNode.Rees
universe u
namespace AlgebraicGeometry.Scheme.PowerNode.Resolution

/-- The unit node is the actual Laurent affine scheme, not a degenerate chain. -/
def unitNodeLaurentEquiv (k : Type u) [CommRing k] :
    PlaneNode.Ring (1 : k) ≃ₐ[k] Localization.Away (Polynomial.X : k[X]) := by
  have hu : IsUnit (PlaneNode.U (1 : k)) := IsUnit.of_mul_eq_one (PlaneNode.V (1 : k)) (by
    simpa only [map_one] using PlaneNode.relation (1 : k))
  exact ((IsLocalization.atUnit (PlaneNode.Ring (1 : k)) (Localization.Away (PlaneNode.U (1 : k)))
    _ hu).restrictScalars k).trans
    (PlaneNode.Regularity.nodeAwayLaurent (1 : k))

namespace Cross
variable (k : Type u) [Field k]

lemma nodePoly_squarefree : Squarefree (PlaneNode.poly (0 : k)) := by
  have hp : Prime (Polynomial.C (Polynomial.X : k[X])) :=
    Polynomial.prime_C_iff.mpr Polynomial.prime_X
  have hq : Prime (Polynomial.X : k[X][X]) := Polynomial.prime_X
  have hr : IsRelPrime (Polynomial.X : k[X][X]) (Polynomial.C (Polynomial.X : k[X])) :=
    hq.irreducible.isRelPrime_iff_not_dvd.mpr (by simp [Polynomial.X_dvd_iff])
  simpa [PlaneNode.poly] using squarefree_mul_iff.mpr ⟨hr.symm, hp.squarefree, hq.squarefree⟩

instance ring_reduced : _root_.IsReduced (ring k) := by
  apply (Ideal.isRadical_iff_quotient_reduced (I := Ideal.span {PlaneNode.poly (0 : k)})).mp
  exact isRadical_iff_span_singleton.mp (nodePoly_squarefree k).isRadical

instance scheme_reduced : AlgebraicGeometry.IsReduced (scheme k) := inferInstance

end Cross
end AlgebraicGeometry.Scheme.PowerNode.Resolution

end -- noncomputable section
end NodeFibreReduced
