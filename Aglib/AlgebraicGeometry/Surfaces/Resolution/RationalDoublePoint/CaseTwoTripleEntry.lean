module

public import Aglib.AlgebraicGeometry.Surfaces.Resolution.RationalDoublePoint.CaseTwoMarkedStalk
public import Aglib.AlgebraicGeometry.Surfaces.Resolution.RationalDoublePoint.CaseTwoCubic

/-!
# The actual second entry on the original blowup stalk

The aligned triple-entry identity excludes its old parameter chart. On the
other actual chart, the native second-entry theorem produces a full marker.
Its parameter is the ratio of the old two generators; the original centre
is generated by the image of the chart denominator, not by that ratio.
-/

@[expose] public noncomputable section
set_option autoImplicit false

open CategoryTheory IsLocalRing
open Localization.Away Localization.Away.SaturatedChart
open AlgebraicGeometry.Scheme.Blowup AlgebraicGeometry.Scheme.RationalSingularities

universe u

namespace AlgebraicGeometry.Scheme.RationalDoublePoint.CaseTwoTripleEntry

variable {A : Type u} [CommRing A] [IsLocalRing A] [IsDomain A] [IsNoetherianRing A]

omit [IsDomain A] in
private theorem parameter_ne_zero {t u w : maximalIdeal A} (T : TripleEntryData t u w)
    (hd : ringKrullDim A = 2) (hsing : ¬ IsRegularLocalRing A) : (t : A) ≠ 0 := by
  intro ht
  have h := first_not_mem_sq_of_span_triple_of_not_regular A t u w T.generates hd hsing
  rw [ht] at h
  exact h (Ideal.zero_mem _)

variable [IsIntegrallyClosed A] (B : BlowupDatum (affineCenter A (maximalIdeal A)))

/-- An actual continuing Case-II child of a triple-entry stage cannot lie
on its old parameter chart. Its own full kernel is derived in the actual chart triple. -/
theorem not_mem_parameterChart
    (hdA : ringKrullDim A = 2) (hA : IsNagataRing.{u, 0} A)
    (hRat : NormalModificationH1Vanishing A) (hsingA : ¬ IsRegularLocalRing A)
    {t u w : maximalIdeal A} (T : TripleEntryData t u w)
    (x : B.Y) (hx : IsClosed ({x} : Set B.Y)) (hbase : B.map x = closedPoint A)
    (hsing : ¬ IsRegularLocalRing (B.Y.presheaf.stalk x))
    (tC sC zC : maximalIdeal (B.Y.presheaf.stalk x))
    (hgenC : maximalIdeal (B.Y.presheaf.stalk x) = Ideal.span
      ({(tC : B.Y.presheaf.stalk x), (sC : B.Y.presheaf.stalk x),
        (zC : B.Y.presheaf.stalk x)} : Set (B.Y.presheaf.stalk x)))
    (hrankC : Module.finrank
      ((B.Y.presheaf.stalk x) ⧸ maximalIdeal (B.Y.presheaf.stalk x))
      (maximalIdeal (B.Y.presheaf.stalk x)).Cotangent = 3)
    (hkerC : doubleLineChildCotangentKernel (B.Y.presheaf.stalk x) ![sC, zC, tC] =
      Ideal.span {(MvPolynomial.X 1 :
        MvPolynomial (Fin 3) (ResidueField (B.Y.presheaf.stalk x))) ^ 2}) :
    x ∉ Set.range (CaseOneChart.chart B t) := by
  intro hchart
  have ht0 := parameter_ne_zero T hdA hsingA
  let : IsIntegrallyClosed (saturatedChart A (maximalIdeal A) (t : A)) :=
    MaximalIdealBlowup.ordinary_saturatedChart_isIntegrallyClosed A hdA hA hRat t ht0
  obtain ⟨_, _, _, F, _, _, _, _, _, _⟩ := T.exists_fixed_cubic
  let D := T.presentation.reducedChart
  obtain ⟨P, hP, hdata⟩ := CaseTwoPoint.exists_actual_prime_parameter_at_closed_singular_point
    B t u w T.generates T.tangent F x hx hbase hsing hchart
  let : P.IsPrime := hP
  obtain ⟨q, Q, _, hq, hPq, hQ, _, _, hd, hs, ε, _⟩ := hdata
  let C : Type u := B.Y.presheaf.stalk x
  let S := Localization.AtPrime P
  let e : C ≃+* S := ε.commRingCatIsoToRingEquiv
  have hg : maximalIdeal S = Ideal.span
      ({(D.primeTriple Q q hQ P hPq 2 : S), (D.primeTriple Q q hQ P hPq 0 : S),
        (D.primeTriple Q q hQ P hPq 1 : S)} : Set S) :=
    Ideal.localTriple_generates P
      (algebraMap A (saturatedChart A (maximalIdeal A) (t : A)) (t : A)) Q
      (fractionElement (maximalIdeal A) t w) (D.prime_span Q q hQ P hPq)
  obtain ⟨L, hL, hkL⟩ := CaseTwoMarkedStalk.full_square_kernel_in_target_generators
    (R := C) (S := S) e tC sC zC hgenC hrankC hkerC (D.primeTriple Q q hQ P hPq) hg
  exact T.no_continuing_parameter_chart ht0 Q q hQ hq P hPq hd hs L hL hkL

/-- The actual second entry yields a full parent marker or a full marker on
the original child stalk. The ratio parameter, denominator centre and original
structural residue map are retained as distinct data. -/
theorem marker_or_next_marker_at_closed_point
    (hdA : ringKrullDim A = 2) (hA : IsNagataRing.{u, 0} A)
    (hRat : NormalModificationH1Vanishing A) (hsingA : ¬ IsRegularLocalRing A)
    {t u w : maximalIdeal A} (T : TripleEntryData t u w)
    (x : B.Y) (hx : IsClosed ({x} : Set B.Y)) (hbase : B.map x = closedPoint A)
    (hsing : ¬ IsRegularLocalRing (B.Y.presheaf.stalk x))
    (tC sC zC : maximalIdeal (B.Y.presheaf.stalk x))
    (hgenC : maximalIdeal (B.Y.presheaf.stalk x) = Ideal.span
      ({(tC : B.Y.presheaf.stalk x), (sC : B.Y.presheaf.stalk x),
        (zC : B.Y.presheaf.stalk x)} : Set (B.Y.presheaf.stalk x)))
    (hrankC : Module.finrank
      ((B.Y.presheaf.stalk x) ⧸ maximalIdeal (B.Y.presheaf.stalk x))
      (maximalIdeal (B.Y.presheaf.stalk x)).Cotangent = 3)
    (hkerC : doubleLineChildCotangentKernel (B.Y.presheaf.stalk x) ![sC, zC, tC] =
      Ideal.span {(MvPolynomial.X 1 :
        MvPolynomial (Fin 3) (ResidueField (B.Y.presheaf.stalk x))) ^ 2}) :
    letI := B.map.stalkScalar_isLocalHom_of_closedPoint x hbase
    (∃ r : maximalIdeal A, ∃ M : MarkedCubic r, M.other = t ∧ M.square = w) ∨
      (∃ r : maximalIdeal (B.Y.presheaf.stalk x), ∃ N : MarkedCubic r,
        B.map.stalkScalar x (t : A) = B.map.stalkScalar x (u : A) * r ∧
        (N.other : B.Y.presheaf.stalk x) = B.map.stalkScalar x (u : A) ∧
        B.map.stalkScalar x (w : A) = B.map.stalkScalar x (u : A) * N.square ∧
        IsLocalRing.residue (B.Y.presheaf.stalk x) N.relation.coefficients.a2 =
          IsLocalRing.residue (B.Y.presheaf.stalk x) (B.map.stalkScalar x T.coefficient) ∧
        (r : B.Y.presheaf.stalk x) ∉ maximalIdeal (B.Y.presheaf.stalk x) ^ 2 ∧
        (maximalIdeal A).map (B.map.stalkScalar x) =
          Ideal.span {B.map.stalkScalar x (u : A)} ∧
        Function.Bijective (ResidueField.map (B.map.stalkScalar x))) := by
  let C : Type u := B.Y.presheaf.stalk x
  let f : A →+* C := B.map.stalkScalar x
  let : IsLocalHom f := B.map.stalkScalar_isLocalHom_of_closedPoint x hbase
  have hchart : x ∈ Set.range (CaseOneChart.chart B u) := by
    rcases CaseTwoPoint.mem_planeChart_or_opposite_of_closed_exceptional_point
      B t u w T.generates T.tangent x hx hbase with ht | hu
    · exact False.elim (not_mem_parameterChart B hdA hA hRat hsingA T
        x hx hbase hsing tC sC zC hgenC hrankC hkerC ht)
    · exact hu
  have ht0 := parameter_ne_zero T hdA hsingA
  let : IsIntegrallyClosed (saturatedChart A (maximalIdeal A) (t : A)) :=
    MaximalIdealBlowup.ordinary_saturatedChart_isIntegrallyClosed A hdA hA hRat t ht0
  obtain ⟨_, _, _, F, _, _, _, _, _, _⟩ := T.exists_fixed_cubic
  have hgen : maximalIdeal A = Ideal.span ({(u : A), (t : A), (w : A)} : Set A) := by
    simpa only [Set.insert_comm] using T.generates
  have hker : doubleLineChildCotangentKernel A ![t, w, u] =
      Ideal.span {(MvPolynomial.X 1 : MvPolynomial (Fin 3) (ResidueField A)) ^ 2} := by
    have h := cotangentKernel_planeChange ![u, w, t] 0 1 1 0 (by simp) T.tangent
    simpa only [planeChangeTriple_triple, zero_smul, one_smul, zero_add, add_zero] using h
  let D := (DoubleLinePresentation.ofKernel u t w hgen hker).reducedChart
  obtain ⟨P, hP, hdata⟩ := CaseTwoPoint.exists_actual_prime_parameter_at_closed_singular_point
    B u t w hgen hker F.swap x hx hbase hsing hchart
  let : P.IsPrime := hP
  obtain ⟨q, Q, hm, hq, hPq, hQ, _, _, hd, hs, ε, hε⟩ := hdata
  let S := Localization.AtPrime P
  let c : A →+* S := localizedChartMap (maximalIdeal A) (u : A) P
  let e : C ≃+* S := ε.commRingCatIsoToRingEquiv
  have he : e.toRingHom.comp f = c := hε
  have hg : maximalIdeal S = Ideal.span
      ({(D.primeTriple Q q hQ P hPq 2 : S), (D.primeTriple Q q hQ P hPq 0 : S),
        (D.primeTriple Q q hQ P hPq 1 : S)} : Set S) :=
    Ideal.localTriple_generates P
      (algebraMap A (saturatedChart A (maximalIdeal A) (u : A)) (u : A)) Q
      (fractionElement (maximalIdeal A) u w) (D.prime_span Q q hQ P hPq)
  obtain ⟨L, hL, hkL⟩ := CaseTwoMarkedStalk.full_square_kernel_in_target_generators
    (R := C) (S := S) e tC sC zC hgenC hrankC hkerC (D.primeTriple Q q hQ P hPq) hg
  rcases triple_entry_next T ht0 D Q q hQ hq hm P hPq hd hs L hL hkL with
    hmarker | ⟨_, hP0, hN0, _, hlocal, hres⟩
  · exact Or.inl hmarker
  right
  obtain ⟨N0, hother, hsquare, hcoef⟩ := hN0
  let : IsLocalHom c := hlocal
  let : IsNoetherianRing S := IsLocalization.isNoetherianRing P.primeCompl S
    (saturatedChart_isNoetherian (maximalIdeal A) (u : A))
  let : IsNoetherianRing C := isNoetherianRing_of_ringEquiv S (S := C) e.symm
  have hdC : ringKrullDim C = 2 :=
    (ringKrullDim_eq_of_ringEquiv (R := C) (S := S) e).trans hd
  let r : maximalIdeal C :=
    maximalIdealEquivMap (A := S) (B := C) e.symm (D.centeredTriple P hP0 0)
  let N : MarkedCubic r := N0.map (A := S) (B := C) e.symm
  have hminu : c (u : A) ∉ maximalIdeal S ^ 2 :=
    first_not_mem_sq_of_span_triple_of_not_regular S
      (D.primeTriple Q q hQ P hPq 2) (D.primeTriple Q q hQ P hPq 0)
      (D.primeTriple Q q hQ P hPq 1) hg hd hs
  have hcenteru : (maximalIdeal A).map c = Ideal.span {c (u : A)} :=
    localizedChartMap_center (maximalIdeal A) (u : A) u.property P
  have htransport := parameter_properties_of_equiv_comp
    (A := A) (R := C) (S := S) f c e he (u : A) (e.symm (c (u : A)))
      (e.apply_symm_apply _)
  have htransport_min := htransport hminu
  have htransport_center := htransport_min hcenteru
  obtain ⟨huval, _, hcenter, hres'⟩ := htransport_center hres
  have heval (a : A) : e.symm.toRingHom (c a) = f a :=
    e.symm_apply_eq.mpr (RingHom.congr_fun he a).symm
  refine ⟨r, N, ?_, ?_, ?_, ?_, ?_, ?_, hres'⟩
  · have h := congrArg (algebraMap (saturatedChart A (maximalIdeal A) (u : A)) S)
      (fractionElement_mul (maximalIdeal A) u t)
    have h' := congrArg e.symm.toRingHom h
    simp only [map_mul] at h'
    change e.symm.toRingHom (c (u : A)) * (r : C) =
      e.symm.toRingHom (c (t : A)) at h'
    rw [heval, heval] at h'
    exact h'.symm
  · change e.symm (N0.other : S) = f (u : A)
    rw [hother]
    exact huval
  · have h := congrArg (algebraMap (saturatedChart A (maximalIdeal A) (u : A)) S)
      (fractionElement_mul (maximalIdeal A) u w)
    have h' := congrArg e.symm.toRingHom h
    simp only [map_mul] at h'
    change e.symm.toRingHom (c (u : A)) *
      e.symm.toRingHom (D.centeredTriple P hP0 1 : S) =
        e.symm.toRingHom (c (w : A)) at h'
    rw [heval, heval] at h'
    change f (w : A) = f (u : A) * e.symm (N0.square : S)
    rw [hsquare]
    exact h'.symm
  · apply (ResidueField.mapEquiv (R := C) (S := S) e).injective
    change IsLocalRing.residue S (e (e.symm N0.relation.coefficients.a2)) =
      IsLocalRing.residue S (e (f T.coefficient))
    rw [e.apply_symm_apply]
    exact hcoef.trans (congrArg (IsLocalRing.residue S)
      (RingHom.congr_fun he T.coefficient).symm)
  · exact first_not_mem_sq_of_span_triple_of_not_regular C
      r N.other N.square N.generates hdC hsing
  · simpa only [huval] using hcenter

end AlgebraicGeometry.Scheme.RationalDoublePoint.CaseTwoTripleEntry
