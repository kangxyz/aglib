module

public import Aglib.RingTheory.GradedAlgebra.Quotient
public import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Proper
public import Mathlib.AlgebraicGeometry.EllipticCurve.Projective.Basic
public import Mathlib.RingTheory.MvPolynomial.Homogeneous

/-!
# The literal projective Weierstrass cubic

Source: ordinary R5 Weierstrass.Projective, lines 182–337.
The cubic, quotient ring, Proj, chart maps and infinity section are literal.
Properness holds over every commutative base ring.
-/

@[expose] public section

noncomputable section
set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open CategoryTheory AlgebraicGeometry MvPolynomial
namespace WeierstrassCurve.Projective
universe u
variable {k : Type u} [CommRing k]
attribute [local instance] MvPolynomial.gradedAlgebra

/-- The total-degree grading on three-coordinate polynomials. -/
abbrev polynomialGrading (k : Type u) [CommRing k] := homogeneousSubmodule (Fin 3) k

lemma cubic_homogeneous (W : WeierstrassCurve k) :
    W.toProjective.polynomial ∈ polynomialGrading k 3 := by
  change W.toProjective.polynomial.IsHomogeneous 3
  unfold WeierstrassCurve.Projective.polynomial
  exact (((isHomogeneous_X_pow 1 2).mul (isHomogeneous_X k 2)).add
    (((isHomogeneous_C_mul_X W.a₁ 0).mul (isHomogeneous_X k 1)).mul
      (isHomogeneous_X k 2))).add
    ((isHomogeneous_C_mul_X W.a₃ 1).mul (isHomogeneous_X_pow 2 2)) |>.sub
    ((((isHomogeneous_X_pow 0 3).add
      ((isHomogeneous_C_mul_X_pow W.a₂ 0 2).mul (isHomogeneous_X k 2))).add
      ((isHomogeneous_C_mul_X W.a₄ 0).mul (isHomogeneous_X_pow 2 2))).add
      (isHomogeneous_C_mul_X_pow W.a₆ 2 3))

/-- The principal ideal generated by the homogeneous Weierstrass cubic. -/
def cubicIdeal (W : WeierstrassCurve k) : Ideal (MvPolynomial (Fin 3) k) :=
  Ideal.span {W.toProjective.polynomial}

lemma cubicIdeal_homogeneous (W : WeierstrassCurve k) :
    (cubicIdeal W).IsHomogeneous (polynomialGrading k) := by
  apply Ideal.homogeneous_span
  intro p hp
  rcases Set.mem_singleton_iff.mp hp with rfl
  exact ⟨3, cubic_homogeneous W⟩

/-- The homogeneous coordinate ring of the projective Weierstrass cubic. -/
abbrev homogeneousCoordinateRing (W : WeierstrassCurve k) :=
  MvPolynomial (Fin 3) k ⧸ cubicIdeal W
/-- The quotient grading on the homogeneous coordinate ring. -/
abbrev grading (W : WeierstrassCurve k) :=
  GradedAlgebra.Quotient.grading (polynomialGrading k) (cubicIdeal W)
instance quotientGradedAlgebra (W : WeierstrassCurve k) : GradedAlgebra (grading W) :=
  GradedAlgebra.Quotient.gradedAlgebra _ _ (cubicIdeal_homogeneous W)

/-- The literal projective closed cubic, not an abstract elliptic-curve candidate. -/
abbrev scheme (W : WeierstrassCurve k) : Scheme := Proj (grading W)
/-- The class of a projective coordinate in the homogeneous coordinate ring. -/
def coordinate (W : WeierstrassCurve k) (i : Fin 3) : homogeneousCoordinateRing W :=
  Ideal.Quotient.mk _ (X i)
lemma coordinate_mem (W : WeierstrassCurve k) (i : Fin 3) : coordinate W i ∈ grading W 1 :=
  Submodule.mem_map.mpr ⟨X i, isHomogeneous_X k i, rfl⟩

/-- Evaluation at the standard infinity representative, already factoring the cubic. -/
def infinityEval (W : WeierstrassCurve k) : homogeneousCoordinateRing W →+* k :=
  Ideal.Quotient.lift _ (eval ![0, 1, 0]) (by
    change cubicIdeal W ≤ RingHom.ker (eval ![0, 1, 0])
    apply Ideal.span_le.mpr
    intro p hp
    rcases Set.mem_singleton_iff.mp hp with rfl
    simp [RingHom.mem_ker, WeierstrassCurve.Projective.polynomial])

@[simp] lemma infinityEval_coordinate (W : WeierstrassCurve k) (i : Fin 3) :
    infinityEval W (coordinate W i) = ![0, 1, 0] i := by
  simp [infinityEval, coordinate]
@[simp] lemma infinityEval_constant (W : WeierstrassCurve k) (a : k) :
    infinityEval W (algebraMap k (homogeneousCoordinateRing W) a) = a := by
  change infinityEval W (Ideal.Quotient.mk _ (C a)) = a
  simp [infinityEval]

instance scalarTower (W : WeierstrassCurve k) :
    IsScalarTower k (grading W 0) (homogeneousCoordinateRing W) :=
  IsScalarTower.of_algebraMap_eq (R := k) (S := grading W 0)
    (A := homogeneousCoordinateRing W) fun _ => rfl
instance finiteTypeGradeZero (W : WeierstrassCurve k) :
    Algebra.FiniteType (grading W 0) (homogeneousCoordinateRing W) :=
  Algebra.FiniteType.of_restrictScalars_finiteType k _ _

/-- The homomorphism sending base-ring constants to the degree-zero component. -/
def constToGradeZero (W : WeierstrassCurve k) : k →+* grading W 0 :=
  algebraMap k (grading W 0)
lemma constToGradeZero_bijective (W : WeierstrassCurve k) :
    Function.Bijective (constToGradeZero W) := by
  constructor
  · intro a b hab
    have hab' := congrArg (fun t : grading W 0 => infinityEval W t.val) hab
    change infinityEval W (algebraMap k (homogeneousCoordinateRing W) a) =
      infinityEval W (algebraMap k (homogeneousCoordinateRing W) b) at hab'
    simpa only [infinityEval_constant] using hab'
  · intro a
    obtain ⟨p, hp, hpa⟩ := Submodule.mem_map.mp a.property
    have hp' : C (p.coeff 0) = p :=
      (MvPolynomial.totalDegree_eq_zero_iff_eq_C.mp
        ((MvPolynomial.totalDegree_zero_iff_isHomogeneous (Fin 3)).mpr hp)).symm
    refine ⟨p.coeff 0, Subtype.ext ?_⟩
    change Ideal.Quotient.mk _ (C (p.coeff 0)) = a.val
    rw [hp']
    exact hpa

/-- The canonical identification of the base ring with the degree-zero component. -/
def gradeZeroIso (W : WeierstrassCurve k) : k ≃+* grading W 0 :=
  RingEquiv.ofBijective (constToGradeZero W) (constToGradeZero_bijective W)
/-- The structural morphism of the projective cubic to the spectrum of its base ring. -/
def structureMap (W : WeierstrassCurve k) : scheme W ⟶ Spec (.of k) :=
  Proj.toSpecZero (grading W) ≫ Spec.map (CommRingCat.ofHom (constToGradeZero W))
instance structureMap_proper (W : WeierstrassCurve k) : IsProper (structureMap W) := by
  have : IsIso (Spec.map (CommRingCat.ofHom (constToGradeZero W))) := by
    change IsIso (Scheme.Spec.mapIso (gradeZeroIso W).toCommRingCatIso.op).hom
    infer_instance
  unfold structureMap
  infer_instance

/-- The projective Weierstrass cubic as a scheme over its base ring. -/
abbrev curveOver (W : WeierstrassCurve k) : Over (Spec (.of k)) := Over.mk (structureMap W)
/-- The degree-zero localization defining the chart where coordinate `i` is invertible. -/
abbrev chartRing (W : WeierstrassCurve k) (i : Fin 3) :=
  HomogeneousLocalization.Away (grading W) (coordinate W i)
/-- The canonical open immersion of a standard affine chart into the projective cubic. -/
def chart (W : WeierstrassCurve k) (i : Fin 3) :
    Spec (.of (chartRing W i)) ⟶ scheme W :=
  Proj.awayι (grading W) (coordinate W i) (coordinate_mem W i) (by decide)
instance chart_open (W : WeierstrassCurve k) (i : Fin 3) : IsOpenImmersion (chart W i) :=
  inferInstanceAs (IsOpenImmersion (Proj.awayι _ _ _ _))
lemma chart_range (W : WeierstrassCurve k) (i : Fin 3) :
    (chart W i).opensRange = Proj.basicOpen (grading W) (coordinate W i) :=
  Proj.opensRange_awayι _ _ _ _

/-- Evaluation at `(0:1:0)` on the chart where the second coordinate is invertible. -/
def infinityChartEval (W : WeierstrassCurve k) : chartRing W 1 →+* k :=
  (Localization.awayLift (infinityEval W) (coordinate W 1) (by simp)).comp
    (algebraMap (chartRing W 1) (Localization.Away (coordinate W 1)))
/-- The section of the projective cubic represented by `(0:1:0)`. -/
def infinitySection (W : WeierstrassCurve k) : Spec (.of k) ⟶ scheme W :=
  Spec.map (CommRingCat.ofHom (infinityChartEval W)) ≫ chart W 1

lemma infinityChartEval_mk (W : WeierstrassCurve k) (n : ℕ)
    (a : homogeneousCoordinateRing W) (ha : a ∈ grading W (n • 1)) :
    infinityChartEval W (HomogeneousLocalization.Away.mk (grading W)
      (coordinate_mem W 1) n a ha) = infinityEval W a := by
  simpa only [infinityChartEval, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply,
    HomogeneousLocalization.Away.val_mk, infinityEval_coordinate,
    Matrix.cons_val_one, Matrix.head_cons, one_pow, mul_one] using
    Localization.awayLift_mk (infinityEval W) (coordinate W 1) a 1 (by simp) n

lemma infinityChartEval_constant (W : WeierstrassCurve k) (r : k) :
    infinityChartEval W (HomogeneousLocalization.fromZeroRingHom (grading W)
      (Submonoid.powers (coordinate W 1)) (constToGradeZero W r)) = r := by
  change infinityChartEval W (HomogeneousLocalization.Away.mk (grading W)
    (coordinate_mem W 1) 0 (algebraMap k (homogeneousCoordinateRing W) r) _) = r
  rw [infinityChartEval_mk, infinityEval_constant]

@[reassoc] lemma infinitySection_structure (W : WeierstrassCurve k) :
    infinitySection W ≫ structureMap W = 𝟙 _ := by
  rw [infinitySection, chart, structureMap, Category.assoc,
    ← Category.assoc _ (Proj.toSpecZero _), Proj.awayι_toSpecZero,
    ← Spec.map_comp, ← Spec.map_comp]
  rw [← Spec.map_id]
  congr 1
  apply CommRingCat.hom_ext
  apply RingHom.ext
  intro r
  exact infinityChartEval_constant W r


end WeierstrassCurve.Projective
