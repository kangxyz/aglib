module

public import Aglib.AlgebraicGeometry.Stalk.PrincipalBaseChange
public import Aglib.AlgebraicGeometry.Morphisms.Smooth.Regularity
public import Mathlib.RingTheory.DiscreteValuationRing.Basic

/-! # The original uniformizer on smooth DVR stalks

The actual special-fibre projection has principal stalk kernel generated by
the original structural uniformizer. Its surjective stalk map identifies that
quotient with the original smooth-fibre stalk. Flatness preserves regularity
of the parameter; smoothness of the actual fibre proves regularity of its
quotient. No substitute fibre or local-ring realization is introduced.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.Scheme.Hom

universe u

/-- The original structural uniformizer is a regular parameter with regular
quotient at every point of the actual smooth special fibre. -/
theorem smoothDVR_stalk_regularParameter
    {R : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    {X : Scheme.{u}} (p : X ⟶ Spec (.of R)) [Smooth p]
    (t : R) (ht : Irreducible t)
    (y : (pullback p (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) : Scheme.{u})) :
    let x := pullback.fst p (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) y
    p.stalkScalar x t ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x) ∧
      IsSMulRegular (X.presheaf.stalk x) (p.stalkScalar x t) ∧
      IsRegularLocalRing ((X.presheaf.stalk x) ⧸ Ideal.span {p.stalkScalar x t}) := by
  let r := Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))
  let F : Scheme.{u} := pullback p r
  let b : F ⟶ X := pullback.fst p r
  let c : F ⟶ Spec (.of (IsLocalRing.ResidueField R)) := pullback.snd p r
  let : IsClosedImmersion r :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  let : IsRegularLocalRing (F.presheaf.stalk y) :=
    Scheme.smoothFieldRegularity (IsLocalRing.ResidueField R) F c inferInstance y
  have hbase : RingHom.ker (IsLocalRing.residue R) = Ideal.span {t} := by
    rw [IsLocalRing.ker_residue, ht.maximalIdeal_eq]
  have hker : RingHom.ker (b.stalkMap y).hom = Ideal.span {p.stalkScalar (b y) t} :=
    ker_stalkMap_pullback_fst_of_principal (IsLocalRing.residue R)
      IsLocalRing.residue_surjective t hbase p y
  have hzero : (b.stalkMap y).hom (p.stalkScalar (b y) t) = 0 := by
    change p.stalkScalar (b y) t ∈ RingHom.ker (b.stalkMap y).hom
    rw [hker]
    exact Ideal.subset_span (Set.mem_singleton _)
  have hmem : p.stalkScalar (b y) t ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk (b y)) := by
    change ¬ IsUnit (p.stalkScalar (b y) t)
    intro hu
    have hu' := hu.map (b.stalkMap y).hom
    rw [hzero] at hu'
    exact not_isUnit_zero hu'
  have hregular : IsSMulRegular (X.presheaf.stalk (b y)) (p.stalkScalar (b y) t) :=
    (isRegular_iff_mem_nonZeroDivisors.mpr
      (p.stalkScalar_mem_nonZeroDivisors (b y)
        (mem_nonZeroDivisors_iff_ne_zero.mpr ht.ne_zero))).left.isSMulRegular
  have hquot :
      IsRegularLocalRing ((X.presheaf.stalk (b y)) ⧸ Ideal.span {p.stalkScalar (b y) t}) := by
    rw [← hker]
    exact IsRegularLocalRing.of_ringEquiv
      ((b.stalkMap y).hom.quotientKerEquivOfSurjective (b.stalkMap_surjective y)).symm
  exact ⟨hmem, hregular, hquot⟩

end AlgebraicGeometry.Scheme.Hom
