module

public import Aglib.AlgebraicGeometry.Modules.IdealPowers.IdealSheaf
public import Aglib.AlgebraicGeometry.Modules.IdealPowers.ThickeningTransitions
public import Aglib.AlgebraicGeometry.Modules.Invertible.Basic
public import Aglib.AlgebraicGeometry.Modules.ClosedImmersion.Stalk
public import Mathlib.CategoryTheory.Functor.OfSequence

/-! # Actual compatible line bundles on the original ideal thickenings -/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite
open scoped ZeroObject

namespace AlgebraicGeometry.Scheme.Modules.Invertible

universe u

variable {R : Type u} [CommRing R] {X : Scheme.{u}}
  (f : X ⟶ Spec (CommRingCat.of R)) (I : Ideal R)

/-- Actual positive-level line bundles, compatible along the original
successor morphisms between the actual ideal-power thickenings. -/
structure CompatibleLineBundleSystem where
  /-- The actual line bundle on the original thickening by `I ^ (n + 1)`. -/
  bundle : ∀ n : ℕ, LineBundle (idealThickeningSpace f (I ^ (n + 1)))
  /-- The actual pullback isomorphism along the original successor thickening map. -/
  successorIso : ∀ n : ℕ,
    (pullback (idealThickeningMap f
      (Ideal.pow_le_pow_right (Nat.le_succ (n + 1))))).obj (bundle (n + 1)).val ≅
      (bundle n).val

namespace CompatibleLineBundleSystem

variable {f I} (S : CompatibleLineBundleSystem f I)

section CoefficientMap

variable {Y : Scheme.{u}} (i : Y ⟶ X) (M : X.Modules) (N : Y.Modules)
  (g : (pullback i).obj M ⟶ N)

/-- The original unit with an actual coefficient morphism, kept behind one
regular definition before specializing to the concrete thickenings. -/
def adjointCoefficientMap : M ⟶ (pushforward i).obj N :=
  (pullbackPushforwardAdjunction i).unit.app M ≫ (pushforward i).map g

theorem adjointCoefficientMap_eq_unit :
    adjointCoefficientMap i M N g =
      (pullbackPushforwardAdjunction i).unit.app M ≫ (pushforward i).map g := rfl

end CoefficientMap

/-- The actual closed pushforward of a positive-stage line bundle. -/
abbrev positiveTerm (n : ℕ) : X.Modules :=
  (pushforward (idealThickeningι f (I ^ (n + 1)))).obj (S.bundle n).val

/-- The original closed-immersion counit identifies a positive term on
its actual thickening with the given line bundle. -/
def positiveStageIso (n : ℕ) :
    (pullback (idealThickeningι f (I ^ (n + 1)))).obj (S.positiveTerm n) ≅
      (S.bundle n).val := by
  letI := pullbackPushforwardCounit_isIso_of_closedImmersion
    (idealThickeningι f (I ^ (n + 1))) (S.bundle n).val
  exact asIso ((pullbackPushforwardAdjunction
    (idealThickeningι f (I ^ (n + 1)))).counit.app (S.bundle n).val)

/-- The original composition comparison and counit reduce the next
pushed line bundle to the supplied previous line bundle. -/
def successorCoefficientIso (n : ℕ) :
    (pullback (idealThickeningι f (I ^ (n + 1)))).obj (S.positiveTerm (n + 1)) ≅
      (S.bundle n).val :=
  ((pullbackComp (idealThickeningMap f
      (Ideal.pow_le_pow_right (Nat.le_succ (n + 1))))
    (idealThickeningι f (I ^ (n + 2)))).app (S.positiveTerm (n + 1)) ≪≫
    (pullbackCongr (idealThickeningMap_ι f
      (Ideal.pow_le_pow_right (Nat.le_succ (n + 1))))).app
        (S.positiveTerm (n + 1))).symm ≪≫
    (pullback (idealThickeningMap f
      (Ideal.pow_le_pow_right (Nat.le_succ (n + 1))))).mapIso
        (S.positiveStageIso (n + 1)) ≪≫ S.successorIso n

/-- The positive-stage transition is the original geometric quotient unit,
followed by the actual successor coefficient comparison. -/
def positiveTransition (n : ℕ) : S.positiveTerm (n + 1) ⟶ S.positiveTerm n :=
  adjointCoefficientMap (idealThickeningι f (I ^ (n + 1)))
    (S.positiveTerm (n + 1)) (S.bundle n).val (S.successorCoefficientIso n).hom

/-- Index zero is the actual zero module sheaf. -/
def term : ℕ → X.Modules
  | 0 => 0
  | n + 1 => S.positiveTerm n

/-- The original positive transitions, extended by the zero-stage map. -/
def successorTransition : ∀ n : ℕ, S.term (n + 1) ⟶ S.term n
  | 0 => 0
  | n + 1 => S.positiveTransition n

/-- The native inverse diagram generated by the original successor maps. -/
def diagram : ℕᵒᵖ ⥤ X.Modules :=
  Functor.ofOpSequence S.successorTransition

@[simp]
theorem diagram_obj_zero : S.diagram.obj (op 0) = 0 := rfl

@[simp]
theorem diagram_obj_succ (n : ℕ) :
    S.diagram.obj (op (n + 1)) = S.positiveTerm n := rfl

@[simp]
theorem diagram_map_succ (n : ℕ) :
    S.diagram.map (homOfLE (Nat.le_succ n)).op = S.successorTransition n :=
  Functor.ofOpSequence_map_homOfLE_succ S.successorTransition n

end CompatibleLineBundleSystem

end AlgebraicGeometry.Scheme.Modules.Invertible
