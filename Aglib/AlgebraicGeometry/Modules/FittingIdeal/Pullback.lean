module

public import Aglib.AlgebraicGeometry.Modules.FittingIdeal.Basic
public import Aglib.AlgebraicGeometry.IdealSheaf.LocallyClosed
public import Aglib.AlgebraicGeometry.Modules.QuasiCoherent.Affine.Pullback
public import Aglib.AlgebraicGeometry.Modules.QuasiCoherent.Affine.PullbackSections
public import Aglib.AlgebraicGeometry.Modules.QuasiCoherent.FiniteType.Sections

/-!
# Pullback of Fitting ideal sheaves

For a morphism `g : T ⟶ S` and a quasi-coherent `𝒪_S`-module `F` of finite type whose pullback
`g^* F` is again of finite type, `(Fitt_k F).comap g = Fitt_k (g^* F)`
(`Scheme.Modules.fittingIdealSheaf_comap`). This is the sheaf form of the base change of Fitting
ideals, Stacks Project, Tag 07ZA (3), and the base change statement of Stacks, Tag 0C3D
(Lemma 31.9.1: `Fitt_k(f^* F) = f^{-1} Fitt_k(F) · 𝒪_T`).

On affine opens `V ⊆ g ⁻¹ U`, the sections of `g^* F` on `V` are the base change of the sections of
`F` on `U` along `g.appLE U V` (`affinePullbackGlobalSectionsIso`, through the affine charts
`Spec Γ(T, V) ⟶ T` and `Spec Γ(S, U) ⟶ S` and the commuting square
`IsAffineOpen.SpecMap_appLE_fromSpec`), and the pulled-back ideal sheaf on `V` is generated by the
image of the ideal on `U` (`IdealSheafData.ideal_comap_eq_map_appLE`).

The finite-type hypothesis `hgF` on `g^* F` is a separate argument. Mathematically it always
holds: the pullback of a quasi-coherent sheaf of finite type is of finite type. Aglib does not yet
supply that theorem, so `hgF` stands in for it; it is not a mathematical condition. It is
available when `F` is of finite presentation
(`QuasiCoherent.affineLocallyFiniteType_pullback_of_finitePresentation`) or when `S` is locally
Noetherian (`QuasiCoherent.affineLocallyFiniteType_pullback`).
-/

@[expose] public section

noncomputable section

universe u

open CategoryTheory Opposite TopologicalSpace
open scoped TensorProduct

namespace AlgebraicGeometry.Scheme.Modules

variable {S T : Scheme.{u}} (g : T ⟶ S) (F : S.Modules)

/-- Fitting ideals of the sections of a pullback: for affine opens `U` of `S` and `V` of `T` with
`V ≤ g ⁻¹ᵁ U`, `Fitt_k(Γ(g^* F, V))` is generated by the image of `Fitt_k(Γ(F, U))` under
`g.appLE U V`. -/
theorem fittingIdeal_sections_pullback (hF : QuasiCoherent.affineLocallyFiniteType S F)
    (U : S.affineOpens) (V : T.affineOpens) (h : V.1 ≤ g ⁻¹ᵁ U.1) (k : ℕ) :
    Module.fittingIdeal Γ(T, V) Γ((pullback g).obj F, V) k =
      (Module.fittingIdeal Γ(S, U) Γ(F, U) k).map (g.appLE U V h).hom := by
  have hU : IsAffineOpen U.1 := U.2
  have hV : IsAffineOpen V.1 := V.2
  have : (F.restrict hU.fromSpec).IsQuasicoherent := (hF Γ(S, U) hU.fromSpec).1
  have : Module.Finite Γ(S, U) (moduleSpecΓFunctor.obj (F.restrict hU.fromSpec)) :=
    (hF Γ(S, U) hU.fromSpec).2
  have hsq : hV.fromSpec ≫ g = Spec.map (g.appLE U V h) ≫ hU.fromSpec :=
    (IsAffineOpen.SpecMap_appLE_fromSpec g hU hV h).symm
  let e₁ := QuasiCoherent.AffineOpenSections.toSpecTopSectionsLinearEquiv ((pullback g).obj F) hV
  let e₂ := (moduleSpecΓFunctor.mapIso
    ((pullbackOpenSquare hV.fromSpec (Spec.map (g.appLE U V h)) g hU.fromSpec hsq).app
      F)).toLinearEquiv
  let e₃ := (affinePullbackGlobalSectionsIso (g.appLE U V h) (F.restrict hU.fromSpec)).toLinearEquiv
  let e₄ := QuasiCoherent.AffineOpenSections.toSpecTopSectionsLinearEquiv F hU
  calc Module.fittingIdeal Γ(T, V) Γ((pullback g).obj F, V) k
      = Module.fittingIdeal Γ(T, V)
          (moduleSpecΓFunctor.obj (((pullback g).obj F).restrict hV.fromSpec)) k :=
        Module.fittingIdeal_congr e₁ k
    _ = Module.fittingIdeal Γ(T, V) (moduleSpecΓFunctor.obj
          ((pullback (Spec.map (g.appLE U V h))).obj (F.restrict hU.fromSpec))) k :=
        Module.fittingIdeal_congr e₂ k
    _ = Module.fittingIdeal Γ(T, V) ((ModuleCat.extendScalars (g.appLE U V h).hom).obj
          (moduleSpecΓFunctor.obj (F.restrict hU.fromSpec))) k :=
        (Module.fittingIdeal_congr e₃ k).symm
    _ = (Module.fittingIdeal Γ(S, U) (moduleSpecΓFunctor.obj (F.restrict hU.fromSpec)) k).map
          (g.appLE U V h).hom :=
        Module.fittingIdeal_extendScalars _ _ k
    _ = (Module.fittingIdeal Γ(S, U) Γ(F, U) k).map (g.appLE U V h).hom :=
        congrArg (fun I => I.map (g.appLE U V h).hom) (Module.fittingIdeal_congr e₄ k).symm

/-- **Pullback of Fitting ideal sheaves** (Stacks Project, Tags 07ZA (3) and 0C3D): for
`g : T ⟶ S` and a quasi-coherent sheaf of finite type `F` whose pullback is of finite type,
`(Fitt_k F).comap g = Fitt_k (g^* F)`. -/
theorem fittingIdealSheaf_comap (hF : QuasiCoherent.affineLocallyFiniteType S F)
    (hgF : QuasiCoherent.affineLocallyFiniteType T ((pullback g).obj F)) (k : ℕ) :
    (fittingIdealSheaf F hF k).comap g = fittingIdealSheaf ((pullback g).obj F) hgF k := by
  refine IdealSheafData.ext_of_iSup_eq_top _ (IdealSheafData.iSup_affineOpens_le_preimage_eq_top g)
    fun p => ?_
  rw [IdealSheafData.ideal_comap_eq_map_appLE _ g p.1.1 p.1.2 p.2, ideal_fittingIdealSheaf,
    ideal_fittingIdealSheaf]
  exact (fittingIdeal_sections_pullback g F hF p.1.1 p.1.2 p.2 k).symm

end AlgebraicGeometry.Scheme.Modules
