module

public import Aglib.AlgebraicGeometry.Modules.StructureSheaf.Hom
public import Aglib.AlgebraicGeometry.Modules.Tensor.Monoidal.Basic
public import Aglib.CategoryTheory.Preadditive.Coproducts
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Generators

/-!
# Generation by global sections

Global sections of a scheme module `M` are written as morphisms `𝟙_ ⟶ M` out of the monoidal
unit. `globalSectionsEval M : ⨁_{s : 𝟙_ ⟶ M} 𝟙_ ⟶ M` evaluates all of them, and `M` is generated
by its global sections when it is an epimorphism. A morphism through which every global section
factors is then an epimorphism (`epi_of_unitHom_factor`); a morphism surjective on global
sections lets every global section of its target factor (`exists_unitHom_factor_of_surjective`).
Finitely many morphisms `φ_j : G ⟶ M`, jointly surjective on global sections, carry generating
global sections of `G` to generating global sections of `M`
(`epi_sigmaDesc_globalSectionsEval_comp`, and `exists_finite_sections_comp` for finite families).
A finite family `s` with `Sigma.desc s` an epimorphism is a finite family of generating sections
in Mathlib's sense (`exists_generatingSections_isFiniteType_of_epi`).
-/

@[expose] public section

noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory Opposite

universe u

namespace AlgebraicGeometry.Scheme.Modules

variable {X : Scheme.{u}}

/-- The evaluation of all global sections, `⨁_{s : 𝟙_ ⟶ M} 𝟙_ ⟶ M`. -/
def globalSectionsEval (M : X.Modules) :
    (∐ fun _ : (𝟙_ X.Modules ⟶ M) => 𝟙_ X.Modules) ⟶ M :=
  Sigma.desc fun s => s

@[reassoc]
theorem ι_globalSectionsEval (M : X.Modules) (s : 𝟙_ X.Modules ⟶ M) :
    Sigma.ι (fun _ : (𝟙_ X.Modules ⟶ M) => 𝟙_ X.Modules) s ≫ globalSectionsEval M = s :=
  Sigma.ι_comp_desc _ _

/-- A morphism through which every global section of a globally generated module factors is an
epimorphism. -/
theorem epi_of_unitHom_factor {A M : X.Modules} (φ : A ⟶ M) [Epi (globalSectionsEval M)]
    (h : ∀ s : 𝟙_ X.Modules ⟶ M, ∃ g : 𝟙_ X.Modules ⟶ A, g ≫ φ = s) : Epi φ := by
  choose g hg using h
  refine epi_of_epi_fac (f := Sigma.desc g) (h := globalSectionsEval M) ?_
  apply Sigma.hom_ext
  intro s
  rw [Sigma.ι_comp_desc_assoc, hg, ι_globalSectionsEval]

-- The global-section equivalence is stated for `SheafOfModules.unit` and `Γ(M, ⊤)`; they agree
-- with `𝟙_` and with the module sections only after unfolding.
set_option backward.isDefEq.respectTransparency false in
/-- If a morphism is surjective on global sections, every global section of its target factors
through it. -/
theorem exists_unitHom_factor_of_surjective {A M : X.Modules} (φ : A ⟶ M)
    (hφ : Function.Surjective (φ.val.app (op ⊤))) (s : 𝟙_ X.Modules ⟶ M) :
    ∃ g : 𝟙_ X.Modules ⟶ A, g ≫ φ = s := by
  obtain ⟨x, hx⟩ := hφ (unitHomGlobalSectionsEquiv X M s)
  refine ⟨(unitHomGlobalSectionsEquiv X A).symm x, (unitHomGlobalSectionsEquiv X M).injective ?_⟩
  have h1 : unitHomGlobalSectionsEquiv X M ((unitHomGlobalSectionsEquiv X A).symm x ≫ φ) =
      φ.val.app (op ⊤)
        (unitHomGlobalSectionsEquiv X A ((unitHomGlobalSectionsEquiv X A).symm x)) := rfl
  rw [h1, Equiv.apply_symm_apply, hx]

/-- If finitely many morphisms `φ_j : G ⟶ M` are jointly surjective on global sections and `M` is
globally generated, then the global sections of `G` followed by the `φ_j` generate `M`. -/
theorem epi_sigmaDesc_globalSectionsEval_comp {J : Type u} [Finite J] {G M : X.Modules}
    (φ : J → (G ⟶ M)) (hφ : Function.Surjective ((Sigma.desc φ).val.app (op ⊤)))
    [Epi (globalSectionsEval M)] :
    Epi (Sigma.desc fun j => globalSectionsEval G ≫ φ j) := by
  let := Fintype.ofFinite J
  apply epi_of_unitHom_factor
  intro b
  obtain ⟨a, ha⟩ := exists_unitHom_factor_of_surjective _ hφ b
  obtain ⟨s, hs⟩ := exists_eq_sum_sigma_ι a
  refine ⟨∑ j, Sigma.ι (fun _ : (𝟙_ X.Modules ⟶ G) => 𝟙_ X.Modules) (s j) ≫
    Sigma.ι (fun _ : J => ∐ fun _ : (𝟙_ X.Modules ⟶ G) => 𝟙_ X.Modules) j, ?_⟩
  rw [← ha, hs, Preadditive.sum_comp, Preadditive.sum_comp]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [Category.assoc, Sigma.ι_comp_desc, ι_globalSectionsEval_assoc, Category.assoc,
    Sigma.ι_comp_desc]

/-- If finitely many morphisms `φ_j : G ⟶ M` are jointly surjective on global sections and `M` is
generated by finitely many global sections `b_k`, then finitely many global sections `s` of `G`,
followed by the `φ_j`, generate `M`. -/
theorem exists_finite_sections_comp {J K : Type u} [Finite J] {G M : X.Modules}
    (φ : J → (G ⟶ M)) (hφ : Function.Surjective ((Sigma.desc φ).val.app (op ⊤)))
    (b : K → (𝟙_ X.Modules ⟶ M)) [Epi (Sigma.desc b)] :
    ∃ s : K × J → (𝟙_ X.Modules ⟶ G),
      Epi (Sigma.desc fun j => (Sigma.desc s : (∐ fun _ : K × J => 𝟙_ X.Modules) ⟶ G) ≫ φ j) := by
  let := Fintype.ofFinite J
  have hb (k : K) : ∃ c : J → (𝟙_ X.Modules ⟶ G), b k = ∑ j, c j ≫ φ j := by
    obtain ⟨a, ha⟩ := exists_unitHom_factor_of_surjective _ hφ (b k)
    obtain ⟨c, hc⟩ := exists_eq_sum_sigma_ι a
    refine ⟨c, ?_⟩
    rw [← ha, hc, Preadditive.sum_comp]
    exact Finset.sum_congr rfl fun j _ => by rw [Category.assoc, Sigma.ι_comp_desc]
  choose c hc using hb
  refine ⟨fun x => c x.1 x.2, ?_⟩
  refine epi_of_epi_fac (f := Sigma.desc fun k => ∑ j,
    Sigma.ι (fun _ : K × J => 𝟙_ X.Modules) (k, j) ≫
      Sigma.ι (fun _ : J => ∐ fun _ : K × J => 𝟙_ X.Modules) j) (h := Sigma.desc b) ?_
  apply Sigma.hom_ext
  intro k
  rw [Sigma.ι_comp_desc_assoc, Sigma.ι_comp_desc, hc k, Preadditive.sum_comp]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [Category.assoc, Sigma.ι_comp_desc, Sigma.ι_comp_desc_assoc]

-- The free module sheaf is the coproduct of copies of `SheafOfModules.unit`, which is `𝟙_` only
-- after unfolding the monoidal structure.
set_option backward.isDefEq.respectTransparency false in
/-- A finite family of global sections `s` with `Sigma.desc s` an epimorphism is a finite family
of generating sections in Mathlib's sense. -/
theorem exists_generatingSections_isFiniteType_of_epi {M : X.Modules} {J : Type u} [Finite J]
    (s : J → (𝟙_ X.Modules ⟶ M)) [Epi (Sigma.desc s)] :
    ∃ σ : SheafOfModules.GeneratingSections M, σ.IsFiniteType := by
  refine ⟨⟨J, SheafOfModules.freeHomEquiv _ (Sigma.desc s), ?_⟩, ⟨inferInstance⟩⟩
  rw [Equiv.symm_apply_apply]
  infer_instance

end AlgebraicGeometry.Scheme.Modules
