module

public import Aglib.AlgebraicGeometry.Modules.Generators.GlobalSections

/-!
# The counit of the pullback-pushforward adjunction and global generation

For every morphism of schemes `f : X ⟶ S` and every module `M` on `X`, the counit
`f^* f_* M ⟶ M` of the pullback-pushforward adjunction is surjective on global sections: by the
triangle identity, the image of a global section `m` under the adjunction unit of `f_* M` maps to
`m` (`counit_app_top_surjective`). Hence every global section of `M` factors through the counit,
and the counit is an epimorphism as soon as `M` is generated by its global sections
(`epi_counit_of_epi_globalSectionsEval`). This is the easy half of relative global generation:
`f^* f_* M ⟶ M` is surjective when `M` is globally generated, with no hypothesis on `f`.
-/

@[expose] public section

noncomputable section

universe u

open CategoryTheory Opposite

namespace AlgebraicGeometry.Scheme.Modules

variable {X S : Scheme.{u}} (f : X ⟶ S)

/-- **The counit is surjective on global sections**: for every `f : X ⟶ S` and every module `M`
on `X`, a global section `m` of `M` is the image under the counit `f^* f_* M ⟶ M` of the image of
`m` under the adjunction unit of `f_* M`, by the triangle identity. -/
theorem counit_app_top_surjective (M : X.Modules) :
    Function.Surjective
      (((pullbackPushforwardAdjunction f).counit.app M).val.app (op ⊤)) := by
  intro m
  refine ⟨((pullbackPushforwardAdjunction f).unit.app
    ((pushforward f).obj M)).val.app (op ⊤) m, ?_⟩
  exact congrArg (fun k => k.val.app (op ⊤) m)
    ((pullbackPushforwardAdjunction f).right_triangle_components M)

/-- **Global generation gives relative global generation**: for every `f : X ⟶ S`, if `M` is
generated by its global sections, then the counit `f^* f_* M ⟶ M` is an epimorphism. Every global
section of `M` factors through the counit (`counit_app_top_surjective`,
`exists_unitHom_factor_of_surjective`). -/
theorem epi_counit_of_epi_globalSectionsEval (M : X.Modules) [Epi (globalSectionsEval M)] :
    Epi ((pullbackPushforwardAdjunction f).counit.app M) := by
  have : Epi (globalSectionsEval ((𝟭 X.Modules).obj M)) := ‹Epi (globalSectionsEval M)›
  exact epi_of_unitHom_factor _ fun s =>
    exists_unitHom_factor_of_surjective _ (counit_app_top_surjective f M) s

/-- The counit at `M` is an epimorphism when it is one at an isomorphic module, by naturality. -/
theorem epi_counit_of_iso {M N : X.Modules} (e : M ≅ N)
    [Epi ((pullbackPushforwardAdjunction f).counit.app N)] :
    Epi ((pullbackPushforwardAdjunction f).counit.app M) := by
  have h : (pullbackPushforwardAdjunction f).counit.app M =
      (pullback f).map ((pushforward f).map e.hom) ≫
        (pullbackPushforwardAdjunction f).counit.app N ≫ e.inv := by
    have hn := (pullbackPushforwardAdjunction f).counit.naturality e.hom
    simp only [Functor.comp_map, Functor.id_map] at hn
    rw [reassoc_of% hn, Iso.hom_inv_id, Category.comp_id]
  rw [h]
  infer_instance

end AlgebraicGeometry.Scheme.Modules
