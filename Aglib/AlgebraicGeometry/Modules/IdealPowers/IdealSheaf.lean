module

public import Aglib.AlgebraicGeometry.Modules.IdealPowers.Thickening
public import Aglib.AlgebraicGeometry.IdealSheaf.Closed.SpecKernel
public import Aglib.AlgebraicGeometry.IdealSheaf.LocallyClosed

/-!
# The ideal sheaf of an actual affine-base thickening

The global scalar ideal, its powers, and the kernel of the original base-change
closed immersion define the same native ideal sheaf. No affineness of the source
scheme or flatness over the base is required.
-/

@[expose] public noncomputable section
set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.Scheme.Modules

universe u
variable {A : Type u} [CommRing A] {X : Scheme.{u}}
  (f : X ⟶ Spec (CommRingCat.of A)) (I : Ideal A)

local instance quotientMap_isClosedImmersion :
    IsClosedImmersion (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) :=
  IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective

/-- The actual affine-base thickening is a closed immersion. -/
instance idealThickeningι_isClosedImmersion : IsClosedImmersion (idealThickeningι f I) := by
  change IsClosedImmersion (pullback.fst f (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))))
  infer_instance

/-- The ideal sheaf generated by the original affine-base ideal. -/
def idealThickeningIdealSheaf : X.IdealSheafData :=
  IdealSheafData.ofIdealTop (I.map (idealThickeningBaseScalar f))

@[simp]
theorem idealThickeningIdealSheaf_ideal (U : X.affineOpens) :
    (idealThickeningIdealSheaf f I).ideal U =
      I.map ((X.presheaf.map (homOfLE le_top).op).hom.comp
        (idealThickeningBaseScalar f)) := by
  simp [idealThickeningIdealSheaf, Ideal.map_map]

/-- Taking powers agrees with taking powers of the original base ideal. -/
@[simp]
theorem idealThickeningIdealSheaf_pow (n : ℕ) :
    idealThickeningIdealSheaf f I ^ n = idealThickeningIdealSheaf f (I ^ n) := by
  ext U : 2
  simp [Ideal.map_pow]

/-- The original pullback closed immersion has precisely the generated ideal sheaf. -/
theorem idealThickeningι_ker :
    (idealThickeningι f I).ker = idealThickeningIdealSheaf f I := by
  rw [idealThickeningι, IdealSheafData.ker_fst_of_isClosedImmersion]
  ext U : 2
  rw [IdealSheafData.ideal_comap_eq_map_appLE _ f
    ⟨⊤, isAffineOpen_top _⟩ U (by simp), IdealSheafData.specMap_kernel_top]
  have hker : RingHom.ker (Ideal.Quotient.mk I) = I := Ideal.mk_ker
  rw [hker]
  have he : I.comap (Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom =
      I.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom :=
    (Ideal.map_comap_of_equiv
      (Scheme.ΓSpecIso (CommRingCat.of A)).commRingCatIsoToRingEquiv.symm).symm
  rw [he, Ideal.map_map, idealThickeningIdealSheaf_ideal]
  rfl

/-- The native closed subscheme is the actual affine-base thickening. -/
def idealThickeningSubschemeIso :
    (idealThickeningIdealSheaf f I).subscheme ≅ idealThickeningSpace f I :=
  eqToIso (congrArg IdealSheafData.subscheme (idealThickeningι_ker f I).symm) ≪≫
    (asIso (idealThickeningι f I).toImage).symm

private theorem subscheme_eqToHom_ι {J K : X.IdealSheafData} (h : J = K) :
    eqToHom (congrArg IdealSheafData.subscheme h) ≫ K.subschemeι = J.subschemeι := by
  subst K
  simp

/-- The comparison preserves the original immersion into the source scheme. -/
@[reassoc (attr := simp)]
theorem idealThickeningSubschemeIso_hom_ι :
    (idealThickeningSubschemeIso f I).hom ≫ idealThickeningι f I =
      (idealThickeningIdealSheaf f I).subschemeι := by
  rw [idealThickeningSubschemeIso, Iso.trans_hom, Category.assoc]
  have h : (asIso (idealThickeningι f I).toImage).inv ≫ idealThickeningι f I =
      (idealThickeningι f I).ker.subschemeι := by
    apply (cancel_epi (asIso (idealThickeningι f I).toImage).hom).mp
    rw [← Category.assoc, Iso.hom_inv_id, Category.id_comp]
    exact (idealThickeningι f I).toImage_imageι.symm
  change eqToHom (congrArg IdealSheafData.subscheme (idealThickeningι_ker f I).symm) ≫
    (asIso (idealThickeningι f I).toImage).inv ≫ idealThickeningι f I = _
  rw [h]
  exact subscheme_eqToHom_ι (idealThickeningι_ker f I).symm

end AlgebraicGeometry.Scheme.Modules
