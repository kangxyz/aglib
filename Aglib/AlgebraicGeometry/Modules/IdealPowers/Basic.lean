module

public import Aglib.AlgebraicGeometry.Modules.Linear
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Colimits
public import Mathlib.Algebra.Homology.ShortComplex.ShortExact
public import Mathlib.RingTheory.Ideal.Operations

/-!
# Actual ideal multiples of module sheaves

The ideal multiple is the categorical image of scalar evaluation from the coproduct
indexed by the ideal. Thus it is the locally generated image, not an assertion that
tensoring an ideal inclusion is injective. No flatness or quasicoherence is required.
-/

@[expose] public section

noncomputable section

set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry.Scheme.Modules

universe u

variable (X : Scheme.{u}) {A : Type u} [CommRing A]
variable (α : A →+* Γ(X, ⊤)) (F : X.Modules)

/-- Scalar evaluation whose image is the ideal multiple of the coefficient sheaf. -/
def idealEvaluation (J : Ideal A) : (∐ fun _ : J => F) ⟶ F :=
  Sigma.desc fun a => globalScalarEndomorphism X F (α a)

/-- The actual image coefficient generated by an ideal under the structural map. -/
def idealMultiple (J : Ideal A) : X.Modules := image (idealEvaluation X α F J)

/-- Inclusion of the ideal-generated image into the original coefficient. -/
def idealMultipleι (J : Ideal A) : idealMultiple X α F J ⟶ F :=
  image.ι (idealEvaluation X α F J)

instance (J : Ideal A) : Mono (idealMultipleι X α F J) := by
  dsimp [idealMultipleι]
  infer_instance

/-- Every scalar in the ideal factors through the actual ideal multiple. -/
def idealMultipleScalar (J : Ideal A) (a : J) : F ⟶ idealMultiple X α F J :=
  Sigma.ι (fun _ : J => F) a ≫ factorThruImage (idealEvaluation X α F J)

@[reassoc (attr := simp)]
theorem idealMultipleScalar_ι (J : Ideal A) (a : J) :
    idealMultipleScalar X α F J a ≫ idealMultipleι X α F J =
      globalScalarEndomorphism X F (α a) := by
  simp [idealMultipleScalar, idealMultipleι, idealEvaluation, Category.assoc]

/-- The map between scalar presentations induced by inclusion of ideals. -/
def idealEvaluationMap {J K : Ideal A} (h : J ≤ K) :
    (∐ fun _ : J => F) ⟶ (∐ fun _ : K => F) :=
  Sigma.desc fun a => Sigma.ι (fun _ : K => F) ⟨a, h a.property⟩

@[reassoc (attr := simp)]
theorem idealEvaluationMap_evaluation {J K : Ideal A} (h : J ≤ K) :
    idealEvaluationMap X F h ≫ idealEvaluation X α F K = idealEvaluation X α F J := by
  apply Sigma.hom_ext
  intro a
  simp [idealEvaluationMap, idealEvaluation]

/-- Inclusion of actual ideal multiples, constructed by image functoriality. -/
def idealMultipleMap {J K : Ideal A} (h : J ≤ K) :
    idealMultiple X α F J ⟶ idealMultiple X α F K :=
  image.map (Arrow.homMk' (f := idealEvaluation X α F J)
    (g := idealEvaluation X α F K) (idealEvaluationMap X F h) (𝟙 F) (by simp))

@[reassoc (attr := simp)]
theorem idealMultipleMap_ι {J K : Ideal A} (h : J ≤ K) :
    idealMultipleMap X α F h ≫ idealMultipleι X α F K = idealMultipleι X α F J := by
  exact (image.map_ι (Arrow.homMk' (f := idealEvaluation X α F J)
    (g := idealEvaluation X α F K) (idealEvaluationMap X F h) (𝟙 F) (by simp))).trans
    (Category.comp_id _)

@[simp]
theorem idealMultipleMap_refl (J : Ideal A) :
    idealMultipleMap X α F (le_refl J) = 𝟙 _ := by
  apply (cancel_mono (idealMultipleι X α F J)).mp
  simp

@[reassoc (attr := simp)]
theorem idealMultipleMap_comp {J K L : Ideal A} (h : J ≤ K) (k : K ≤ L) :
    idealMultipleMap X α F h ≫ idealMultipleMap X α F k =
      idealMultipleMap X α F (h.trans k) := by
  apply (cancel_mono (idealMultipleι X α F L)).mp
  simp

/-- The genuine coefficient quotient by an ideal multiple. -/
def idealQuotient (J : Ideal A) : X.Modules := cokernel (idealMultipleι X α F J)

/-- The original quotient morphism. -/
def idealQuotientπ (J : Ideal A) : F ⟶ idealQuotient X α F J :=
  cokernel.π (idealMultipleι X α F J)

instance (J : Ideal A) : Epi (idealQuotientπ X α F J) := by
  dsimp [idealQuotientπ]
  infer_instance

@[reassoc (attr := simp)]
theorem idealMultipleι_quotientπ (J : Ideal A) :
    idealMultipleι X α F J ≫ idealQuotientπ X α F J = 0 :=
  cokernel.condition _

/-- The native short exact coefficient sequence. -/
def idealSequence (J : Ideal A) : ShortComplex X.Modules :=
  ShortComplex.cokernelSequence (idealMultipleι X α F J)

theorem idealSequence_shortExact (J : Ideal A) : (idealSequence X α F J).ShortExact where
  exact := ShortComplex.cokernelSequence_exact _
  mono_f := by change Mono (idealMultipleι X α F J); infer_instance
  epi_g := by change Epi (idealQuotientπ X α F J); infer_instance

/-- Reduction induced by inclusion of the defining ideals. -/
def idealQuotientMap {J K : Ideal A} (h : J ≤ K) :
    idealQuotient X α F J ⟶ idealQuotient X α F K :=
  cokernel.desc (idealMultipleι X α F J) (idealQuotientπ X α F K) (by
    rw [← idealMultipleMap_ι X α F h, Category.assoc, idealMultipleι_quotientπ,
      comp_zero])

@[reassoc (attr := simp)]
theorem idealQuotientπ_map {J K : Ideal A} (h : J ≤ K) :
    idealQuotientπ X α F J ≫ idealQuotientMap X α F h = idealQuotientπ X α F K :=
  cokernel.π_desc _ _ _

@[simp]
theorem idealQuotientMap_refl (J : Ideal A) :
    idealQuotientMap X α F (le_refl J) = 𝟙 _ := by
  apply (cancel_epi (idealQuotientπ X α F J)).mp
  simp

@[reassoc (attr := simp)]
theorem idealQuotientMap_comp {J K L : Ideal A} (h : J ≤ K) (k : K ≤ L) :
    idealQuotientMap X α F h ≫ idealQuotientMap X α F k =
      idealQuotientMap X α F (h.trans k) := by
  apply (cancel_epi (idealQuotientπ X α F J)).mp
  simp

/-- The actual morphism of ideal-multiple short exact sequences. -/
def idealSequenceMap {J K : Ideal A} (h : J ≤ K) :
    idealSequence X α F J ⟶ idealSequence X α F K where
  τ₁ := idealMultipleMap X α F h
  τ₂ := 𝟙 F
  τ₃ := idealQuotientMap X α F h
  comm₁₂ := by
    change idealMultipleMap X α F h ≫ idealMultipleι X α F K = idealMultipleι X α F J ≫ 𝟙 F
    rw [idealMultipleMap_ι, Category.comp_id]
  comm₂₃ := by
    change 𝟙 F ≫ idealQuotientπ X α F K = idealQuotientπ X α F J ≫ idealQuotientMap X α F h
    rw [idealQuotientπ_map, Category.id_comp]

/-- The actual coefficient `Iⁿ F`, including the zeroth power. -/
abbrev idealPower (I : Ideal A) (n : ℕ) : X.Modules := idealMultiple X α F (I ^ n)

/-- The actual coefficient quotient `F / Iⁿ F`. -/
abbrev idealPowerQuotient (I : Ideal A) (n : ℕ) : X.Modules := idealQuotient X α F (I ^ n)

/-- Degree-lowering transition of the ideal-power coefficients. -/
abbrev idealPowerMap (I : Ideal A) {n m : ℕ} (h : n ≤ m) :
    idealPower X α F I m ⟶ idealPower X α F I n :=
  idealMultipleMap X α F (Ideal.pow_le_pow_right h)

/-- The original reduction map of coefficient quotients. -/
abbrev idealPowerQuotientMap (I : Ideal A) {n m : ℕ} (h : n ≤ m) :
    idealPowerQuotient X α F I m ⟶ idealPowerQuotient X α F I n :=
  idealQuotientMap X α F (Ideal.pow_le_pow_right h)

end AlgebraicGeometry.Scheme.Modules
