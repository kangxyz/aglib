module

public import Aglib.AlgebraicGeometry.HilbertScheme.DirectImage
public import Aglib.AlgebraicGeometry.IdealSheaf.Order
public import Aglib.AlgebraicGeometry.ProjectiveSpace.Tensor.Equivalence

/-!
# A flat family is determined by its sections in degree `m`

Nitsure, *Construction of Hilbert and Quot schemes*, arXiv:math/0504590v1, §5, p. 26: for a point
`Z ⊆ P^n_B` of the Hilbert functor over a Noetherian ring `B` and `m = hilbertRegularityBound n Φ`,
the twisted ideal sheaf `I_Z(m)` is generated by its global sections (Lemma 2.1 (c) on `P^n_B`,
`epi_globalSectionsEval_idealTwist`), so `Z` is recovered from the image of
`H^0(I_Z(m)) ⟶ H^0(𝒪(m))`. Global sections are morphisms `𝟙_ ⟶ M` out of the unit module, and
`idealTwistSections ι Z r` is the set of sections of `𝒪(r) ⊗ 𝒪` that factor through
`I_Z(r) ⟶ 𝒪(r) ⊗ 𝒪`.

* `ProjectiveSpace.le_of_idealTwistSections_subset`: if `I_W(r)` is generated by its global
  sections and every such section of `𝒪(r) ⊗ 𝒪` is a section of `I_{W'}(r)`, then `W ≤ W'`. The
  composite `I_W(r) ⟶ 𝒪(r) ⊗ 𝒪 ⟶ 𝒪(r) ⊗ 𝒪_{W'}` vanishes on every generating section, hence is
  zero; twisting is an equivalence (`twistingTensorEquivalence`), so `I_W ⟶ 𝒪 ⟶ 𝒪_{W'}` is zero
  and `I_W ⟶ 𝒪` factors through the kernel `I_{W'}` of `𝒪 ⟶ 𝒪_{W'}`; closed subschemes are
  ordered by their ideal modules (`Scheme.IdealSheafData.le_of_idealInclusion_factor`).
* `ProjectiveSpace.eq_of_idealTwistSections_eq`: **injectivity**: two flat families over `B` with
  all fiber Hilbert polynomials `Φ` and the same sections in a degree `r ≥ m` are equal.
-/

@[expose] public section

noncomputable section

set_option backward.isDefEq.respectTransparency false

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory Opposite
open AlgebraicGeometry.Scheme.Modules AlgebraicGeometry.Scheme.Modules.QuasiCoherent
open scoped Polynomial

universe u

namespace AlgebraicGeometry

namespace ProjectiveSpace

open Scheme.Cohomology

variable (ι : Type u) {B : Type u} [CommRing B]

/-- The twisted ideal inclusion `I_W(r) ⟶ 𝒪(r) ⊗ 𝒪` of a closed subscheme `W ⊆ P^n_B`. -/
abbrev idealTwistInclusion (W : (ProjectiveSpace B ι).IdealSheafData) (r : ℤ) :
    idealTwist ι W r ⟶ (moduleTensorLeftFunctor (ProjectiveSpace B ι) (twistingSheaf B ι r)).obj
      (SheafOfModules.unit (ProjectiveSpace B ι).ringCatSheaf) :=
  (moduleTensorLeftFunctor (ProjectiveSpace B ι) (twistingSheaf B ι r)).map
    (Scheme.Hom.idealInclusion W.subschemeι)

/-- The global sections of `𝒪(r) ⊗ 𝒪` that are sections of `I_W(r)`: the image of
`H^0(I_W(r)) ⟶ H^0(𝒪(r))`, with global sections written as morphisms out of the unit. -/
def idealTwistSections (W : (ProjectiveSpace B ι).IdealSheafData) (r : ℤ) :
    Set (𝟙_ (ProjectiveSpace B ι).Modules ⟶
      (moduleTensorLeftFunctor (ProjectiveSpace B ι) (twistingSheaf B ι r)).obj
        (SheafOfModules.unit (ProjectiveSpace B ι).ringCatSheaf)) :=
  Set.range fun s : 𝟙_ (ProjectiveSpace B ι).Modules ⟶ idealTwist ι W r =>
    s ≫ idealTwistInclusion ι W r

/-- **A globally generated twisted ideal sheaf is determined by its sections**: if `I_W(r)` is
generated by its global sections and every global section of `𝒪(r) ⊗ 𝒪` coming from `I_W(r)`
comes from `I_{W'}(r)`, then `W ≤ W'`. -/
theorem le_of_idealTwistSections_subset (W W' : (ProjectiveSpace B ι).IdealSheafData) (r : ℤ)
    (hgen : Epi (globalSectionsEval (idealTwist ι W r)))
    (h : idealTwistSections ι W r ⊆ idealTwistSections ι W' r) : W ≤ W' := by
  let T := moduleTensorLeftFunctor (ProjectiveSpace B ι) (twistingSheaf B ι r)
  have hf : T.map (Scheme.Hom.idealInclusion W.subschemeι ≫ W'.toQuotientModule) = 0 := by
    rw [← cancel_epi (globalSectionsEval (idealTwist ι W r)), comp_zero]
    refine Sigma.hom_ext _ _ fun s => ?_
    rw [ι_globalSectionsEval_assoc, comp_zero]
    obtain ⟨t, ht⟩ := h ⟨s, rfl⟩
    have ht' : t ≫ T.map (Scheme.Hom.idealInclusion W'.subschemeι) =
        s ≫ T.map (Scheme.Hom.idealInclusion W.subschemeι) := ht
    rw [T.map_comp, ← Category.assoc, ← ht', Category.assoc, ← T.map_comp,
      show Scheme.Hom.idealInclusion W'.subschemeι ≫ W'.toQuotientModule = 0 from
        cokernel.condition _, T.map_zero, comp_zero]
  have h0 : Scheme.Hom.idealInclusion W.subschemeι ≫ W'.toQuotientModule = 0 :=
    T.map_injective (by rw [hf, T.map_zero])
  obtain ⟨k, hk⟩ := KernelFork.IsLimit.lift' (Abelian.monoIsKernelOfCokernel _
    (cokernelIsCokernel (Scheme.Hom.idealInclusion W'.subschemeι))) _ h0
  exact W.le_of_idealInclusion_factor W' k hk

variable [IsNoetherianRing B] (n : ℕ) (e : ι ≃ Fin (n + 1)) {Φ : ℚ[X]}

include e in
/-- **Injectivity of `Z ↦ H^0(I_Z(r)) ⊆ H^0(𝒪(r))`** (Nitsure, arXiv:math/0504590v1, §5, p. 26):
two closed subschemes of `P^n_B`, flat over the Noetherian ring `B` and with all fiber Hilbert
polynomials `Φ`, whose ideal sheaves have the same global sections in a degree
`r ≥ hilbertRegularityBound n Φ`, are equal. -/
theorem eq_of_idealTwistSections_eq (Z Z' : (ProjectiveSpace B ι).IdealSheafData)
    [Flat (Z.subschemeι ≫ toSpec B ι)] [Flat (Z'.subschemeι ≫ toSpec B ι)]
    (hfib : ∀ p : PrimeSpectrum B,
      subschemeHilbertPolynomial ι p.asIdeal.ResidueField (primeFiber ι Z p) = Φ)
    (hfib' : ∀ p : PrimeSpectrum B,
      subschemeHilbertPolynomial ι p.asIdeal.ResidueField (primeFiber ι Z' p) = Φ)
    (r : ℤ) (hr : hilbertRegularityBound n Φ ≤ r)
    (h : idealTwistSections ι Z r = idealTwistSections ι Z' r) : Z = Z' :=
  le_antisymm
    (le_of_idealTwistSections_subset ι Z Z' r
      (epi_globalSectionsEval_idealTwist ι n e Z hfib r hr) h.le)
    (le_of_idealTwistSections_subset ι Z' Z r
      (epi_globalSectionsEval_idealTwist ι n e Z' hfib' r hr) h.ge)

end ProjectiveSpace

end AlgebraicGeometry
