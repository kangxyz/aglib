module

public import Aglib.AlgebraicGeometry.HilbertScheme.IdealTwist.DirectImage
public import Aglib.AlgebraicGeometry.Modules.Locality.Epimorphisms
public import Aglib.AlgebraicGeometry.Modules.Generators.Counit
public import Aglib.AlgebraicGeometry.Modules.BaseChange.Counit
public import Aglib.AlgebraicGeometry.Modules.ZeroLocus.ImageFactorisation

/-!
# Relative global generation of the twisted ideal sheaf of a Hilbert family

Let `T` be locally Noetherian over `Spec A`, `Z` a point of `Hilb^Φ(T)`,
`π : X_T = P^n_A ×_{Spec A} T ⟶ T` and `r ≥ hilbertRegularityBound n Φ`. Following Nitsure,
*Construction of Hilbert and Quot schemes*, arXiv:math/0504590v1, §5, p. 25, (*), and p. 26,
"Embedding Quot into Grassmannian":

* `IsHilbertFamily.epi_counit_familyIdealTwist`: the counit `π^* π_* I_Z(r) ⟶ I_Z(r)` is an
  epimorphism (relative global generation). Over an affine open `Spec B ⊆ T` the pullback of the
  counit to `P^n_B` is the counit of `P^n_B ⟶ Spec B` at `I_{Z_B}(r)`, because the base-change map
  along an open immersion is invertible (`epi_pullback_counit_of_isPullback`); that counit is an
  epimorphism since `I_{Z_B}(r)` is generated by its global sections (Lemma 2.1 (c),
  `IsHilbertFamily.epi_globalSectionsEval_idealTwist`, and `epi_counit_of_epi_globalSectionsEval`).
  Epimorphisms are detected on the open cover of `X_T` by the `P^n_B`
  (`epi_of_pullback_openCover`).
* `IsHilbertFamily.imageIdealData_tensor_counit`: for a finite locally free `L` and an
  isomorphism `u : L ⊗ I_Z(r) ≅ I_Z` (for `L = 𝒪(-r)` the untwisting), `Z` is the image ideal of
  `L ⊗ π^* π_* I_Z(r) ⟶ L ⊗ I_Z(r) ≅ I_Z ⟶ 𝒪`: the form of the ideal of `Z` used in the "⇒"
  inclusion of Nitsure's proof of Theorem 5.2 (§5, p. 24) (`Hom.imageIdealData_eq_of_epi_comp`).
-/

@[expose] public section

noncomputable section

open CategoryTheory CategoryTheory.Limits
open scoped Polynomial

universe u

namespace AlgebraicGeometry.ProjectiveSpace

open Scheme.Cohomology Scheme.Modules.QuasiCoherent

variable (ι : Type u) {A : Type u} [CommRing A] {Φ : ℚ[X]} {T : Scheme.{u}}
  {g : T ⟶ Spec (CommRingCat.of A)} {Z : (pullback (toSpec A ι) g).IdealSheafData}
  (n : ℕ) (e : ι ≃ Fin (n + 1))

include e in
/-- **Relative global generation of `I_Z(r)`** (Nitsure, arXiv:math/0504590v1, §5, p. 25, (*),
from Lemma 2.1 (c), p. 10, on the affine pieces): for a point `Z` of `Hilb^Φ(T)`, `T` locally
Noetherian, and `r ≥ hilbertRegularityBound n Φ`, the counit `π^* π_* I_Z(r) ⟶ I_Z(r)` is an
epimorphism. -/
theorem IsHilbertFamily.epi_counit_familyIdealTwist [IsLocallyNoetherian T]
    (hZ : IsHilbertFamily ι Φ g Z) (r : ℤ) (hr : hilbertRegularityBound n Φ ≤ r) :
    Epi ((Scheme.Modules.pullbackPushforwardAdjunction (pullback.snd (toSpec A ι) g)).counit.app
      (familyIdealTwist ι g Z r)) := by
  have := hZ.flat
  have (U : T.affineOpens) : IsOpenImmersion (pointMap ι g (K := Γ(T, U)) U.2.fromSpec) :=
    have : IsOpenImmersion (U.2.fromSpec : Spec (CommRingCat.of Γ(T, U)) ⟶ T) :=
      U.2.isOpenImmersion_fromSpec
    inferInstance
  apply Scheme.Modules.epi_of_pullback_openCover
    (fun U : T.affineOpens => ProjectiveSpace Γ(T, U) ι)
    (fun U => pointMap ι g (K := Γ(T, U)) U.2.fromSpec)
  · intro y
    obtain ⟨U, hU, htU, -⟩ := exists_isAffineOpen_mem_and_subset
      (show pullback.snd (toSpec A ι) g y ∈ (⊤ : T.Opens) from trivial)
    obtain ⟨z, hz⟩ := Scheme.Modules.exists_apply_eq_of_isPullback
      (isPullback_pointMap ι g (K := Γ(T, U)) hU.fromSpec) y (by rwa [hU.range_fromSpec])
    exact ⟨⟨U, hU⟩, z, hz⟩
  · intro U
    have : IsNoetherianRing Γ(T, U) := IsLocallyNoetherian.component_noetherian U
    have hp := isPullback_pointMap ι g (K := Γ(T, U)) U.2.fromSpec
    have : IsOpenImmersion (U.2.fromSpec : Spec (CommRingCat.of Γ(T, U)) ⟶ T) :=
      U.2.isOpenImmersion_fromSpec
    have := Scheme.Modules.isIso_cartesianBaseChangeMap_of_isOpenImmersion _ _ _ _ hp
      (familyIdealTwist ι g Z r)
    have := hZ.epi_globalSectionsEval_idealTwist ι n e (B := Γ(T, U)) U.2.fromSpec r hr
    have := Scheme.Modules.epi_counit_of_epi_globalSectionsEval (toSpec Γ(T, U) ι)
      (idealTwist ι (Z.comap (pointMap ι g (K := Γ(T, U)) U.2.fromSpec)) r)
    have := Scheme.Modules.epi_counit_of_iso (toSpec Γ(T, U) ι)
      (pointMapIdealTwistIso ι Z (B := Γ(T, U)) U.2.fromSpec r)
    exact Scheme.Modules.epi_pullback_counit_of_isPullback _ _ _ _ hp _

include e in
/-- **The ideal of a Hilbert family from the sections of its twist** (the form consumed by the
"⇒" inclusion of Nitsure, arXiv:math/0504590v1, §5, p. 26): for a point `Z` of `Hilb^Φ(T)`, `T`
locally Noetherian, a natural `r ≥ hilbertRegularityBound n Φ`, a finite locally free `L` and an
isomorphism `u : L ⊗ I_Z(r) ≅ I_Z`, the closed subscheme `Z` is the image ideal of
`L ⊗ π^* π_* I_Z(r) ⟶ L ⊗ I_Z(r) ≅ I_Z ⟶ 𝒪`. For `L = 𝒪(-r)` this is the image of
`π^* π_* I_Z(r) ⊗ 𝒪(-r) ⟶ 𝒪`. -/
theorem IsHilbertFamily.imageIdealData_tensor_counit [IsLocallyNoetherian T]
    (hZ : IsHilbertFamily ι Φ g Z) (r : ℕ) (hr : hilbertRegularityBound n Φ ≤ r)
    (L : (pullback (toSpec A ι) g).Modules) [Scheme.Modules.IsFiniteLocallyFree _ L]
    (u : (Scheme.Modules.moduleTensorLeftFunctor _ L).obj (familyIdealTwist ι g Z r) ≅
      Scheme.Hom.idealModule Z.subschemeι) :
    Scheme.Modules.Hom.imageIdealData
      ((Scheme.Modules.moduleTensorLeftFunctor _ L).map
          ((Scheme.Modules.pullbackPushforwardAdjunction (pullback.snd (toSpec A ι) g)).counit.app
            (familyIdealTwist ι g Z r)) ≫ u.hom ≫ Scheme.Hom.idealInclusion Z.subschemeι) =
      Z := by
  have := hZ.isFiniteLocallyFree_pushforward_familyIdealTwist ι n e r hr
  have := hZ.epi_counit_familyIdealTwist ι n e r hr
  have : PreservesFiniteColimits (Scheme.Modules.moduleTensorLeftFunctor _ L) :=
    Functor.preservesFiniteColimits_of_preservesHomology _
  have hP : affineLocallyFiniteType _ ((Scheme.Modules.moduleTensorLeftFunctor _ L).obj
      ((Scheme.Modules.pullback (pullback.snd (toSpec A ι) g)).obj
        ((Scheme.Modules.pushforward (pullback.snd (toSpec A ι) g)).obj
          (familyIdealTwist ι g Z r)))) :=
    affineLocallyFiniteType_tensor _ _ (affineLocallyFiniteType_of_finitePresentation L)
      (affineLocallyFiniteType_of_finitePresentation _)
  have : ((Scheme.Modules.moduleTensorLeftFunctor _ L).obj
      ((Scheme.Modules.pushforward (pullback.snd (toSpec A ι) g) ⋙
        Scheme.Modules.pullback (pullback.snd (toSpec A ι) g)).obj
          (familyIdealTwist ι g Z r))).IsQuasicoherent :=
    quasicoherent_of_affineCharts _ (fun R j _ => (hP R j).1)
  rw [← Category.assoc]
  exact Scheme.Modules.Hom.imageIdealData_eq_of_epi_comp
    (Scheme.Modules.Hom.imageIdealLocalizes_of_isQuasicoherent _) Z _ rfl

end AlgebraicGeometry.ProjectiveSpace
