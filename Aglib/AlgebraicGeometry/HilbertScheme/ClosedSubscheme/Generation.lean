module

public import Aglib.AlgebraicGeometry.HilbertScheme.ClosedSubscheme.Containment
public import Aglib.AlgebraicGeometry.Cohomology.Projective.Regularity.GlobalGeneration

/-!
# A closed subscheme of `P^n_A` is cut out by its sections in large degree

Let `A` be a ring and `C ⊆ P^n_A` a closed subscheme with ideal module `I_C`, and
`I_C(r) = 𝒪(r) ⊗ I_C` (`idealTwist`). For an epimorphism `σ : 𝒪^J ⟶ I_C(r)` (generating global
sections of `I_C(r)`), the sections `φ = σ ≫ (I_C(r) ⟶ 𝒪(r))` cut out `C`: the image ideal of
their section pairing `𝒪^J ⊗ 𝒪(-r) ⟶ 𝒪` is `C` (`imageIdealData_sectionPairing_of_epi`). The
pairing is `σ ⊗ 𝒪(-r)`, an epimorphism, followed by the untwisting `I_C(r) ⊗ 𝒪(-r) ≅ I_C`
(`untwistIso_hom_comp`) and the inclusion `I_C ⟶ 𝒪`.

For a Noetherian ring `A`, `I_C` is coherent and hence `m`-regular for some `m`
(`Scheme.Cohomology.exists_isProjectiveRegular`), so `I_C(r)` is generated by its global sections
for every `r ≥ m` (Nitsure, *Construction of Hilbert and Quot schemes*, arXiv:math/0504590v1,
Lemma 2.1 (c), p. 10, generation half; Nitsure states Lemma 2.1 over a field, §2, p. 9, and
`IsProjectiveRegular.epi_globalSectionsEval` proves it over any ring). Hence
`exists_sectionPairing_imageIdealData_eq`: there is `m` such that for every natural `r ≥ m` some
family of sections of `𝒪(r)` cuts out `C`. The family is the set of all global sections of
`I_C(r)`; finiteness of the family is not needed by the consumer.

Consumer: `HilbertScheme/ClosedSubscheme/Representability`.
-/

@[expose] public section

noncomputable section

set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory
open AlgebraicGeometry.Scheme.Modules

universe u

namespace AlgebraicGeometry

namespace ProjectiveSpace

variable (ι : Type u) {A : Type u} [CommRing A]

/-- The inclusion `I_C(r) = 𝒪(r) ⊗ I_C ⟶ 𝒪(r) ⊗ 𝒪 ≅ 𝒪(r)` on `P^n_A`. -/
def idealTwistToTwistingSheaf (C : (ProjectiveSpace A ι).IdealSheafData) (r : ℤ) :
    idealTwist ι C r ⟶ twistingSheaf A ι r :=
  (twistingSheaf A ι r ◁ Scheme.Hom.idealInclusion C.subschemeι) ≫ (ρ_ (twistingSheaf A ι r)).hom

/-- **Generating sections of `I_C(r)` cut out `C`**: for an epimorphism `σ : 𝒪^J ⟶ I_C(r)`, the
image ideal of the section pairing of `σ ≫ (I_C(r) ⟶ 𝒪(r))` is `C`. -/
theorem imageIdealData_sectionPairing_of_epi (C : (ProjectiveSpace A ι).IdealSheafData) (r : ℕ)
    {J : Type u}
    (σ : SheafOfModules.free (R := (ProjectiveSpace A ι).ringCatSheaf) J ⟶ idealTwist ι C r)
    [Epi σ] :
    Scheme.Modules.Hom.imageIdealData
      (sectionPairing ι r (σ ≫ idealTwistToTwistingSheaf ι C r)) = C := by
  let Pr : twistingSheaf A ι (r : ℤ) ⊗ twistingSheaf A ι (-(r : ℤ)) ≅
      𝟙_ (ProjectiveSpace A ι).Modules :=
    twistingTensorNegIso (R := A) (ι := ι) (r : ℤ)
  have : PreservesFiniteColimits
      (Scheme.Modules.moduleTensorRightFunctor _ (twistingSheaf A ι (-(r : ℤ)))) :=
    Functor.preservesFiniteColimits_of_preservesHomology _
  have : Epi (Scheme.Modules.tensorSheafMap (ProjectiveSpace A ι) σ
      (𝟙 (twistingSheaf A ι (-(r : ℤ))))) :=
    inferInstanceAs (Epi ((Scheme.Modules.moduleTensorRightFunctor _
      (twistingSheaf A ι (-(r : ℤ)))).map σ))
  have hcomp := untwistIso_hom_comp Pr (Scheme.Hom.idealInclusion C.subschemeι)
  have h : sectionPairing ι r (σ ≫ idealTwistToTwistingSheaf ι C r) =
      (Scheme.Modules.tensorSheafMap (ProjectiveSpace A ι) σ (𝟙 _) ≫
        (untwistIso Pr (Scheme.Hom.idealModule C.subschemeι)).hom) ≫
          Scheme.Hom.idealInclusion C.subschemeι := by
    rw [Category.assoc, hcomp, sectionPairing_def]
    change _ = Scheme.Modules.tensorSheafMap (ProjectiveSpace A ι) σ (𝟙 _) ≫
      Scheme.Modules.tensorSheafMap (ProjectiveSpace A ι) (idealTwistToTwistingSheaf ι C r)
        (𝟙 _) ≫ Pr.hom
    rw [tensorSheafMap_comp_assoc, Category.id_comp]
  have := isQuasicoherent_sectionPairingSource ι r (A := A) (J := J)
  rw [h]
  exact Scheme.Modules.Hom.imageIdealData_eq_of_epi_comp
    (Scheme.Modules.Hom.imageIdealLocalizes_of_isQuasicoherent _) C _ rfl

/-- **A closed subscheme is cut out by sections of `𝒪(r)` for all large `r`** (Nitsure,
arXiv:math/0504590v1, Lemma 2.1 (c), p. 10, generation half, stated there over a field and proved
over any ring by `IsProjectiveRegular.epi_globalSectionsEval`): for a Noetherian ring `A` and a
closed subscheme `C ⊆ P^n_A`, there is `m` such that for every natural `r ≥ m` some family `φ` of
global sections of `𝒪(r)` has section pairing with image ideal `C`. -/
theorem exists_sectionPairing_imageIdealData_eq [IsNoetherianRing A] (n : ℕ)
    (e : ι ≃ Fin (n + 1)) (C : (ProjectiveSpace A ι).IdealSheafData) :
    ∃ m : ℤ, ∀ r : ℕ, m ≤ r → ∃ (J : Type u)
      (φ : SheafOfModules.free (R := (ProjectiveSpace A ι).ringCatSheaf) J ⟶
        twistingSheaf A ι (r : ℤ)),
      Scheme.Modules.Hom.imageIdealData (sectionPairing ι r φ) = C := by
  have : Finite ι := Finite.of_equiv _ e.symm
  have hI := Scheme.Hom.affineLocallyFiniteType_idealModule C.subschemeι
  obtain ⟨m, hm⟩ := Scheme.Cohomology.exists_isProjectiveRegular A ι n e _ hI
  refine ⟨m, fun r hr => ?_⟩
  have := Scheme.Cohomology.IsProjectiveRegular.epi_globalSectionsEval A ι n e hI hm hr
  exact ⟨_, globalSectionsEval (idealTwist ι C r) ≫ idealTwistToTwistingSheaf ι C r,
    imageIdealData_sectionPairing_of_epi ι C r (globalSectionsEval _)⟩

end ProjectiveSpace

end AlgebraicGeometry
