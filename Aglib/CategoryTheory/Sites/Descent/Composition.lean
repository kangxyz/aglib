module

public import Mathlib.CategoryTheory.Sites.Descent.Precoverage
public import Aglib.CategoryTheory.Sites.Descent.Bind

/-!
# Effective descent along composites of presieves

Let `F : LocallyDiscrete Cᵒᵖ ⥤ᵖ Cat` and let `J` be a Grothendieck topology on `C`.

* `Pseudofunctor.IsPrestack.of_le`, `Pseudofunctor.IsStack.of_le`: a prestack (stack) for a
  topology `J'` is a prestack (stack) for every coarser topology `J ≤ J'`.
* `Pseudofunctor.IsStackFor.bind`: let `F` be a `J`-prestack. If `R` is a `J`-covering presieve
  of `S` for which `F` is a stack, and for every arrow `f : Y ⟶ S` of `R`, `R' f` is a
  `J`-covering presieve of `Y` for which `F` is a stack, then `F` is a stack for the composite
  presieve `R.bind R'` (Mathlib's `Presieve.bind`). This is the presieve form of
  `Pseudofunctor.isEquivalence_toDescentData_comp` of [Bind](Bind.lean), for the families indexed
  by `R.category`.

Mathlib's `Pseudofunctor.IsStackFor.of_le` (`Mathlib/CategoryTheory/Sites/Descent/Precoverage.lean`)
passes effective descent from a covering presieve to every larger one, for a prestack. It does not
give the composition statement: the sieve generated by `R.bind R'` is *smaller* than the sieve
generated by `R`. For a sheaf of types, the corresponding statement is Mathlib's
`Presieve.isSheafFor_bind`.

(`citation needed`: a locator for the composition statement for stacks; Giraud, *Cohomologie non
abélienne*, Chapter II, is the expected source but was not inspected. For sheaves of types the
statement is [Elephant, Lemma C2.1.7(i)], as cited by Mathlib's `Presieve.isSheafFor_bind`.)
-/

@[expose] public section

universe v' v u' u

namespace CategoryTheory.Pseudofunctor

open Bicategory

variable {C : Type u} [Category.{v} C] (F : LocallyDiscrete Cᵒᵖ ⥤ᵖ Cat.{v', u'})

/-- A prestack for a topology `J'` is a prestack for every coarser topology. -/
lemma IsPrestack.of_le {J J' : GrothendieckTopology C} (h : J ≤ J') [F.IsPrestack J'] :
    F.IsPrestack J :=
  IsPrestack.of_isPrestackFor fun _ R hR ↦ F.isPrestackFor' R (h _ hR)

/-- A stack for a topology `J'` is a stack for every coarser topology. -/
lemma IsStack.of_le {J J' : GrothendieckTopology C} (h : J ≤ J') [F.IsStack J'] :
    F.IsStack J :=
  IsStack.of_isStackFor fun _ R hR ↦ F.isStackFor' R (h _ hR)

variable {F}

/-- **Effective descent along composites of presieves, for prestacks.** If `F` is a `J`-prestack,
`R` a `J`-covering presieve of `S` for which `F` is a stack, and `R' f` a `J`-covering presieve of
the source of every arrow `f` of `R` for which `F` is a stack, then `F` is a stack for the
composite presieve `R.bind R'`. -/
theorem IsStackFor.bind {J : GrothendieckTopology C} [F.IsPrestack J] {S : C} {R : Presieve S}
    (hR : F.IsStackFor R) (hRJ : Sieve.generate R ∈ J S)
    (R' : ∀ ⦃Y : C⦄ ⦃f : Y ⟶ S⦄, R f → Presieve Y)
    (hR' : ∀ ⦃Y : C⦄ ⦃f : Y ⟶ S⦄ (hf : R f), F.IsStackFor (R' hf))
    (hR'J : ∀ ⦃Y : C⦄ ⦃f : Y ⟶ S⦄ (hf : R f), Sieve.generate (R' hf) ∈ J Y) :
    F.IsStackFor (R.bind R') := by
  have hf : Sieve.ofArrows _ (fun (a : R.category) ↦ a.obj.hom) ∈ J S := by
    rwa [Sieve.ofArrows_category']
  have hg : ∀ a : R.category,
      Sieve.ofArrows _ (fun (b : (R' a.property).category) ↦ b.obj.hom) ∈ J a.obj.left :=
    fun a ↦ by
      rw [Sieve.ofArrows_category']
      exact hR'J a.property
  have := hR.isEquivalence
  have := fun a : R.category ↦ (hR' a.property).isEquivalence
  have key := isEquivalence_toDescentData_comp (F := F) (J := J) (fun (a : R.category) ↦ a.obj.hom)
    (fun a (b : (R' a.property).category) ↦ b.obj.hom) hg hf
  rw [← isStackFor_ofArrows_iff] at key
  refine (F.isStackFor_iff_of_sieve_eq (congrArg Sieve.generate ?_)).1 key
  refine le_antisymm ?_ ?_
  · rintro Z _ ⟨ab⟩
    exact ⟨_, ab.2.obj.hom, ab.1.obj.hom, ab.1.property, ab.2.property, rfl⟩
  · rintro Z _ ⟨Y, g, f, H, H', rfl⟩
    exact Presieve.ofArrows.mk
      (⟨⟨Over.mk f, H⟩, ⟨Over.mk g, H'⟩⟩ : Σ a : R.category, (R' a.property).category)

end CategoryTheory.Pseudofunctor
