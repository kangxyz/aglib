module

public import Mathlib.CategoryTheory.Sites.Over

/-!
# Coverings along `Over.map`

Let `J` be a Grothendieck topology on a category `C` and `f : X ⟶ Y` a morphism of `C`. The functor
`Over.map f : Over X ⥤ Over Y` keeps the underlying object: `((Over.map f).obj U).left = U.left`.
A sieve on an object `U` of `Over X` covers for the induced topology `J.over X` exactly when the
sieve of `U.left` that it generates covers for `J` (Mathlib's `GrothendieckTopology.mem_over_iff`),
and likewise over `Y`. Hence the coverings of `U` over `X` and of `(Over.map f).obj U` over `Y`
correspond:

* `GrothendieckTopology.functorPushforward_over_map_mem_iff`: a sieve `R` on `U` covers for
  `J.over X` if and only if its image `R.functorPushforward (Over.map f)` covers for `J.over Y`;
* `GrothendieckTopology.functorPullback_over_map_mem_iff`: a sieve `R` on `(Over.map f).obj U`
  covers for `J.over Y` if and only if its preimage `R.functorPullback (Over.map f)` covers for
  `J.over X`.

The forward directions are Mathlib's proofs that `Over.map f` is cover-preserving
(`GrothendieckTopology.over_map_coverPreserving`) and cocontinuous; together with compatible
preservation they give Mathlib's continuity and cocontinuity instances of `Over.map f` for
`J.over X` and `J.over Y` (`Mathlib.CategoryTheory.Sites.Over`). For schemes and the fppf
topology, with `f = g : S' ⟶ S`, this says that a family of `S'`-schemes is an fppf covering if
and only if it is one as a family of `S`-schemes. In the base change of the Picard functor this is
the reason Kleiman gives for the identification of the sheafified functors, which "holds
essentially by definition" (Kleiman, *The Picard scheme*, arXiv:math/0504020v1, Answer 4.4, p. 65,
for étale coverings; the consumer is `Aglib.AlgebraicGeometry.Picard.BaseChange`).
-/

@[expose] public section

universe v u

namespace CategoryTheory.GrothendieckTopology

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C) {X Y : C} (f : X ⟶ Y)

/-- **Coverings along `Over.map`, image form**: a sieve `R` on `U : Over X` covers for `J.over X`
if and only if its image under `Over.map f` covers `(Over.map f).obj U` for `J.over Y`. Both
conditions say that the sieve of `U.left` generated by `R` covers for `J`. -/
theorem functorPushforward_over_map_mem_iff {U : Over X} (R : Sieve U) :
    R.functorPushforward (Over.map f) ∈ J.over Y ((Over.map f).obj U) ↔ R ∈ J.over X U := by
  obtain ⟨R, rfl⟩ := (Sieve.overEquiv U).symm.surjective R
  rw [Sieve.functorPushforward_over_map, mem_over_iff, mem_over_iff, OrderIso.apply_symm_apply,
    OrderIso.apply_symm_apply]
  exact Iff.rfl

/-- **Coverings along `Over.map`, preimage form**: a sieve `R` on `(Over.map f).obj U` covers for
`J.over Y` if and only if its preimage under `Over.map f` covers `U` for `J.over X`. -/
theorem functorPullback_over_map_mem_iff {U : Over X} (R : Sieve ((Over.map f).obj U)) :
    R.functorPullback (Over.map f) ∈ J.over X U ↔ R ∈ J.over Y ((Over.map f).obj U) :=
  (J.mem_over_iff _).trans <| by
    rw [Sieve.overEquiv_functorPullback_map]
    exact (J.mem_over_iff R).symm

end CategoryTheory.GrothendieckTopology
