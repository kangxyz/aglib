module

public import Aglib.CategoryTheory.Sites.SheafCohomology.Continuity.FiniteHypercoverColimit
public import Mathlib.Algebra.Category.Grp.AB
public import Mathlib.CategoryTheory.Limits.Preserves.Limits

/-! # The canonical section-colimit comparison

On a site generated by finite `1`-hypercovers, the native sections functor
commutes with filtered colimits of abelian sheaves. The comparison is the
original `colimit.post`, and its equation with every colimit injection
is retained. Higher sheaf cohomology is not asserted here.
-/

@[expose] public noncomputable section

namespace CategoryTheory.GrothendieckTopology.OneHypercoverFamily

open Limits Opposite

universe w v u k

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
  (H : J.OneHypercoverFamily.{w}) [H.IsGenerating]
  (hfin : ∀ ⦃X : C⦄ (E : J.OneHypercover.{w} X), H E →
    Finite E.I₀ ∧ ∀ i j : E.I₀, Finite (E.I₁ i j))
  {I : Type k} [SmallCategory I] [IsFiltered I]

/-- Filtered colimits of abelian sheaves on a finite-hypercover site are
preserved by the original sections functor, with coefficients in `Type k`. -/
abbrev preservesFilteredColimitsSections (X : C) :
    PreservesColimitsOfShape I ((sheafSections J AddCommGrpCat.{k}).obj (op X)) := by
  let := preservesColimitsOfShapeSheafToPresheaf (I := I)
    (A := AddCommGrpCat.{k}) H hfin
  change PreservesColimitsOfShape I
    (sheafToPresheaf J AddCommGrpCat.{k} ⋙ (evaluation _ _).obj (op X))
  infer_instance

variable (G : I ⥤ Sheaf J AddCommGrpCat.{k}) [HasColimit G]

/-- The inverse native preservation isomorphism has precisely the direction
of the canonical section-colimit comparison. -/
def sectionsFilteredColimitIso (X : C) :
    colimit (G ⋙ (sheafSections J AddCommGrpCat.{k}).obj (op X)) ≅
      (colimit G).obj.obj (op X) := by
  letI := preservesFilteredColimitsSections (I := I) H hfin X
  exact (preservesColimitIso ((sheafSections J AddCommGrpCat.{k}).obj (op X)) G).symm

/-- The section-colimit isomorphism is not an arbitrary chosen isomorphism. -/
theorem sectionsFilteredColimitIso_hom (X : C) :
    (sectionsFilteredColimitIso H hfin G X).hom =
      colimit.post G ((sheafSections J AddCommGrpCat.{k}).obj (op X)) := rfl

/-- Normalization at the actual coefficient-diagram cocone maps. -/
theorem sectionsFilteredColimitIso_ι (X : C) (i : I) :
    colimit.ι (G ⋙ (sheafSections J AddCommGrpCat.{k}).obj (op X)) i ≫
        (sectionsFilteredColimitIso H hfin G X).hom =
      (colimit.ι G i).hom.app (op X) := by
  let := preservesFilteredColimitsSections (I := I) H hfin X
  exact ι_preservesColimitIso_inv ((sheafSections J AddCommGrpCat.{k}).obj (op X)) G i

end CategoryTheory.GrothendieckTopology.OneHypercoverFamily
