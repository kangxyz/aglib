module

public import Aglib.CategoryTheory.Sites.SheafCohomology.ModuleCoefficients.LocalLiftFamily
public import Mathlib.CategoryTheory.Sites.Hypercover.IsSheaf

/-! # Finite families of local lifts

A topology generated by finite covering families permits a locally surjective
map to lift each section on a finite representable covering family. These are
actual lifts and the original covering map, not a section-surjectivity premise.
-/

@[expose] public noncomputable section

open CategoryTheory Limits Opposite Functor

namespace CategoryTheory.Sheaf.ModuleCoefficients

universe v u

variable {C : Type u} [Category.{v} C]
  {F G : Cᵒᵖ ⥤ AddCommGrpCat.{max u v}} (g : F ⟶ G)
  {W : C} (s : G.obj (op W))
  {ι : Type (max u v)} (U : ι → Over W)
  (hlift : ∀ i, Presheaf.imageSieve g s (U i).hom)

/-- Chosen lifts on a specified family, extended along its representables. -/
def familyLocalLiftSections :
    Presheaf.Cech.familyPresheaf (fun i => (U i).left) ⟶
      F ⋙ forget AddCommGrpCat where
  app X := ↾fun a => F.map a.2.op
    (Presheaf.localPreimage g s (U a.1).hom (hlift a.1))
  naturality X Y f := by
    ext a
    change F.map (f.unop ≫ a.2).op _ = F.map f (F.map a.2.op _)
    simp only [op_comp, Quiver.Hom.op_unop, Functor.map_comp]
    rfl

/-- The chosen family lifts retain the original map and target section. -/
lemma familyLocalLiftSections_comp :
    familyLocalLiftSections g s U hlift ≫ whiskerRight g (forget AddCommGrpCat) =
      Presheaf.Cech.familyMap U ≫ representedSection s := by
  ext X a
  change g.app X (F.map a.2.op _) = G.map (a.2 ≫ (U a.1).hom).op s
  rw [NatTrans.naturality_apply, Presheaf.app_localPreimage]
  simp only [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]

variable {g s}

/-- A covering representable family induces a locally surjective presheaf map. -/
theorem familyMap_locallySurjective_of_covering (J : GrothendieckTopology C)
    (hU : Sieve.ofArrows (fun i => (U i).left) (fun i => (U i).hom) ∈ J W) :
    Presheaf.IsLocallySurjective J (Presheaf.Cech.familyMap U) where
  imageSieve_mem {X} y := by
    apply J.superset_covering _ (J.pullback_stable y.down hU)
    intro V f hf
    obtain ⟨Z, a, b, ⟨i⟩, hab⟩ := hf
    refine ⟨⟨i, a⟩, ?_⟩
    apply ULift.ext
    exact hab

/-- A finite generating family supplies a finite covering family of actual
local lifts for every section of a locally surjective presheaf morphism. -/
theorem exists_finite_localLiftFamily (J : GrothendieckTopology C)
    (H : J.OneHypercoverFamily.{max u v}) [H.IsGenerating]
    (hfin : ∀ ⦃X : C⦄ (E : J.OneHypercover.{max u v} X), H E → Finite E.I₀)
    (g : F ⟶ G) [Presheaf.IsLocallySurjective J g]
    {W : C} (s : G.obj (op W)) :
    ∃ (ι : Type (max u v)) (_ : Finite ι) (U : ι → Over W),
      (Sieve.ofArrows (fun i => (U i).left) (fun i => (U i).hom) ∈ J W) ∧
      ∀ i, Presheaf.imageSieve g s (U i).hom := by
  obtain ⟨E, hE, hle⟩ := H.exists_oneHypercover
    (Presheaf.imageSieve g s) (Presheaf.imageSieve_mem J g s)
  exact ⟨E.I₀, hfin E hE, fun i => Over.mk (E.f i), E.mem₀,
    fun i => hle _ (E.sieve₀_f i)⟩

end CategoryTheory.Sheaf.ModuleCoefficients
