module

public import Aglib.CategoryTheory.Sites.SheafCohomology.Continuity.FiniteMulticospan
public import Mathlib.CategoryTheory.Sites.Hypercover.IsSheaf
public import Mathlib.CategoryTheory.Sites.Limits
public import Mathlib.CategoryTheory.Limits.Preserves.Shapes.Multiequalizer
public import Mathlib.CategoryTheory.Limits.Preserves.Finite
public import Mathlib.Basic.Finite.Sigma
public import Mathlib.Basic.Finite.Prod

/-! # Colimits of sheaves on a finite-hypercover site

If a topology is generated by `1`-hypercovers with finite sets of components
and relations, every coefficient colimit functor preserving finite limits
computes colimits of sheaves pointwise. The hypotheses concern finite covering
data and limits in the coefficient category, not cohomological continuity.

The hypercover index universe is independent of the diagram, coefficient,
and site universes. This applies to filtered colimits of abelian groups without
requiring all objects of a larger ambient site to be compact.
-/

@[expose] public noncomputable section

namespace CategoryTheory

open Limits Opposite

universe w v u vA uA vI uI

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
  {A : Type uA} [Category.{vA} A]
  {I : Type uI} [Category.{vI} I]

namespace GrothendieckTopology.OneHypercoverFamily

variable (H : J.OneHypercoverFamily.{w}) [H.IsGenerating]
  (hfin : ∀ ⦃X : C⦄ (E : J.OneHypercover.{w} X), H E →
    Finite E.I₀ ∧ ∀ i j : E.I₀, Finite (E.I₁ i j))
  [HasColimitsOfShape I A]
  [PreservesFiniteLimits (colim (J := I) (C := A))]

include H hfin in
/-- A pointwise coefficient colimit is a sheaf when finite matching diagrams
suffice to test the sheaf condition. -/
theorem isSheaf_pointwiseColimit (G : I ⥤ Sheaf J A) :
    Presheaf.IsSheaf J ((G ⋙ sheafToPresheaf J A).flip ⋙ colim) := by
  apply (H.isSheaf_iff _).2
  intro X E hE
  let : Finite E.I₀ := (hfin E hE).1
  let (i j : E.I₀) : Finite (E.I₁ i j) := (hfin E hE).2 i j
  let : Finite E.multicospanShape.L := inferInstanceAs (Finite E.I₀)
  let : Finite E.multicospanShape.R :=
    inferInstanceAs (Finite (Σ ij : E.I₀ × E.I₀, E.I₁ ij.1 ij.2))
  let P : Cᵒᵖ ⥤ I ⥤ A := (G ⋙ sheafToPresheaf J A).flip
  have hc : IsLimit (E.multifork P) := by
    apply evaluationJointlyReflectsLimits
    intro i
    exact (Multifork.isLimitMapEquiv (E.multifork P) ((evaluation I A).obj i)).symm
      (E.isLimitMultifork (G.obj i))
  exact ⟨Multifork.isLimitMapOfPreserves (E.multifork P) colim hc⟩

/-- Under finite-hypercover generation, the native inclusion of sheaves
preserves the given colimits. -/
abbrev preservesColimitsOfShapeSheafToPresheaf :
    PreservesColimitsOfShape I (sheafToPresheaf J A) where
  preservesColimit {G} := by
    suffices CreatesColimit G (sheafToPresheaf J A) from inferInstance
    refine Sheaf.createsColimitOfIsSheaf _ (fun c hc ↦ ?_)
    let e : c.pt ≅ (G ⋙ sheafToPresheaf J A).flip ⋙ colim :=
      hc.coconePointUniqueUpToIso (pointwiseIsColimit _)
    rw [Presheaf.isSheaf_of_iso_iff e]
    exact isSheaf_pointwiseColimit H hfin G

end GrothendieckTopology.OneHypercoverFamily

end CategoryTheory
