module

public import Mathlib.FieldTheory.KummerExtension
public import Mathlib.GroupTheory.SpecificGroups.Cyclic

/-! # Literal power generators of Kummer subextensions

Every intermediate field of a Kummer extension generated by the specified root
is generated by the specified power of that same root. The original field,
radicand and coefficient embedding are unchanged. Finite dimensionality,
Galoisness and cyclicity are constructed from the root and primitive-root
hypotheses, rather than supplied as comparison data.
-/

@[expose] public noncomputable section

open Polynomial Module

namespace IntermediateField

universe u v

variable {K : Type u} {F : Type v} [Field K] [Field F] [Algebra K F]

private theorem eq_of_finrank_eq_cyclic [FiniteDimensional K F] [IsGalois K F]
    [IsCyclic Gal(F/K)] (E D : IntermediateField K F)
    (h : finrank K E = finrank K D) : E = D := by
  apply IsGalois.intermediateFieldEquivSubgroup.injective
  change E.fixingSubgroup = D.fixingSubgroup
  apply le_antisymm
  · apply IsCyclic.subgroup_le_iff_index_dvd.mpr
    rw [← finrank_eq_fixingSubgroup_index, ← finrank_eq_fixingSubgroup_index, h]
  · apply IsCyclic.subgroup_le_iff_index_dvd.mpr
    rw [← finrank_eq_fixingSubgroup_index, ← finrank_eq_fixingSubgroup_index, h]

private theorem finrank_adjoin_le_of_pow {m : ℕ} (hm : 0 < m) {x : F} {b : K}
    (hx : x ^ m = algebraMap K F b) : finrank K K⟮x⟯ ≤ m := by
  have hp : aeval x (X ^ m - C b) = 0 := by simp [hx]
  have hi : IsIntegral K x := ⟨X ^ m - C b, monic_X_pow_sub_C b hm.ne', hp⟩
  rw [adjoin.finrank hi]
  exact (natDegree_le_natDegree (minpoly.min K x (monic_X_pow_sub_C b hm.ne') hp)).trans_eq
    natDegree_X_pow_sub_C

private theorem finrank_adjoin_pow {N e : ℕ}
    (hN : 0 < N) (he : 0 < e) (heN : e ∣ N) {a : K} {θ : F}
    (hθ : θ ^ N = algebraMap K F a) (hgen : K⟮θ⟯ = ⊤)
    (hdegree : finrank K F = N) : finrank K K⟮θ ^ (N / e)⟯ = e := by
  let D : IntermediateField K F := K⟮θ ^ (N / e)⟯
  have hd : 0 < N / e := Nat.div_pos (Nat.le_of_dvd hN heN) he
  have hβ : (θ ^ (N / e)) ^ e = algebraMap K F a := by
    rw [← pow_mul, Nat.div_mul_cancel heN, hθ]
  have hupper : finrank K D ≤ e := finrank_adjoin_le_of_pow he hβ
  let β : D := ⟨θ ^ (N / e), subset_adjoin K _ (Set.mem_singleton _)⟩
  have hgenD : D⟮θ⟯ = ⊤ := adjoin_eq_top_of_adjoin_eq_top K hgen
  have hupper' : finrank D F ≤ N / e := by
    have h := finrank_adjoin_le_of_pow (K := D) hd (x := θ) (b := β) rfl
    rw [hgenD] at h
    simpa only [finrank_top'] using h
  have htower : finrank K D * finrank D F = N :=
    (finrank_mul_finrank K D F).trans hdegree
  apply le_antisymm hupper
  refine Nat.le_of_mul_le_mul_right ?_ hd
  calc
    e * (N / e) = N := Nat.mul_div_cancel' heN
    _ = finrank K D * finrank D F := htower.symm
    _ ≤ finrank K D * (N / e) := Nat.mul_le_mul_left _ hupper'

/-- In the original Kummer extension, an intermediate field of degree `e` is
literally generated by `θ ^ (N / e)`. The degree is positive and divides `N`.
The primitive-root hypothesis retains the necessary characteristic guard. -/
theorem eq_adjoin_pow_of_kummer {N : ℕ} (hN : 0 < N) {a : K} {θ : F}
    (hθ : θ ^ N = algebraMap K F a) (hgen : K⟮θ⟯ = ⊤)
    (hirr : Irreducible (X ^ N - C a)) (hroots : (primitiveRoots N K).Nonempty)
    (E : IntermediateField K F) :
    0 < finrank K E ∧ finrank K E ∣ N ∧ E = K⟮θ ^ (N / finrank K E)⟯ := by
  have hp : aeval θ (X ^ N - C a) = 0 := by simp [hθ]
  have hi : IsIntegral K θ := ⟨X ^ N - C a, monic_X_pow_sub_C a hN.ne', hp⟩
  let : FiniteDimensional K K⟮θ⟯ := adjoin.finiteDimensional hi
  let : FiniteDimensional K F := FiniteDimensional.of_surjective K⟮θ⟯.val.toLinearMap (by
    intro x
    exact ⟨⟨x, by rw [hgen]; trivial⟩, rfl⟩)
  have hmin : minpoly K θ = X ^ N - C a :=
    (minpoly.eq_of_irreducible_of_monic hirr hp (monic_X_pow_sub_C a hN.ne')).symm
  have hdegree : finrank K F = N := by
    have h := adjoin.finrank hi
    rw [hgen] at h
    simpa only [finrank_top', hmin, natDegree_X_pow_sub_C] using h
  let : IsSplittingField K F (X ^ N - C a) := by
    have hs := isSplittingField_X_pow_sub_C_of_root_adjoin_eq_top
      (by simpa only [hdegree] using hroots)
      (by simpa only [hdegree] using hθ) hgen
    simpa only [hdegree] using hs
  let : IsGalois K F := isGalois_of_isSplittingField_X_pow_sub_C hroots hirr F
  let : NeZero N := ⟨hN.ne'⟩
  let : IsCyclic Gal(F/K) := isCyclic_of_isSplittingField_X_pow_sub_C hroots hirr F
  have he : 0 < finrank K E := finrank_pos
  have heN : finrank K E ∣ N := hdegree ▸ finrank_dvd_finrank_right K E F
  refine ⟨he, heN, eq_of_finrank_eq_cyclic E _ ?_⟩
  exact (finrank_adjoin_pow hN he heN hθ hgen hdegree).symm

end IntermediateField
