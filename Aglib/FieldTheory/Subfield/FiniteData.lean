module

public import Mathlib.Algebra.Field.Subfield.Basic
public import Mathlib.FieldTheory.Finiteness

/-!
# Finite subfield data

Source: `R5Lab.Aglib.FieldTheory.Subfield.FiniteData`,
revision `f8a3314ddecffcada2ec721d26d56a937bed9690`. Exact field, action, embedding and
explicit-data hypotheses are retained. Native objects and maps are reused.
-/

@[expose] public section

namespace Subfield
universe u v
variable {K : Type u} [Field K]
/-- A unit viewed in a subfield containing its value. -/
noncomputable def restrictUnit (E : Subfield K) (a : Kˣ) (ha : (a : K) ∈ E) : Eˣ :=
  Units.mk0 ⟨(a : K), ha⟩ (by
    intro h
    exact a.ne_zero (congrArg (fun x : E => (x : K)) h))

@[simp] theorem restrictUnit_val (E : Subfield K) (a : Kˣ) (ha : (a : K) ∈ E) :
    ((restrictUnit E a ha : E) : K) = (a : K) := rfl

theorem map_restrictUnit (E : Subfield K) (a : Kˣ) (ha : (a : K) ∈ E) :
    Units.map E.subtype.toMonoidHom (restrictUnit E a ha) = a := by
  apply Units.ext
  rfl

theorem inclusion_restrictUnit {E F : Subfield K} (hEF : E ≤ F)
    (a : Kˣ) (ha : (a : K) ∈ E) :
    Units.map (Subfield.inclusion hEF).toMonoidHom (restrictUnit E a ha) =
      restrictUnit F a (hEF ha) := by
  apply Units.ext
  rfl

@[simp] theorem restrictUnit_mul (E : Subfield K) (a b : Kˣ)
    (ha : (a : K) ∈ E) (hb : (b : K) ∈ E) :
    restrictUnit E (a * b) (E.mul_mem ha hb) = restrictUnit E a ha * restrictUnit E b hb := by
  apply Units.ext
  rfl

/-- The subfield generated by a specified base subfield and finitely many
additional field elements. With base `⊥`, this is generation over the prime field. -/
def generatedSubfield (base : Subfield K) (s : Finset K) : Subfield K :=
  base ⊔ Subfield.closure (s : Set K)

theorem generatedSubfield_mono (base : Subfield K) : Monotone (generatedSubfield base) := by
  intro s t hst
  exact sup_le_sup_left (Subfield.closure_mono (by exact hst)) base

theorem mem_generatedSubfield (base : Subfield K) (s : Finset K) {x : K} (hx : x ∈ s) :
    x ∈ generatedSubfield base s :=
  (show Subfield.closure (s : Set K) ≤ generatedSubfield base s from le_sup_right)
    (Subfield.subset_closure hx)

theorem generatedSubfield_le {base E : Subfield K} {s : Finset K}
    (hbase : base ≤ E) (hs : (s : Set K) ⊆ E) : generatedSubfield base s ≤ E :=
  sup_le hbase (Subfield.closure_le.mpr hs)

/-- The subfield closure of a finite set is a finitely generated field over
its prime field, in Mathlib's `Field.FG` sense. -/
theorem closure_finset_fg (s : Finset K) : Field.FG (Subfield.closure (s : Set K)) := by
  classical
  let E := Subfield.closure (s : Set K)
  let t : Finset E := s.attach.image (fun x => ⟨x.val, Subfield.subset_closure x.property⟩)
  refine ⟨⟨t, ?_⟩⟩
  apply top_unique
  intro x hx
  have h : E ≤ (Subfield.closure (t : Set E)).map E.subtype := by
    apply Subfield.closure_le.mpr
    intro y hy
    apply Subfield.mem_map.mpr
    refine ⟨⟨y, Subfield.subset_closure hy⟩, Subfield.subset_closure ?_, rfl⟩
    exact Finset.mem_image.mpr ⟨⟨y, hy⟩, Finset.mem_attach _ _, rfl⟩
  exact (Subfield.map_mem_map E.subtype).mp (h x.property)

end Subfield
