module

public import Mathlib.FieldTheory.TranscendentalSeparable
public import Mathlib.FieldTheory.FinTrdeg
public import Mathlib.Data.Fintype.EquivFin

/-! # Finite separating bases with their actual transcendence degree

The separating set comes from `IsSeparablyGenerated`; essential finite type
makes that same set finite. Reindexing does not change its adjoined field.
-/

@[expose] public noncomputable section

open scoped IntermediateField.algebraAdjoinAdjoin

namespace Algebra.IsSeparablyGenerated

variable (k K : Type*) [Field k] [Field K] [Algebra k K]

/-- An essentially finite-type separably generated field extension has a
finite separating basis, with the genuine transcendence degree and a finite
extension over the field generated by this same basis. -/
theorem exists_fin_isTranscendenceBasis_and_finite
    [Algebra.EssFiniteType k K] [Algebra.IsSeparablyGenerated k K] :
    ∃ (d : ℕ) (t : Fin d → K),
      IsTranscendenceBasis k t ∧ Algebra.trdeg k K = (d : Cardinal) ∧
        Module.Finite (IntermediateField.adjoin k (Set.range t)) K ∧
        Algebra.IsSeparable (IntermediateField.adjoin k (Set.range t)) K := by
  classical
  obtain ⟨s, hs, hsep⟩ := (inferInstance : Algebra.IsSeparablyGenerated k K)
  let : Finite s := finite_of_isTranscendenceBasis hs
  let : Fintype s := Fintype.ofFinite s
  let e : Fin (Fintype.card s) ≃ s := (Fintype.equivFin s).symm
  let t : Fin (Fintype.card s) → K := fun i => (e i : K)
  have ht : IsTranscendenceBasis k t := hs.comp_equiv e
  have hrange : Set.range t = s := by
    ext x
    constructor
    · rintro ⟨i, rfl⟩
      exact (e i).property
    · intro hx
      refine ⟨e.symm ⟨x, hx⟩, ?_⟩
      simp only [t, Equiv.apply_symm_apply]
  have hsep' : Algebra.IsSeparable (IntermediateField.adjoin k (Set.range t)) K := by
    rwa [hrange]
  let := hsep'
  let : Algebra.EssFiniteType (IntermediateField.adjoin k (Set.range t)) K :=
    Algebra.EssFiniteType.of_comp k _ K
  refine ⟨Fintype.card s, t, ht, ?_,
    Algebra.finite_of_essFiniteType_of_isAlgebraic, hsep'⟩
  simpa using ht.lift_cardinalMk_eq_trdeg.symm

end Algebra.IsSeparablyGenerated

namespace IsTranscendenceBasis

variable {k K ι : Type*} [Field k] [Field K] [Algebra k K] [Fintype ι]

/-- The size of an actual finite transcendence basis is bounded by the size
of any actual finite field-generating family. No differential-rank argument
and no specially chosen generators are needed. -/
theorem fin_le_card_of_adjoin_eq_top {d : ℕ} {t : Fin d → K}
    (ht : IsTranscendenceBasis k t) (x : ι → K)
    (hx : IntermediateField.adjoin k (Set.range x) = ⊤) :
    d ≤ Fintype.card ι := by
  let : Algebra.IsAlgebraic (IntermediateField.adjoin k (Set.range x)) K := by
    rw [hx]
    infer_instance
  let : Algebra.IsAlgebraic (Algebra.adjoin k (Set.range x)) K :=
    Algebra.IsAlgebraic.trans (Algebra.adjoin k (Set.range x))
      (IntermediateField.adjoin k (Set.range x)) K
  have hdegree : Algebra.trdeg k K = (d : Cardinal) := by
    simpa using ht.lift_cardinalMk_eq_trdeg.symm
  have hle := (Cardinal.lift_le.mpr
    (Algebra.IsAlgebraic.trdeg_le_cardinalMk k (Set.range x))).trans
      (Cardinal.mk_range_le_lift (f := x))
  simpa [hdegree] using hle

end IsTranscendenceBasis
