namespace Units.CyclicQuotient

/-- A nonzero integer-valued homomorphism has an actual preimage of the positive
cyclic generator of its image. The generator and all exponent witnesses are outputs. -/
theorem exists_positive_image_generator {L : Type u} [Group L]
    (f : L →* Multiplicative ℤ) (x₀ : L) (h₀ : f x₀ ≠ 1) :
    ∃ t : L, 0 < (f t).toAdd ∧ ∀ x : L, ∃ z : ℤ, f x = f t ^ z := by
  obtain ⟨g, hg⟩ := (Subgroup.isCyclic_iff_exists_zpowers_eq_top f.range).mp inferInstance
  have hgm : g ∈ f.range := hg ▸ Subgroup.mem_zpowers g
  obtain ⟨t, ht⟩ := hgm
  have hgen : ∀ x : L, ∃ z : ℤ, f x = g ^ z := by
    intro x
    have hx : f x ∈ Subgroup.zpowers g := hg.symm ▸ (show f x ∈ f.range from ⟨x, rfl⟩)
    obtain ⟨z, hz⟩ := Subgroup.mem_zpowers_iff.mp hx
    exact ⟨z, hz.symm⟩
  have hg0 : g.toAdd ≠ 0 := by
    intro h
    have he : g = 1 := Multiplicative.toAdd.injective h
    obtain ⟨z, hz⟩ := hgen x₀
    exact h₀ (by simpa [he] using hz)
  rcases lt_or_gt_of_ne hg0 with hneg | hpos
  · refine ⟨t⁻¹, ?_, ?_⟩
    · simpa [ht] using neg_pos.mpr hneg
    · intro x
      obtain ⟨z, hz⟩ := hgen x
      refine ⟨-z, ?_⟩
      simpa [ht] using hz
  · exact ⟨t, ht ▸ hpos, fun x => by simpa [ht] using hgen x⟩

variable {G : Type u} [CommGroup G] (q : G)

/-- The actual inverse-image subgroup has a positive exponent generator. -/
theorem exists_positive_period_generator
    (hq : Function.Injective (fun z : ℤ => q ^ z))
    (H : Subgroup (QuotientGroup.CyclicQuotient q)) [Finite H] :
    ∃ t : liftedSubgroup q H,
      0 < periodExponent q H t ∧
      ∀ x : liftedSubgroup q H, ∃ z : ℤ,
        exponentHom q hq H x = exponentHom q hq H t ^ z :=
  exists_positive_image_generator (exponentHom q hq H) (periodLift q H)
    (exponentHom_period_ne_one q hq H)

/-- Zero exponent is exactly the torsion relation imposed by the actual finite
subgroup cardinality. -/
theorem periodExponent_eq_zero_iff
    (hq : Function.Injective (fun z : ℤ => q ^ z))
    (H : Subgroup (QuotientGroup.CyclicQuotient q)) (x : liftedSubgroup q H) :
    periodExponent q H x = 0 ↔ (x : G) ^ Nat.card H = 1 := by
  constructor
  · intro h
    simpa [h] using (periodExponent_spec q H x).symm
  · intro h
    apply hq
    simpa [h] using periodExponent_spec q H x

end Units.CyclicQuotient

