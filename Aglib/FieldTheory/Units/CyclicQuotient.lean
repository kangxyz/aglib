namespace Units.CyclicQuotient
variable {K : Type u} [Field K]

/-- A constructed generator presentation of a literal finite subgroup of a
period quotient. The torsion order is the actual cardinality of the torsion
subgroup, and the map is the preexisting quotient of the power homomorphism. -/
structure KernelNormalForm (q : Kˣ)
    (hq : Function.Injective (fun z : ℤ => q ^ z))
    (H : Subgroup (QuotientGroup.CyclicQuotient q)) where
  t : liftedSubgroup q H
  positive : 0 < periodExponent q H t
  generates : ∀ x : liftedSubgroup q H, ∃ z : ℤ,
    exponentHom q hq H x = exponentHom q hq H t ^ z
  b : ℕ
  b_pos : 0 < b
  index_relation : (Nat.card H : ℤ) = (b : ℤ) * periodExponent q H t
  relation : q ^ Nat.card (torsionSubgroup q H) =
    ((t : Kˣ) ^ Nat.card (torsionSubgroup q H)) ^ b
  kernel_eq : H = (QuotientGroup.zpowersPowerMap q
    ((t : Kˣ) ^ Nat.card (torsionSubgroup q H))
    (Nat.card (torsionSubgroup q H)) b relation).ker

/-- The positive generator's period index is constructed from the image of
q itself, rather than supplied as a numerical certificate. -/
theorem positive_period_index (q : Kˣ)
    (hq : Function.Injective (fun z : ℤ => q ^ z))
    (H : Subgroup (QuotientGroup.CyclicQuotient q)) [Finite H]
    (t : liftedSubgroup q H) (hpos : 0 < periodExponent q H t)
    (ht : ∀ x : liftedSubgroup q H, ∃ z : ℤ,
      exponentHom q hq H x = exponentHom q hq H t ^ z) :
    ∃ b : ℕ, 0 < b ∧
      (Nat.card H : ℤ) = (b : ℤ) * periodExponent q H t ∧
      q / (t : Kˣ) ^ b ∈ torsionSubgroup q H := by
  obtain ⟨z, hz⟩ := ht (periodLift q H)
  have he := congrArg Multiplicative.toAdd hz
  change periodExponent q H (periodLift q H) = z * periodExponent q H t at he
  rw [periodExponent_periodLift q hq H] at he
  have hN : (0 : ℤ) < Nat.card H := by exact_mod_cast Nat.card_pos (α := H)
  have hzpos : 0 < z := by
    nlinarith
  refine ⟨z.toNat, by omega, ?_, ?_⟩
  · simpa [Int.toNat_of_nonneg hzpos.le] using he
  · have hu : exponentHom q hq H (periodLift q H / t ^ z) = 1 := by
      rw [map_div, map_zpow, hz, div_self']
    have hm := (mem_torsionSubgroup_iff q hq H _).mpr hu
    simpa only [Subgroup.coe_div, Subgroup.coe_zpow, periodLift,
      ← zpow_natCast, Int.toNat_of_nonneg hzpos.le] using hm

/-- Equality of the actual lifted subgroup with the power preimage is derived
from the cyclic-generator decomposition and its finite torsion kernel. -/
theorem liftedSubgroup_eq_power_preimage (q : Kˣ)
    (hq : Function.Injective (fun z : ℤ => q ^ z))
    (H : Subgroup (QuotientGroup.CyclicQuotient q)) [Finite H]
    (t : liftedSubgroup q H)
    (ht : ∀ x : liftedSubgroup q H, ∃ z : ℤ,
      exponentHom q hq H x = exponentHom q hq H t ^ z) :
    liftedSubgroup q H =
      (Subgroup.zpowers ((t : Kˣ) ^ Nat.card (torsionSubgroup q H))).comap
        (powMonoidHom (Nat.card (torsionSubgroup q H))) := by
  let a := Nat.card (torsionSubgroup q H)
  have hJ : torsionSubgroup q H = rootsOfUnity a K :=
    torsionSubgroup_eq_rootsOfUnity q H
  ext x
  change x ∈ liftedSubgroup q H ↔ x ^ a ∈ Subgroup.zpowers ((t : Kˣ) ^ a)
  constructor
  · intro hx
    obtain ⟨z, hz⟩ := quotient_generator_decomposition q hq H t ht ⟨x, hx⟩
    rw [hJ, mem_rootsOfUnity, div_pow, div_eq_one] at hz
    exact Subgroup.mem_zpowers_iff.mpr ⟨z, by simpa [← zpow_natCast, ← zpow_mul, mul_comm] using
      hz.symm⟩
  · intro hx
    obtain ⟨z, hz⟩ := Subgroup.mem_zpowers_iff.mp hx
    have hu : x / (t : Kˣ) ^ z ∈ torsionSubgroup q H := by
      rw [hJ, mem_rootsOfUnity, div_pow, div_eq_one]
      simpa [← zpow_natCast, ← zpow_mul, mul_comm] using hz.symm
    have hm := (liftedSubgroup q H).mul_mem hu.1 ((liftedSubgroup q H).zpow_mem t.property z)
    simpa using hm

/-- Every actual finite subgroup of the period quotient has a normal form.
There is no algebraic-isogeny, power-map or classification premise. -/
theorem kernelNormalForm_nonempty (q : Kˣ)
    (hq : Function.Injective (fun z : ℤ => q ^ z))
    (H : Subgroup (QuotientGroup.CyclicQuotient q)) [Finite H] :
    Nonempty (KernelNormalForm q hq H) := by
  obtain ⟨t, hpos, ht⟩ := exists_positive_period_generator q hq H
  obtain ⟨b, hb, hindex, htors⟩ := positive_period_index q hq H t hpos ht
  let a := Nat.card (torsionSubgroup q H)
  have hrel : q ^ a = ((t : Kˣ) ^ a) ^ b := by
    rw [torsionSubgroup_eq_rootsOfUnity, mem_rootsOfUnity,
      div_pow, div_eq_one] at htors
    simpa only [← pow_mul, Nat.mul_comm] using htors
  refine ⟨⟨t, hpos, ht, b, hb, hindex, hrel, ?_⟩⟩
  apply Subgroup.comap_injective (QuotientGroup.mk'_surjective (Subgroup.zpowers q))
  change liftedSubgroup q H = _
  refine (liftedSubgroup_eq_power_preimage q hq H t ht).trans ?_
  ext x
  change x ^ a ∈ Subgroup.zpowers ((t : Kˣ) ^ a) ↔
    QuotientGroup.zpowersPowerMap q ((t : Kˣ) ^ a) a b hrel (QuotientGroup.mk x) = 1
  rw [QuotientGroup.zpowersPowerMap_mk, QuotientGroup.eq_one_iff]

/-- An actual normal form, selected only after its existence has been proved. -/
def kernelNormalForm (q : Kˣ)
    (hq : Function.Injective (fun z : ℤ => q ^ z))
    (H : Subgroup (QuotientGroup.CyclicQuotient q)) [Finite H] : KernelNormalForm q hq H :=
  Classical.choice (kernelNormalForm_nonempty q hq H)

end Units.CyclicQuotient

