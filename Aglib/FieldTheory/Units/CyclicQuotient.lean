variable {K : Type u} [Field K] (q : Kˣ) (σ : K ≃+* K)

/-- The actual quotient action induced by a field automorphism fixing the
period. This map is constructed from the units action, not supplied separately. -/
def periodQuotientAction (hfix : Units.map σ.toMonoidHom q = q) :
    QuotientGroup.CyclicQuotient q →* QuotientGroup.CyclicQuotient q :=
  QuotientGroup.map _ _ (Units.map σ.toMonoidHom) (by
    apply Subgroup.zpowers_le.mpr
    change Units.map σ.toMonoidHom q ∈ Subgroup.zpowers q
    rw [hfix]
    exact Subgroup.mem_zpowers q)

@[simp] theorem periodQuotientAction_mk
    (hfix : Units.map σ.toMonoidHom q = q) (x : Kˣ) :
    periodQuotientAction q σ hfix (QuotientGroup.mk x) =
      QuotientGroup.mk (Units.map σ.toMonoidHom x) := rfl

variable (hfix : Units.map σ.toMonoidHom q = q)
  (H : Subgroup (QuotientGroup.CyclicQuotient q))
  (hH : ∀ y ∈ H, periodQuotientAction q σ hfix y ∈ H)

/-- Stability of the actual quotient subgroup induces a map on its literal
inverse image. The stability hypothesis has not been derived from a scheme. -/
def liftedAction : liftedSubgroup q H →* liftedSubgroup q H where
  toFun x := ⟨Units.map σ.toMonoidHom (x : Kˣ), hH _ x.property⟩
  map_one' := Subtype.ext (map_one _)
  map_mul' x y := Subtype.ext (map_mul _ (x : Kˣ) (y : Kˣ))

/-- The constructed exponent is fixed because the automorphism fixes q;
there is no norm-preservation premise. -/
theorem periodExponent_liftedAction
    (hq : Function.Injective (fun z : ℤ => q ^ z))
    (x : liftedSubgroup q H) :
    periodExponent q H (liftedAction q σ hfix H hH x) = periodExponent q H x := by
  apply hq
  calc
    q ^ periodExponent q H (liftedAction q σ hfix H hH x) =
        (Units.map σ.toMonoidHom (x : Kˣ)) ^ Nat.card H :=
      periodExponent_spec q H _
    _ = Units.map σ.toMonoidHom ((x : Kˣ) ^ Nat.card H) := (map_pow _ _ _).symm
    _ = Units.map σ.toMonoidHom (q ^ periodExponent q H x) :=
      congrArg (Units.map σ.toMonoidHom) (periodExponent_spec q H x).symm
    _ = q ^ periodExponent q H x := by rw [map_zpow, hfix]

include hfix hH in
/-- An automorphism fixing q and stabilizing the actual finite subgroup fixes
the constructed period. This proves invariance only, not original-field descent. -/
theorem KernelNormalForm.period_fixed [Finite H]
    (hq : Function.Injective (fun z : ℤ => q ^ z))
    (N : KernelNormalForm q hq H) : Units.map σ.toMonoidHom N.p = N.p := by
  have he : exponentHom q hq H (liftedAction q σ hfix H hH N.t) =
      exponentHom q hq H N.t :=
    Multiplicative.toAdd.injective (periodExponent_liftedAction q σ hfix H hH hq N.t)
  have hu : (((liftedAction q σ hfix H hH N.t) / N.t : liftedSubgroup q H) : Kˣ) ∈
      torsionSubgroup q H := by
    rw [mem_torsionSubgroup_iff q hq H, map_div, he, div_self']
  change Units.map σ.toMonoidHom (N.t : Kˣ) / (N.t : Kˣ) ∈ torsionSubgroup q H at hu
  rw [N.torsion_eq, mem_rootsOfUnity, div_pow, div_eq_one] at hu
  simpa only [KernelNormalForm.p, map_pow] using hu

include hfix hH in
/-- Invariance of the period returned by the proved normal-form construction. -/
theorem constructed_period_fixed [Finite H]
    (hq : Function.Injective (fun z : ℤ => q ^ z)) :
    Units.map σ.toMonoidHom (kernelNormalForm q hq H).p = (kernelNormalForm q hq H).p :=
  KernelNormalForm.period_fixed (q := q) (σ := σ) (hfix := hfix)
    (H := H) (hH := hH) (hq := hq) (kernelNormalForm q hq H)

end Units.CyclicQuotient

end

end FiniteKernelConstruction
