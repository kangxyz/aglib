namespace Units.CyclicQuotient
variable {G : Type u} [CommGroup G] (q : G)

/-- The literal inverse image of a subgroup of the period quotient. -/
def liftedSubgroup (H : Subgroup (QuotientGroup.CyclicQuotient q)) : Subgroup G :=
  H.comap (QuotientGroup.mk' (Subgroup.zpowers q))

/-- Its elements have an actual power in the period lattice, derived from the
cardinality of the given finite subgroup rather than a supplied normal form. -/
theorem power_mem_periods (H : Subgroup (QuotientGroup.CyclicQuotient q))
    (x : liftedSubgroup q H) : (x : G) ^ Nat.card H ∈ Subgroup.zpowers q := by
  have h := congrArg (fun y : H => (y : QuotientGroup.CyclicQuotient q))
    (pow_card_eq_one' (x := (⟨QuotientGroup.mk (x : G), x.property⟩ : H)))
  apply (QuotientGroup.eq_one_iff _).mp
  simpa only [Subgroup.coe_pow, Subgroup.coe_one, QuotientGroup.mk_pow] using h

theorem exists_period_exponent (H : Subgroup (QuotientGroup.CyclicQuotient q))
    (x : liftedSubgroup q H) : ∃ z : ℤ, q ^ z = (x : G) ^ Nat.card H :=
  Subgroup.mem_zpowers_iff.mp (power_mem_periods q H x)

/-- The actual integer exponent of the cardinality power in the period lattice. -/
def periodExponent (H : Subgroup (QuotientGroup.CyclicQuotient q)) (x : liftedSubgroup q H) : ℤ :=
  (exists_period_exponent q H x).choose

theorem periodExponent_spec (H : Subgroup (QuotientGroup.CyclicQuotient q))
    (x : liftedSubgroup q H) : q ^ periodExponent q H x = (x : G) ^ Nat.card H :=
  (exists_period_exponent q H x).choose_spec

/-- The integer-valued lattice map is constructed by uniqueness of period
powers. Its eventual positive image generator is an output still to derive. -/
def exponentHom (hq : Function.Injective (fun z : ℤ => q ^ z))
    (H : Subgroup (QuotientGroup.CyclicQuotient q)) : liftedSubgroup q H →* Multiplicative ℤ where
  toFun x := Multiplicative.ofAdd (periodExponent q H x)
  map_one' := by
    apply Multiplicative.toAdd.injective
    apply hq
    simpa using periodExponent_spec q H 1
  map_mul' x y := by
    apply Multiplicative.toAdd.injective
    apply hq
    change q ^ periodExponent q H (x * y) = q ^ (periodExponent q H x + periodExponent q H y)
    rw [zpow_add, periodExponent_spec, periodExponent_spec, periodExponent_spec]
    exact mul_pow (x : G) (y : G) _

/-- The original period is an actual element of the inverse-image subgroup. -/
def periodLift (H : Subgroup (QuotientGroup.CyclicQuotient q)) : liftedSubgroup q H :=
  ⟨q, by
    change QuotientGroup.mk q ∈ H
    have hq : (QuotientGroup.mk q : QuotientGroup.CyclicQuotient q) = 1 :=
      (QuotientGroup.eq_one_iff q).mpr (Subgroup.mem_zpowers q)
    rw [hq]
    exact H.one_mem⟩

theorem periodExponent_periodLift
    (hq : Function.Injective (fun z : ℤ => q ^ z))
    (H : Subgroup (QuotientGroup.CyclicQuotient q)) :
    periodExponent q H (periodLift q H) = (Nat.card H : ℤ) := by
  apply hq
  simpa only [periodLift, zpow_natCast] using periodExponent_spec q H (periodLift q H)

/-- The image is genuinely nonzero for a finite actual subgroup. -/
theorem exponentHom_period_ne_one
    (hq : Function.Injective (fun z : ℤ => q ^ z))
    (H : Subgroup (QuotientGroup.CyclicQuotient q)) [Finite H] :
    exponentHom q hq H (periodLift q H) ≠ 1 := by
  intro h
  have he := congrArg Multiplicative.toAdd h
  change periodExponent q H (periodLift q H) = 0 at he
  rw [periodExponent_periodLift q hq H] at he
  have hp : 0 < Nat.card H := Nat.card_pos
  omega

end Units.CyclicQuotient

end

