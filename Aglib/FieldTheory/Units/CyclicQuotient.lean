namespace Units.CyclicQuotient
variable {K : Type u} [Field K]

/-- The literal finite-order part of the lifted subgroup. -/
def torsionSubgroup (q : Kˣ) (H : Subgroup (QuotientGroup.CyclicQuotient q)) : Subgroup Kˣ :=
  liftedSubgroup q H ⊓ rootsOfUnity (Nat.card H) K

instance torsionSubgroup_finite (q : Kˣ) (H : Subgroup (QuotientGroup.CyclicQuotient q))
    [Finite H] : Finite (torsionSubgroup q H) := by
  let : NeZero (Nat.card H) := ⟨Nat.card_pos.ne'⟩
  exact Finite.of_injective
    (fun x : torsionSubgroup q H => (⟨x.val, x.property.2⟩ : rootsOfUnity (Nat.card H) K))
    (fun x y h => Subtype.ext (congrArg (fun y : rootsOfUnity (Nat.card H) K => (y : Kˣ)) h))

/-- Every finite subgroup of a field's units is all the roots of unity of its
own order. Only the polynomial root bound is needed, with no assumed primitive root. -/
theorem finite_subgroup_eq_rootsOfUnity (J : Subgroup Kˣ) [Finite J] :
    J = rootsOfUnity (Nat.card J) K := by
  let : NeZero (Nat.card J) := ⟨Nat.card_pos.ne'⟩
  apply Subgroup.eq_of_le_of_card_ge
  · intro x hx
    rw [mem_rootsOfUnity]
    exact congrArg (fun y : J => (y : Kˣ)) (pow_card_eq_one' (x := (⟨x, hx⟩ : J)))
  · exact card_rootsOfUnity (k := Nat.card J) (R := K)

/-- The actual torsion kernel has the complete roots-of-unity form. -/
theorem torsionSubgroup_eq_rootsOfUnity (q : Kˣ) (H : Subgroup (QuotientGroup.CyclicQuotient q))
    [Finite H] :
    torsionSubgroup q H = rootsOfUnity (Nat.card (torsionSubgroup q H)) K :=
  finite_subgroup_eq_rootsOfUnity _

/-- The constructed exponent homomorphism has exactly this torsion kernel. -/
theorem mem_torsionSubgroup_iff (q : Kˣ)
    (hq : Function.Injective (fun z : ℤ => q ^ z))
    (H : Subgroup (QuotientGroup.CyclicQuotient q)) (x : liftedSubgroup q H) :
    (x : Kˣ) ∈ torsionSubgroup q H ↔ exponentHom q hq H x = 1 := by
  change ((x : Kˣ) ∈ liftedSubgroup q H ∧ (x : Kˣ) ∈ rootsOfUnity (Nat.card H) K) ↔ _
  rw [and_iff_right x.property, mem_rootsOfUnity, ← periodExponent_eq_zero_iff q hq H x]
  exact Multiplicative.ofAdd.injective.eq_iff.symm

/-- A preimage of a cyclic image generator generates the lifted subgroup up to
its actual finite torsion kernel. -/
theorem quotient_generator_decomposition (q : Kˣ)
    (hq : Function.Injective (fun z : ℤ => q ^ z))
    (H : Subgroup (QuotientGroup.CyclicQuotient q))
    (t : liftedSubgroup q H)
    (ht : ∀ x : liftedSubgroup q H, ∃ z : ℤ,
      exponentHom q hq H x = exponentHom q hq H t ^ z)
    (x : liftedSubgroup q H) :
    ∃ z : ℤ, (x : Kˣ) / (t : Kˣ) ^ z ∈ torsionSubgroup q H := by
  obtain ⟨z, hz⟩ := ht x
  refine ⟨z, ?_⟩
  change ((x / t ^ z : liftedSubgroup q H) : Kˣ) ∈ torsionSubgroup q H
  rw [mem_torsionSubgroup_iff q hq H, map_div, map_zpow, hz, div_self']

end Units.CyclicQuotient

end

