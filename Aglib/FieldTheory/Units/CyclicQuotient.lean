@[expose] public section

namespace QuotientGroup

/-- The literal quotient of a commutative group by the cyclic subgroup generated by q. -/
abbrev CyclicQuotient {G : Type*} [CommGroup G] (q : G) := G ⧸ Subgroup.zpowers q

end QuotientGroup

universe u

/-!
## Constructed finite subgroup kernels of actual cyclic period quotients

The subgroup constructions below construct the finite-subgroup normal form,
its exact power-map kernel/cardinality, algebraicity of the output period, and
invariance under actual automorphisms fixing q and preserving the subgroup.
No arbitrary algebraic-isogeny classification, scheme-kernel identification,
or original-field descent from a completed closure is asserted.
-/

section FiniteKernelConstruction
universe v

