namespace Units.CyclicQuotient
variable {F : Type u} {K : Type v} [Field F] [Field K] [Algebra F K]

/-- Every representative of a finite quotient subgroup is algebraic over the
original field. This is proved before making any claim about Galois-fixed
points of a completed algebraic closure. -/
theorem lifted_element_integral (q : Fˣ)
    (H : Subgroup (QuotientGroup.CyclicQuotient (Units.map (algebraMap F K).toMonoidHom q)))
    [Finite H]
    (x : liftedSubgroup (Units.map (algebraMap F K).toMonoidHom q) H) :
    IsIntegral F ((x : Kˣ) : K) := by
  obtain ⟨z, hz⟩ := exists_period_exponent _ H x
  apply IsIntegral.of_pow (Nat.card_pos (α := H))
  have h := congrArg (fun y : Kˣ => (y : K)) hz
  have hp : (((x : Kˣ) : K) ^ Nat.card H) = algebraMap F K ((q : F) ^ z) := by
    simpa using h.symm
  rw [hp]
  exact isIntegral_algebraMap

end Units.CyclicQuotient

end

