module

public import Aglib.KTheory.MilnorK.StageLift
public import Aglib.KTheory.MilnorK.DegreeGeneration
public import Aglib.KTheory.MilnorK.Residue.Polynomial.Support

/-!
# Mixed-symbol generation under an explicit polynomial degree gap

If every monic irreducible polynomial of degree smaller than a specified
irreducible `p` is linear, then the actual Milnor group of `AdjoinRoot p` is
spanned by symbols with base-field entries except for their last entry.
This is the degree-gap case of Bass--Tate I, Corollary 5.3, used on p. 388.

The proof specializes actual rational polynomial stages. It constructs no
prime-special closure and asserts no independence of polynomial norms. Degree
one moduli and the empty base tuple are included.
-/

@[expose] public noncomputable section

namespace MilnorK

open Polynomial

variable {k E : Type*} [Field k] [Field E]

/-- The integer span of actual symbols with a base-field prefix and one final
extension-field unit. This is a submodule of the original Milnor group. -/
def mixedSpan (φ : k →+* E) (m : ℕ) : Submodule ℤ (K E (m + 1)) :=
  Submodule.span ℤ {z | ∃ (a : SymbolTuple k m) (b : Eˣ),
    z = symbol (Fin.snoc (Units.map φ.toMonoidHom ∘ a) b)}

namespace DegreeFiltration

open PolynomialResidue

/-- With no nonlinear irreducibles below the bound, the actual polynomial
stage is contained in the stage generated by constants and linear polynomials. -/
theorem lower_le_lower_two_of_degree_gap (n d : ℕ)
    (hgap : ∀ q : MonicIrreducible k, q.val.natDegree < d → q.val.natDegree = 1) :
    lower k (n + 1) d ≤ lower k (n + 1) 2 := by
  induction d with
  | zero => exact lower_mono (by omega)
  | succ d ih =>
    by_cases hd : d = 0
    · subst d
      exact lower_mono (by omega)
    · rw [lower_succ_eq d (Nat.pos_of_ne_zero hd)]
      refine sup_le (ih (fun q hq => hgap q (by omega))) ?_
      apply Submodule.span_le.mpr
      rintro x ⟨q, a, hq, ha, hqm, hqi, hqd, had, rfl⟩
      have hd1 : d = 1 := hqd.symm.trans (hgap ⟨q, hqm, hqi⟩ (by simp [hqd]))
      rw [hd1] at hqd had
      rw [lower_succ_eq 1 (by omega)]
      exact top_mem 1 q a hq ha hqm hqi hqd had

variable (p : k[X]) [Fact (Irreducible p)]

private theorem specialize_polynomial_mem_mixed (m : ℕ) (a : Fin (m + 1) → k[X])
    (ha : ∀ i, a i ≠ 0) (hpa : ∀ i, ¬ p ∣ a i)
    (hsmall : ∀ i : Fin m, (a i.castSucc).natDegree < 1) :
    specializeAt p (m + 1) (symbol (polynomialTuple a ha)) ∈
      mixedSpan (algebraMap k (AdjoinRoot p)) m := by
  have hc : ∀ i : Fin m, ∃ c : k, C c = a i.castSucc := fun i =>
    natDegree_eq_zero.mp (Nat.lt_one_iff.mp (hsmall i))
  choose c hc using hc
  let u : SymbolTuple k m := fun i => Units.mk0 (c i) (by
    intro hz
    exact ha i.castSucc (by rw [← hc i, hz, map_zero]))
  change specializeAt p (m + 1)
    (symbol (fun i => PolynomialResidue.polynomialUnit (a i) (ha i))) ∈ _
  rw [specializeAt_polynomial_units p (m + 1) a ha hpa]
  apply Submodule.subset_span
  refine ⟨u, quotientUnit p (a (Fin.last m)) (hpa (Fin.last m)), ?_⟩
  congr 1
  funext i
  refine Fin.lastCases ?_ (fun j => ?_) i
  · simp only [Fin.snoc_last]
  · simp only [Fin.snoc_castSucc, Function.comp_apply]
    apply Units.ext
    change AdjoinRoot.mk p (a j.castSucc) = algebraMap k (AdjoinRoot p) (c j)
    rw [← hc j]
    rfl

/-- Constant polynomial symbols specialize to mixed symbols, even for a linear
modulus and in degree one. -/
theorem lower_one_le_comap_specialize_mixed (m : ℕ) :
    lower k (m + 1) 1 ≤
      (mixedSpan (algebraMap k (AdjoinRoot p)) m).comap (specializeAt p (m + 1)) := by
  apply Submodule.span_le.mpr
  rintro x ⟨a, ha, had, rfl⟩
  exact specialize_polynomial_mem_mixed p m a ha
    (fun i hdiv => (not_le_of_gt
      ((had i).trans_le (Fact.out : Irreducible p).natDegree_pos))
      (natDegree_le_of_dvd hdiv (ha i)))
    (fun i => had i.castSucc)

/-- Below a nonlinear modulus, the second polynomial stage specializes to the
actual mixed-symbol span. -/
theorem lower_two_le_comap_specialize_mixed (hp : 1 < p.natDegree) (m : ℕ) :
    lower k (m + 1) 2 ≤
      (mixedSpan (algebraMap k (AdjoinRoot p)) m).comap (specializeAt p (m + 1)) := by
  rw [show 2 = 1 + 1 from rfl, lower_succ_eq 1 (by omega)]
  refine sup_le (lower_one_le_comap_specialize_mixed p m) ?_
  apply Submodule.span_le.mpr
  rintro x ⟨q, a, hq, ha, _, _, hqd, had, rfl⟩
  let b : Fin (m + 1) → k[X] := Fin.snoc a q
  have hb : ∀ i, b i ≠ 0 := by
    intro i
    refine Fin.lastCases ?_ (fun j => ?_) i <;> simp [b, hq, ha]
  have hpb : ∀ i, ¬ p ∣ b i := by
    intro i hdiv
    have hlt : (b i).natDegree < p.natDegree := by
      refine Fin.lastCases ?_ (fun j => ?_) i
      · simpa only [b, Fin.snoc_last, hqd] using hp
      · simpa only [b, Fin.snoc_castSucc] using (had j).trans hp
    exact (not_le_of_gt hlt) (natDegree_le_of_dvd hdiv (hb i))
  have heq : Fin.snoc (polynomialTuple a ha) (polynomialUnit k q hq) =
      polynomialTuple b hb := by
    funext i
    refine Fin.lastCases ?_ (fun j => ?_) i <;> simp [polynomialTuple, b]
  rw [heq]
  exact specialize_polynomial_mem_mixed p m b hb hpb
    (fun i => by simpa only [b, Fin.snoc_castSucc] using had i)

end DegreeFiltration

open PolynomialResidue DegreeFiltration

/-- The degree-gap case of Bass--Tate mixed generation, in every positive
Milnor degree and arbitrary characteristic. The gap is an explicit polynomial
hypothesis, not an assumed generation statement or a special-field instance. -/
theorem mixedSpan_eq_top_of_degree_gap (p : MonicIrreducible k)
    (hgap : ∀ q : MonicIrreducible k,
      q.val.natDegree < p.val.natDegree → q.val.natDegree = 1) (m : ℕ) :
    mixedSpan (algebraMap k (AdjoinRoot p.val)) m = ⊤ := by
  have hzero : (mixedSpan (algebraMap k (AdjoinRoot p.val)) m).mkQ = 0 := by
    apply linearMap_ext
    intro a
    apply (Submodule.Quotient.mk_eq_zero _).mpr
    let r : Fin (m + 1) → k[X] := fun i => reducedRepresentative p.val p.property.1 (a i)
    have hr : ∀ i, r i ≠ 0 := fun i =>
      reducedRepresentative_ne_zero p.val p.property.1 (a i)
    have hrd : ∀ i, (r i).natDegree < p.val.natDegree := fun i =>
      reducedRepresentative_natDegree_lt p.val p.property.1 (a i)
    have hpr : ∀ i, ¬ p.val ∣ r i := fun i =>
      p.property.1.not_dvd_of_natDegree_lt (hr i) (hrd i)
    have hspec : specializeAt p.val (m + 1) (symbol (polynomialTuple r hr)) =
        symbol a := by
      change specializeAt p.val (m + 1)
        (symbol (fun i => PolynomialResidue.polynomialUnit (r i) (hr i))) = _
      rw [specializeAt_polynomial_units p.val (m + 1) r hr hpr]
      congr 1
      funext i
      exact quotientUnit_reducedRepresentative p.val p.property.1 (a i)
    rw [← hspec]
    have hmem := polynomial_symbol_mem_lower p.val.natDegree r hr hrd
    by_cases hp1 : p.val.natDegree = 1
    · exact lower_one_le_comap_specialize_mixed p.val m (by simpa only [hp1] using hmem)
    · exact lower_two_le_comap_specialize_mixed p.val
        (by have := p.property.2.natDegree_pos; omega) m
        (lower_le_lower_two_of_degree_gap m p.val.natDegree hgap hmem)
  apply top_unique
  intro x _
  exact (Submodule.Quotient.mk_eq_zero _).mp (LinearMap.congr_fun hzero x)

/-- Linear and quadratic extensions satisfy the degree gap automatically.
In particular the linear case does not require a nonlinear-modulus argument. -/
theorem mixedSpan_eq_top_of_natDegree_le_two (p : MonicIrreducible k)
    (hp : p.val.natDegree ≤ 2) (m : ℕ) :
    mixedSpan (algebraMap k (AdjoinRoot p.val)) m = ⊤ := by
  apply mixedSpan_eq_top_of_degree_gap p _ m
  intro q hq
  have := q.property.2.natDegree_pos
  omega

/-- Every class has an actual finite integer linear combination of mixed
symbols. This records the witnesses needed by subsequent finite descent. -/
theorem exists_mixed_expansion_of_degree_gap (p : MonicIrreducible k)
    (hgap : ∀ q : MonicIrreducible k,
      q.val.natDegree < p.val.natDegree → q.val.natDegree = 1) (m : ℕ)
    (x : K (AdjoinRoot p.val) (m + 1)) :
    ∃ c : (SymbolTuple k m × (AdjoinRoot p.val)ˣ) →₀ ℤ,
      (c.sum fun ab z => z • symbol (Fin.snoc
        (Units.map (algebraMap k (AdjoinRoot p.val)).toMonoidHom ∘ ab.1) ab.2)) = x := by
  apply Finsupp.mem_span_range_iff_exists_finsupp.mp
  have hs : {z | ∃ (a : SymbolTuple k m) (b : (AdjoinRoot p.val)ˣ),
      z = symbol (Fin.snoc
        (Units.map (algebraMap k (AdjoinRoot p.val)).toMonoidHom ∘ a) b)} =
      Set.range (fun ab : SymbolTuple k m × (AdjoinRoot p.val)ˣ =>
        symbol (Fin.snoc
          (Units.map (algebraMap k (AdjoinRoot p.val)).toMonoidHom ∘ ab.1) ab.2)) := by
    ext z
    constructor
    · rintro ⟨a, b, rfl⟩
      exact ⟨(a, b), rfl⟩
    · rintro ⟨⟨a, b⟩, rfl⟩
      exact ⟨a, b, rfl⟩
  rw [← hs]
  change x ∈ mixedSpan (algebraMap k (AdjoinRoot p.val)) m
  rw [mixedSpan_eq_top_of_degree_gap p hgap m]
  trivial

end MilnorK
