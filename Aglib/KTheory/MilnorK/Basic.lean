module

public import Mathlib.LinearAlgebra.Finsupp.LinearCombination
public import Mathlib.LinearAlgebra.Quotient.Basic
public import Mathlib.Algebra.Field.Defs
public import Mathlib.Algebra.Ring.Units
public import Mathlib.Algebra.GroupWithZero.Units.Basic

/-!
# Milnor K-groups in every nonnegative degree

`K F n` is the free abelian group on ordered `n`-tuples of units, divided by
coordinatewise multiplicative additivity and adjacent Steinberg relations.
This is the standard generators-and-relations presentation of the degree `n`
part of the tensor algebra on `Fˣ` divided by the Steinberg ideal. In particular
we impose only adjacent Steinberg pairs, exactly as in that homogeneous ideal.

The presentation is an actual quotient of an integer module. The symbol laws
and universal property below are proved from its defining submodule; none is
an assumption about `K`. The construction includes degree zero and works in
arbitrary characteristic and universe. Field maps and low-degree equivalences
are developed in separate modules.
-/

@[expose] public section

noncomputable section

namespace MilnorK

universe u v

variable (F : Type u) [Field F] (n : ℕ)

/-- The ordered unit tuples indexing degree `n` symbols. -/
abbrev SymbolTuple := Fin n → Fˣ

/-- The free integer module on all degree `n` symbols. -/
abbrev Presentation := SymbolTuple F n →₀ ℤ

/-- The defining relations: additivity in each coordinate and adjacent Steinberg pairs. -/
def relationGenerators : Set (Presentation F n) :=
  {r | (∃ (a : SymbolTuple F n) (i : Fin n) (b c : Fˣ),
      r = Finsupp.single (Function.update a i (b * c)) 1 -
        Finsupp.single (Function.update a i b) 1 -
        Finsupp.single (Function.update a i c) 1) ∨
    (∃ (a : SymbolTuple F n) (i j : Fin n),
      i.val + 1 = j.val ∧ (a i : F) + (a j : F) = 1 ∧ r = Finsupp.single a 1)}

/-- The integer submodule generated by exactly the standard Milnor relations. -/
def relationSpan : Submodule ℤ (Presentation F n) :=
  Submodule.span ℤ (relationGenerators F n)

/-- The standard degree `n` Milnor K-group as a symbol-relation quotient. -/
abbrev K := Presentation F n ⧸ relationSpan F n

variable {F n}

/-- The ordered symbol of an `n`-tuple of units in the actual quotient. -/
def symbol (a : SymbolTuple F n) : K F n :=
  (relationSpan F n).mkQ (Finsupp.single a 1)

/-- Multiplication in any one coordinate is addition of symbols. -/
theorem symbol_mul (a : SymbolTuple F n) (i : Fin n) (b c : Fˣ) :
    symbol (Function.update a i (b * c)) =
      symbol (Function.update a i b) + symbol (Function.update a i c) := by
  have h : (relationSpan F n).mkQ
      (Finsupp.single (Function.update a i (b * c)) 1 -
        Finsupp.single (Function.update a i b) 1 -
        Finsupp.single (Function.update a i c) 1) = 0 := by
    change (Submodule.Quotient.mk _ : K F n) = 0
    rw [Submodule.Quotient.mk_eq_zero]
    exact Submodule.subset_span (Or.inl ⟨a, i, b, c, rfl⟩)
  change symbol (Function.update a i (b * c)) -
    symbol (Function.update a i b) - symbol (Function.update a i c) = 0 at h
  exact sub_eq_zero.mp ((sub_sub _ _ _).symm.trans h)

/-- An adjacent pair adding to one makes the symbol zero. -/
theorem steinberg (a : SymbolTuple F n) (i j : Fin n)
    (hij : i.val + 1 = j.val) (h : (a i : F) + (a j : F) = 1) : symbol a = 0 := by
  change (Submodule.Quotient.mk _ : K F n) = 0
  rw [Submodule.Quotient.mk_eq_zero]
  exact Submodule.subset_span (Or.inr ⟨a, i, j, hij, h, rfl⟩)

/-- Any coordinate equal to the multiplicative identity makes its symbol zero. -/
@[simp] theorem symbol_update_one (a : SymbolTuple F n) (i : Fin n) :
    symbol (Function.update a i 1) = 0 := by
  have h := symbol_mul a i 1 1
  rw [one_mul] at h
  exact (add_left_cancel ((add_zero _).trans h)).symm

/-- Coordinatewise identity-axis vanishing, without requiring an updated tuple. -/
theorem symbol_eq_zero_of_eq_one (a : SymbolTuple F n) (i : Fin n) (h : a i = 1) :
    symbol a = 0 := by
  simpa only [← h, Function.update_eq_self] using symbol_update_one a i

/-- Inverting one coordinate negates its symbol. -/
@[simp] theorem symbol_update_inv (a : SymbolTuple F n) (i : Fin n) (b : Fˣ) :
    symbol (Function.update a i b⁻¹) = -symbol (Function.update a i b) := by
  have h := symbol_mul a i b b⁻¹
  rw [mul_inv_cancel, symbol_update_one] at h
  exact eq_neg_of_add_eq_zero_right h.symm

variable {A : Type v} [AddCommGroup A]

/-- The condition for a tuple-valued function to respect the standard symbol relations.
This is a property of a proposed target function, not extra structure on `K F n`. -/
structure IsSymbolMap (s : SymbolTuple F n → A) : Prop where
  map_mul : ∀ (a : SymbolTuple F n) (i : Fin n) (b c : Fˣ),
    s (Function.update a i (b * c)) =
      s (Function.update a i b) + s (Function.update a i c)
  steinberg : ∀ (a : SymbolTuple F n) (i j : Fin n),
    i.val + 1 = j.val → (a i : F) + (a j : F) = 1 → s a = 0

/-- The constructed symbols themselves satisfy all defining relations. -/
theorem symbol_isSymbolMap : IsSymbolMap (symbol (F := F) (n := n)) :=
  ⟨symbol_mul, steinberg⟩

/-- A function respecting the defining relations descends to the actual Milnor quotient. -/
def lift (s : SymbolTuple F n → A) (hs : IsSymbolMap s) : K F n →ₗ[ℤ] A :=
  (relationSpan F n).liftQ (Finsupp.linearCombination ℤ s) (by
    rw [relationSpan, Submodule.span_le]
    rintro r (⟨a, i, b, c, rfl⟩ | ⟨a, i, j, hij, h, rfl⟩)
    · change Finsupp.linearCombination ℤ s _ = 0
      simp only [map_sub, Finsupp.linearCombination_single, one_smul, hs.map_mul,
        add_sub_cancel_left, sub_self]
    · change Finsupp.linearCombination ℤ s _ = 0
      simpa only [Finsupp.linearCombination_single, one_smul] using hs.steinberg a i j hij h)

/-- Quotient descent has exactly the prescribed values on symbols. -/
@[simp] theorem lift_symbol (s : SymbolTuple F n → A) (hs : IsSymbolMap s)
    (a : SymbolTuple F n) : lift s hs (symbol a) = s a := by
  simp [lift, symbol]

/-- Integer-linear maps out of Milnor K-theory are determined by their symbol values. -/
@[ext] theorem linearMap_ext (f g : K F n →ₗ[ℤ] A)
    (h : ∀ a : SymbolTuple F n, f (symbol a) = g (symbol a)) : f = g := by
  apply Submodule.linearMap_qext
  apply Finsupp.lhom_ext
  intro a z
  have hz : Finsupp.single a z = z • Finsupp.single a (1 : ℤ) := by simp
  rw [hz]
  simpa only [map_smul, LinearMap.comp_apply, symbol] using congrArg (z • ·) (h a)

/-- Additive maps are likewise determined by their symbol values. -/
@[ext] theorem addHom_ext (f g : K F n →+ A)
    (h : ∀ a : SymbolTuple F n, f (symbol a) = g (symbol a)) : f = g := by
  apply AddMonoidHom.toIntLinearMap_injective
  exact linearMap_ext f.toIntLinearMap g.toIntLinearMap h

/-- Every genuine symbol map has one and only one integer-linear extension. -/
theorem existsUnique_lift (s : SymbolTuple F n → A) (hs : IsSymbolMap s) :
    ∃! f : K F n →ₗ[ℤ] A, ∀ a : SymbolTuple F n, f (symbol a) = s a := by
  refine ⟨lift s hs, lift_symbol s hs, ?_⟩
  intro f hf
  apply linearMap_ext
  intro a
  exact (hf a).trans (lift_symbol s hs a).symm

end MilnorK
