module

public import Mathlib.FieldTheory.RatFunc.Basic
public import Mathlib.RingTheory.AdjoinRoot
public import Mathlib.RingTheory.DedekindDomain.Dvr
public import Mathlib.RingTheory.LocalRing.ResidueField.Ideal

/-!
# The actual local ring and residue field at an irreducible polynomial

For an irreducible polynomial `p` over an arbitrary field, the localization at
`(p)` is a discrete valuation ring with fraction field `RatFunc k`. Its residue
field is canonically `AdjoinRoot p`, through the original polynomial quotient
map. The image of `p` is a uniformizer, and nonzero representatives of degree
less than a monic `p` are units. No separability hypothesis is used.
-/

@[expose] public noncomputable section

open Polynomial
open scoped nonZeroDivisors

namespace Polynomial.LocalResidue

universe u

variable {k : Type u} [Field k] (p : k[X]) [Fact (Irreducible p)]

/-- The actual principal prime ideal of an irreducible polynomial. -/
abbrev primeIdeal : Ideal k[X] := Ideal.span {p}

/-- The actual localization of `k[X]` at `(p)`. -/
abbrev Ring := Localization.AtPrime (primeIdeal p)

/-- The actual residue field of the polynomial local ring. -/
abbrev ResidueField := IsLocalRing.ResidueField (Ring p)

/-- The prime ideal of an irreducible polynomial is nonzero. -/
theorem primeIdeal_ne_bot : primeIdeal p ≠ ⊥ := by
  intro h
  exact (Fact.out : Irreducible p).ne_zero (Ideal.span_singleton_eq_bot.mp h)

instance instIsDiscreteValuationRing : IsDiscreteValuationRing (Ring p) :=
  IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain
    k[X] (primeIdeal_ne_bot p) (Ring p)

/-- The canonical inclusion of the polynomial local ring into rational functions,
using the existing rational-function scalar action. -/
instance instAlgebraRatFunc : Algebra (Ring p) (RatFunc k) where
  algebraMap := (RatFunc.toFractionRingRingEquiv k).symm.toRingHom.comp
    (algebraMap (Ring p) (FractionRing k[X]))
  smul_def' r x := by
    cases x
    exact (RatFunc.ofFractionRing_smul r _).symm.trans
      (congrArg RatFunc.ofFractionRing (Algebra.smul_def r _)) |>.trans
        (RatFunc.ofFractionRing_mul _ _)
  commutes' _ _ := mul_comm _ _

instance instIsScalarTowerRatFunc : IsScalarTower k[X] (Ring p) (RatFunc k) where
  smul_assoc a b x := by
    cases x
    simp only [← RatFunc.ofFractionRing_smul, smul_assoc]

instance instIsFractionRingRatFunc : IsFractionRing (Ring p) (RatFunc k) :=
  IsFractionRing.isFractionRing_of_isDomain_of_isLocalization
    (primeIdeal p).primeCompl (Ring p) (RatFunc k)

/-- The canonical quotient map induces the residue-field equivalence. -/
def adjoinRootEquiv : AdjoinRoot p ≃ₐ[k] ResidueField p := by
  change (k[X] ⧸ primeIdeal p) ≃ₐ[k] (primeIdeal p).ResidueField
  exact AlgEquiv.ofBijective
    (IsScalarTower.toAlgHom k (k[X] ⧸ primeIdeal p) (primeIdeal p).ResidueField)
    (Ideal.bijective_algebraMap_quotient_residueField (primeIdeal p))

/-- Identify the actual residue field with the original polynomial quotient. -/
def residueEquiv : ResidueField p ≃ₐ[k] AdjoinRoot p :=
  (adjoinRootEquiv p).symm

/-- Compatibility with the original quotient map, before taking the inverse. -/
@[simp]
theorem adjoinRootEquiv_mk (q : k[X]) :
    adjoinRootEquiv p (AdjoinRoot.mk p q) = algebraMap k[X] (ResidueField p) q :=
  rfl

/-- Reduction of a polynomial is its literal class modulo `p`. -/
@[simp]
theorem residueEquiv_algebraMap (q : k[X]) :
    residueEquiv p (algebraMap k[X] (ResidueField p) q) = AdjoinRoot.mk p q := by
  exact (adjoinRootEquiv p).symm_apply_apply (AdjoinRoot.mk p q)

/-- Localize a polynomial and then reduce: the result is its original quotient class. -/
@[simp]
theorem residueEquiv_residue_polynomial (q : k[X]) :
    residueEquiv p (IsLocalRing.residue (Ring p) (algebraMap k[X] (Ring p) q)) =
      AdjoinRoot.mk p q := by
  exact residueEquiv_algebraMap p q

/-- Polynomial reduction equals evaluation at the actual adjoined root. -/
theorem residueEquiv_residue_eq_aeval (q : k[X]) :
    residueEquiv p (IsLocalRing.residue (Ring p) (algebraMap k[X] (Ring p) q)) =
      aeval (AdjoinRoot.root p) q := by
  rw [residueEquiv_residue_polynomial, AdjoinRoot.aeval_eq]

/-- The maximal ideal is generated by the localized defining polynomial. -/
theorem maximalIdeal_eq_span :
    IsLocalRing.maximalIdeal (Ring p) =
      Ideal.span {algebraMap k[X] (Ring p) p} := by
  rw [← IsLocalization.AtPrime.map_eq_maximalIdeal (primeIdeal p) (Ring p)]
  exact Ideal.map_span (algebraMap k[X] (Ring p)) {p} |>.trans (by simp)

/-- The localized polynomial is an actual uniformizer, not chosen auxiliary data. -/
theorem irreducible_polynomial : Irreducible (algebraMap k[X] (Ring p) p) :=
  (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mpr (maximalIdeal_eq_span p)

/-- A polynomial becomes a unit exactly when it is not divisible by `p`. -/
theorem isUnit_polynomial_iff (q : k[X]) :
    IsUnit (algebraMap k[X] (Ring p) q) ↔ ¬ p ∣ q := by
  rw [IsLocalization.AtPrime.isUnit_to_map_iff (Ring p) (primeIdeal p)]
  exact not_congr Ideal.mem_span_singleton

/-- Nonzero reduced polynomial representatives are units in the actual local ring. -/
theorem isUnit_polynomial_of_natDegree_lt (hp : p.Monic) {q : k[X]} (hq : q ≠ 0)
    (hdeg : q.natDegree < p.natDegree) : IsUnit (algebraMap k[X] (Ring p) q) := by
  exact (isUnit_polynomial_iff p q).mpr (hp.not_dvd_of_natDegree_lt hq hdeg)

end Polynomial.LocalResidue
