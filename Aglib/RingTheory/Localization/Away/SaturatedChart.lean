module

public import Aglib.RingTheory.Localization.Away.MapInverse
public import Mathlib.RingTheory.Adjoin.Basic
public import Mathlib.Tactic.Ring

/-!
# Subalgebras generated by ideal fractions in a principal localization

The construction is the displayed subalgebra of the actual localization.
No geometric blowup identification is asserted.

Source: `R5Lab.Aglib.RingTheory.Localization.Away.SaturatedChart`.
Packet SHA-256:
`288733f97ac9ca90d8b6cd2a1193806748e2453e788ac659d5c900497c212dbc`.
Actual hypotheses, universes and forward maps are retained; source identity is
separate from compilation and mathematical-adoption evidence.
-/

@[expose] public section

noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
universe u v w
namespace Localization.Away
variable {R : Type u} [CommRing R]

/-- The saturated affine blowup chart, as the actual subalgebra of the localization. -/
def saturatedChart (A : Type v) [CommRing A] (I : Ideal A) (a : A) :
    Subalgebra A (Localization.Away a) :=
  Algebra.adjoin A {z | ∃ b ∈ I,
    z = algebraMap A (Localization.Away a) b * IsLocalization.Away.invSelf a}

/-- The element `b / a` in the localization obtained by inverting `a`. -/
def fraction {A : Type v} [CommRing A] (a b : A) : Localization.Away a :=
  algebraMap A (Localization.Away a) b * IsLocalization.Away.invSelf a

lemma fraction_mem {A : Type v} [CommRing A] (I : Ideal A) (a b : A) (hb : b ∈ I) :
    fraction a b ∈ saturatedChart A I a := Algebra.subset_adjoin ⟨b, hb, rfl⟩

lemma saturatedChart_le {A : Type v} [CommRing A] [Algebra R A]
    (s : Set A) (a : A) (T : Subalgebra R (Localization.Away a))
    (hA : ∀ b : A, algebraMap A (Localization.Away a) b ∈ T)
    (hs : ∀ b ∈ s, fraction a b ∈ T) :
    (saturatedChart A (Ideal.span s) a).restrictScalars R ≤ T := by
  intro z hz
  refine Algebra.adjoin_induction (R := A) (p := fun x _ => x ∈ T) ?_ hA ?_ ?_ hz
  · rintro _ ⟨b, hb, rfl⟩
    change fraction a b ∈ T
    induction hb using Submodule.span_induction with
    | mem b hb => exact hs b hb
    | zero => simpa only [fraction, map_zero, zero_mul] using T.zero_mem
    | add b c hb hc ihb ihc => simpa only [fraction, map_add, add_mul] using T.add_mem ihb ihc
    | smul b c hc ih =>
      simpa only [fraction, smul_eq_mul, map_mul, mul_assoc] using T.mul_mem (hA b) ih
  · intro x y hx hy ihx ihy; exact T.add_mem ihx ihy
  · intro x y hx hy ihx ihy; exact T.mul_mem ihx ihy

lemma fraction_mul_self {A : Type v} [CommRing A] (a b : A) :
    fraction a b * algebraMap A (Localization.Away a) a =
      algebraMap A (Localization.Away a) b := by
  simp [fraction, mul_assoc, mul_comm (IsLocalization.Away.invSelf a)]

lemma fraction_self {A : Type v} [CommRing A] (a : A) : fraction a a = 1 := by
  exact IsLocalization.Away.mul_invSelf a

end Localization.Away
