module

public import Mathlib.RingTheory.AlgebraicIndependent.Adjoin
public import Mathlib.RingTheory.AlgebraicIndependent.Basic
public import Mathlib.FieldTheory.Separable
public import Mathlib.RingTheory.Finiteness.Basic

/-! # Actual parameter fields under the residue coefficient equivalence

The coefficient equivalence and polynomial evaluation construct the comparison
with the generated intermediate field. Finite separability is transported only
after proving the actual fraction-map triangle.
-/

@[expose] public noncomputable section

namespace SeparatingParameterField

variable {k F L ι : Type*} [Field k] [Field F] [Field L]
  [Algebra k F] [Algebra F L] [Algebra k L] [IsScalarTower k F L]
variable (e : k ≃+* F) (he : (algebraMap k F) = e.toRingHom)
variable (y : ι → L) (hy : AlgebraicIndependent F y)

include e he hy in
/-- Independence over the actual residue coefficient field follows along its genuine injection. -/
theorem independent : AlgebraicIndependent k y :=
  AlgebraicIndependent.restrictScalars (by rw [he]; exact e.injective) hy

/-- The canonical lower-coefficient parameter fraction map, using actual evaluation. -/
def fractionPoint : FractionRing (MvPolynomial ι k) →+* L :=
  IsFractionRing.lift (K := FractionRing (MvPolynomial ι k))
    (g := (MvPolynomial.aeval (R := k) y).toRingHom)
    (algebraicIndependent_iff_injective_aeval.mp (independent e he y hy))

/-- Coefficient equivalence followed by actual evaluation identifies the parameter field
with the actual intermediate field generated by the chosen coordinates. -/
def equivalence : FractionRing (MvPolynomial ι k) ≃+*
    IntermediateField.adjoin F (Set.range y) :=
  (IsFractionRing.ringEquivOfRingEquiv (MvPolynomial.mapEquiv ι e)).trans
    hy.aevalEquivField.toRingEquiv

/-- The field equivalence agrees with the canonical parameter fraction map into the target. -/
theorem equivalence_coe :
    (IntermediateField.adjoin F (Set.range y)).val.toRingHom.comp
      (equivalence e y hy).toRingHom = fractionPoint e he y hy := by
  apply IsFractionRing.ringHom_ext (A := MvPolynomial ι k)
  intro f
  change ((equivalence e y hy (algebraMap (MvPolynomial ι k)
    (FractionRing (MvPolynomial ι k)) f)) : L) = _
  rw [equivalence, RingEquiv.trans_apply, IsFractionRing.ringEquivOfRingEquiv_algebraMap]
  change (hy.aevalEquivField (algebraMap (MvPolynomial ι F)
    (FractionRing (MvPolynomial ι F)) (MvPolynomial.map e.toRingHom f)) : L) = _
  rw [AlgebraicIndependent.aevalEquivField_algebraMap_apply_coe,
    fractionPoint, IsFractionRing.lift_algebraMap]
  have h : (MvPolynomial.aeval (R := F) y).toRingHom.comp
      (MvPolynomial.map e.toRingHom) = (MvPolynomial.aeval (R := k) y).toRingHom := by
    apply MvPolynomial.ringHom_ext
    · intro c
      simp only [RingHom.comp_apply, MvPolynomial.map_C]
      change MvPolynomial.aeval (R := F) y (MvPolynomial.C (e c)) =
        MvPolynomial.aeval (R := k) y (MvPolynomial.C c)
      rw [MvPolynomial.aeval_C, MvPolynomial.aeval_C]
      exact (congrArg (algebraMap F L) (DFunLike.congr_fun he c)).symm.trans
        (IsScalarTower.algebraMap_apply k F L c).symm
    · intro i
      simp only [RingHom.comp_apply, MvPolynomial.map_X]
      change MvPolynomial.aeval (R := F) y (MvPolynomial.X i) =
        MvPolynomial.aeval (R := k) y (MvPolynomial.X i)
      rw [MvPolynomial.aeval_X, MvPolynomial.aeval_X]
  exact DFunLike.congr_fun h f

/-- Finite separability transports to the canonical parameter-field action, not an arbitrary
isomorphic action on the target field. -/
theorem finite_and_isSeparable
    [Module.Finite (IntermediateField.adjoin F (Set.range y)) L]
    [Algebra.IsSeparable (IntermediateField.adjoin F (Set.range y)) L] :
    letI := (fractionPoint e he y hy).toAlgebra
    Module.Finite (FractionRing (MvPolynomial ι k)) L ∧
      Algebra.IsSeparable (FractionRing (MvPolynomial ι k)) L := by
  let G := FractionRing (MvPolynomial ι k)
  let E := IntermediateField.adjoin F (Set.range y)
  let φ := equivalence e y hy
  let : Algebra G L := (fractionPoint e he y hy).toAlgebra
  let : Algebra G E := φ.toRingHom.toAlgebra
  have htriangle : (algebraMap E L).comp φ.toRingHom = algebraMap G L :=
    equivalence_coe e he y hy
  let : IsScalarTower G E L := IsScalarTower.of_algebraMap_eq' htriangle.symm
  have hfinite : Module.Finite G E := RingHom.Finite.of_surjective φ.toRingHom φ.surjective
  let := hfinite
  refine ⟨Module.Finite.trans E L, ?_⟩
  exact Algebra.IsSeparable.of_equiv_equiv φ.symm (RingEquiv.refl L) (by
    ext a
    change fractionPoint e he y hy (φ.symm a) = (a : L)
    have hval := DFunLike.congr_fun (equivalence_coe e he y hy) (φ.symm a)
    change (φ (φ.symm a) : L) = fractionPoint e he y hy (φ.symm a) at hval
    rw [φ.apply_symm_apply] at hval
    exact hval.symm)

end SeparatingParameterField
