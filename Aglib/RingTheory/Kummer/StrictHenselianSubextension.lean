module

public import Aglib.FieldTheory.KummerEmbedding
public import Aglib.RingTheory.Henselian.PrimitiveRoots
public import Aglib.RingTheory.Kummer.GenericField
public import Aglib.RingTheory.Kummer.RegularParameterRecognition

/-! # Original normalization charts of embedded strict-Henselian subextensions

The actual embedded field is generated by a specified power of the original
root. Primitive roots are lifted from the original residue field, and the
regular-parameter recognition constructs its literal integral-closure chart.
All fraction fields, coefficient actions and ambient values are retained.
-/

@[expose] public noncomputable section

namespace Algebra.Kummer

section General

variable (R : Type*) [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
  (f : R) (hf : f ∈ IsLocalRing.maximalIdeal R)
  [IsRegularLocalRing (R ⧸ Ideal.span {f})]
  (N : ℕ) (hN : 0 < N) (hreg : IsSMulRegular R f)
  (K F L : Type*) [Field K] [Field F] [Field L]
  [Algebra R K] [IsFractionRing R K]
  [Algebra (RootAlgebra N f) F] [IsFractionRing (RootAlgebra N f) F]
  [Algebra R F] [Algebra K F]
  [IsScalarTower R (RootAlgebra N f) F] [IsScalarTower R K F]
  [Algebra K L] [Algebra R L] [IsScalarTower R K L]

include hf hN hreg

/-- The normalization of the original embedded field has a literal root
chart, with positive invertible exponent dividing the original bound and
with every ambient field value preserved. The supplied embedding is genuine
lower-level data; geometric callers construct it from the original cover. -/
theorem exists_rootIntegralClosureEquiv_of_embedding_of_primitiveRoots
    (hunit : IsUnit (N : R)) (hroots : (primitiveRoots N K).Nonempty)
    (i : L →ₐ[K] F) :
    ∃ (e : ℕ) (β : L) (hβ : β ^ e = algebraMap R L f),
      0 < e ∧ e ∣ N ∧ IsUnit (e : R) ∧
      ∃ c : RootAlgebra e f ≃ₐ[R] integralClosure R L,
        (∀ x, (c x : L) = rootEvaluation R L e f β hβ x) ∧
        i β = (algebraMap (RootAlgebra N f) F
          (AdjoinRoot.root (rootPolynomial N f))) ^ (N / e) := by
  let : IsRegularLocalRing R := IsRegularLocalRing.of_quotient_span_singleton R f hreg
  let : IsDomain R := IsRegularLocalRing.isDomain_of_regularLocal R
  obtain ⟨e, β, he, heN, _, hpow, hgen, himage⟩ :=
    i.exists_root_generator_of_kummer_embedding hN
      (genericRoot_pow R N f K F) (genericRoot_adjoin_eq_top R N f K F)
      (genericRoot_irreducible R N f K F hN) hroots
  have hβ : β ^ e = algebraMap R L f :=
    hpow.trans (IsScalarTower.algebraMap_apply R K L f).symm
  refine ⟨e, β, hβ, he, heN, isUnit_of_dvd_unit heN.natCast hunit,
    parameterRootIntegralClosureEquiv R K L e he f hf hreg β hβ hgen, ?_, himage⟩
  exact parameterRootIntegralClosureEquiv_coe R K L e he f hf hreg β hβ hgen

end General

section Strict

variable (R : Type*) [CommRing R] [HenselianLocalRing R]
  [IsSepClosed (IsLocalRing.ResidueField R)] [IsNoetherianRing R]
  (f : R) (hf : f ∈ IsLocalRing.maximalIdeal R)
  [IsRegularLocalRing (R ⧸ Ideal.span {f})]
  (N : ℕ) (hN : 0 < N) (hreg : IsSMulRegular R f)
  (K F L : Type*) [Field K] [Field F] [Field L]
  [Algebra R K] [IsFractionRing R K]
  [Algebra (RootAlgebra N f) F] [IsFractionRing (RootAlgebra N f) F]
  [Algebra R F] [Algebra K F]
  [IsScalarTower R (RootAlgebra N f) F] [IsScalarTower R K F]
  [Algebra K L] [Algebra R L] [IsScalarTower R K L]

include hf hN hreg

/-- Over a strictly Henselian base the primitive roots are supplied internally
from the original residue field. The complete chart construction is the same
one used at a finite etale stage with supplied primitive roots. -/
theorem exists_rootIntegralClosureEquiv_of_embedding
    (hunit : IsUnit (N : R)) (i : L →ₐ[K] F) :
    ∃ (e : ℕ) (β : L) (hβ : β ^ e = algebraMap R L f),
      0 < e ∧ e ∣ N ∧ IsUnit (e : R) ∧
      ∃ c : RootAlgebra e f ≃ₐ[R] integralClosure R L,
        (∀ x, (c x : L) = rootEvaluation R L e f β hβ x) ∧
        i β = (algebraMap (RootAlgebra N f) F
          (AdjoinRoot.root (rootPolynomial N f))) ^ (N / e) := by
  let : IsRegularLocalRing R := IsRegularLocalRing.of_quotient_span_singleton R f hreg
  let : IsDomain R := IsRegularLocalRing.isDomain_of_regularLocal R
  exact exists_rootIntegralClosureEquiv_of_embedding_of_primitiveRoots
    R f hf N hN hreg K F L hunit
    (HenselianLocalRing.primitiveRoots_fraction_nonempty R K N hN hunit) i

end Strict

end Algebra.Kummer
