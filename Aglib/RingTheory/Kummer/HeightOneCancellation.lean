module

public import Aglib.RingTheory.Kummer.RegularParameter
public import Aglib.RingTheory.RegularLocalRing.Normal
public import Aglib.RingTheory.KrullDimension.IntegralExtension

/-! # The specified height-one prime over the root divisor

The original source prime is retained. Normal-base going down identifies its
contraction with the ideal generated by the literal root, using the actual
root quotient. This is the prime-identification step of normalized root
cancellation, not a claim of unramifiedness of the normalization.
-/

@[expose] public noncomputable section

namespace Algebra.Kummer

universe u v

variable (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
  (f : R) (hf : f ∈ IsLocalRing.maximalIdeal R) (N : ℕ) (hN : 0 < N)
  (hreg : IsSMulRegular R f) [IsRegularLocalRing (R ⧸ Ideal.span {f})]

local notation "T" => RootAlgebra N f
local notation "θ" => AdjoinRoot.root (rootPolynomial N f)

include hf hN hreg in
/-- The original root is prime, not merely a nonzerodivisor or an associated
choice of parameter. -/
theorem parameterRoot_root_prime : Prime θ := by
  let : IsRegularLocalRing T := parameterRoot_isRegularLocalRing R f hf N hN hreg
  let : IsDomain T := IsRegularLocalRing.isDomain_of_regularLocal T
  let : IsDomain (R ⧸ Ideal.span {f}) :=
    IsRegularLocalRing.isDomain_of_regularLocal _
  let : IsDomain (T ⧸ Ideal.span {θ}) :=
    (rootQuotientEquiv N hN f).toRingEquiv.toMulEquiv.isDomain _
  have hθ : θ ≠ 0 := by
    intro hz
    have hr := parameterRoot_root_regular R f N hN hreg
    have he : (1 : T) = 0 := hr (by simp [hz])
    exact one_ne_zero he
  exact (Ideal.span_singleton_prime hθ).mp
    ((Ideal.Quotient.isDomain_iff_prime _).mp inferInstance)

include hf hN hreg in
/-- For the specified height-one prime of an original integral domain
extension, lying over the root divisor forces its actual contraction to be
exactly the original root ideal. No unramifiedness is assumed. -/
theorem parameterRoot_heightOne_under_eq
    (B : Type v) [CommRing B] [IsDomain B] [Algebra T B]
    [FaithfulSMul T B] [Algebra.IsIntegral T B]
    (q : Ideal B) [q.IsPrime] (hq : q.height = 1)
    (hdiv : algebraMap T B θ ∈ q) :
    q.under T = Ideal.span {θ} := by
  let : IsRegularLocalRing T := parameterRoot_isRegularLocalRing R f hf N hN hreg
  let : IsDomain T := IsRegularLocalRing.isDomain_of_regularLocal T
  let : IsIntegrallyClosed T := IsRegularLocalRing.isIntegrallyClosed_of_regularLocal T
  have hp : (q.under T).height = 1 :=
    (Ideal.height_eq_height_under_of_normal q).symm.trans hq
  exact Ideal.eq_span_singleton_of_height_eq_one hp hdiv
    (parameterRoot_root_prime R f hf N hN hreg)

end Algebra.Kummer
