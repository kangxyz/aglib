module

public import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis
public import Mathlib.FieldTheory.Minpoly.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Monic residue equations after passing to a parameter field

The coefficient map out of the algebra generated by a transcendence basis is
constructed from its polynomial evaluation equivalence. An injective map from
the parameter polynomial ring to a field transports genuine algebraicity
witnesses, with the actual coefficient triangle checked. Minimal polynomials
then provide monic positive-degree equations for the residue coordinates.
-/

@[expose] public section

noncomputable section

universe u v w t

namespace ResidueParameterAnnihilator

variable {k : Type u} [Field k] {D : Type v} [CommRing D] [Algebra k D]
variable {σ : Type w} {x : σ → D} (hx : IsTranscendenceBasis k x)
variable {F : Type t} [Field F] (f : MvPolynomial σ k →+* F)

/-- The actual map on the parameter-generated coefficient algebra. -/
def coefficientMap : Algebra.adjoin k (Set.range x) →+* F :=
  f.comp hx.1.aevalEquiv.symm.toRingHom

theorem coefficientMap_injective (hf : Function.Injective f) :
    Function.Injective (coefficientMap hx f) :=
  hf.comp hx.1.aevalEquiv.symm.injective

variable {E : Type*} [CommRing E] [Algebra F E] (g : D →+* E)

/-- Compatibility on the parameter polynomial ring gives compatibility on its
actual image coefficient algebra, not on an assumed coefficient-field section. -/
theorem coefficient_triangle
    (hfg : (algebraMap F E).comp f = g.comp (MvPolynomial.aeval x).toRingHom) :
    (algebraMap F E).comp (coefficientMap hx f) =
      g.comp (algebraMap (Algebra.adjoin k (Set.range x)) D) := by
  apply RingHom.ext
  intro a
  obtain ⟨p, rfl⟩ := hx.1.aevalEquiv.surjective a
  change algebraMap F E (f (hx.1.aevalEquiv.symm (hx.1.aevalEquiv p))) =
    g (algebraMap (Algebra.adjoin k (Set.range x)) D (hx.1.aevalEquiv p))
  rw [AlgEquiv.symm_apply_apply, hx.1.algebraMap_aevalEquiv]
  exact DFunLike.congr_fun hfg p

include hx

/-- Algebraicity is transported along the explicitly constructed coefficient map. -/
theorem isIntegral_image (hf : Function.Injective f)
    (hfg : (algebraMap F E).comp f = g.comp (MvPolynomial.aeval x).toRingHom)
    (d : D) : IsIntegral F (g d) := by
  let := hx.isAlgebraic
  have hd : IsAlgebraic (Algebra.adjoin k (Set.range x)) d :=
    Algebra.IsAlgebraic.isAlgebraic d
  exact (hd.ringHom_of_comp_eq (coefficientMap hx f) g
    (coefficientMap_injective hx f hf) (coefficient_triangle hx f g hfg)).isIntegral

/-- The resulting annihilator is the actual minimal polynomial. -/
theorem minpoly_spec [Nontrivial E] (hf : Function.Injective f)
    (hfg : (algebraMap F E).comp f = g.comp (MvPolynomial.aeval x).toRingHom)
    (d : D) :
    (minpoly F (g d)).Monic ∧ 0 < (minpoly F (g d)).natDegree ∧
      Polynomial.aeval (g d) (minpoly F (g d)) = 0 := by
  have hi := isIntegral_image hx f g hf hfg d
  exact ⟨minpoly.monic hi, minpoly.natDegree_pos hi, minpoly.aeval F (g d)⟩

end ResidueParameterAnnihilator

namespace ResidueMonicEquations

variable {F : Type u} [Field F] {B : Type v} [CommRing B] [Algebra F B]
variable {ι : Type w} (z : ι → B) (q : Ideal B) [q.IsPrime]

/-- Actual monic residue equations, not a supplied family of witnesses. -/
def equations : ι → Polynomial F := fun i => minpoly F (Ideal.Quotient.mk q (z i))

theorem equations_spec
    (hz : ∀ i, IsIntegral F (Ideal.Quotient.mk q (z i))) :
    (∀ i, (equations (F := F) z q i).Monic) ∧
    (∀ i, 0 < (equations (F := F) z q i).natDegree) ∧
    (∀ i, Polynomial.aeval (z i) (equations (F := F) z q i) ∈ q) := by
  refine ⟨fun i => minpoly.monic (hz i), fun i => minpoly.natDegree_pos (hz i), ?_⟩
  intro i
  rw [← Ideal.Quotient.eq_zero_iff_mem]
  change (Ideal.Quotient.mkₐ F q)
    (Polynomial.aeval (z i) (equations (F := F) z q i)) = 0
  rw [← Polynomial.aeval_algHom_apply (Ideal.Quotient.mkₐ F q)]
  exact minpoly.aeval F (Ideal.Quotient.mk q (z i))

end ResidueMonicEquations
