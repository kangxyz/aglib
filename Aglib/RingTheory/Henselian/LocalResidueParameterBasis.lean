module

public import Aglib.RingTheory.Henselian.ResidueParameterBasis
public import Aglib.RingTheory.DiscreteValuationRing.ParameterResidue

/-!
# Actual residue parameters over a local coefficient ring

Only the prime quotient receives the residue-field action. Its finite
transcendence basis is selected among the images of the actual algebra
generators. In the DVR case the parameter map contracts the prime to the
literal ideal generated by the constant uniformizer.
-/

@[expose] public noncomputable section

universe u v w
namespace LocalResidueParameterBasis
open IsLocalRing

section Local

variable {R : Type u} [CommRing R] [IsLocalRing R]
variable {B : Type v} [CommRing B] [Algebra R B]
variable (q : Ideal B) [q.IsPrime]
variable (hq : q.comap (algebraMap R B) = maximalIdeal R)

/-- The residue action exists on the prime quotient, not on the source. -/
abbrev residueAlgebra : Algebra (ResidueField R) (B ⧸ q) :=
  Ideal.Quotient.algebraQuotientOfLEComap (le_of_eq hq.symm)

omit [q.IsPrime] in
/-- The coefficient triangle is the native quotient triangle. -/
theorem residue_triangle :
    let := residueAlgebra q hq
    (algebraMap (ResidueField R) (B ⧸ q)).comp (residue R) =
      algebraMap R (B ⧸ q) := by
  let := residueAlgebra q hq
  ext r
  rfl

omit [q.IsPrime] in
/-- Algebra generators remain generators after reducing the coefficient ring. -/
theorem residue_adjoin_eq_top {ι : Type w} (z : ι → B)
    (hz : Algebra.adjoin R (Set.range z) = ⊤) :
    let := residueAlgebra q hq
    Algebra.adjoin (ResidueField R) (Set.range (fun i => Ideal.Quotient.mk q (z i))) = ⊤ := by
  let := residueAlgebra q hq
  let : IsScalarTower R (ResidueField R) (B ⧸ q) :=
    IsScalarTower.of_algebraMap_eq' (residue_triangle q hq).symm
  let C := Algebra.adjoin (ResidueField R)
    (Set.range (fun i => Ideal.Quotient.mk q (z i)))
  let D := (C.restrictScalars R).comap (Ideal.Quotient.mkₐ R q)
  have hle : Algebra.adjoin R (Set.range z) ≤ D := by
    apply Algebra.adjoin_le
    rintro _ ⟨i, rfl⟩
    exact Algebra.subset_adjoin ⟨i, rfl⟩
  apply top_unique
  intro x _
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x
  exact hle (by rw [hz]; trivial)

/-- Select actual source-generator indices, with no residue section or
separability assumption. -/
theorem exists_residue_basis {ι : Type w} [Finite ι] (z : ι → B)
    (hz : Algebra.adjoin R (Set.range z) = ⊤) :
    let := residueAlgebra q hq
    ∃ s : Set (B ⧸ q), s.Finite ∧ ∃ t : s → ι,
      (∀ a, Ideal.Quotient.mk q (z (t a)) = (a : B ⧸ q)) ∧
      IsTranscendenceBasis (ResidueField R) ((↑) : s → B ⧸ q) := by
  classical
  let := residueAlgebra q hq
  let r : ι → B ⧸ q := fun i => Ideal.Quotient.mk q (z i)
  have hr : Algebra.adjoin (ResidueField R) (Set.range r) = ⊤ :=
    residue_adjoin_eq_top q hq z hz
  let : Algebra.IsAlgebraic (Algebra.adjoin (ResidueField R) (Set.range r)) (B ⧸ q) := by
    constructor
    intro x
    have hx : x ∈ Algebra.adjoin (ResidueField R) (Set.range r) := by rw [hr]; trivial
    exact isAlgebraic_algebraMap (A := B ⧸ q)
      (⟨x, hx⟩ : Algebra.adjoin (ResidueField R) (Set.range r))
  obtain ⟨s, hs, hb⟩ := exists_isTranscendenceBasis_subset (R := ResidueField R) (Set.range r)
  refine ⟨s, (Set.finite_range r).subset hs,
    (fun a => Classical.choose (hs a.property)), ?_, hb⟩
  intro a
  exact Classical.choose_spec (hs a.property)

end Local

variable {R : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
variable {B : Type v} [CommRing B] [Algebra R B]
variable (q : Ideal B) [q.IsPrime]
variable (hq : q.comap (algebraMap R B) = maximalIdeal R)
variable {σ : Type*} (t : σ → B) (π : R) [Fact (Irreducible π)]

omit [q.IsPrime] in
/-- Residue independence gives the exact vertical parameter contraction. -/
theorem parameterMap_comap
    (ht : let := residueAlgebra q hq
      AlgebraicIndependent (ResidueField R) (fun i => Ideal.Quotient.mk q (t i))) :
    q.comap (MvPolynomial.aeval t).toRingHom =
      ParameterLocalization.parameterIdeal R σ π := by
  let := residueAlgebra q hq
  have heval : (Ideal.Quotient.mk q).comp (MvPolynomial.aeval t).toRingHom =
      (MvPolynomial.aeval (fun i => Ideal.Quotient.mk q (t i))).toRingHom.comp
        (MvPolynomial.map (residue R)) := by
    apply MvPolynomial.ringHom_ext
    · intro r
      change Ideal.Quotient.mk q (MvPolynomial.aeval t (MvPolynomial.C r)) =
        MvPolynomial.aeval (fun i => Ideal.Quotient.mk q (t i))
          (MvPolynomial.map (residue R) (MvPolynomial.C r))
      rw [MvPolynomial.map_C, MvPolynomial.aeval_C, MvPolynomial.aeval_C]
      rfl
    · intro i
      simp
  rw [← ParameterLocalization.ker_map_residue R σ π]
  ext f
  change MvPolynomial.aeval t f ∈ q ↔ MvPolynomial.map (residue R) f = 0
  rw [← Ideal.Quotient.eq_zero_iff_mem]
  change ((Ideal.Quotient.mk q).comp (MvPolynomial.aeval t).toRingHom) f = 0 ↔ _
  rw [heval]
  exact (algebraicIndependent_iff_injective_aeval.mp ht).eq_iff' (map_zero _)

end LocalResidueParameterBasis
