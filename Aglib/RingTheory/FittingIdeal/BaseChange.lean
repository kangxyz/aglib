module

public import Aglib.RingTheory.FittingIdeal.Basic
public import Mathlib.LinearAlgebra.TensorProduct.Pi
public import Mathlib.LinearAlgebra.TensorProduct.RightExactness
public import Mathlib.RingTheory.Localization.BaseChange

/-!
# Base change of Fitting ideals

For a ring map `R → S` and a finitely generated `R`-module `M`,
`Fitt_k(S ⊗[R] M) = Fitt_k(M) S` (Stacks Project, Tag 07ZA (3)). A presentation
`R^n → M → 0` with kernel `K` base-changes, by right exactness of the tensor product, to a
presentation `S^n → S ⊗[R] M → 0` whose kernel is spanned by the image of `K`; the minors of the
image vectors are the images of the minors.

* `Module.fittingIdeal_baseChange`: the statement for `S ⊗[R] M`;
* `Module.fittingIdeal_of_isBaseChange`: the same for any `IsBaseChange S g`;
* `Module.fittingIdeal_of_isLocalizedModule`: localizations, `Fitt_k(M_p) = Fitt_k(M) R_p`.
-/

@[expose] public section

open Function TensorProduct

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]

namespace Module

/-- The kernel of the base change `S^n → S ⊗[R] M` of a presentation `R^n → M` is spanned by the
images of the relations. -/
private theorem ker_baseChange_comp_piScalarRight_symm {n : ℕ} (S : Type*) [CommRing S]
    [Algebra R S] {f : (Fin n → R) →ₗ[R] M} (hf : Surjective f) :
    LinearMap.ker ((f.baseChange S) ∘ₗ (piScalarRight R S S (Fin n)).symm.toLinearMap) =
      Submodule.span S ((fun x : Fin n → R => fun i => algebraMap R S (x i)) ''
        (LinearMap.ker f : Set (Fin n → R))) := by
  set e := piScalarRight R S S (Fin n)
  have hexact := (lTensor_exact S (LinearMap.exact_subtype_ker_map f) hf).linearMap_ker_eq
  have he : ∀ x : Fin n → R, e (1 ⊗ₜ x) = fun i => algebraMap R S (x i) := fun x => by
    funext i
    simp [e, Algebra.smul_def]
  ext y
  constructor
  · intro hy
    have h1 : e.symm y ∈ LinearMap.ker (LinearMap.lTensor S f) := by
      rw [LinearMap.mem_ker, ← LinearMap.baseChange_eq_ltensor]
      exact hy
    rw [hexact] at h1
    obtain ⟨z, hz⟩ := h1
    rw [← e.apply_symm_apply y, ← hz]
    clear hz hy
    induction z with
    | tmul s x =>
      have hs : (LinearMap.lTensor S (LinearMap.ker f).subtype) (s ⊗ₜ[R] x) =
          s • (1 ⊗ₜ[R] (x : Fin n → R)) := by
        rw [LinearMap.lTensor_tmul, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        rfl
      rw [hs, map_smul, he]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨x, x.2, rfl⟩)
    | add z₁ z₂ h₁ h₂ =>
      rw [map_add, map_add]
      exact add_mem h₁ h₂
  · intro hy
    refine (Submodule.span_le.2 ?_) hy
    rintro _ ⟨x, hx, rfl⟩
    change (f.baseChange S) (e.symm (fun i => algebraMap R S (x i))) = 0
    rw [← he, e.symm_apply_apply, LinearMap.baseChange_tmul, LinearMap.mem_ker.1 hx,
      TensorProduct.tmul_zero]

/-- Base change of Fitting ideals (Stacks Project, Tag 07ZA (3)): for a ring map `R → S` and a
finitely generated `R`-module `M`, `Fitt_k(S ⊗[R] M)` is the ideal of `S` generated by the image
of `Fitt_k(M)`. -/
theorem fittingIdeal_baseChange [Module.Finite R M] (S : Type*) [CommRing S] [Algebra R S]
    (k : ℕ) : fittingIdeal S (S ⊗[R] M) k = (fittingIdeal R M k).map (algebraMap R S) := by
  obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' R M
  set e := piScalarRight R S S (Fin n)
  have hfS : Surjective ((f.baseChange S) ∘ₗ e.symm.toLinearMap) := by
    have : Surjective (f.baseChange S) := by
      rw [LinearMap.baseChange_eq_ltensor]
      exact LinearMap.lTensor_surjective S hf
    exact this.comp e.symm.surjective
  rw [fittingIdeal_eq_minorIdeal_ker hfS, fittingIdeal_eq_minorIdeal_ker hf,
    ker_baseChange_comp_piScalarRight_symm S hf, Submodule.span_minorIdeal,
    Submodule.minorIdeal, Ideal.map_span]
  congr 1
  ext x
  constructor
  · rintro ⟨v, e', hv, rfl⟩
    choose u hu huv using hv
    refine ⟨_, ⟨u, e', hu, rfl⟩, ?_⟩
    rw [RingHom.map_det]
    congr 1
    ext j i
    simp [← huv j]
  · rintro ⟨_, ⟨u, e', hu, rfl⟩, rfl⟩
    refine ⟨fun j i => algebraMap R S (u j i), e', fun j => ⟨u j, hu j, rfl⟩, ?_⟩
    rw [RingHom.map_det]
    rfl

/-- Base change of Fitting ideals along any `IsBaseChange S g` (Stacks Project, Tag 07ZA (3)). -/
theorem fittingIdeal_of_isBaseChange [Module.Finite R M] {S N : Type*} [CommRing S]
    [Algebra R S] [AddCommGroup N] [Module R N] [Module S N] [IsScalarTower R S N]
    {g : M →ₗ[R] N} (hg : IsBaseChange S g) (k : ℕ) :
    fittingIdeal S N k = (fittingIdeal R M k).map (algebraMap R S) := by
  rw [← fittingIdeal_baseChange S k, fittingIdeal_congr hg.equiv]

/-- Localization of Fitting ideals: `Fitt_k(M_p) = Fitt_k(M) R_p` for a localization `R_p` of `R`
at a submonoid `p` and a localization `M_p` of `M` (Stacks Project, Tag 07ZA (3)). -/
theorem fittingIdeal_of_isLocalizedModule [Module.Finite R M] (p : Submonoid R)
    {Rₚ Mₚ : Type*} [CommRing Rₚ] [Algebra R Rₚ] [IsLocalization p Rₚ] [AddCommGroup Mₚ]
    [Module R Mₚ] [Module Rₚ Mₚ] [IsScalarTower R Rₚ Mₚ] (g : M →ₗ[R] Mₚ)
    [IsLocalizedModule p g] (k : ℕ) :
    fittingIdeal Rₚ Mₚ k = (fittingIdeal R M k).map (algebraMap R Rₚ) :=
  fittingIdeal_of_isBaseChange (IsLocalizedModule.isBaseChange p Rₚ g) k

end Module
