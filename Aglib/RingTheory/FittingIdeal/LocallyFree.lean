module

public import Aglib.RingTheory.FittingIdeal.BaseChange
public import Mathlib.LinearAlgebra.Dimension.Constructions
public import Mathlib.LinearAlgebra.Dimension.Free
public import Mathlib.LinearAlgebra.Matrix.NonsingularInverse
public import Mathlib.RingTheory.LocalProperties.Basic
public import Mathlib.RingTheory.Localization.Finiteness
public import Mathlib.RingTheory.Spectrum.Prime.FreeLocus

/-!
# Fitting ideals and local freeness

* `Module.span_compl_range_eq_top_of_isUnit_det`: if a minor of size `s` of the relations of a
  presentation `R^ι ↠ M` is a unit, then `M` is generated by the images of the basis vectors
  outside the rows of the minor (the elimination step behind Stacks Project, Tag 07ZC).
* `Module.fittingIdeal_eq_top_iff_exists_finset`: over a local ring, `Fitt_k(M) = R` if and only
  if `M` is generated by `k` elements (Stacks, Tag 07ZC, (1) ⇔ (3) at the closed point).
* `Module.fittingIdeal_eq_bot_and_eq_top_iff_of_isLocalRing`: over a local ring, `M` is free of
  rank `r` if and only if `Fitt_k(M) = 0` for `k < r` and `Fitt_r(M) = R`; the variant
  `Module.free_and_finrank_eq_succ_iff_of_isLocalRing` is the form `Fitt_r = 0`,
  `Fitt_{r+1} = R` for rank `r + 1` (Stacks, Tag 07ZD, local case).
* `Module.fittingIdeal_eq_bot_and_eq_top_iff`: for a finitely generated `M`, all localizations
  `M_p` at primes are free of rank `r` (`Module.freeLocus` is everything and
  `Module.rankAtStalk` is `r`) if and only if `Fitt_k(M) = 0` for `k < r` and `Fitt_r(M) = R`
  (Stacks, Tag 07ZD, with (1) in stalkwise form);
  `Module.fittingIdeal_eq_bot_and_eq_top_iff_projective` is the form "projective of constant
  rank `r`" for finitely presented `M`.

Stacks, Tag 07ZD (1) asks that `M` be finite locally free of rank `r` in the Zariski sense: a
cover by `D(f_i)` with `M_{f_i} ≅ R_{f_i}^r`. The statements here prove the stalkwise form (free
of rank `r` at every prime). Passing from it to Zariski-local freeness, and deducing that `M` is
finitely presented, needs Stacks, Tag 07ZC (4), which is not formalized; this is why the
projective form assumes `[Module.FinitePresentation R M]`, a hypothesis Stacks does not need.

All statements are for finitely generated modules over arbitrary commutative rings; no
Noetherian hypothesis is used. The convention `Fitt_{-1}(M) = 0` of Stacks, Tag 07Z9 is encoded
by the hypothesis `∀ k < r, fittingIdeal R M k = ⊥`, which is vacuous for `r = 0`.
-/

@[expose] public section

open Function

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]

namespace Module

/-- Elimination: if `R^ι ↠ M` is a presentation, `v j` are relations and the minor of the `v j`
at the rows given by an injective `e : Fin s → ι` is a unit, then `M` is generated by the images
of the basis vectors `Pi.single l 1` with `l` outside the range of `e`. -/
theorem span_compl_range_eq_top_of_isUnit_det {ι : Type*} [Finite ι] [DecidableEq ι]
    {f : (ι → R) →ₗ[R] M} (hf : Surjective f) {s : ℕ} {v : Fin s → ι → R}
    (hv : ∀ j, v j ∈ LinearMap.ker f) {e : Fin s → ι} (he : Function.Injective e)
    (hdet : IsUnit (Matrix.of fun j i => v j (e i)).det) :
    Submodule.span R ((fun l => f (Pi.single l 1)) '' {l | l ∉ Set.range e}) = ⊤ := by
  cases nonempty_fintype ι
  set N := Submodule.span R ((fun l => f (Pi.single l 1)) '' {l | l ∉ Set.range e})
  set B : Matrix (Fin s) (Fin s) R := Matrix.of fun j i => v j (e i)
  set b : ι → M ⧸ N := fun l => N.mkQ (f (Pi.single l 1))
  have hb : ∀ l, l ∉ Set.range e → b l = 0 := fun l hl =>
    (Submodule.Quotient.mk_eq_zero N).2 (Submodule.subset_span ⟨l, hl, rfl⟩)
  have hsum : ∀ x : ι → R, N.mkQ (f x) = ∑ l, x l • b l := by
    intro x
    conv_lhs => rw [pi_eq_sum_univ' x]
    simp [map_sum, map_smul, b]
  have hy : ∀ j, ∑ i, v j (e i) • b (e i) = 0 := by
    intro j
    have h0 : N.mkQ (f (v j)) = 0 := by rw [LinearMap.mem_ker.1 (hv j), map_zero]
    rw [hsum] at h0
    rw [← h0, ← Finset.sum_image (f := fun l => v j l • b l) fun i _ i' _ h => he h]
    refine Finset.sum_subset (Finset.subset_univ _) fun l _ hl => ?_
    rw [hb l (by simpa using hl), smul_zero]
  set Y : (Fin s → R) →ₗ[R] M ⧸ N := Fintype.linearCombination R fun i => b (e i)
  have hrow : ∀ j, Y (B j) = 0 := fun j => by
    simpa [Y, Fintype.linearCombination_apply, B] using hy j
  have hall : ∀ c, Y c = 0 := by
    intro c
    have hc : c = Matrix.vecMul (Matrix.vecMul c B⁻¹) B := by
      rw [Matrix.vecMul_vecMul, Matrix.nonsing_inv_mul _ hdet, Matrix.vecMul_one]
    rw [hc, Matrix.vecMul_eq_sum, map_sum]
    simp [hrow]
  have hgen : ∀ l, f (Pi.single l 1) ∈ N := by
    intro l
    by_cases hl : l ∈ Set.range e
    · obtain ⟨i, rfl⟩ := hl
      have := hall (Pi.single i 1)
      simp only [Y, Fintype.linearCombination_apply_single, one_smul] at this
      exact (Submodule.Quotient.mk_eq_zero N).1 this
    · exact Submodule.subset_span ⟨l, hl, rfl⟩
  refine eq_top_iff.2 fun m _ => ?_
  obtain ⟨x, rfl⟩ := hf m
  rw [pi_eq_sum_univ' x, map_sum]
  exact Submodule.sum_mem _ fun l _ => by
    rw [map_smul]
    exact N.smul_mem _ (hgen l)

/-- A surjection from a finite free module gives a finite set of generators of at most the
number of basis vectors. -/
private theorem exists_finset_card_le_of_surjective {n : ℕ} {f : (Fin n → R) →ₗ[R] M}
    (S : Finset (Fin n))
    (hS : Submodule.span R ((fun l => f (Pi.single l 1)) '' (S : Set (Fin n))) = ⊤) :
    ∃ s : Finset M, s.card ≤ S.card ∧ Submodule.span R (s : Set M) = ⊤ := by
  classical
  exact ⟨S.image fun l => f (Pi.single l 1), Finset.card_image_le, by
    rw [Finset.coe_image]
    exact hS⟩

/-- Over a local ring, `Fitt_k(M) = R` if and only if `M` is generated by `k` elements
(Stacks Project, Tag 07ZC, (1) ⇔ (3) at the closed point). -/
theorem fittingIdeal_eq_top_iff_exists_finset [IsLocalRing R] [Module.Finite R M] {k : ℕ} :
    fittingIdeal R M k = ⊤ ↔ ∃ s : Finset M, s.card ≤ k ∧ Submodule.span R (s : Set M) = ⊤ := by
  classical
  constructor
  · intro h
    obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' R M
    have hall : Submodule.span R ((fun l => f (Pi.single l 1)) ''
        ((Finset.univ : Finset (Fin n)) : Set (Fin n))) =
        ⊤ := by
      refine eq_top_iff.2 fun m _ => ?_
      obtain ⟨x, rfl⟩ := hf m
      rw [pi_eq_sum_univ' x, map_sum]
      exact Submodule.sum_mem _ fun l _ => by
        rw [map_smul]
        exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨l, by simp, rfl⟩)
    by_cases hk : n ≤ k
    · obtain ⟨s, hs, hspan⟩ := exists_finset_card_le_of_surjective _ hall
      exact ⟨s, hs.trans (by simpa using hk), hspan⟩
    rw [fittingIdeal_eq_minorIdeal_ker hf, Nat.card_fin] at h
    obtain ⟨_, ⟨v, e, hv, rfl⟩, hu⟩ : ∃ x ∈ {x | ∃ (v : Fin (n - k) → Fin n → R)
        (e : Fin (n - k) → Fin n), (∀ j, v j ∈ LinearMap.ker f) ∧
          (Matrix.of fun j i => v j (e i)).det = x}, IsUnit x := by
      by_contra hne
      push Not at hne
      have hle : (LinearMap.ker f).minorIdeal (n - k) ≤ IsLocalRing.maximalIdeal R :=
        Ideal.span_le.2 fun x hx => (IsLocalRing.mem_maximalIdeal x).2 (hne x hx)
      rw [h] at hle
      exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top (top_le_iff.1 hle)
    have he : Function.Injective e := by
      by_contra hni
      obtain ⟨i, i', hii', hne⟩ := Function.not_injective_iff.1 hni
      rw [Matrix.det_zero_of_column_eq hne fun j => by simp [hii']] at hu
      exact not_isUnit_zero hu
    have hspan := span_compl_range_eq_top_of_isUnit_det hf hv he hu
    refine (exists_finset_card_le_of_surjective (Finset.univ.filter fun l => l ∉ Set.range e)
      (by simpa using hspan)).imp fun s hs => ⟨hs.1.trans ?_, hs.2⟩
    have h1 := Finset.card_filter_add_card_filter_not (s := Finset.univ)
      (fun l : Fin n => l ∈ Set.range e)
    have h2 : (Finset.univ.filter fun l : Fin n => l ∈ Set.range e) = Finset.univ.image e := by
      ext
      simp
    rw [h2, Finset.card_image_of_injective _ he, Finset.card_univ, Fintype.card_fin,
      Finset.card_univ, Fintype.card_fin] at h1
    omega
  · rintro ⟨s, hs, hspan⟩
    refine fittingIdeal_eq_top_of_span_eq_top (v := ((↑) : s → M)) (by simpa using hspan) ?_
    rw [Nat.card_eq_fintype_card, Fintype.card_coe]
    exact hs

/-- Over a local ring, a finitely generated module `M` is free of rank `r` if and only if
`Fitt_k(M) = 0` for `k < r` and `Fitt_r(M) = R` (Stacks Project, Tag 07ZD, (1) ⇔ (3), local
case). -/
theorem fittingIdeal_eq_bot_and_eq_top_iff_of_isLocalRing [IsLocalRing R] [Module.Finite R M]
    {r : ℕ} : ((∀ k < r, fittingIdeal R M k = ⊥) ∧ fittingIdeal R M r = ⊤) ↔
      Module.Free R M ∧ Module.finrank R M = r := by
  constructor
  · rintro ⟨hbot, htop⟩
    obtain ⟨s, hs, hspan⟩ := fittingIdeal_eq_top_iff_exists_finset.1 htop
    set g : (s → R) →ₗ[R] M := Fintype.linearCombination R ((↑) : s → M)
    have hg : Surjective g := by
      rw [← LinearMap.range_eq_top, Fintype.range_linearCombination]
      simpa using hspan
    have hcard : s.card = r := by
      by_contra hne
      have := hbot s.card (lt_of_le_of_ne hs hne)
      rw [fittingIdeal_eq_top_of_span_eq_top (v := ((↑) : s → M)) (by simpa using hspan)
        (by simp)] at this
      exact top_ne_bot this
    have hker : LinearMap.ker g = ⊥ := by
      rcases Nat.eq_zero_or_pos r with hr | hr
      · have : IsEmpty s := Finset.isEmpty_coe_sort.2 (Finset.card_eq_zero.1 (hcard.trans hr))
        exact eq_bot_iff.2 fun x _ => (Submodule.mem_bot R).2 (Subsingleton.elim x 0)
      · have := hbot (r - 1) (by omega)
        rwa [fittingIdeal_eq_minorIdeal_ker hg, Nat.card_eq_fintype_card, Fintype.card_coe,
          hcard, show r - (r - 1) = 1 by omega, Submodule.minorIdeal_one_eq_bot_iff] at this
    let e := LinearEquiv.ofBijective g ⟨LinearMap.ker_eq_bot.1 hker, hg⟩
    refine ⟨Module.Free.of_equiv e, ?_⟩
    rw [← e.finrank_eq, Module.finrank_fintype_fun_eq_card, Fintype.card_coe, hcard]
  · rintro ⟨_, hrank⟩
    have key := fittingIdeal_of_basis (Module.finBasis R M)
    refine ⟨fun k hk => ?_, ?_⟩
    · rw [key, ite_eq_right (by rw [Nat.card_fin, hrank]; omega)]
    · rw [key, ite_eq_left (by rw [Nat.card_fin, hrank])]

/-- Over a local ring, a finitely generated module is free of rank `r + 1` if and only if
`Fitt_r(M) = 0` and `Fitt_{r+1}(M) = R` (Stacks Project, Tag 07ZD, (1) ⇔ (2), local case). -/
theorem free_and_finrank_eq_succ_iff_of_isLocalRing [IsLocalRing R] [Module.Finite R M]
    {r : ℕ} : Module.Free R M ∧ Module.finrank R M = r + 1 ↔
      fittingIdeal R M r = ⊥ ∧ fittingIdeal R M (r + 1) = ⊤ := by
  rw [← fittingIdeal_eq_bot_and_eq_top_iff_of_isLocalRing]
  refine and_congr_left' ⟨fun h => h r r.lt_succ_self, fun h k hk => ?_⟩
  exact eq_bot_iff.2 (h ▸ fittingIdeal_mono (Nat.le_of_lt_succ hk))

/-- `Fitt_k(M)` localized at a prime `p` is the `k`-th Fitting ideal of `M_p`. -/
private theorem fittingIdeal_localizedModule_atPrime [Module.Finite R M] (p : PrimeSpectrum R)
    (k : ℕ) : fittingIdeal (Localization.AtPrime p.asIdeal)
      (LocalizedModule p.asIdeal.primeCompl M) k =
        (fittingIdeal R M k).map (algebraMap R (Localization.AtPrime p.asIdeal)) :=
  fittingIdeal_of_isLocalizedModule p.asIdeal.primeCompl (LocalizedModule.mkLinearMap _ M) k

/-- Stacks Project, Tag 07ZD, (1) ⇔ (3), with (1) in stalkwise form: a finitely generated module
`M` has free localizations `M_p` of rank `r` at all primes `p` if and only if `Fitt_k(M) = 0` for
`k < r` and `Fitt_r(M) = R`. Zariski-local finite freeness of rank `r` (Stacks, Tag 07ZD (1)
itself) would need Stacks, Tag 07ZC (4), which is not formalized. -/
theorem fittingIdeal_eq_bot_and_eq_top_iff [Module.Finite R M] {r : ℕ} :
    ((∀ k < r, fittingIdeal R M k = ⊥) ∧ fittingIdeal R M r = ⊤) ↔
      ∀ p : PrimeSpectrum R, p ∈ Module.freeLocus R M ∧ Module.rankAtStalk M p = r := by
  constructor
  · rintro ⟨hbot, htop⟩ p
    exact (fittingIdeal_eq_bot_and_eq_top_iff_of_isLocalRing (r := r)).1
      ⟨fun k hk => by rw [fittingIdeal_localizedModule_atPrime, hbot k hk, Ideal.map_bot], by
        rw [fittingIdeal_localizedModule_atPrime, htop, Ideal.map_top]⟩
  · intro h
    have hp : ∀ (p : PrimeSpectrum R) (k : ℕ),
        (fittingIdeal R M k).map (algebraMap R (Localization.AtPrime p.asIdeal)) =
          if r ≤ k then ⊤ else ⊥ := by
      intro p k
      have := (fittingIdeal_eq_bot_and_eq_top_iff_of_isLocalRing (r := r)).2 (h p)
      rw [← fittingIdeal_localizedModule_atPrime]
      split_ifs with hk
      · exact top_unique (this.2 ▸ fittingIdeal_mono hk)
      · exact this.1 k (by omega)
    refine ⟨fun k hk => ideal_eq_bot_of_localization' _ fun J hJ => ?_, ?_⟩
    · have := hp ⟨J, hJ.isPrime⟩ k
      rw [ite_eq_right (by omega)] at this
      exact this
    · by_contra hne
      obtain ⟨J, hJ, hle⟩ := Ideal.exists_le_maximal _ hne
      have h1 := hp ⟨J, hJ.isPrime⟩ r
      rw [ite_eq_left le_rfl] at h1
      have h2 : (fittingIdeal R M r).map (algebraMap R (Localization.AtPrime J)) ≤
          IsLocalRing.maximalIdeal _ := by
        rw [← Localization.AtPrime.map_eq_maximalIdeal]
        exact Ideal.map_mono hle
      rw [show (fittingIdeal R M r).map (algebraMap R (Localization.AtPrime J)) = ⊤ from h1]
        at h2
      exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top (top_le_iff.1 h2)

/-- Stacks Project, Tag 07ZD, (1) ⇔ (2) for rank `r + 1`, with (1) in stalkwise form: all
localizations of `M` at primes are free of rank `r + 1` if and only if `Fitt_r(M) = 0` and
`Fitt_{r+1}(M) = R`. Zariski-local finite freeness needs the unformalized Stacks, Tag 07ZC (4). -/
theorem fittingIdeal_eq_bot_and_eq_top_iff_succ [Module.Finite R M] {r : ℕ} :
    (fittingIdeal R M r = ⊥ ∧ fittingIdeal R M (r + 1) = ⊤) ↔
      ∀ p : PrimeSpectrum R, p ∈ Module.freeLocus R M ∧ Module.rankAtStalk M p = r + 1 := by
  rw [← fittingIdeal_eq_bot_and_eq_top_iff]
  refine and_congr_left' ⟨fun h k hk => ?_, fun h => h r r.lt_succ_self⟩
  exact eq_bot_iff.2 (h ▸ fittingIdeal_mono (Nat.le_of_lt_succ hk))

/-- For a finitely presented module, `Fitt_k(M) = 0` for `k < r` and `Fitt_r(M) = R` if and only
if `M` is projective of constant rank `r` (Stacks Project, Tag 07ZD). Finite presentation is
assumed because the deduction of finite presentation from the Fitting conditions (through
Stacks, Tag 07ZC (4)) is not formalized. -/
theorem fittingIdeal_eq_bot_and_eq_top_iff_projective [Module.FinitePresentation R M] {r : ℕ} :
    ((∀ k < r, fittingIdeal R M k = ⊥) ∧ fittingIdeal R M r = ⊤) ↔
      Module.Projective R M ∧ ∀ p : PrimeSpectrum R, Module.rankAtStalk M p = r := by
  rw [fittingIdeal_eq_bot_and_eq_top_iff, ← Module.freeLocus_eq_univ_iff, Set.eq_univ_iff_forall,
    forall_and]

end Module
