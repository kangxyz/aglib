module

public import Aglib.LinearAlgebra.Multilinear.Span
public import Mathlib.LinearAlgebra.Matrix.Adjugate
public import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
public import Mathlib.RingTheory.Ideal.Maps

/-!
# Ideals of minors

For a commutative ring `R`, a matrix `A : Matrix m n R` and `r : ℕ`, `Matrix.minorIdeal A r` is
the ideal `I_r(A)` generated by the `r × r` minors of `A` (Stacks Project, Tag 07Z7). The rows and
columns of a minor are given by arbitrary functions `Fin r → m` and `Fin r → n`; a non-injective
choice repeats a row or a column and contributes `0`, so this is the usual ideal, with
`I_0(A) = R`.

For a submodule `N` of `ι → R`, `Submodule.minorIdeal N r` is the ideal generated by the `r × r`
minors of all matrices whose columns lie in `N`. A minor with rows `e : Fin r → ι` and columns
`v : Fin r → ι → R` is written as the determinant of the transposed matrix
`Matrix.of fun j i => v j (e i)`, which has the same value.

* `Submodule.span_minorIdeal` and `Matrix.minorIdeal_eq_minorIdeal_span`: the minors of a
  generating set (respectively of the columns of a matrix) generate the minor ideal of the span;
  this is the multilinearity step of Stacks, Tag 07Z8, through
  `MultilinearMap.map_mem_span_of_forall_mem_span` (`Aglib.LinearAlgebra.Multilinear.Span`).
* `Submodule.minorIdeal_succ_le`, `Submodule.minorIdeal_antitone`: `I_{r+1} ⊆ I_r`
  (Stacks, Tag 07Z7 (1)).
* `Submodule.minorIdeal_map_funLeft_le`, `Submodule.minorIdeal_map_funLeft_equiv`: renaming or
  repeating coordinates.
* `Submodule.minorIdeal_ker_succ`: adding one generator to a presentation raises the size of the
  minors by one without changing the ideal; this is the key step of Stacks, Tag 07Z8. Extension
  by zero from `ι → R` to `Option ι → R` is Mathlib's
  `(LinearEquiv.piOptionEquivProd R).symm.toLinearMap ∘ₗ LinearMap.inr R R (ι → R)`.
-/

@[expose] public section

open Function
open scoped Matrix

variable {R : Type*} [CommRing R]

namespace Matrix

variable {m n : Type*}

/-- The ideal `I_r(A)` generated by the `r × r` minors of `A` (Stacks Project, Tag 07Z7). Rows
and columns are chosen by arbitrary functions `Fin r → m` and `Fin r → n`; repeated rows or
columns give vanishing minors, so `I_0(A) = R` and `I_r(A) = 0` for `r` larger than the number of
rows or columns. -/
def minorIdeal (A : Matrix m n R) (r : ℕ) : Ideal R :=
  Ideal.span {x | ∃ (e : Fin r → m) (c : Fin r → n), (A.submatrix e c).det = x}

end Matrix

namespace Submodule

variable {ι κ : Type*}

/-- The ideal generated by the `r × r` minors of all matrices whose columns lie in the submodule
`N` of `ι → R`. The minor with rows `e : Fin r → ι` and columns `v : Fin r → ι → R` is written
as the determinant of the transposed matrix `Matrix.of fun j i => v j (e i)`. -/
def minorIdeal (N : Submodule R (ι → R)) (r : ℕ) : Ideal R :=
  Ideal.span {x | ∃ (v : Fin r → ι → R) (e : Fin r → ι), (∀ j, v j ∈ N) ∧
    (Matrix.of fun j i => v j (e i)).det = x}

theorem det_mem_minorIdeal {N : Submodule R (ι → R)} {r : ℕ} {v : Fin r → ι → R}
    (hv : ∀ j, v j ∈ N) (e : Fin r → ι) : (Matrix.of fun j i => v j (e i)).det ∈ N.minorIdeal r :=
  Ideal.subset_span ⟨v, e, hv, rfl⟩

/-- The minors of families of vectors of `T` generate the minor ideal of `span R T`
(the multilinearity step of Stacks, Tag 07Z8). -/
theorem span_minorIdeal (T : Set (ι → R)) (r : ℕ) :
    (span R T).minorIdeal r = Ideal.span {x | ∃ (v : Fin r → ι → R) (e : Fin r → ι),
      (∀ j, v j ∈ T) ∧ (Matrix.of fun j i => v j (e i)).det = x} := by
  refine le_antisymm (Ideal.span_le.2 ?_) (Ideal.span_mono ?_)
  · rintro _ ⟨v, e, hv, rfl⟩
    let D : MultilinearMap R (fun _ : Fin r => ι → R) R :=
      (Matrix.detRowAlternating : (Fin r → R) [⋀^Fin r]→ₗ[R] R).toMultilinearMap.compLinearMap
        fun _ => LinearMap.funLeft R R e
    have hD : ∀ w : Fin r → ι → R, D w = (Matrix.of fun j i => w j (e i)).det := fun _ => rfl
    have := D.map_mem_span_of_forall_mem_span hv
    rw [hD] at this
    refine (Submodule.span_le.2 ?_) this
    rintro _ ⟨w, hw, rfl⟩
    exact Ideal.subset_span ⟨w, e, hw, (hD w).symm⟩
  · rintro _ ⟨v, e, hv, rfl⟩
    exact ⟨v, e, fun j => subset_span (hv j), rfl⟩

/-- The minors of the columns of a matrix generate the minor ideal of their span: `I_r(A)` only
depends on the submodule spanned by the columns of `A` (the multilinearity step of Stacks,
Tag 07Z8). -/
theorem _root_.Matrix.minorIdeal_eq_minorIdeal_span {J : Type*} (A : Matrix ι J R) (r : ℕ) :
    A.minorIdeal r = (span R (Set.range Aᵀ)).minorIdeal r := by
  rw [span_minorIdeal]
  refine le_antisymm (Ideal.span_le.2 ?_) (Ideal.span_le.2 ?_)
  · rintro _ ⟨e, c, rfl⟩
    refine Ideal.subset_span ⟨fun j => Aᵀ (c j), e, fun j => ⟨c j, rfl⟩, ?_⟩
    rw [← Matrix.det_transpose]
    rfl
  · rintro _ ⟨v, e, hv, rfl⟩
    choose c hc using hv
    refine Ideal.subset_span ⟨e, c, ?_⟩
    rw [← Matrix.det_transpose]
    congr 1
    ext j i
    simp [← hc j]

theorem minorIdeal_mono {N N' : Submodule R (ι → R)} (h : N ≤ N') (r : ℕ) :
    N.minorIdeal r ≤ N'.minorIdeal r :=
  Ideal.span_mono fun _ ⟨v, e, hv, hx⟩ => ⟨v, e, fun j => h (hv j), hx⟩

@[simp]
theorem minorIdeal_zero (N : Submodule R (ι → R)) : N.minorIdeal 0 = ⊤ :=
  (Ideal.eq_top_iff_one _).2 <| Ideal.subset_span ⟨Fin.elim0, Fin.elim0, fun j => j.elim0,
    Matrix.det_isEmpty⟩

/-- `I_{r+1} ⊆ I_r` (Stacks Project, Tag 07Z7 (1)), by expansion along the first row. -/
theorem minorIdeal_succ_le (N : Submodule R (ι → R)) (r : ℕ) :
    N.minorIdeal (r + 1) ≤ N.minorIdeal r := by
  refine Ideal.span_le.2 ?_
  rintro _ ⟨v, e, hv, rfl⟩
  rw [Matrix.det_succ_row _ 0]
  exact sum_mem fun i _ => Ideal.mul_mem_left _ _ <|
    det_mem_minorIdeal (v := v ∘ (0 : Fin (r + 1)).succAbove) (fun j => hv _) (e ∘ i.succAbove)

theorem minorIdeal_antitone (N : Submodule R (ι → R)) : Antitone N.minorIdeal :=
  antitone_nat_of_succ_le N.minorIdeal_succ_le

@[simp]
theorem minorIdeal_bot_succ (r : ℕ) : (⊥ : Submodule R (ι → R)).minorIdeal (r + 1) = ⊥ := by
  refine (Ideal.span_eq_bot).2 ?_
  rintro _ ⟨v, e, hv, rfl⟩
  refine Matrix.det_eq_zero_of_row_eq_zero 0 fun i => ?_
  simp [(Submodule.mem_bot R).1 (hv 0)]

theorem minorIdeal_one_eq_bot_iff {N : Submodule R (ι → R)} : N.minorIdeal 1 = ⊥ ↔ N = ⊥ := by
  refine ⟨fun h => (Submodule.eq_bot_iff _).2 fun x hx => funext fun l => ?_, fun h => ?_⟩
  · have := det_mem_minorIdeal (v := fun _ : Fin 1 => x) (fun _ => hx) fun _ => l
    rw [h, Matrix.det_fin_one] at this
    simpa using this
  · rw [h]
    exact minorIdeal_bot_succ 0

/-- A maximal minor annihilates the cokernel: if `e : Fin r → ι` is surjective and the vectors
`v j` lie in `K`, then `det (v j (e i)) • x ∈ K` for every `x` (the adjugate argument of Stacks,
Tag 07ZA (6)). -/
theorem det_smul_mem_of_surjective {K : Submodule R (ι → R)} {r : ℕ} {v : Fin r → ι → R}
    (hv : ∀ j, v j ∈ K) {e : Fin r → ι} (he : Surjective e) (x : ι → R) :
    (Matrix.of fun j i => v j (e i)).det • x ∈ K := by
  set B : Matrix (Fin r) (Fin r) R := Matrix.of fun j i => v j (e i)
  set c : Fin r → R := Matrix.vecMul (x ∘ e) B.adjugate
  have hu : (∑ j, c j • v j) ∈ K := sum_mem fun j _ => K.smul_mem _ (hv j)
  convert hu using 1
  funext l
  obtain ⟨i, rfl⟩ := he l
  have hc : Matrix.vecMul c B i = B.det * x (e i) := by
    simp only [c, Matrix.vecMul_vecMul, Matrix.adjugate_mul, Matrix.vecMul_smul,
      Matrix.vecMul_one, Pi.smul_apply, smul_eq_mul, comp_apply]
  rw [Pi.smul_apply, smul_eq_mul, ← hc, Finset.sum_apply]
  simp [Matrix.vecMul, dotProduct, B]

/-- Renaming or repeating coordinates along `g : ι → κ` does not enlarge the minor ideal. -/
theorem minorIdeal_map_funLeft_le (g : ι → κ) (N : Submodule R (κ → R)) (r : ℕ) :
    (N.map (LinearMap.funLeft R R g)).minorIdeal r ≤ N.minorIdeal r := by
  refine Ideal.span_le.2 ?_
  rintro _ ⟨v, e, hv, rfl⟩
  choose u hu huv using fun j => (Submodule.mem_map).1 (hv j)
  have : (Matrix.of fun j i => v j (e i)) = Matrix.of fun j i => u j (g (e i)) := by
    ext j i
    simp [← huv j, LinearMap.funLeft_apply]
  rw [this]
  exact det_mem_minorIdeal hu (g ∘ e)

theorem minorIdeal_map_funLeft_equiv (σ : ι ≃ κ) (N : Submodule R (κ → R)) (r : ℕ) :
    (N.map (LinearMap.funLeft R R σ)).minorIdeal r = N.minorIdeal r := by
  refine le_antisymm (minorIdeal_map_funLeft_le σ N r) (Ideal.span_le.2 ?_)
  rintro _ ⟨v, e, hv, rfl⟩
  have : (Matrix.of fun j i => v j (e i)) =
      Matrix.of fun j i => (LinearMap.funLeft R R σ (v j)) (σ.symm (e i)) := by
    ext j i
    simp [LinearMap.funLeft_apply]
  rw [this]
  exact det_mem_minorIdeal (fun j => Submodule.mem_map_of_mem (hv j)) (σ.symm ∘ e)

/-- Reindexing a presentation along an equivalence of index types does not change the minor
ideals of its kernel. -/
theorem minorIdeal_ker_comp_funLeft {M : Type*} [AddCommGroup M] [Module R M]
    (f : (κ → R) →ₗ[R] M) (σ : ι ≃ κ) (r : ℕ) :
    (LinearMap.ker (f ∘ₗ LinearMap.funLeft R R σ.symm)).minorIdeal r =
      (LinearMap.ker f).minorIdeal r := by
  have : LinearMap.ker (f ∘ₗ LinearMap.funLeft R R σ.symm) =
      (LinearMap.ker f).map (LinearMap.funLeft R R σ) := by
    ext x
    simp only [LinearMap.mem_ker, LinearMap.comp_apply, Submodule.mem_map]
    refine ⟨fun hx => ⟨LinearMap.funLeft R R σ.symm x, hx, ?_⟩, ?_⟩
    · ext i
      simp [LinearMap.funLeft_apply]
    · rintro ⟨y, hy, rfl⟩
      convert hy using 2
      ext i
      simp [LinearMap.funLeft_apply]
  rw [this, minorIdeal_map_funLeft_equiv]

/-! ### Adding one generator -/

/-- A minor of extensions by zero of vectors of `K` lies in the minor ideal of `K`. -/
private theorem det_extendByZero_mem_minorIdeal {K : Submodule R (ι → R)} {s : ℕ}
    {u : Fin s → ι → R} (hu : ∀ j, u j ∈ K) (e : Fin s → Option ι) :
    (Matrix.of fun j i =>
      ((LinearEquiv.piOptionEquivProd R).symm.toLinearMap ∘ₗ LinearMap.inr R R (ι → R) :
        (ι → R) →ₗ[R] Option ι → R) (u j) (e i)).det ∈ K.minorIdeal s := by
  set E : (ι → R) →ₗ[R] Option ι → R :=
    (LinearEquiv.piOptionEquivProd R).symm.toLinearMap ∘ₗ LinearMap.inr R R (ι → R)
  have E_none : ∀ x, E x none = 0 := fun _ => rfl
  have E_some : ∀ x i, E x (some i) = x i := fun _ _ => rfl
  by_cases h : ∃ i, e i = none
  · obtain ⟨i, hi⟩ := h
    rw [Matrix.det_eq_zero_of_column_eq_zero i fun j => by simp [hi, E_none]]
    exact Ideal.zero_mem _
  · push Not at h
    choose l hl using fun i => Option.ne_none_iff_exists'.1 (h i)
    have : (Matrix.of fun j i => E (u j) (e i)) = Matrix.of fun j i => u j (l i) := by
      ext j i
      simp [hl i, E_some]
    rw [this]
    exact det_mem_minorIdeal hu l

/-- Adding one generator to a presentation raises the size of the minors by one without changing
the ideal (the key step of Stacks Project, Tag 07Z8). Here `h` is a map on `Option ι → R` whose
restriction to the old generators, along the extension by zero
`(LinearEquiv.piOptionEquivProd R).symm.toLinearMap ∘ₗ LinearMap.inr R R (ι → R)`, is surjective;
the kernel of `h` is spanned by the kernel of the restriction and one relation expressing the new
generator. -/
theorem minorIdeal_ker_succ {M : Type*} [AddCommGroup M] [Module R M]
    (h : (Option ι → R) →ₗ[R] M)
    (hh : Surjective (h ∘ₗ (LinearEquiv.piOptionEquivProd R).symm.toLinearMap ∘ₗ
      LinearMap.inr R R (ι → R))) (r : ℕ) :
    (LinearMap.ker h).minorIdeal (r + 1) =
      (LinearMap.ker (h ∘ₗ (LinearEquiv.piOptionEquivProd R).symm.toLinearMap ∘ₗ
        LinearMap.inr R R (ι → R))).minorIdeal r := by
  classical
  set E : (ι → R) →ₗ[R] Option ι → R :=
    (LinearEquiv.piOptionEquivProd R).symm.toLinearMap ∘ₗ LinearMap.inr R R (ι → R)
  have E_none : ∀ x, E x none = 0 := fun _ => rfl
  have E_some : ∀ x i, E x (some i) = x i := fun _ _ => rfl
  set K := LinearMap.ker (h ∘ₗ E)
  obtain ⟨a, ha⟩ := hh (h (Pi.single none 1))
  set w₀ : Option ι → R := Pi.single none 1 - E a
  have hw₀ : w₀ ∈ LinearMap.ker h := by
    simp only [w₀, LinearMap.mem_ker, map_sub]
    rw [← ha]
    simp
  have hext : ∀ v ∈ K, E v ∈ LinearMap.ker h := fun v hv => hv
  have hker : LinearMap.ker h = span R (insert w₀ (E '' (K : Set (ι → R)))) := by
    refine le_antisymm (fun w hw => ?_) (span_le.2 ?_)
    · rw [span_insert, span_image, span_eq, mem_sup]
      refine ⟨w none • w₀, mem_span_singleton.2 ⟨w none, rfl⟩,
        E (fun i => w (some i) + w none * a i), ?_, ?_⟩
      · refine ⟨_, ?_, rfl⟩
        have hw' : w = E (fun i => w (some i)) + w none • Pi.single none 1 := by
          funext o
          cases o <;> simp [E_none, E_some]
        have h0 : h w = 0 := hw
        rw [hw', map_add, map_smul, ← ha] at h0
        have hsum : E (fun i => w (some i) + w none * a i) =
            E (fun i => w (some i)) + w none • E a := by
          funext o
          cases o <;> simp [E_none, E_some]
        change h (E _) = 0
        rw [hsum, map_add, map_smul]
        exact h0
      · funext o
        cases o <;> simp [w₀, mul_comm, E_none, E_some]
    · rintro _ (rfl | ⟨v, hv, rfl⟩)
      · exact hw₀
      · exact hext v hv
  have hT : ∀ w ∈ insert w₀ (E '' (K : Set (ι → R))), w ≠ w₀ →
      ∃ u ∈ K, E u = w := by
    rintro w (rfl | ⟨u, hu, rfl⟩) hne
    · exact absurd rfl hne
    · exact ⟨u, hu, rfl⟩
  refine le_antisymm ?_ (Ideal.span_le.2 ?_)
  · rw [hker, span_minorIdeal]
    refine Ideal.span_le.2 ?_
    rintro _ ⟨v, e, hv, rfl⟩
    by_cases hw : ∃ j₀, v j₀ = w₀
    · obtain ⟨j₀, hj₀⟩ := hw
      by_cases h2 : ∃ j₁, j₁ ≠ j₀ ∧ v j₁ = w₀
      · obtain ⟨j₁, hne, hj₁⟩ := h2
        rw [Matrix.det_zero_of_row_eq hne (by ext i; simp [hj₀, hj₁])]
        exact Ideal.zero_mem _
      · push Not at h2
        rw [Matrix.det_succ_row _ j₀]
        refine sum_mem fun i _ => Ideal.mul_mem_left _ _ ?_
        have hu : ∀ j, ∃ u ∈ K, E u = v (j₀.succAbove j) := fun j =>
          hT _ (hv _) (h2 _ (Fin.succAbove_ne j₀ j))
        choose u hu huv using hu
        have : (Matrix.of fun j i => v j (e i)).submatrix j₀.succAbove i.succAbove =
            Matrix.of fun j i' => E (u j) (e (i.succAbove i')) := by
          ext j i'
          simp [huv j]
        rw [this]
        exact det_extendByZero_mem_minorIdeal hu _
    · push Not at hw
      choose u hu huv using fun j => hT _ (hv j) (hw j)
      have : (Matrix.of fun j i => v j (e i)) =
          Matrix.of fun j i => E (u j) (e i) := by
        ext j i
        simp [huv j]
      rw [this]
      exact K.minorIdeal_succ_le r (det_extendByZero_mem_minorIdeal hu e)
  · rintro _ ⟨u, e, hu, rfl⟩
    rw [SetLike.mem_coe]
    let v : Fin (r + 1) → Option ι → R :=
      Fin.snoc (α := fun _ => Option ι → R) (fun j => E (u j)) w₀
    let e' : Fin (r + 1) → Option ι := Fin.snoc (α := fun _ => Option ι) (fun i => some (e i)) none
    have hv : ∀ j, v j ∈ LinearMap.ker h := by
      intro j
      refine Fin.lastCases (motive := fun j => v j ∈ LinearMap.ker h) ?_ (fun j => ?_) j
      · simpa [v] using hw₀
      · simpa [v] using hext _ (hu j)
    convert det_mem_minorIdeal hv e' using 1
    rw [Matrix.det_succ_column _ (Fin.last r), Fin.sum_univ_castSucc]
    simp only [v, e', Matrix.of_apply, Fin.snoc_castSucc, Fin.snoc_last,
      E_none, mul_zero, zero_mul, Finset.sum_const_zero, zero_add,
      Fin.succAbove_last, Fin.val_last]
    have hsign : ((-1 : R) ^ (r + r)) = 1 := by
      rw [← two_mul, pow_mul]
      simp
    simp only [hsign, w₀, Pi.sub_apply, Pi.single_eq_same, E_none, sub_zero,
      one_mul]
    congr 1
    ext j i
    simp [E_some]

end Submodule
