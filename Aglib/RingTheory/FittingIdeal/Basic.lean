module

public import Aglib.RingTheory.FittingIdeal.Minors
public import Mathlib.Algebra.BigOperators.Fin
public import Mathlib.Algebra.Group.Pointwise.Set.ListOfFn
public import Mathlib.Data.Fintype.Option
public import Mathlib.LinearAlgebra.Basis.Defs
public import Mathlib.LinearAlgebra.Finsupp.LinearCombination
public import Mathlib.RingTheory.Finiteness.Cardinality
public import Mathlib.SetTheory.Cardinal.NatCard

/-!
# Fitting ideals

Let `R` be a commutative ring and `M` a finitely generated `R`-module. For a presentation
`⊕_{j ∈ J} R → R^n → M → 0` with relation matrix `A`, the `k`-th Fitting ideal `Fitt_k(M)` is
the ideal generated by the `(n - k) × (n - k)` minors of `A`, with `Fitt_k(M) = R` for `k ≥ n`;
it does not depend on the presentation (Stacks Project, Tags 07Z8 and 07Z9).

`Module.fittingIdeal R M k` is defined from the presentation chosen by
`Module.Finite.exists_fin'` as the minor ideal (`Submodule.minorIdeal`) of its kernel, and is `⊥`
when `M` is not finitely generated. The presentation-free interface is

* `Module.fittingIdeal_eq_minorIdeal_ker`: for every surjection `f : (ι → R) →ₗ[R] M` with `ι`
  finite, `fittingIdeal R M k = (ker f).minorIdeal (Nat.card ι - k)` (Stacks, Tag 07Z8);
* `Module.fittingIdeal_eq_minorIdeal`: the same with the minors of a relation matrix `A` whose
  columns span `ker f`, for an arbitrary index type `J` of relations.

Basic properties (Stacks, Tags 07Z9, 07ZA and 07ZB):

* `Module.fittingIdeal_mono`: `Fitt_k(M) ⊆ Fitt_{k+1}(M)`;
* `Module.fittingIdeal_eq_top_of_span_eq_top`: `Fitt_k(M) = R` if `M` is generated by `k`
  elements (07ZA (1));
* `Module.fittingIdeal_le_of_surjective` and `Module.fittingIdeal_congr`: a surjection
  `M ↠ N` gives `Fitt_k(M) ⊆ Fitt_k(N)` (07ZA (5)); isomorphic modules have equal Fitting ideals;
* `Module.fittingIdeal_zero_le_annihilator`: `Fitt_0(M) ⊆ Ann(M)` (07ZA (6)), and
  `Module.annihilator_pow_le_fittingIdeal_zero`: `Ann(M)^n ⊆ Fitt_0(M)` for `n` generators;
* `Module.fittingIdeal_zero_quotient`: `Fitt_0(R/I) = I` (07ZA (8));
* `Module.fittingIdeal_pi` and `Module.fittingIdeal_of_basis`: `Fitt_k(R^n) = 0` for `k < n` and
  `= R` for `k ≥ n` (07ZB).

The independence proof adds generators one at a time
(`Submodule.minorIdeal_ker_succ`), by induction over the finite type of added generators.
-/

@[expose] public section

open Function
open scoped Matrix

variable {R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M] [AddCommGroup N]
  [Module R N]

namespace Submodule

variable {ι κ : Type*}

/-- Extension by zero from `ι → R` to `ι ⊕ κ → R`. -/
private def extInl : (ι → R) →ₗ[R] ι ⊕ κ → R where
  toFun x := Sum.elim x 0
  map_add' x y := by
    funext o
    cases o <;> simp
  map_smul' c x := by
    funext o
    cases o <;> simp

@[simp]
private theorem extInl_apply (x : ι → R) : (extInl x : ι ⊕ κ → R) = Sum.elim x 0 := rfl

/-- `Option (ι ⊕ α) ≃ ι ⊕ Option α`, sending `none` to `inr none`. -/
private def optionSumEquiv (ι α : Type*) : Option (ι ⊕ α) ≃ ι ⊕ Option α where
  toFun o := o.elim (Sum.inr none) (Sum.elim Sum.inl (Sum.inr ∘ some))
  invFun := Sum.elim (some ∘ Sum.inl) fun o => o.elim none (some ∘ Sum.inr)
  left_inv := by rintro (_ | _ | _) <;> rfl
  right_inv := by rintro (_ | _ | _) <;> rfl

/-- Adding finitely many generators to a presentation: if `F ∘ₗ extInl` is surjective, the minor
ideals of `ker F` of size `|ι ⊕ κ| - k` and of `ker (F ∘ₗ extInl)` of size `|ι| - k` agree. -/
private theorem minorIdeal_ker_sum [Finite ι] (κ : Type*) [Finite κ] (k : ℕ) :
    ∀ F : (ι ⊕ κ → R) →ₗ[R] M, Surjective (F ∘ₗ extInl) →
      (LinearMap.ker F).minorIdeal (Nat.card (ι ⊕ κ) - k) =
        (LinearMap.ker (F ∘ₗ extInl)).minorIdeal (Nat.card ι - k) := by
  refine Finite.induction_empty_option (P := fun κ => ∀ F : (ι ⊕ κ → R) →ₗ[R] M,
    Surjective (F ∘ₗ extInl) → (LinearMap.ker F).minorIdeal (Nat.card (ι ⊕ κ) - k) =
      (LinearMap.ker (F ∘ₗ extInl)).minorIdeal (Nat.card ι - k)) ?_ ?_ ?_ κ
  · intro α β e hα F hF
    set σ : ι ⊕ α ≃ ι ⊕ β := Equiv.sumCongr (Equiv.refl ι) e
    have hcomp : (F ∘ₗ LinearMap.funLeft R R σ.symm) ∘ₗ extInl = F ∘ₗ extInl := by
      refine LinearMap.ext fun x => congrArg F (funext fun o => ?_)
      rcases o with i | b <;> rfl
    have h1 := hα (F ∘ₗ LinearMap.funLeft R R σ.symm) (hcomp ▸ hF)
    rwa [hcomp, minorIdeal_ker_comp_funLeft, Nat.card_congr σ] at h1
  · intro F hF
    set σ : ι ≃ ι ⊕ PEmpty := (Equiv.sumEmpty ι PEmpty).symm
    have hcomp : F ∘ₗ extInl = F ∘ₗ LinearMap.funLeft R R σ.symm := by
      refine LinearMap.ext fun x => congrArg F (funext fun o => ?_)
      rcases o with i | e
      · rfl
      · exact e.elim
    rw [hcomp, minorIdeal_ker_comp_funLeft, Nat.card_congr σ]
  · intro α _ hα F hF
    set σ := optionSumEquiv ι α
    set H : (Option (ι ⊕ α) → R) →ₗ[R] M := F ∘ₗ LinearMap.funLeft R R σ.symm
    set G : (ι ⊕ α → R) →ₗ[R] M :=
      H ∘ₗ (LinearEquiv.piOptionEquivProd R).symm.toLinearMap ∘ₗ LinearMap.inr R R (ι ⊕ α → R)
    have hGF : G ∘ₗ extInl = F ∘ₗ extInl := by
      refine LinearMap.ext fun x => congrArg F (funext fun o => ?_)
      rcases o with i | _ | a <;> rfl
    have hG : Surjective G := by
      have : Surjective (G ∘ₗ extInl) := hGF ▸ hF
      exact Surjective.of_comp this
    have hcard : Nat.card (ι ⊕ Option α) = Nat.card (ι ⊕ α) + 1 := by
      rw [← Nat.card_congr σ, Finite.card_option]
    rw [← hGF, ← hα G (hGF ▸ hF), ← minorIdeal_ker_comp_funLeft F σ, hcard]
    by_cases hk : k ≤ Nat.card (ι ⊕ α)
    · rw [Nat.sub_add_comm hk]
      exact minorIdeal_ker_succ H hG _
    · rw [Nat.sub_eq_zero_of_le (by omega), Nat.sub_eq_zero_of_le (by omega), minorIdeal_zero,
        minorIdeal_zero]

/-- The minor ideals of the kernels of two presentations agree after the size shift by the number
of generators (Stacks Project, Tag 07Z8). -/
theorem minorIdeal_ker_eq_of_surjective [Finite ι] [Finite κ] {f : (ι → R) →ₗ[R] M}
    {g : (κ → R) →ₗ[R] M} (hf : Surjective f) (hg : Surjective g) (k : ℕ) :
    (LinearMap.ker f).minorIdeal (Nat.card ι - k) =
      (LinearMap.ker g).minorIdeal (Nat.card κ - k) := by
  set F : (ι ⊕ κ → R) →ₗ[R] M :=
    f ∘ₗ LinearMap.funLeft R R Sum.inl + g ∘ₗ LinearMap.funLeft R R Sum.inr
  set G : (κ ⊕ ι → R) →ₗ[R] M :=
    g ∘ₗ LinearMap.funLeft R R Sum.inl + f ∘ₗ LinearMap.funLeft R R Sum.inr
  have hF : F ∘ₗ extInl = f := LinearMap.ext fun x => by
    change f x + g 0 = f x
    simp
  have hG : G ∘ₗ extInl = g := LinearMap.ext fun x => by
    change g x + f 0 = g x
    simp
  have hFG : F = G ∘ₗ LinearMap.funLeft R R (Equiv.sumComm ι κ).symm := by
    refine LinearMap.ext fun w => ?_
    simp only [F, G, LinearMap.add_apply, LinearMap.comp_apply]
    rw [add_comm]
    rfl
  have h1 := minorIdeal_ker_sum κ k F (hF ▸ hf)
  have h2 := minorIdeal_ker_sum ι k G (hG ▸ hg)
  rw [hF] at h1
  rw [hG] at h2
  rw [← h1, ← h2, hFG, minorIdeal_ker_comp_funLeft, Nat.card_congr (Equiv.sumComm ι κ)]

end Submodule

namespace Module

open scoped Classical in
variable (R M) in
/-- The `k`-th Fitting ideal of an `R`-module `M` (Stacks Project, Tag 07Z9): for a finitely
generated `M`, the ideal generated by the `(n - k) × (n - k)` minors of a relation matrix of a
presentation of `M` by `n` generators, which is `R` for `k ≥ n`. It is computed here from the
presentation chosen by `Module.Finite.exists_fin'`; `Module.fittingIdeal_eq_minorIdeal_ker` shows
that every presentation gives the same ideal. If `M` is not finitely generated, the value is
`⊥`. -/
noncomputable def fittingIdeal (k : ℕ) : Ideal R :=
  if h : Module.Finite R M then
    haveI := h
    (LinearMap.ker (Module.Finite.exists_fin' R M).choose_spec.choose).minorIdeal
      ((Module.Finite.exists_fin' R M).choose - k)
  else ⊥

theorem fittingIdeal_of_not_finite (h : ¬Module.Finite R M) (k : ℕ) :
    fittingIdeal R M k = ⊥ :=
  dite_eq_right h

/-- Independence of the presentation (Stacks Project, Tag 07Z8): for every surjection
`f : (ι → R) →ₗ[R] M` from a finite free module, `Fitt_k(M)` is the ideal of the
`(|ι| - k)`-minors of the kernel of `f`. -/
theorem fittingIdeal_eq_minorIdeal_ker {ι : Type*} [Finite ι] {f : (ι → R) →ₗ[R] M}
    (hf : Surjective f) (k : ℕ) :
    fittingIdeal R M k = (LinearMap.ker f).minorIdeal (Nat.card ι - k) := by
  have hM : Module.Finite R M := Module.Finite.of_surjective f hf
  rw [fittingIdeal, dite_eq_left hM]
  have := Submodule.minorIdeal_ker_eq_of_surjective
    (Module.Finite.exists_fin' R M).choose_spec.choose_spec hf k
  rwa [Nat.card_fin] at this

/-- Independence of the presentation, matrix form (Stacks Project, Tags 07Z8 and 07Z9): if
`f : (ι → R) →ₗ[R] M` is surjective and the columns of `A : Matrix ι J R` span `ker f`, that is
`⊕_{j ∈ J} R → R^ι → M → 0` is a presentation with relation matrix `A`, then `Fitt_k(M)` is the
ideal of the `(|ι| - k)`-minors of `A`. -/
theorem fittingIdeal_eq_minorIdeal {ι J : Type*} [Finite ι] {f : (ι → R) →ₗ[R] M}
    (hf : Surjective f) {A : Matrix ι J R}
    (hA : Submodule.span R (Set.range Aᵀ) = LinearMap.ker f) (k : ℕ) :
    fittingIdeal R M k = A.minorIdeal (Nat.card ι - k) := by
  rw [fittingIdeal_eq_minorIdeal_ker hf, Matrix.minorIdeal_eq_minorIdeal_span, hA]

/-- The Fitting ideals increase: `Fitt_k(M) ⊆ Fitt_{k+1}(M)` (Stacks Project, Tag 07Z9). -/
theorem fittingIdeal_mono : Monotone (fittingIdeal R M) := by
  intro k l hkl
  by_cases hM : Module.Finite R M
  · obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' R M
    rw [fittingIdeal_eq_minorIdeal_ker hf, fittingIdeal_eq_minorIdeal_ker hf]
    exact Submodule.minorIdeal_antitone _ (by omega)
  · simp [fittingIdeal_of_not_finite hM]

theorem fittingIdeal_le_succ (k : ℕ) : fittingIdeal R M k ≤ fittingIdeal R M (k + 1) :=
  fittingIdeal_mono k.le_succ

/-- If `M` is generated by `k` elements, then `Fitt_k(M) = R` (Stacks Project, Tag 07ZA (1)). -/
theorem fittingIdeal_eq_top_of_span_eq_top {ι : Type*} [Finite ι] {v : ι → M}
    (hv : Submodule.span R (Set.range v) = ⊤) {k : ℕ} (hk : Nat.card ι ≤ k) :
    fittingIdeal R M k = ⊤ := by
  cases nonempty_fintype ι
  have hf : Surjective (Fintype.linearCombination R v) := by
    rw [← LinearMap.range_eq_top, Fintype.range_linearCombination, hv]
  rw [fittingIdeal_eq_minorIdeal_ker hf, Nat.sub_eq_zero_of_le hk, Submodule.minorIdeal_zero]

/-- A surjection `M ↠ N` gives `Fitt_k(M) ⊆ Fitt_k(N)` (Stacks Project, Tag 07ZA (5)). -/
theorem fittingIdeal_le_of_surjective {g : M →ₗ[R] N} (hg : Surjective g) (k : ℕ) :
    fittingIdeal R M k ≤ fittingIdeal R N k := by
  by_cases hM : Module.Finite R M
  · obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' R M
    rw [fittingIdeal_eq_minorIdeal_ker hf,
      fittingIdeal_eq_minorIdeal_ker (show Surjective (g ∘ₗ f) from hg.comp hf)]
    exact Submodule.minorIdeal_mono (LinearMap.ker_le_ker_comp f g) _
  · rw [fittingIdeal_of_not_finite hM]
    exact bot_le

/-- Isomorphic modules have the same Fitting ideals. -/
theorem fittingIdeal_congr (e : M ≃ₗ[R] N) (k : ℕ) : fittingIdeal R M k = fittingIdeal R N k :=
  le_antisymm (fittingIdeal_le_of_surjective e.surjective k)
    (fittingIdeal_le_of_surjective e.symm.surjective k)

/-- `Fitt_0(M) ⊆ Ann(M)` (Stacks Project, Tag 07ZA (6)). -/
theorem fittingIdeal_zero_le_annihilator : fittingIdeal R M 0 ≤ Module.annihilator R M := by
  by_cases hM : Module.Finite R M
  · obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' R M
    rw [fittingIdeal_eq_minorIdeal_ker hf, Nat.sub_zero, Nat.card_fin]
    refine Ideal.span_le.2 ?_
    rintro _ ⟨v, e, hv, rfl⟩
    rw [SetLike.mem_coe, Module.mem_annihilator]
    intro m
    obtain ⟨x, rfl⟩ := hf m
    by_cases he : Function.Injective e
    · rw [← map_smul]
      exact Submodule.det_smul_mem_of_surjective hv (Finite.injective_iff_surjective.1 he) x
    · obtain ⟨i, i', hii', hne⟩ := Function.not_injective_iff.1 he
      rw [Matrix.det_zero_of_column_eq hne fun j => by simp [hii'], zero_smul]
  · rw [fittingIdeal_of_not_finite hM]
    exact bot_le

/-- If `M` is generated by `n` elements, then `Ann(M)^n ⊆ Fitt_0(M)`: the products of `n`
annihilating scalars are diagonal minors of relations. -/
theorem annihilator_pow_le_fittingIdeal_zero {n : ℕ} {v : Fin n → M}
    (hv : Submodule.span R (Set.range v) = ⊤) :
    Module.annihilator R M ^ n ≤ fittingIdeal R M 0 := by
  classical
  have hf : Surjective (Fintype.linearCombination R v) := by
    rw [← LinearMap.range_eq_top, Fintype.range_linearCombination, hv]
  rw [fittingIdeal_eq_minorIdeal_ker hf, Nat.card_fin, Nat.sub_zero,
    Submodule.pow_eq_span_pow_set, Submodule.span_le]
  intro x hx
  obtain ⟨a, rfl⟩ := Set.mem_pow.1 hx
  rw [Fin.prod_ofFn, SetLike.mem_coe]
  have hw : ∀ j, ((a j : R) • Pi.single j 1 : Fin n → R) ∈
      LinearMap.ker (Fintype.linearCombination R v) := by
    intro j
    rw [LinearMap.mem_ker, map_smul, Fintype.linearCombination_apply_single, one_smul]
    exact Module.mem_annihilator.1 (a j).2 (v j)
  convert Submodule.det_mem_minorIdeal hw id using 1
  rw [← Matrix.det_diagonal]
  congr 1
  ext j i
  by_cases h : j = i
  · subst h
    simp
  · simp [Matrix.diagonal_apply_ne _ h, Pi.single_apply, Ne.symm h]

/-- `Fitt_0(R/I) = I` (Stacks Project, Tag 07ZA (8)). -/
theorem fittingIdeal_zero_quotient (I : Ideal R) : fittingIdeal R (R ⧸ I) 0 = I := by
  set f : (Unit → R) →ₗ[R] R ⧸ I := I.mkQ ∘ₗ LinearMap.proj ()
  have hf : Surjective f := fun y => by
    obtain ⟨x, rfl⟩ := I.mkQ_surjective y
    exact ⟨fun _ => x, rfl⟩
  have hker : ∀ x : Unit → R, x ∈ LinearMap.ker f ↔ x () ∈ I := fun x => by
    simp [f, Submodule.Quotient.mk_eq_zero]
  rw [fittingIdeal_eq_minorIdeal_ker hf, Nat.card_unique, Nat.sub_zero]
  refine le_antisymm (Ideal.span_le.2 ?_) fun x hx => ?_
  · rintro _ ⟨v, e, hv, rfl⟩
    rw [Matrix.det_fin_one]
    exact (hker _).1 (hv 0)
  · have := Submodule.det_mem_minorIdeal (N := LinearMap.ker f) (r := 1)
      (v := fun (_ : Fin 1) (_ : Unit) => x) (fun _ => (hker _).2 hx) fun _ => ()
    rwa [Matrix.det_fin_one] at this

/-- The Fitting ideals of a finite free module `ι → R`: `Fitt_k = R` for `k ≥ |ι|` and
`Fitt_k = 0` for `k < |ι|` (Stacks Project, Tag 07ZB). -/
theorem fittingIdeal_pi (ι : Type*) [Finite ι] (k : ℕ) :
    fittingIdeal R (ι → R) k = if Nat.card ι ≤ k then ⊤ else ⊥ := by
  rw [fittingIdeal_eq_minorIdeal_ker (f := LinearMap.id) surjective_id, LinearMap.ker_id]
  split_ifs with h
  · rw [Nat.sub_eq_zero_of_le h, Submodule.minorIdeal_zero]
  · obtain ⟨r, hr⟩ : ∃ r, Nat.card ι - k = r + 1 := ⟨Nat.card ι - k - 1, by omega⟩
    rw [hr, Submodule.minorIdeal_bot_succ]

/-- The Fitting ideals of a module with a finite basis indexed by `ι` (Stacks Project,
Tag 07ZB). -/
theorem fittingIdeal_of_basis {ι : Type*} [Finite ι] (b : Module.Basis ι R M) (k : ℕ) :
    fittingIdeal R M k = if Nat.card ι ≤ k then ⊤ else ⊥ := by
  cases nonempty_fintype ι
  rw [fittingIdeal_congr b.equivFun, fittingIdeal_pi]

end Module
