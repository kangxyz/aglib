/-!
# Generic freeness over a Noetherian domain

Let `A` be a Noetherian domain, `B` a finitely generated `A`-algebra and `M` a finite
`B`-module. Then there is `a ≠ 0` in `A` such that `M[1/a]` is a free `A[1/a]`-module
(Stacks Project, Tag 051R, Lemma 10.118.1; Nitsure, *Construction of Hilbert and Quot
schemes*, arXiv:math/0504590v1, Lemma 4.1, p. 18). Here `M[1/a]` is
`LocalizedModule.Away a M = LocalizedModule (Submonoid.powers a) M`, a module over
`Localization.Away a`, and the `A`-module structure of `M` is the given one, compatible with
`B` through `IsScalarTower A B M`.

## Main results

* `Module.Finite.exists_free_localizedModule_away_of_isNoetherianRing`: the case where `M`
  is already finite over `A` (from Mathlib's
  `Module.FinitePresentation.exists_free_localizedModule_powers` at the generic point).
* `Module.Finite.exists_ne_zero_free_localizedModule_away`: generic freeness.
* `Module.Finite.exists_ne_zero_flat_localizedModule_away`: the flat consequence.

## Proof

The sources argue by Noether normalization and induction on the dimension of the generic
fibre. The proof here avoids both. It inducts on the number of polynomial variables.
If `B` is generated by one element `x` over a Noetherian `A`-algebra `C` for which the
statement holds, and `M₀` is the `C`-span of a finite set of `B`-generators of `M`, then
`F 0 = ⊥`, `F (j + 1) = M₀ + x F j` is an exhaustive filtration of `M` by finite
`C`-modules. Multiplication by `x` maps each graded piece onto the next one, and by
Noetherianity these surjections are eventually bijective, so only finitely many graded pieces
need a denominator. Freeness of the localized graded pieces gives freeness of the localized
module (`Module.free_localizedModule_of_filtration_of_isScalarTower`).
-/

@[expose] public section

universe u v w

open Polynomial

namespace Module

section PowerFiltration

variable {C N : Type*} [CommRing C] [AddCommGroup N] [Module C N] (T : N →ₗ[C] N)
  (M₀ : Submodule C N)

/-- The filtration `F 0 = ⊥`, `F (j + 1) = M₀ ⊔ T (F j)`, so that
`F (j + 1) = M₀ + T M₀ + ⋯ + T^j M₀`. -/
private def powerFiltration : ℕ → Submodule C N
  | 0 => ⊥
  | j + 1 => M₀ ⊔ (powerFiltration j).map T

private theorem powerFiltration_succ (j : ℕ) :
    powerFiltration T M₀ (j + 1) = M₀ ⊔ (powerFiltration T M₀ j).map T :=
  rfl

private theorem powerFiltration_mono : Monotone (powerFiltration T M₀) := by
  refine monotone_nat_of_le_succ fun j => ?_
  induction j with
  | zero => exact bot_le
  | succ j ih =>
    rw [powerFiltration_succ, powerFiltration_succ T M₀ (j + 1)]
    exact sup_le_sup_left (Submodule.map_mono ih) _

private theorem map_powerFiltration_le (j : ℕ) :
    (powerFiltration T M₀ j).map T ≤ powerFiltration T M₀ (j + 1) :=
  le_sup_right

private theorem le_powerFiltration_succ (j : ℕ) : M₀ ≤ powerFiltration T M₀ (j + 1) :=
  le_sup_left

private theorem powerFiltration_fg (hM₀ : M₀.FG) (j : ℕ) : (powerFiltration T M₀ j).FG := by
  induction j with
  | zero => exact Submodule.fg_bot
  | succ j ih => exact hM₀.sup (ih.map T)

private theorem powerFiltration_succ_succ_le (j : ℕ) :
    powerFiltration T M₀ (j + 1 + 1) ≤
      powerFiltration T M₀ (j + 1) ⊔ (powerFiltration T M₀ (j + 1)).map T :=
  sup_le_sup_right (le_powerFiltration_succ T M₀ j) _

/-- The graded piece `F (j + 1) / F j` of the power filtration. -/
private abbrev powerGraded (j : ℕ) : Type _ :=
  ↥(powerFiltration T M₀ (j + 1)) ⧸
    (powerFiltration T M₀ j).comap (powerFiltration T M₀ (j + 1)).subtype

/-- The map `F (j + 1) / F j → F (j + 2) / F (j + 1)` induced by `T`. -/
private def gradedMap (j : ℕ) : powerGraded T M₀ j →ₗ[C] powerGraded T M₀ (j + 1) :=
  Submodule.mapQ _ _ (T.restrict fun n hn => map_powerFiltration_le T M₀ (j + 1) ⟨n, hn, rfl⟩)
    fun n hn => map_powerFiltration_le T M₀ j ⟨n, hn, rfl⟩

private theorem gradedMap_surjective (j : ℕ) : Function.Surjective (gradedMap T M₀ j) := by
  intro y
  obtain ⟨⟨z, hz⟩, rfl⟩ := Submodule.mkQ_surjective _ y
  obtain ⟨u, hu, v, hv, rfl⟩ := Submodule.mem_sup.mp (powerFiltration_succ_succ_le T M₀ j hz)
  obtain ⟨w, hw, rfl⟩ := hv
  refine ⟨Submodule.Quotient.mk ⟨w, hw⟩, ?_⟩
  rw [gradedMap, Submodule.mapQ_apply, Submodule.mkQ_apply, Submodule.Quotient.eq]
  change T w - (u + T w) ∈ powerFiltration T M₀ (j + 1)
  simpa using hu

/-- The composite `F 1 / F 0 → F (j + 1) / F j` of the graded maps. -/
private def gradedIter : (j : ℕ) → powerGraded T M₀ 0 →ₗ[C] powerGraded T M₀ j
  | 0 => LinearMap.id
  | j + 1 => gradedMap T M₀ j ∘ₗ gradedIter j

private theorem gradedIter_surjective (j : ℕ) : Function.Surjective (gradedIter T M₀ j) := by
  induction j with
  | zero => exact Function.surjective_id
  | succ j ih => exact (gradedMap_surjective T M₀ j).comp ih

/-- Over a Noetherian ring and for finitely generated `M₀`, the graded maps of the power
filtration are eventually bijective. -/
private theorem exists_bijective_gradedMap [IsNoetherianRing C] (hM₀ : M₀.FG) :
    ∃ j₀, ∀ j, j₀ ≤ j → Function.Bijective (gradedMap T M₀ j) := by
  have : Module.Finite C (powerFiltration T M₀ (0 + 1)) :=
    Module.Finite.iff_fg.mpr (powerFiltration_fg T M₀ hM₀ (0 + 1))
  have hmono : Monotone fun j => LinearMap.ker (gradedIter T M₀ j) :=
    monotone_nat_of_le_succ fun j => LinearMap.ker_le_ker_comp _ _
  obtain ⟨j₀, hj₀⟩ := monotone_stabilizes_iff_noetherian.mpr
    (inferInstance : IsNoetherian C (powerGraded T M₀ 0)) ⟨_, hmono⟩
  refine ⟨j₀, fun j hj => ⟨?_, gradedMap_surjective T M₀ j⟩⟩
  rw [← LinearMap.ker_eq_bot, eq_bot_iff]
  intro y hy
  obtain ⟨z, rfl⟩ := gradedIter_surjective T M₀ j y
  have hz : z ∈ LinearMap.ker (gradedIter T M₀ (j + 1)) := hy
  have h1 : LinearMap.ker (gradedIter T M₀ (j + 1)) = LinearMap.ker (gradedIter T M₀ j) :=
    (hj₀ (j + 1) (by omega)).symm.trans (hj₀ j hj)
  rw [h1] at hz
  exact (Submodule.mem_bot C).mpr hz

end PowerFiltration

section GenericFreeness

variable {A : Type u} [CommRing A]

/-- Generic freeness for a finite module over a Noetherian domain: `M[1/a]` is free for some
`a ≠ 0`. This is the generic point of the open free locus of the finitely presented module. -/
theorem Finite.exists_free_localizedModule_away_of_isNoetherianRing [IsDomain A]
    [IsNoetherianRing A] (M : Type w) [AddCommGroup M] [Module A M] [Module.Finite A M] :
    ∃ a : A, a ≠ 0 ∧ Module.Free (Localization.Away a) (LocalizedModule.Away a M) := by
  have : Module.FinitePresentation A M := Module.finitePresentation_of_finite A M
  obtain ⟨r, hr, hfree, -⟩ := Module.FinitePresentation.exists_free_localizedModule_powers
    (nonZeroDivisors A) (LocalizedModule.mkLinearMap (nonZeroDivisors A) M) (FractionRing A)
  exact ⟨r, nonZeroDivisors.ne_zero hr, hfree⟩

/-- The statement of generic freeness for finite `C`-modules in the universe `w`. -/
private def GenericallyFree (A : Type u) [CommRing A] (C : Type v) [CommRing C] [Algebra A C] :
    Prop :=
  ∀ (N : Type w) [AddCommGroup N] [Module C N] [Module A N] [IsScalarTower A C N]
    [Module.Finite C N],
    ∃ a : A, a ≠ 0 ∧ Module.Free (Localization.Away a) (LocalizedModule.Away a N)

private theorem genericallyFree_of_finite [IsDomain A] [IsNoetherianRing A] (C : Type v)
    [CommRing C] [Algebra A C] [Module.Finite A C] : GenericallyFree.{u, v, w} A C := by
  intro N _ _ _ _ _
  have : Module.Finite A N := Module.Finite.trans C N
  exact Finite.exists_free_localizedModule_away_of_isNoetherianRing N

private theorem genericallyFree_of_surjective {C : Type v} {B : Type*} [CommRing C] [Algebra A C]
    [CommRing B] [Algebra A B] (φ : C →ₐ[A] B) (hφ : Function.Surjective φ)
    (hC : GenericallyFree.{u, v, w} A C) : GenericallyFree.{u, _, w} A B := by
  intro N _ _ _ _ _
  let : Algebra C B := φ.toRingHom.toAlgebra
  let : Module C N := Module.compHom N φ.toRingHom
  have : IsScalarTower C B N := ⟨fun c b n => by
    change (φ c * b) • n = φ c • b • n
    rw [mul_smul]⟩
  have : IsScalarTower A C N := ⟨fun a c n => by
    change φ (a • c) • n = a • φ c • n
    rw [map_smul, smul_assoc]⟩
  have : Module.Finite C B := Module.Finite.of_surjective (Algebra.linearMap C B) hφ
  have : Module.Finite C N := Module.Finite.trans B N
  exact hC N

/-- The induction step: generic freeness passes from a Noetherian `A`-algebra `C` to a
`C`-algebra generated by one element. -/
private theorem genericallyFree_of_adjoin_singleton [IsDomain A] {C : Type v} [CommRing C]
    [IsNoetherianRing C] [Algebra A C] {B : Type*} [CommRing B] [Algebra C B] [Algebra A B]
    [IsScalarTower A C B] (x : B) (hx : Algebra.adjoin C {x} = ⊤)
    (hC : GenericallyFree.{u, v, w} A C) : GenericallyFree.{u, _, w} A B := by
  classical
  intro N _ _ _ _ _
  let : Module C N := Module.compHom N (algebraMap C B)
  have : IsScalarTower C B N := ⟨fun c b n => by
    change (c • b) • n = algebraMap C B c • b • n
    rw [Algebra.smul_def, mul_smul]⟩
  have : IsScalarTower A C N := ⟨fun a c n => by
    change algebraMap C B (a • c) • n = a • algebraMap C B c • n
    rw [Algebra.smul_def, map_mul, ← IsScalarTower.algebraMap_apply, mul_smul, algebraMap_smul]⟩
  obtain ⟨S, hS⟩ := Module.Finite.fg_top (R := B) (M := N)
  let T : N →ₗ[C] N := (LinearMap.lsmul B N x).restrictScalars C
  let M₀ : Submodule C N := Submodule.span C (S : Set N)
  have hM₀ : M₀.FG := ⟨S, rfl⟩
  have hdir : Directed (· ≤ ·) (powerFiltration T M₀) := (powerFiltration_mono T M₀).directed_le
  -- the union of the filtration is stable under `B`
  have hW : ∀ b : B, ∀ n ∈ ⨆ j, powerFiltration T M₀ j, b • n ∈ ⨆ j, powerFiltration T M₀ j := by
    intro b
    have hb : b ∈ Algebra.adjoin C {x} := hx ▸ Algebra.mem_top
    induction hb using Algebra.adjoin_induction with
    | mem y hy =>
      rw [Set.mem_singleton_iff.mp hy]
      intro n hn
      obtain ⟨j, hj⟩ := (Submodule.mem_iSup_of_directed _ hdir).mp hn
      exact (Submodule.mem_iSup_of_directed _ hdir).mpr
        ⟨j + 1, map_powerFiltration_le T M₀ j ⟨n, hj, rfl⟩⟩
    | algebraMap c =>
      intro n hn
      rw [algebraMap_smul]
      exact Submodule.smul_mem _ c hn
    | add b₁ b₂ _ _ h₁ h₂ =>
      intro n hn
      rw [add_smul]
      exact add_mem (h₁ n hn) (h₂ n hn)
    | mul b₁ b₂ _ _ h₁ h₂ =>
      intro n hn
      rw [mul_smul]
      exact h₁ _ (h₂ n hn)
  have htop : ⨆ j, powerFiltration T M₀ j = ⊤ := by
    rw [eq_top_iff]
    rintro n -
    have hn : n ∈ Submodule.span B (S : Set N) := hS ▸ Submodule.mem_top
    induction hn using Submodule.span_induction with
    | mem y hy =>
      exact (Submodule.mem_iSup_of_directed _ hdir).mpr
        ⟨0 + 1, le_powerFiltration_succ T M₀ 0 (Submodule.subset_span hy)⟩
    | zero => exact zero_mem _
    | add y z _ _ hy hz => exact add_mem hy hz
    | smul b y _ hy => exact hW b y hy
  have hfin : ∀ j, Module.Finite C (powerGraded T M₀ j) := fun j =>
    have : Module.Finite C (powerFiltration T M₀ (j + 1)) :=
      Module.Finite.iff_fg.mpr (powerFiltration_fg T M₀ hM₀ (j + 1))
    inferInstance
  choose a ha hfree using fun j => have := hfin j; hC (powerGraded T M₀ j)
  obtain ⟨j₀, hj₀⟩ := exists_bijective_gradedMap T M₀ hM₀
  refine ⟨∏ j ∈ Finset.range (j₀ + 1), a j, Finset.prod_ne_zero_iff.mpr fun j _ => ha j, ?_⟩
  have hle : ∀ j ≤ j₀, Module.Free (Localization.Away (∏ j ∈ Finset.range (j₀ + 1), a j))
      (LocalizedModule.Away (∏ j ∈ Finset.range (j₀ + 1), a j) (powerGraded T M₀ j)) :=
    fun j hj =>
      have := hfree j
      free_localizedModule_away_of_dvd
        (Finset.dvd_prod_of_mem a (Finset.mem_range.mpr (Nat.lt_succ_of_le hj)))
  have hge : ∀ j, j₀ ≤ j → Module.Free (Localization.Away (∏ j ∈ Finset.range (j₀ + 1), a j))
      (LocalizedModule.Away (∏ j ∈ Finset.range (j₀ + 1), a j) (powerGraded T M₀ j)) := by
    intro j hj
    induction j, hj using Nat.le_induction with
    | base => exact hle j₀ le_rfl
    | succ j hj ih =>
      have := ih
      exact free_localizedModule_of_linearEquiv _
        (LinearEquiv.ofBijective ((gradedMap T M₀ j).restrictScalars A) (hj₀ j hj))
  exact free_localizedModule_of_filtration_of_isScalarTower _ (powerFiltration T M₀)
    (powerFiltration_mono T M₀) rfl htop fun j =>
      if h : j ≤ j₀ then hle j h else hge j (by omega)

private theorem genericallyFree_mvPolynomial [IsDomain A] [IsNoetherianRing A] (n : ℕ) :
    GenericallyFree.{u, u, w} A (MvPolynomial (Fin n) A) := by
  induction n with
  | zero =>
    have : Module.Finite A (MvPolynomial (Fin 0) A) :=
      Module.Finite.equiv (MvPolynomial.isEmptyAlgEquiv A (Fin 0)).toLinearEquiv.symm
    exact genericallyFree_of_finite _
  | succ n ih =>
    have hpoly : GenericallyFree.{u, u, w} A (MvPolynomial (Fin n) A)[X] :=
      genericallyFree_of_adjoin_singleton X Polynomial.adjoin_X ih
    exact genericallyFree_of_surjective (MvPolynomial.finSuccEquiv A n).symm.toAlgHom
      (MvPolynomial.finSuccEquiv A n).symm.surjective hpoly

/-- **Generic freeness** (Stacks Project, Tag 051R, Lemma 10.118.1; Nitsure,
arXiv:math/0504590v1, Lemma 4.1, p. 18). Let `A` be a Noetherian domain, `B` a finitely
generated `A`-algebra and `M` a finite `B`-module. Then there is `a ≠ 0` in `A` such that
`M[1/a] = LocalizedModule (Submonoid.powers a) M` is a free `A[1/a]`-module. -/
theorem Finite.exists_ne_zero_free_localizedModule_away [IsDomain A] [IsNoetherianRing A]
    {B : Type v} [CommRing B] [Algebra A B] [Algebra.FiniteType A B] (M : Type w)
    [AddCommGroup M] [Module A M] [Module B M] [IsScalarTower A B M] [Module.Finite B M] :
    ∃ a : A, a ≠ 0 ∧ Module.Free (Localization.Away a) (LocalizedModule.Away a M) := by
  obtain ⟨n, φ, hφ⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp ‹_›
  exact genericallyFree_of_surjective φ hφ (genericallyFree_mvPolynomial n) M

/-- **Generic flatness** for modules: under the hypotheses of generic freeness, `M[1/a]` is a
flat `A[1/a]`-module for some `a ≠ 0`. -/
theorem Finite.exists_ne_zero_flat_localizedModule_away [IsDomain A] [IsNoetherianRing A]
    {B : Type v} [CommRing B] [Algebra A B] [Algebra.FiniteType A B] (M : Type w)
    [AddCommGroup M] [Module A M] [Module B M] [IsScalarTower A B M] [Module.Finite B M] :
    ∃ a : A, a ≠ 0 ∧ Module.Flat (Localization.Away a) (LocalizedModule.Away a M) := by
  obtain ⟨a, ha, hfree⟩ := Finite.exists_ne_zero_free_localizedModule_away (A := A) (B := B) M
  exact ⟨a, ha, inferInstance⟩

end GenericFreeness

end Module
