module

public import Mathlib.Data.ENat.SuccOrder
public import Mathlib.RingTheory.DiscreteValuationRing.TFAE
public import Mathlib.RingTheory.RegularLocalRing.Defs

/-!
# A normal local domain with two nonprincipal maximal-ideal generators

A commutative Noetherian normal local domain whose maximal ideal is
nonprincipal and has at most two generators is regular of dimension two.
The final wrapper retains the actual pair of original ring elements and
their literal maximal-ideal equality.

Normal local domains of dimension at most one are local Dedekind domains,
so have principal maximal ideal. Krull's height theorem gives the other
dimension bound, and the native generator criterion gives regularity.
No regularity or dimension assumption is an input.

The current consumer is the original target local ring in surface
contraction, after normality has been transported from its actual global
sections ring.
-/

@[expose] public section

namespace IsLocalRing

variable {R : Type*} [CommRing R] [IsLocalRing R] [IsDomain R]
  [IsNoetherianRing R] [IsIntegrallyClosed R]

/-- A nonprincipal maximal ideal of a normal Noetherian local domain
forces the original ring to have Krull dimension at least two. -/
theorem two_le_ringKrullDim_of_not_isPrincipal
    (hnp : ¬(maximalIdeal R).IsPrincipal) : 2 ≤ ringKrullDim R := by
  apply (ENat.WithBot.add_one_le_iff (n := 1)).mpr
  apply lt_of_not_ge
  intro hdim
  let : Ring.KrullDimLE 1 R := (Ring.krullDimLE_iff (n := 1)).mpr hdim
  let : IsDedekindDomain R :=
    { (inferInstance : IsIntegrallyClosed R) with
      maximalOfPrime := fun hp hprime => hprime.isMaximal_of_ne_bot hp }
  exact hnp (maximalIdeal_isPrincipal_of_isDedekindDomain R)

/-- At most two generators and nonprincipality give dimension exactly
two for a normal Noetherian local domain. -/
theorem ringKrullDim_eq_two_of_spanFinrank_le_two
    (hgen : (maximalIdeal R).spanFinrank ≤ 2)
    (hnp : ¬(maximalIdeal R).IsPrincipal) : ringKrullDim R = 2 := by
  apply le_antisymm
  · exact (ringKrullDim_le_spanFinrank_maximalIdeal R).trans (by exact_mod_cast hgen)
  · exact two_le_ringKrullDim_of_not_isPrincipal hnp

end IsLocalRing

namespace IsRegularLocalRing

variable {R : Type*} [CommRing R] [IsLocalRing R] [IsDomain R]
  [IsNoetherianRing R] [IsIntegrallyClosed R]

/-- A normal Noetherian local domain with nonprincipal maximal ideal
generated by at most two elements is a regular local ring. -/
theorem of_spanFinrank_le_two_of_not_isPrincipal
    (hgen : (IsLocalRing.maximalIdeal R).spanFinrank ≤ 2)
    (hnp : ¬(IsLocalRing.maximalIdeal R).IsPrincipal) : IsRegularLocalRing R := by
  apply of_spanFinrank_maximalIdeal_le R
  rw [IsLocalRing.ringKrullDim_eq_two_of_spanFinrank_le_two hgen hnp]
  exact_mod_cast hgen

end IsRegularLocalRing

namespace IsLocalRing

variable {R : Type*} [CommRing R] [IsLocalRing R] [IsDomain R]
  [IsNoetherianRing R] [IsIntegrallyClosed R]

/-- The actual original pair generating a nonprincipal maximal ideal
makes the normal Noetherian local domain regular of dimension two. -/
theorem regularLocal_dimension_two_of_span_pair (u v : R)
    (hgen : maximalIdeal R = Ideal.span ({u, v} : Set R))
    (hnp : ¬(maximalIdeal R).IsPrincipal) :
    ringKrullDim R = 2 ∧ IsRegularLocalRing R := by
  have hbound : (maximalIdeal R).spanFinrank ≤ 2 := by
    rw [hgen]
    apply (Submodule.spanFinrank_span_le_ncard_of_finite
      ((Set.finite_singleton v).insert u)).trans
    simpa only [Set.ncard_singleton] using Set.ncard_insert_le u ({v} : Set R)
  exact ⟨ringKrullDim_eq_two_of_spanFinrank_le_two hbound hnp,
    IsRegularLocalRing.of_spanFinrank_le_two_of_not_isPrincipal hbound hnp⟩

end IsLocalRing
