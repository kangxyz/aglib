module

public import Mathlib.RingTheory.Adjoin.Polynomial.Basic
public import Mathlib.RingTheory.Algebraic.Defs
public import Mathlib.RingTheory.KrullDimension.Polynomial

/-!
# Dimension of an algebra generated by one algebraic element

A nonzero annihilating polynomial belongs to the kernel of the original
surjective evaluation map. It is a nonzerodivisor because the coefficient
ring is a domain. The polynomial dimension formula and dimension drop
under a nonzerodivisor quotient give the bound on the generated algebra.
-/

@[expose] public section

/-- An algebra generated by one algebraic element over a Noetherian domain
has dimension at most the dimension of that domain. The target need not
be a domain, and neither dimension is assumed finite. -/
theorem IsAlgebraic.ringKrullDim_le_of_adjoin_singleton_eq_top
    {R S : Type*} [CommRing R] [IsDomain R] [IsNoetherianRing R]
    [CommRing S] [Algebra R S] {b : S} (hb : IsAlgebraic R b)
    (hgen : Algebra.adjoin R {b} = ⊤) : ringKrullDim S ≤ ringKrullDim R := by
  have hsurj : Function.Surjective (Polynomial.aeval b : Polynomial R →ₐ[R] S) := by
    intro s
    exact Algebra.adjoin_mem_exists_aeval (R := R) (x := b) (by rw [hgen]; trivial)
  obtain ⟨p, hp, hpzero⟩ := hb
  have hdim := ringKrullDim_succ_le_of_surjective
    (Polynomial.aeval (R := R) b).toRingHom hsurj (r := p)
    (mem_nonZeroDivisors_iff_ne_zero.mpr hp) hpzero
  rw [Polynomial.ringKrullDim_of_isNoetherianRing] at hdim
  have hone : (1 : WithBot ℕ∞) ≠ ⊤ := by
    change ((1 : ℕ∞) : WithBot ℕ∞) ≠ ((⊤ : ℕ∞) : WithBot ℕ∞)
    exact fun h => ENat.one_ne_top (WithBot.coe_injective h)
  exact (WithBot.add_le_add_iff_right' (α := ℕ) (c := 1) (by simp) hone).mp hdim
