module

public import Mathlib.Algebra.Colimit.Ring
public import Mathlib.Algebra.GroupWithZero.Action.Regular
public import Mathlib.RingTheory.LocalRing.ResidueField.Basic

/-!
# Principal residue kernels in actual directed limits

For a directed system of local rings with compatible points in a field,
the actual ring direct limit is local. A common natural coefficient that
generates all residue kernels also generates the limit residue kernel.
Regularity of that coefficient passes to the limit by equality at a later
stage, without injectivity or flatness assumptions on transition maps.
-/

@[expose] public noncomputable section

open IsLocalRing
open scoped nonZeroDivisors

namespace Ring.DirectLimit

variable {ι : Type*} [Preorder ι] [Nonempty ι] [IsDirectedOrder ι]
  (G : ι → Type*) [∀ i, CommRing (G i)]
  (f : ∀ i j, i ≤ j → G i →+* G j)

local notation "D" => Ring.DirectLimit G (fun i j h ↦ f i j h)

/-- Regularity of the same natural coefficient passes to the actual
direct limit by equality at a sufficiently late stage. -/
theorem isSMulRegular_natCast [DirectedSystem G (fun i j h ↦ f i j h)]
    (p : ℕ) (hp : ∀ i, IsSMulRegular (G i) (p : G i)) :
    IsSMulRegular D (p : D) := by
  apply IsSMulRegular.of_right_eq_zero_of_smul
  intro u hu
  obtain ⟨i, x, rfl⟩ := Ring.DirectLimit.exists_of u
  have hzero : Ring.DirectLimit.of G (fun i j h ↦ f i j h) i ((p : G i) * x) = 0 := by
    simpa only [map_mul, map_natCast, smul_eq_mul] using hu
  obtain ⟨j, hij, hlate⟩ := Ring.DirectLimit.of.zero_exact (f' := f) hzero
  have hx : f i j hij x = 0 := (hp j).right_eq_zero_of_smul
    (by simpa only [map_mul, map_natCast, smul_eq_mul] using hlate)
  rw [← Ring.DirectLimit.of_f (f := fun i j h ↦ f i j h) hij x, hx, map_zero]

variable (K : Type*) [Field K] (g : ∀ i, G i →+* K)
  (hg : ∀ i j h x, g j (f i j h x) = g i x)

local notation "ρ" => Ring.DirectLimit.lift G (fun i j h ↦ f i j h) K g hg

include K g hg in
/-- Locality of the actual direct limit follows from representatives and
their unit-or-one-minus-unit dichotomy. The compatible field point supplies
nontriviality. -/
theorem isLocalRing_of_fieldPoint [∀ i, IsLocalRing (G i)] : IsLocalRing D := by
  let : Nontrivial D := RingHom.domain_nontrivial ρ
  apply IsLocalRing.of_isUnit_or_isUnit_one_sub_self
  intro u
  obtain ⟨i, x, rfl⟩ := Ring.DirectLimit.exists_of u
  rcases IsLocalRing.isUnit_or_isUnit_one_sub_self x with hx | hx
  · exact Or.inl (hx.map (Ring.DirectLimit.of G (fun i j h ↦ f i j h) i))
  · exact Or.inr (by
      simpa only [map_sub, map_one] using
        hx.map (Ring.DirectLimit.of G (fun i j h ↦ f i j h) i))

omit [Nonempty ι] [IsDirectedOrder ι] in
/-- Joint surjectivity of the original residue points gives surjectivity
of the actual induced point on the direct limit. -/
theorem fieldPoint_surjective (hsurj : ∀ a : K, ∃ i x, g i x = a) :
    Function.Surjective ρ := by
  intro a
  obtain ⟨i, x, hx⟩ := hsurj a
  refine ⟨Ring.DirectLimit.of G (fun i j h ↦ f i j h) i x, ?_⟩
  rw [Ring.DirectLimit.lift_of]
  exact hx

/-- The literal kernel at the limit is generated by the same natural
coefficient. Witnesses are mapped from an actual component. -/
theorem ker_fieldPoint_eq_span_natCast (p : ℕ)
    (hker : ∀ i, RingHom.ker (g i) = Ideal.span {(p : G i)}) :
    RingHom.ker ρ = Ideal.span {(p : D)} := by
  have hρp : ρ (p : D) = 0 := by
    let i : ι := Classical.choice inferInstance
    have hi : (p : G i) ∈ RingHom.ker (g i) := by
      rw [hker i]
      exact Ideal.mem_span_singleton_self _
    change g i (p : G i) = 0 at hi
    simpa only [map_natCast] using hi
  ext u
  constructor
  · intro hu
    obtain ⟨i, x, rfl⟩ := Ring.DirectLimit.exists_of u
    have hx : x ∈ RingHom.ker (g i) := by
      change g i x = 0
      change ρ (Ring.DirectLimit.of G (fun i j h ↦ f i j h) i x) = 0 at hu
      simpa only [Ring.DirectLimit.lift_of] using hu
    rw [hker i, Ideal.mem_span_singleton] at hx
    obtain ⟨y, hy⟩ := hx
    apply Ideal.mem_span_singleton.mpr
    refine ⟨Ring.DirectLimit.of G (fun i j h ↦ f i j h) i y, ?_⟩
    simpa only [map_mul, map_natCast] using
      congrArg (Ring.DirectLimit.of G (fun i j h ↦ f i j h) i) hy
  · intro hu
    exact ((Ideal.span_singleton_le_iff_mem (RingHom.ker ρ)).mpr hρp) hu

include hg in
/-- The actual maximal ideal at the limit is generated by the same
coefficient, using the actual surjective residue point. -/
theorem maximalIdeal_eq_span_natCast [∀ i, IsLocalRing (G i)] (p : ℕ)
    (hker : ∀ i, RingHom.ker (g i) = Ideal.span {(p : G i)})
    (hsurj : ∀ a : K, ∃ i x, g i x = a) :
    let _ : IsLocalRing D := isLocalRing_of_fieldPoint G f K g hg
    maximalIdeal D = Ideal.span {(p : D)} := by
  let : IsLocalRing D := isLocalRing_of_fieldPoint G f K g hg
  exact (IsLocalRing.ker_eq_maximalIdeal ρ (fieldPoint_surjective G f K g hg hsurj)).symm.trans
    (ker_fieldPoint_eq_span_natCast G f K g hg p hker)

/-- The residue marking at the direct limit is the original induced field
point, factored by its actual maximal ideal. -/
def residueEquivOfFieldPoint [∀ i, IsLocalRing (G i)]
    (hsurj : ∀ a : K, ∃ i x, g i x = a) :
    let _ : IsLocalRing D := isLocalRing_of_fieldPoint G f K g hg
    ResidueField D ≃+* K := by
  let : IsLocalRing D := isLocalRing_of_fieldPoint G f K g hg
  have hsurj' := fieldPoint_surjective G f K g hg hsurj
  exact (Ideal.quotEquivOfEq (IsLocalRing.ker_eq_maximalIdeal ρ hsurj').symm).trans
    (RingHom.quotientKerEquivOfSurjective hsurj')

@[simp]
theorem residueEquivOfFieldPoint_residue_of [∀ i, IsLocalRing (G i)]
    (hsurj : ∀ a : K, ∃ i x, g i x = a) (i : ι) (x : G i) :
    let _ : IsLocalRing D := isLocalRing_of_fieldPoint G f K g hg
    residueEquivOfFieldPoint G f K g hg hsurj
      (residue D (Ring.DirectLimit.of G (fun i j h ↦ f i j h) i x)) = g i x := by
  let : IsLocalRing D := isLocalRing_of_fieldPoint G f K g hg
  exact Ring.DirectLimit.lift_of K g hg i x

end Ring.DirectLimit
