module

public import Aglib.RingTheory.AdicCompletion.PrincipalDiscreteValuationRing
public import Mathlib.RingTheory.LocalRing.LocalSubring
public import Mathlib.RingTheory.LocalRing.ResidueField.Basic

/-!
# Directed unions of local subrings along the original inclusions

An increasing sequence in the native domination order has its actual union
inside the same field. The original stage inclusions are local. A fixed marker
which principalizes each preceding maximal ideal generates the union's maximal
ideal. Original residue maps and the literal principal completion are retained.
The union is not assumed Noetherian or separated.
-/

@[expose] public noncomputable section

open IsLocalRing
open scoped nonZeroDivisors

universe u

namespace LocalSubring

variable {K : Type u} [Field K]

private theorem directed_toSubring (S : ℕ → LocalSubring K) (hS : Monotone S) :
    Directed (· ≤ ·) (fun n => (S n).toSubring) := by
  intro n m
  exact ⟨max n m, (hS (Nat.le_max_left n m)).1, (hS (Nat.le_max_right n m)).1⟩

/-- The literal increasing union, with locality proved from the original stages. -/
def directedUnion (S : ℕ → LocalSubring K) (hS : Monotone S) : LocalSubring K where
  toSubring := ⨆ n, (S n).toSubring
  isLocalRing := by
    apply IsLocalRing.of_isUnit_or_isUnit_one_sub_self
    intro x
    obtain ⟨n, hn⟩ := (Subring.mem_iSup_of_directed (directed_toSubring S hS)).mp x.2
    let a : (S n).toSubring := ⟨x.1, hn⟩
    let f : (S n).toSubring →+* (⨆ n, (S n).toSubring : Subring K) :=
      Subring.inclusion (le_iSup (fun n => (S n).toSubring) n)
    have hfa : f a = x := Subtype.ext rfl
    obtain hu | hu := IsLocalRing.isUnit_or_isUnit_one_sub_self a
    · exact Or.inl (hfa ▸ hu.map f)
    · exact Or.inr (by simpa only [map_sub, map_one, hfa] using hu.map f)

namespace DirectedUnion

variable (S : ℕ → LocalSubring K) (hS : Monotone S)

/-- The carrier is the actual subring union in the original field. -/
abbrev Ring : Type u := (directedUnion S hS).toSubring

/-- The original inclusion of two stages in the domination chain. -/
def stageInclusion (n m : ℕ) (hnm : n ≤ m) : (S n).toSubring →+* (S m).toSubring :=
  Subring.inclusion (hS hnm).1

instance stageInclusion_isLocal (n m : ℕ) (hnm : n ≤ m) :
    IsLocalHom (stageInclusion S hS n m hnm) := (hS hnm).2

/-- The original inclusion of a stage into the literal union. -/
def inclusion (n : ℕ) : (S n).toSubring →+* Ring S hS :=
  Subring.inclusion (le_iSup (fun n => (S n).toSubring) n)

theorem inclusion_coe (n : ℕ) (a : (S n).toSubring) :
    (inclusion S hS n a : K) = a := rfl

theorem inclusion_comp_stageInclusion (n m : ℕ) (hnm : n ≤ m) :
    (inclusion S hS m).comp (stageInclusion S hS n m hnm) = inclusion S hS n := rfl

/-- Every actual union element belongs to one original stage. -/
theorem exists_stage (x : Ring S hS) :
    ∃ n : ℕ, ∃ a : (S n).toSubring, inclusion S hS n a = x := by
  obtain ⟨n, hn⟩ := (Subring.mem_iSup_of_directed (directed_toSubring S hS)).mp x.2
  exact ⟨n, ⟨x.1, hn⟩, Subtype.ext rfl⟩

/-- A stage nonunit cannot become invertible later in the actual union. -/
instance inclusion_isLocal (n : ℕ) : IsLocalHom (inclusion S hS n) := by
  constructor
  intro a ha
  obtain ⟨u, hu⟩ := ha
  obtain ⟨m, b, hb⟩ := exists_stage S hS ((u⁻¹ : (Ring S hS)ˣ) : Ring S hS)
  let N := max n m
  let an : (S N).toSubring := stageInclusion S hS n N (Nat.le_max_left n m) a
  let bm : (S N).toSubring := stageInclusion S hS m N (Nat.le_max_right n m) b
  have hab : inclusion S hS n a * inclusion S hS m b = 1 := by
    rw [hb, ← hu]
    simp
  have habN : an * bm = 1 := by
    apply Subtype.ext
    exact congrArg (fun x : Ring S hS => (x : K)) hab
  have han : IsUnit an := isUnit_of_dvd_one ⟨bm, habN.symm⟩
  exact (isUnit_map_iff (stageInclusion S hS n N (Nat.le_max_left n m)) a).mp han

/-- The same marker at an original stage, through the original inclusion. -/
def stageMarker (p : (S 0).toSubring) (n : ℕ) : (S n).toSubring :=
  stageInclusion S hS 0 n (Nat.zero_le n) p

/-- The original marker viewed in the literal union. -/
def marker (p : (S 0).toSubring) : Ring S hS := inclusion S hS 0 p

theorem inclusion_stageMarker (p : (S 0).toSubring) (n : ℕ) :
    inclusion S hS n (stageMarker S hS p n) = marker S hS p := rfl

/-- The actual exceptional-ideal equations force the union maximal ideal
to be generated by the same original marker. -/
theorem maximalIdeal_eq_span (p : (S 0).toSubring)
    (hp : p ∈ maximalIdeal (S 0).toSubring)
    (hstep : ∀ n, (maximalIdeal (S n).toSubring).map
      (stageInclusion S hS n (n + 1) (Nat.le_succ n)) =
        Ideal.span {stageMarker S hS p (n + 1)}) :
    maximalIdeal (Ring S hS) = Ideal.span {marker S hS p} := by
  apply le_antisymm
  · intro x hx
    obtain ⟨n, a, ha⟩ := exists_stage S hS x
    have ham : a ∈ maximalIdeal (S n).toSubring := by
      intro hau
      apply hx
      rw [← ha]
      exact hau.map (inclusion S hS n)
    have hnext := Ideal.mem_map_of_mem
      (stageInclusion S hS n (n + 1) (Nat.le_succ n)) ham
    rw [hstep n, Ideal.mem_span_singleton] at hnext
    obtain ⟨b, hb⟩ := hnext
    rw [Ideal.mem_span_singleton]
    refine ⟨inclusion S hS (n + 1) b, ?_⟩
    apply Subtype.ext
    have hax : (a : K) = (x : K) :=
      congrArg (fun z : Ring S hS => (z : K)) ha
    exact hax.symm.trans
      (congrArg (fun z : (S (n + 1)).toSubring => (z : K)) hb)
  · apply Ideal.span_le.mpr
    rintro x (rfl : x = marker S hS p)
    exact map_nonunit (inclusion S hS 0) p hp

/-- The marker is a nonzerodivisor in the same field subring, not merely
a nonzero element of an assumed completed domain. -/
theorem marker_mem_nonZeroDivisors (p : (S 0).toSubring) (hp : p ≠ 0) :
    marker S hS p ∈ (Ring S hS)⁰ := by
  rw [mem_nonZeroDivisors_iff_ne_zero]
  intro h
  apply hp
  apply (Subring.inclusion_injective
    (le_iSup (fun n => (S n).toSubring) 0))
  exact h.trans (inclusion S hS 0).map_zero.symm

/-- The residue comparison is induced by the original initial-stage inclusion. -/
theorem residueMap_bijective
    (hres : ∀ n, Function.Surjective
      (ResidueField.map (stageInclusion S hS 0 n (Nat.zero_le n)))) :
    Function.Bijective (ResidueField.map (inclusion S hS 0)) := by
  refine ⟨RingHom.injective _, ?_⟩
  intro z
  obtain ⟨x, rfl⟩ := residue_surjective (R := Ring S hS) z
  obtain ⟨n, a, ha⟩ := exists_stage S hS x
  obtain ⟨w, hw⟩ := hres n (residue (S n).toSubring a)
  refine ⟨w, ?_⟩
  calc
    ResidueField.map (inclusion S hS 0) w =
        ResidueField.map (inclusion S hS n)
          (ResidueField.map (stageInclusion S hS 0 n (Nat.zero_le n)) w) :=
      (ResidueField.map_map (stageInclusion S hS 0 n (Nat.zero_le n))
        (inclusion S hS n) w).symm
    _ = ResidueField.map (inclusion S hS n) (residue (S n).toSubring a) :=
      congrArg (ResidueField.map (inclusion S hS n)) hw
    _ = residue (Ring S hS) (inclusion S hS n a) := ResidueField.map_residue _ _
    _ = residue (Ring S hS) x := congrArg (residue (Ring S hS)) ha

/-- The completion is the literal principal completion in the published
DVR provider, with no new generic completion construction. -/
abbrev Completion (p : (S 0).toSubring) : Type u :=
  AdicCompletion (Ideal.span {marker S hS p}) (Ring S hS)

/-- Each original stage map into that one actual principal completion. -/
def stageMap (p : (S 0).toSubring) (n : ℕ) : (S n).toSubring →+* Completion S hS p :=
  (algebraMap (Ring S hS) (Completion S hS p)).comp (inclusion S hS n)

theorem stageMap_comp (p : (S 0).toSubring) (n m : ℕ) (hnm : n ≤ m) :
    (stageMap S hS p m).comp (stageInclusion S hS n m hnm) = stageMap S hS p n := rfl

theorem stageMap_marker (p : (S 0).toSubring) (n : ℕ) :
    stageMap S hS p n (stageMarker S hS p n) = stageMap S hS p 0 p := rfl

section PrincipalCompletion

variable (p : (S 0).toSubring) (hp : p ∈ maximalIdeal (S 0).toSubring)
  (hstep : ∀ n, (maximalIdeal (S n).toSubring).map
    (stageInclusion S hS n (n + 1) (Nat.le_succ n)) =
      Ideal.span {stageMarker S hS p (n + 1)})

include hp hstep

/-- The local structure comes from the proved actual union maximal ideal. -/
theorem completion_isLocalRing : IsLocalRing (Completion S hS p) :=
  AdicCompletion.isLocalRing_span_singleton (Ring S hS) (marker S hS p)
    (maximalIdeal_eq_span S hS p hp hstep)

/-- The original principal completion is complete for its actual maximal ideal. -/
theorem completion_isAdicComplete :
    let _ : IsLocalRing (Completion S hS p) := completion_isLocalRing S hS p hp hstep
    IsAdicComplete (maximalIdeal (Completion S hS p)) (Completion S hS p) :=
  AdicCompletion.isAdicComplete_maximalIdeal_span_singleton (Ring S hS) (marker S hS p)
    (maximalIdeal_eq_span S hS p hp hstep)

/-- Domainness is derived from the actual union marker's nonzerodivisor property. -/
theorem completion_isDomain (hp0 : p ≠ 0) : IsDomain (Completion S hS p) :=
  AdicCompletion.isDomain_span_singleton (Ring S hS) (marker S hS p)
    (maximalIdeal_eq_span S hS p hp hstep) (marker_mem_nonZeroDivisors S hS p hp0)

/-- The published native theorem supplies the actual completion DVR, with
its derived domain structure bound explicitly. -/
theorem completion_isDiscreteValuationRing (hp0 : p ≠ 0) :
    let _ : IsDomain (Completion S hS p) := completion_isDomain S hS p hp hstep hp0
    IsDiscreteValuationRing (Completion S hS p) :=
  AdicCompletion.isDiscreteValuationRing_span_singleton (Ring S hS) (marker S hS p)
    (maximalIdeal_eq_span S hS p hp hstep) (marker_mem_nonZeroDivisors S hS p hp0)

/-- The same original marker maps to a uniformizer of the actual completion. -/
theorem completion_marker_irreducible (hp0 : p ≠ 0) :
    Irreducible (stageMap S hS p 0 p) :=
  AdicCompletion.irreducible_algebraMap_span_singleton (Ring S hS) (marker S hS p)
    (maximalIdeal_eq_span S hS p hp hstep) (marker_mem_nonZeroDivisors S hS p hp0)

/-- Each constructed map from an original stage to the same completion is local. -/
theorem stageMap_isLocal (n : ℕ) : IsLocalHom (stageMap S hS p n) := by
  let : IsLocalRing (Completion S hS p) := completion_isLocalRing S hS p hp hstep
  let : IsLocalHom (algebraMap (Ring S hS) (Completion S hS p)) :=
    AdicCompletion.algebraMap_isLocalHom_span_singleton (Ring S hS) (marker S hS p)
      (maximalIdeal_eq_span S hS p hp hstep)
  exact RingHom.isLocalHom_comp _ _

/-- The completed residue comparison is the actual initial-stage map,
composed with the same native completion coefficient map. -/
theorem stageMap_residue_bijective
    (hres : ∀ n, Function.Surjective
      (ResidueField.map (stageInclusion S hS 0 n (Nat.zero_le n)))) :
    let _ : IsLocalRing (Completion S hS p) := completion_isLocalRing S hS p hp hstep
    let _ : IsLocalHom (stageMap S hS p 0) := stageMap_isLocal S hS p hp hstep 0
    Function.Bijective (ResidueField.map (stageMap S hS p 0)) := by
  let : IsLocalRing (Completion S hS p) := completion_isLocalRing S hS p hp hstep
  let : IsLocalHom (algebraMap (Ring S hS) (Completion S hS p)) :=
    AdicCompletion.algebraMap_isLocalHom_span_singleton (Ring S hS) (marker S hS p)
      (maximalIdeal_eq_span S hS p hp hstep)
  have hc := AdicCompletion.residueFieldMap_span_singleton_bijective
    (Ring S hS) (marker S hS p) (maximalIdeal_eq_span S hS p hp hstep)
  have hi := residueMap_bijective S hS hres
  change Function.Bijective
    (ResidueField.map ((algebraMap (Ring S hS) (Completion S hS p)).comp (inclusion S hS 0)))
  rw [ResidueField.map_comp]
  exact hc.comp hi

end PrincipalCompletion
end DirectedUnion
end LocalSubring
