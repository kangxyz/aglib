module

public import Mathlib.RingTheory.LocalRing.Module
public import Mathlib.RingTheory.LocalRing.ResidueField.Basic

/-!
# Surjectivity of a finite local algebra map from its closed fibre

The actual maximal-ideal image equality and surjectivity on actual residue
fields make the original algebra map surjective by native Nakayama. Neither
flatness nor formal unramifiedness is needed.
-/

@[expose] public section

universe u v

namespace IsLocalRing

/-- A finite local algebra with unchanged maximal ideal and surjective residue
map is generated by its original coefficient image. -/
theorem surjective_algebraMap_of_map_maximalIdeal_of_residue
    (R : Type u) (S : Type v) [CommRing R] [CommRing S] [Algebra R S]
    [IsLocalRing R] [IsLocalRing S] [IsLocalHom (algebraMap R S)]
    [Module.Finite R S]
    (hm : (maximalIdeal R).map (algebraMap R S) = maximalIdeal S)
    (hκ : Function.Surjective (algebraMap (ResidueField R) (ResidueField S))) :
    Function.Surjective (algebraMap R S) := by
  change Function.Surjective (Algebra.linearMap R S)
  rw [← LinearMap.range_eq_top, ← top_le_iff]
  apply Submodule.le_of_le_smul_of_le_jacobson_bot Module.Finite.fg_top
    (maximalIdeal_le_jacobson _)
  rw [Ideal.smul_top_eq_map, hm]
  rintro x -
  obtain ⟨a, ha⟩ := hκ (residue S x)
  obtain ⟨a, rfl⟩ := residue_surjective a
  rw [ResidueField.algebraMap_residue, ← sub_eq_zero, ← map_sub, residue_eq_zero_iff] at ha
  rw [← sub_sub_self (algebraMap R S a) x]
  exact sub_mem (Submodule.mem_sup_left ⟨a, rfl⟩) (Submodule.mem_sup_right ha)

end IsLocalRing
