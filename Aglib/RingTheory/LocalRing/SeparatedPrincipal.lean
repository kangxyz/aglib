@[expose] public section

noncomputable section
set_option autoImplicit false
open IsLocalRing
namespace IsLocalRing
universe u
section PrincipalSeparated
variable {S : Type u} [CommRing S] [IsLocalRing S]
  (π : S) (hm : maximalIdeal S = Ideal.span {π})

include hm

/-- A finite upper bound on the maximal-ideal order gives the usual unit-power
factorization, even before a domain structure has been proved. -/
theorem exists_eq_unit_mul_pow_of_not_mem_maximalIdeal_pow {n : ℕ} {x : S}
    (hx : x ∉ maximalIdeal S ^ n) :
    ∃ k : ℕ, ∃ v : Sˣ, x = v * π ^ k := by
  induction n generalizing x with
  | zero => exact (hx (by simp)).elim
  | succ n ih =>
    by_cases hu : IsUnit x
    · obtain ⟨v, rfl⟩ := hu
      exact ⟨0, v, by simp⟩
    · have hxm : x ∈ maximalIdeal S := by
        simpa [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] using hu
      rw [hm, Ideal.mem_span_singleton'] at hxm
      obtain ⟨y, rfl⟩ := hxm
      have hy : y ∉ maximalIdeal S ^ n := by
        intro hy
        apply hx
        rw [pow_succ]
        exact Ideal.mul_mem_mul hy (by rw [hm]; exact Ideal.subset_span (by simp))
      obtain ⟨k, v, hv⟩ := ih hy
      refine ⟨k + 1, v, ?_⟩
      rw [hv, pow_succ, mul_assoc]

variable [IsHausdorff (maximalIdeal S) S]

/-- Separatedness supplies a finite bound for every nonzero element. -/
theorem exists_eq_unit_mul_pow_of_isHausdorff {x : S} (hx : x ≠ 0) :
    ∃ k : ℕ, ∃ v : Sˣ, x = v * π ^ k := by
  have hn : ∃ n : ℕ, x ∉ maximalIdeal S ^ n := by
    by_contra! hn
    apply hx
    apply IsHausdorff.haus' (I := maximalIdeal S) x
    intro n
    simpa [SModEq.zero, Ideal.smul_eq_mul] using hn n
  obtain ⟨n, hn⟩ := hn
  exact exists_eq_unit_mul_pow_of_not_mem_maximalIdeal_pow π hm hn

/-- A separated local ring with a principal maximal ideal generated by a
non-nilpotent element is a domain. -/
theorem isDomain_of_isHausdorff_of_maximalIdeal_eq_span
    (hπ : ∀ n : ℕ, π ^ n ≠ 0) : IsDomain S := by
  have : NoZeroDivisors S := ⟨by
    intro x y hxy
    by_contra! h
    obtain ⟨k, v, rfl⟩ := exists_eq_unit_mul_pow_of_isHausdorff π hm h.1
    obtain ⟨l, w, rfl⟩ := exists_eq_unit_mul_pow_of_isHausdorff π hm h.2
    have hp : π ^ (k + l) = 0 := by
      have he : (v : S) * π ^ k * ((w : S) * π ^ l) =
          (v * w : Sˣ) * π ^ (k + l) := by
        simp only [Units.val_mul, pow_add]
        ac_rfl
      rw [he] at hxy
      exact (v * w).isUnit.mul_right_eq_zero.mp hxy
    exact hπ (k + l) hp⟩
  exact NoZeroDivisors.to_isDomain S

/-- The domain just constructed is a DVR, with the same chosen generator. -/
theorem isDiscreteValuationRing_of_isHausdorff_of_maximalIdeal_eq_span
    (hπ : ∀ n : ℕ, π ^ n ≠ 0) :
    let : IsDomain S := isDomain_of_isHausdorff_of_maximalIdeal_eq_span π hm hπ
    IsDiscreteValuationRing S := by
  let : IsDomain S := isDomain_of_isHausdorff_of_maximalIdeal_eq_span π hm hπ
  have hi : Irreducible π :=
    IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal π
      (by simpa using hπ 1) hm
  apply IsDiscreteValuationRing.ofHasUnitMulPowIrreducibleFactorization
  refine ⟨π, hi, ?_⟩
  intro x hx
  obtain ⟨k, v, rfl⟩ := exists_eq_unit_mul_pow_of_isHausdorff π hm hx
  exact ⟨k, ⟨v, by simp [mul_comm]⟩⟩

end PrincipalSeparated

end IsLocalRing
