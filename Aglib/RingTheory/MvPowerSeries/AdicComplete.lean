module

public import Aglib.RingTheory.AdicCompletion.Congruence
public import Mathlib.RingTheory.AdicCompletion.Topology
public import Mathlib.RingTheory.MvPowerSeries.Inverse
public import Mathlib.RingTheory.MvPowerSeries.Ideal
public import Mathlib.RingTheory.MvPowerSeries.LinearTopology
public import Mathlib.Topology.Algebra.OpenSubgroup

/-!
# Maximal-ideal completeness of multivariate power series

For a complete Noetherian local coefficient ring and finitely many variables,
the coefficientwise topology is the topology of the power series ring's own
maximal ideal. This mixed ideal includes both coefficient nonunits and the
variables; it is not merely the ideal generated by the variables.
-/

@[expose] public section

open Filter IsLocalRing
open scoped Topology

namespace MvPowerSeries

universe u v

variable {σ : Type u} {R : Type v} [Finite σ] [CommRing R]

theorem sub_truncTotal_mem_map_idealOfVars_pow (n : ℕ) (f : MvPowerSeries σ R) :
    f - (f.truncTotal n : MvPowerSeries σ R) ∈
      ((MvPolynomial.idealOfVars σ R) ^ n).map
        (algebraMap (MvPolynomial σ R) (MvPowerSeries σ R)) := by
  let V := MvPolynomial.idealOfVars σ R
  let e := toAdicCompletionAlgEquiv σ R
  have heval : AdicCompletion.evalₐ V n (e f) =
      AdicCompletion.evalₐ V n (e (f.truncTotal n : MvPowerSeries σ R)) := by
    have hcoe (p : MvPolynomial σ R) :
        algebraMap (MvPolynomial σ R) (MvPowerSeries σ R) p = ↑p := by
      simp [algebraMap_apply']
    rw [← hcoe, e.commutes, (AdicCompletion.evalₐ V n).commutes]
    change AdicCompletion.evalₐ V n (toAdicCompletion σ R f) = _
    simp only [toAdicCompletion]
    rfl
  have hmem := (AdicCompletion.evalₐ_eq_iff_sub_mem V
    (MvPolynomial.idealOfVars_fg σ R) n _ _).mp heval
  have himage := Ideal.mem_map_of_mem e.symm.toRingHom hmem
  have hcomp : e.symm.toRingHom.comp
      (algebraMap (MvPolynomial σ R) (AdicCompletion V (MvPolynomial σ R))) =
      algebraMap (MvPolynomial σ R) (MvPowerSeries σ R) := by
    apply RingHom.ext
    intro p
    exact e.symm.commutes p
  rw [Ideal.map_map, hcomp] at himage
  change e.symm (e f - e (f.truncTotal n : MvPowerSeries σ R)) ∈ _ at himage
  simpa only [map_sub, AlgEquiv.symm_apply_apply] using himage

variable [IsLocalRing R]

omit [Finite σ] in
private lemma constantCoeff_mem_maximalIdeal (f : MvPowerSeries σ R)
    (hf : f ∈ maximalIdeal (MvPowerSeries σ R)) : constantCoeff f ∈ maximalIdeal R := by
  simpa only [mem_maximalIdeal, mem_nonunits_iff, isUnit_iff_constantCoeff] using hf

omit [Finite σ] in
private lemma map_maximalIdeal_C_le :
    (maximalIdeal R).map (C : R →+* MvPowerSeries σ R) ≤
      maximalIdeal (MvPowerSeries σ R) := by
  apply Ideal.map_le_iff_le_comap.mpr
  intro r hr
  change C r ∈ maximalIdeal (MvPowerSeries σ R)
  simpa only [mem_maximalIdeal, mem_nonunits_iff, isUnit_iff_constantCoeff,
    constantCoeff_C] using hr

omit [Finite σ] in
private lemma map_idealOfVars_le_maximalIdeal :
    (MvPolynomial.idealOfVars σ R).map
      (algebraMap (MvPolynomial σ R) (MvPowerSeries σ R)) ≤
      maximalIdeal (MvPowerSeries σ R) := by
  rw [Ideal.map_le_iff_le_comap]
  apply Ideal.span_le.mpr
  rintro _ ⟨i, rfl⟩
  change algebraMap (MvPolynomial σ R) (MvPowerSeries σ R) (MvPolynomial.X i) ∈
    maximalIdeal (MvPowerSeries σ R)
  simp [algebraMap_apply', mem_maximalIdeal, mem_nonunits_iff, isUnit_iff_constantCoeff]

private lemma mem_maximalIdeal_pow_of_low_coeff_mem (n : ℕ)
    (hm : (maximalIdeal R).FG) (f : MvPowerSeries σ R)
    (hf : ∀ d : σ →₀ ℕ, d.degree < n → coeff d f ∈ maximalIdeal R ^ n) :
    f ∈ maximalIdeal (MvPowerSeries σ R) ^ n := by
  have hlow : (f.truncTotal n : MvPowerSeries σ R) ∈
      (maximalIdeal R ^ n).map (C : R →+* MvPowerSeries σ R) := by
    apply mem_map_C_of_forall_coeff_mem (hm.pow (n := n))
    intro d
    rw [MvPolynomial.coeff_coe, coeff_truncTotal_eq_ite]
    split_ifs with hd
    · exact hf d hd
    · exact Ideal.zero_mem _
  have hlow' : (f.truncTotal n : MvPowerSeries σ R) ∈
      maximalIdeal (MvPowerSeries σ R) ^ n := by
    apply (Ideal.pow_right_mono (map_maximalIdeal_C_le (σ := σ) (R := R)) n)
    simpa only [Ideal.map_pow] using hlow
  have htail : f - (f.truncTotal n : MvPowerSeries σ R) ∈
      maximalIdeal (MvPowerSeries σ R) ^ n := by
    apply (Ideal.pow_right_mono (map_idealOfVars_le_maximalIdeal (σ := σ) (R := R)) n)
    simpa only [Ideal.map_pow] using sub_truncTotal_mem_map_idealOfVars_pow n f
  simpa only [sub_add_cancel] using (maximalIdeal (MvPowerSeries σ R) ^ n).add_mem htail hlow'

open WithPiTopology

private lemma maximalIdeal_pow_mem_nhds [TopologicalSpace R]
    (hR : IsAdic (maximalIdeal R)) (hm : (maximalIdeal R).FG) (n : ℕ) :
    ((maximalIdeal (MvPowerSeries σ R) ^ n : Ideal (MvPowerSeries σ R)) :
      Set (MvPowerSeries σ R)) ∈ 𝓝 0 := by
  classical
  have hcoeff (d : σ →₀ ℕ) :
      {f : MvPowerSeries σ R | coeff d f ∈ maximalIdeal R ^ n} ∈ 𝓝 0 := by
    have hm_n : ((maximalIdeal R ^ n : Ideal R) : Set R) ∈ 𝓝 (0 : R) :=
      hR.hasBasis_nhds_zero.mem_of_mem trivial
    apply Filter.mem_of_superset
      ((WithPiTopology.continuous_coeff R d).continuousAt.preimage_mem_nhds hm_n)
    intro f hf
    exact hf
  have hfinite : (⋂ d ∈ {d : σ →₀ ℕ | d.degree < n},
      {f : MvPowerSeries σ R | coeff d f ∈ maximalIdeal R ^ n}) ∈
      𝓝 (0 : MvPowerSeries σ R) :=
    (Filter.biInter_mem (Finsupp.finite_of_degree_lt n)).mpr (fun d _ => hcoeff d)
  apply Filter.mem_of_superset hfinite
  intro f hf
  apply mem_maximalIdeal_pow_of_low_coeff_mem n hm f
  simpa only [Set.mem_iInter, Set.mem_ofPred_eq] using hf

/-- Finite-variable power series over a maximal-ideal-complete Noetherian local
ring are complete for their own maximal ideal, including both coefficient
nonunits and variables. No coefficient field or discrete valuation is required. -/
theorem isAdicComplete_maximalIdeal (σ : Type u) (R : Type v) [Finite σ]
    [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    [IsAdicComplete (maximalIdeal R) R] :
    IsAdicComplete (maximalIdeal (MvPowerSeries σ R)) (MvPowerSeries σ R) := by
  classical
  let : WithIdeal R := ⟨maximalIdeal R⟩
  have hR : IsAdic (maximalIdeal R) := rfl
  have : CompleteSpace R := hR.isAdicComplete_iff.mp inferInstance |>.1
  have : T2Space R := hR.isAdicComplete_iff.mp inferInstance |>.2
  have : IsLinearTopology Rᵐᵒᵖ R :=
    (IsCentralScalar.isLinearTopology_iff R).mpr inferInstance
  have hB : IsAdic (maximalIdeal (MvPowerSeries σ R)) := by
    apply isAdic_iff.mpr
    constructor
    · intro n
      exact (maximalIdeal (MvPowerSeries σ R) ^ n).toAddSubgroup.isOpen_of_mem_nhds
        (maximalIdeal_pow_mem_nhds hR (maximalIdeal R).fg_of_isNoetherianRing n)
    · intro s hs
      obtain ⟨I, hI, hIs⟩ := IsLinearTopology.hasBasis_ideal.mem_iff.mp hs
      have hrad : maximalIdeal (MvPowerSeries σ R) ≤ I.radical := by
        intro f hf
        have hnil : IsTopologicallyNilpotent f :=
          LinearTopology.isTopologicallyNilpotent_of_constantCoeff
            (WithIdeal.isTopologicallyNilpotent_of_mem
              (constantCoeff_mem_maximalIdeal f hf))
        exact hnil.exists_pow_mem_of_mem_nhds hI
      obtain ⟨n, hn⟩ := Ideal.exists_pow_le_of_le_radical_of_fg hrad
        (maximalIdeal (MvPowerSeries σ R)).fg_of_isNoetherianRing
      exact ⟨n, fun f hf => hIs (hn hf)⟩
  exact hB.isAdicComplete_iff.mpr ⟨inferInstance, inferInstance⟩

end MvPowerSeries
