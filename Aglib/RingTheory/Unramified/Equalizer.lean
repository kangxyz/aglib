module

public import Mathlib.RingTheory.Unramified.Basic

/-!
# Equalizers of maps from an unramified algebra

For an essentially finite type, formally unramified algebra, the ideal generated
by the differences of two algebra maps is generated by an idempotent. If the maps
agree after a given ring homomorphism, one localization coequalizes them and the
given homomorphism factors through that localization.
-/

@[expose] public section

open scoped TensorProduct

namespace Algebra.FormallyUnramified

variable {R A B : Type*} [CommRing R] [CommRing A] [CommRing B]
  [Algebra R A] [Algebra R B] [EssFiniteType R A] [FormallyUnramified R A]

/-- The ideal of differences of two maps from an essentially finite type,
formally unramified algebra is generated by an idempotent. -/
lemma exists_idempotent_span_sub_eq (f g : A →ₐ[R] B) :
    ∃ e : B, IsIdempotentElem e ∧
      Ideal.span (Set.range fun a : A => f a - g a) = Ideal.span {e} := by
  obtain ⟨e, he, hI⟩ : ∃ e, IsIdempotentElem e ∧
      KaehlerDifferential.ideal R A = (A ⊗[R] A) ∙ e :=
    (Ideal.isIdempotentElem_iff_of_fg _ (KaehlerDifferential.ideal_fg R A)).mp <|
      (Ideal.cotangent_subsingleton_iff _).mp <|
        inferInstanceAs <| Subsingleton Ω[A⁄R]
  change KaehlerDifferential.ideal R A = Ideal.span {e} at hI
  let φ : A ⊗[R] A →ₐ[R] B := TensorProduct.lift g f (fun _ _ => .all _ _)
  refine ⟨φ e, ?_, ?_⟩
  · change φ e * φ e = φ e
    rw [← map_mul, he]
  · calc
      Ideal.span (Set.range fun a : A => f a - g a) =
          (Ideal.span (Set.range fun a : A =>
            (1 : A) ⊗ₜ[R] a - a ⊗ₜ[R] (1 : A))).map φ.toRingHom := by
        rw [Ideal.map_span, ← Set.range_comp']
        simp [φ]
      _ = Ideal.span {φ e} := by
        rw [KaehlerDifferential.span_range_eq_ideal, hI, Ideal.map_span,
          Set.image_singleton]
        rfl

/-- Two algebra maps agreeing after a ring homomorphism admit an annihilator of
all their differences whose image under that homomorphism is one. -/
lemma exists_pointed_annihilator {K : Type*} [CommRing K]
    (f g : A →ₐ[R] B) (p : B →+* K)
    (hp : p.comp f.toRingHom = p.comp g.toRingHom) :
    ∃ s : B, p s = 1 ∧ ∀ a : A, s * (f a - g a) = 0 := by
  obtain ⟨e, he, hI⟩ := exists_idempotent_span_sub_eq f g
  have hker : Ideal.span (Set.range fun a : A => f a - g a) ≤ RingHom.ker p := by
    rw [Ideal.span_le]
    rintro _ ⟨a, rfl⟩
    change p (f a - g a) = 0
    rw [map_sub, sub_eq_zero]
    exact RingHom.congr_fun hp a
  have hpe : p e = 0 := by
    apply hker
    rw [hI]
    exact Ideal.subset_span (Set.mem_singleton e)
  refine ⟨1 - e, by simp [hpe], ?_⟩
  intro a
  have ha : f a - g a ∈ Ideal.span {e} := by
    rw [← hI]
    exact Ideal.subset_span ⟨a, rfl⟩
  obtain ⟨t, ht⟩ := Ideal.mem_span_singleton'.mp ha
  rw [← ht]
  calc
    (1 - e) * (t * e) = t * (e - e * e) := by ring
    _ = 0 := by rw [he, sub_self, mul_zero]

/-- One localization coequalizes two algebra maps agreeing after a given ring
homomorphism, and that ring homomorphism factors through the localization. -/
lemma exists_pointed_localization_coequalizer {K : Type*} [CommRing K]
    (f g : A →ₐ[R] B) (p : B →+* K)
    (hp : p.comp f.toRingHom = p.comp g.toRingHom) :
    ∃ s : B, p s = 1 ∧
      (IsScalarTower.toAlgHom R B (Localization.Away s)).comp f =
        (IsScalarTower.toAlgHom R B (Localization.Away s)).comp g ∧
      ∃ q : Localization.Away s →+* K,
        q.comp (algebraMap B (Localization.Away s)) = p := by
  obtain ⟨s, hs, hfg⟩ := exists_pointed_annihilator f g p hp
  refine ⟨s, hs, ?_, ?_⟩
  · apply AlgHom.ext
    intro a
    change algebraMap B (Localization.Away s) (f a) =
      algebraMap B (Localization.Away s) (g a)
    apply sub_eq_zero.mp
    have h := congrArg (algebraMap B (Localization.Away s)) (hfg a)
    rw [map_mul, map_sub, map_zero] at h
    exact (IsLocalization.Away.algebraMap_isUnit s).mul_right_eq_zero.mp h
  · have hpunit : IsUnit (p s) := by rw [hs]; exact isUnit_one
    exact ⟨IsLocalization.Away.lift s hpunit, IsLocalization.Away.lift_comp s hpunit⟩

end Algebra.FormallyUnramified
