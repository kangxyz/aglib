module

public import Mathlib.Algebra.DirectSum.Module
public import Mathlib.RingTheory.Finiteness.Basic

/-!
# Bounded homogeneous generating degrees of a finite external graded module

Finite generation of the total module forces a finite bound on the degrees
needed to generate it. The proof uses the actual direct-sum component maps.
No Noetherian hypothesis, algebraization or finite generation of each component
is required for this elementary bound.
-/

@[expose] public noncomputable section

open DirectSum

namespace GradedModule

universe u v

variable (R : Type u) [Semiring R] (M : ℕ → Type v)
  [∀ n, AddCommMonoid (M n)] [Module R (⨁ n, M n)]

/-- The submodule generated by the original homogeneous components up to a
specified degree, allowing the actual full-ring scalar action. -/
def boundedDegreeSpan (c : ℕ) : Submodule R (⨁ n, M n) :=
  Submodule.span R {x | ∃ n ≤ c, ∃ y : M n, x = DirectSum.of M n y}

theorem boundedDegreeSpan_mono : Monotone (boundedDegreeSpan R M) := by
  intro c d hcd
  apply Submodule.span_mono
  rintro x ⟨n, hn, y, rfl⟩
  exact ⟨n, hn.trans hcd, y, rfl⟩

/-- All original homogeneous components together generate the total module. -/
theorem iSup_boundedDegreeSpan : (⨆ c, boundedDegreeSpan R M c) = ⊤ := by
  apply top_le_iff.mp
  intro x _
  induction x using DirectSum.induction_on with
  | zero => exact Submodule.zero_mem _
  | of n x =>
    apply (le_iSup (boundedDegreeSpan R M) n)
    exact Submodule.subset_span ⟨n, le_rfl, x, rfl⟩
  | add x y hx hy => exact Submodule.add_mem _ (hx (Submodule.mem_top)) (hy (Submodule.mem_top))

/-- A finite external graded module is generated in bounded homogeneous
degrees, with the same original component inclusions and full scalar action. -/
theorem exists_boundedDegreeSpan_eq_top [Module.Finite R (⨁ n, M n)] :
    ∃ c : ℕ, boundedDegreeSpan R M c = ⊤ := by
  let L : ℕ →o Submodule R (⨁ n, M n) :=
    ⟨boundedDegreeSpan R M, boundedDegreeSpan_mono R M⟩
  obtain ⟨c, hc⟩ := (Module.Finite.fg_top (R := R) (M := ⨁ n, M n)).stabilizes_of_iSup_eq
    L (iSup_boundedDegreeSpan R M)
  exact ⟨c, hc.symm⟩

end GradedModule
