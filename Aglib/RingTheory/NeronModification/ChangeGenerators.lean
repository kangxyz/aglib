module

public import Aglib.RingTheory.NeronModification.Lift

/-! # Independence of the generators of a Néron centre

The actual modification depends only on the ideal generated by the distinguished
element together with the specified centre generators. The comparison maps are
constructed from ideal membership and the actual divisibility universal property.
-/

@[expose] public noncomputable section

set_option backward.isDefEq.respectTransparency false

namespace Algebra.NeronModification

variable {B ι κ : Type*} [CommRing B]
variable (p : B) (g : ι → B) (h : κ → B)

/-- Every element of the centre ideal becomes divisible by the distinguished element. -/
theorem of_dvd_of_mem_centre (b : B)
    (hb : b ∈ Ideal.span (insert p (Set.range g))) : of p g p ∣ of p g b := by
  have hc : Ideal.span (insert p (Set.range g)) ≤
      (Ideal.span {of p g p}).comap (of p g) := by
    apply Ideal.span_le.mpr
    intro x hx
    rcases hx with hxp | ⟨i, rfl⟩
    · subst x
      change of p g p ∈ Ideal.span {of p g p}
      exact Ideal.mem_span_singleton_self _
    · change of p g (g i) ∈ Ideal.span {of p g p}
      exact Ideal.mem_span_singleton.mpr ⟨coordinate p g i, (of_mul_coordinate p g i).symm⟩
  have hh := hc hb
  change of p g b ∈ Ideal.span {of p g p} at hh
  with_reducible_and_instances
    exact (@Ideal.mem_span_singleton (Modification p g) inferInstance
      (of p g b) (of p g p)).mp hh

/-- Inclusion of the actual centre ideals gives the corresponding modification map. -/
def mapOfCentreLe
    (hgh : Ideal.span (insert p (Set.range g)) ≤ Ideal.span (insert p (Set.range h))) :
    Modification p g →ₐ[B] Modification p h := by
  classical
  have hd (i : ι) : of p h p ∣ of p h (g i) :=
    of_dvd_of_mem_centre p h (g i)
      (hgh (Ideal.subset_span (Set.mem_insert_of_mem p ⟨i, rfl⟩)))
  choose z hz using hd
  exact liftAlgHom p g z (fun i => (hz i).symm) (isRegular_of p h)

/-- The comparison induced by centre inclusion preserves the original coefficient map. -/
@[simp] theorem mapOfCentreLe_of
    (hgh : Ideal.span (insert p (Set.range g)) ≤ Ideal.span (insert p (Set.range h)))
    (b : B) : mapOfCentreLe p g h hgh (of p g b) = of p h b :=
  (mapOfCentreLe p g h hgh).commutes b

/-- Equality of the actual centre ideals gives a base-preserving algebra equivalence. -/
def changeGeneratorsEquiv
    (hgh : Ideal.span (insert p (Set.range g)) = Ideal.span (insert p (Set.range h))) :
    Modification p g ≃ₐ[B] Modification p h :=
  AlgEquiv.ofAlgHom (mapOfCentreLe p g h hgh.le) (mapOfCentreLe p h g hgh.ge)
    (algHom_ext_of_isRegular (C := Modification p h) p h (isRegular_of p h) _ _)
    (algHom_ext_of_isRegular (C := Modification p g) p g (isRegular_of p g) _ _)

/-- Changing centre generators leaves every original coefficient unchanged. -/
@[simp] theorem changeGeneratorsEquiv_of
    (hgh : Ideal.span (insert p (Set.range g)) = Ideal.span (insert p (Set.range h)))
    (b : B) : changeGeneratorsEquiv p g h hgh (of p g b) = of p h b :=
  (changeGeneratorsEquiv p g h hgh).commutes b

end Algebra.NeronModification
