/-! # Finite-field stages of split nilpotent quotients

A finite family of original characters and chosen preimages of the coordinate
vectors involves finitely many coefficients in the original base-changed
basis. The actual intermediate field generated by these coefficients retains
the original surjective quotient and its nilpotent kernel. Nilpotence is
reflected as an equality of ideal powers along the injective tensor map.

This is descent over algebraic field extensions, not spreading over a
Noetherian base ring. The original coordinate index is never reindexed.
-/

@[expose] public noncomputable section

open scoped TensorProduct BigOperators

/-- In an original commuting square of ring maps, an injective source-base
map reflects nilpotence of the whole kernel ideal. The ideal image inclusion,
its powers, and reflection of zero are proved together before any concrete
field-stage maps are substituted. All original bundled maps are retained. -/
theorem RingHom.ker_pow_eq_bot_of_injective_square
    {R S T U : Type*} [CommRing R] [CommRing S] [CommRing T] [CommRing U]
    {F : Type*} [FunLike F R S] [RingHomClass F R S]
    {G : Type*} [FunLike G R T] [RingHomClass G R T]
    {H : Type*} [FunLike H S U] [RingHomClass H S U]
    {E : Type*} [FunLike E T U] [RingHomClass E T U]
    (f : F) (q : G) (p : H) (g : E) (hf : Function.Injective f)
    (hcomm : ∀ x, p (f x) = g (q x))
    (n : ℕ) (hn : (RingHom.ker p) ^ n = ⊥) : (RingHom.ker q) ^ n = ⊥ := by
  have hker : (RingHom.ker q).map f ≤ RingHom.ker p := by
    apply Ideal.map_le_iff_le_comap.mpr
    intro x hx
    change p (f x) = 0
    rw [hcomm, show q x = 0 from hx, map_zero]
  apply (Ideal.map_eq_bot_iff_of_injective (f := f) hf).mp
  apply le_antisymm _ bot_le
  calc
    ((RingHom.ker q) ^ n).map f = ((RingHom.ker q).map f) ^ n :=
      Ideal.map_pow f (RingHom.ker q) n
    _ ≤ (RingHom.ker p) ^ n := pow_le_pow_left' hker n
    _ = ⊥ := hn

namespace Algebra.FiniteAlgebra

universe u v w t s

variable {k : Type u} [Field k] {Ω : Type v} [Field Ω] [Algebra k Ω]
  [Algebra.IsAlgebraic k Ω] {A : Type w} [CommRing A] [Algebra k A]
  {I : Type t} [Finite I] {J : Type s} [Finite J]

/-- A split nilpotent quotient over an algebraic extension descends to an
actual finite intermediate field. The coordinatewise equation records the
original tensor base-change map, not merely an abstract isomorphism. -/
theorem exists_finiteField_splitQuotient (b : Module.Basis I k A)
    (q : Ω ⊗[k] A →ₐ[Ω] (J → Ω)) (hq : Function.Surjective q)
    (n : ℕ) (hn : (RingHom.ker q.toRingHom) ^ n = ⊥) :
    ∃ L : IntermediateField k Ω, Module.Finite k L ∧
      ∃ qL : L ⊗[k] A →ₐ[L] (J → L), Function.Surjective qL ∧
        (RingHom.ker qL.toRingHom) ^ n = ⊥ ∧
        ∀ (z : L ⊗[k] A) (j : J), (qL z j : Ω) =
          q (Algebra.TensorProduct.map L.val (AlgHom.id k A) z) j := by
  classical
  let : Fintype I := Fintype.ofFinite I
  let : Fintype J := Fintype.ofFinite J
  let χ : J → (A →ₐ[k] Ω) := fun j =>
    (((Pi.evalAlgHom Ω (fun _ : J => Ω) j).comp q).restrictScalars k).comp
      Algebra.TensorProduct.includeRight
  let p : J → Ω ⊗[k] A := fun j => (hq (Pi.single j 1)).choose
  have hp (j : J) : q (p j) = Pi.single j 1 := (hq (Pi.single j 1)).choose_spec
  let c : J → I → Ω := fun j i => (b.baseChange Ω).repr (p j) i
  let coeffs : Finset Ω :=
    Finset.univ.image (fun ij : I × J => χ ij.2 (b ij.1)) ∪
      Finset.univ.image (fun ji : J × I => c ji.1 ji.2)
  let L : IntermediateField k Ω := IntermediateField.adjoin k (coeffs : Set Ω)
  have hχ (j : J) (i : I) : χ j (b i) ∈ L := by
    apply IntermediateField.subset_adjoin k _
    exact Finset.mem_union_left _ (Finset.mem_image.mpr ⟨(i, j), Finset.mem_univ _, rfl⟩)
  have hc (j : J) (i : I) : c j i ∈ L := by
    apply IntermediateField.subset_adjoin k _
    exact Finset.mem_union_right _ (Finset.mem_image.mpr ⟨(j, i), Finset.mem_univ _, rfl⟩)
  have hχall (j : J) (a : A) : χ j a ∈ L := by
    rw [← b.sum_repr a, map_sum]
    exact L.sum_mem fun i _ => by
      rw [map_smul]
      exact L.smul_mem (hχ j i)
  let χL : J → (A →ₐ[k] L) := fun j => (χ j).codRestrict L.toSubalgebra (hχall j)
  let qL : L ⊗[k] A →ₐ[L] (J → L) :=
    AlgHom.liftEquiv k L A (J → L) (AlgHom.pi χL)
  let ι : L ⊗[k] A →ₐ[k] Ω ⊗[k] A :=
    Algebra.TensorProduct.map L.val (AlgHom.id k A)
  have hcomm (z : L ⊗[k] A) (j : J) : (qL z j : Ω) = q (ι z) j := by
    induction z using TensorProduct.inductionOn with
    | tmul l a =>
      change (l : Ω) * q (1 ⊗ₜ[k] a) j = q ((l : Ω) ⊗ₜ[k] a) j
      calc
        _ = q ((l : Ω) • (1 ⊗ₜ[k] a)) j := by rw [map_smul]; rfl
        _ = _ := by rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
    | add x y hx hy => simp [hx, hy]
  let pL : J → L ⊗[k] A := fun j => ∑ i, (⟨c j i, hc j i⟩ : L) ⊗ₜ[k] b i
  have hpL (j : J) : ι (pL j) = p j := by
    simp only [pL, map_sum, ι, Algebra.TensorProduct.map_tmul, AlgHom.id_apply]
    change (∑ i, c j i ⊗ₜ[k] b i) = p j
    simpa only [c, Module.Basis.baseChange_apply, TensorProduct.smul_tmul',
      smul_eq_mul, mul_one] using (b.baseChange Ω).sum_repr (p j)
  have hqL (j : J) : qL (pL j) = Pi.single j 1 := by
    apply funext
    intro j'
    apply Subtype.val_injective
    rw [hcomm, hpL, hp]
    simp only [Pi.single_apply]
    split_ifs <;> rfl
  have hsurj : Function.Surjective qL := by
    intro y
    refine ⟨∑ j, y j • pL j, ?_⟩
    simp only [map_sum, map_smul, hqL]
    ext j
    simp [Pi.single_apply]
  have hinj : Function.Injective ι := by
    exact TensorProduct.map_injective_of_flat_flat L.val.toLinearMap
      (AlgHom.id k A).toLinearMap Subtype.val_injective Function.injective_id
  let g : (J → L) →+* (J → Ω) :=
    RingHom.pi fun j => L.val.toRingHom.comp (Pi.evalRingHom (fun _ : J => L) j)
  have hsquare (z : L ⊗[k] A) : q (ι z) = g (qL z) := by
    funext j
    exact (hcomm z j).symm
  have hnil := RingHom.ker_pow_eq_bot_of_injective_square
    ι qL.toRingHom q.toRingHom g hinj hsquare n hn
  have hfinite : Module.Finite k L :=
    IntermediateField.finiteDimensional_adjoin fun x _ =>
      (Algebra.IsAlgebraic.isAlgebraic x).isIntegral
  exact ⟨L, hfinite, qL, hsurj, hnil, hcomm⟩

/-- The canonical quotient over the original maximal spectrum has a finite
field stage. This specializes the finite-coordinate construction without
changing the original geometric index or the original quotient map. -/
theorem exists_finiteField_splitReduction [IsAlgClosed Ω] [Module.Finite k A] :
    ∃ n : ℕ, 0 < n ∧ ∃ L : IntermediateField k Ω, Module.Finite k L ∧
      ∃ qL : L ⊗[k] A →ₐ[L] (MaximalSpectrum (Ω ⊗[k] A) → L),
        Function.Surjective qL ∧ (RingHom.ker qL.toRingHom) ^ n = ⊥ ∧
        ∀ (z : L ⊗[k] A) (j : MaximalSpectrum (Ω ⊗[k] A)), (qL z j : Ω) =
          splitReductionMap Ω (Ω ⊗[k] A)
            (Algebra.TensorProduct.map L.val (AlgHom.id k A) z) j := by
  classical
  let : IsArtinianRing (Ω ⊗[k] A) := IsArtinianRing.of_finite Ω _
  let : Fintype (MaximalSpectrum (Ω ⊗[k] A)) := Fintype.ofFinite _
  obtain ⟨n, hn, hnil⟩ := exists_positive_pow_ker_splitReductionMap_eq_bot Ω (Ω ⊗[k] A)
  exact ⟨n, hn, exists_finiteField_splitQuotient (Module.Free.chooseBasis k A)
    (splitReductionMap Ω (Ω ⊗[k] A)) (splitReductionMap_surjective Ω _) n hnil⟩

end Algebra.FiniteAlgebra
