module

public import Mathlib.RingTheory.FiniteType

/-! # An arithmetic coefficient model retaining an invertible integer

The actual integer subalgebra generated by the inverse of the given unit is
finite type and already contains that unit and its inverse. It lies in the
original ring's universe. Any original ring arrow is linear over this model
using its original composite scalar map, without a universe-lifted localization.
-/

@[expose] public noncomputable section

namespace Algebra.InvertibleIntegerModel

universe u v
variable {A : Type u} [CommRing A] (n : ℕ) (h : IsUnit (n : A))

/-- The original integer subalgebra generated by the inverse of the given unit. -/
def model : Subalgebra ℤ A := Algebra.adjoin ℤ ({↑h.unit⁻¹} : Set A)

instance model_finiteType : Algebra.FiniteType ℤ (model n h) :=
  Algebra.FiniteType.adjoin_of_finite (Set.finite_singleton _)

/-- The modulus is already a unit in this same finite-type subalgebra. -/
theorem model_isUnit : IsUnit (n : model n h) := by
  let inv : model n h := ⟨↑h.unit⁻¹, Algebra.subset_adjoin (Set.mem_singleton _)⟩
  apply isUnit_iff_exists_inv.mpr
  refine ⟨inv, ?_⟩
  apply Subtype.ext
  change (n : A) * ↑h.unit⁻¹ = 1
  exact (congrArg (fun z : A => z * ↑h.unit⁻¹) h.unit_spec).symm.trans h.unit.mul_inv

variable {B : Type v} [CommRing B]

/-- The scalar map is the original ring arrow composed with the actual inclusion. -/
def targetMap (f : A →+* B) : model n h →+* B := f.comp (model n h).val.toRingHom

/-- The original ring arrow, with the unchanged values, is linear over the model. -/
def originalArrow (f : A →+* B) :
    letI : Algebra (model n h) B := (targetMap n h f).toAlgebra
    A →ₐ[model n h] B := by
  letI : Algebra (model n h) B := (targetMap n h f).toAlgebra
  exact { f with commutes' := fun _ => rfl }

/-- The arithmetic realization retains the whole original ring homomorphism. -/
theorem originalArrow_toRingHom (f : A →+* B) :
    letI : Algebra (model n h) B := (targetMap n h f).toAlgebra
    (originalArrow n h f).toRingHom = f := rfl

end Algebra.InvertibleIntegerModel
