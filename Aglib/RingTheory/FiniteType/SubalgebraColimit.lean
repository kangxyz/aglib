module

public import Mathlib.Algebra.Category.Ring.FilteredColimits
public import Mathlib.Algebra.Category.Ring.Colimits
public import Mathlib.CategoryTheory.Limits.Types.ColimitTypeFiltered
public import Mathlib.RingTheory.FiniteType

/-!
# The colimit of finitely generated subalgebras

A commutative algebra is the filtered union of its subalgebras generated by
finite subsets. The diagram and cocone use the actual inclusion ring maps.
The coefficient ring and algebra may have different universes.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

namespace Algebra.FiniteTypeSubalgebraLimit

universe u v

variable (R : Type u) (A : Type v) [CommRing R] [CommRing A] [Algebra R A]

/-- The subalgebra generated by a finite set of elements. -/
abbrev stage (s : Finset A) : Subalgebra R A := Algebra.adjoin R (s : Set A)

instance stage_finiteType (s : Finset A) : Algebra.FiniteType R (stage R A s) :=
  Algebra.FiniteType.adjoin_of_finite s.finite_toSet

/-- The actual inclusion diagram of a monotone family of subalgebras. -/
def subalgebraDiagram {J : Type v} [Preorder J]
    (S : J → Subalgebra R A) (hS : Monotone S) : J ⥤ CommRingCat.{v} where
  obj j := CommRingCat.of (S j)
  map f := CommRingCat.ofHom (Subalgebra.inclusion (hS (leOfHom f))).toRingHom
  map_id _ := rfl
  map_comp _ _ := rfl

/-- The actual inclusion cocone of a monotone family of subalgebras. -/
def subalgebraCocone {J : Type v} [Preorder J]
    (S : J → Subalgebra R A) (hS : Monotone S) : Cocone (subalgebraDiagram R A S hS) where
  pt := CommRingCat.of A
  ι :=
    { app j := CommRingCat.ofHom (S j).val.toRingHom
      naturality _ _ _ := rfl }

/-- The finite-generated subalgebra diagram with native inclusions. -/
def ringDiagram : Finset A ⥤ CommRingCat.{v} :=
  subalgebraDiagram R A (stage R A) fun _ _ h ↦
    Algebra.adjoin_mono (Finset.coe_subset.mpr h)

/-- The inclusion cocone into the original algebra. -/
def ringCocone : Cocone (ringDiagram R A) :=
  subalgebraCocone R A (stage R A) fun _ _ h ↦
    Algebra.adjoin_mono (Finset.coe_subset.mpr h)

/-- The underlying type-valued inclusion cocone. -/
def ringTypeCocone : (ringDiagram R A ⋙ forget CommRingCat).CoconeTypes :=
  (ringDiagram R A ⋙ forget CommRingCat).coconeTypesEquiv.symm
    ((forget CommRingCat).mapCocone (ringCocone R A))

/-- Each element belongs to its singleton-generated stage. -/
def singleElement (x : A) : stage R A {x} :=
  ⟨x, Algebra.subset_adjoin (by simp)⟩

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- Every element is represented at a stage, and stage inclusions are injective. -/
theorem ringTypeCocone_isColimit : (ringTypeCocone R A).IsColimit := by
  refine ⟨?_, ?_⟩
  · rw [Functor.CoconeTypes.descColimitType_injective_iff_of_isFiltered']
    intro s x y h
    refine ⟨s, 𝟙 s, ?_⟩
    exact Subtype.ext h
  · intro x
    refine ⟨Functor.ιColimitType (ringDiagram R A ⋙ forget CommRingCat) {x}
      (singleElement R A x), ?_⟩
    exact Functor.descColimitType_ιColimitType_apply _ _ _ _

/-- The original algebra is the colimit in commutative rings. -/
def ringCoconeIsColimit : IsColimit (ringCocone R A) := by
  let : ReflectsColimit (ringDiagram R A) (forget CommRingCat) :=
    reflectsColimit_of_reflectsIsomorphisms _ _
  apply isColimitOfReflects (forget CommRingCat)
  exact ((Functor.CoconeTypes.isColimit_iff (ringTypeCocone R A)).mp
    (ringTypeCocone_isColimit R A)).some

/-- The inclusion of a stage respects the original coefficient algebra map. -/
@[simp]
theorem ringCocone_algebraMap (s : Finset A) (r : R) :
    ((ringCocone R A).ι.app s).hom (algebraMap R (stage R A s) r) =
      algebraMap R A r := rfl

end Algebra.FiniteTypeSubalgebraLimit
