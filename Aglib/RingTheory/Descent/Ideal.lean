module

public import Mathlib.Algebra.Category.Ring.Constructions
public import Mathlib.RingTheory.Flat.Equalizer
public import Mathlib.RingTheory.Flat.FaithfullyFlat.Algebra
public import Mathlib.RingTheory.RingHom.FaithfullyFlat

/-!
# Faithfully flat descent of ideals

Let `B` be an `A`-algebra and `J` an ideal of `B`. Write `includeLeft, includeRight : B → B ⊗[A] B`
for the two coprojections.

* `Ideal.map_comap_algebraMap_eq_comap_includeLeft_map_includeRight`: if `B` is flat over `A`,
  the extension to `B` of the contraction `J ∩ A` is the preimage under `includeLeft` of the
  extension of `J` along `includeRight`.
* `Ideal.map_comap_algebraMap_eq_self_of_faithfullyFlat`: if `B` is faithfully flat over `A`
  and the two extensions of `J` to `B ⊗[A] B` agree, then `J` is the extension of the ideal
  `J.comap (algebraMap A B)` of `A`.
* `Ideal.existsUnique_map_algebraMap_eq_of_faithfullyFlat`: that ideal of `A` is the unique
  ideal whose extension is `J`.
* `Ideal.map_comap_eq_self_of_isPushout`: the same descent for an arbitrary pushout square
  `B ⟶ C ⟵ B` of a faithfully flat `φ : A ⟶ B` in `CommRingCat`, as produced by the global
  sections of a fibre product of affine schemes.

This is the affine case of the descent of closed subschemes along faithfully flat
quasi-compact morphisms (Nitsure, *Construction of Hilbert and Quot schemes*,
arXiv:math/0504590v1, Lemma 6.7(2), which Nitsure attributes to SGA 1, Exposé VIII,
Corollaire 1.9; that source is not checked here). Compare effective
descent of modules along faithfully flat ring maps (Stacks Project, Tag 023N,
Proposition 35.3.9), which the proof does not use: it applies flatness to the kernel of
`A → B ⧸ J` and faithful flatness of `includeLeft`, which is the base change of `A → B`.
-/

@[expose] public section

open TensorProduct

namespace Ideal

variable {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]

private lemma algebraMap_tmul_one (a : A) :
    algebraMap A B a ⊗ₜ[A] (1 : B) = (1 : B) ⊗ₜ[A] algebraMap A B a := by
  rw [Algebra.algebraMap_eq_smul_one]
  exact TensorProduct.smul_tmul _ _ _

/-- Over a flat `A`-algebra `B`, the extension of the contraction of an ideal `J ⊆ B` equals
the preimage under `b ↦ b ⊗ₜ 1` of the ideal of `B ⊗[A] B` generated by `1 ⊗ₜ J`. The inclusion
`⊆` holds for every algebra; the reverse inclusion tensors the kernel of `A → B ⧸ J` with `B`. -/
theorem map_comap_algebraMap_eq_comap_includeLeft_map_includeRight [Module.Flat A B]
    (J : Ideal B) :
    (J.comap (algebraMap A B)).map (algebraMap A B) =
      (J.map (Algebra.TensorProduct.includeRight : B →ₐ[A] B ⊗[A] B)).comap
        (Algebra.TensorProduct.includeLeft : B →ₐ[A] B ⊗[A] B) := by
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap] at ha
    rw [Ideal.mem_comap, Ideal.mem_comap, Algebra.TensorProduct.includeLeft_apply,
      algebraMap_tmul_one]
    exact Ideal.mem_map_of_mem _ ha
  · intro x hx
    rw [Ideal.mem_comap, Algebra.TensorProduct.includeLeft_apply] at hx
    let π : A →ₗ[A] B ⧸ J := (Ideal.Quotient.mkₐ A J).toLinearMap ∘ₗ Algebra.linearMap A B
    have hπ : ∀ a : A, a ∈ LinearMap.ker π ↔ algebraMap A B a ∈ J := fun a ↦ by
      rw [LinearMap.mem_ker]
      exact Ideal.Quotient.eq_zero_iff_mem
    -- `x ⊗ₜ 1` is killed by `B ⊗ π`, since `id ⊗ mk` kills the ideal generated by `1 ⊗ₜ J`.
    let ψ : B ⊗[A] B →ₐ[A] B ⊗[A] (B ⧸ J) :=
      Algebra.TensorProduct.map (AlgHom.id A B) (Ideal.Quotient.mkₐ A J)
    have hψ : J.map (Algebra.TensorProduct.includeRight : B →ₐ[A] B ⊗[A] B) ≤ RingHom.ker ψ := by
      rw [Ideal.map_le_iff_le_comap]
      intro j hj
      simp [ψ, Ideal.Quotient.eq_zero_iff_mem.mpr hj]
    have h0 : x ⊗ₜ[A] (1 : A) ∈ LinearMap.ker (AlgebraTensorModule.lTensor B B π) := by
      have := hψ hx
      rw [RingHom.mem_ker] at this
      simpa [ψ, π] using this
    rw [Module.Flat.ker_lTensor_eq B B π] at h0
    obtain ⟨t, ht⟩ := h0
    have key : ∀ t : B ⊗[A] LinearMap.ker π,
        TensorProduct.rid A B (AlgebraTensorModule.lTensor B B (LinearMap.ker π).subtype t) ∈
          (J.comap (algebraMap A B)).map (algebraMap A B) := by
      intro t
      induction t with
      | tmul b a =>
        rw [AlgebraTensorModule.lTensor_tmul, Submodule.subtype_apply, TensorProduct.rid_tmul,
          Algebra.smul_def]
        exact Ideal.mul_mem_right _ _
          (Ideal.mem_map_of_mem _ ((hπ a).mp a.2))
      | add t₁ t₂ h₁ h₂ =>
        rw [map_add, map_add]
        exact Ideal.add_mem _ h₁ h₂
    have := key t
    rwa [ht, TensorProduct.rid_tmul, one_smul] at this

/-- **Faithfully flat descent of ideals.** If `B` is faithfully flat over `A` and the two
extensions of `J ⊆ B` to `B ⊗[A] B` agree, then `J` is the extension of `J ∩ A`. -/
theorem map_comap_algebraMap_eq_self_of_faithfullyFlat [Module.FaithfullyFlat A B]
    (J : Ideal B)
    (hJ : J.map (Algebra.TensorProduct.includeLeft : B →ₐ[A] B ⊗[A] B) =
      J.map (Algebra.TensorProduct.includeRight : B →ₐ[A] B ⊗[A] B)) :
    (J.comap (algebraMap A B)).map (algebraMap A B) = J := by
  rw [map_comap_algebraMap_eq_comap_includeLeft_map_includeRight, ← hJ]
  exact Ideal.comap_map_eq_self_of_faithfullyFlat (A := B) (B := B ⊗[A] B) J

/-- Over a faithfully flat `A`-algebra `B`, an ideal `J ⊆ B` whose two extensions to
`B ⊗[A] B` agree is the extension of a unique ideal of `A`, namely `J.comap (algebraMap A B)`. -/
theorem existsUnique_map_algebraMap_eq_of_faithfullyFlat [Module.FaithfullyFlat A B]
    (J : Ideal B)
    (hJ : J.map (Algebra.TensorProduct.includeLeft : B →ₐ[A] B ⊗[A] B) =
      J.map (Algebra.TensorProduct.includeRight : B →ₐ[A] B ⊗[A] B)) :
    ∃! I : Ideal A, I.map (algebraMap A B) = J :=
  ⟨J.comap (algebraMap A B), map_comap_algebraMap_eq_self_of_faithfullyFlat J hJ,
    fun I hI ↦ by rw [← hI, Ideal.comap_map_eq_self_of_faithfullyFlat]⟩

/-- The extension to `B` of an ideal of `A` has equal extensions to `B ⊗[A] B`. -/
theorem map_includeLeft_map_algebraMap_eq_map_includeRight (I : Ideal A) :
    (I.map (algebraMap A B)).map (Algebra.TensorProduct.includeLeft : B →ₐ[A] B ⊗[A] B) =
      (I.map (algebraMap A B)).map (Algebra.TensorProduct.includeRight : B →ₐ[A] B ⊗[A] B) := by
  rw [← Ideal.map_coe (Algebra.TensorProduct.includeLeft : B →ₐ[A] B ⊗[A] B),
    ← Ideal.map_coe (Algebra.TensorProduct.includeRight : B →ₐ[A] B ⊗[A] B),
    Ideal.map_map, Ideal.map_map]
  congr 1
  ext a
  simp [algebraMap_tmul_one]

/-- Over a faithfully flat `A`-algebra `B`, an ideal of `B` is extended from `A` if and only if
its two extensions to `B ⊗[A] B` agree. -/
theorem exists_map_algebraMap_eq_iff_map_includeLeft_eq_map_includeRight
    [Module.FaithfullyFlat A B] (J : Ideal B) :
    (∃ I : Ideal A, I.map (algebraMap A B) = J) ↔
      J.map (Algebra.TensorProduct.includeLeft : B →ₐ[A] B ⊗[A] B) =
        J.map (Algebra.TensorProduct.includeRight : B →ₐ[A] B ⊗[A] B) := by
  refine ⟨?_, fun hJ ↦ ⟨_, map_comap_algebraMap_eq_self_of_faithfullyFlat J hJ⟩⟩
  rintro ⟨I, rfl⟩
  exact map_includeLeft_map_algebraMap_eq_map_includeRight I

universe u

open CategoryTheory in
/-- **Faithfully flat descent of ideals, pushout form.** Let `φ : A ⟶ B` be faithfully flat and
let `i₁ i₂ : B ⟶ C` form a pushout of `φ` along itself in `CommRingCat`. If the two extensions of
`J ⊆ B` to `C` agree, then `J` is the extension of `J.comap φ`. Only the comparison map from `C`
to `B ⊗[A] B` given by the pushout property is used. -/
theorem map_comap_eq_self_of_isPushout {A B C : CommRingCat.{u}} {φ : A ⟶ B} {i₁ i₂ : B ⟶ C}
    (hφ : φ.hom.FaithfullyFlat) (h : IsPushout φ φ i₁ i₂) (J : Ideal B)
    (hJ : J.map i₁.hom = J.map i₂.hom) :
    (J.comap φ.hom).map φ.hom = J := by
  let := φ.hom.toAlgebra
  have : Module.FaithfullyFlat A B := hφ
  refine map_comap_algebraMap_eq_self_of_faithfullyFlat J ?_
  let inl : B ⟶ CommRingCat.of (B ⊗[A] B) :=
    CommRingCat.ofHom (Algebra.TensorProduct.includeLeft : B →ₐ[A] B ⊗[A] B).toRingHom
  let inr : B ⟶ CommRingCat.of (B ⊗[A] B) :=
    CommRingCat.ofHom (Algebra.TensorProduct.includeRight : B →ₐ[A] B ⊗[A] B).toRingHom
  have w : φ ≫ inl = φ ≫ inr := by
    ext a
    exact algebraMap_tmul_one a
  have h₁ : J.map (Algebra.TensorProduct.includeLeft : B →ₐ[A] B ⊗[A] B) =
      (J.map i₁.hom).map (h.desc inl inr w).hom := by
    rw [Ideal.map_map, ← CommRingCat.hom_comp, h.inl_desc]
    rfl
  have h₂ : J.map (Algebra.TensorProduct.includeRight : B →ₐ[A] B ⊗[A] B) =
      (J.map i₂.hom).map (h.desc inl inr w).hom := by
    rw [Ideal.map_map, ← CommRingCat.hom_comp, h.inr_desc]
    rfl
  rw [h₁, h₂, hJ]

end Ideal
