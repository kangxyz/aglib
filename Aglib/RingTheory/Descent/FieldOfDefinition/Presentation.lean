module

public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
public import Mathlib.RingTheory.Extension.Presentation.Core
public import Mathlib.RingTheory.Etale.Descent

/-!
# Algebra objects over finite field stages

A finitely presented algebra over `R ⊗[K] Ω` has an actual model over
`R ⊗[K] E`, where `E` is generated by a finite subset of the extension field `Ω`.
The model includes its base-change equivalence. The construction does not require
a Noetherian base, separability, or a nontrivial base algebra.

## Extraction basis

Transferred from `R5Lab.RingTheory.Descent.FieldObjectDescent` at source revision
`95a3772b895fbc19a81684be4ffd519d0fdcd6b3`, SHA-256
`bc0258fe92647cff15d59a63bd043b5a70523ce3a8572ca44f9c2478bf6bdbe3`.
The source interface retains its objects, maps and assumptions under native
mathematical declaration namespaces.
-/

@[expose] public section

noncomputable section

open _root_.TensorProduct

section FieldOfDefinition

universe u

variable (K Ω R : Type u) [Field K] [Field Ω] [Algebra K Ω]
  [CommRing R] [Algebra K R]

/-- The intermediate field generated by the selected finite set of coefficients. -/
abbrev _root_.Algebra.Descent.FieldOfDefinition.stageField (s : Finset Ω) : IntermediateField K Ω :=
  IntermediateField.adjoin K (s : Set Ω)

/-- The tensor extension of R to the intermediate field generated by the selected coefficients. -/
abbrev _root_.Algebra.Descent.FieldOfDefinition.stageRing (s : Finset Ω) := R ⊗[K]
  Algebra.Descent.FieldOfDefinition.stageField K Ω s

/-- The actual map on coefficients: `r ⊗ e ↦ r ⊗ e.val`. -/
def _root_.Algebra.Descent.FieldOfDefinition.fieldMap (E : IntermediateField K Ω) : R ⊗[K] E
  →ₐ[R] R ⊗[K] Ω :=
  Algebra.TensorProduct.lTensor R E.val

/-- The tensor-algebra map induced by an inclusion of intermediate coefficient fields. -/
def _root_.Algebra.Descent.FieldOfDefinition.fieldTransition {E F : IntermediateField K Ω} (h :
  E ≤ F) :
    R ⊗[K] E →ₐ[R] R ⊗[K] F :=
  Algebra.TensorProduct.lTensor R (IntermediateField.inclusion h)

@[simp] theorem _root_.Algebra.Descent.FieldOfDefinition.fieldMap_transition {E F :
  IntermediateField K Ω} (h : E ≤ F)
    (x : R ⊗[K] E) :
    Algebra.Descent.FieldOfDefinition.fieldMap K Ω R F
      (Algebra.Descent.FieldOfDefinition.fieldTransition K Ω R h x) =
      Algebra.Descent.FieldOfDefinition.fieldMap K Ω R E x := by
  have H := Algebra.TensorProduct.map_id_comp (S := R) (A := R)
    F.val (IntermediateField.inclusion h)
  exact (DFunLike.congr_fun H x).symm

/-- The canonical coefficient map from the selected stage ring to R ⊗[K] Ω. -/
abbrev _root_.Algebra.Descent.FieldOfDefinition.stageMap (s : Finset Ω) :
  Algebra.Descent.FieldOfDefinition.stageRing K Ω R s →ₐ[R] R ⊗[K] Ω :=
  Algebra.Descent.FieldOfDefinition.fieldMap K Ω R (Algebra.Descent.FieldOfDefinition.stageField
    K Ω s)

instance _root_.Algebra.Descent.FieldOfDefinition.stageAlgebra (s : Finset Ω) : Algebra
  (Algebra.Descent.FieldOfDefinition.stageRing K Ω R s) (R ⊗[K] Ω) :=
  (Algebra.Descent.FieldOfDefinition.stageMap K Ω R s).toRingHom.toAlgebra

/-- The map of stage rings induced by inclusion of their finite coefficient sets. -/
def _root_.Algebra.Descent.FieldOfDefinition.transition {s t : Finset Ω} (h : s ⊆ t) :
    Algebra.Descent.FieldOfDefinition.stageRing K Ω R s →ₐ[R]
      Algebra.Descent.FieldOfDefinition.stageRing K Ω R t :=
  Algebra.Descent.FieldOfDefinition.fieldTransition K Ω R (IntermediateField.adjoin.mono K (s :
    Set Ω) (t : Set Ω)
    (Finset.coe_subset.mpr h))

@[simp] theorem _root_.Algebra.Descent.FieldOfDefinition.stageMap_transition {s t : Finset Ω} (h
  : s ⊆ t)
    (x : Algebra.Descent.FieldOfDefinition.stageRing K Ω R s) :
    Algebra.Descent.FieldOfDefinition.stageMap K Ω R t
      (Algebra.Descent.FieldOfDefinition.transition K Ω R h x) =
      Algebra.Descent.FieldOfDefinition.stageMap K Ω R s x :=
  Algebra.Descent.FieldOfDefinition.fieldMap_transition K Ω R _ x

theorem _root_.Algebra.Descent.FieldOfDefinition.range_stageMap_mono {s t : Finset Ω} (h : s ⊆ t) :
    Set.range (Algebra.Descent.FieldOfDefinition.stageMap K Ω R s) ⊆ Set.range
      (Algebra.Descent.FieldOfDefinition.stageMap K Ω R t) := by
  rintro x ⟨y, rfl⟩
  exact ⟨Algebra.Descent.FieldOfDefinition.transition K Ω R h y,
    Algebra.Descent.FieldOfDefinition.stageMap_transition K Ω R h y⟩

/-- Every tensor has finitely many field coefficients. -/
theorem _root_.Algebra.Descent.FieldOfDefinition.exists_stage_preimage (x : R ⊗[K] Ω) :
    ∃ s : Finset Ω, x ∈ Set.range (Algebra.Descent.FieldOfDefinition.stageMap K Ω R s) := by
  classical
  induction x using _root_.TensorProduct.inductionOn with
  | tmul r a =>
    refine ⟨{a}, r ⊗ₜ[K] ⟨a, ?_⟩, rfl⟩
    exact IntermediateField.subset_adjoin K _ (by simp)
  | add x y hx hy =>
    obtain ⟨s, hs⟩ := hx
    obtain ⟨t, ht⟩ := hy
    obtain ⟨x', hx'⟩ := Algebra.Descent.FieldOfDefinition.range_stageMap_mono K Ω R
      (Finset.subset_union_left) hs
    obtain ⟨y', hy'⟩ := Algebra.Descent.FieldOfDefinition.range_stageMap_mono K Ω R
      (Finset.subset_union_right) ht
    exact ⟨s ∪ t, x' + y', by simp [hx', hy']⟩

/-- A finite family of tensor coefficients lies in one actual finite-subset stage. -/
theorem _root_.Algebra.Descent.FieldOfDefinition.exists_stage_finset (T : Finset (R ⊗[K] Ω)) :
    ∃ s : Finset Ω, (T : Set (R ⊗[K] Ω)) ⊆ Set.range (Algebra.Descent.FieldOfDefinition.stageMap
      K Ω R s) := by
  classical
  induction T using Finset.induction_on with
  | empty => exact ⟨∅, by simp⟩
  | @insert x T hx hT =>
    obtain ⟨s, hs⟩ := Algebra.Descent.FieldOfDefinition.exists_stage_preimage K Ω R x
    obtain ⟨t, ht⟩ := hT
    refine ⟨s ∪ t, ?_⟩
    intro y hy
    rcases Finset.mem_insert.mp hy with rfl | hy
    · exact Algebra.Descent.FieldOfDefinition.range_stageMap_mono K Ω R Finset.subset_union_left hs
    · exact Algebra.Descent.FieldOfDefinition.range_stageMap_mono K Ω R
        Finset.subset_union_right (ht hy)

theorem _root_.Algebra.Descent.FieldOfDefinition.exists_stage_finite_set {T : Set (R ⊗[K] Ω)}
  (hT : T.Finite) :
    ∃ s : Finset Ω, T ⊆ Set.range (Algebra.Descent.FieldOfDefinition.stageMap K Ω R s) := by
  simpa using Algebra.Descent.FieldOfDefinition.exists_stage_finset K Ω R hT.toFinset

instance _root_.Algebra.Descent.FieldOfDefinition.stageField_finite [Algebra.IsAlgebraic K Ω] (s
  : Finset Ω) :
    Module.Finite K (Algebra.Descent.FieldOfDefinition.stageField K Ω s) :=
  IntermediateField.finiteDimensional_adjoin fun x _ ↦
    (Algebra.IsAlgebraic.isAlgebraic x).isIntegral

variable (B : Type u) [CommRing B] [Algebra (R ⊗[K] Ω) B]

/-- An actual finitely presented algebra model at an actual field stage. -/
structure _root_.Algebra.Descent.FieldOfDefinition.FPModel where
  /-- The selected finite set of coefficients for this algebra model. -/
  stage : Finset Ω
  /-- The model algebra over the selected coefficient stage. -/
  Model : Type u
  [commRing : CommRing Model]
  [algebra : Algebra (Algebra.Descent.FieldOfDefinition.stageRing K Ω R stage) Model]
  [finitePresentation : Algebra.FinitePresentation (Algebra.Descent.FieldOfDefinition.stageRing
    K Ω R stage) Model]
  /-- The algebra equivalence identifying the scalar extension of the model with B. -/
  equiv : (R ⊗[K] Ω) ⊗[Algebra.Descent.FieldOfDefinition.stageRing K Ω R stage] Model ≃ₐ[R ⊗[K] Ω] B

attribute [instance] Algebra.Descent.FieldOfDefinition.FPModel.commRing
  Algebra.Descent.FieldOfDefinition.FPModel.algebra
  Algebra.Descent.FieldOfDefinition.FPModel.finitePresentation

/-- Finite presentation supplies the model rather than being an object-descent premise.
The quotient model and the actual inverse maps are the pinned library's
`Algebra.Presentation.ModelOfHasCoeffs` and `tensorModelOfHasCoeffsEquiv`. -/
def _root_.Algebra.Descent.FieldOfDefinition.finitePresentationModel [Algebra.FinitePresentation
  (R ⊗[K] Ω) B] :
    Algebra.Descent.FieldOfDefinition.FPModel K Ω R B := by
  let P := Algebra.Presentation.ofFinitePresentation (R ⊗[K] Ω) B
  let s := (Algebra.Descent.FieldOfDefinition.exists_stage_finite_set K Ω R P.finite_coeffs).choose
  have hs := (Algebra.Descent.FieldOfDefinition.exists_stage_finite_set K Ω R
    P.finite_coeffs).choose_spec
  let A₀ := Algebra.Descent.FieldOfDefinition.stageRing K Ω R s
  letI : Algebra A₀ B := ((algebraMap (R ⊗[K] Ω) B).comp
    (algebraMap A₀ (R ⊗[K] Ω))).toAlgebra
  letI : IsScalarTower A₀ (R ⊗[K] Ω) B := IsScalarTower.of_algebraMap_eq' rfl
  letI : P.HasCoeffs A₀ := ⟨hs⟩
  exact
    { stage := s
      Model := P.ModelOfHasCoeffs A₀
      equiv := P.tensorModelOfHasCoeffsEquiv A₀ }

end FieldOfDefinition
