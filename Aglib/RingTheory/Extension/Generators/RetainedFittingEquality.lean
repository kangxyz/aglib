module

public import Aglib.RingTheory.Extension.Generators.RetainedRelationMinor
public import Aglib.RingTheory.Extension.Presentation.RelationMinors
public import Aglib.RingTheory.Extension.Presentation.FittingParameters

/-! # Actual retained relations preserve the evaluated Fitting ideal

The selected relations need not generate the kernel. The same coordinate matrix
supplies their membership and retained minor, while the intrinsic projection bound
supplies the opposite ideal inclusion.
-/

@[expose] public noncomputable section

open MvPolynomial

namespace Algebra.Generators

variable {R B S α β : Type*} [CommRing R] [CommRing B] [CommRing S]
  [Algebra R B] [Algebra R S] [Algebra (MvPolynomial α R) B]
  [IsScalarTower R (MvPolynomial α R) B] [Fintype α] [Fintype β]
  [DecidableEq α] [DecidableEq β]

omit [Fintype α] [Fintype β] [DecidableEq α] [DecidableEq β] in
/-- Actual selected relation minors suffice; the whole kernel need not be generated by them. -/
theorem map_fittingIdeal_absorb_eq_of_actual_relations [Finite α] [Finite β]
    (P : Generators R B (β ⊕ α))
    (ha : ∀ i, algebraMap (MvPolynomial α R) B (X i) = P.val (.inr i))
    (k : ℕ) (hk : Nat.card α ≤ k) (χ : B →ₐ[R] S)
    (f : Fin (Nat.card β - (k - Nat.card α)) → MvPolynomial (β ⊕ α) R)
    (hf : ∀ j, f j ∈ P.ker)
    (cols : Fin (Nat.card β - (k - Nat.card α)) → β)
    (hminor : Ideal.span {(Matrix.of fun j i => χ (aeval P.val
      (pderiv (.inl (cols i)) (f j)))).det} =
        (Module.fittingIdeal B (KaehlerDifferential R B) k).map χ.toRingHom) :
    (Module.fittingIdeal B (KaehlerDifferential (MvPolynomial α R) B)
      (k - Nat.card α)).map χ.toRingHom =
        (Module.fittingIdeal B (KaehlerDifferential R B) k).map χ.toRingHom := by
  classical
  let Q : Presentation R B (β ⊕ α) P.ker :=
    { P with relation := Subtype.val
             span_range_relation_eq_ker := by rw [Subtype.range_coe]; exact Ideal.span_eq _ }
  apply le_antisymm
    (Ideal.map_mono (Q.fittingIdeal_absorbPolynomialParameters_le ha k hk))
  rw [← hminor]
  apply (Ideal.span_singleton_le_iff_mem _).mpr
  have hf' (j) : parameterSubstitution (X : α → MvPolynomial α R) (f j) ∈
      (P.absorbParameters X ha).ker := by
    have h := hf j
    rw [← P.comap_ker_absorbParameters X ha] at h
    exact h
  have hm := (P.absorbParameters X ha).det_relation_pderiv_mem_fittingIdeal
    (k - Nat.card α) (fun j => parameterSubstitution (X : α → MvPolynomial α R) (f j))
    hf' cols
  have he : (Matrix.of fun j i => aeval (P.absorbParameters X ha).val
      (pderiv (cols i) (parameterSubstitution (X : α → MvPolynomial α R) (f j)))) =
      (Matrix.of fun j i => aeval P.val (pderiv (.inl (cols i)) (f j))) := by
    ext j i
    exact P.aeval_pderiv_absorbPolynomialParameters ha (f j) (cols i)
  rw [he] at hm
  have hdet : χ.toRingHom (Matrix.of (fun j i => aeval P.val
      (pderiv (.inl (cols i)) (f j)))).det =
      (Matrix.of fun j i => χ (aeval P.val (pderiv (.inl (cols i)) (f j)))).det := by
    rw [RingHom.map_det]
    apply congrArg Matrix.det
    ext i j
    rfl
  rw [← hdet]
  exact Ideal.mem_map_of_mem χ.toRingHom hm

/-- The SAME matrix and its normalized retained adjugate minor give the old evaluated
Fitting equality after projection. No new relation family or target parameters are chosen. -/
theorem map_fittingIdeal_absorb_linearChange_eq
    (P : Generators R B (β ⊕ α)) (U : Matrix (β ⊕ α) (β ⊕ α) R) (hU : IsUnit U.det)
    (ha : ∀ i, algebraMap (MvPolynomial α R) B (X i) =
      (P.linearChange U hU).val (.inr i))
    (k : ℕ) (hk : Nat.card α ≤ k) (χ : B →ₐ[R] S)
    (f : Fin (Nat.card β - (k - Nat.card α)) → P.ker)
    (cols : Fin (Nat.card β - (k - Nat.card α)) ↪ β)
    (δ h : S) (hh : IsUnit h)
    (hδ : Ideal.span {δ} =
      (Module.fittingIdeal B (KaehlerDifferential R B) k).map χ.toRingHom)
    (hnorm : ((Matrix.of (fun j i => χ (aeval P.val
        (pderiv i (f j : MvPolynomial (β ⊕ α) R)))) *
      ((algebraMap R S).mapMatrix U).adjugate).submatrix _root_.id
        (fun i => Sum.inl (cols i))).det = δ * h) :
    (Module.fittingIdeal B (KaehlerDifferential (MvPolynomial α R) B)
      (k - Nat.card α)).map χ.toRingHom =
        (Module.fittingIdeal B (KaehlerDifferential R B) k).map χ.toRingHom := by
  let c : Fin (Nat.card β - (k - Nat.card α)) ↪ β ⊕ α :=
    cols.trans ⟨Sum.inl, Sum.inl_injective⟩
  obtain ⟨hf, hm⟩ := P.retained_relation_minor U hU χ f c δ h hh hnorm
  exact (P.linearChange U hU).map_fittingIdeal_absorb_eq_of_actual_relations
    ha k hk χ (fun j => inverseLinearSubstitution U (f j : MvPolynomial (β ⊕ α) R))
    hf cols (hm.trans hδ)

end Algebra.Generators
