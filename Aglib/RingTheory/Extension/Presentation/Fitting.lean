module

public import Aglib.RingTheory.Extension.Presentation.RelationSpan
public import Aglib.RingTheory.FittingIdeal.Basic

/-! # Jacobian minors compute intrinsic Fitting ideals

The matrix uses variables as rows and all relation generators as columns.
Only the variable index is finite. No Noetherian hypothesis or finiteness of the
relation index is needed to identify the Fitting ideals of Kähler differentials.
-/

@[expose] public noncomputable section

open TensorProduct MvPolynomial

namespace Algebra.Presentation

variable {A B ι σ : Type*} [CommRing A] [CommRing B] [Algebra A B] [Finite ι]

set_option backward.isDefEq.respectTransparency false in
/-- In the actual polynomial cotangent basis, all relation derivative columns span
exactly the kernel of the canonical surjection onto Kähler differentials. -/
theorem span_relation_pderiv_eq_ker (P : Presentation A B ι σ) :
    Submodule.span B (Set.range fun j i => aeval P.val (pderiv i (P.relation j))) =
      LinearMap.ker (P.toExtension.toKaehler ∘ₗ
        P.toGenerators.cotangentSpaceBasis.equivFun.symm.toLinearMap) := by
  let e := P.toGenerators.cotangentSpaceBasis.equivFun
  have hcoord (j : σ) :
      e ((1 : B) ⊗ₜ[P.toExtension.Ring] KaehlerDifferential.D A P.toExtension.Ring (P.relation j)) =
        fun i => aeval P.val (pderiv i (P.relation j)) := by
    funext i
    exact P.toGenerators.cotangentSpaceBasis_repr_one_tmul (P.relation j) i
  have hker :
      Submodule.map e.toLinearMap (LinearMap.ker P.toExtension.toKaehler) =
        LinearMap.ker (P.toExtension.toKaehler ∘ₗ e.symm.toLinearMap) := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      change P.toExtension.toKaehler (e.symm (e y)) = 0
      simpa only [LinearEquiv.symm_apply_apply] using (LinearMap.mem_ker.mp hy)
    · intro hx
      exact ⟨e.symm x, hx, e.apply_symm_apply x⟩
  have h := congrArg (Submodule.map e.toLinearMap)
    P.span_relation_differentials_eq_ker_toKaehler
  rw [Submodule.map_span, ← Set.range_comp'] at h
  change Submodule.span B (Set.range fun j =>
    e ((1 : B) ⊗ₜ[P.toExtension.Ring]
      KaehlerDifferential.D A P.toExtension.Ring (P.relation j))) = _ at h
  simp only [hcoord] at h
  exact h.trans hker

set_option backward.isDefEq.respectTransparency false in
/-- The intrinsic `k`-th Fitting ideal of Kähler differentials is generated by the
`(number of variables - k)` minors of the full evaluated relation-derivative matrix. -/
theorem fittingIdeal_kaehler_eq_minorIdeal (P : Presentation A B ι σ) (k : ℕ) :
    Module.fittingIdeal B (KaehlerDifferential A B) k =
      (Matrix.of fun i j => aeval P.val (pderiv i (P.relation j))).minorIdeal
        (Nat.card ι - k) := by
  let f := P.toExtension.toKaehler ∘ₗ
    P.toGenerators.cotangentSpaceBasis.equivFun.symm.toLinearMap
  have hf : Function.Surjective f :=
    P.toExtension.toKaehler_surjective.comp
      P.toGenerators.cotangentSpaceBasis.equivFun.symm.surjective
  apply Module.fittingIdeal_eq_minorIdeal hf
  exact P.span_relation_pderiv_eq_ker

end Algebra.Presentation
