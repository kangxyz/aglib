module

public import Aglib.RingTheory.PlaneNode.Basic
public import Aglib.RingTheory.DiscreteValuationRing.UniformizerResidue
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
Native extraction from the R5 local-model source
`PointedResolution.EtaleNode.CommonChart`.
R5 revision: `f8a3314ddecffcada2ec721d26d56a937bed9690`.
Source SHA-256:
`fde7e4ab022c6077b626d4b418d07d7024d1d49239d091f10ab72a0cbec327ca`.
Exact original local residue map and its coordinate-centre kernel/span; no Noetherian or local
  structure on an auxiliary coefficient algebra. Surjectivity proof also comes from
  CommonCenters64–72.
Conditional blowup families remain explicit inputs.
-/

@[expose] public section

noncomputable section
set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open IsLocalRing
universe u

namespace PlaneNode
variable {R : Type u} [CommRing R] [IsLocalRing R]

/-- The `R`-algebra map from the node ring to the residue field sending both node
coordinates to zero, defined when `c` has zero residue. -/
def residueMap (c : R) (hc : residue R c = 0) : PlaneNode.Ring c →ₐ[R] ResidueField R :=
  PlaneNode.lift c 0 0 (by simp [ResidueField.algebraMap_eq, hc])

/-- The ideal generated by the extended base maximal ideal and the node coordinates
`U` and `V`; when `c` has zero residue, this is the kernel of `residueMap`. -/
def residueCenter (c : R) : Ideal (PlaneNode.Ring c) :=
  Ideal.map (algebraMap R (PlaneNode.Ring c)) (maximalIdeal R) ⊔
    Ideal.span {PlaneNode.U c, PlaneNode.V c}

theorem residueCenter_eq_ker (c : R) (hc : residue R c = 0) :
    residueCenter c = RingHom.ker (residueMap c hc).toRingHom := by
  let I := residueCenter c
  let Q := PlaneNode.Ring c ⧸ I
  let q : PlaneNode.Ring c →ₐ[R] Q := Ideal.Quotient.mkₐ R I
  let p := residueMap c hc
  have hz (r : R) (hr : r ∈ maximalIdeal R) : algebraMap R Q r = 0 := by
    exact Ideal.Quotient.eq_zero_iff_mem.mpr
      (show algebraMap R (PlaneNode.Ring c) r ∈ I from
        Ideal.mem_sup_left (Ideal.mem_map_of_mem _ hr))
  let j : ResidueField R →ₐ[R] Q :=
    Ideal.Quotient.liftₐ (maximalIdeal R) (Algebra.ofId R Q) hz
  have hqu : q (PlaneNode.U c) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_sup_right (Ideal.subset_span (by simp)))
  have hqv : q (PlaneNode.V c) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_sup_right (Ideal.subset_span (by simp)))
  have hmaps : q = j.comp p := by
    apply PlaneNode.hom_ext <;> simp only [AlgHom.comp_apply, p, residueMap,
      PlaneNode.lift_U, PlaneNode.lift_V, map_zero, hqu, hqv]
  have hle : I ≤ RingHom.ker p.toRingHom := by
    refine sup_le ?_ (Ideal.span_le.mpr ?_)
    · rw [Ideal.map_le_iff_le_comap]
      intro r hr
      change p (algebraMap R (PlaneNode.Ring c) r) = 0
      rw [p.commutes, ResidueField.algebraMap_eq]
      exact (residue_eq_zero_iff r).mpr hr
    · intro z hz
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
      rcases hz with hz | hz
      · rw [hz]
        exact PlaneNode.lift_U c 0 0 _
      · rw [hz]
        exact PlaneNode.lift_V c 0 0 _
  refine le_antisymm hle ?_
  intro z hz
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  change q z = 0
  change p z = 0 at hz
  rw [hmaps, AlgHom.comp_apply, hz, map_zero]

theorem residueCenter_eq_uniformizer_span {R : Type u} [CommRing R] [IsDomain R]
    [IsDiscreteValuationRing R]
    (c π : R) (hπ : Irreducible π) :
    residueCenter c = Ideal.span {algebraMap R (PlaneNode.Ring c) π, PlaneNode.U c, PlaneNode.V c}
      := by
  rw [residueCenter, (IsDiscreteValuationRing.irreducible_iff_uniformizer π).mp hπ,
    Ideal.map_span, Set.image_singleton, ← Ideal.span_union]
  congr 1

lemma residueMap_surjective (c : R) (hc : residue R c = 0) :
    Function.Surjective (residueMap c hc).toRingHom := by
  intro z
  obtain ⟨r, hr⟩ := residue_surjective (R := R) z
  refine ⟨algebraMap R (PlaneNode.Ring c) r, ?_⟩
  change residueMap c hc (algebraMap R (PlaneNode.Ring c) r) = z
  simpa only [AlgHom.commutes, ResidueField.algebraMap_eq] using hr


end PlaneNode
