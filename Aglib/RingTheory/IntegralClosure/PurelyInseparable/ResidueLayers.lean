/-!
# Residue layers of a purely inseparable normalization

The order filtration is the inverse image of the actual principal ideals
`z^j T`, where `T` is the normalization of a prime localization. One
denominator clears each whole layer. Dividing by `z^j` and taking the
residue then embeds the successive quotient into the literal normalization
of the prime quotient in the local residue field.

For a complete Noetherian normal local domain and a finite purely
inseparable extension of its fraction field, when the prime quotient has
dimension at most one and the prime localization is a DVR, every such
successive quotient is finite. The finite filtration proves that the image
of the global normalization in `T/xT` is finite for each nonzero coefficient
`x`. Neither normalization is assumed finite over its coefficient ring.
-/

@[expose] public noncomputable section

open scoped Pointwise nonZeroDivisors

namespace integralClosure

section Order

variable {R : Type*} [CommRing R] (p : Ideal R) [p.IsPrime]
  (E : Type*) [Field E] [Algebra R E]
  [Algebra (Localization.AtPrime p) E] [IsScalarTower R (Localization.AtPrime p) E]

local notation "A" => Localization.AtPrime p
local notation "S" => integralClosure R E
local notation "T" => integralClosure A E

/-- The actual inclusion of the global normalization into the normalization
of the prime localization, inside the original ambient field. -/
def toAtPrimeNormalization : S →ₐ[R] T where
  toFun b := ⟨b, b.property.tower_top⟩
  map_zero' := Subtype.ext rfl
  map_one' := Subtype.ext rfl
  map_add' _ _ := Subtype.ext rfl
  map_mul' _ _ := Subtype.ext rfl
  commutes' _ := Subtype.ext rfl

@[simp]
theorem coe_toAtPrimeNormalization (b : S) :
    (toAtPrimeNormalization p E b : E) = (b : E) := rfl

/-- The elements of the global normalization whose local images belong to
the actual principal ideal generated by the `j`-th power of `z`. -/
def atPrimeOrder (z : S) (j : ℕ) : Submodule R S :=
  ((Ideal.span {(toAtPrimeNormalization p E z) ^ j}).restrictScalars R).comap
    (toAtPrimeNormalization p E).toLinearMap

@[simp]
theorem mem_atPrimeOrder (z b : S) (j : ℕ) :
    b ∈ atPrimeOrder p E z j ↔
      (toAtPrimeNormalization p E z) ^ j ∣ toAtPrimeNormalization p E b := by
  change _ ∈ Ideal.span {_} ↔ _
  exact Ideal.mem_span_singleton

theorem atPrimeOrder_succ_le (z : S) (j : ℕ) :
    atPrimeOrder p E z (j + 1) ≤ atPrimeOrder p E z j := by
  intro b hb
  rw [mem_atPrimeOrder] at hb ⊢
  exact (pow_dvd_pow _ (Nat.le_succ j)).trans hb

@[simp]
theorem atPrimeOrder_zero (z : S) : atPrimeOrder p E z 0 = ⊤ := by
  ext b
  simp only [mem_atPrimeOrder, pow_zero, one_dvd, Submodule.mem_top]

/-- The order condition is exactly integrality of the actual divided
element over the prime localization. -/
theorem mem_atPrimeOrder_iff_div_mem (z b : S) (hz : (z : E) ≠ 0) (j : ℕ) :
    b ∈ atPrimeOrder p E z j ↔ (b : E) / (z : E) ^ j ∈ T := by
  rw [mem_atPrimeOrder]
  constructor
  · rintro ⟨t, ht⟩
    have heq : (b : E) = (z : E) ^ j * (t : E) := congrArg Subtype.val ht
    have hdiv : (b : E) / (z : E) ^ j = (t : E) := by
      rw [heq]
      field_simp [hz]
    exact hdiv.symm ▸ t.property
  · intro ht
    refine ⟨⟨_, ht⟩, ?_⟩
    apply Subtype.ext
    change (b : E) = (z : E) ^ j * ((b : E) / (z : E) ^ j)
    field_simp [hz]

/-- Division by the fixed global numerator, with values in the actual
local normalization. -/
def atPrimeOrderDivide (z : S) (hz : (z : E) ≠ 0) (j : ℕ) :
    atPrimeOrder p E z j →ₗ[R] T where
  toFun b := ⟨(b.1 : E) / (z : E) ^ j,
    (mem_atPrimeOrder_iff_div_mem p E z b.1 hz j).mp b.2⟩
  map_add' b b' := Subtype.ext (add_div _ _ _)
  map_smul' r b := by
    apply Subtype.ext
    simp only [RingHom.id_apply, Submodule.coe_smul, Algebra.smul_def,
      Subalgebra.coe_mul, Subalgebra.coe_algebraMap, mul_div_assoc]

@[simp]
theorem coe_atPrimeOrderDivide (z : S) (hz : (z : E) ≠ 0) (j : ℕ)
    (b : atPrimeOrder p E z j) :
    (atPrimeOrderDivide p E z hz j b : E) = (b.1 : E) / (z : E) ^ j := rfl

private theorem coefficient_isUnit (c : R) (hc : c ∉ p) : IsUnit (algebraMap R T c) := by
  rw [IsScalarTower.algebraMap_apply R A T]
  exact (IsLocalization.map_units A (⟨c, hc⟩ : p.primeCompl)).map (algebraMap A T)

/-- A uniformizer in the local normalization can be multiplied by one
coefficient outside the prime to obtain a global integral uniformizer. -/
theorem exists_global_uniformizer [IsDiscreteValuationRing T] :
    ∃ z : S, Irreducible (toAtPrimeNormalization p E z) := by
  obtain ⟨t, ht⟩ := IsDiscreteValuationRing.exists_irreducible T
  obtain ⟨c, hc⟩ := IsIntegral.exists_multiple_integral_of_isLocalization
    (Rₘ := A) p.primeCompl (t : E) t.property
  let z : S := ⟨c • (t : E), hc⟩
  have heq : toAtPrimeNormalization p E z = algebraMap R T c * t := by
    apply Subtype.ext
    change c • (t : E) = algebraMap R E c * (t : E)
    rw [Submonoid.smul_def, Algebra.smul_def]
  refine ⟨z, ?_⟩
  rw [heq]
  exact (irreducible_isUnit_mul (coefficient_isUnit p E c c.property)).mpr ht

/-- The original normalization mapped to the quotient of its actual local
normalization by one specified element. -/
def toAtPrimeQuotient (t : T) : S →ₐ[R] T ⧸ Ideal.span {t} :=
  (Ideal.Quotient.mkₐ R (Ideal.span {t})).comp (toAtPrimeNormalization p E)

@[simp]
theorem toAtPrimeQuotient_apply (t : T) (b : S) :
    toAtPrimeQuotient p E t b =
      Ideal.Quotient.mk (Ideal.span {t}) (toAtPrimeNormalization p E b) := rfl

theorem ker_toAtPrimeQuotient_pow (z : S) (j : ℕ) :
    LinearMap.ker (toAtPrimeQuotient p E ((toAtPrimeNormalization p E z) ^ j)).toLinearMap =
      atPrimeOrder p E z j := by
  ext b
  change Ideal.Quotient.mk _ (toAtPrimeNormalization p E b) = 0 ↔
    toAtPrimeNormalization p E b ∈ Ideal.span {_}
  exact Ideal.Quotient.eq_zero_iff_mem

end Order

section Denominator

variable {R : Type*} [CommRing R] [IsDomain R] [IsNoetherianRing R]
  [IsIntegrallyClosed R] (p : Ideal R) [p.IsPrime]
  (K E : Type*) [Field K] [Algebra R K] [IsFractionRing R K]
  [Algebra (Localization.AtPrime p) K] [IsFractionRing (Localization.AtPrime p) K]
  [Field E] [Algebra R E] [Algebra K E] [IsScalarTower R K E]
  [Algebra (Localization.AtPrime p) E] [IsScalarTower R (Localization.AtPrime p) E]
  [IsScalarTower (Localization.AtPrime p) K E]

local notation "A" => Localization.AtPrime p
local notation "S" => integralClosure R E
local notation "T" => integralClosure A E

local instance : IsIntegrallyClosed A :=
  isIntegrallyClosed_of_isLocalization A p.primeCompl p.primeCompl_le_nonZeroDivisors

/-- A single coefficient outside the prime clears every element of a fixed
order layer after division by the global numerator. The proof clears the
finitely generated contraction of `(a^j)`, where `a = z^q` in the base. -/
theorem exists_order_denominator (q : ℕ) (hq : 0 < q)
    (hpower : ∀ u : E, u ^ q ∈ (algebraMap K E).range)
    (z : S) (hz : (z : E) ≠ 0) (j : ℕ) :
    ∃ c : R, c ∉ p ∧ ∀ b : S, b ∈ atPrimeOrder p E z j →
      algebraMap R E c * (b : E) / (z : E) ^ j ∈ S := by
  obtain ⟨a, ha⟩ :=
    (mem_iff_pow_mem_range R K E (z : E) q hq (hpower z)).mp z.property
  let I : Ideal R := Ideal.span {a ^ j}
  let J : Ideal R := (I.map (algebraMap R A)).comap (algebraMap R A)
  obtain ⟨c, hc, hclear⟩ := Ideal.exists_mul_mem_of_map_le_atPrime p J I
    (IsNoetherian.noetherian J) Ideal.map_comap_le
  refine ⟨c, hc, ?_⟩
  intro b hb
  have hdiv := (mem_atPrimeOrder_iff_div_mem p E z b hz j).mp hb
  obtain ⟨r, hr⟩ :=
    (mem_iff_pow_mem_range R K E (b : E) q hq (hpower b)).mp b.property
  obtain ⟨v, hv⟩ :=
    (mem_iff_pow_mem_range A K E _ q hq (hpower _)).mp hdiv
  have hpowers : algebraMap R E (a ^ j) = ((z : E) ^ j) ^ q := by
    rw [map_pow, ha, ← pow_mul, ← pow_mul, Nat.mul_comm q j]
  have hinj : Function.Injective (algebraMap A E) := by
    rw [IsScalarTower.algebraMap_eq A K E]
    exact (RingHom.injective (algebraMap K E)).comp (IsFractionRing.injective A K)
  have hrJ : r ∈ J := by
    change algebraMap R A r ∈ (Ideal.span {a ^ j}).map (algebraMap R A)
    rw [Ideal.map_span, Set.image_singleton, Ideal.mem_span_singleton]
    refine ⟨v, hinj ?_⟩
    rw [map_mul, ← IsScalarTower.algebraMap_apply R A E,
      ← IsScalarTower.algebraMap_apply R A E, hr, hpowers, hv, div_pow]
    field_simp [hz]
  obtain ⟨d, hd⟩ := Ideal.mem_span_singleton.mp (hclear r hrJ)
  have hproduct : algebraMap R E c * (b : E) ^ q =
      ((z : E) ^ j) ^ q * algebraMap R E d := by
    have h := congrArg (algebraMap R E) hd
    simpa only [map_mul, hr, hpowers] using h
  have hcpow : algebraMap R E c ^ q =
      algebraMap R E c ^ (q - 1) * algebraMap R E c := by
    rw [← pow_succ, Nat.sub_add_cancel hq]
  have hscaled : (algebraMap R E c * (b : E) / (z : E) ^ j) ^ q =
      algebraMap R E (c ^ (q - 1) * d) := by
    rw [div_pow, mul_pow, map_mul, map_pow]
    apply (div_eq_iff (pow_ne_zero q (pow_ne_zero j hz))).mpr
    rw [hcpow, mul_assoc, hproduct]
    ring
  change IsIntegral R _
  apply IsIntegral.of_pow hq
  rw [hscaled]
  exact isIntegral_algebraMap

end Denominator

section Residue

variable {R : Type*} [CommRing R] (p : Ideal R) [p.IsPrime]
  (E : Type*) [Field E] [Algebra R E]
  [Algebra (Localization.AtPrime p) E] [IsScalarTower R (Localization.AtPrime p) E]
  [IsLocalRing (integralClosure (Localization.AtPrime p) E)]
  [IsLocalHom (algebraMap (Localization.AtPrime p)
    (integralClosure (Localization.AtPrime p) E))]

local notation "A" => Localization.AtPrime p
local notation "S" => integralClosure R E
local notation "T" => integralClosure A E
local notation "C" => R ⧸ p
local notation "ℓ" => IsLocalRing.ResidueField T

/-- The actual coefficient algebra on the local residue field, factored
through the prime quotient by its canonical quotient map. -/
@[instance_reducible]
def atPrimeResidueQuotientAlgebra : Algebra C ℓ :=
  (Ideal.Quotient.lift p (algebraMap R ℓ) fun r hr ↦ by
    rw [IsScalarTower.algebraMap_apply R A ℓ,
      IsScalarTower.algebraMap_apply A T ℓ,
      IsLocalRing.ResidueField.algebraMap_eq, IsLocalRing.residue_eq_zero_iff]
    exact _root_.map_nonunit (algebraMap A T) _
      ((IsLocalization.AtPrime.to_map_mem_maximal_iff A p r).mpr hr)).toAlgebra

attribute [local instance] atPrimeResidueQuotientAlgebra

instance atPrimeResidueQuotientTower : IsScalarTower R C ℓ :=
  IsScalarTower.of_algebraMap_eq fun _ ↦ rfl

@[simp]
theorem atPrimeResidueQuotientAlgebra_mk (r : R) :
    algebraMap C ℓ (Ideal.Quotient.mk p r) = algebraMap R ℓ r := rfl

end Residue

section LayerMap

variable {R : Type*} [CommRing R] [IsDomain R] [IsNoetherianRing R]
  [IsIntegrallyClosed R] (p : Ideal R) [p.IsPrime]
  (K E : Type*) [Field K] [Algebra R K] [IsFractionRing R K]
  [Algebra (Localization.AtPrime p) K] [IsFractionRing (Localization.AtPrime p) K]
  [Field E] [Algebra R E] [Algebra K E] [IsScalarTower R K E]
  [Algebra (Localization.AtPrime p) E] [IsScalarTower R (Localization.AtPrime p) E]
  [IsScalarTower (Localization.AtPrime p) K E]
  [IsDiscreteValuationRing (integralClosure (Localization.AtPrime p) E)]
  [IsLocalHom (algebraMap (Localization.AtPrime p)
    (integralClosure (Localization.AtPrime p) E))]

local notation "Rₚ" => Localization.AtPrime p
local notation "S" => integralClosure R E
local notation "T" => integralClosure Rₚ E
local notation "C" => R ⧸ p
local notation "ℓ" => IsLocalRing.ResidueField T

attribute [local instance] atPrimeResidueQuotientAlgebra

/-- Each order layer admits an actual scaled residue map into the literal
normalization of the prime quotient. Its kernel is precisely the next
order layer. The denominator depends only on the order, not on the element. -/
theorem exists_residueLayerMap (q : ℕ) (hq : 0 < q)
    (hpower : ∀ u : E, u ^ q ∈ (algebraMap K E).range)
    (z : S) (hz : Irreducible (toAtPrimeNormalization p E z)) (j : ℕ) :
    ∃ c : R, c ∉ p ∧ ∃ f : atPrimeOrder p E z j →ₗ[R] integralClosure C ℓ,
      (∀ b, (f b : ℓ) = IsLocalRing.residue T
        (c • atPrimeOrderDivide p E z
          (fun h ↦ hz.ne_zero (Subtype.ext h)) j b)) ∧
      LinearMap.ker f = (atPrimeOrder p E z (j + 1)).comap
        (atPrimeOrder p E z j).subtype := by
  let hz0 : (z : E) ≠ 0 := fun h ↦ hz.ne_zero (Subtype.ext h)
  obtain ⟨c, hc, hclear⟩ := exists_order_denominator p K E q hq hpower z hz0 j
  let d := atPrimeOrderDivide p E z hz0 j
  let g : atPrimeOrder p E z j →ₗ[R] ℓ :=
    ((Algebra.linearMap T ℓ).restrictScalars R).comp (c • d)
  have hg : ∀ b, g b ∈ integralClosure C ℓ := by
    intro b
    have hb := hclear b.1 b.2
    have hint : IsIntegral R (c • d b) := by
      apply (isIntegral_algebraMap_iff (R := R) (A := T) (B := E)).mp
      change IsIntegral R ((c • atPrimeOrderDivide p E z hz0 j b : T) : E)
      rw [Subalgebra.coe_smul, coe_atPrimeOrderDivide, Algebra.smul_def]
      simpa only [mem_integralClosure_iff, mul_div_assoc] using hb
    exact (hint.map (IsScalarTower.toAlgHom R T ℓ)).tower_top
  let f : atPrimeOrder p E z j →ₗ[R] integralClosure C ℓ :=
    { toFun := fun b ↦ ⟨g b, hg b⟩
      map_add' := fun b b' ↦ Subtype.ext (map_add g b b')
      map_smul' := fun r b ↦ Subtype.ext (map_smul g r b) }
  refine ⟨c, hc, f, fun _ ↦ rfl, ?_⟩
  ext b
  change f b = 0 ↔ b.1 ∈ atPrimeOrder p E z (j + 1)
  rw [Subtype.ext_iff]
  change IsLocalRing.residue T (c • d b) = 0 ↔ _
  rw [IsLocalRing.residue_eq_zero_iff, Algebra.smul_def,
    Ideal.unit_mul_mem_iff_mem _ (coefficient_isUnit p E c hc),
    hz.maximalIdeal_eq, Ideal.mem_span_singleton, mem_atPrimeOrder]
  have hd : toAtPrimeNormalization p E b.1 =
      (toAtPrimeNormalization p E z) ^ j * d b := by
    apply Subtype.ext
    change (b.1 : E) = (z : E) ^ j * ((b.1 : E) / (z : E) ^ j)
    field_simp [hz0]
  rw [hd, pow_succ, mul_dvd_mul_iff_left (pow_ne_zero j hz.ne_zero)]

end LayerMap

section Complete

variable {R : Type*} [CommRing R] [IsDomain R] [IsNoetherianRing R]
  [IsIntegrallyClosed R] [IsLocalRing R]
  [IsAdicComplete (IsLocalRing.maximalIdeal R) R]
  (p : Ideal R) [p.IsPrime] [Ring.KrullDimLE 1 (R ⧸ p)]
  [IsDiscreteValuationRing (Localization.AtPrime p)]
  (K E : Type*) [Field K] [Algebra R K] [IsFractionRing R K]
  [Algebra (Localization.AtPrime p) K] [IsFractionRing (Localization.AtPrime p) K]
  [Field E] [Algebra R E] [Algebra K E] [IsScalarTower R K E]
  [Algebra (Localization.AtPrime p) E] [IsScalarTower R (Localization.AtPrime p) E]
  [IsScalarTower (Localization.AtPrime p) K E]
  [FiniteDimensional K E] [IsPurelyInseparable K E]

local notation "A" => Localization.AtPrime p
local notation "S" => integralClosure R E
local notation "T" => integralClosure A E
local notation "C" => R ⧸ p

local notation "ℓ" => IsLocalRing.ResidueField T

attribute [local instance] atPrimeResidueQuotientAlgebra

include K in
omit [IsIntegrallyClosed R] [Algebra R K] [IsFractionRing R K] [IsScalarTower R K E] in
/-- The normalization of the actual prime quotient in the actual local
residue field is finite over the original complete ring. -/
theorem finite_atPrimeResidueNormalization :
    let _ : IsDiscreteValuationRing T := isDiscreteValuationRing_of_isPurelyInseparable A K E
    let _ : IsLocalHom (algebraMap A T) := algebraMap_isLocalHom A K E
    Module.Finite R (integralClosure C ℓ) := by
  let : IsDiscreteValuationRing T := isDiscreteValuationRing_of_isPurelyInseparable A K E
  let : IsLocalHom (algebraMap A T) := algebraMap_isLocalHom A K E
  change Module.Finite R (integralClosure C ℓ)
  let : IsNoetherianRing C := isNoetherianRing_of_surjective R C
    (Ideal.Quotient.mk p) Ideal.Quotient.mk_surjective
  let : IsLocalRing C := IsLocalRing.of_surjective' (Ideal.Quotient.mk p)
    Ideal.Quotient.mk_surjective
  let : IsAdicComplete (IsLocalRing.maximalIdeal C) C := by
    have h := IsAdicComplete.map_algebraMap_of_finite R (IsLocalRing.maximalIdeal R) C
    rwa [IsLocalRing.map_maximalIdeal_of_surjective
      (algebraMap R C) Ideal.Quotient.mk_surjective] at h
  let : Algebra p.ResidueField ℓ := purelyInseparableResidueAlgebra A K E
  let : IsScalarTower C p.ResidueField ℓ := by
    apply IsScalarTower.of_algebraMap_eq
    intro x
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
    change algebraMap R ℓ r =
      algebraMap p.ResidueField ℓ (algebraMap R p.ResidueField r)
    exact IsScalarTower.algebraMap_apply R p.ResidueField ℓ r
  let : Module.Finite p.ResidueField ℓ := finite_residueField_of_isPurelyInseparable A K E
  let : Module.Finite C (integralClosure C ℓ) :=
    finite_of_complete_local_dimLE_one C p.ResidueField ℓ
  exact Module.Finite.trans C (integralClosure C ℓ)

include K in
/-- Every successive order quotient is finite over the complete base ring.
This follows from its injection into the actual finite curve normalization;
it does not require either ambient normalization to be a finite module. -/
theorem finite_atPrimeOrder_layer (z : S)
    (hz : Irreducible (toAtPrimeNormalization p E z)) (j : ℕ) :
    Module.Finite R
      (atPrimeOrder p E z j ⧸ (atPrimeOrder p E z (j + 1)).comap
        (atPrimeOrder p E z j).subtype) := by
  let : IsDiscreteValuationRing T := isDiscreteValuationRing_of_isPurelyInseparable A K E
  let : IsLocalHom (algebraMap A T) := algebraMap_isLocalHom A K E
  obtain ⟨e, he⟩ := (inferInstance : IsPurelyInseparable.HasExponent K E).has_exponent
  have hq : 0 < ringExpChar K ^ e := by
    apply pow_pos
    unfold ringExpChar
    exact lt_of_lt_of_le Nat.zero_lt_one (le_max_right _ _)
  obtain ⟨c, hc, f, hf, hker⟩ := exists_residueLayerMap p K E _ hq he z hz j
  let : Module.Finite R (integralClosure C ℓ) := finite_atPrimeResidueNormalization p K E
  have hfinite : (LinearMap.ker f).CoFG := Submodule.CoFG.ker f
  simpa only [hker] using hfinite

include K in
/-- A finite initial segment of the actual order filtration has finite
quotient over the complete base. -/
theorem finite_quotient_atPrimeOrder (z : S)
    (hz : Irreducible (toAtPrimeNormalization p E z)) (n : ℕ) :
    Module.Finite R (S ⧸ atPrimeOrder p E z n) := by
  induction n with
  | zero =>
      rw [atPrimeOrder_zero]
      infer_instance
  | succ n ih =>
      let H := atPrimeOrder p E z n
      let H' := atPrimeOrder p E z (n + 1)
      let J := H'.comap H.subtype
      let f₀ : H →ₗ[R] S ⧸ H' := H'.mkQ.comp H.subtype
      have hker : J ≤ LinearMap.ker f₀ := by
        intro b hb
        exact (Submodule.Quotient.mk_eq_zero H').mpr hb
      let f : H ⧸ J →ₗ[R] S ⧸ H' := J.liftQ f₀ hker
      let g : S ⧸ H' →ₗ[R] S ⧸ H :=
        Submodule.factor (atPrimeOrder_succ_le p E z n)
      have hexact : LinearMap.range f = LinearMap.ker g := by
        ext y
        constructor
        · rintro ⟨v, rfl⟩
          induction v using Submodule.Quotient.induction_on with
          | _ b =>
              change (Submodule.Quotient.mk b.1 : S ⧸ H) = 0
              exact (Submodule.Quotient.mk_eq_zero H).mpr b.2
        · intro hy
          obtain ⟨b, rfl⟩ := H'.mkQ_surjective y
          have hb : b ∈ H := (Submodule.Quotient.mk_eq_zero H).mp hy
          exact ⟨Submodule.Quotient.mk (⟨b, hb⟩ : H), rfl⟩
      let : Module.Finite R (H ⧸ J) := finite_atPrimeOrder_layer p K E z hz n
      let : Module.Finite R (S ⧸ H) := ih
      let : IsNoetherian R (S ⧸ H') := isNoetherian_of_range_eq_ker f g hexact
      exact inferInstance

include K in
/-- The image of the global normalization in the actual local quotient by
any nonzero local element is finite. The ambient local quotient itself is
not asserted finite over the original ring. -/
theorem finite_range_toAtPrimeQuotient (t : T) (ht : t ≠ 0) :
    Module.Finite R (LinearMap.range (toAtPrimeQuotient p E t).toLinearMap) := by
  let : IsDiscreteValuationRing T := isDiscreteValuationRing_of_isPurelyInseparable A K E
  obtain ⟨z, hz⟩ := exists_global_uniformizer p E
  obtain ⟨n, u, hu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible ht hz
  have hspan : Ideal.span {t} = Ideal.span {(toAtPrimeNormalization p E z) ^ n} := by
    rw [hu, Ideal.span_singleton_mul_left_unit u.isUnit]
  let f := (toAtPrimeQuotient p E t).toLinearMap
  have hker : LinearMap.ker f = atPrimeOrder p E z n := by
    ext b
    change Ideal.Quotient.mk (Ideal.span {t}) (toAtPrimeNormalization p E b) = 0 ↔
      toAtPrimeNormalization p E b ∈ Ideal.span {(toAtPrimeNormalization p E z) ^ n}
    rw [Ideal.Quotient.eq_zero_iff_mem, hspan]
  let : Module.Finite R (S ⧸ LinearMap.ker f) := by
    rw [hker]
    exact finite_quotient_atPrimeOrder p K E z hz n
  exact Module.Finite.equiv f.quotKerEquivRange

include K in
/-- For a nonzero coefficient `x`, the literal image `S → T/xT` is finite
over the complete base, with the original localization and quotient maps. -/
theorem finite_range_toAtPrimeQuotient_algebraMap (x : R) (hx : x ≠ 0) :
    Module.Finite R
      (LinearMap.range (toAtPrimeQuotient p E (algebraMap R T x)).toLinearMap) := by
  apply finite_range_toAtPrimeQuotient p K E
  intro h
  have hzero : algebraMap R E x = 0 := congrArg Subtype.val h
  rw [IsScalarTower.algebraMap_apply R K E] at hzero
  apply hx
  apply IsFractionRing.injective R K
  apply RingHom.injective (algebraMap K E)
  simpa only [map_zero] using hzero

end Complete

end integralClosure
