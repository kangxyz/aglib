/-!
# Descent of integral closedness along a faithfully flat map of domains

Let `S` be a faithfully flat algebra over a domain `R`, with `S` itself a
normal domain. An element of `Frac(R)` integral over `R` maps to an integral
element of `Frac(S)`, hence to an element of `S`. Writing the original element
as `a / b`, this says that the image of `a` belongs to the ideal generated by
the image of `b`. Faithfully flat ideal contraction gives `a ∈ (b)` in `R`,
which puts the original fraction in `R`.

## Source correspondence

Auxiliary local algebra for `K2-018#lem:k2018-residue-bockstein`, lines 308–339,
and `K2-018#prop:k2018-arithmetic-characters`, lines 341–445, in
`research/exposes/K2/018/expose.tex` at revision
`e73d98b1b5c1e5abcdebf7d058e436d792b87982`, source SHA-256
`e716cfb3c6eaba82370c5b46b806df5705ad4583df0ed41b1a576e419f3bd299`.
The current consumer is the actual smooth-curve stalk normality theorem in
`R5Lab.AlgebraicGeometry.LocalRing.SmoothNormal`. This module proves only the
stated general algebraic descent result, not either complete source claim.

Implementation basis: `017f90ba7298909cb4b1e928e2f38042a08ebf4f`;
Lean `4.34.1`, mathlib `d13f23b723b8a846827a245b89c10fc7d3f11612`.

## Extraction basis

Transferred from `R5Lab.RingTheory.IntegralClosure.FaithfullyFlat` at source revision
`95a3772b895fbc19a81684be4ffd519d0fdcd6b3`, SHA-256
`4572e8c667c8fbe37f07d5061ac10949cc0151e3e0e860f04c7f12d6ee16fbff`.
The source interface retains its objects, maps and assumptions under native
mathematical declaration namespaces.
-/

@[expose] public section

noncomputable section
namespace IsIntegrallyClosed

/-- Auxiliary local algebra for the two `K2-018` locators and source snapshot above:
integral closedness descends along a faithfully flat algebra map between domains.
The proof contracts principal ideals; integral closedness of the source is the conclusion. -/
lemma isIntegrallyClosed_of_faithfullyFlat (R S : Type*)
    [CommRing R] [IsDomain R] [CommRing S] [IsDomain S]
    [Algebra R S] [Module.FaithfullyFlat R S] [IsIntegrallyClosed S] :
    IsIntegrallyClosed R := by
  let K := FractionRing R
  let L := FractionRing S
  have hinj : Function.Injective (algebraMap R L) :=
    (IsFractionRing.injective S L).comp (FaithfulSMul.algebraMap_injective R S)
  let i : K →ₐ[R] L := IsFractionRing.liftAlgHom (g := Algebra.ofId R L) hinj
  apply (isIntegrallyClosed_iff K).mpr
  intro x hx
  obtain ⟨a, b, hb, hab⟩ := IsFractionRing.div_surjective R x
  have hbK : algebraMap R K b ≠ 0 :=
    IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hb
  have hbL : algebraMap R L b ≠ 0 := by
    rw [← i.commutes b]
    exact (map_ne_zero i).mpr hbK
  have hint : IsIntegral S (i x) := (hx.map i).tower_top
  obtain ⟨c, hc⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hint
  have he : algebraMap R S a = algebraMap R S b * c := by
    apply IsFractionRing.injective S L
    rw [map_mul, ← IsScalarTower.algebraMap_apply R S L,
      ← IsScalarTower.algebraMap_apply R S L, hc, ← hab, map_div₀, i.commutes, i.commutes]
    exact (mul_div_cancel₀ _ hbL).symm
  have ha : a ∈ Ideal.span {b} := by
    rw [← Ideal.comap_map_eq_self_of_faithfullyFlat (B := S) (Ideal.span {b})]
    change algebraMap R S a ∈ (Ideal.span {b}).map (algebraMap R S)
    rw [Ideal.map_span, Set.image_singleton, Ideal.mem_span_singleton]
    exact ⟨c, he⟩
  obtain ⟨d, hd⟩ := Ideal.mem_span_singleton.mp ha
  refine ⟨d, ?_⟩
  rw [← hab, hd, map_mul, mul_div_cancel_left₀ _ hbK]

end IsIntegrallyClosed
