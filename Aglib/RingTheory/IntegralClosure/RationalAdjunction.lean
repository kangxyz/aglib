/-!
# The algebra of adjoining an actual fraction

The polynomial evaluation kernel over a normal domain is generated by its
linear relations. The quotient by the adjoined fraction is the quotient by
the numerator ideal in the original ring. Multiplication by the denominator
embeds that quotient into a principal quotient, retaining the coefficient
map. A nonzero polynomial relation also supplies the required dimension bound.

The normalization-finiteness consumer is `Nagata.RationalAdjunction`.
No Japanese or Nagata stability assertion is assumed in these algebraic lemmas.
-/

@[expose] public noncomputable section

open Polynomial

namespace Ideal

variable {R : Type*} [CommRing R]

/-- Multiplication by `a` on representatives, from the quotient by `(I : a)`
to the quotient by `I`. -/
def quotientColonSingletonHom (I : Ideal R) (a : R) :
    (R ⧸ I.colon ({a} : Set R)) →ₗ[R] R ⧸ I :=
  (I.colon ({a} : Set R)).liftQ (a • I.mkQ) (by
    intro r hr
    change Ideal.Quotient.mk I (a * r) = 0
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    simpa only [Submodule.mem_colon_singleton, smul_eq_mul, mul_comm] using hr)

@[simp]
theorem quotientColonSingletonHom_mk (I : Ideal R) (a r : R) :
    quotientColonSingletonHom I a (Ideal.Quotient.mk _ r) =
      Ideal.Quotient.mk I (a * r) := rfl

/-- The multiplication map has exactly the colon ideal as its kernel before
passing to the source quotient. -/
theorem quotientColonSingletonHom_injective (I : Ideal R) (a : R) :
    Function.Injective (quotientColonSingletonHom I a) := by
  apply LinearMap.ker_eq_bot.mp
  unfold quotientColonSingletonHom
  apply Submodule.ker_liftQ_eq_bot
  intro r hr
  change Ideal.Quotient.mk I (a * r) = 0 at hr
  simpa only [Submodule.mem_colon_singleton, smul_eq_mul, mul_comm] using
    (Ideal.Quotient.eq_zero_iff_mem.mp hr)

end Ideal

namespace IsAssociatedPrime

variable {R : Type*} [CommRing R] [IsDomain R] [IsNoetherianRing R]
  [IsIntegrallyClosed R]

/-- The actual colon quotient embeds into the nonzero principal quotient. -/
theorem height_le_one_of_colon_span_singleton {p : Ideal R} {a b : R}
    (hb : b ≠ 0)
    (h : IsAssociatedPrime p (R ⧸ (Ideal.span {b}).colon ({a} : Set R))) :
    p.height ≤ 1 :=
  (h.map_of_injective (Ideal.quotientColonSingletonHom (Ideal.span {b}) a)
    (Ideal.quotientColonSingletonHom_injective (Ideal.span {b}) a)).height_le_one_of_principal hb

end IsAssociatedPrime

namespace Polynomial

variable (R : Type*) [CommRing R] {K : Type*} [CommRing K] [Algebra R K]

/-- The ideal generated by the actual linear relations satisfied by `x`. -/
def linearRelationIdeal (x : K) : Ideal R[X] :=
  Ideal.span {p | ∃ a b : R, algebraMap R K a * x = algebraMap R K b ∧
    p = C a * X - C b}

variable {R}

theorem linearRelationIdeal_le_ker_aeval (x : K) :
    linearRelationIdeal R x ≤ RingHom.ker (aeval x).toRingHom := by
  apply Ideal.span_le.mpr
  rintro p ⟨a, b, hab, rfl⟩
  change aeval x (C a * X - C b) = 0
  simpa only [map_sub, map_mul, aeval_C, aeval_X, sub_eq_zero] using hab

end Polynomial

namespace IsIntegrallyClosed

variable {R K : Type*} [CommRing R] [IsIntegrallyClosed R]
  [Field K] [Algebra R K] [IsFractionRing R K]

/-- The leading coefficient times a root in the actual fraction field lies
in the original normal domain. -/
theorem algebraMap_eq_leadingCoeff_mul_of_aeval_eq_zero {p : R[X]} {x : K}
    (hp : aeval x p = 0) :
    ∃ b : R, algebraMap R K b = algebraMap R K p.leadingCoeff * x := by
  by_cases hp0 : p = 0
  · exact ⟨0, by simp [hp0]⟩
  apply algebraMap_eq_of_integral
  refine ⟨p.integralNormalization, p.monic_integralNormalization hp0, ?_⟩
  exact integralNormalization_aeval_eq_zero hp fun r hr =>
    (IsFractionRing.injective R K) (by simpa only [map_zero] using hr)

end IsIntegrallyClosed

namespace Polynomial

variable {R K : Type*} [CommRing R] [IsIntegrallyClosed R]
  [Field K] [Algebra R K] [IsFractionRing R K]

/-- Over a normal domain, all relations of an actual fraction follow from
linear relations, under the original evaluation map. -/
theorem ker_aeval_eq_linearRelationIdeal (x : K) :
    RingHom.ker (aeval x).toRingHom = linearRelationIdeal R x := by
  have aux : ∀ p : R[X], aeval x p = 0 → p ∈ linearRelationIdeal R x := by
    intro p
    induction p using Polynomial.degree_lt_wf.induction with
    | h p ih =>
      intro hp
      by_cases hp0 : p = 0
      · simpa only [hp0] using (linearRelationIdeal R x).zero_mem
      have hpos : 0 < p.natDegree := by
        by_contra h
        have hd : p.natDegree = 0 := Nat.eq_zero_of_not_pos h
        have hc : p.coeff 0 = 0 := by
          apply IsFractionRing.injective R K
          have he : aeval x (C (p.coeff 0)) = 0 :=
            (congrArg (aeval x) (p.eq_C_of_natDegree_eq_zero hd)).symm.trans hp
          simpa only [aeval_C, map_zero] using he
        exact hp0 ((p.eq_C_of_natDegree_eq_zero hd).trans (by rw [hc, C_0]))
      obtain ⟨b, hb⟩ :=
        IsIntegrallyClosed.algebraMap_eq_leadingCoeff_mul_of_aeval_eq_zero hp
      let l : R[X] := C p.leadingCoeff * X - C b
      have hl : l ∈ linearRelationIdeal R x :=
        Ideal.subset_span ⟨p.leadingCoeff, b, hb.symm, rfl⟩
      have hlzero : aeval x l = 0 := by
        dsimp [l]
        simpa only [map_sub, map_mul, aeval_C, aeval_X, sub_eq_zero] using hb.symm
      let q : R[X] := p - l * X ^ (p.natDegree - 1)
      have hpow : (X : R[X]) * X ^ (p.natDegree - 1) = X ^ p.natDegree := by
        rw [← pow_succ', Nat.sub_add_cancel hpos]
      have hq : q = p.eraseLead + C b * X ^ (p.natDegree - 1) := by
        dsimp [q, l]
        calc
          p - (C p.leadingCoeff * X - C b) * X ^ (p.natDegree - 1) =
              (p - C p.leadingCoeff * X ^ p.natDegree) +
                C b * X ^ (p.natDegree - 1) := by
                  rw [sub_mul, mul_assoc, hpow]
                  ring
          _ = p.eraseLead + C b * X ^ (p.natDegree - 1) := by
            rw [p.self_sub_C_mul_X_pow]
      have hqdegree : q.natDegree < p.natDegree := by
        rw [hq]
        exact lt_of_le_of_lt
          (natDegree_add_le_of_degree_le p.eraseLead_natDegree_le
            (natDegree_C_mul_X_pow_le b (p.natDegree - 1)))
          (Nat.sub_lt hpos (by decide))
      have hqzero : aeval x q = 0 := by
        simp only [q, map_sub, map_mul, hp, hlzero, zero_mul, sub_zero]
      have hqm : q ∈ linearRelationIdeal R x :=
        ih q (degree_lt_degree hqdegree) hqzero
      have hsum := (linearRelationIdeal R x).add_mem hqm
        ((linearRelationIdeal R x).mul_mem_right (X ^ (p.natDegree - 1)) hl)
      simpa only [q, sub_add_cancel] using hsum
  apply le_antisymm
  · intro p hp
    exact aux p (RingHom.mem_ker.mp hp)
  · exact linearRelationIdeal_le_ker_aeval x

end Polynomial

namespace Algebra

variable (R : Type*) [CommRing R] {K : Type*} [Field K] [Algebra R K]

/-- The chosen element of its literal singleton-generated subalgebra. -/
def adjoinSingletonGenerator (x : K) : Algebra.adjoin R ({x} : Set K) :=
  ⟨x, Algebra.self_mem_adjoin_singleton R x⟩

/-- The coefficients which are an original-ring multiple of the fraction. -/
def numeratorIdeal (x : K) : Ideal R where
  carrier := {b | ∃ a : R, algebraMap R K a * x = algebraMap R K b}
  zero_mem' := ⟨0, by simp⟩
  add_mem' := by
    rintro b c ⟨a, ha⟩ ⟨d, hd⟩
    exact ⟨a + d, by rw [map_add, add_mul, ha, hd, map_add]⟩
  smul_mem' := by
    rintro r b ⟨a, ha⟩
    refine ⟨r * a, ?_⟩
    simp only [smul_eq_mul, map_mul, mul_assoc, ha]

@[simp]
theorem mem_numeratorIdeal (x : K) (b : R) :
    b ∈ numeratorIdeal R x ↔
      ∃ a : R, algebraMap R K a * x = algebraMap R K b := Iff.rfl

/-- The original coefficient map to the quotient by the actual generator. -/
def adjoinSingletonQuotientMap (x : K) :
    R →ₐ[R] (Algebra.adjoin R ({x} : Set K)) ⧸
      Ideal.span {adjoinSingletonGenerator R x} :=
  Algebra.ofId R _

theorem aeval_adjoinSingletonGenerator_surjective (x : K) :
    Function.Surjective
      (aeval (adjoinSingletonGenerator R x) :
        R[X] →ₐ[R] Algebra.adjoin R ({x} : Set K)) := by
  intro y
  obtain ⟨p, hp⟩ := Algebra.adjoin_eq_exists_aeval R x y
  refine ⟨p, ?_⟩
  apply Subtype.ext
  simpa only [adjoinSingletonGenerator, Polynomial.coe_aeval_mk_apply] using hp

theorem adjoinSingletonQuotientMap_surjective (x : K) :
    Function.Surjective (adjoinSingletonQuotientMap R x) := by
  let S := Algebra.adjoin R ({x} : Set K)
  let z : S := adjoinSingletonGenerator R x
  let I : Ideal S := Ideal.span {z}
  intro y
  obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective y
  obtain ⟨p, hp⟩ := aeval_adjoinSingletonGenerator_surjective R x s
  refine ⟨p.coeff 0, ?_⟩
  have hz : (Ideal.Quotient.mkₐ R I) z = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))
  have he := Polynomial.aeval_algHom_apply (Ideal.Quotient.mkₐ R I) z p
  rw [hz, ← Polynomial.coeff_zero_eq_aeval_zero', hp] at he
  exact he

variable [IsFractionRing R K]

/-- The numerator ideal is the literal principal colon ideal for any supplied
nonzero-denominator representation. -/
theorem numeratorIdeal_eq_colon (x : K) {a b : R} (ha : a ≠ 0)
    (hab : algebraMap R K a * x = algebraMap R K b) :
    numeratorIdeal R x = (Ideal.span {b}).colon ({a} : Set R) := by
  have haK : algebraMap R K a ≠ 0 := by
    simpa only [map_zero] using (IsFractionRing.injective R K).ne ha
  ext r
  rw [mem_numeratorIdeal, Submodule.mem_colon_singleton, smul_eq_mul,
    Ideal.mem_span_singleton]
  constructor
  · rintro ⟨c, hc⟩
    refine ⟨c, ?_⟩
    apply IsFractionRing.injective R K
    simp only [map_mul]
    calc
      algebraMap R K r * algebraMap R K a =
          algebraMap R K c * (algebraMap R K a * x) := by rw [← hc]; ring
      _ = algebraMap R K b * algebraMap R K c := by rw [hab]; ring
  · rintro ⟨c, hc⟩
    refine ⟨c, ?_⟩
    apply mul_left_cancel₀ haK
    have hcK := congrArg (algebraMap R K) hc
    simp only [map_mul] at hcK
    calc
      algebraMap R K a * (algebraMap R K c * x) =
          algebraMap R K b * algebraMap R K c := by rw [← hab]; ring
      _ = algebraMap R K a * algebraMap R K r := by rw [← hcK]; ring

variable [IsIntegrallyClosed R]

theorem ker_adjoinSingletonQuotientMap (x : K) :
    RingHom.ker (adjoinSingletonQuotientMap R x).toRingHom = numeratorIdeal R x := by
  let S := Algebra.adjoin R ({x} : Set K)
  let z : S := adjoinSingletonGenerator R x
  let I : Ideal S := Ideal.span {z}
  have hconst : Polynomial.linearRelationIdeal R x ≤
      (numeratorIdeal R x).comap Polynomial.constantCoeff := by
    apply Ideal.span_le.mpr
    rintro p ⟨a, b, hab, rfl⟩
    change (C a * X - C b).coeff 0 ∈ numeratorIdeal R x
    simpa using (numeratorIdeal R x).neg_mem (show b ∈ numeratorIdeal R x from ⟨a, hab⟩)
  ext b
  constructor
  · intro hb
    have hbzero : Ideal.Quotient.mk I (algebraMap R S b) = 0 := hb
    obtain ⟨s, hs⟩ := Ideal.mem_span_singleton.mp
      (Ideal.Quotient.eq_zero_iff_mem.mp hbzero)
    obtain ⟨p, hp⟩ := Algebra.adjoin_eq_exists_aeval R x s
    let g : R[X] := X * p - C b
    have hsz : algebraMap R K b = x * (s : K) :=
      congrArg (fun t : S => (t : K)) hs
    have hg : aeval x g = 0 := by
      simp only [g, map_sub, map_mul, aeval_X, aeval_C, hp, hsz, sub_self]
    have hgm : g ∈ Polynomial.linearRelationIdeal R x := by
      rw [← Polynomial.ker_aeval_eq_linearRelationIdeal x]
      exact RingHom.mem_ker.mpr hg
    have hm : -b ∈ numeratorIdeal R x := by
      simpa [g] using hconst hgm
    simpa only [neg_neg] using (numeratorIdeal R x).neg_mem hm
  · rintro ⟨a, ha⟩
    change Ideal.Quotient.mk I (algebraMap R S b) = 0
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    apply Ideal.mem_span_singleton.mpr
    refine ⟨algebraMap R S a, ?_⟩
    apply Subtype.ext
    change algebraMap R K b = x * algebraMap R K a
    simpa only [mul_comm] using ha.symm

/-- The quotient by the actual adjoined element, as an algebra over the
original coefficient ring. -/
def adjoinSingletonQuotientEquiv (x : K) :
    ((Algebra.adjoin R ({x} : Set K)) ⧸
      Ideal.span {adjoinSingletonGenerator R x}) ≃ₐ[R] R ⧸ numeratorIdeal R x :=
  (Ideal.quotientKerAlgEquivOfSurjective
    (adjoinSingletonQuotientMap_surjective R x)).symm.trans
      (Ideal.quotientEquivAlgOfEq R (ker_adjoinSingletonQuotientMap R x))

/-- The same quotient comparison for the supplied literal denominator and
numerator. -/
def adjoinSingletonQuotientEquivColon (x : K) {a b : R} (ha : a ≠ 0)
    (hab : algebraMap R K a * x = algebraMap R K b) :
    ((Algebra.adjoin R ({x} : Set K)) ⧸
      Ideal.span {adjoinSingletonGenerator R x}) ≃ₐ[R]
        R ⧸ (Ideal.span {b}).colon ({a} : Set R) :=
  (adjoinSingletonQuotientEquiv R x).trans
    (Ideal.quotientEquivAlgOfEq R (numeratorIdeal_eq_colon R x ha hab))

end Algebra

namespace Algebra

variable (R : Type*) [CommRing R] [IsDomain R] [IsNoetherianRing R]
  {K : Type*} [Field K] [Algebra R K]

/-- A nonzero algebraic relation drops the polynomial-ring dimension by one
for the original singleton-generated subalgebra. -/
theorem ringKrullDim_adjoin_singleton_succ_le (x : K) (hx : IsAlgebraic R x) :
    ringKrullDim (Algebra.adjoin R ({x} : Set K)) + 1 ≤ ringKrullDim R + 1 := by
  obtain ⟨p, hp, hpx⟩ := hx
  have hzero : aeval (adjoinSingletonGenerator R x) p = 0 := by
    apply Subtype.ext
    change (aeval (adjoinSingletonGenerator R x) p : K) = 0
    simpa only [adjoinSingletonGenerator, Polynomial.coe_aeval_mk_apply] using hpx
  have hdrop := ringKrullDim_succ_le_of_surjective
    (aeval (adjoinSingletonGenerator R x)).toRingHom
    (aeval_adjoinSingletonGenerator_surjective R x)
    (mem_nonZeroDivisors_iff_ne_zero.mpr hp) hzero
  simpa only [Polynomial.ringKrullDim_of_isNoetherianRing] using hdrop

theorem ringKrullDim_adjoin_singleton_le_two (x : K) (hx : IsAlgebraic R x)
    (hdim : ringKrullDim R ≤ 2) :
    ringKrullDim (Algebra.adjoin R ({x} : Set K)) ≤ 2 :=
  ENat.WithBot.add_le_add_one_right_iff.mp
    ((ringKrullDim_adjoin_singleton_succ_le R x hx).trans (add_le_add hdim le_rfl))

end Algebra

open IsLocalRing

namespace Algebra

variable (R : Type*) [CommRing R] [IsDomain R]
  {K : Type*} [Field K] [Algebra R K] [IsFractionRing R K]

omit [IsDomain R] in
theorem isFractionRing_adjoin_singleton (x : K) :
    IsFractionRing (Algebra.adjoin R ({x} : Set K)) K := by
  let S := Algebra.adjoin R ({x} : Set K)
  let : FaithfulSMul S K :=
    (faithfulSMul_iff_algebraMap_injective S K).mpr Subtype.val_injective
  apply IsFractionRing.of_field
  intro z
  obtain ⟨a, b, _, hab⟩ := IsFractionRing.div_surjective R z
  exact ⟨algebraMap R S a, algebraMap R S b, hab.symm⟩

omit [IsDomain R] [IsFractionRing R K] in
private theorem adjoinSingleton_ideal_ext (x : K)
    (I J : Ideal (Algebra.adjoin R ({x} : Set K)))
    (hI : adjoinSingletonGenerator R x ∈ I)
    (hJ : adjoinSingletonGenerator R x ∈ J)
    (hIJ : I.comap (algebraMap R (Algebra.adjoin R ({x} : Set K))) =
      J.comap (algebraMap R (Algebra.adjoin R ({x} : Set K)))) : I = J := by
  let S := Algebra.adjoin R ({x} : Set K)
  let G : Ideal S := Ideal.span {adjoinSingletonGenerator R x}
  let π : S →+* S ⧸ G := Ideal.Quotient.mk G
  let α : R →+* S ⧸ G := (adjoinSingletonQuotientMap R x).toRingHom
  have hGI : G ≤ I := Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hI)
  have hGJ : G ≤ J := Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hJ)
  have hker : Ideal.comap π ⊥ = G := by
    change RingHom.ker (Ideal.Quotient.mk G) = G
    exact Ideal.mk_ker
  have hπI : (I.map π).comap π = I := by
    rw [Ideal.comap_map_of_surjective π Ideal.Quotient.mk_surjective, hker,
      sup_eq_left.mpr hGI]
  have hπJ : (J.map π).comap π = J := by
    rw [Ideal.comap_map_of_surjective π Ideal.Quotient.mk_surjective, hker,
      sup_eq_left.mpr hGJ]
  have he : I.map π = J.map π := by
    apply Ideal.comap_injective_of_surjective α (adjoinSingletonQuotientMap_surjective R x)
    change ((I.map π).comap π).comap (algebraMap R S) =
      ((J.map π).comap π).comap (algebraMap R S)
    rw [hπI, hπJ, hIJ]
  exact hπI.symm.trans ((congrArg (Ideal.comap π) he).trans hπJ)

private def primeFractionMap (p : Ideal R) [p.IsPrime] :
    Localization.AtPrime p →ₐ[R] K :=
  IsLocalization.liftAlgHom (M := p.primeCompl) (f := Algebra.ofId R K)
    (fun s => IsLocalization.map_units K ⟨s.val, p.primeCompl_le_nonZeroDivisors s.property⟩)

private theorem no_local_inverse_of_numeratorIdeal_le (x : K)
    (p : Ideal R) [p.IsPrime] (hJ : numeratorIdeal R x ≤ p)
    (y : Localization.AtPrime p) : primeFractionMap R (K := K) p y * x ≠ 1 := by
  intro hyx
  obtain ⟨⟨c, s⟩, hy⟩ := IsLocalization.surj p.primeCompl y
  have he : primeFractionMap R (K := K) p y * algebraMap R K s = algebraMap R K c := by
    simpa only [map_mul, (primeFractionMap R (K := K) p).commutes] using
      congrArg (primeFractionMap R (K := K) p) hy
  apply s.property
  apply hJ
  refine ⟨c, ?_⟩
  calc
    algebraMap R K c * x =
        (primeFractionMap R (K := K) p y * algebraMap R K s) * x := by rw [he]
    _ = (primeFractionMap R (K := K) p y * x) * algebraMap R K s := by ring
    _ = algebraMap R K s := by rw [hyx, one_mul]

private theorem exists_mem_maximal_preimage
    (A F : Type*) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [Field F] [Algebra A F] [IsFractionRing A F] (x : F)
    (h : ∀ y : A, algebraMap A F y * x ≠ 1) :
    ∃ y : A, y ∈ maximalIdeal A ∧ algebraMap A F y = x := by
  obtain ⟨b, a, ha, hba⟩ := IsFractionRing.div_surjective A x
  have haF : algebraMap A F a ≠ 0 := IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors ha
  have hmul : algebraMap A F b = x * algebraMap A F a := (div_eq_iff haF).mp hba
  obtain ⟨c, hc | hc⟩ := ValuationRing.cond a b
  · have hcx : algebraMap A F c = x := by
      apply mul_left_cancel₀ haF
      calc
        algebraMap A F a * algebraMap A F c = algebraMap A F b := by rw [← map_mul, hc]
        _ = algebraMap A F a * x := by rw [hmul]; ring
    refine ⟨c, ?_, hcx⟩
    change ¬IsUnit c
    rintro ⟨u, rfl⟩
    apply h (↑u⁻¹)
    rw [← hcx, ← map_mul]
    simp
  · exfalso
    apply h c
    apply mul_right_cancel₀ haF
    calc
      (algebraMap A F c * x) * algebraMap A F a =
          algebraMap A F c * algebraMap A F b := by rw [hmul]; ring
      _ = algebraMap A F a := by rw [mul_comm, ← map_mul, hc]
      _ = 1 * algebraMap A F a := by rw [one_mul]

/-- The actual prime localization of a rational adjunction equals the
coefficient prime localization when the latter is a DVR and the adjoined
element belongs to the selected prime. -/
theorem nonempty_adjoinSingletonAtPrimeEquiv (x : K)
    (q : Ideal (Algebra.adjoin R ({x} : Set K))) [q.IsPrime]
    (hxq : adjoinSingletonGenerator R x ∈ q)
    [IsDiscreteValuationRing
      (Localization.AtPrime (q.comap (algebraMap R (Algebra.adjoin R ({x} : Set K)))))] :
    Nonempty (Localization.AtPrime q ≃ₐ[R]
      Localization.AtPrime (q.comap (algebraMap R (Algebra.adjoin R ({x} : Set K))))) := by
  let S := Algebra.adjoin R ({x} : Set K)
  let p : Ideal R := q.comap (algebraMap R S)
  let A := Localization.AtPrime p
  let B := Localization.AtPrime q
  let φ : A →ₐ[R] K := primeFractionMap R (K := K) p
  let : Algebra A K := φ.toRingHom.toAlgebra
  let : IsScalarTower R A K := IsScalarTower.of_algHom φ
  let : IsFractionRing A K :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization p.primeCompl A K
  have hφ : Function.Injective φ := IsFractionRing.injective A K
  have hJ : numeratorIdeal R x ≤ p := by
    rintro b ⟨a, hab⟩
    change algebraMap R S b ∈ q
    have he : algebraMap R S b = adjoinSingletonGenerator R x * algebraMap R S a := by
      apply Subtype.ext
      change algebraMap R K b = x * algebraMap R K a
      simpa only [mul_comm] using hab.symm
    rw [he]
    exact q.mul_mem_right _ hxq
  obtain ⟨c, hcm, hc⟩ := exists_mem_maximal_preimage A K x
    (no_local_inverse_of_numeratorIdeal_le R x p hJ)
  have hS : S ≤ φ.range := Algebra.adjoin_le (Set.singleton_subset_iff.mpr ⟨c, hc⟩)
  let e : A ≃ₐ[R] φ.range := AlgEquiv.ofInjective φ hφ
  let f : S →ₐ[R] A := e.symm.toAlgHom.comp (Subalgebra.inclusion hS)
  have hφf (s : S) : φ (f s) = (s : K) := by
    change (e (e.symm (Subalgebra.inclusion hS s)) : K) = (s : K)
    rw [e.apply_symm_apply]
    rfl
  have hfc : f (adjoinSingletonGenerator R x) = c :=
    hφ ((hφf _).trans hc.symm)
  have hlocal : (maximalIdeal A).comap f.toRingHom = q := by
    apply adjoinSingleton_ideal_ext R x
    · change f (adjoinSingletonGenerator R x) ∈ maximalIdeal A
      rwa [hfc]
    · exact hxq
    · ext r
      change f (algebraMap R S r) ∈ maximalIdeal A ↔ r ∈ p
      rw [f.commutes]
      exact IsLocalization.AtPrime.to_map_mem_maximal_iff A p r
  have hfunit (s : q.primeCompl) : IsUnit (f s) := by
    have hn : f s ∉ maximalIdeal A := by
      intro hs
      have hs' : s.val ∈ (maximalIdeal A).comap f.toRingHom := hs
      exact s.property (Eq.mp (congrArg (fun I : Ideal S => s.val ∈ I) hlocal) hs')
    simpa only [mem_maximalIdeal, mem_nonunits_iff, not_not] using hn
  let ψ : B →ₐ[R] A := IsLocalization.liftAlgHom (M := q.primeCompl) (f := f) hfunit
  let η : A →ₐ[R] B := IsLocalization.liftAlgHom (M := p.primeCompl)
    (f := Algebra.ofId R B) (fun s => by
      have hs : algebraMap R S s ∈ q.primeCompl := s.property
      change IsUnit (algebraMap R B s.val)
      simpa only [← IsScalarTower.algebraMap_apply R S B] using
        (IsLocalization.map_units B ⟨algebraMap R S s, hs⟩))
  let : IsFractionRing S K := isFractionRing_adjoin_singleton R x
  let ρ : B →ₐ[S] K := IsLocalization.liftAlgHom (M := q.primeCompl)
    (f := Algebra.ofId S K)
    (fun s => IsLocalization.map_units K ⟨s.val, q.primeCompl_le_nonZeroDivisors s.property⟩)
  let : Algebra B K := ρ.toRingHom.toAlgebra
  let : IsScalarTower S B K := IsScalarTower.of_algHom ρ
  let : IsFractionRing B K :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization q.primeCompl B K
  have hρ : Function.Injective ρ := IsFractionRing.injective B K
  let ρR : B →ₐ[R] K := ρ.restrictScalars R
  have hψη : ψ.comp η = AlgHom.id R A :=
    (IsLocalization.algHom_subsingleton p.primeCompl).elim _ _
  have hρη : ρR.comp η = φ :=
    (IsLocalization.algHom_subsingleton p.primeCompl).elim _ _
  have hφψ : φ.comp ψ = ρR := by
    apply IsLocalization.algHom_ext q.primeCompl
    ext s
    change φ (ψ (algebraMap S B s)) = ρ (algebraMap S B s)
    calc
      φ (ψ (algebraMap S B s)) = φ (f s) :=
        congrArg φ (IsLocalization.lift_eq (S := B) (g := f.toRingHom) hfunit s)
      _ = algebraMap S K s := hφf s
      _ = ρ (algebraMap S B s) := (ρ.commutes s).symm
  have hηψ (z : B) : η (ψ z) = z := by
    apply hρ
    change (ρR.comp η) (ψ z) = ρR z
    rw [hρη]
    exact AlgHom.congr_fun hφψ z
  exact ⟨AlgEquiv.ofBijective ψ
    ⟨Function.LeftInverse.injective hηψ,
      Function.RightInverse.surjective (fun z => AlgHom.congr_fun hψη z)⟩⟩

end Algebra

namespace Algebra

variable (R : Type*) [CommRing R] {K : Type*} [Field K] [Algebra R K]

/-- Killing the actual generator makes the original coefficient map
surjective, for any ideal containing that generator. -/
theorem adjoinSingleton_quotient_algebraMap_surjective (x : K)
    (I : Ideal (Algebra.adjoin R ({x} : Set K)))
    (hxI : adjoinSingletonGenerator R x ∈ I) :
    Function.Surjective (algebraMap R ((Algebra.adjoin R ({x} : Set K)) ⧸ I)) := by
  let S := Algebra.adjoin R ({x} : Set K)
  let G : Ideal S := Ideal.span {adjoinSingletonGenerator R x}
  have hGI : G ≤ I := Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hxI)
  let f : S ⧸ G →ₐ[R] S ⧸ I := Ideal.Quotient.factorₐ R hGI
  have hf : Function.Surjective f := by
    intro y
    obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective y
    exact ⟨Ideal.Quotient.mk G s, rfl⟩
  exact hf.comp (adjoinSingletonQuotientMap_surjective R x)

variable [IsDomain R] [IsNoetherianRing R] [IsFractionRing R K]

theorem ringKrullDim_adjoin_singleton_le_two_of_isFractionRing (x : K)
    (hdim : ringKrullDim R ≤ 2) :
    ringKrullDim (Algebra.adjoin R ({x} : Set K)) ≤ 2 :=
  ringKrullDim_adjoin_singleton_le_two R x
    ((IsFractionRing.isAlgebraic_iff R K K).mpr
      (Algebra.IsAlgebraic.isAlgebraic (R := K) x)) hdim

variable [IsIntegrallyClosed R]

/-- The actual local ring at an associated prime of the generator quotient
is a DVR. Its comparison with the coefficient localization preserves the
original fraction-field maps. -/
theorem isDiscreteValuationRing_atPrime_adjoin_singleton (x : K) (hx : x ≠ 0)
    (q : Ideal (Algebra.adjoin R ({x} : Set K))) [q.IsPrime]
    (hass : IsAssociatedPrime q ((Algebra.adjoin R ({x} : Set K)) ⧸
      Ideal.span {adjoinSingletonGenerator R x})) :
    IsDiscreteValuationRing (Localization.AtPrime q) := by
  let S := Algebra.adjoin R ({x} : Set K)
  let I : Ideal S := Ideal.span {adjoinSingletonGenerator R x}
  let p : Ideal R := q.comap (algebraMap R S)
  let : Algebra.FiniteType R S := Algebra.FiniteType.adjoin_of_finite (Set.finite_singleton x)
  let : IsNoetherianRing S := Algebra.FiniteType.isNoetherianRing R S
  obtain ⟨b, a, ha, hba⟩ := IsFractionRing.div_surjective R x
  have ha0 : a ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp ha
  have haK : algebraMap R K a ≠ 0 := IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors ha
  have hab : algebraMap R K a * x = algebraMap R K b := by
    simpa only [mul_comm] using ((div_eq_iff haK).mp hba).symm
  have hb : b ≠ 0 := by
    intro hb
    have hz : algebraMap R K a * x = 0 := by simpa only [hb, map_zero] using hab
    exact hx ((mul_eq_zero.mp hz).resolve_left haK)
  have hassR : IsAssociatedPrime p (S ⧸ I) := by
    obtain ⟨_, z, hz⟩ := isAssociatedPrime_iff.mp hass
    apply isAssociatedPrime_iff.mpr
    refine ⟨inferInstance, z, ?_⟩
    ext r
    change algebraMap R S r ∈ q ↔
      r ∈ (⊥ : Submodule R (S ⧸ I)).colon {z}
    rw [hz]
    simp only [Submodule.mem_colon_singleton, Submodule.mem_bot,
      IsScalarTower.algebraMap_smul]
  let e := adjoinSingletonQuotientEquivColon R x ha0 hab
  have hassC : IsAssociatedPrime p (R ⧸ (Ideal.span {b}).colon ({a} : Set R)) :=
    e.toLinearEquiv.isAssociatedPrime_iff.mp hassR
  have hassP : IsAssociatedPrime p (R ⧸ Ideal.span {b}) :=
    hassC.map_of_injective (Ideal.quotientColonSingletonHom (Ideal.span {b}) a)
      (Ideal.quotientColonSingletonHom_injective (Ideal.span {b}) a)
  let : IsDiscreteValuationRing (Localization.AtPrime p) :=
    hassP.isDiscreteValuationRing_atPrime_of_principal hb
  obtain ⟨eLocal⟩ := nonempty_adjoinSingletonAtPrimeEquiv R x q
    hass.mem_of_quotient_span_singleton
  exact IsDiscreteValuationRing.RingEquivClass.isDiscreteValuationRing eLocal.symm

end Algebra

namespace Algebra

variable (R : Type*) [CommRing R] [IsDomain R]
  {K : Type*} [Field K] [Algebra R K] [IsFractionRing R K]

/-- Inverting the original denominator in the actual adjunction gives the
original coefficient localization, under an equivalence over the base. -/
def adjoinSingletonAwayEquiv (x : K) (a b : R) (ha : a ≠ 0)
    (hab : algebraMap R K a * x = algebraMap R K b) :
    Localization.Away (algebraMap R (Algebra.adjoin R ({x} : Set K)) a) ≃ₐ[R]
      Localization.Away a := by
  let S := Algebra.adjoin R ({x} : Set K)
  let A := Localization.Away a
  let aS : S := algebraMap R S a
  let B := Localization.Away aS
  have haK : algebraMap R K a ≠ 0 := by
    simpa only [map_zero] using (IsFractionRing.injective R K).ne ha
  let φ : A →ₐ[R] K := IsLocalization.Away.liftAlgHom a
    (f := Algebra.ofId R K) (IsUnit.mk0 _ haK)
  let : Algebra A K := φ.toRingHom.toAlgebra
  let : IsScalarTower R A K := IsScalarTower.of_algHom φ
  let : IsFractionRing A K :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization (Submonoid.powers a) A K
  have hφ : Function.Injective φ := IsFractionRing.injective A K
  let c : A := algebraMap R A b * IsLocalization.Away.invSelf a
  have hca : c * algebraMap R A a = algebraMap R A b := by
    simp [c, mul_assoc, mul_comm (IsLocalization.Away.invSelf a)]
  have hc : φ c = x := by
    apply mul_right_cancel₀ haK
    calc
      φ c * algebraMap R K a = algebraMap R K b := by
        simpa only [map_mul, φ.commutes] using congrArg φ hca
      _ = x * algebraMap R K a := by rw [← hab]; ring
  have hS : S ≤ φ.range := Algebra.adjoin_le (Set.singleton_subset_iff.mpr ⟨c, hc⟩)
  let e : A ≃ₐ[R] φ.range := AlgEquiv.ofInjective φ hφ
  let f : S →ₐ[R] A := e.symm.toAlgHom.comp (Subalgebra.inclusion hS)
  have hφf (s : S) : φ (f s) = (s : K) := by
    change (e (e.symm (Subalgebra.inclusion hS s)) : K) = (s : K)
    rw [e.apply_symm_apply]
    rfl
  have hunitA : IsUnit (algebraMap R A a) :=
    IsLocalization.Away.algebraMap_isUnit (S := A) a
  have hfa : IsUnit (f aS) := by simpa only [aS, f.commutes] using hunitA
  let ψ : B →ₐ[R] A := IsLocalization.Away.liftAlgHom aS (f := f) hfa
  have hunitB : IsUnit (algebraMap R B a) := by
    simpa only [aS, ← IsScalarTower.algebraMap_apply R S B] using
      (IsLocalization.Away.algebraMap_isUnit (S := B) aS)
  let η : A →ₐ[R] B :=
    IsLocalization.Away.liftAlgHom a (f := Algebra.ofId R B) hunitB
  let : IsFractionRing S K := isFractionRing_adjoin_singleton R x
  have haSK : algebraMap S K aS ≠ 0 := haK
  let ρ : B →ₐ[S] K := IsLocalization.Away.liftAlgHom aS
    (f := Algebra.ofId S K) (IsUnit.mk0 _ haSK)
  let : Algebra B K := ρ.toRingHom.toAlgebra
  let : IsScalarTower S B K := IsScalarTower.of_algHom ρ
  let : IsFractionRing B K :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization (Submonoid.powers aS) B K
  have hρ : Function.Injective ρ := IsFractionRing.injective B K
  let ρR : B →ₐ[R] K := ρ.restrictScalars R
  have hψη : ψ.comp η = AlgHom.id R A :=
    (IsLocalization.algHom_subsingleton (Submonoid.powers a)).elim _ _
  have hρη : ρR.comp η = φ :=
    (IsLocalization.algHom_subsingleton (Submonoid.powers a)).elim _ _
  have hφψ : φ.comp ψ = ρR := by
    apply IsLocalization.algHom_ext (Submonoid.powers aS)
    ext s
    change φ (ψ (algebraMap S B s)) = ρ (algebraMap S B s)
    calc
      φ (ψ (algebraMap S B s)) = φ (f s) :=
        congrArg φ (IsLocalization.Away.lift_eq (S := B) (g := f.toRingHom) aS hfa s)
      _ = algebraMap S K s := hφf s
      _ = ρ (algebraMap S B s) := (ρ.commutes s).symm
  have hηψ (z : B) : η (ψ z) = z := by
    apply hρ
    change (ρR.comp η) (ψ z) = ρR z
    rw [hρη]
    exact AlgHom.congr_fun hφψ z
  exact AlgEquiv.ofBijective ψ
    ⟨Function.LeftInverse.injective hηψ,
      Function.RightInverse.surjective (fun z => AlgHom.congr_fun hψη z)⟩

theorem isIntegrallyClosed_away_adjoin_singleton [IsIntegrallyClosed R]
    (x : K) (a b : R) (ha : a ≠ 0)
    (hab : algebraMap R K a * x = algebraMap R K b) :
    IsIntegrallyClosed
      (Localization.Away (algebraMap R (Algebra.adjoin R ({x} : Set K)) a)) := by
  let A := Localization.Away a
  have hM : Submonoid.powers a ≤ nonZeroDivisors R :=
    powers_le_nonZeroDivisors_of_noZeroDivisors ha
  let : IsIntegrallyClosed A := isIntegrallyClosed_of_isLocalization A (Submonoid.powers a) hM
  exact IsIntegrallyClosed.of_equiv (adjoinSingletonAwayEquiv R x a b ha hab).symm.toRingEquiv

end Algebra

namespace Algebra

variable (R : Type*) [CommRing R] {K : Type*} [Field K] [Algebra R K]

/-- The literal inclusion of the subalgebra generated by a polynomial value
into the subalgebra generated by its argument. -/
def polynomialValueInclusion (x : K) (f : R[X]) :
    Algebra.adjoin R ({aeval x f} : Set K) →ₐ[R] Algebra.adjoin R ({x} : Set K) :=
  Subalgebra.inclusion (Algebra.adjoin_le
    (Set.singleton_subset_iff.mpr (Polynomial.aeval_mem_adjoin_singleton R x)))

/-- A positive-degree monic polynomial makes the original adjunction finite
over the literal subalgebra generated by its value. -/
theorem finite_adjoin_singleton_over_polynomial_value
    (x : K) (f : R[X]) (hf : f.Monic) (hdeg : 0 < f.natDegree) :
    letI : Algebra (Algebra.adjoin R ({aeval x f} : Set K))
        (Algebra.adjoin R ({x} : Set K)) :=
      (polynomialValueInclusion R x f).toRingHom.toAlgebra
    Module.Finite (Algebra.adjoin R ({aeval x f} : Set K))
      (Algebra.adjoin R ({x} : Set K)) := by
  let B := Algebra.adjoin R ({aeval x f} : Set K)
  let S := Algebra.adjoin R ({x} : Set K)
  let i : B →ₐ[R] S := polynomialValueInclusion R x f
  let : Algebra B S := i.toRingHom.toAlgebra
  let : IsScalarTower R B S := IsScalarTower.of_algHom i
  let z : S := adjoinSingletonGenerator R x
  let u : B := adjoinSingletonGenerator R (aeval x f)
  let g : B[X] := f.map (algebraMap R B) - C u
  have hg : g.Monic := by
    apply (hf.map (algebraMap R B)).sub_of_left
    apply degree_lt_degree
    rw [natDegree_C, hf.natDegree_map]
    exact hdeg
  have hz : IsIntegral B z := by
    refine ⟨g, hg, ?_⟩
    change aeval z (f.map (algebraMap R B) - C u) = 0
    rw [_root_.map_sub, Polynomial.aeval_map_algebraMap B z f, aeval_C]
    apply sub_eq_zero.mpr
    apply Subtype.ext
    change (aeval (adjoinSingletonGenerator R x) f : K) = aeval x f
    simp only [adjoinSingletonGenerator, Polynomial.coe_aeval_mk_apply]
  let : Module.Finite B (Algebra.adjoin B ({z} : Set S)) :=
    Algebra.finite_adjoin_simple_of_isIntegral hz
  have htop : Algebra.adjoin B ({z} : Set S) = ⊤ := by
    rw [Algebra.adjoin_singleton_eq_range_aeval]
    apply (AlgHom.range_eq_top _).mpr
    intro s
    obtain ⟨p, hp⟩ := aeval_adjoinSingletonGenerator_surjective R x s
    refine ⟨p.map (algebraMap R B), ?_⟩
    rw [Polynomial.aeval_map_algebraMap B z p]
    exact hp
  let : Module.Finite B (⊤ : Subalgebra B S) := by
    rw [← htop]
    infer_instance
  change Module.Finite B S
  exact Module.Finite.of_surjective (Subalgebra.val (⊤ : Subalgebra B S)).toLinearMap
    (fun s => ⟨⟨s, trivial⟩, rfl⟩)

end Algebra

namespace Algebra

universe u

theorem exists_aeval_mem_leadingCoeff_not_mem
    (R K : Type u) [CommRing R] [Field K] [Algebra R K] (x : K)
    (m : Ideal (Algebra.adjoin R ({x} : Set K))) [m.IsMaximal] :
    ∃ f : R[X], aeval (adjoinSingletonGenerator R x) f ∈ m ∧
      f.leadingCoeff ∉ m.comap (algebraMap R (Algebra.adjoin R ({x} : Set K))) := by
  let S := Algebra.adjoin R ({x} : Set K)
  let L := S ⧸ m
  let : Field L := Ideal.Quotient.field m
  let p : Ideal R := m.comap (algebraMap R S)
  let D := R ⧸ p
  let k := FractionRing D
  let : Algebra D L := inferInstance
  let : IsScalarTower R D L := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hinj : Function.Injective (algebraMap D L) :=
    Ideal.algebraMap_quotient_injective (R := R) (I := m)
  let : FaithfulSMul D L := (faithfulSMul_iff_algebraMap_injective D L).mpr hinj
  let : Algebra k L := FractionRing.liftAlgebra D L
  let : IsScalarTower D k L := FractionRing.isScalarTower_liftAlgebra D L
  let : IsScalarTower R D k := inferInstance
  let : IsScalarTower R k L := IsScalarTower.to₁₃₄ R D k L
  let : Algebra.FiniteType R S := Algebra.FiniteType.adjoin_of_finite (Set.finite_singleton x)
  let : Algebra.FiniteType R L := Algebra.FiniteType.of_surjective
    (Ideal.Quotient.mkₐ R m) Ideal.Quotient.mk_surjective
  let : Algebra.FiniteType k L := Algebra.FiniteType.of_restrictScalars_finiteType R k L
  let : Module.Finite k L := finite_of_finite_type_of_isJacobsonRing k L
  let z : L := Ideal.Quotient.mk m (adjoinSingletonGenerator R x)
  have hz : IsAlgebraic D z := (IsFractionRing.isAlgebraic_iff D k L).mpr
    (Algebra.IsAlgebraic.isAlgebraic (R := k) z)
  obtain ⟨g, hg, hgz⟩ := hz
  obtain ⟨f, hf, hdegree⟩ := Polynomial.exists_natDegree_eq_of_mem_lifts
    (Polynomial.mem_lifts_of_surjective (f := Ideal.Quotient.mk p)
      Ideal.Quotient.mk_surjective g)
  refine ⟨f, ?_, ?_⟩
  · apply Ideal.Quotient.eq_zero_iff_mem.mp
    calc
      Ideal.Quotient.mk m (aeval (adjoinSingletonGenerator R x) f) = aeval z f :=
        (Polynomial.aeval_algHom_apply (Ideal.Quotient.mkₐ R m)
          (adjoinSingletonGenerator R x) f).symm
      _ = aeval z (f.map (algebraMap R D)) :=
        (Polynomial.aeval_map_algebraMap D z f).symm
      _ = 0 := by
        rw [Ideal.Quotient.algebraMap_eq p, hf]
        exact hgz
  · intro hlead
    have hzero : Ideal.Quotient.mk p f.leadingCoeff = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr hlead
    have hleadmap : Ideal.Quotient.mk p f.leadingCoeff = g.leadingCoeff := by
      change Ideal.Quotient.mk p (f.coeff f.natDegree) = g.coeff g.natDegree
      rw [hdegree, ← Polynomial.coeff_map, hf]
    exact hg (Polynomial.leadingCoeff_eq_zero.mp (hleadmap.symm.trans hzero))

end Algebra

namespace Algebra

variable (R A : Type*) [CommRing R] [CommRing A] [Algebra R A]
  {K : Type*} [Field K] [Algebra R K] [Algebra A K] [IsScalarTower R A K]

/-- The localization axioms are checked at variable rings and their original
field embeddings, before specializing the generated subalgebras. -/
private theorem isLocalization_of_fraction_denominators
    (R S T K : Type*) [CommRing R] [CommRing S] [CommRing T] [CommRing K]
    [Algebra R S] [Algebra R T] [Algebra R K] [Algebra S T] [Algebra S K]
    [Algebra T K] [IsScalarTower R S T] [IsScalarTower R S K]
    [IsScalarTower S T K] (M : Submonoid R)
    (hS : Function.Injective (algebraMap S K))
    (hT : Function.Injective (algebraMap T K))
    (hunit : ∀ r : M, IsUnit (algebraMap R T r))
    (hden : ∀ y : T, ∃ r : M, ∃ s : S,
      algebraMap S K s = algebraMap R K r * algebraMap T K y) :
    IsLocalization (Algebra.algebraMapSubmonoid S M) T := by
  apply (_root_.isLocalization_iff (Algebra.algebraMapSubmonoid S M) T).mpr
  refine ⟨?_, ?_, ?_⟩
  · rintro ⟨_, r, hr, rfl⟩
    change IsUnit (algebraMap S T (algebraMap R S r))
    rw [← IsScalarTower.algebraMap_apply R S T]
    exact hunit ⟨r, hr⟩
  · intro y
    obtain ⟨r, s, hs⟩ := hden y
    refine ⟨⟨s, ⟨algebraMap R S r.val, ⟨r.val, r.property, rfl⟩⟩⟩, ?_⟩
    apply hT
    calc
      algebraMap T K (y * algebraMap S T (algebraMap R S r.val)) =
          algebraMap T K y * algebraMap R K r.val := by
        rw [_root_.map_mul, ← IsScalarTower.algebraMap_apply S T K,
          ← IsScalarTower.algebraMap_apply R S K]
      _ = algebraMap S K s := (mul_comm _ _).trans hs.symm
      _ = algebraMap T K (algebraMap S T s) := IsScalarTower.algebraMap_apply S T K s
  · intro x y h
    have he : x = y := hS (by
      calc
        algebraMap S K x = algebraMap T K (algebraMap S T x) :=
          IsScalarTower.algebraMap_apply S T K x
        _ = algebraMap T K (algebraMap S T y) := congrArg (algebraMap T K) h
        _ = algebraMap S K y := (IsScalarTower.algebraMap_apply S T K y).symm)
    exact ⟨1, by simpa only [OneMemClass.coe_one, one_mul] using he⟩

/-- The original inclusion of the singleton-generated algebra after extending
its coefficient ring inside the same field. -/
def adjoinSingletonScalarExtension (x : K) :
    Algebra.adjoin R ({x} : Set K) →ₐ[R] Algebra.adjoin A ({x} : Set K) :=
  Subalgebra.inclusion (Algebra.adjoin_le (S :=
    (Algebra.adjoin A ({x} : Set K)).restrictScalars R)
    (Set.singleton_subset_iff.mpr (Algebra.self_mem_adjoin_singleton A x)))

/-- The coefficient action of the literal inclusion, named identically in
the localization producer and its consumers. -/
@[instance_reducible]
def adjoinSingletonScalarExtensionAlgebra (x : K) :
    Algebra (Algebra.adjoin R ({x} : Set K)) (Algebra.adjoin A ({x} : Set K)) :=
  (adjoinSingletonScalarExtension R A x).toRingHom.toAlgebra

set_option maxHeartbeats 400000 in
-- The variable-ring criterion uses the standard budget. Its concrete specialization
-- exceeded 200000 kernel heartbeats in remote-ab2c32b2 and remote-873a3090 after
-- representation repairs. Keep this finite allowance local to the actual adapter.
/-- Localization of the coefficients localizes the literal singleton adjoin
at exactly the images of the coefficient denominators. -/
theorem isLocalization_adjoin_singleton (M : Submonoid R) [IsLocalization M A]
    (x : K) :
    letI : Algebra (Algebra.adjoin R ({x} : Set K)) (Algebra.adjoin A ({x} : Set K)) :=
      adjoinSingletonScalarExtensionAlgebra R A x
    IsLocalization (Algebra.algebraMapSubmonoid (Algebra.adjoin R ({x} : Set K)) M)
      (Algebra.adjoin A ({x} : Set K)) := by
  let S := Algebra.adjoin R ({x} : Set K)
  let T := Algebra.adjoin A ({x} : Set K)
  let i : S →ₐ[R] T := adjoinSingletonScalarExtension R A x
  let : Algebra S T := adjoinSingletonScalarExtensionAlgebra R A x
  let : IsScalarTower R S T := IsScalarTower.of_algHom i
  let : IsScalarTower S T K := IsScalarTower.of_algebraMap_eq fun _ => rfl
  apply isLocalization_of_fraction_denominators R S T K M
    Subtype.val_injective Subtype.val_injective
  · intro r
    rw [IsScalarTower.algebraMap_apply R A T]
    exact (IsLocalization.map_units A r).map (algebraMap A T)
  · intro y
    obtain ⟨r, hr⟩ := multiple_mem_adjoin_of_mem_localization_adjoin
      M A ({x} : Set K) (y : K) y.property
    refine ⟨r, ⟨r.val • (y : K), hr⟩, ?_⟩
    exact Algebra.smul_def r.val (y : K)

end Algebra

namespace IsLocalization

/-- Localization does not increase Krull dimension, through the actual
contraction order embedding on prime ideals. -/
theorem ringKrullDim_le (R A : Type*) [CommRing R] [CommRing A] [Algebra R A]
    (M : Submonoid R) [IsLocalization M A] : ringKrullDim A ≤ ringKrullDim R := by
  apply Order.krullDim_le_of_strictMono (fun p : PrimeSpectrum A =>
    (⟨p.asIdeal.comap (algebraMap R A), inferInstance⟩ : PrimeSpectrum R))
  intro p q hpq
  exact (IsLocalization.orderEmbedding M A).strictMono hpq

end IsLocalization
