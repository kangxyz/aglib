module

public import Aglib.RingTheory.LocalRing.ResidueSpanAnnihilator

/-!
# A common multiplier for original ideal generators

This is the ideal-valued application of finite-module residue-fiber detection.
The residue field is that of the original prime in the original ring. The
conclusion is literal membership in the ideal generated by the selected
original elements, not membership in an auxiliary quotient or localization.
-/

@[expose] public section

noncomputable section

open TensorProduct

namespace Ideal

variable {A ι : Type*} [CommRing A] [IsNoetherianRing A]

/-- If selected elements span the original ideal's residue fiber, one element
outside the prime multiplies the entire original ideal into their ideal span. -/
theorem exists_notMem_mul_mem_span_of_residue_span
    (q : Ideal A) [q.IsPrime] (v : ι → q)
    (hspan : Submodule.span q.ResidueField
      (Set.range fun i => (1 : q.ResidueField) ⊗ₜ[A] v i) = ⊤) :
    ∃ h : A, h ∉ q ∧ ∀ f ∈ q, h * f ∈ Ideal.span (Set.range fun i => (v i : A)) := by
  obtain ⟨h, hh, hv⟩ := Module.exists_notMem_smul_mem_span_of_residue_span
    (⟨q, inferInstance⟩ : PrimeSpectrum A) v hspan
  refine ⟨h, hh, fun f hf => ?_⟩
  have hle : Submodule.span A (Set.range v) ≤
      Submodule.comap q.subtype (Ideal.span (Set.range fun i => (v i : A))) := by
    apply Submodule.span_le.mpr
    rintro _ ⟨i, rfl⟩
    exact Ideal.subset_span ⟨i, rfl⟩
  exact hle (hv ⟨f, hf⟩)

/-- A finite ideal may be tested at a different prime containing it. The result
is a literal common multiplier in the original ring. -/
theorem exists_notMem_mul_mem_span_of_residue_span_at
    (I J : Ideal A) [J.IsPrime] (v : ι → I)
    (hspan : Submodule.span J.ResidueField
      (Set.range fun i => (1 : J.ResidueField) ⊗ₜ[A] v i) = ⊤) :
    ∃ h : A, h ∉ J ∧ ∀ f ∈ I, h * f ∈ Ideal.span (Set.range fun i => (v i : A)) := by
  obtain ⟨h, hh, hv⟩ := Module.exists_notMem_smul_mem_span_of_residue_span
    (⟨J, inferInstance⟩ : PrimeSpectrum A) v hspan
  refine ⟨h, hh, fun f hf => ?_⟩
  have hle : Submodule.span A (Set.range v) ≤
      Submodule.comap I.subtype (Ideal.span (Set.range fun i => (v i : A))) := by
    apply Submodule.span_le.mpr
    rintro _ ⟨i, rfl⟩
    exact Ideal.subset_span ⟨i, rfl⟩
  exact hle (hv ⟨f, hf⟩)

end Ideal
