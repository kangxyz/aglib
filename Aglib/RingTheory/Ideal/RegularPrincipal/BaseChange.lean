module

public import Aglib.RingTheory.Ideal.RegularPrincipal
public import Aglib.RingTheory.Flat.IdealBaseChange

/-!
# Canonical base change of regular principal kernels

The existing scalar-extension map of ring kernels is an isomorphism if the source
kernel is generated by a regular element and the target kernel is generated by
its regular image. No flatness or finiteness assumption is used.
-/

@[expose] public section

noncomputable section

set_option autoImplicit false
set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open CategoryTheory Limits TensorProduct
open scoped ChangeOfRings

universe u

namespace Ideal

/-- Multiplication by a regular generator identifies the ring with the actual ideal.
The forward map is the existing `LinearMap.toSpanSingleton`. -/
theorem toSpanSingleton_bijective_of_regular_generator {R : Type u} [CommRing R]
    (I : Ideal R) (r : R) (hr : IsSMulRegular R r) (hI : I = Ideal.span {r}) :
    Function.Bijective (LinearMap.toSpanSingleton R I
      (⟨r, hI ▸ Ideal.mem_span_singleton_self r⟩ : I)) := by
  constructor
  · intro a b hab
    apply hr
    simpa only [LinearMap.toSpanSingleton_apply, Submodule.coe_smul_of_tower,
      smul_eq_mul, mul_comm] using congrArg Subtype.val hab
  · intro a
    have ha : a.val ∈ Ideal.span {r} := hI ▸ a.property
    obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp ha
    exact ⟨b, Subtype.ext hb⟩

end Ideal

namespace ModuleCat

/-- The already defined scalar-extension unit map is an isomorphism for every ring map. -/
theorem scalarExtensionUnit_isIso {R S : CommRingCat.{u}} (b : R ⟶ S) :
    IsIso (scalarExtensionUnit b) := by
  let : Algebra R S := b.hom.toAlgebra
  let e : (extendScalars b.hom).obj (of R R) ≅ of S S :=
    extendScalarsAlgebraIso R S (of R R) ≪≫
      (AlgebraTensorModule.rid R S S).toModuleIso
  have he : scalarExtensionUnit b = e.hom := by
    apply ExtendScalars.hom_ext
    intro r
    change scalarExtensionUnit b ((1 : S) ⊗ₜ[R,b.hom] r) =
      (AlgebraTensorModule.rid R S S)
        ((extendScalarsAlgebraIso R S (of R R)).hom ((1 : S) ⊗ₜ[R,b.hom] r))
    rw [extendScalarsAlgebraIso_tmul, AlgebraTensorModule.rid_tmul]
    change (1 : S) * b r = b r * 1
    simp
  rw [he]
  infer_instance

/-- The canonical scalar-extended kernel map is an isomorphism when both displayed
kernels have the corresponding regular principal generators. The square need only
commute; its cartesian property can be used separately to establish the target kernel. -/
theorem extendedKernelMap_isIso_of_regularPrincipal
    {R S R' S' : CommRingCat.{u}} (φ : R ⟶ S) (φ' : R' ⟶ S')
    (b : R ⟶ R') (a : S ⟶ S') (h : φ ≫ a = b ≫ φ')
    (r : R) (hr : IsSMulRegular R r)
    (hI : RingHom.ker φ.hom = Ideal.span {r})
    (hr' : IsSMulRegular R' (b r))
    (hI' : RingHom.ker φ'.hom = Ideal.span {b r}) :
    IsIso (extendedKernelMap φ φ' b a h) := by
  let g : of R R ⟶ of R (RingHom.ker φ.hom) :=
    ofHom (LinearMap.toSpanSingleton R (RingHom.ker φ.hom)
      ⟨r, hI ▸ Ideal.mem_span_singleton_self r⟩)
  let g' : of R' R' ⟶ of R' (RingHom.ker φ'.hom) :=
    ofHom (LinearMap.toSpanSingleton R' (RingHom.ker φ'.hom)
      ⟨b r, hI' ▸ Ideal.mem_span_singleton_self (b r)⟩)
  have : IsIso g := (ConcreteCategory.isIso_iff_bijective g).mpr
    (Ideal.toSpanSingleton_bijective_of_regular_generator _ r hr hI)
  have : IsIso g' := (ConcreteCategory.isIso_iff_bijective g').mpr
    (Ideal.toSpanSingleton_bijective_of_regular_generator _ (b r) hr' hI')
  have : IsIso (scalarExtensionUnit b) := scalarExtensionUnit_isIso b
  have hc : (extendScalars b.hom).map g ≫ extendedKernelMap φ φ' b a h =
      scalarExtensionUnit b ≫ g' := by
    apply ExtendScalars.hom_ext
    intro x
    apply Subtype.ext
    change ((extendedKernelMap φ φ' b a h)
      ((extendScalars b.hom).map g ((1 : R') ⊗ₜ[R,b.hom] x)) : R') =
        (g' (scalarExtensionUnit b ((1 : R') ⊗ₜ[R,b.hom] x)) : R')
    rw [ExtendScalars.map_tmul, spectralExtendedIdealMap_tmul]
    change (1 : R') * b (x * r) = ((1 : R') * b x) * b r
    simp only [one_mul, map_mul]
  apply (isIso_comp_left_iff ((extendScalars b.hom).map g) _).mp
  rw [hc]
  infer_instance

end ModuleCat
