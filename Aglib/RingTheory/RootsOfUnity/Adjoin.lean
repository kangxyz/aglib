module

public import Mathlib.RingTheory.Etale.StandardEtale

/-!
# Finite formally unramified root subalgebras

The literal subalgebra generated by an element satisfying `ζ ^ n = 1` is
finite over its coefficient ring when `n ≠ 0`. If the integer `n` is a unit
in that ring, the standard étale presentation for `X ^ n - 1` surjects onto
this subalgebra and proves formal unramifiedness. The construction preserves
the specified ambient algebra and distinguished root; no valuation-ring,
local-ring, completeness or residue-field hypothesis is required.

## Extraction basis

Transferred from `R5Lab.RingTheory.DiscreteValuationRing.UnramifiedRoots` at source revision
`95a3772b895fbc19a81684be4ffd519d0fdcd6b3`, SHA-256
`0ff5d84f4fc799b1f1f162206a2913476d4ebf9d10f5cccd5f0ea04bcfc2dc5d`.
This module contains the `RootAlgebra` section (source lines 27–109), including the actual root,
finite-module proof, standard étale presentation, surjection and formal-unramifiedness proof;
all other source interfaces remain outside this extraction.
-/

@[expose] public section

noncomputable section

namespace Algebra.RootsOfUnity

open Polynomial IsLocalRing

universe u v

section RootAlgebra

variable (R : Type u) [CommRing R] {A : Type v} [CommRing A] [Algebra R A]

/-- The literal subalgebra generated by the specified root. -/
abbrev RootAlgebra (ζ : A) := Algebra.adjoin R ({ζ} : Set A)

/-- Its distinguished generator. -/
def root (ζ : A) : RootAlgebra R ζ := ⟨ζ, Algebra.subset_adjoin (Set.mem_singleton ζ)⟩

@[simp] theorem root_coe (ζ : A) : (root R ζ : A) = ζ := rfl

theorem root_pow {ζ : A} {n : ℕ} (hζ : ζ ^ n = 1) : (root R ζ) ^ n = 1 :=
  Subtype.ext hζ

/-- Any positive-order root of unity is integral over its coefficient ring. -/
theorem root_isIntegral {ζ : A} {n : ℕ} (hn : n ≠ 0) (hζ : ζ ^ n = 1) :
    IsIntegral R ζ :=
  ⟨X ^ n - C 1, monic_X_pow_sub_C 1 hn, by simp [hζ]⟩

/-- The actual root subalgebra is a finite module. -/
theorem rootAlgebra_finite {ζ : A} {n : ℕ} (hn : n ≠ 0) (hζ : ζ ^ n = 1) :
    Module.Finite R (RootAlgebra R ζ) :=
  Algebra.finite_adjoin_simple_of_isIntegral (root_isIntegral R hn hζ)

/-- The standard étale presentation uses the explicit root polynomial and
inverts its derivative. Its étale identity is tautological and constructive. -/
def rootEtalePair (n : ℕ) (hn : n ≠ 0) : StandardEtalePair R where
  f := X ^ n - C 1
  monic_f := monic_X_pow_sub_C 1 hn
  g := derivative (X ^ n - C 1)
  cond := ⟨1, 0, 1, by simp⟩

/-- The distinguished root is a unit in the actual root subalgebra. -/
theorem root_isUnit {ζ : A} {n : ℕ} (hn : n ≠ 0) (hζ : ζ ^ n = 1) :
    IsUnit (root R ζ) := by
  apply IsUnit.of_mul_eq_one ((root R ζ) ^ (n - 1))
  rw [← pow_succ', Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr hn)]
  exact root_pow R hζ

/-- Invertibility of the integer `n` makes the derivative at the root a unit. -/
theorem rootEtalePair_hasMap {ζ : A} {n : ℕ} (hn : n ≠ 0)
    (hnR : IsUnit (n : R)) (hζ : ζ ^ n = 1) :
    (rootEtalePair R n hn).HasMap (root R ζ) := by
  constructor
  · change aeval (root R ζ) (X ^ n - C 1) = 0
    simp [root_pow R hζ]
  · change IsUnit (aeval (root R ζ) (derivative (X ^ n - C 1)))
    simp only [derivative_sub, derivative_X_pow, derivative_C, sub_zero,
      map_mul, aeval_C, map_pow, aeval_X]
    exact (hnR.map (algebraMap R (RootAlgebra R ζ))).mul ((root_isUnit R hn hζ).pow _)

/-- The actual standard étale algebra surjects onto the specified root subalgebra. -/
def rootEtaleSurjection {ζ : A} {n : ℕ} (hn : n ≠ 0)
    (hnR : IsUnit (n : R)) (hζ : ζ ^ n = 1) :
    (rootEtalePair R n hn).Ring →ₐ[R] RootAlgebra R ζ :=
  (rootEtalePair R n hn).lift (root R ζ) (rootEtalePair_hasMap R hn hnR hζ)

theorem rootEtaleSurjection_surjective {ζ : A} {n : ℕ} (hn : n ≠ 0)
    (hnR : IsUnit (n : R)) (hζ : ζ ^ n = 1) :
    Function.Surjective (rootEtaleSurjection R hn hnR hζ) := by
  intro b
  have hb : (b : A) ∈ (aeval (R := R) ζ).range := by
    rw [← Algebra.adjoin_singleton_eq_range_aeval]
    exact b.property
  obtain ⟨p, hp⟩ := hb
  refine ⟨aeval (rootEtalePair R n hn).X p, ?_⟩
  apply Subtype.ext
  rw [← aeval_algHom_apply]
  simp only [rootEtaleSurjection, StandardEtalePair.lift_X]
  change (RootAlgebra R ζ).val (aeval (root R ζ) p) = b.val
  rw [← aeval_algHom_apply]
  exact hp

/-- This constructs formal unramifiedness of the actual finite root subalgebra,
without assuming a pre-existing unramified extension. -/
theorem rootAlgebra_formallyUnramified {ζ : A} {n : ℕ} (hn : n ≠ 0)
    (hnR : IsUnit (n : R)) (hζ : ζ ^ n = 1) :
    Algebra.FormallyUnramified R (RootAlgebra R ζ) :=
  Algebra.FormallyUnramified.of_surjective (rootEtaleSurjection R hn hnR hζ)
    (rootEtaleSurjection_surjective R hn hnR hζ)

end RootAlgebra

end Algebra.RootsOfUnity
