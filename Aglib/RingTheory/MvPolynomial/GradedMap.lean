module

public import Mathlib.RingTheory.MvPolynomial.Homogeneous
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Maps

/-!
# Graded coefficient maps of polynomial rings

The native coefficient map preserves the actual total-degree homogeneous
submodules and carries the irrelevant ideal onto the irrelevant ideal.
The variable-ideal normalization is the sole implementation formerly placed
in `AlgebraicGeometry/ProjectiveSpace/Basic.lean`; its proof is unchanged.
-/

@[expose] public section

noncomputable section

attribute [local instance] MvPolynomial.gradedAlgebra

namespace MvPolynomial

section Semiring

variable {R S T ι : Type*} [CommSemiring R] [CommSemiring S] [CommSemiring T]

/-- The native polynomial coefficient map as a homomorphism of total-degree graded rings. -/
def gradedMap (f : R →+* S) : homogeneousSubmodule ι R →+*ᵍ homogeneousSubmodule ι S where
  __ := MvPolynomial.map f
  map_mem hp := hp.map f

@[simp]
theorem gradedMap_apply (f : R →+* S) (p : MvPolynomial ι R) :
    gradedMap f p = MvPolynomial.map f p := rfl

@[simp]
theorem gradedMap_id : gradedMap (ι := ι) (RingHom.id R) =
    GradedRingHom.id (homogeneousSubmodule ι R) := by
  apply GradedRingHom.ext
  intro p
  change MvPolynomial.map (RingHom.id R) p = p
  exact MvPolynomial.map_id p

@[simp]
theorem gradedMap_comp (g : S →+* T) (f : R →+* S) :
    gradedMap (ι := ι) (g.comp f) = (gradedMap g).comp (gradedMap f) := by
  apply GradedRingHom.ext
  intro p
  change MvPolynomial.map (g.comp f) p = MvPolynomial.map g (MvPolynomial.map f p)
  simp only [MvPolynomial.map_map]

end Semiring

/-- For the total-degree grading, the irrelevant ideal is the ideal generated by the variables.
-/
theorem irrelevant_homogeneousSubmodule_eq_idealOfVars (R ι : Type*) [CommRing R] :
    (HomogeneousIdeal.irrelevant (homogeneousSubmodule ι R)).toIdeal = idealOfVars ι R := by
  apply le_antisymm
  · apply (HomogeneousIdeal.toIdeal_irrelevant_le _).mpr
    intro n hn p hp
    change p ∈ idealOfVars ι R
    rw [← pow_one (idealOfVars ι R), mem_pow_idealOfVars_iff]
    intro d hd
    have hdeg : d.degree = n := by
      simpa [Finsupp.degree_eq_weight_one, ← Pi.one_def] using hp (mem_support_iff.mp hd)
    simpa [hdeg] using Nat.succ_le_iff.mpr hn
  · apply Ideal.span_le.mpr
    rintro p ⟨i, rfl⟩
    exact HomogeneousIdeal.mem_irrelevant_of_mem _ Nat.zero_lt_one (isHomogeneous_X R i)

section Ring

variable {R S ι : Type*} [CommRing R] [CommRing S]

/-- Every coefficient homomorphism maps the original irrelevant ideal onto the new one. -/
theorem irrelevant_map_gradedMap (f : R →+* S) :
    (HomogeneousIdeal.irrelevant (homogeneousSubmodule ι R)).map (gradedMap f) =
      HomogeneousIdeal.irrelevant (homogeneousSubmodule ι S) := by
  apply HomogeneousIdeal.ext
  rw [HomogeneousIdeal.toIdeal_map, irrelevant_homogeneousSubmodule_eq_idealOfVars,
    irrelevant_homogeneousSubmodule_eq_idealOfVars]
  change Ideal.map (MvPolynomial.map f) (Ideal.span (Set.range (X : ι → MvPolynomial ι R))) =
    Ideal.span (Set.range (X : ι → MvPolynomial ι S))
  rw [Ideal.map_span, ← Set.range_comp]
  simp only [Function.comp_def, MvPolynomial.map_X]

end Ring

end MvPolynomial
