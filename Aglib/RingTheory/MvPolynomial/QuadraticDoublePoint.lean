/-!
# Exact quadratics at original rational double points

The original evaluation kernel is generated by the translated variables.
Membership of a quadratic in its square gives the exact centered quadratic
with unchanged quadratic coefficients, in every characteristic. Equal-degree
homogeneous membership in a principal ideal gives a nonzero scalar multiple.
Binary dehomogenization detects rational double zeros, and the original
bijective coefficient map preserves and reflects homogeneous scalar squares.
Native substitutions retain the needed original point ideals and binary
restrictions. These results do not supply a geometric full-kernel hypothesis.
-/

@[expose] public noncomputable section
set_option autoImplicit false

universe u v

namespace MvPolynomial

section Evaluation

variable {R : Type u} [CommRing R] {σ : Type v}

/-- The original rational evaluation kernel is generated by its actual shifted variables. -/
theorem ker_eval_eq_span_X_sub_C (α : σ → R) :
    RingHom.ker (eval α) = Ideal.span (Set.range fun i => X i - C (α i)) := by
  classical
  let J : Ideal (MvPolynomial σ R) := Ideal.span (Set.range fun i => X i - C (α i))
  let q : MvPolynomial σ R →+* MvPolynomial σ R ⧸ J := Ideal.Quotient.mk J
  have hq : q = (q.comp C).comp (eval α) := by
    apply ringHom_ext
    · intro a
      simp only [RingHom.comp_apply, eval_C]
    · intro i
      simp only [RingHom.comp_apply, eval_X]
      apply sub_eq_zero.mp
      rw [← map_sub]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨i, rfl⟩)
  change RingHom.ker (eval α) = J
  apply le_antisymm
  · intro p hp
    have he : q p = q (C (eval α p)) := RingHom.congr_fun hq p
    change eval α p = 0 at hp
    rw [hp, map_zero, map_zero] at he
    exact Ideal.Quotient.eq_zero_iff_mem.mp he
  · apply Ideal.span_le.mpr
    rintro p ⟨i, rfl⟩
    change eval α (X i - C (α i)) = 0
    simp only [map_sub, eval_X, eval_C, sub_self]

/-- A partial derivation takes the square of the original ideal into that ideal. -/
theorem pderiv_mem_of_mem_ideal_sq (I : Ideal (MvPolynomial σ R))
    {p : MvPolynomial σ R} (hp : p ∈ I ^ 2) (i : σ) : pderiv i p ∈ I := by
  rw [pow_two] at hp
  refine Submodule.mul_induction_on hp ?_ ?_
  · intro a ha b hb
    rw [pderiv_mul]
    exact I.add_mem (I.mul_mem_left _ hb) (I.mul_mem_right _ ha)
  · intro a b ha hb
    simpa only [map_add] using I.add_mem ha hb

end Evaluation

section Quadratic

variable {k : Type u} [Field k]

private theorem quadratic_centered (a b c d e f : k) (α : Fin 2 → k)
    (hQ : QuadraticClosedPoint.quadratic a b c d e f ∈ RingHom.ker (eval α) ^ 2) :
    QuadraticClosedPoint.quadratic a b c d e f =
      C d * (X 1 - C (α 1)) ^ 2 +
        C e * (X 1 - C (α 1)) * (X 0 - C (α 0)) +
          C f * (X 0 - C (α 0)) ^ 2 := by
  let Q := QuadraticClosedPoint.quadratic a b c d e f
  have hval : eval α Q = 0 := (Ideal.pow_le_self (by decide : 2 ≠ 0)) hQ
  have hd0 : eval α (pderiv 0 Q) = 0 :=
    pderiv_mem_of_mem_ideal_sq (RingHom.ker (eval α)) hQ 0
  have hd1 : eval α (pderiv 1 Q) = 0 :=
    pderiv_mem_of_mem_ideal_sq (RingHom.ker (eval α)) hQ 1
  have hTaylor : Q = C (eval α Q) +
      C (eval α (pderiv 0 Q)) * (X 0 - C (α 0)) +
        C (eval α (pderiv 1 Q)) * (X 1 - C (α 1)) +
          C d * (X 1 - C (α 1)) ^ 2 +
            C e * (X 1 - C (α 1)) * (X 0 - C (α 0)) +
              C f * (X 0 - C (α 0)) ^ 2 := by
    simp only [QuadraticClosedPoint.quadratic, Fin.isValue, map_add, eval_C, map_mul,
      eval_X, map_pow, derivation_C, Derivation.leibniz, pderiv_X,
      ne_eq, one_ne_zero, not_false_eq_true, Pi.single_eq_of_ne, smul_eq_mul, mul_zero,
      add_zero, Pi.single_eq_same, mul_one, zero_add, Derivation.leibniz_pow,
      Nat.add_one_sub_one, pow_one, nsmul_eq_mul, Nat.cast_ofNat, eval_ofNat,
      zero_ne_one, Q]
    rw [show (C (2 : k) : MvPolynomial (Fin 2) k) = 2 from map_ofNat C 2]
    ring
  simpa only [hval, hd0, hd1, map_zero, zero_mul, zero_add] using hTaylor

/-- A genuine double zero gives the exact centered quadratic with the original
quadratic coefficients. No division by two or field section is used. -/
theorem quadratic_eq_centered_of_mem_eval_ker_sq
    (F : MvPolynomial (Fin 2) k) (hdeg : F.totalDegree ≤ 2) (α : Fin 2 → k)
    (hF : F ∈ RingHom.ker (eval α) ^ 2) :
    F = C (F.coeff (Finsupp.single 0 2)) * (X 0 - C (α 0)) ^ 2 +
      C (F.coeff (Finsupp.single 0 1 + Finsupp.single 1 1)) *
        (X 0 - C (α 0)) * (X 1 - C (α 1)) +
          C (F.coeff (Finsupp.single 1 2)) * (X 1 - C (α 1)) ^ 2 := by
  have hexp := QuadraticClosedPoint.eq_quadratic_of_totalDegree_le F hdeg
  have hc := quadratic_centered (F.coeff 0) (F.coeff (Finsupp.single 1 1))
    (F.coeff (Finsupp.single 0 1)) (F.coeff (Finsupp.single 1 2))
    (F.coeff (Finsupp.single 1 1 + Finsupp.single 0 1))
    (F.coeff (Finsupp.single 0 2)) α (hexp ▸ hF)
  calc
    F = _ := hexp.trans hc
    _ = _ := by
      rw [show Finsupp.single (1 : Fin 2) 1 + Finsupp.single 0 1 =
        Finsupp.single 0 1 + Finsupp.single 1 1 from add_comm _ _]
      ring

end Quadratic

section Homogeneous

variable {k : Type u} [Field k] {σ : Type v}

/-- Nonzero homogeneous polynomials of the same degree in the same principal
ideal differ by a nonzero scalar. The original polynomials are retained. -/
theorem eq_nonzero_scalar_mul_of_mem_span_of_isHomogeneous
    {f q : MvPolynomial σ k} {n : ℕ}
    (hf : f.IsHomogeneous n) (hf0 : f ≠ 0)
    (hq : q.IsHomogeneous n) (hq0 : q ≠ 0) (hmem : f ∈ Ideal.span {q}) :
    ∃ c : k, c ≠ 0 ∧ f = C c * q := by
  obtain ⟨p, hp⟩ := Ideal.mem_span_singleton.mp hmem
  have hp0 : p ≠ 0 := by
    intro hz
    rw [hz, mul_zero] at hp
    exact hf0 hp
  have hdeg := hf.totalDegree_le
  rw [hp, totalDegree_mul_of_isDomain hq0 hp0, hq.totalDegree hq0] at hdeg
  have hpdeg : p.totalDegree = 0 := by omega
  have hpC := totalDegree_eq_zero_iff_eq_C.mp hpdeg
  refine ⟨p.coeff 0, ?_, ?_⟩
  · intro hc
    apply hp0
    exact hpC.trans (by rw [hc, map_zero])
  · calc
      f = q * p := hp
      _ = C (p.coeff 0) * q := (congrArg (q * ·) hpC).trans (mul_comm _ _)

end Homogeneous


section Binary

variable {k : Type u} [Field k]

/-- A homogeneous binary quadratic has its original three coefficient expansion. -/
theorem eq_binary_quadratic_of_isHomogeneous {q : MvPolynomial (Fin 2) k}
    (hq : q.IsHomogeneous 2) :
    q = C (q.coeff (Finsupp.single 0 2)) * X 0 ^ 2 +
      C (q.coeff (Finsupp.single 0 1 + Finsupp.single 1 1)) * X 0 * X 1 +
        C (q.coeff (Finsupp.single 1 2)) * X 1 ^ 2 := by
  have h0 : q.coeff 0 = 0 := hq.coeff_eq_zero (by simp)
  have hx : q.coeff (Finsupp.single 0 1) = 0 := hq.coeff_eq_zero (by simp)
  have hy : q.coeff (Finsupp.single 1 1) = 0 := hq.coeff_eq_zero (by simp)
  calc
    q = _ := QuadraticClosedPoint.eq_quadratic_of_totalDegree_le q hq.totalDegree_le
    _ = _ := by
      rw [QuadraticClosedPoint.quadratic, h0, hx, hy]
      rw [show Finsupp.single (1 : Fin 2) 1 + Finsupp.single 0 1 =
        Finsupp.single 0 1 + Finsupp.single 1 1 from add_comm _ _]
      simp only [map_zero, zero_mul, zero_add]
      ring

/-- The native binary dehomogenization loses no homogeneous quadratic coefficient. -/
theorem binary_dehom_injective_on_homogeneous_two
    {f g : MvPolynomial (Fin 2) k} (hf : f.IsHomogeneous 2) (hg : g.IsHomogeneous 2)
    (h : eval₂Hom Polynomial.C ![1, Polynomial.X] f =
      eval₂Hom Polynomial.C ![1, Polynomial.X] g) : f = g := by
  have hfexp := eq_binary_quadratic_of_isHomogeneous hf
  have hgexp := eq_binary_quadratic_of_isHomogeneous hg
  rw [hfexp, hgexp] at h
  simp only [map_add, map_mul, map_pow, eval₂Hom_C, eval₂Hom_X',
    Matrix.cons_val_zero, Matrix.cons_val_one, one_pow, mul_one] at h
  have h0 : f.coeff (Finsupp.single 0 2) = g.coeff (Finsupp.single 0 2) := by
    simpa using congrArg (fun p : Polynomial k => p.coeff 0) h
  have h1 : f.coeff (Finsupp.single 0 1 + Finsupp.single 1 1) =
      g.coeff (Finsupp.single 0 1 + Finsupp.single 1 1) := by
    simpa using congrArg (fun p : Polynomial k => p.coeff 1) h
  have h2 : f.coeff (Finsupp.single 1 2) = g.coeff (Finsupp.single 1 2) := by
    simpa using congrArg (fun p : Polynomial k => p.coeff 2) h
  rw [hfexp, hgexp, h0, h1, h2]

/-- A nonzero homogeneous binary quadratic with a rational double zero is
a scalar linear square over that very field, in every characteristic. -/
theorem binary_eq_scalar_square_of_dehom_mem_point_sq
    {q : MvPolynomial (Fin 2) k} (hq : q.IsHomogeneous 2) (hq0 : q ≠ 0) (α : k)
    (hdouble : eval₂Hom Polynomial.C ![1, Polynomial.X] q ∈
      (Ideal.span {Polynomial.X - Polynomial.C α}) ^ 2) :
    ∃ c : k, c ≠ 0 ∧ q = C c * (X 1 - C α * X 0) ^ 2 := by
  let ψ : MvPolynomial (Fin 2) k →+* Polynomial k :=
    eval₂Hom Polynomial.C ![1, Polynomial.X]
  have hp0 : ψ q ≠ 0 := by
    intro hz
    apply hq0
    apply binary_dehom_injective_on_homogeneous_two hq (isHomogeneous_zero (Fin 2) k 2)
    exact hz.trans (map_zero ψ).symm
  have hexp : ψ q =
      Polynomial.C (q.coeff (Finsupp.single 1 2)) * Polynomial.X ^ 2 +
      Polynomial.C (q.coeff (Finsupp.single 0 1 + Finsupp.single 1 1)) * Polynomial.X +
      Polynomial.C (q.coeff (Finsupp.single 0 2)) := by
    have he := congrArg ψ (eq_binary_quadratic_of_isHomogeneous hq)
    simp only [ψ, map_add, map_mul, map_pow, eval₂Hom_C, eval₂Hom_X',
      Matrix.cons_val_zero, Matrix.cons_val_one, one_pow, mul_one] at he
    exact he.trans (by ring)
  have hpdeg : (ψ q).natDegree ≤ 2 := by
    rw [hexp]
    exact Polynomial.natDegree_quadratic_le
  rw [Ideal.span_singleton_pow] at hdouble
  obtain ⟨p, hp⟩ := Ideal.mem_span_singleton.mp hdouble
  change ψ q = (Polynomial.X - Polynomial.C α) ^ 2 * p at hp
  have hpne : p ≠ 0 := by
    intro hz
    apply hp0
    exact hp.trans (by rw [hz, mul_zero])
  have hpdegree : p.natDegree = 0 := by
    rw [hp, Polynomial.natDegree_mul
      (pow_ne_zero 2 (Polynomial.X_sub_C_ne_zero α)) hpne,
      Polynomial.natDegree_pow, Polynomial.natDegree_X_sub_C] at hpdeg
    omega
  have hpC := Polynomial.eq_C_of_natDegree_eq_zero hpdegree
  have hc : p.coeff 0 ≠ 0 := by
    intro hz
    apply hpne
    exact hpC.trans (by rw [hz, map_zero])
  refine ⟨p.coeff 0, hc, ?_⟩
  apply binary_dehom_injective_on_homogeneous_two hq
    ((((isHomogeneous_X (R := k) 1).sub
      ((isHomogeneous_X (R := k) 0).C_mul α)).pow 2).C_mul (p.coeff 0))
  change ψ q = ψ (C (p.coeff 0) * (X 1 - C α * X 0) ^ 2)
  rw [hp]
  calc
    (Polynomial.X - Polynomial.C α) ^ 2 * p =
        Polynomial.C (p.coeff 0) * (Polynomial.X - Polynomial.C α) ^ 2 :=
      (congrArg ((Polynomial.X - Polynomial.C α) ^ 2 * ·) hpC).trans (mul_comm _ _)
    _ = ψ (C (p.coeff 0) * (X 1 - C α * X 0) ^ 2) := by
      simp only [ψ, map_mul, map_pow, map_sub, eval₂Hom_C, eval₂Hom_X',
        Matrix.cons_val_zero, Matrix.cons_val_one, mul_one]

end Binary

section CoefficientMap

variable {R : Type u} {S : Type v} {σ : Type*} [CommSemiring R] [CommSemiring S]

/-- A bijective original coefficient homomorphism preserves and reflects scalar
homogeneous squares. Polynomial surjectivity uses that map itself, not a
replacement field isomorphism or a section of a residue map. -/
theorem exists_scalar_homogeneous_square_map_iff
    (ρ : R →+* S) (hρ : Function.Bijective ρ) (q : MvPolynomial σ R) (n : ℕ) :
    (∃ c : S, c ≠ 0 ∧ ∃ L : MvPolynomial σ S,
      L.IsHomogeneous n ∧ L ≠ 0 ∧ map ρ q = C c * L ^ 2) ↔
    (∃ c : R, c ≠ 0 ∧ ∃ L : MvPolynomial σ R,
      L.IsHomogeneous n ∧ L ≠ 0 ∧ q = C c * L ^ 2) := by
  constructor
  · rintro ⟨c, hc, L, hL, hL0, he⟩
    obtain ⟨d, rfl⟩ := hρ.surjective c
    obtain ⟨K, rfl⟩ := map_surjective ρ hρ.surjective L
    refine ⟨d, ?_, K, IsHomogeneous.of_map hρ.injective hL, ?_, ?_⟩
    · intro hz
      exact hc (by rw [hz, map_zero])
    · intro hz
      exact hL0 (by rw [hz, map_zero])
    · apply map_injective ρ hρ.injective
      simpa only [map_mul, map_pow, map_C] using he
  · rintro ⟨c, hc, L, hL, hL0, rfl⟩
    refine ⟨ρ c, ?_, map ρ L, hL.map ρ, ?_, ?_⟩
    · intro hz
      exact hc (hρ.injective (hz.trans (map_zero ρ).symm))
    · intro hz
      exact hL0 (map_injective ρ hρ.injective (hz.trans (map_zero (map ρ)).symm))
    · simp only [map_mul, map_pow, map_C]

end CoefficientMap

section LinearEvaluation

variable {R : Type u} [CommSemiring R] {σ : Type v} {τ : Type*} [Finite σ]

/-- The original substitution of polynomials of degree at most one into a
homogeneous linear polynomial still has total degree at most one. -/
theorem totalDegree_eval₂Hom_le_one_of_isHomogeneous_one
    (L : MvPolynomial σ R) (hL : L.IsHomogeneous 1)
    (v : σ → MvPolynomial τ R) (hv : ∀ i, (v i).totalDegree ≤ 1) :
    (eval₂Hom C v L).totalDegree ≤ 1 := by
  classical
  let _ := Fintype.ofFinite σ
  have hmem : L ∈ Submodule.span R (Set.range (X : σ → MvPolynomial σ R)) := by
    rw [← homogeneousSubmodule_one_eq_span_X]
    exact hL
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun R).mp hmem
  rw [← hc, map_sum]
  apply totalDegree_finsetSum_le
  intro i _
  rw [Algebra.smul_def, algebraMap_eq, map_mul, eval₂Hom_C, eval₂Hom_X']
  exact (totalDegree_mul _ _).trans
    (by simpa only [totalDegree_C, zero_add] using hv i)

end LinearEvaluation

section OppositeEvaluation

variable {R : Type u} [CommRing R]

/-- The original evaluation that kills the first coordinate sends every
power of the actual rational plane-point ideal into the corresponding
power of the original univariate point ideal. -/
theorem eval_zero_first_mem_point_pow
    (p : MvPolynomial (Fin 2) R) (α : R) (n : ℕ)
    (hp : p ∈ RingHom.ker (eval ![0, α]) ^ n) :
    eval₂Hom Polynomial.C ![0, Polynomial.X] p ∈
      (Ideal.span {Polynomial.X - Polynomial.C α}) ^ n := by
  let ψ : MvPolynomial (Fin 2) R →+* Polynomial R :=
    eval₂Hom Polynomial.C ![0, Polynomial.X]
  let J : Ideal (Polynomial R) := Ideal.span {Polynomial.X - Polynomial.C α}
  have hle : (RingHom.ker (eval ![0, α])).map ψ ≤ J := by
    rw [Ideal.map_le_iff_le_comap, ker_eval_eq_span_X_sub_C]
    apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    change ψ (X i - C (![0, α] i)) ∈ J
    fin_cases i
    · simpa only [ψ, map_sub, eval₂Hom_X', eval₂Hom_C, Matrix.cons_val_zero',
        map_zero, sub_self] using J.zero_mem
    · simpa only [ψ, map_sub, eval₂Hom_X', eval₂Hom_C, Matrix.cons_val_succ',
        Matrix.cons_val_zero'] using (Ideal.mem_span_singleton_self
          (Polynomial.X - Polynomial.C α))
  have hmap := Ideal.mem_map_of_mem ψ hp
  rw [Ideal.map_pow] at hmap
  exact (pow_le_pow_left' hle n) hmap

end OppositeEvaluation

section CenteredNonsquare

variable {k : Type u} [Field k]

/-- The actual centered equation retains a nonzero nonsquare binary quadratic.
Only the original rational point and original three coefficients occur. -/
theorem centered_binary_quadratic_nonsquare
    (Q : MvPolynomial (Fin 2) k) (hQ0 : Q ≠ 0) (hdeg : Q.totalDegree ≤ 2)
    (α : Fin 2 → k) (hQsq : Q ∈ RingHom.ker (eval α) ^ 2)
    (hcase : ¬ ∃ c : k, c ≠ 0 ∧ ∃ l : MvPolynomial (Fin 2) k,
      l.totalDegree ≤ 1 ∧ Q = C c * l ^ 2) :
    let r : MvPolynomial (Fin 2) k :=
      C (Q.coeff (Finsupp.single 0 2)) * X 0 ^ 2 +
      C (Q.coeff (Finsupp.single 0 1 + Finsupp.single 1 1)) * X 0 * X 1 +
      C (Q.coeff (Finsupp.single 1 2)) * X 1 ^ 2
    r ≠ 0 ∧ r.IsHomogeneous 2 ∧
      ¬ ∃ c : k, c ≠ 0 ∧ ∃ L : MvPolynomial (Fin 2) k,
        L.IsHomogeneous 1 ∧ L ≠ 0 ∧ r = C c * L ^ 2 := by
  let r : MvPolynomial (Fin 2) k :=
    C (Q.coeff (Finsupp.single 0 2)) * X 0 ^ 2 +
    C (Q.coeff (Finsupp.single 0 1 + Finsupp.single 1 1)) * X 0 * X 1 +
    C (Q.coeff (Finsupp.single 1 2)) * X 1 ^ 2
  let ψ : MvPolynomial (Fin 2) k →+* MvPolynomial (Fin 2) k :=
    eval₂Hom C (fun i => X i - C (α i))
  have hψ : ψ r = Q := by
    simp only [ψ, r, map_add, map_mul, map_pow, eval₂Hom_C, eval₂Hom_X']
    exact (quadratic_eq_centered_of_mem_eval_ker_sq Q hdeg α hQsq).symm
  change r ≠ 0 ∧ r.IsHomogeneous 2 ∧ _
  refine ⟨?_, ?_, ?_⟩
  · intro hz
    apply hQ0
    rw [← hψ, hz, map_zero]
  · exact (((isHomogeneous_X_pow (R := k) 0 2).C_mul _).add
      (((isHomogeneous_X (R := k) 0).C_mul _).mul (isHomogeneous_X (R := k) 1))).add
        ((isHomogeneous_X_pow (R := k) 1 2).C_mul _)
  · rintro ⟨c, hc, L, hL, _, he⟩
    change r = C c * L ^ 2 at he
    have hldeg : (ψ L).totalDegree ≤ 1 :=
      totalDegree_eval₂Hom_le_one_of_isHomogeneous_one L hL _
        (fun i => (totalDegree_sub_C_le (X i) (α i)).trans (by rw [totalDegree_X]))
    apply hcase
    refine ⟨c, hc, ψ L, hldeg, ?_⟩
    rw [← hψ, he, map_mul, map_pow]
    simp only [ψ, eval₂Hom_C]

end CenteredNonsquare

section RestrictionNonsquare

variable {R : Type u} [CommSemiring R]

/-- A nonzero nonsquare binary restriction excludes a homogeneous scalar
square of the original ternary polynomial. All maps are native substitutions. -/
theorem not_scalar_homogeneous_square_of_first_zero_restriction
    (q : MvPolynomial (Fin 3) R)
    (hr0 : eval₂Hom (C : R →+* MvPolynomial (Fin 2) R) ![0, X 0, X 1] q ≠ 0)
    (hr : ¬ ∃ c : R, c ≠ 0 ∧ ∃ L : MvPolynomial (Fin 2) R,
      L.IsHomogeneous 1 ∧ L ≠ 0 ∧ eval₂Hom C ![0, X 0, X 1] q = C c * L ^ 2) :
    ¬ ∃ c : R, c ≠ 0 ∧ ∃ L : MvPolynomial (Fin 3) R,
      L.IsHomogeneous 1 ∧ L ≠ 0 ∧ q = C c * L ^ 2 := by
  let χ : MvPolynomial (Fin 3) R →+* MvPolynomial (Fin 2) R :=
    eval₂Hom C ![0, X 0, X 1]
  rintro ⟨c, hc, L, hL, _, he⟩
  have hlinear : (χ L).IsHomogeneous 1 := by
    have h := hL.eval₂ (C : R →+* MvPolynomial (Fin 2) R) ![0, X 0, X 1]
      (fun a => isHomogeneous_C _ a) (n := 1) (fun i => by
        fin_cases i
        · exact isHomogeneous_zero (Fin 2) R 1
        · exact isHomogeneous_X _ 0
        · exact isHomogeneous_X _ 1)
    simpa only [χ, coe_eval₂Hom, one_mul] using h
  have hχ : χ q = C c * (χ L) ^ 2 := by
    rw [he, map_mul, map_pow]
    simp only [χ, eval₂Hom_C]
  have hnonzero : χ L ≠ 0 := by
    intro hz
    apply hr0
    change χ q = 0
    rw [hχ, hz, zero_pow (by decide : (2 : ℕ) ≠ 0), mul_zero]
  exact hr ⟨c, hc, χ L, hlinear, hnonzero, hχ⟩

end RestrictionNonsquare

end MvPolynomial

namespace MvPolynomial

variable {R : Type u} [CommSemiring R] {σ τ : Type*}

/-- Native variable reindexing preserves and reflects homogeneous scalar
squares, without altering the original coefficient ring. -/
theorem exists_scalar_homogeneous_square_rename_iff
    (e : σ ≃ τ) (q : MvPolynomial σ R) (n : ℕ) :
    (∃ c : R, c ≠ 0 ∧ ∃ L : MvPolynomial τ R,
      L.IsHomogeneous n ∧ L ≠ 0 ∧ rename e q = C c * L ^ 2) ↔
    (∃ c : R, c ≠ 0 ∧ ∃ L : MvPolynomial σ R,
      L.IsHomogeneous n ∧ L ≠ 0 ∧ q = C c * L ^ 2) := by
  constructor
  · rintro ⟨c, hc, L, hL, hL0, he⟩
    refine ⟨c, hc, rename e.symm L, IsHomogeneous.rename_isHomogeneous hL, ?_, ?_⟩
    · intro hz
      exact hL0 (rename_injective e.symm e.symm.injective
        (hz.trans (map_zero (rename e.symm)).symm))
    · have h := congrArg (rename e.symm) he
      simpa only [rename_rename, e.symm_comp_self, rename_id_apply,
        map_mul, map_pow, rename_C] using h
  · rintro ⟨c, hc, L, hL, hL0, rfl⟩
    refine ⟨c, hc, rename e L, IsHomogeneous.rename_isHomogeneous hL, ?_, ?_⟩
    · intro hz
      exact hL0 (rename_injective e e.injective
        (hz.trans (map_zero (rename e)).symm))
    · simp only [map_mul, map_pow, rename_C]

end MvPolynomial
