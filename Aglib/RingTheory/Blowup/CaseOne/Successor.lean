module

public import Aglib.RingTheory.AssociatedGraded.NativeRing
public import Aglib.RingTheory.Blowup.QuadraticPresentation.Cases
public import Aglib.RingTheory.Blowup.DoubleLine.Marked.Chart
public import Aglib.RingTheory.MvPolynomial.QuadraticDoublePoint

/-!
# Genuine centered relations on the original Case-I chart

The original singular chart point supplies rational coordinates. Finite lifts
of those coordinates and of the original quadratic coefficients give the
specific chart-prime generators. The existing exceptional reduction kernel
then produces an actual quadratic relation divisible by the same original
parameter. Minimality forces its actual cofactor into the child maximal
ideal. Native Rees symbols give a genuine quadratic kernel member, and
the honest Hilbert function identifies its entire canonical kernel.
No cubic relation or coefficient-field section is assumed.
-/

@[expose] public noncomputable section
set_option autoImplicit false

open IsLocalRing

universe u

namespace Localization.Away.CaseOne

variable {A : Type u} [CommRing A] [IsLocalRing A]

/-- The shifted original fraction, with its coefficient lifted in the original local ring. -/
def centeredFraction (t : maximalIdeal A) (g : Fin 2 → maximalIdeal A)
    (a : Fin 2 → A) (i : Fin 2) : Chart A t :=
  SaturatedChart.fractionElement (maximalIdeal A) t (g i) - algebraMap A (Chart A t) (a i)

namespace Presentation

variable {t : maximalIdeal A} {g : Fin 2 → maximalIdeal A} {Q : Plane A}
    (D : Presentation A t g Q)

private theorem reduction_base (a : A) :
    D.reduction (algebraMap A (Chart A t) a) =
      Ideal.Quotient.mk (Ideal.span {Q}) (MvPolynomial.C (residue A a)) :=
  D.coefficient a

private theorem reduction_fraction (i : Fin 2) :
    D.reduction (SaturatedChart.fractionElement (maximalIdeal A) t (g i)) =
      Ideal.Quotient.mk (Ideal.span {Q}) (MvPolynomial.X i) :=
  D.coordinate i

/-- The original reduction retains the actual recentering coefficient. -/
theorem reduction_centeredFraction (a : Fin 2 → A) (i : Fin 2) :
    D.reduction (centeredFraction t g a i) =
      Ideal.Quotient.mk (Ideal.span {Q})
        (MvPolynomial.X i - MvPolynomial.C (residue A (a i))) := by
  rw [centeredFraction, map_sub, D.reduction_fraction, D.reduction_base, map_sub]

variable (M : Ideal (Plane A)) [M.IsMaximal] (hQM : Q ∈ M)

/-- Singularity and Case I produce coordinates in the original residue field
for this very plane point, through its original constant map. -/
theorem exists_rational_coordinates [IsNoetherianRing A] [IsDomain A]
    (ht : (t : A) ≠ 0) (hQ0 : Q ≠ 0) (hdeg : Q.totalDegree ≤ 2)
    (hcase : ¬ ∃ c : ResidueField A, c ≠ 0 ∧ ∃ l : Plane A,
      l.totalDegree ≤ 1 ∧ Q = MvPolynomial.C c * l ^ 2)
    (hsing : ¬ IsRegularLocalRing (D.LocalRing M hQM)) :
    ∃ α : Fin 2 → ResidueField A, M = RingHom.ker (MvPolynomial.eval α) := by
  let : Field (Plane A ⧸ M) := Ideal.Quotient.field M
  have hres := plane_residue_bijective M Q hQ0 hdeg
    (D.equation_mem_sq_of_not_regular M hQM ht hsing) hcase
  choose α hα using fun i : Fin 2 =>
    hres.surjective (Ideal.Quotient.mk M (MvPolynomial.X i))
  have hmap : Ideal.Quotient.mk M =
      (algebraMap (ResidueField A) (Plane A ⧸ M)).comp (MvPolynomial.eval α) := by
    apply MvPolynomial.ringHom_ext
    · intro c
      simp only [RingHom.comp_apply, MvPolynomial.eval_C]
      rfl
    · intro i
      simp only [RingHom.comp_apply, MvPolynomial.eval_X]
      exact (hα i).symm
  refine ⟨α, ?_⟩
  calc
    M = RingHom.ker (Ideal.Quotient.mk M) := Ideal.mk_ker.symm
    _ = RingHom.ker (MvPolynomial.eval α) := by
      rw [hmap]
      exact RingHom.ker_comp_of_injective (MvPolynomial.eval α)
        (algebraMap (ResidueField A) (Plane A ⧸ M)).injective

omit [M.IsMaximal] in
/-- The original chart prime is generated by the same exceptional parameter
and the two literal shifted fractions, not merely some three elements. -/
theorem prime_eq_span_centered (α : Fin 2 → ResidueField A)
    (hM : M = RingHom.ker (MvPolynomial.eval α)) (a : Fin 2 → A)
    (ha : ∀ i, residue A (a i) = α i) :
    D.prime M hQM = Ideal.span
      ({algebraMap A (Chart A t) (t : A), centeredFraction t g a 0,
        centeredFraction t g a 1} : Set (Chart A t)) := by
  let π : Plane A →+* Plane A ⧸ Ideal.span {Q} := Ideal.Quotient.mk (Ideal.span {Q})
  have hMspan : M = Ideal.span
      ({MvPolynomial.X 0 - MvPolynomial.C (α 0),
        MvPolynomial.X 1 - MvPolynomial.C (α 1)} : Set (Plane A)) := by
    rw [hM, MvPolynomial.ker_eval_eq_span_X_sub_C]
    congr 1
    ext p
    simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]
    constructor
    · rintro ⟨i, rfl⟩
      fin_cases i <;> simp
    · rintro (rfl | rfl)
      · exact ⟨0, rfl⟩
      · exact ⟨1, rfl⟩
  have hu (i : Fin 2) : D.reduction (centeredFraction t g a i) =
      π (MvPolynomial.X i - MvPolynomial.C (α i)) := by
    rw [D.reduction_centeredFraction, ha]
  have hmap : (Ideal.span ({centeredFraction t g a 0,
      centeredFraction t g a 1} : Set (Chart A t))).map D.reduction = M.map π := by
    rw [Ideal.map_span, Set.image_pair, hu, hu, hMspan, Ideal.map_span, Set.image_pair]
  have hker : RingHom.ker D.reduction = exceptionalIdeal A t := by
    change RingHom.ker (D.equiv.toRingHom.comp (Ideal.Quotient.mk (exceptionalIdeal A t))) = _
    rw [RingHom.ker_comp_of_injective (Ideal.Quotient.mk (exceptionalIdeal A t))
      D.equiv.injective, Ideal.mk_ker]
  rw [D.prime_eq_comap M hQM, ← hmap,
    Ideal.comap_map_of_surjective' D.reduction D.reduction_surjective, hker]
  simp only [exceptionalIdeal, Ideal.span_insert]
  ac_rfl

/-- The genuine singular Case-I point produces finite original coefficient
lifts, its actual three prime generators, and an actual divided quadratic
relation in the original saturated chart. The relation is not an input. -/
theorem exists_centered_chart_relation [IsNoetherianRing A] [IsDomain A]
    (ht : (t : A) ≠ 0) (hQ0 : Q ≠ 0) (hdeg : Q.totalDegree ≤ 2)
    (hcase : ¬ ∃ c : ResidueField A, c ≠ 0 ∧ ∃ l : Plane A,
      l.totalDegree ≤ 1 ∧ Q = MvPolynomial.C c * l ^ 2)
    (hsing : ¬ IsRegularLocalRing (D.LocalRing M hQM)) :
    ∃ (α : Fin 2 → ResidueField A) (a : Fin 2 → A) (b : Fin 3 → A),
      M = RingHom.ker (MvPolynomial.eval α) ∧
      (∀ i, residue A (a i) = α i) ∧
      residue A (b 0) = Q.coeff (Finsupp.single 0 2) ∧
      residue A (b 1) = Q.coeff (Finsupp.single 0 1 + Finsupp.single 1 1) ∧
      residue A (b 2) = Q.coeff (Finsupp.single 1 2) ∧
      D.prime M hQM = Ideal.span
        ({algebraMap A (Chart A t) (t : A), centeredFraction t g a 0,
          centeredFraction t g a 1} : Set (Chart A t)) ∧
      ∃ H : Chart A t,
        algebraMap A (Chart A t) (b 0) * centeredFraction t g a 0 ^ 2 +
          algebraMap A (Chart A t) (b 1) * centeredFraction t g a 0 * centeredFraction t g a 1 +
            algebraMap A (Chart A t) (b 2) * centeredFraction t g a 1 ^ 2 =
              algebraMap A (Chart A t) (t : A) * H := by
  obtain ⟨α, hM⟩ := D.exists_rational_coordinates M hQM ht hQ0 hdeg hcase hsing
  choose a ha using fun i : Fin 2 => residue_surjective (R := A) (α i)
  let c : Fin 3 → ResidueField A := ![Q.coeff (Finsupp.single 0 2),
    Q.coeff (Finsupp.single 0 1 + Finsupp.single 1 1), Q.coeff (Finsupp.single 1 2)]
  choose b hb using fun i : Fin 3 => residue_surjective (R := A) (c i)
  have hb0 : residue A (b 0) = Q.coeff (Finsupp.single 0 2) := hb 0
  have hb1 : residue A (b 1) = Q.coeff (Finsupp.single 0 1 + Finsupp.single 1 1) := hb 1
  have hb2 : residue A (b 2) = Q.coeff (Finsupp.single 1 2) := hb 2
  have hQsq := D.equation_mem_sq_of_not_regular M hQM ht hsing
  rw [hM] at hQsq
  have hcenter := MvPolynomial.quadratic_eq_centered_of_mem_eval_ker_sq Q hdeg α hQsq
  refine ⟨α, a, b, hM, ha, hb0, hb1, hb2, D.prime_eq_span_centered M hQM α hM a ha, ?_⟩
  let R : Chart A t :=
    algebraMap A (Chart A t) (b 0) * centeredFraction t g a 0 ^ 2 +
      algebraMap A (Chart A t) (b 1) * centeredFraction t g a 0 * centeredFraction t g a 1 +
        algebraMap A (Chart A t) (b 2) * centeredFraction t g a 1 ^ 2
  have hred : D.reduction R = 0 := by
    have hQ : Ideal.Quotient.mk (Ideal.span {Q}) Q = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self Q)
    have hcenter0 := (congrArg (Ideal.Quotient.mk (Ideal.span {Q})) hcenter).symm.trans hQ
    simpa only [R, map_add, map_mul, map_pow, D.reduction_base,
      D.reduction_centeredFraction, ha, hb0, hb1, hb2] using hcenter0
  have hmem : R ∈ exceptionalIdeal A t := by
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    apply D.equiv.injective
    change D.reduction R = D.equiv 0
    simpa only [map_zero] using hred
  obtain ⟨H, hH⟩ := Ideal.mem_span_singleton.mp hmem
  exact ⟨H, hH⟩

end Presentation

end Localization.Away.CaseOne

namespace IsLocalRing

variable {B : Type u} [CommRing B] [IsLocalRing B]

/-- A true quadratic relation and the same minimal parameter force the
actual cofactor into the maximal ideal. -/
theorem cofactor_mem_maximal_of_quadratic_relation
    (t u v : maximalIdeal B) (a b c H : B)
    (ht : (t : B) ∉ maximalIdeal B ^ 2)
    (hrel : a * (u : B) ^ 2 + b * (u : B) * (v : B) + c * (v : B) ^ 2 =
      (t : B) * H) : H ∈ maximalIdeal B := by
  by_contra hH
  apply ht
  apply ((maximalIdeal B ^ 2).mul_unit_mem_iff_mem (notMem_maximalIdeal.mp hH)).mp
  rw [← hrel]
  apply (maximalIdeal B ^ 2).add_mem
  · apply (maximalIdeal B ^ 2).add_mem
    · exact (maximalIdeal B ^ 2).mul_mem_left a (Ideal.pow_mem_pow u.property 2)
    · rw [mul_assoc, pow_two]
      exact (maximalIdeal B * maximalIdeal B).mul_mem_left b
        (Ideal.mul_mem_mul u.property v.property)
  · exact (maximalIdeal B ^ 2).mul_mem_left c (Ideal.pow_mem_pow v.property 2)

/-- Actual generation expands the actual cofactor, without choosing a
coefficient-field section. -/
theorem exists_cofactor_coefficients_of_quadratic_relation
    (t u v : maximalIdeal B) (a b c H : B)
    (hgen : maximalIdeal B = Ideal.span ({(t : B), (u : B), (v : B)} : Set B))
    (ht : (t : B) ∉ maximalIdeal B ^ 2)
    (hrel : a * (u : B) ^ 2 + b * (u : B) * (v : B) + c * (v : B) ^ 2 =
      (t : B) * H) :
    ∃ d e f : B, H = d * (t : B) + e * (u : B) + f * (v : B) := by
  have hH := cofactor_mem_maximal_of_quadratic_relation t u v a b c H ht hrel
  rw [hgen] at hH
  obtain ⟨d, z, hz, hHz⟩ := Ideal.mem_span_insert.mp hH
  obtain ⟨e, f, hef⟩ := Ideal.mem_span_pair.mp hz
  refine ⟨d, e, f, ?_⟩
  rw [← hef] at hHz
  simpa only [add_assoc] using hHz

end IsLocalRing

namespace Localization.Away.CaseOne

variable {A : Type u} [CommRing A] [IsLocalRing A]

/-- A true six-term relation gives membership in the original canonical cone
kernel, using the native Rees symbols and the existing quadratic representation. -/
theorem quadratic_mem_canonicalCone_kernel
    (t u v : maximalIdeal A) (c : Fin 6 → A)
    (hrel : c 0 * (t : A) ^ 2 + c 1 * (u : A) ^ 2 + c 2 * (v : A) ^ 2 +
      c 3 * (t : A) * (u : A) + c 4 * (t : A) * (v : A) +
        c 5 * (u : A) * (v : A) = 0) :
    GradedAlgebra.TernaryQuadratic.quadratic (fun i => residue A (c i)) ∈
      RingHom.ker (canonicalConeMap t ![u, v]) := by
  let I := maximalIdeal A
  let F := canonicalConeMap t ![u, v]
  let T := reesAlgebra.degreeOne I t
  let U := reesAlgebra.degreeOne I u
  let V := reesAlgebra.degreeOne I v
  have hFT : F (MvPolynomial.X 0) = Ideal.Quotient.mk I.associatedGradedIdeal T :=
    canonicalConeMap_X t ![u, v] 0
  have hFU : F (MvPolynomial.X 1) = Ideal.Quotient.mk I.associatedGradedIdeal U :=
    canonicalConeMap_X t ![u, v] 1
  have hFV : F (MvPolynomial.X 2) = Ideal.Quotient.mk I.associatedGradedIdeal V :=
    canonicalConeMap_X t ![u, v] 2
  have hFC (a : A) : F (MvPolynomial.C (residue A a)) =
      Ideal.Quotient.mk I.associatedGradedIdeal (algebraMap A (reesAlgebra I) a) :=
    Ideal.cotangentPolynomialMap_C_mk I (orderedGenerators t ![u, v]) a
  have hrees : algebraMap A (reesAlgebra I) (c 0) * T ^ 2 +
      algebraMap A (reesAlgebra I) (c 1) * U ^ 2 +
      algebraMap A (reesAlgebra I) (c 2) * V ^ 2 +
      algebraMap A (reesAlgebra I) (c 3) * T * U +
      algebraMap A (reesAlgebra I) (c 4) * T * V +
      algebraMap A (reesAlgebra I) (c 5) * U * V = 0 := by
    apply Subtype.ext
    change Polynomial.C (c 0) * Polynomial.monomial 1 (t : A) ^ 2 +
      Polynomial.C (c 1) * Polynomial.monomial 1 (u : A) ^ 2 +
      Polynomial.C (c 2) * Polynomial.monomial 1 (v : A) ^ 2 +
      Polynomial.C (c 3) * Polynomial.monomial 1 (t : A) * Polynomial.monomial 1 (u : A) +
      Polynomial.C (c 4) * Polynomial.monomial 1 (t : A) * Polynomial.monomial 1 (v : A) +
      Polynomial.C (c 5) * Polynomial.monomial 1 (u : A) * Polynomial.monomial 1 (v : A) = 0
    have he : Polynomial.C (c 0) * Polynomial.monomial 1 (t : A) ^ 2 +
        Polynomial.C (c 1) * Polynomial.monomial 1 (u : A) ^ 2 +
        Polynomial.C (c 2) * Polynomial.monomial 1 (v : A) ^ 2 +
        Polynomial.C (c 3) * Polynomial.monomial 1 (t : A) * Polynomial.monomial 1 (u : A) +
        Polynomial.C (c 4) * Polynomial.monomial 1 (t : A) * Polynomial.monomial 1 (v : A) +
        Polynomial.C (c 5) * Polynomial.monomial 1 (u : A) * Polynomial.monomial 1 (v : A) =
        Polynomial.monomial 2
          (c 0 * (t : A) ^ 2 + c 1 * (u : A) ^ 2 + c 2 * (v : A) ^ 2 +
            c 3 * (t : A) * (u : A) + c 4 * (t : A) * (v : A) +
              c 5 * (u : A) * (v : A)) := by
      simp only [Polynomial.monomial_pow, one_mul, Polynomial.C_mul_monomial,
        Polynomial.monomial_mul_monomial, ← map_add]
    rw [he, hrel, map_zero]
  have hmap := congrArg (Ideal.Quotient.mk I.associatedGradedIdeal) hrees
  change F (GradedAlgebra.TernaryQuadratic.quadratic (fun i => residue A (c i))) = 0
  rw [GradedAlgebra.TernaryQuadratic.quadratic_expansion]
  simp only [map_add, map_mul, map_pow, hFT, hFU, hFV, hFC]
  simpa only [map_add, map_mul, map_pow, map_zero] using hmap

/-- Use the original residue action on each native graded component. -/
local instance successorComponentModule (n : ℕ) :
    Module (ResidueField A) (Ideal.associatedGradedQuotientGrading (maximalIdeal A) n) :=
  Submodule.module (Ideal.associatedGradedQuotientGrading (maximalIdeal A) n)

/-- Genuine generation and the actual Hilbert function identify the whole
kernel with a true nonzero quadratic relation, rather than assuming that kernel. -/
theorem canonicalCone_kernel_eq_of_quadratic_relation
    (t u v : maximalIdeal A) (c : Fin 6 → A)
    (hgen : Ideal.span (Set.range fun i => (orderedGenerators t ![u, v] i : A)) =
      maximalIdeal A)
    (hc : (fun i => residue A (c i)) ≠ 0)
    (hrel : c 0 * (t : A) ^ 2 + c 1 * (u : A) ^ 2 + c 2 * (v : A) ^ 2 +
      c 3 * (t : A) * (u : A) + c 4 * (t : A) * (v : A) +
        c 5 * (u : A) * (v : A) = 0)
    (hHilbert : ∀ n, Module.finrank (ResidueField A)
      (Ideal.associatedGradedQuotientGrading (maximalIdeal A) n) = 2 * n + 1) :
    RingHom.ker (canonicalConeMap t ![u, v]) =
      Ideal.span {GradedAlgebra.TernaryQuadratic.quadratic (fun i => residue A (c i))} := by
  let q := GradedAlgebra.TernaryQuadratic.quadratic (fun i => residue A (c i))
  have hq0 : q ≠ 0 := by
    intro hz
    apply hc
    apply GradedAlgebra.TernaryQuadratic.quadratic_injective
    simpa only [q, GradedAlgebra.TernaryQuadratic.quadratic, Pi.zero_apply,
      map_zero, Finset.sum_const_zero] using hz
  obtain ⟨p, hp0, hp, hker, _⟩ := exists_presentation_of_hilbert t ![u, v] hgen hHilbert
  have hmem : q ∈ Ideal.span {p} := by
    rw [← hker]
    exact quadratic_mem_canonicalCone_kernel t u v c hrel
  obtain ⟨a, ha, he⟩ :=
    MvPolynomial.eq_nonzero_scalar_mul_of_mem_span_of_isHomogeneous
      (GradedAlgebra.TernaryQuadratic.quadratic_homogeneous _) hq0 hp hp0 hmem
  change q = MvPolynomial.C a * p at he
  change RingHom.ker (canonicalConeMap t ![u, v]) = Ideal.span {q}
  rw [hker, he]
  exact (Ideal.span_singleton_mul_left_unit
    ((isUnit_iff_ne_zero.mpr ha).map MvPolynomial.C) p).symm

end Localization.Away.CaseOne

namespace Localization.Away.CaseOne.Presentation

variable {A : Type u} [CommRing A] [IsLocalRing A]
    {t : maximalIdeal A} {g : Fin 2 → maximalIdeal A} {Q : Plane A}
    (D : Presentation A t g Q) (M : Ideal (Plane A)) [M.IsMaximal] (hQM : Q ∈ M)

/-- The genuine singular Case-I chart produces the actual local generators,
finite original coefficient lifts and a true nonzero quadratic relation.
No Hilbert function or desired child-kernel equality is assumed here. -/
theorem exists_centered_local_quadratic_relation [IsNoetherianRing A] [IsDomain A]
    (ht : (t : A) ≠ 0) (hQ0 : Q ≠ 0) (hdeg : Q.totalDegree ≤ 2)
    (hcase : ¬ ∃ c : ResidueField A, c ≠ 0 ∧ ∃ l : Plane A,
      l.totalDegree ≤ 1 ∧ Q = MvPolynomial.C c * l ^ 2)
    (hsing : ¬ IsRegularLocalRing (D.LocalRing M hQM)) :
    ∃ (α : Fin 2 → ResidueField A) (a : Fin 2 → A) (b : Fin 3 → A)
        (u v : maximalIdeal (D.LocalRing M hQM)) (d e f : D.LocalRing M hQM),
      M = RingHom.ker (MvPolynomial.eval α) ∧
      (∀ i, residue A (a i) = α i) ∧
      residue A (b 0) = Q.coeff (Finsupp.single 0 2) ∧
      residue A (b 1) = Q.coeff (Finsupp.single 0 1 + Finsupp.single 1 1) ∧
      residue A (b 2) = Q.coeff (Finsupp.single 1 2) ∧
      (u : D.LocalRing M hQM) =
        algebraMap (Chart A t) (D.LocalRing M hQM) (centeredFraction t g a 0) ∧
      (v : D.LocalRing M hQM) =
        algebraMap (Chart A t) (D.LocalRing M hQM) (centeredFraction t g a 1) ∧
      maximalIdeal (D.LocalRing M hQM) = Ideal.span
        ({D.parameter M hQM, (u : D.LocalRing M hQM), (v : D.LocalRing M hQM)} :
          Set (D.LocalRing M hQM)) ∧
      (fun i => residue (D.LocalRing M hQM)
        (![-d, D.localMap M hQM (b 0), D.localMap M hQM (b 2),
          -e, -f, D.localMap M hQM (b 1)] i)) ≠ 0 ∧
      -d * D.parameter M hQM ^ 2 +
        D.localMap M hQM (b 0) * (u : D.LocalRing M hQM) ^ 2 +
        D.localMap M hQM (b 2) * (v : D.LocalRing M hQM) ^ 2 +
        -e * D.parameter M hQM * (u : D.LocalRing M hQM) +
        -f * D.parameter M hQM * (v : D.LocalRing M hQM) +
        D.localMap M hQM (b 1) * (u : D.LocalRing M hQM) * (v : D.LocalRing M hQM) = 0 := by
  obtain ⟨α, a, b, hM, ha, hb0, hb1, hb2, hprime, H, hchart⟩ :=
    D.exists_centered_chart_relation M hQM ht hQ0 hdeg hcase hsing
  let R := D.LocalRing M hQM
  let φ : Chart A t →+* R := algebraMap (Chart A t) R
  have hgenR : maximalIdeal R = Ideal.span
      ({D.parameter M hQM, φ (centeredFraction t g a 0),
        φ (centeredFraction t g a 1)} : Set R) := by
    have hm := congrArg (Ideal.map φ) hprime
    rw [Ideal.map_span, Set.image_insert_eq, Set.image_insert_eq, Set.image_singleton] at hm
    exact (IsLocalization.AtPrime.map_eq_maximalIdeal (D.prime M hQM) R).symm.trans hm
  have hu : φ (centeredFraction t g a 0) ∈ maximalIdeal R := by
    rw [hgenR]
    exact Ideal.subset_span (by simp)
  have hv : φ (centeredFraction t g a 1) ∈ maximalIdeal R := by
    rw [hgenR]
    exact Ideal.subset_span (by simp)
  let u : maximalIdeal R := ⟨φ (centeredFraction t g a 0), hu⟩
  let v : maximalIdeal R := ⟨φ (centeredFraction t g a 1), hv⟩
  let p : maximalIdeal R := ⟨D.parameter M hQM, D.parameter_mem_maximal M hQM⟩
  have hgen : maximalIdeal R = Ideal.span ({(p : R), (u : R), (v : R)} : Set R) := hgenR
  have hmin : (p : R) ∉ maximalIdeal R ^ 2 :=
    D.parameter_not_mem_sq M hQM ht hQ0 hsing
  have hφbase (z : A) : φ (algebraMap A (Chart A t) z) = D.localMap M hQM z := rfl
  have hrel : D.localMap M hQM (b 0) * (u : R) ^ 2 +
      D.localMap M hQM (b 1) * (u : R) * (v : R) +
      D.localMap M hQM (b 2) * (v : R) ^ 2 = (p : R) * φ H := by
    simpa only [map_add, map_mul, map_pow, hφbase, u, v, p, parameter] using
      congrArg φ hchart
  obtain ⟨d, e, f, hH⟩ := IsLocalRing.exists_cofactor_coefficients_of_quadratic_relation
    p u v (D.localMap M hQM (b 0)) (D.localMap M hQM (b 1))
      (D.localMap M hQM (b 2)) (φ H) hgen hmin hrel
  refine ⟨α, a, b, u, v, d, e, f, hM, ha, hb0, hb1, hb2, rfl, rfl, hgen, ?_, ?_⟩
  · intro hz
    have hc0 : residue R (D.localMap M hQM (b 0)) = 0 := by
      simpa using congrFun hz 1
    have hc1 : residue R (D.localMap M hQM (b 1)) = 0 := by
      simpa using congrFun hz 5
    have hc2 : residue R (D.localMap M hQM (b 2)) = 0 := by
      simpa using congrFun hz 2
    let : IsLocalHom (D.localMap M hQM) := D.localMap_isLocal M hQM
    have h0 : residue A (b 0) = 0 :=
      (ResidueField.map (D.localMap M hQM)).injective
        (by simpa only [ResidueField.map_residue, map_zero] using hc0)
    have h1 : residue A (b 1) = 0 :=
      (ResidueField.map (D.localMap M hQM)).injective
        (by simpa only [ResidueField.map_residue, map_zero] using hc1)
    have h2 : residue A (b 2) = 0 :=
      (ResidueField.map (D.localMap M hQM)).injective
        (by simpa only [ResidueField.map_residue, map_zero] using hc2)
    have hQsq := D.equation_mem_sq_of_not_regular M hQM ht hsing
    rw [hM] at hQsq
    have hcenter := MvPolynomial.quadratic_eq_centered_of_mem_eval_ker_sq Q hdeg α hQsq
    apply hQ0
    simpa only [← hb0, ← hb1, ← hb2, h0, h1, h2, map_zero, zero_mul,
      zero_add] using hcenter
  · rw [hH] at hrel
    change -d * (p : R) ^ 2 + D.localMap M hQM (b 0) * (u : R) ^ 2 +
      D.localMap M hQM (b 2) * (v : R) ^ 2 + -e * (p : R) * (u : R) +
      -f * (p : R) * (v : R) + D.localMap M hQM (b 1) * (u : R) * (v : R) = 0
    linear_combination hrel

end Localization.Away.CaseOne.Presentation

namespace MvPolynomial.FirstCoordinate

variable {k : Type u} [Field k]

/-- An actual double point on the first chart identifies the original
homogeneous restriction by homogenizing its exact centered equation. -/
theorem restrict_zero_eq_centered_binary
    (q : MvPolynomial (Fin 3) k) (hq : q.IsHomogeneous 2)
    (hdeg : (dehom q).totalDegree ≤ 2) (α : Fin 2 → k)
    (hQsq : dehom q ∈ RingHom.ker (MvPolynomial.eval α) ^ 2) :
    MvPolynomial.eval₂Hom (MvPolynomial.C : k →+* MvPolynomial (Fin 2) k)
      ![0, MvPolynomial.X 0, MvPolynomial.X 1] q =
      MvPolynomial.C ((dehom q).coeff (Finsupp.single 0 2)) * MvPolynomial.X 0 ^ 2 +
      MvPolynomial.C ((dehom q).coeff (Finsupp.single 0 1 + Finsupp.single 1 1)) *
        MvPolynomial.X 0 * MvPolynomial.X 1 +
      MvPolynomial.C ((dehom q).coeff (Finsupp.single 1 2)) * MvPolynomial.X 1 ^ 2 := by
  let U : MvPolynomial (Fin 3) k := MvPolynomial.X 1 - MvPolynomial.C (α 0) * MvPolynomial.X 0
  let V : MvPolynomial (Fin 3) k := MvPolynomial.X 2 - MvPolynomial.C (α 1) * MvPolynomial.X 0
  let qC : MvPolynomial (Fin 3) k :=
    MvPolynomial.C ((dehom q).coeff (Finsupp.single 0 2)) * U ^ 2 +
    MvPolynomial.C ((dehom q).coeff (Finsupp.single 0 1 + Finsupp.single 1 1)) * U * V +
    MvPolynomial.C ((dehom q).coeff (Finsupp.single 1 2)) * V ^ 2
  have hU : U.IsHomogeneous 1 :=
    (MvPolynomial.isHomogeneous_X (R := k) 1).sub
      ((MvPolynomial.isHomogeneous_X (R := k) 0).C_mul (α 0))
  have hV : V.IsHomogeneous 1 :=
    (MvPolynomial.isHomogeneous_X (R := k) 2).sub
      ((MvPolynomial.isHomogeneous_X (R := k) 0).C_mul (α 1))
  have hqC : qC.IsHomogeneous 2 :=
    (((hU.pow 2).C_mul _).add ((hU.C_mul _).mul hV)).add ((hV.pow 2).C_mul _)
  have hdehom : dehom qC = dehom q := by
    simpa only [qC, U, V, map_add, map_mul, map_pow, map_sub, dehom_C, dehom_X_zero,
      show (1 : Fin 3) = (0 : Fin 2).succ from rfl,
      show (2 : Fin 3) = (1 : Fin 2).succ from rfl, dehom_X_succ, mul_one] using
      (MvPolynomial.quadratic_eq_centered_of_mem_eval_ker_sq (dehom q) hdeg α hQsq).symm
  have he : q = qC := dehom_injective_on_homogeneous_two hq hqC hdehom.symm
  let χ : MvPolynomial (Fin 3) k →+* MvPolynomial (Fin 2) k :=
    MvPolynomial.eval₂Hom MvPolynomial.C ![0, MvPolynomial.X 0, MvPolynomial.X 1]
  change χ q = _
  calc
    χ q = χ qC := congrArg χ he
    _ = _ := by
      simp [χ, qC, U, V]

end MvPolynomial.FirstCoordinate

namespace GradedAlgebra.TernaryQuadratic

variable {k : Type u} [Field k]

/-- The original first-coordinate-zero restriction retains the original
binary coefficients of the existing ternary quadratic. -/
theorem restrict_zero_quadratic (c : Fin 6 → k) :
    MvPolynomial.eval₂Hom (MvPolynomial.C : k →+* MvPolynomial (Fin 2) k)
      ![0, MvPolynomial.X 0, MvPolynomial.X 1] (quadratic c) =
      MvPolynomial.C (c 1) * MvPolynomial.X 0 ^ 2 +
      MvPolynomial.C (c 5) * MvPolynomial.X 0 * MvPolynomial.X 1 +
      MvPolynomial.C (c 2) * MvPolynomial.X 1 ^ 2 := by
  rw [quadratic_expansion]
  simp only [map_add, map_mul, map_pow, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
    Matrix.head_cons, Matrix.tail_cons,
    zero_pow (by decide : (2 : ℕ) ≠ 0), mul_zero, zero_mul, zero_add, add_zero]
  ring

end GradedAlgebra.TernaryQuadratic

namespace GradedAlgebra.TernaryQuadratic

universe v

variable {k : Type u} {l : Type v} [Field k] [Field l]

/-- The actual centered parent coefficients remain a nonzero nonsquare
binary restriction through the original bijective coefficient map. -/
theorem restrict_zero_nonsquare_of_centered_coefficients
    (ρ : k →+* l) (hρ : Function.Bijective ρ)
    (Q : MvPolynomial (Fin 2) k) (hQ0 : Q ≠ 0) (hdeg : Q.totalDegree ≤ 2)
    (α : Fin 2 → k) (hQsq : Q ∈ RingHom.ker (MvPolynomial.eval α) ^ 2)
    (hcase : ¬ ∃ c : k, c ≠ 0 ∧ ∃ L : MvPolynomial (Fin 2) k,
      L.totalDegree ≤ 1 ∧ Q = MvPolynomial.C c * L ^ 2)
    (c : Fin 6 → l)
    (h1 : c 1 = ρ (Q.coeff (Finsupp.single 0 2)))
    (h5 : c 5 = ρ (Q.coeff (Finsupp.single 0 1 + Finsupp.single 1 1)))
    (h2 : c 2 = ρ (Q.coeff (Finsupp.single 1 2))) :
    let r := MvPolynomial.eval₂Hom
      (MvPolynomial.C : l →+* MvPolynomial (Fin 2) l)
      ![0, MvPolynomial.X 0, MvPolynomial.X 1] (quadratic c)
    r ≠ 0 ∧ ¬ ∃ a : l, a ≠ 0 ∧ ∃ L : MvPolynomial (Fin 2) l,
      L.IsHomogeneous 1 ∧ L ≠ 0 ∧ r = MvPolynomial.C a * L ^ 2 := by
  let r : MvPolynomial (Fin 2) k :=
    MvPolynomial.C (Q.coeff (Finsupp.single 0 2)) * MvPolynomial.X 0 ^ 2 +
    MvPolynomial.C (Q.coeff (Finsupp.single 0 1 + Finsupp.single 1 1)) *
      MvPolynomial.X 0 * MvPolynomial.X 1 +
    MvPolynomial.C (Q.coeff (Finsupp.single 1 2)) * MvPolynomial.X 1 ^ 2
  obtain ⟨hr0, _, hrns⟩ :=
    MvPolynomial.centered_binary_quadratic_nonsquare Q hQ0 hdeg α hQsq hcase
  have he : MvPolynomial.eval₂Hom
      (MvPolynomial.C : l →+* MvPolynomial (Fin 2) l)
      ![0, MvPolynomial.X 0, MvPolynomial.X 1] (quadratic c) =
      MvPolynomial.map ρ r := by
    rw [restrict_zero_quadratic, h1, h5, h2]
    simp only [r, map_add, map_mul, map_pow, MvPolynomial.map_C, MvPolynomial.map_X]
  dsimp only
  rw [he]
  refine ⟨?_, ?_⟩
  · intro hz
    exact hr0 (MvPolynomial.map_injective ρ hρ.injective
      (hz.trans (map_zero (MvPolynomial.map ρ)).symm))
  · intro h
    exact hrns ((MvPolynomial.exists_scalar_homogeneous_square_map_iff ρ hρ r 1).mp h)

end GradedAlgebra.TernaryQuadratic

namespace MvPolynomial.FirstCoordinate

variable {k : Type u} [Field k]

/-- A double point in the opposite chart cannot lie on the zero locus of
the original parameter ratio when the original binary restriction is good. -/
theorem opposite_first_coordinate_ne_zero_of_double_point
    (q : MvPolynomial (Fin 3) k) (hq : q.IsHomogeneous 2)
    (hr0 : MvPolynomial.eval₂Hom (MvPolynomial.C : k →+* MvPolynomial (Fin 2) k)
      ![0, MvPolynomial.X 0, MvPolynomial.X 1] q ≠ 0)
    (hrns : ¬ ∃ c : k, c ≠ 0 ∧ ∃ L : MvPolynomial (Fin 2) k,
      L.IsHomogeneous 1 ∧ L ≠ 0 ∧
      MvPolynomial.eval₂Hom MvPolynomial.C ![0, MvPolynomial.X 0, MvPolynomial.X 1] q =
        MvPolynomial.C c * L ^ 2)
    (α : Fin 2 → k)
    (hsq : dehom (MvPolynomial.rename (Equiv.swap (0 : Fin 3) 1) q) ∈
      RingHom.ker (MvPolynomial.eval α) ^ 2) : α 0 ≠ 0 := by
  intro hzero
  let χ : MvPolynomial (Fin 3) k →+* MvPolynomial (Fin 2) k :=
    MvPolynomial.eval₂Hom MvPolynomial.C ![0, MvPolynomial.X 0, MvPolynomial.X 1]
  let r := χ q
  have hr : r.IsHomogeneous 2 := by
    have h := hq.eval₂ (MvPolynomial.C : k →+* MvPolynomial (Fin 2) k)
      ![0, MvPolynomial.X 0, MvPolynomial.X 1]
      (fun a => MvPolynomial.isHomogeneous_C _ a) (n := 1) (fun i => by
        fin_cases i
        · exact MvPolynomial.isHomogeneous_zero (Fin 2) k 1
        · exact MvPolynomial.isHomogeneous_X _ 0
        · exact MvPolynomial.isHomogeneous_X _ 1)
    simpa only [r, χ, MvPolynomial.coe_eval₂Hom, one_mul] using h
  have hα : α = ![0, α 1] := by
    funext i
    fin_cases i
    · exact hzero
    · rfl
  rw [hα] at hsq
  have hd := MvPolynomial.eval_zero_first_mem_point_pow
    (dehom (MvPolynomial.rename (Equiv.swap (0 : Fin 3) 1) q)) (α 1) 2 hsq
  let η : MvPolynomial (Fin 2) k →+* Polynomial k :=
    MvPolynomial.eval₂Hom Polynomial.C ![0, Polynomial.X]
  let ψ : MvPolynomial (Fin 2) k →+* Polynomial k :=
    MvPolynomial.eval₂Hom Polynomial.C ![1, Polynomial.X]
  have hmaps : η.comp (dehom.comp
      (MvPolynomial.rename (R := k) (Equiv.swap (0 : Fin 3) 1)).toRingHom) = ψ.comp χ := by
    apply MvPolynomial.ringHom_ext
    · intro a
      simp [η, ψ, χ]
    · intro i
      have hd1 : dehom (MvPolynomial.X 1 : MvPolynomial (Fin 3) k) =
          MvPolynomial.X 0 := dehom_X_succ 0
      have hd2 : dehom (MvPolynomial.X 2 : MvPolynomial (Fin 3) k) =
          MvPolynomial.X 1 := dehom_X_succ 1
      fin_cases i <;> simp [η, ψ, χ, Equiv.swap_apply_def, hd1, hd2]
  have he : η (dehom (MvPolynomial.rename (Equiv.swap (0 : Fin 3) 1) q)) = ψ r :=
    RingHom.congr_fun hmaps q
  change η (dehom (MvPolynomial.rename (Equiv.swap (0 : Fin 3) 1) q)) ∈
    (Ideal.span {Polynomial.X - Polynomial.C (α 1)}) ^ 2 at hd
  rw [he] at hd
  obtain ⟨c, hc, hcEq⟩ :=
    MvPolynomial.binary_eq_scalar_square_of_dehom_mem_point_sq (q := r) hr hr0 (α 1) hd
  apply hrns
  refine ⟨c, hc, MvPolynomial.X 1 - MvPolynomial.C (α 1) * MvPolynomial.X 0,
    (MvPolynomial.isHomogeneous_X (R := k) 1).sub
      ((MvPolynomial.isHomogeneous_X (R := k) 0).C_mul (α 1)), ?_, hcEq⟩
  intro hz
  apply hr0
  change r = 0
  rw [hcEq, hz, zero_pow (by decide : (2 : ℕ) ≠ 0), mul_zero]

end MvPolynomial.FirstCoordinate

namespace MvPolynomial.FirstCoordinate

variable {k : Type u} [Field k]

/-- Interchanging the two actual companions commutes with the original
parameter-zero restriction through the native binary interchange. -/
theorem restrict_zero_rename_swap_companions (q : MvPolynomial (Fin 3) k) :
    MvPolynomial.eval₂Hom (MvPolynomial.C : k →+* MvPolynomial (Fin 2) k)
      ![0, MvPolynomial.X 0, MvPolynomial.X 1]
      (MvPolynomial.rename (Equiv.swap (1 : Fin 3) 2) q) =
    MvPolynomial.rename (Equiv.swap (0 : Fin 2) 1)
      (MvPolynomial.eval₂Hom (MvPolynomial.C : k →+* MvPolynomial (Fin 2) k)
        ![0, MvPolynomial.X 0, MvPolynomial.X 1] q) := by
  let χ : MvPolynomial (Fin 3) k →+* MvPolynomial (Fin 2) k :=
    MvPolynomial.eval₂Hom MvPolynomial.C ![0, MvPolynomial.X 0, MvPolynomial.X 1]
  have he : χ.comp (MvPolynomial.rename (R := k) (Equiv.swap (1 : Fin 3) 2)).toRingHom =
      (MvPolynomial.rename (R := k) (Equiv.swap (0 : Fin 2) 1)).toRingHom.comp χ := by
    apply MvPolynomial.ringHom_ext
    · intro a
      simp [χ]
    · intro i
      fin_cases i <;> simp [χ, Equiv.swap_apply_def]
  exact RingHom.congr_fun he q

end MvPolynomial.FirstCoordinate

namespace Localization.Away.CaseOne

variable {A : Type u} [CommRing A] [IsLocalRing A]

/-- Literal permutation of the actual generators transports the entire
original principal kernel, with the inverse-renamed original equation. -/
theorem canonicalCone_kernel_permutation
    (t t' : maximalIdeal A) (g g' : Fin 2 → maximalIdeal A)
    (e : Fin 3 ≃ Fin 3)
    (hg : orderedGenerators t' g' = fun i => orderedGenerators t g (e i))
    (q : MvPolynomial (Fin 3) (ResidueField A))
    (hker : RingHom.ker (canonicalConeMap t g) = Ideal.span {q}) :
    RingHom.ker (canonicalConeMap t' g') =
      Ideal.span {MvPolynomial.rename e.symm q} := by
  let σ := MvPolynomial.renameEquiv (ResidueField A) e
  have hp := IsLocalRing.cotangentPolynomialMap_permutation (orderedGenerators t g) e
  rw [← hg] at hp
  have hcomp : RingHom.ker (canonicalConeMap t' g') =
      (RingHom.ker (canonicalConeMap t g)).comap σ.toRingHom := by
    ext p
    change Ideal.cotangentPolynomialMap (maximalIdeal A) (orderedGenerators t' g') p = 0 ↔
      Ideal.cotangentPolynomialMap (maximalIdeal A) (orderedGenerators t g) (σ p) = 0
    rw [hp]
    rfl
  have hspan : (Ideal.span {σ.symm q}).map σ.toRingHom = Ideal.span {q} := by
    rw [Ideal.map_span, Set.image_singleton]
    change Ideal.span {σ (σ.symm q)} = Ideal.span {q}
    rw [σ.apply_symm_apply]
  change RingHom.ker (canonicalConeMap t' g') = Ideal.span {σ.symm q}
  rw [hcomp, hker, ← hspan]
  exact Ideal.comap_map_of_bijective σ.toRingHom σ.bijective

end Localization.Away.CaseOne

namespace Localization.Away.CaseOne.Presentation

variable {A : Type u} [CommRing A] [IsLocalRing A] [IsNoetherianRing A] [IsDomain A]
    {s : maximalIdeal A} {g : Fin 2 → maximalIdeal A}

/-- The actual first opposite ratio avoids the original chart prime.
Its value is read through the existing point_fraction law, not an
abstract residue-field identification. -/
theorem first_opposite_fraction_not_mem
    (q : MvPolynomial (Fin 3) (ResidueField A)) (hq : q.IsHomogeneous 2)
    (hr0 : MvPolynomial.eval₂Hom
      (MvPolynomial.C : ResidueField A →+* MvPolynomial (Fin 2) (ResidueField A))
      ![0, MvPolynomial.X 0, MvPolynomial.X 1] q ≠ 0)
    (hrns : ¬ ∃ c : ResidueField A, c ≠ 0 ∧ ∃ L : MvPolynomial (Fin 2) (ResidueField A),
      L.IsHomogeneous 1 ∧ L ≠ 0 ∧
      MvPolynomial.eval₂Hom MvPolynomial.C ![0, MvPolynomial.X 0, MvPolynomial.X 1] q =
        MvPolynomial.C c * L ^ 2)
    (D : Presentation A s g (MvPolynomial.FirstCoordinate.dehom
      (MvPolynomial.rename (Equiv.swap (0 : Fin 3) 1) q)))
    (M : Ideal (Plane A)) [M.IsMaximal]
    (hQM : MvPolynomial.FirstCoordinate.dehom
      (MvPolynomial.rename (Equiv.swap (0 : Fin 3) 1) q) ∈ M)
    (hs : (s : A) ≠ 0)
    (hQ0 : MvPolynomial.FirstCoordinate.dehom
      (MvPolynomial.rename (Equiv.swap (0 : Fin 3) 1) q) ≠ 0)
    (hdeg : (MvPolynomial.FirstCoordinate.dehom
      (MvPolynomial.rename (Equiv.swap (0 : Fin 3) 1) q)).totalDegree ≤ 2)
    (hcase : ¬ ∃ c : ResidueField A, c ≠ 0 ∧ ∃ L : Plane A,
      L.totalDegree ≤ 1 ∧ MvPolynomial.FirstCoordinate.dehom
        (MvPolynomial.rename (Equiv.swap (0 : Fin 3) 1) q) = MvPolynomial.C c * L ^ 2)
    (hsing : ¬ IsRegularLocalRing (D.LocalRing M hQM)) :
    SaturatedChart.fractionElement (maximalIdeal A) s (g 0) ∉ D.prime M hQM := by
  obtain ⟨α, hM⟩ := D.exists_rational_coordinates M hQM hs hQ0 hdeg hcase hsing
  have hsq := D.equation_mem_sq_of_not_regular M hQM hs hsing
  rw [hM] at hsq
  have hα := MvPolynomial.FirstCoordinate.opposite_first_coordinate_ne_zero_of_double_point
    q hq hr0 hrns α hsq
  intro hratio
  change D.point M hQM (SaturatedChart.fractionElement (maximalIdeal A) s (g 0)) = 0 at hratio
  rw [D.point_fraction] at hratio
  have hX : (MvPolynomial.X 0 : Plane A) ∈ M := Ideal.Quotient.eq_zero_iff_mem.mp hratio
  rw [hM] at hX
  exact hα (by simpa only [RingHom.mem_ker, MvPolynomial.eval_X] using hX)

end Localization.Away.CaseOne.Presentation
