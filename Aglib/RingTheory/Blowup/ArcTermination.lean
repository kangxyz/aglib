/-!
# The original arc map on a saturated blowup chart

For a map `f : C →+* R` and an element `t` whose image is nonzero in the
domain `R`, the actual saturated chart of `(t) + ker f` maps to the original
ring `R`. Its kernel is generated by the literal fractions `z / t` with
`z ∈ ker f`. For a surjection of local rings with `f t` a uniformizer, the
centre is the original maximal ideal.

This is the chart algebra used by the arc descent in Stacks, Tag 0BG3. The
actual generic local rings are canonically compared over the original `C`,
with compatible quotient maps to the fraction field of the same `R`. A given
original generic DVR structure transfers through that constructed equivalence.
Minimal actual kernel generators, positive normalized torsion relations,
and nonincrease of the actual next kernel generator count are constructed
below. Strict lexicographic descent and termination remain separate assertions.
-/

@[expose] public noncomputable section

universe u v

namespace Localization.Away

variable {C : Type u} [CommRing C] {R : Type v} [CommRing R]

/-- The centre ideal written using the original quotient map. -/
def arcCenterIdeal (f : C →+* R) (t : C) : Ideal C :=
  Ideal.span {t} ⊔ RingHom.ker f

/-- The literal subalgebra of `C[1/t]` used by the arc. -/
abbrev arcChart (f : C →+* R) (t : C) :=
  saturatedChart C (arcCenterIdeal f t) t

/-- The original kernel element divided by the original exceptional parameter. -/
def arcFraction (f : C →+* R) (t : C) (z : RingHom.ker f) : arcChart f t :=
  ⟨fraction t z, fraction_mem _ _ _
    ((show RingHom.ker f ≤ arcCenterIdeal f t from le_sup_right) z.property)⟩

/-- The ideal generated by all divided elements of the original kernel. -/
def arcFractionIdeal (f : C →+* R) (t : C) : Ideal (arcChart f t) :=
  Ideal.span (Set.range (arcFraction f t))

/-- A saturated chart of a displayed ideal span has the displayed algebra
generators, with the same literal fractions in the original localization. -/
theorem saturatedChart_span_eq_adjoin_fractions (s : Set C) (t : C) :
    saturatedChart C (Ideal.span s) t = Algebra.adjoin C (fraction t '' s) := by
  apply le_antisymm
  · exact saturatedChart_le s t (Algebra.adjoin C (fraction t '' s))
      (fun c => (Algebra.adjoin C (fraction t '' s)).algebraMap_mem c)
      (fun b hb => Algebra.subset_adjoin ⟨b, hb, rfl⟩)
  · apply Algebra.adjoin_le
    rintro _ ⟨b, hb, rfl⟩
    exact fraction_mem _ _ _ (Ideal.subset_span hb)

/-- Finite generation of the actual original centre proves Noetherianity
of its actual saturated chart. -/
theorem arcChart_isNoetherian [IsNoetherianRing C] (f : C →+* R) (t : C) :
    IsNoetherianRing (arcChart f t) := by
  obtain ⟨s, hs⟩ := (arcCenterIdeal f t).fg_of_isNoetherianRing
  apply isNoetherianRing_of_fg
  apply Subalgebra.fg_def.mpr
  refine ⟨fraction t '' (s : Set C), s.finite_toSet.image _, ?_⟩
  rw [← saturatedChart_span_eq_adjoin_fractions, hs]

/-- A literal denominator representation in the actual saturated chart. -/
theorem arcChart_exists_denominator (f : C →+* R) (t : C) (x : arcChart f t) :
    ∃ (n : ℕ) (c : C),
      x * (algebraMap C (arcChart f t) t) ^ n = algebraMap C (arcChart f t) c := by
  obtain ⟨n, c, hc⟩ := IsLocalization.Away.surj t (x : Localization.Away t)
  refine ⟨n, c, ?_⟩
  apply Subtype.ext
  change (x : Localization.Away t) *
    (algebraMap C (Localization.Away t) t) ^ n = algebraMap C (Localization.Away t) c
  exact hc

/-- Once the actual exceptional parameter becomes a unit, a chart map is
uniquely determined by its original scalar map. -/
theorem arcChart_ringHom_ext_of_exceptional_isUnit {S : Type*} [Semiring S]
    (f : C →+* R) (t : C) (g h : arcChart f t →+* S)
    (hu : IsUnit (g (algebraMap C (arcChart f t) t)))
    (hbase : ∀ c : C,
      g (algebraMap C (arcChart f t) c) = h (algebraMap C (arcChart f t) c)) :
    g = h := by
  ext x
  obtain ⟨n, c, hc⟩ := arcChart_exists_denominator f t x
  apply (hu.pow n).mul_left_injective
  calc
    g x * g (algebraMap C (arcChart f t) t) ^ n =
        g (x * (algebraMap C (arcChart f t) t) ^ n) := by rw [map_mul, map_pow]
    _ = g (algebraMap C (arcChart f t) c) := congrArg g hc
    _ = h (algebraMap C (arcChart f t) c) := hbase c
    _ = h (x * (algebraMap C (arcChart f t) t) ^ n) := congrArg h hc.symm
    _ = h x * g (algebraMap C (arcChart f t) t) ^ n := by
      rw [map_mul, map_pow, ← hbase t]

@[simp]
theorem coe_arcFraction (f : C →+* R) (t : C) (z : RingHom.ker f) :
    (arcFraction f t z : Localization.Away t) = fraction t z := rfl

/-- Multiplying by the exceptional parameter recovers the original element. -/
theorem exceptional_mul_arcFraction (f : C →+* R) (t : C) (z : RingHom.ker f) :
    algebraMap C (arcChart f t) t * arcFraction f t z =
      algebraMap C (arcChart f t) z := by
  apply Subtype.ext
  exact (mul_comm _ _).trans (fraction_mul_self t z)

@[simp]
theorem arcFraction_zero (f : C →+* R) (t : C) : arcFraction f t 0 = 0 := by
  apply Subtype.ext
  simp only [coe_arcFraction, ZeroMemClass.coe_zero, fraction, map_zero, zero_mul]

@[simp]
theorem arcFraction_add (f : C →+* R) (t : C) (z w : RingHom.ker f) :
    arcFraction f t (z + w) = arcFraction f t z + arcFraction f t w := by
  apply Subtype.ext
  change fraction t ((z : C) + w) = fraction t z + fraction t w
  simp only [fraction, map_add, add_mul]

theorem arcFraction_smul (f : C →+* R) (t c : C) (z : RingHom.ker f) :
    arcFraction f t (c • z) = algebraMap C (arcChart f t) c * arcFraction f t z := by
  apply Subtype.ext
  change fraction t (c * (z : C)) =
    algebraMap C (Localization.Away t) c * fraction t z
  simp only [fraction, map_mul, mul_assoc]

/-- Any original generating family of the kernel gives the same generating
family after dividing by the exceptional parameter. -/
theorem arcFractionIdeal_eq_span {ι : Type*} (f : C →+* R) (t : C)
    (z : ι → RingHom.ker f)
    (hz : Ideal.span (Set.range fun i => (z i : C)) = RingHom.ker f) :
    arcFractionIdeal f t = Ideal.span (Set.range fun i => arcFraction f t (z i)) := by
  let J : Ideal (arcChart f t) := Ideal.span (Set.range fun i => arcFraction f t (z i))
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨w, rfl⟩
    have hw : (w : C) ∈ Ideal.span (Set.range fun i => (z i : C)) := by
      rw [hz]
      exact w.property
    refine Submodule.span_induction
      (p := fun x hx => arcFraction f t ⟨x, hz ▸ hx⟩ ∈ J) ?_ ?_ ?_ ?_ hw
    · rintro _ ⟨i, rfl⟩
      exact Ideal.subset_span ⟨i, rfl⟩
    · change arcFraction f t 0 ∈ J
      rw [arcFraction_zero]
      exact J.zero_mem
    · intro a b ha hb iha ihb
      change arcFraction f t (⟨a, hz ▸ ha⟩ + ⟨b, hz ▸ hb⟩) ∈ J
      rw [arcFraction_add]
      exact J.add_mem iha ihb
    · intro c a ha iha
      change arcFraction f t (c • (⟨a, hz ▸ ha⟩ : RingHom.ker f)) ∈ J
      rw [arcFraction_smul]
      exact J.mul_mem_left _ iha
  · apply Ideal.span_mono
    rintro _ ⟨i, rfl⟩
    exact ⟨z i, rfl⟩

/-- The original extended kernel factors by one exceptional parameter, as an
equality of ideals in the actual saturated chart. -/
theorem map_ker_eq_exceptional_mul_arcFractionIdeal (f : C →+* R) (t : C) :
    (RingHom.ker f).map (algebraMap C (arcChart f t)) =
      Ideal.span {algebraMap C (arcChart f t) t} * arcFractionIdeal f t := by
  apply le_antisymm
  · apply Ideal.map_le_iff_le_comap.mpr
    intro z hz
    apply Ideal.mem_span_singleton_mul.mpr
    exact ⟨arcFraction f t ⟨z, hz⟩, Ideal.subset_span ⟨_, rfl⟩,
      exceptional_mul_arcFraction f t ⟨z, hz⟩⟩
  · apply Ideal.span_singleton_mul_le_iff.mpr
    intro x hx
    induction hx using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨z, rfl⟩ := hy
      rw [exceptional_mul_arcFraction]
      exact Ideal.mem_map_of_mem _ z.property
    | zero => simpa only [mul_zero] using
        ((RingHom.ker f).map (algebraMap C (arcChart f t))).zero_mem
    | add x y hx hy ihx ihy =>
      rw [mul_add]
      exact ((RingHom.ker f).map (algebraMap C (arcChart f t))).add_mem ihx ihy
    | smul c x hx ih =>
      convert ((RingHom.ker f).map (algebraMap C (arcChart f t))).mul_mem_left c ih
        using 1
      simp only [smul_eq_mul]
      ring

private theorem fraction_eq_base_add (f : C →+* R) (t : C) {b : C}
    (hb : b ∈ arcCenterIdeal f t) :
    ∃ (c : C) (z : RingHom.ker f),
      fraction t b = algebraMap C (Localization.Away t) c + fraction t z := by
  obtain ⟨a, ha, z, hz, rfl⟩ := Submodule.mem_sup.mp hb
  obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton.mp ha
  refine ⟨c, ⟨z, hz⟩, ?_⟩
  calc
    fraction t (t * c + z) =
        algebraMap C (Localization.Away t) c *
          (algebraMap C (Localization.Away t) t * IsLocalization.Away.invSelf t) +
          fraction t z := by simp only [fraction, map_add, map_mul]; ring
    _ = _ := by rw [IsLocalization.Away.mul_invSelf, mul_one]

/-- For the original surjection of local rings, lifting a uniformizer makes
the chart centre exactly the original maximal ideal. -/
theorem arcCenterIdeal_eq_maximalIdeal [IsLocalRing C] [IsLocalRing R]
    (f : C →+* R) (t : C) (hf : Function.Surjective f)
    (ht : IsLocalRing.maximalIdeal R = Ideal.span {f t}) :
    arcCenterIdeal f t = IsLocalRing.maximalIdeal C := by
  let : IsLocalHom f := IsLocalHom.of_surjective f hf
  have hspan : (Ideal.span {t}).map f = Ideal.span {f t} := by
    rw [Ideal.map_span, Set.image_singleton]
  rw [← IsLocalRing.maximalIdeal_comap f, ht, ← hspan,
    Ideal.comap_map_of_surjective f hf]
  rfl

private theorem exceptional_sq_mul_pow_arcFraction
    (f : C →+* R) (t : C) (z : RingHom.ker f) (n : ℕ) (hn : 0 < n) :
    (algebraMap C (arcChart f t) t) ^ 2 *
        ((algebraMap C (arcChart f t) t) ^ (n - 1) * arcFraction f t z) =
      algebraMap C (arcChart f t) (t ^ n * z) := by
  let T := algebraMap C (arcChart f t) t
  calc
    T ^ 2 * (T ^ (n - 1) * arcFraction f t z) =
        (T ^ (n - 1) * T) * (T * arcFraction f t z) := by ring
    _ = T ^ n * algebraMap C (arcChart f t) z := by
      rw [← pow_succ, Nat.sub_add_cancel hn, exceptional_mul_arcFraction]
    _ = _ := by rw [map_mul, map_pow]

private theorem exists_base_sub_mem_arcFractionIdeal (f : C →+* R) (t : C)
    (x : arcChart f t) :
    ∃ c : C, x - algebraMap C (arcChart f t) c ∈ arcFractionIdeal f t := by
  refine Algebra.adjoin_induction
    (p := fun x hx => ∃ c : C,
      (⟨x, hx⟩ : arcChart f t) - algebraMap C (arcChart f t) c ∈
        arcFractionIdeal f t) ?_ ?_ ?_ ?_ x.property
  · rintro _ ⟨b, hb, rfl⟩
    obtain ⟨c, z, h⟩ := fraction_eq_base_add f t hb
    refine ⟨c, ?_⟩
    have he : (⟨fraction t b, fraction_mem _ _ _ hb⟩ : arcChart f t) -
        algebraMap C (arcChart f t) c = arcFraction f t z := by
      apply Subtype.ext
      change fraction t b - algebraMap C (Localization.Away t) c = fraction t z
      rw [h, add_sub_cancel_left]
    change (⟨fraction t b, fraction_mem _ _ _ hb⟩ : arcChart f t) -
      algebraMap C (arcChart f t) c ∈ arcFractionIdeal f t
    exact he.symm ▸ (show arcFraction f t z ∈ arcFractionIdeal f t from
      Ideal.subset_span ⟨z, rfl⟩)
  · intro c
    refine ⟨c, ?_⟩
    change algebraMap C (arcChart f t) c - algebraMap C (arcChart f t) c ∈
      arcFractionIdeal f t
    simpa only [sub_self] using (arcFractionIdeal f t).zero_mem
  · intro a b ha hb iha ihb
    obtain ⟨c, hc⟩ := iha
    obtain ⟨d, hd⟩ := ihb
    refine ⟨c + d, ?_⟩
    change (⟨a, ha⟩ : arcChart f t) + (⟨b, hb⟩ : arcChart f t) -
      algebraMap C (arcChart f t) (c + d) ∈ arcFractionIdeal f t
    convert (arcFractionIdeal f t).add_mem hc hd using 1
    simp only [map_add]
    ring
  · intro a b ha hb iha ihb
    obtain ⟨c, hc⟩ := iha
    obtain ⟨d, hd⟩ := ihb
    refine ⟨c * d, ?_⟩
    have hm := (arcFractionIdeal f t).add_mem
      ((arcFractionIdeal f t).mul_mem_left (⟨a, ha⟩ : arcChart f t) hd)
      ((arcFractionIdeal f t).mul_mem_left (algebraMap C (arcChart f t) d) hc)
    change (⟨a, ha⟩ : arcChart f t) * (⟨b, hb⟩ : arcChart f t) -
      algebraMap C (arcChart f t) (c * d) ∈ arcFractionIdeal f t
    convert hm using 1
    simp only [map_mul]
    ring

/-- The native localization lift of the original map, inverting its actual
image of the exceptional parameter. -/
def arcLocalizationMap (f : C →+* R) (t : C) :
    Localization.Away t →+* Localization.Away (f t) :=
  IsLocalization.Away.lift t
    (g := (algebraMap R (Localization.Away (f t))).comp f)
    (by simpa only [RingHom.comp_apply] using
      IsLocalization.Away.algebraMap_isUnit (S := Localization.Away (f t)) (f t))

@[simp]
private theorem arcLocalizationMap_base (f : C →+* R) (t c : C) :
    arcLocalizationMap f t (algebraMap C (Localization.Away t) c) =
      algebraMap R (Localization.Away (f t)) (f c) :=
  IsLocalization.Away.lift_eq _ _ _

private theorem arcLocalizationMap_fraction (f : C →+* R) (t : C)
    (z : RingHom.ker f) : arcLocalizationMap f t (fraction t z) = 0 := by
  simp only [fraction, map_mul, arcLocalizationMap_base,
    RingHom.mem_ker.mp z.property, map_zero, zero_mul]

/-- On the actual arc chart, the native localization lift lands in the image
of the original quotient ring. -/
theorem arcLocalizationMap_mem_range (f : C →+* R) (t : C)
    (x : arcChart f t) :
    arcLocalizationMap f t (x : Localization.Away t) ∈
      (algebraMap R (Localization.Away (f t))).range := by
  refine Algebra.adjoin_induction
    (p := fun x _ => arcLocalizationMap f t x ∈
      (algebraMap R (Localization.Away (f t))).range) ?_ ?_ ?_ ?_ x.property
  · rintro _ ⟨b, hb, rfl⟩
    obtain ⟨c, z, h⟩ := fraction_eq_base_add f t hb
    change arcLocalizationMap f t (fraction t b) ∈ _
    rw [h, map_add, arcLocalizationMap_base, arcLocalizationMap_fraction, add_zero]
    exact ⟨f c, rfl⟩
  · intro c
    rw [arcLocalizationMap_base]
    exact ⟨f c, rfl⟩
  · intro x y hx hy ihx ihy
    simpa only [map_add] using
      (algebraMap R (Localization.Away (f t))).range.add_mem ihx ihy
  · intro x y hx hy ihx ihy
    simpa only [map_mul] using
      (algebraMap R (Localization.Away (f t))).range.mul_mem ihx ihy

/-- The restriction of the actual localization lift to the proved image. -/
def arcMapToRange (f : C →+* R) (t : C) :
    arcChart f t →+* (algebraMap R (Localization.Away (f t))).range :=
  ((arcLocalizationMap f t).comp (arcChart f t).val.toRingHom).codRestrict _
    (arcLocalizationMap_mem_range f t)

variable [IsDomain R]

private theorem away_base_injective (r : R) (hr : r ≠ 0) :
    Function.Injective (algebraMap R (Localization.Away r)) :=
  IsLocalization.injective (Localization.Away r)
    (powers_le_nonZeroDivisors_of_noZeroDivisors hr)

/-- A domain embeds as the range of its original nonzero principal localization. -/
def awayBaseRangeEquiv (r : R) (hr : r ≠ 0) :
    R ≃+* (algebraMap R (Localization.Away r)).range :=
  RingEquiv.ofBijective (algebraMap R (Localization.Away r)).rangeRestrict
    ⟨fun _ _ h => IsLocalization.injective (Localization.Away r)
      (powers_le_nonZeroDivisors_of_noZeroDivisors hr) (congrArg Subtype.val h),
      RingHom.rangeRestrict_surjective _⟩

/-- The map from the actual saturated chart to the original quotient domain.
Its construction proves that the localization map has image in `R`. -/
def arcMap (f : C →+* R) (t : C) (ht : f t ≠ 0) : arcChart f t →+* R :=
  (awayBaseRangeEquiv (f t) ht).symm.toRingHom.comp (arcMapToRange f t)

private theorem arcMap_spec (f : C →+* R) (t : C) (ht : f t ≠ 0)
    (x : arcChart f t) :
    algebraMap R (Localization.Away (f t)) (arcMap f t ht x) =
      arcLocalizationMap f t (x : Localization.Away t) := by
  change algebraMap R (Localization.Away (f t))
      ((awayBaseRangeEquiv (f t) ht).symm (arcMapToRange f t x)) =
    (arcMapToRange f t x : Localization.Away (f t))
  exact congrArg Subtype.val ((awayBaseRangeEquiv (f t) ht).apply_symm_apply
    (arcMapToRange f t x))

/-- The chart extension keeps the original quotient map on the original ring. -/
@[simp]
theorem arcMap_base (f : C →+* R) (t : C) (ht : f t ≠ 0) (c : C) :
    arcMap f t ht (algebraMap C (arcChart f t) c) = f c := by
  apply away_base_injective (f t) ht
  rw [arcMap_spec]
  exact arcLocalizationMap_base f t c

/-- Every divided original kernel element maps to zero in the same domain. -/
@[simp]
theorem arcMap_arcFraction (f : C →+* R) (t : C) (ht : f t ≠ 0)
    (z : RingHom.ker f) : arcMap f t ht (arcFraction f t z) = 0 := by
  apply away_base_injective (f t) ht
  rw [arcMap_spec, map_zero]
  exact arcLocalizationMap_fraction f t z

/-- Surjectivity is retained, using the unchanged original scalar map. -/
theorem arcMap_surjective (f : C →+* R) (t : C) (ht : f t ≠ 0)
    (hf : Function.Surjective f) : Function.Surjective (arcMap f t ht) := by
  intro r
  obtain ⟨c, rfl⟩ := hf r
  exact ⟨algebraMap C (arcChart f t) c, arcMap_base f t ht c⟩

/-- The kernel is the ideal generated by the literal divided kernel elements. -/
theorem ker_arcMap (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    RingHom.ker (arcMap f t ht) = arcFractionIdeal f t := by
  apply le_antisymm
  · intro x hx
    obtain ⟨c, hc⟩ := exists_base_sub_mem_arcFractionIdeal f t x
    have hJ : arcFractionIdeal f t ≤ RingHom.ker (arcMap f t ht) := by
      apply Ideal.span_le.mpr
      rintro _ ⟨z, rfl⟩
      exact RingHom.mem_ker.mpr (arcMap_arcFraction f t ht z)
    have hfc : f c = 0 := by
      have h := RingHom.mem_ker.mp (hJ hc)
      simpa only [map_sub, RingHom.mem_ker.mp hx, arcMap_base, zero_sub,
        neg_eq_zero] using h
    have hbase : algebraMap C (arcChart f t) c ∈ arcFractionIdeal f t := by
      rw [← exceptional_mul_arcFraction f t ⟨c, RingHom.mem_ker.mpr hfc⟩]
      exact (arcFractionIdeal f t).mul_mem_left _ (Ideal.subset_span ⟨_, rfl⟩)
    have hsum := (arcFractionIdeal f t).add_mem hc hbase
    simpa only [sub_add_cancel] using hsum
  · apply Ideal.span_le.mpr
    rintro _ ⟨z, rfl⟩
    exact RingHom.mem_ker.mpr (arcMap_arcFraction f t ht z)

/-- A specified original generating family gives an actual chart-kernel
generating family, without a hypothesis asserting kernel preservation. -/
theorem ker_arcMap_eq_span {ι : Type*} (f : C →+* R) (t : C) (ht : f t ≠ 0)
    (z : ι → RingHom.ker f)
    (hz : Ideal.span (Set.range fun i => (z i : C)) = RingHom.ker f) :
    RingHom.ker (arcMap f t ht) =
      Ideal.span (Set.range fun i => arcFraction f t (z i)) := by
  rw [ker_arcMap, arcFractionIdeal_eq_span f t z hz]

/-- Squaring the genuine exceptional factorization divides both factors of
the original squared kernel. -/
theorem map_ker_sq_eq_exceptional_sq_mul_ker_sq
    (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    (RingHom.ker f ^ 2).map (algebraMap C (arcChart f t)) =
      Ideal.span {(algebraMap C (arcChart f t) t) ^ 2} *
        RingHom.ker (arcMap f t ht) ^ 2 := by
  rw [Ideal.map_pow, map_ker_eq_exceptional_mul_arcFractionIdeal,
    mul_pow, Ideal.span_singleton_pow, ker_arcMap]

/-- Dividing an actual squared-kernel relation by `t²` lowers both positive
exponents by one inside the actual kernel of the chart map to the original `R`.
The coefficient need not be a unit. -/
theorem transformed_relation_mem_ker_sq
    (f : C →+* R) (t : C) (ht : f t ≠ 0) (z w : RingHom.ker f)
    (a : C) (n m : ℕ) (hn : 0 < n) (hm : 0 < m)
    (hrel : t ^ n * (z : C) - a * t ^ m * (w : C) ∈ RingHom.ker f ^ 2) :
    (algebraMap C (arcChart f t) t) ^ (n - 1) * arcFraction f t z -
        algebraMap C (arcChart f t) a *
          (algebraMap C (arcChart f t) t) ^ (m - 1) * arcFraction f t w ∈
      RingHom.ker (arcMap f t ht) ^ 2 := by
  let T := algebraMap C (arcChart f t) t
  let e := T ^ (n - 1) * arcFraction f t z -
    algebraMap C (arcChart f t) a * T ^ (m - 1) * arcFraction f t w
  have he : T ^ 2 * e =
      algebraMap C (arcChart f t) (t ^ n * (z : C) - a * t ^ m * (w : C)) := by
    calc
      T ^ 2 * e = T ^ 2 * (T ^ (n - 1) * arcFraction f t z) -
          algebraMap C (arcChart f t) a *
            (T ^ 2 * (T ^ (m - 1) * arcFraction f t w)) := by dsimp [e]; ring
      _ = algebraMap C (arcChart f t) (t ^ n * (z : C)) -
          algebraMap C (arcChart f t) a *
            algebraMap C (arcChart f t) (t ^ m * (w : C)) := by
        rw [exceptional_sq_mul_pow_arcFraction f t z n hn,
          exceptional_sq_mul_pow_arcFraction f t w m hm]
      _ = _ := by simp only [map_sub, map_mul]; ring
  have hmem := Ideal.mem_map_of_mem (algebraMap C (arcChart f t)) hrel
  rw [map_ker_sq_eq_exceptional_sq_mul_ker_sq f t ht] at hmem
  obtain ⟨q, hq, hqe⟩ := Ideal.mem_span_singleton_mul.mp hmem
  have heq : e = q := exceptional_pow_mul_injective (arcCenterIdeal f t) t 2
    (he.trans hqe.symm)
  change e ∈ _
  rw [heq]
  exact hq

/-- The one-term torsion relation has the same actual exponent decrease. -/
theorem transformed_torsion_relation_mem_ker_sq
    (f : C →+* R) (t : C) (ht : f t ≠ 0) (z : RingHom.ker f)
    (n : ℕ) (hn : 0 < n) (hrel : t ^ n * (z : C) ∈ RingHom.ker f ^ 2) :
    (algebraMap C (arcChart f t) t) ^ (n - 1) * arcFraction f t z ∈
      RingHom.ker (arcMap f t ht) ^ 2 := by
  simpa only [map_zero, zero_mul, sub_zero] using
    transformed_relation_mem_ker_sq f t ht z 0 0 n 1 hn Nat.zero_lt_one
      (by simpa only [zero_mul, sub_zero] using hrel)

section LocalArc

variable [IsLocalRing R]

/-- The actual closed-point centre selected by the original arc on this chart. -/
def arcClosedPoint (f : C →+* R) (t : C) (ht : f t ≠ 0) : Ideal (arcChart f t) :=
  (IsLocalRing.maximalIdeal R).comap (arcMap f t ht)

instance arcClosedPoint_isPrime (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    (arcClosedPoint f t ht).IsPrime := by
  dsimp only [arcClosedPoint]
  infer_instance

/-- The chart centre is closed whenever the original quotient map is surjective. -/
theorem arcClosedPoint_isMaximal (f : C →+* R) (t : C) (ht : f t ≠ 0)
    (hf : Function.Surjective f) : (arcClosedPoint f t ht).IsMaximal :=
  Ideal.comap_isMaximal_of_surjective _ (arcMap_surjective f t ht hf)

/-- Its original equations are the exceptional parameter and the divided kernel. -/
theorem arcClosedPoint_eq_span_sup (f : C →+* R) (t : C) (ht : f t ≠ 0)
    (hf : Function.Surjective f)
    (hu : IsLocalRing.maximalIdeal R = Ideal.span {f t}) :
    arcClosedPoint f t ht =
      Ideal.span {algebraMap C (arcChart f t) t} ⊔ arcFractionIdeal f t := by
  have hspan :
      (Ideal.span {algebraMap C (arcChart f t) t}).map (arcMap f t ht) =
        Ideal.span {f t} := by
    rw [Ideal.map_span, Set.image_singleton, arcMap_base]
  rw [arcClosedPoint, hu, ← hspan,
    Ideal.comap_map_of_surjective _ (arcMap_surjective f t ht hf),
    ← RingHom.ker_eq_comap_bot, ker_arcMap]

/-- The actual local ring of the saturated chart at the arc's closed point. -/
abbrev arcLocalRing (f : C →+* R) (t : C) (ht : f t ≠ 0) :=
  Localization.AtPrime (arcClosedPoint f t ht)

/-- The actual local chart remains Noetherian over a Noetherian original ring. -/
theorem arcLocalRing_isNoetherian [IsNoetherianRing C]
    (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    IsNoetherianRing (arcLocalRing f t ht) :=
  IsLocalization.isNoetherianRing (arcClosedPoint f t ht).primeCompl
    (arcLocalRing f t ht) (arcChart_isNoetherian f t)

/-- The original quotient map extends to the actual closed-point localization. -/
def arcLocalMap (f : C →+* R) (t : C) (ht : f t ≠ 0) : arcLocalRing f t ht →+* R :=
  IsLocalization.lift (M := (arcClosedPoint f t ht).primeCompl)
    (g := arcMap f t ht) (fun s => IsLocalRing.notMem_maximalIdeal.mp s.property)

@[simp]
theorem arcLocalMap_base (f : C →+* R) (t : C) (ht : f t ≠ 0)
    (x : arcChart f t) :
    arcLocalMap f t ht (algebraMap (arcChart f t) (arcLocalRing f t ht) x) =
      arcMap f t ht x := IsLocalization.lift_eq _ _

/-- The original scalar map to the actual local ring, written as its exact composite. -/
def arcLocalBase (f : C →+* R) (t : C) (ht : f t ≠ 0) : C →+* arcLocalRing f t ht :=
  (algebraMap (arcChart f t) (arcLocalRing f t ht)).comp (algebraMap C (arcChart f t))

@[simp]
theorem arcLocalMap_arcLocalBase (f : C →+* R) (t : C) (ht : f t ≠ 0) (c : C) :
    arcLocalMap f t ht (arcLocalBase f t ht c) = f c := by
  simp only [arcLocalBase, RingHom.comp_apply, arcLocalMap_base, arcMap_base]

/-- The same original quotient domain is the quotient of the actual local chart. -/
theorem arcLocalMap_surjective (f : C →+* R) (t : C) (ht : f t ≠ 0)
    (hf : Function.Surjective f) : Function.Surjective (arcLocalMap f t ht) := by
  intro r
  obtain ⟨c, rfl⟩ := hf r
  exact ⟨arcLocalBase f t ht c, arcLocalMap_arcLocalBase f t ht c⟩

/-- The localized kernel is exactly the extension of the constructed chart kernel. -/
theorem ker_arcLocalMap (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    RingHom.ker (arcLocalMap f t ht) =
      (RingHom.ker (arcMap f t ht)).map
        (algebraMap (arcChart f t) (arcLocalRing f t ht)) := by
  have hcomp : (arcLocalMap f t ht).comp
      (algebraMap (arcChart f t) (arcLocalRing f t ht)) = arcMap f t ht := by
    ext x
    exact arcLocalMap_base f t ht x
  calc
    RingHom.ker (arcLocalMap f t ht) =
        ((RingHom.ker (arcLocalMap f t ht)).comap
          (algebraMap (arcChart f t) (arcLocalRing f t ht))).map
            (algebraMap (arcChart f t) (arcLocalRing f t ht)) :=
      (IsLocalization.map_under (arcClosedPoint f t ht).primeCompl
        (arcLocalRing f t ht) (RingHom.ker (arcLocalMap f t ht))).symm
    _ = _ := by rw [RingHom.comap_ker, hcomp]

/-- The original kernel generators divide to an actual generating family of
the arc kernel after localization at its closed point. -/
theorem ker_arcLocalMap_eq_span {ι : Type*}
    (f : C →+* R) (t : C) (ht : f t ≠ 0) (z : ι → RingHom.ker f)
    (hz : Ideal.span (Set.range fun i => (z i : C)) = RingHom.ker f) :
    RingHom.ker (arcLocalMap f t ht) = Ideal.span
      (Set.range fun i => algebraMap (arcChart f t) (arcLocalRing f t ht)
        (arcFraction f t (z i))) := by
  rw [ker_arcLocalMap, ker_arcMap_eq_span f t ht z hz, Ideal.map_span]
  congr 1
  exact (Set.range_comp'
    (algebraMap (arcChart f t) (arcLocalRing f t ht))
    (fun i => arcFraction f t (z i))).symm

/-- The transformed relation holds in the actual local ring at the arc centre. -/
theorem local_transformed_relation_mem_ker_sq
    (f : C →+* R) (t : C) (ht : f t ≠ 0) (z w : RingHom.ker f)
    (a : C) (n m : ℕ) (hn : 0 < n) (hm : 0 < m)
    (hrel : t ^ n * (z : C) - a * t ^ m * (w : C) ∈ RingHom.ker f ^ 2) :
    (arcLocalBase f t ht t) ^ (n - 1) *
          algebraMap (arcChart f t) (arcLocalRing f t ht) (arcFraction f t z) -
        arcLocalBase f t ht a * (arcLocalBase f t ht t) ^ (m - 1) *
          algebraMap (arcChart f t) (arcLocalRing f t ht) (arcFraction f t w) ∈
      RingHom.ker (arcLocalMap f t ht) ^ 2 := by
  have h := Ideal.mem_map_of_mem
    (algebraMap (arcChart f t) (arcLocalRing f t ht))
    (transformed_relation_mem_ker_sq f t ht z w a n m hn hm hrel)
  rw [Ideal.map_pow, ← ker_arcLocalMap] at h
  simpa only [map_sub, map_mul, map_pow, arcLocalBase, RingHom.comp_apply] using h

end LocalArc

attribute [local instance] RingHom.ker_isPrime

/-- The original generic quotient lift to the fraction field of the same `R`,
on a specified actual localization. This constructor fixes the ring and algebra
presentation before constructing the lift. -/
def genericQuotientLift {A : Type*} [CommSemiring A] (f : A →+* R)
    (S : Type*) [CommSemiring S] [Algebra A S]
    [IsLocalization (RingHom.ker f).primeCompl S] : S →+* FractionRing R :=
  IsLocalization.lift (M := (RingHom.ker f).primeCompl)
    (g := (algebraMap R (FractionRing R)).comp f) (fun s =>
      isUnit_iff_ne_zero.mpr (by
        intro hs
        apply s.property
        apply RingHom.mem_ker.mpr
        apply IsFractionRing.injective R (FractionRing R)
        simpa only [RingHom.comp_apply, map_zero] using hs))

@[simp]
theorem genericQuotientLift_base {A : Type*} [CommSemiring A] (f : A →+* R)
    (S : Type*) [CommSemiring S] [Algebra A S]
    [IsLocalization (RingHom.ker f).primeCompl S] (a : A) :
    genericQuotientLift f S (algebraMap A S a) =
      algebraMap R (FractionRing R) (f a) := IsLocalization.lift_eq _ _

/-- The original generic quotient map on the native prime localization. -/
def genericQuotientMap (f : C →+* R) :
    Localization.AtPrime (RingHom.ker f) →+* FractionRing R :=
  genericQuotientLift f (Localization.AtPrime (RingHom.ker f))

@[simp]
theorem genericQuotientMap_base (f : C →+* R) (c : C) :
    genericQuotientMap f (algebraMap C (Localization.AtPrime (RingHom.ker f)) c) =
      algebraMap R (FractionRing R) (f c) :=
  genericQuotientLift_base f (Localization.AtPrime (RingHom.ker f)) c

/-- Generic quotient maps to a fixed fraction field commute with any native
generic-ring map over a commuting square of the original ring homomorphisms.
The ring types and the shared quotient are explicit at this boundary. -/
theorem genericQuotientMap_comp_of_base {D S : Type*} [CommSemiring D] [Semiring S]
    (f : C →+* R) (g : D →+* R) (a : C →+* D)
    (j : D →+* S) (l : S →+* FractionRing R)
    (k : Localization.AtPrime (RingHom.ker f) →+* S)
    (hl : ∀ d : D, l (j d) = algebraMap R (FractionRing R) (g d))
    (hk : ∀ c : C,
      k (algebraMap C (Localization.AtPrime (RingHom.ker f)) c) =
        j (a c))
    (h : g.comp a = f) :
    l.comp k = genericQuotientMap f := by
  apply IsLocalization.ringHom_ext (RingHom.ker f).primeCompl
  ext c
  change l (k (algebraMap C (Localization.AtPrime (RingHom.ker f)) c)) =
    genericQuotientMap f (algebraMap C (Localization.AtPrime (RingHom.ker f)) c)
  rw [hk, hl, genericQuotientMap_base]
  exact congrArg (algebraMap R (FractionRing R)) (RingHom.congr_fun h c)

/-- Surjectivity of the original quotient makes its actual generic quotient
map onto the fraction field, including all of its denominators. -/
theorem genericQuotientMap_surjective (f : C →+* R) (hf : Function.Surjective f) :
    Function.Surjective (genericQuotientMap f) := by
  intro y
  obtain ⟨r, s, rfl⟩ := IsLocalization.exists_mk'_eq (nonZeroDivisors R) y
  obtain ⟨a, ha⟩ := hf r
  obtain ⟨b, hb⟩ := hf (s : R)
  have hb0 : b ∉ RingHom.ker f := by
    intro hbker
    exact (mem_nonZeroDivisors_iff_ne_zero.mp s.property)
      (hb.symm.trans (RingHom.mem_ker.mp hbker))
  let sb : (RingHom.ker f).primeCompl := ⟨b, hb0⟩
  refine ⟨IsLocalization.mk' (Localization.AtPrime (RingHom.ker f)) a sb, ?_⟩
  apply (IsLocalization.map_units (FractionRing R) s).mul_left_injective
  have h := congrArg (genericQuotientMap f)
    (IsLocalization.mk'_spec (Localization.AtPrime (RingHom.ker f)) a sb)
  simpa only [map_mul, genericQuotientMap_base, sb, ha, hb, IsLocalization.mk'_spec] using h

/-- The original generic quotient has precisely the maximal ideal as kernel. -/
theorem ker_genericQuotientMap (f : C →+* R) (hf : Function.Surjective f) :
    RingHom.ker (genericQuotientMap f) =
      IsLocalRing.maximalIdeal (Localization.AtPrime (RingHom.ker f)) :=
  IsLocalRing.eq_maximalIdeal
    (RingHom.ker_isMaximal_of_surjective _ (genericQuotientMap_surjective f hf))

/-- The actual generic residue field is the fraction field of the original
quotient `R`, with its quotient map specified below. -/
def genericResidueFieldEquiv (f : C →+* R) (hf : Function.Surjective f) :
    IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker f)) ≃+* FractionRing R :=
  (Ideal.quotEquivOfEq (ker_genericQuotientMap f hf).symm).trans
    ((genericQuotientMap f).quotientKerEquivOfSurjective (genericQuotientMap_surjective f hf))

@[simp]
theorem genericResidueFieldEquiv_residue (f : C →+* R) (hf : Function.Surjective f)
    (x : Localization.AtPrime (RingHom.ker f)) :
    genericResidueFieldEquiv f hf
        (IsLocalRing.residue (Localization.AtPrime (RingHom.ker f)) x) =
      genericQuotientMap f x := by
  change (genericQuotientMap f).quotientKerEquivOfSurjective
      (genericQuotientMap_surjective f hf)
      (Ideal.quotEquivOfEq (ker_genericQuotientMap f hf).symm (Ideal.Quotient.mk _ x)) = _
  rw [Ideal.quotEquivOfEq_mk, RingHom.quotientKerEquivOfSurjective_apply_mk]

/-- Restriction of the original principal-localization lift to `C_p`.
The invertibility of `t` is derived from its nonzero original image. -/
def arcChartToGeneric (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    arcChart f t →+* Localization.AtPrime (RingHom.ker f) :=
  (IsLocalization.Away.lift t
    (g := algebraMap C (Localization.AtPrime (RingHom.ker f)))
    ((IsLocalization.AtPrime.isUnit_to_map_iff
      (Localization.AtPrime (RingHom.ker f)) (RingHom.ker f) t).mpr
        (fun hz => ht (RingHom.mem_ker.mp hz)))).comp (arcChart f t).val.toRingHom

@[simp]
theorem arcChartToGeneric_base (f : C →+* R) (t : C) (ht : f t ≠ 0) (c : C) :
    arcChartToGeneric f t ht (algebraMap C (arcChart f t) c) =
      algebraMap C (Localization.AtPrime (RingHom.ker f)) c := by
  let hu : IsUnit (algebraMap C (Localization.AtPrime (RingHom.ker f)) t) :=
    (IsLocalization.AtPrime.isUnit_to_map_iff
      (Localization.AtPrime (RingHom.ker f)) (RingHom.ker f) t).mpr
        (fun hz => ht (RingHom.mem_ker.mp hz))
  change IsLocalization.Away.lift t hu
    (algebraMap C (Localization.Away t) c) = _
  exact IsLocalization.Away.lift_eq t hu c

/-- The unit condition needed for generic localization follows from the
actual denominator equation and the original arc image. -/
theorem isUnit_arcChartToGeneric_of_arcMap_ne_zero
    (f : C →+* R) (t : C) (ht : f t ≠ 0) (x : arcChart f t)
    (hx : arcMap f t ht x ≠ 0) : IsUnit (arcChartToGeneric f t ht x) := by
  obtain ⟨n, c, hc⟩ := arcChart_exists_denominator f t x
  have he : arcMap f t ht x * (f t) ^ n = f c := by
    simpa only [map_mul, map_pow, arcMap_base] using congrArg (arcMap f t ht) hc
  have hfc : f c ≠ 0 := by
    rw [← he]
    exact mul_ne_zero hx (pow_ne_zero n ht)
  have hu : IsUnit (algebraMap C (Localization.AtPrime (RingHom.ker f)) c) :=
    (IsLocalization.AtPrime.isUnit_to_map_iff
      (Localization.AtPrime (RingHom.ker f)) (RingHom.ker f) c).mpr
        (fun hz => hfc (RingHom.mem_ker.mp hz))
  have hg : arcChartToGeneric f t ht x *
      (algebraMap C (Localization.AtPrime (RingHom.ker f)) t) ^ n =
        algebraMap C (Localization.AtPrime (RingHom.ker f)) c := by
    simpa only [map_mul, map_pow, arcChartToGeneric_base] using
      congrArg (arcChartToGeneric f t ht) hc
  exact isUnit_of_mul_isUnit_left (hg.symm ▸ hu)

section GenericArc

variable [IsLocalRing R]

/-- The actual arc-centre local ring maps to the original generic local ring;
all localization denominators are proved to become units. -/
def arcLocalToGeneric (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    arcLocalRing f t ht →+* Localization.AtPrime (RingHom.ker f) :=
  IsLocalization.lift (M := (arcClosedPoint f t ht).primeCompl)
    (g := arcChartToGeneric f t ht) (fun s =>
      isUnit_arcChartToGeneric_of_arcMap_ne_zero f t ht s
        (IsLocalRing.notMem_maximalIdeal.mp s.property).ne_zero)

@[simp]
theorem arcLocalToGeneric_base (f : C →+* R) (t : C) (ht : f t ≠ 0)
    (x : arcChart f t) :
    arcLocalToGeneric f t ht
        (algebraMap (arcChart f t) (arcLocalRing f t ht) x) =
      arcChartToGeneric f t ht x := IsLocalization.lift_eq _ _

@[simp]
theorem arcLocalToGeneric_arcLocalBase (f : C →+* R) (t : C) (ht : f t ≠ 0)
    (c : C) :
    arcLocalToGeneric f t ht (arcLocalBase f t ht c) =
      algebraMap C (Localization.AtPrime (RingHom.ker f)) c := by
  simp only [arcLocalBase, RingHom.comp_apply, arcLocalToGeneric_base, arcChartToGeneric_base]

/-- Nonzero arc image also forces invertibility after the closed-point
localization, by its actual numerator and denominator equation. -/
theorem isUnit_arcLocalToGeneric_of_arcLocalMap_ne_zero
    (f : C →+* R) (t : C) (ht : f t ≠ 0) (x : arcLocalRing f t ht)
    (hx : arcLocalMap f t ht x ≠ 0) : IsUnit (arcLocalToGeneric f t ht x) := by
  obtain ⟨a, s, rfl⟩ := IsLocalization.exists_mk'_eq (arcClosedPoint f t ht).primeCompl x
  have he : arcLocalMap f t ht (IsLocalization.mk' (arcLocalRing f t ht) a s) *
      arcMap f t ht s = arcMap f t ht a := by
    simpa only [map_mul, arcLocalMap_base] using congrArg (arcLocalMap f t ht)
      (IsLocalization.mk'_spec (arcLocalRing f t ht) a s)
  have ha : arcMap f t ht a ≠ 0 := by
    rw [← he]
    exact mul_ne_zero hx (IsLocalRing.notMem_maximalIdeal.mp s.property).ne_zero
  have hg : arcLocalToGeneric f t ht (IsLocalization.mk' (arcLocalRing f t ht) a s) *
      arcChartToGeneric f t ht s = arcChartToGeneric f t ht a := by
    simpa only [map_mul, arcLocalToGeneric_base] using congrArg (arcLocalToGeneric f t ht)
      (IsLocalization.mk'_spec (arcLocalRing f t ht) a s)
  exact isUnit_of_mul_isUnit_left
    (hg.symm ▸ isUnit_arcChartToGeneric_of_arcMap_ne_zero f t ht a ha)

/-- The actual local arc kernel pulls back to the original kernel. -/
theorem comap_ker_arcLocalMap (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    (RingHom.ker (arcLocalMap f t ht)).comap (arcLocalBase f t ht) = RingHom.ker f := by
  have h : (arcLocalMap f t ht).comp (arcLocalBase f t ht) = f := by
    ext c
    exact arcLocalMap_arcLocalBase f t ht c
  rw [RingHom.comap_ker, h]

/-- The actual generic localization of the actual arc-centre local ring.
The regular named type retains one exposed native localization presentation. -/
def arcGenericLocalRing (f : C →+* R) (t : C) (ht : f t ≠ 0) : Type u :=
  Localization.AtPrime (RingHom.ker (arcLocalMap f t ht))

instance arcGenericLocalRingCommRing (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    CommRing (arcGenericLocalRing f t ht) := by
  let cD : CommRing (arcLocalRing f t ht) :=
    @OreLocalization.instCommRing (arcChart f t)
      (inferInstanceAs (CommRing (arcChart f t)))
      (arcClosedPoint f t ht).primeCompl inferInstance
  exact @OreLocalization.instCommRing (arcLocalRing f t ht) cD
    (RingHom.ker (arcLocalMap f t ht)).primeCompl inferInstance

instance arcGenericLocalRingAlgebra (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    Algebra (arcLocalRing f t ht) (arcGenericLocalRing f t ht) :=
  inferInstanceAs (Algebra (arcLocalRing f t ht)
    (Localization.AtPrime (RingHom.ker (arcLocalMap f t ht))))

instance arcGenericLocalRingIsLocalization (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    IsLocalization.AtPrime (arcGenericLocalRing f t ht) (RingHom.ker (arcLocalMap f t ht)) :=
  inferInstanceAs (IsLocalization.AtPrime
    (Localization.AtPrime (RingHom.ker (arcLocalMap f t ht)))
    (RingHom.ker (arcLocalMap f t ht)))

instance arcGenericLocalRingIsLocalRing (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    IsLocalRing (arcGenericLocalRing f t ht) :=
  IsLocalization.AtPrime.isLocalRing (arcGenericLocalRing f t ht)
    (RingHom.ker (arcLocalMap f t ht))

/-- The native generic local-ring map on the original scalar map. -/
def arcGenericMap (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    Localization.AtPrime (RingHom.ker f) →+* arcGenericLocalRing f t ht :=
  Localization.localRingHom (RingHom.ker f) (RingHom.ker (arcLocalMap f t ht))
    (arcLocalBase f t ht) (comap_ker_arcLocalMap f t ht).symm

@[simp]
theorem arcGenericMap_base (f : C →+* R) (t : C) (ht : f t ≠ 0) (c : C) :
    arcGenericMap f t ht (algebraMap C (Localization.AtPrime (RingHom.ker f)) c) =
      algebraMap (arcLocalRing f t ht) (arcGenericLocalRing f t ht)
        (arcLocalBase f t ht c) := Localization.localRingHom_to_map _ _ _ _ _

/-- The inverse generic map is the actual lift of the constructed map to `C_p`. -/
def arcGenericInverse (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    arcGenericLocalRing f t ht →+* Localization.AtPrime (RingHom.ker f) :=
  IsLocalization.lift (M := (RingHom.ker (arcLocalMap f t ht)).primeCompl)
    (g := arcLocalToGeneric f t ht) (fun s =>
      isUnit_arcLocalToGeneric_of_arcLocalMap_ne_zero f t ht s
        (fun hs => s.property (RingHom.mem_ker.mpr hs)))

@[simp]
theorem arcGenericInverse_base (f : C →+* R) (t : C) (ht : f t ≠ 0)
    (x : arcLocalRing f t ht) :
    arcGenericInverse f t ht
        (algebraMap (arcLocalRing f t ht) (arcGenericLocalRing f t ht) x) =
      arcLocalToGeneric f t ht x := IsLocalization.lift_eq _ _

/-- The original exceptional parameter is a unit at the actual generic arc kernel. -/
theorem isUnit_arcGeneric_exceptional (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    IsUnit (algebraMap (arcLocalRing f t ht) (arcGenericLocalRing f t ht)
      (arcLocalBase f t ht t)) :=
  (IsLocalization.AtPrime.isUnit_to_map_iff (arcGenericLocalRing f t ht)
    (RingHom.ker (arcLocalMap f t ht)) (arcLocalBase f t ht t)).mpr
      (fun hz => ht (by simpa only [arcLocalMap_arcLocalBase] using RingHom.mem_ker.mp hz))

/-- The constructed inverse and the original native generic map compose to
the identity on the original generic local ring. -/
theorem arcGenericInverse_comp_arcGenericMap (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    (arcGenericInverse f t ht).comp (arcGenericMap f t ht) = RingHom.id _ := by
  apply IsLocalization.ringHom_ext (RingHom.ker f).primeCompl
  ext c
  simp only [RingHom.comp_apply, arcGenericMap_base, arcGenericInverse_base,
    arcLocalToGeneric_arcLocalBase, RingHom.id_apply]

/-- The other composite is the identity, by actual localization uniqueness
and the exceptional-unit uniqueness of saturated chart maps. -/
theorem arcGenericMap_comp_arcGenericInverse (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    (arcGenericMap f t ht).comp (arcGenericInverse f t ht) = RingHom.id _ := by
  have hD : (arcGenericMap f t ht).comp (arcLocalToGeneric f t ht) =
      algebraMap (arcLocalRing f t ht) (arcGenericLocalRing f t ht) := by
    apply IsLocalization.ringHom_ext (arcClosedPoint f t ht).primeCompl
    refine arcChart_ringHom_ext_of_exceptional_isUnit
      (S := arcGenericLocalRing f t ht) f t
      (((arcGenericMap f t ht).comp (arcLocalToGeneric f t ht)).comp
        (algebraMap (arcChart f t) (arcLocalRing f t ht)))
      ((algebraMap (arcLocalRing f t ht) (arcGenericLocalRing f t ht)).comp
        (algebraMap (arcChart f t) (arcLocalRing f t ht))) ?_ ?_
    · change IsUnit (arcGenericMap f t ht (arcLocalToGeneric f t ht
        (algebraMap (arcChart f t) (arcLocalRing f t ht)
          (algebraMap C (arcChart f t) t))))
      rw [arcLocalToGeneric_base, arcChartToGeneric_base, arcGenericMap_base]
      exact isUnit_arcGeneric_exceptional f t ht
    · intro c
      change arcGenericMap f t ht (arcLocalToGeneric f t ht
          (algebraMap (arcChart f t) (arcLocalRing f t ht)
            (algebraMap C (arcChart f t) c))) =
        algebraMap (arcLocalRing f t ht) (arcGenericLocalRing f t ht)
          (algebraMap (arcChart f t) (arcLocalRing f t ht)
            (algebraMap C (arcChart f t) c))
      rw [arcLocalToGeneric_base, arcChartToGeneric_base, arcGenericMap_base]
      rfl
  apply IsLocalization.ringHom_ext (RingHom.ker (arcLocalMap f t ht)).primeCompl
  ext x
  change arcGenericMap f t ht (arcGenericInverse f t ht
      (algebraMap (arcLocalRing f t ht) (arcGenericLocalRing f t ht) x)) =
    algebraMap (arcLocalRing f t ht) (arcGenericLocalRing f t ht) x
  rw [arcGenericInverse_base]
  exact RingHom.congr_fun hD x

/-- The actual generic local rings are canonically equivalent over the original `C`. -/
def arcGenericEquiv (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    Localization.AtPrime (RingHom.ker f) ≃+* arcGenericLocalRing f t ht where
  toFun := arcGenericMap f t ht
  invFun := arcGenericInverse f t ht
  left_inv := fun x => RingHom.congr_fun (arcGenericInverse_comp_arcGenericMap f t ht) x
  right_inv := fun x => RingHom.congr_fun (arcGenericMap_comp_arcGenericInverse f t ht) x
  map_mul' := map_mul (arcGenericMap f t ht)
  map_add' := map_add (arcGenericMap f t ht)

/-- The equivalence keeps exactly the native map on the original scalar homomorphism. -/
theorem arcGenericEquiv_toRingHom (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    (arcGenericEquiv f t ht).toRingHom = arcGenericMap f t ht := rfl

/-- The actual new generic quotient map, with its source ring fixed once,
to the fraction field of the same original `R`. -/
def arcGenericQuotientMap (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    arcGenericLocalRing f t ht →+* FractionRing R :=
  genericQuotientLift (arcLocalMap f t ht) (arcGenericLocalRing f t ht)

@[simp]
theorem arcGenericQuotientMap_base (f : C →+* R) (t : C) (ht : f t ≠ 0)
    (x : arcLocalRing f t ht) :
    arcGenericQuotientMap f t ht
        (algebraMap (arcLocalRing f t ht) (arcGenericLocalRing f t ht) x) =
      algebraMap R (FractionRing R) (arcLocalMap f t ht x) :=
  genericQuotientLift_base (arcLocalMap f t ht) (arcGenericLocalRing f t ht) x

/-- Both generic quotient maps land in the fraction field of the SAME original
`R`, and the constructed equivalence commutes with those actual maps. -/
theorem genericQuotientMap_comp_arcGenericEquiv
    (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    (arcGenericQuotientMap f t ht).comp (arcGenericEquiv f t ht).toRingHom =
      genericQuotientMap f := by
  rw [arcGenericEquiv_toRingHom]
  exact genericQuotientMap_comp_of_base f (arcLocalMap f t ht) (arcLocalBase f t ht)
    (algebraMap (arcLocalRing f t ht) (arcGenericLocalRing f t ht))
    (arcGenericQuotientMap f t ht) (arcGenericMap f t ht)
    (arcGenericQuotientMap_base f t ht) (arcGenericMap_base f t ht) (by
      ext c
      exact arcLocalMap_arcLocalBase f t ht c)

theorem arcGenericLocalRing_isDomain [IsDomain C]
    (f : C →+* R) (t : C) (ht : f t ≠ 0) : IsDomain (arcGenericLocalRing f t ht) :=
  MulEquiv.isDomain (Localization.AtPrime (RingHom.ker f))
    (arcGenericEquiv f t ht).symm.toMulEquiv

/-- The GIVEN DVR structure on the original generic local ring is preserved
by the constructed canonical comparison, with no regularity premise on the blowup. -/
theorem arcGenericLocalRing_isDiscreteValuationRing [IsDomain C]
    (f : C →+* R) (t : C) (ht : f t ≠ 0)
    [IsDiscreteValuationRing (Localization.AtPrime (RingHom.ker f))] :
    let _ : IsDomain (arcGenericLocalRing f t ht) := arcGenericLocalRing_isDomain f t ht
    IsDiscreteValuationRing (arcGenericLocalRing f t ht) := by
  let : IsDomain (arcGenericLocalRing f t ht) := arcGenericLocalRing_isDomain f t ht
  exact IsDiscreteValuationRing.RingEquivClass.isDiscreteValuationRing (arcGenericEquiv f t ht)

end GenericArc

end Localization.Away


namespace Ideal

/-- A cardinality-minimal generating finset remains irredundant even after
adding the squared ideal. The square is removed by Nakayama, not assumed away. -/
theorem not_mem_span_sdiff_sup_sq_of_minimal_generators
    {A : Type*} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    (p : Ideal A) (hp : p ≤ IsLocalRing.maximalIdeal A) (s : Finset A)
    (hspan : Ideal.span (s : Set A) = p) (hcard : s.card = p.spanFinrank)
    (z : A) (hz : z ∈ s) : z ∉ Ideal.span ((s : Set A) \ {z}) ⊔ p ^ 2 := by
  classical
  intro hrel
  let J := Ideal.span ((s : Set A) \ {z})
  have hle : p ≤ J ⊔ p ^ 2 := by
    apply hspan.ge.trans
    apply Ideal.span_le.mpr
    intro x hx
    by_cases hxe : x = z
    · change x ∈ Ideal.span ((s : Set A) \ {z}) ⊔ p ^ 2
      simpa only [hxe] using hrel
    · exact Submodule.mem_sup_left (Ideal.subset_span ⟨hx, hxe⟩)
  have hpJ : p ≤ J := Submodule.le_of_le_smul_of_le_jacobson_bot
    (IsNoetherian.noetherian (p : Submodule A A))
    (I := p) (hp.trans (IsLocalRing.maximalIdeal_le_jacobson (⊥ : Ideal A)))
    (by simpa only [smul_eq_mul, pow_two] using hle)
  have hJp : J ≤ p := by
    apply Ideal.span_le.mpr
    intro x hx
    exact hspan ▸ Ideal.subset_span hx.1
  have heq : J = p := le_antisymm hJp hpJ
  have herase : (s.erase z : Set A) = (s : Set A) \ {z} := by
    ext x
    simp
  have hJ : J = Ideal.span (s.erase z : Set A) := congrArg Ideal.span herase.symm
  have hbound : p.spanFinrank ≤ (s.erase z).card := by
    rw [← heq, hJ]
    exact (Submodule.spanFinrank_span_le_ncard_of_finite (s.erase z).finite_toSet).trans_eq
      (Set.ncard_coe_finset _)
  have hbound' : s.card ≤ (s.erase z).card := hcard.symm ▸ hbound
  exact Nat.not_lt_of_ge hbound' (Finset.card_erase_lt_of_mem hz)

/-- A finite family in a valuation ring has a member generating its ideal.
This selects an actual member of the original family. -/
theorem exists_mem_span_image_eq_span_singleton {ι A : Type*}
    [CommRing A] [IsDomain A] [ValuationRing A]
    (s : Finset ι) (hs : s.Nonempty) (g : ι → A) :
    ∃ i ∈ s, Ideal.span (g '' (s : Set ι)) = Ideal.span {g i} := by
  classical
  have hspan : Ideal.span (g '' (s : Set ι)) = s.sup (fun i => Ideal.span {g i}) := by
    apply le_antisymm
    · apply Ideal.span_le.mpr
      rintro _ ⟨i, hi, rfl⟩
      exact (show Ideal.span {g i} ≤ s.sup (fun i => Ideal.span {g i}) from
        Finset.le_sup (f := fun j => (Ideal.span {g j} : Ideal A)) hi)
          (Ideal.mem_span_singleton_self (g i))
    · apply Finset.sup_le
      intro i hi
      apply Ideal.span_le.mpr
      rintro x (rfl : x = g i)
      exact Ideal.subset_span ⟨i, hi, rfl⟩
  obtain ⟨i, hi, he⟩ := Finset.exists_mem_eq_sup s hs (fun i => Ideal.span {g i})
  exact ⟨i, hi, hspan.trans he⟩

end Ideal

namespace Localization.Away

variable {C : Type u} [CommRing C] {R : Type v} [CommRing R] [IsDomain R]

attribute [local instance] RingHom.ker_isPrime

/-- Minimal actual kernel generators can be chosen with a distinguished
member uniformizing the GIVEN original generic DVR. Their independence modulo
the squared kernel is proved by the cardinality minimum and Nakayama. -/
theorem exists_minimal_kernel_generators_generic_uniformizer
    [IsLocalRing C] [IsNoetherianRing C] [IsDomain C]
    (f : C →+* R) [IsDiscreteValuationRing (Localization.AtPrime (RingHom.ker f))] :
    ∃ s : Finset C, s.card = (RingHom.ker f).spanFinrank ∧
      Ideal.span (s : Set C) = RingHom.ker f ∧
      (∀ z ∈ s, z ∉ Ideal.span ((s : Set C) \ {z}) ⊔ RingHom.ker f ^ 2) ∧
      ∃ z₁ ∈ s, Irreducible (algebraMap C (Localization.AtPrime (RingHom.ker f)) z₁) := by
  classical
  have hfg : Submodule.FG (RingHom.ker f : Submodule C C) :=
    IsNoetherian.noetherian _
  obtain ⟨s, hcard, hspan⟩ :=
    Submodule.FG.exists_span_finset_card_eq_spanFinrank hfg
  change Ideal.span (s : Set C) = RingHom.ker f at hspan
  have hs : s.Nonempty := by
    by_contra hs
    have hs0 : s = ∅ := Finset.not_nonempty_iff_eq_empty.mp hs
    have hp0 : RingHom.ker f = ⊥ := by
      simpa only [hs0, Finset.coe_empty, Ideal.span_empty] using hspan.symm
    have hmap : (RingHom.ker f).map
        (algebraMap C (Localization.AtPrime (RingHom.ker f))) = ⊥ := by
      calc
        (RingHom.ker f).map (algebraMap C (Localization.AtPrime (RingHom.ker f))) =
            (⊥ : Ideal C).map (algebraMap C (Localization.AtPrime (RingHom.ker f))) :=
          congrArg (Ideal.map (algebraMap C (Localization.AtPrime (RingHom.ker f)))) hp0
        _ = ⊥ := (Ideal.map_bot :
          (⊥ : Ideal C).map (algebraMap C (Localization.AtPrime (RingHom.ker f))) = ⊥)
    have hmaxmap : (RingHom.ker f).map
        (algebraMap C (Localization.AtPrime (RingHom.ker f))) =
          IsLocalRing.maximalIdeal (Localization.AtPrime (RingHom.ker f)) :=
      Localization.AtPrime.map_eq_maximalIdeal
    exact IsDiscreteValuationRing.not_a_field (Localization.AtPrime (RingHom.ker f))
      (hmaxmap.symm.trans hmap)
  obtain ⟨z₁, hz₁, hgen⟩ := Ideal.exists_mem_span_image_eq_span_singleton s hs
    (algebraMap C (Localization.AtPrime (RingHom.ker f)))
  have hmax : IsLocalRing.maximalIdeal (Localization.AtPrime (RingHom.ker f)) =
      Ideal.span {algebraMap C (Localization.AtPrime (RingHom.ker f)) z₁} := by
    rw [← Ideal.map_span, hspan, Localization.AtPrime.map_eq_maximalIdeal] at hgen
    exact hgen
  refine ⟨s, hcard, hspan, ?_, z₁, hz₁, ?_⟩
  · intro z hz
    exact Ideal.not_mem_span_sdiff_sup_sq_of_minimal_generators (RingHom.ker f)
      (IsLocalRing.le_maximalIdeal (RingHom.ker_isPrime f).ne_top) s hspan hcard z hz
  · exact (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mpr hmax

section TorsionRelations

variable [IsLocalRing C] [IsDiscreteValuationRing R]

/-- Surjectivity onto the original DVR lifts the unit in its uniformizer
factorization. The difference belongs to the actual original kernel. -/
theorem exists_unit_pow_mod_ker (f : C →+* R) (hf : Function.Surjective f)
    (t c : C) (ht : Irreducible (f t)) (hc : f c ≠ 0) :
    ∃ (n : ℕ) (u : Cˣ), c - (u : C) * t ^ n ∈ RingHom.ker f := by
  let : IsLocalHom f := IsLocalHom.of_surjective f hf
  obtain ⟨n, v, hv⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hc ht
  obtain ⟨u, hu⟩ := hf (v : R)
  have huunit : IsUnit u := isUnit_of_map_unit f u (by rw [hu]; exact v.isUnit)
  obtain ⟨u, rfl⟩ := huunit
  refine ⟨n, u, RingHom.mem_ker.mpr ?_⟩
  rw [map_sub, map_mul, map_pow, hu, ← hv, sub_self]

/-- A chosen actual generator of the localized kernel gives an actual
power-torsion relation. The localization denominator is converted to a power
using the SURJECTION onto the same DVR, and its kernel error enters `p²`. -/
theorem exists_power_relation_of_generic_span
    (f : C →+* R) (hf : Function.Surjective f) (t : C) (ht : Irreducible (f t))
    (z₁ z : C) (hz : z ∈ RingHom.ker f)
    (hgen : (RingHom.ker f).map (algebraMap C (Localization.AtPrime (RingHom.ker f))) =
      Ideal.span {algebraMap C (Localization.AtPrime (RingHom.ker f)) z₁}) :
    ∃ (n : ℕ) (a : C), t ^ n * z - a * z₁ ∈ RingHom.ker f ^ 2 := by
  have hzloc : algebraMap C (Localization.AtPrime (RingHom.ker f)) z ∈
      (Ideal.span {z₁}).map (algebraMap C (Localization.AtPrime (RingHom.ker f))) := by
    rw [Ideal.map_span, Set.image_singleton, ← hgen]
    exact Ideal.mem_map_of_mem _ hz
  obtain ⟨c, hc, hcz⟩ :=
    (IsLocalization.algebraMap_mem_map_algebraMap_iff (RingHom.ker f).primeCompl
      (Localization.AtPrime (RingHom.ker f)) (Ideal.span {z₁}) z).mp hzloc
  have hfc : f c ≠ 0 := fun h => hc (RingHom.mem_ker.mpr h)
  obtain ⟨n, u, hu⟩ := exists_unit_pow_mod_ker f hf t c ht hfc
  let J := Ideal.span {z₁} ⊔ RingHom.ker f ^ 2
  have herror : (c - (u : C) * t ^ n) * z ∈ RingHom.ker f ^ 2 := by
    rw [pow_two]
    exact Ideal.mul_mem_mul hu hz
  have hprod : (u : C) * (t ^ n * z) ∈ J := by
    have h := J.sub_mem (Submodule.mem_sup_left hcz) (Submodule.mem_sup_right herror)
    convert h using 1
    ring
  have hmem : t ^ n * z ∈ J := (Ideal.unit_mul_mem_iff_mem J u.isUnit).mp hprod
  obtain ⟨a, b, hb, hab⟩ := Ideal.mem_span_singleton_sup.mp hmem
  refine ⟨n, a, ?_⟩
  have he : t ^ n * z - a * z₁ = b := by rw [← hab]; ring
  rw [he]
  exact hb

/-- Independence of two actual kernel generators modulo `p²` forces the
normalized torsion relation to have positive displayed exponents. -/
theorem exists_positive_normalized_relation
    (f : C →+* R) (hf : Function.Surjective f) (t : C) (ht : Irreducible (f t))
    (z₁ z : C) (hz₁ : z₁ ∈ RingHom.ker f) (hz : z ∈ RingHom.ker f)
    (hgen : (RingHom.ker f).map (algebraMap C (Localization.AtPrime (RingHom.ker f))) =
      Ideal.span {algebraMap C (Localization.AtPrime (RingHom.ker f)) z₁})
    (hindz : z ∉ Ideal.span {z₁} ⊔ RingHom.ker f ^ 2)
    (hind₁ : z₁ ∉ Ideal.span {z} ⊔ RingHom.ker f ^ 2) :
    ∃ n : ℕ, 0 < n ∧
      (t ^ n * z ∈ RingHom.ker f ^ 2 ∨
        ∃ (m : ℕ) (u : Cˣ), 0 < m ∧
          t ^ n * z - (u : C) * t ^ m * z₁ ∈ RingHom.ker f ^ 2) := by
  obtain ⟨n, a, hrel⟩ := exists_power_relation_of_generic_span f hf t ht z₁ z hz hgen
  have hn : 0 < n := by
    by_contra hn
    have hn0 : n = 0 := Nat.eq_zero_of_not_pos hn
    apply hindz
    apply Ideal.mem_span_singleton_sup.mpr
    refine ⟨a, z - a * z₁, ?_, ?_⟩
    · simpa only [hn0, pow_zero, one_mul] using hrel
    · ring
  refine ⟨n, hn, ?_⟩
  by_cases ha : f a = 0
  · left
    have haz : a * z₁ ∈ RingHom.ker f ^ 2 := by
      rw [pow_two]
      exact Ideal.mul_mem_mul (RingHom.mem_ker.mpr ha) hz₁
    simpa only [sub_add_cancel] using (RingHom.ker f ^ 2).add_mem hrel haz
  · right
    obtain ⟨m, u, hu⟩ := exists_unit_pow_mod_ker f hf t a ht ha
    have herror : (a - (u : C) * t ^ m) * z₁ ∈ RingHom.ker f ^ 2 := by
      rw [pow_two]
      exact Ideal.mul_mem_mul hu hz₁
    have hnew : t ^ n * z - (u : C) * t ^ m * z₁ ∈ RingHom.ker f ^ 2 := by
      convert (RingHom.ker f ^ 2).add_mem hrel herror using 1
      ring
    have hm : 0 < m := by
      by_contra hm
      have hm0 : m = 0 := Nat.eq_zero_of_not_pos hm
      have hnew0 : t ^ n * z - (u : C) * z₁ ∈ RingHom.ker f ^ 2 := by
        simpa only [hm0, pow_zero, mul_one] using hnew
      let J := Ideal.span {z} ⊔ RingHom.ker f ^ 2
      have hx : t ^ n * z ∈ J := Submodule.mem_sup_left
        ((Ideal.span {z}).mul_mem_left _ (Ideal.mem_span_singleton_self z))
      have huJ : (u : C) * z₁ ∈ J := by
        simpa only [sub_sub_cancel] using J.sub_mem hx (Submodule.mem_sup_right hnew0)
      exact hind₁ ((Ideal.unit_mul_mem_iff_mem J u.isUnit).mp huJ)
    exact ⟨m, u, hm, hnew⟩

/-- Two distinct members of an actual minimum-cardinality kernel generating
set supply the positive normalized relation used by the existing blowup division.
The first member is required to uniformize the GIVEN original generic DVR. -/
theorem exists_positive_relation_of_minimal_kernel_generators
    [IsNoetherianRing C] [IsDomain C]
    (f : C →+* R) (hf : Function.Surjective f) (t : C) (ht : Irreducible (f t))
    [IsDiscreteValuationRing (Localization.AtPrime (RingHom.ker f))]
    (s : Finset C) (hspan : Ideal.span (s : Set C) = RingHom.ker f)
    (hcard : s.card = (RingHom.ker f).spanFinrank)
    (z₁ z : C) (hz₁ : z₁ ∈ s) (hz : z ∈ s) (hne : z ≠ z₁)
    (huni : Irreducible (algebraMap C (Localization.AtPrime (RingHom.ker f)) z₁)) :
    ∃ n : ℕ, 0 < n ∧
      (t ^ n * z ∈ RingHom.ker f ^ 2 ∨
        ∃ (m : ℕ) (u : Cˣ), 0 < m ∧
          t ^ n * z - (u : C) * t ^ m * z₁ ∈ RingHom.ker f ^ 2) := by
  classical
  have hp : RingHom.ker f ≤ IsLocalRing.maximalIdeal C :=
    IsLocalRing.le_maximalIdeal (RingHom.ker_isPrime f).ne_top
  have hz₁p : z₁ ∈ RingHom.ker f := hspan ▸ Ideal.subset_span hz₁
  have hzp : z ∈ RingHom.ker f := hspan ▸ Ideal.subset_span hz
  have hgen : (RingHom.ker f).map (algebraMap C (Localization.AtPrime (RingHom.ker f))) =
      Ideal.span {algebraMap C (Localization.AtPrime (RingHom.ker f)) z₁} := by
    rw [Localization.AtPrime.map_eq_maximalIdeal, huni.maximalIdeal_eq]
  apply exists_positive_normalized_relation f hf t ht z₁ z hz₁p hzp hgen
  · intro h
    apply Ideal.not_mem_span_sdiff_sup_sq_of_minimal_generators
      (RingHom.ker f) hp s hspan hcard z hz
    have hle : Ideal.span {z₁} ⊔ RingHom.ker f ^ 2 ≤
        Ideal.span ((s : Set C) \ {z}) ⊔ RingHom.ker f ^ 2 :=
      sup_le_sup ((Ideal.span_singleton_le_iff_mem (Ideal.span ((s : Set C) \ {z}))).mpr
        (Ideal.subset_span ⟨hz₁, hne.symm⟩)) le_rfl
    exact hle h
  · intro h
    apply Ideal.not_mem_span_sdiff_sup_sq_of_minimal_generators
      (RingHom.ker f) hp s hspan hcard z₁ hz₁
    have hle : Ideal.span {z} ⊔ RingHom.ker f ^ 2 ≤
        Ideal.span ((s : Set C) \ {z₁}) ⊔ RingHom.ker f ^ 2 :=
      sup_le_sup ((Ideal.span_singleton_le_iff_mem (Ideal.span ((s : Set C) \ {z₁}))).mpr
        (Ideal.subset_span ⟨hz, hne⟩)) le_rfl
    exact hle h


/-- The principal-kernel stopping case is regular in the original dimension
two local ring, using its actual surjection and lifted uniformizer. -/
theorem isRegularLocalRing_of_ker_eq_span [IsNoetherianRing C]
    (f : C →+* R) (hf : Function.Surjective f) (t z : C)
    (ht : Irreducible (f t)) (hker : RingHom.ker f = Ideal.span {z})
    (hd : ringKrullDim C = 2) : IsRegularLocalRing C := by
  have hmax : IsLocalRing.maximalIdeal C = Ideal.span ({t, z} : Set C) := by
    rw [← arcCenterIdeal_eq_maximalIdeal f t hf ht.maximalIdeal_eq,
      arcCenterIdeal, hker, Ideal.span_insert]
  have hbound : (IsLocalRing.maximalIdeal C).spanFinrank ≤ 2 := by
    rw [hmax]
    apply (Submodule.spanFinrank_span_le_ncard_of_finite
      ((Set.finite_singleton z).insert t)).trans
    simpa only [Set.ncard_singleton] using Set.ncard_insert_le t ({z} : Set C)
  apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le C
  rw [hd]
  exact_mod_cast hbound

end TorsionRelations

section GeneratorCount

variable [IsLocalRing R]

omit [IsDomain R] [IsLocalRing R] in
/-- The actual saturated arc chart is a domain over the original domain.
The denominator is nonzero because its image under the same quotient is nonzero. -/
theorem arcChart_isDomain [IsDomain C]
    (f : C →+* R) (t : C) (ht : f t ≠ 0) : IsDomain (arcChart f t) := by
  have ht0 : t ≠ 0 := fun h => ht (by rw [h, map_zero])
  let : IsDomain (Localization.Away t) := IsLocalization.Away.isDomain _ ht0
  infer_instance

/-- Domainness is preserved in the actual localization at the arc centre. -/
theorem arcLocalRing_isDomain [IsDomain C]
    (f : C →+* R) (t : C) (ht : f t ≠ 0) : IsDomain (arcLocalRing f t ht) := by
  let : IsDomain (arcChart f t) := arcChart_isDomain f t ht
  exact IsLocalization.isDomain_of_le_nonZeroDivisors (arcLocalRing f t ht)
    (arcClosedPoint f t ht).primeCompl_le_nonZeroDivisors

/-- The intrinsic minimal number of generators of the actual localized arc
kernel cannot increase. The finite divided generating family is constructed
from a cardinality-minimal original family; no count-drop premise is used. -/
theorem spanFinrank_ker_arcLocalMap_le [IsNoetherianRing C]
    (f : C →+* R) (t : C) (ht : f t ≠ 0) :
    (RingHom.ker (arcLocalMap f t ht)).spanFinrank ≤ (RingHom.ker f).spanFinrank := by
  classical
  have hfg : Submodule.FG (RingHom.ker f : Submodule C C) :=
    IsNoetherian.noetherian _
  obtain ⟨s, hcard, hspan⟩ :=
    Submodule.FG.exists_span_finset_card_eq_spanFinrank hfg
  change Ideal.span (s : Set C) = RingHom.ker f at hspan
  let z : s → RingHom.ker f := fun i => ⟨i, hspan ▸ Ideal.subset_span i.property⟩
  have hz : Ideal.span (Set.range fun i => (z i : C)) = RingHom.ker f := by
    change Ideal.span (Set.range fun i : s => (i : C)) = RingHom.ker f
    have hset : Set.range (fun i : s => (i : C)) = (s : Set C) := by
      ext x
      constructor
      · rintro ⟨i, rfl⟩
        exact i.property
      · intro hx
        exact ⟨⟨x, hx⟩, rfl⟩
    rw [hset]
    exact hspan
  let w : s → arcLocalRing f t ht := fun i =>
    algebraMap (arcChart f t) (arcLocalRing f t ht) (arcFraction f t (z i))
  let v : Finset (arcLocalRing f t ht) := Finset.univ.image w
  have hv : (v : Set (arcLocalRing f t ht)) = Set.range w := by
    ext x
    simp only [v, Finset.mem_coe, Finset.mem_image, Finset.mem_univ, true_and, Set.mem_range]
  have hgen : Ideal.span (v : Set (arcLocalRing f t ht)) =
      RingHom.ker (arcLocalMap f t ht) := by
    rw [hv]
    exact (ker_arcLocalMap_eq_span f t ht z hz).symm
  have hbound : (RingHom.ker (arcLocalMap f t ht)).spanFinrank ≤ v.card := by
    rw [← hgen]
    exact (Submodule.spanFinrank_span_le_ncard_of_finite v.finite_toSet).trans_eq
      (Set.ncard_coe_finset _)
  have hcount : v.card ≤ s.card := by
    simpa only [v, Finset.card_univ, Fintype.card_coe] using
      (Finset.card_image_le (s := (Finset.univ : Finset s)) (f := w))
  exact hbound.trans (hcount.trans_eq hcard)

end GeneratorCount

end Localization.Away
