/-!
# The maximal-ideal completion of a discrete valuation ring

The actual maximal-ideal adic completion of a domain DVR is a henselian DVR. Its native algebra
map preserves irreducibles, and the inverse of the induced residue map gives the residue-field
identification. Fraction-field and constants maps retain their universal-property triangles.

## Extraction basis

Transferred existing declarations from `R5Lab/AlgebraicGeometry/LocalRing/AdicDVR.lean` at revision
`79307ff88f07d34fd5c3edb859f799c55e38f290`, source SHA-256
`dc7afe9b0b54d32e6db803543c440c5f3d96f5f6128389c09517acf11483a4d0`, lines 33–116.
The canonical wrappers at lines 28–31, 69–71 and 93 are reused directly.
The stated hypotheses and chosen maps are retained; declarations use native mathematical
namespaces and canonical carriers. Source correspondence is separate from native Lean validation.
-/

@[expose] public section

noncomputable section
set_option autoImplicit false
open IsLocalRing

namespace AdicCompletion

universe u

section Completion
variable (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]

/-- The completion maximal ideal is generated by the image of an irreducible element. -/
theorem maximalIdeal_eq_span_of_irreducible (π : R) (hπ : Irreducible π) :
    maximalIdeal (AdicCompletion (maximalIdeal R) R) =
      Ideal.span {algebraMap R (AdicCompletion (maximalIdeal R) R) π} := by
  calc
    maximalIdeal (AdicCompletion (maximalIdeal R) R) =
        Ideal.map (algebraMap R (AdicCompletion (maximalIdeal R) R)) (maximalIdeal R) :=
      AdicCompletion.maximalIdeal_eq_map
    _ = Ideal.map (algebraMap R (AdicCompletion (maximalIdeal R) R)) (Ideal.span {π}) :=
      congrArg (Ideal.map (algebraMap R (AdicCompletion (maximalIdeal R) R))) hπ.maximalIdeal_eq
    _ = Ideal.span {algebraMap R (AdicCompletion (maximalIdeal R) R) π} := by
      rw [Ideal.map_span]; simp

/-- Every power of the image of an irreducible element in the completion is nonzero. -/
theorem algebraMap_pow_ne_zero_of_irreducible (π : R) (hπ : Irreducible π) (n : ℕ) :
    (algebraMap R (AdicCompletion (maximalIdeal R) R) π) ^ n ≠ 0 := by
  have hinj : Function.Injective (algebraMap R (AdicCompletion (maximalIdeal R) R)) := by
    intro x y h
    apply AdicCompletion.of_injective (maximalIdeal R) R
    simpa only [AdicCompletion.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply] using h
  intro h
  apply pow_ne_zero n hπ.ne_zero
  apply hinj
  simpa only [_root_.map_pow, _root_.map_zero] using h

/-- The maximal-ideal completion of a domain DVR is a domain. -/
instance instIsDomainMaximalIdeal : IsDomain (AdicCompletion (maximalIdeal R) R) := by
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible R
  exact IsLocalRing.isDomain_of_isHausdorff_of_maximalIdeal_eq_span
    (algebraMap R (AdicCompletion (maximalIdeal R) R) π)
    (maximalIdeal_eq_span_of_irreducible R π hπ)
    (algebraMap_pow_ne_zero_of_irreducible R π hπ)

/-- The maximal-ideal completion of a domain DVR is a DVR. -/
instance instIsDiscreteValuationRingMaximalIdeal :
    IsDiscreteValuationRing (AdicCompletion (maximalIdeal R) R) := by
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible R
  exact IsLocalRing.isDiscreteValuationRing_of_isHausdorff_of_maximalIdeal_eq_span
    (algebraMap R (AdicCompletion (maximalIdeal R) R) π)
    (maximalIdeal_eq_span_of_irreducible R π hπ)
    (algebraMap_pow_ne_zero_of_irreducible R π hπ)

/-- The completion algebra map sends irreducible elements to irreducible elements. -/
theorem irreducible_algebraMap (π : R) (hπ : Irreducible π) :
    Irreducible (algebraMap R (AdicCompletion (maximalIdeal R) R) π) :=
  (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mpr
    (maximalIdeal_eq_span_of_irreducible R π hπ)

/-- The maximal-ideal completion of a DVR is a henselian local ring. -/
instance instHenselianLocalRingMaximalIdeal :
    HenselianLocalRing (AdicCompletion (maximalIdeal R) R) where
  is_henselian p hp a ha hd := by
    have hi : IsUnit (Ideal.Quotient.mk (maximalIdeal (AdicCompletion (maximalIdeal R) R))
        (p.derivative.eval a)) :=
      hd.map _
    exact HenselianRing.is_henselian p hp a ha hi

/-- The residue identification is the inverse of the actual induced residue map. -/
def residueFieldEquiv : ResidueField (AdicCompletion (maximalIdeal R) R) ≃+* ResidueField R :=
  (RingEquiv.ofBijective (ResidueField.map (algebraMap R (AdicCompletion (maximalIdeal R) R)))
    (AdicCompletion.residueField_map_bijective R)).symm

/-- The chosen residue-field equivalence inverts the actual induced residue map. -/
@[simp] theorem residueFieldEquiv_map (x : ResidueField R) :
    residueFieldEquiv R
      (ResidueField.map (algebraMap R (AdicCompletion (maximalIdeal R) R)) x) = x :=
  RingEquiv.symm_apply_apply _ x

/-- Residue identification for any selected original residue-field marking. -/
def residueFieldEquivOfEquiv {F : Type*} [Field F] (eR : ResidueField R ≃+* F) :
    ResidueField (AdicCompletion (maximalIdeal R) R) ≃+* F :=
  (residueFieldEquiv R).trans eR

/-- The marked residue-field equivalence commutes with the actual completion residue map. -/
theorem residueFieldEquivOfEquiv_comp {F : Type*} [Field F] (eR : ResidueField R ≃+* F) :
    (residueFieldEquivOfEquiv R eR).toRingHom.comp
        (ResidueField.map (algebraMap R (AdicCompletion (maximalIdeal R) R))) =
      eR.toRingHom := by
  ext x
  exact congrArg eR (residueFieldEquiv_map R x)

/-- The original fraction field embeds by the universal property of localization. -/
def fractionRingMap (K : Type*) [Field K] [Algebra R K] [IsFractionRing R K] :
    K →+* FractionRing (AdicCompletion (maximalIdeal R) R) :=
  IsFractionRing.lift (K := K)
    (g := (algebraMap (AdicCompletion (maximalIdeal R) R)
      (FractionRing (AdicCompletion (maximalIdeal R) R))).comp
        (algebraMap R (AdicCompletion (maximalIdeal R) R)))
    ((IsFractionRing.injective (AdicCompletion (maximalIdeal R) R)
      (FractionRing (AdicCompletion (maximalIdeal R) R))).comp
        (AdicCompletion.of_injective (maximalIdeal R) R))

/-- The fraction-ring map extends the completion map on the original ring. -/
@[simp] theorem fractionRingMap_algebraMap (K : Type*) [Field K] [Algebra R K]
    [IsFractionRing R K] (r : R) :
    fractionRingMap R K (algebraMap R K r) =
      algebraMap (AdicCompletion (maximalIdeal R) R)
        (FractionRing (AdicCompletion (maximalIdeal R) R))
        (algebraMap R (AdicCompletion (maximalIdeal R) R) r) :=
  IsFractionRing.lift_algebraMap _ r

/-- Constants sent through the original ring, its completion, and its fraction field. -/
def fractionRingConstantsMap {F : Type*} [CommRing F] (c : F →+* R) :
    F →+* FractionRing (AdicCompletion (maximalIdeal R) R) :=
  (algebraMap (AdicCompletion (maximalIdeal R) R)
    (FractionRing (AdicCompletion (maximalIdeal R) R))).comp
      ((algebraMap R (AdicCompletion (maximalIdeal R) R)).comp c)

/-- The constants map factors through the original fraction field by the actual maps. -/
theorem fractionRingConstantsMap_eq_comp {F : Type*} [CommRing F] (c : F →+* R)
    (K : Type*) [Field K] [Algebra R K] [IsFractionRing R K] :
    fractionRingConstantsMap R c = (fractionRingMap R K).comp ((algebraMap R K).comp c) := by
  ext a
  exact (fractionRingMap_algebraMap R K (c a)).symm

end Completion
end AdicCompletion
