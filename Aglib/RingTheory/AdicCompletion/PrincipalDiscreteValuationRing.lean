module

public import Aglib.RingTheory.AdicCompletion.Powers
public import Aglib.RingTheory.LocalRing.SeparatedPrincipal
public import Mathlib.Algebra.GroupWithZero.Action.Regular
public import Mathlib.RingTheory.AdicCompletion.LocalRing

/-!
# Completion at a regular generator of the maximal ideal

If a local commutative ring has maximal ideal generated by a nonzerodivisor
`p`, its literal `(p)`-adic completion is a complete DVR. The image of `p`
is a uniformizer, and the original completion map induces the residue-field
comparison. The original ring need not be Noetherian or a domain.

Regularity in the completion is proved on the actual quotient coordinates.
The finite-generation completion APIs provide its local structure, and the
existing separated-principal-ring theorem supplies unit-power factorization
and the DVR conclusion. Flatness of the completion map is not assumed.
-/

@[expose] public noncomputable section

open IsLocalRing
open scoped nonZeroDivisors

namespace AdicCompletion

variable (B : Type*) [CommRing B]

/-- A regular element stays regular in the literal completion at the
principal ideal it generates. No Noetherianity or separatedness of the
original ring is required. -/
theorem isSMulRegular_algebraMap_span_singleton (p : B) (hp : IsSMulRegular B p) :
    IsSMulRegular (AdicCompletion (Ideal.span {p}) B)
      (algebraMap B (AdicCompletion (Ideal.span {p}) B) p) := by
  let I : Ideal B := Ideal.span {p}
  apply IsSMulRegular.of_right_eq_zero_of_smul
  intro u hu
  change algebraMap B (AdicCompletion I B) p * u = 0 at hu
  apply ext_evalₐ
  intro n
  rw [_root_.map_zero]
  obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (evalₐ I (n + 1) u)
  have hcoefficient : evalₐ I (n + 1)
      (algebraMap B (AdicCompletion I B) p) = Ideal.Quotient.mk (I ^ (n + 1)) p := by
    simpa only [Ideal.Quotient.algebraMap_eq] using (evalₐ I (n + 1)).commutes p
  have hpb : p * b ∈ I ^ (n + 1) := by
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    rw [_root_.map_mul, hb, ← hcoefficient,
      ← _root_.map_mul, hu, _root_.map_zero]
  have hbpow : b ∈ I ^ n := by
    change p * b ∈ (Ideal.span {p}) ^ (n + 1) at hpb
    rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hpb
    obtain ⟨c, hc⟩ := hpb
    change b ∈ (Ideal.span {p}) ^ n
    rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton]
    refine ⟨c, hp ?_⟩
    change p * b = p * (p ^ n * c)
    simpa only [pow_succ', mul_assoc] using hc
  have htransition := factor_evalₐ I (Nat.le_succ n) u
  rw [← hb] at htransition
  change Ideal.Quotient.mk (I ^ n) b = evalₐ I n u at htransition
  rw [← htransition]
  exact Ideal.Quotient.eq_zero_iff_mem.mpr hbpow

variable [IsLocalRing B] (p : B) (hm : maximalIdeal B = Ideal.span {p})

include hm

private theorem span_singleton_isMaximal : (Ideal.span {p}).IsMaximal := by
  rw [← hm]
  infer_instance

/-- The completion at the specified generator is local, using only finite
generation of the original maximal ideal. -/
theorem isLocalRing_span_singleton : IsLocalRing (AdicCompletion (Ideal.span {p}) B) := by
  let I : Ideal B := Ideal.span {p}
  let : I.IsMaximal := span_singleton_isMaximal B p hm
  let : (I.map (algebraMap B (AdicCompletion I B))).IsMaximal :=
    isMaximal_map_of_le I I le_rfl (Submodule.fg_span_singleton p)
  let : IsAdicComplete (I.map (algebraMap B (AdicCompletion I B)))
      (AdicCompletion I B) := isAdicComplete_self I (Submodule.fg_span_singleton p)
  exact isLocalRing_of_isAdicComplete_maximal
    (I.map (algebraMap B (AdicCompletion I B)))

/-- The actual maximal ideal of the completion is generated by the image
of the original parameter. -/
theorem maximalIdeal_span_singleton :
    let _ : IsLocalRing (AdicCompletion (Ideal.span {p}) B) := isLocalRing_span_singleton B p hm
    maximalIdeal (AdicCompletion (Ideal.span {p}) B) =
      Ideal.span {algebraMap B (AdicCompletion (Ideal.span {p}) B) p} := by
  let I : Ideal B := Ideal.span {p}
  let : IsLocalRing (AdicCompletion I B) := isLocalRing_span_singleton B p hm
  let : I.IsMaximal := span_singleton_isMaximal B p hm
  have hmax : (I.map (algebraMap B (AdicCompletion I B))).IsMaximal :=
    isMaximal_map_of_le I I le_rfl (Submodule.fg_span_singleton p)
  calc
    maximalIdeal (AdicCompletion I B) = I.map (algebraMap B (AdicCompletion I B)) :=
      (IsLocalRing.eq_maximalIdeal hmax).symm
    _ = Ideal.span {algebraMap B (AdicCompletion I B) p} := by
      change (Ideal.span {p}).map (algebraMap B (AdicCompletion I B)) = _
      rw [Ideal.map_span, Set.image_singleton]

/-- The literal principal completion is complete for its own maximal ideal. -/
theorem isAdicComplete_maximalIdeal_span_singleton :
    let _ : IsLocalRing (AdicCompletion (Ideal.span {p}) B) := isLocalRing_span_singleton B p hm
    IsAdicComplete (maximalIdeal (AdicCompletion (Ideal.span {p}) B))
      (AdicCompletion (Ideal.span {p}) B) := by
  let : IsLocalRing (AdicCompletion (Ideal.span {p}) B) := isLocalRing_span_singleton B p hm
  change IsAdicComplete (maximalIdeal (AdicCompletion (Ideal.span {p}) B))
    (AdicCompletion (Ideal.span {p}) B)
  rw [maximalIdeal_span_singleton B p hm]
  simpa only [Ideal.map_span, Set.image_singleton] using
    isAdicComplete_self (Ideal.span {p}) (Submodule.fg_span_singleton p)

/-- The original completion map is local even when the original ring is
not known to be Noetherian. -/
theorem algebraMap_isLocalHom_span_singleton :
    IsLocalHom (algebraMap B (AdicCompletion (Ideal.span {p}) B)) := by
  let : IsLocalRing (AdicCompletion (Ideal.span {p}) B) := isLocalRing_span_singleton B p hm
  apply ((IsLocalRing.local_hom_TFAE
    (algebraMap B (AdicCompletion (Ideal.span {p}) B))).out 1 3).mpr
  rw [hm, maximalIdeal_span_singleton B p hm, Ideal.map_span, Set.image_singleton]

private theorem algebraMap_pow_ne_zero (hp : p ∈ B⁰) (n : ℕ) :
    (algebraMap B (AdicCompletion (Ideal.span {p}) B) p) ^ n ≠ 0 := by
  let : IsLocalRing (AdicCompletion (Ideal.span {p}) B) := isLocalRing_span_singleton B p hm
  have hpreg : IsSMulRegular B p := by
    apply IsSMulRegular.of_right_eq_zero_of_smul
    intro b hb
    exact (mem_nonZeroDivisors_iff_left.mp hp) b (by simpa only [smul_eq_mul] using hb)
  have hreg := isSMulRegular_algebraMap_span_singleton B p hpreg
  intro hzero
  have hone : (1 : AdicCompletion (Ideal.span {p}) B) = 0 :=
    (IsSMulRegular.pow n hreg).right_eq_zero_of_smul
      (by simpa only [smul_eq_mul, mul_one] using hzero)
  exact one_ne_zero hone

/-- A principal completion at a regular generator of the maximal ideal is
a domain. The original ring itself is not assumed to be a domain. -/
theorem isDomain_span_singleton (hp : p ∈ B⁰) :
    IsDomain (AdicCompletion (Ideal.span {p}) B) := by
  let : IsLocalRing (AdicCompletion (Ideal.span {p}) B) := isLocalRing_span_singleton B p hm
  let : IsAdicComplete (maximalIdeal (AdicCompletion (Ideal.span {p}) B))
      (AdicCompletion (Ideal.span {p}) B) := isAdicComplete_maximalIdeal_span_singleton B p hm
  exact IsLocalRing.isDomain_of_isHausdorff_of_maximalIdeal_eq_span
    (algebraMap B (AdicCompletion (Ideal.span {p}) B) p)
    (maximalIdeal_span_singleton B p hm) (algebraMap_pow_ne_zero B p hm hp)

/-- The literal principal completion is a DVR, by its actual separated
principal maximal ideal and unit-power factorizations. No Noetherian-base,
flat-completion, or residue-perfectness premise is used. -/
theorem isDiscreteValuationRing_span_singleton (hp : p ∈ B⁰) :
    let _ : IsDomain (AdicCompletion (Ideal.span {p}) B) := isDomain_span_singleton B p hm hp
    IsDiscreteValuationRing (AdicCompletion (Ideal.span {p}) B) := by
  let : IsLocalRing (AdicCompletion (Ideal.span {p}) B) := isLocalRing_span_singleton B p hm
  let : IsAdicComplete (maximalIdeal (AdicCompletion (Ideal.span {p}) B))
      (AdicCompletion (Ideal.span {p}) B) := isAdicComplete_maximalIdeal_span_singleton B p hm
  exact IsLocalRing.isDiscreteValuationRing_of_isHausdorff_of_maximalIdeal_eq_span
    (algebraMap B (AdicCompletion (Ideal.span {p}) B) p)
    (maximalIdeal_span_singleton B p hm) (algebraMap_pow_ne_zero B p hm hp)

/-- The original parameter maps to a uniformizer of the actual completion. -/
theorem irreducible_algebraMap_span_singleton (hp : p ∈ B⁰) :
    Irreducible (algebraMap B (AdicCompletion (Ideal.span {p}) B) p) := by
  let : IsDomain (AdicCompletion (Ideal.span {p}) B) := isDomain_span_singleton B p hm hp
  let : IsDiscreteValuationRing (AdicCompletion (Ideal.span {p}) B) :=
    isDiscreteValuationRing_span_singleton B p hm hp
  exact (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mpr
    (maximalIdeal_span_singleton B p hm)

/-- The residue comparison is induced by the original completion map and
is bijective. This part only needs the principal maximal ideal. -/
theorem residueFieldMap_span_singleton_bijective :
    let _ : IsLocalRing (AdicCompletion (Ideal.span {p}) B) := isLocalRing_span_singleton B p hm
    let _ : IsLocalHom (algebraMap B (AdicCompletion (Ideal.span {p}) B)) :=
      algebraMap_isLocalHom_span_singleton B p hm
    Function.Bijective (ResidueField.map
      (algebraMap B (AdicCompletion (Ideal.span {p}) B))) := by
  let I : Ideal B := Ideal.span {p}
  let : IsLocalRing (AdicCompletion I B) := isLocalRing_span_singleton B p hm
  let : IsLocalHom (algebraMap B (AdicCompletion I B)) :=
    algebraMap_isLocalHom_span_singleton B p hm
  refine ⟨RingHom.injective _, ?_⟩
  intro z
  obtain ⟨u, rfl⟩ := residue_surjective (R := AdicCompletion I B) z
  obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (evalOneₐ I u)
  refine ⟨residue B b, ?_⟩
  rw [ResidueField.map_residue]
  apply sub_eq_zero.mp
  rw [← _root_.map_sub, residue_eq_zero_iff]
  have hmem : algebraMap B (AdicCompletion I B) b - u ∈
      I.map (algebraMap B (AdicCompletion I B)) := by
    rw [← ker_evalOneₐ_eq_map I (Submodule.fg_span_singleton p)]
    change evalOneₐ I (algebraMap B (AdicCompletion I B) b - u) = 0
    rw [_root_.map_sub, (evalOneₐ I).commutes]
    exact sub_eq_zero.mpr hb
  rw [maximalIdeal_span_singleton B p hm]
  simpa only [I, Ideal.map_span, Set.image_singleton] using hmem

/-- The residue-field equivalence is the inverse of the actual map induced
by the completion algebra map. -/
def residueFieldEquivSpanSingleton :
    let _ : IsLocalRing (AdicCompletion (Ideal.span {p}) B) := isLocalRing_span_singleton B p hm
    ResidueField (AdicCompletion (Ideal.span {p}) B) ≃+* ResidueField B := by
  let : IsLocalRing (AdicCompletion (Ideal.span {p}) B) := isLocalRing_span_singleton B p hm
  let : IsLocalHom (algebraMap B (AdicCompletion (Ideal.span {p}) B)) :=
    algebraMap_isLocalHom_span_singleton B p hm
  exact (RingEquiv.ofBijective
    (ResidueField.map (algebraMap B (AdicCompletion (Ideal.span {p}) B)))
    (residueFieldMap_span_singleton_bijective B p hm)).symm

/-- The residue equivalence returns each original residue class along the
literal induced map. -/
@[simp]
theorem residueFieldEquivSpanSingleton_map (b : ResidueField B) :
    let _ : IsLocalRing (AdicCompletion (Ideal.span {p}) B) := isLocalRing_span_singleton B p hm
    let _ : IsLocalHom (algebraMap B (AdicCompletion (Ideal.span {p}) B)) :=
      algebraMap_isLocalHom_span_singleton B p hm
    residueFieldEquivSpanSingleton B p hm
      (ResidueField.map (algebraMap B (AdicCompletion (Ideal.span {p}) B)) b) = b := by
  let : IsLocalRing (AdicCompletion (Ideal.span {p}) B) := isLocalRing_span_singleton B p hm
  let : IsLocalHom (algebraMap B (AdicCompletion (Ideal.span {p}) B)) :=
    algebraMap_isLocalHom_span_singleton B p hm
  exact RingEquiv.symm_apply_apply _ b

end AdicCompletion
