module

public import Mathlib.RingTheory.Unramified.Field

/-! # Separability above a family spanning the differentials

This criterion produces algebraic separability over the field generated by the
family. It does not assert that the family is algebraically independent.
-/

@[expose] public noncomputable section

namespace KaehlerDifferential

variable {k K ι : Type*} [Field k] [Field K] [Algebra k K]

/-- A family whose differentials span the differential module over the original
ground field gives a separable algebraic extension above its generated field, in finite type. -/
theorem isSeparable_adjoin_of_span_differentials [Algebra.EssFiniteType k K]
    (x : ι → K)
    (hx : Submodule.span K (Set.range (fun i => D k K (x i))) = ⊤) :
    Algebra.IsSeparable (IntermediateField.adjoin k (Set.range x)) K := by
  let L := IntermediateField.adjoin k (Set.range x)
  let q : KaehlerDifferential k K →ₗ[K] KaehlerDifferential L K := map k L K K
  have hker : ⊤ ≤ LinearMap.ker q := by
    rw [← hx]
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨i, rfl⟩
    change map k L K K (D k K (x i)) = 0
    rw [map_D]
    change D L K (x i) = 0
    exact (D L K).map_algebraMap
      (⟨x i, IntermediateField.subset_adjoin k (Set.range x) ⟨i, rfl⟩⟩ : L)
  have hzero (y : KaehlerDifferential k K) : q y = 0 :=
    hker (Submodule.mem_top : y ∈ (⊤ : Submodule K (KaehlerDifferential k K)))
  have hsurj : Function.Surjective q := map_surjective k L K
  let : Subsingleton (KaehlerDifferential L K) := ⟨by
    intro u v
    obtain ⟨a, rfl⟩ := hsurj u
    obtain ⟨b, rfl⟩ := hsurj v
    exact (hzero a).trans (hzero b).symm⟩
  let : Algebra.FormallyUnramified L K := ⟨inferInstance⟩
  let : Algebra.EssFiniteType L K := Algebra.EssFiniteType.of_comp k L K
  exact Algebra.FormallyUnramified.isSeparable L K

end KaehlerDifferential
