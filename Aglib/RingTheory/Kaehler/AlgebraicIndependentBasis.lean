module

public import Aglib.RingTheory.Kaehler.SeparatingBasis
public import Mathlib.RingTheory.AlgebraicIndependent.Adjoin

/-! # The actual differential basis of a separating family

The rational function field is identified with the intermediate field generated by
the displayed family using the native algebraic-independence equivalence. The
resulting basis consists of the differentials of those actual field elements.
-/

@[expose] public noncomputable section

open MvPolynomial

namespace KaehlerDifferential

variable {k K ι : Type*} [Field k] [Field K] [Algebra k K]

/-- An algebraically independent family with algebraic separable extension above its
adjoined field gives an actual differential basis over the original ground field. -/
theorem exists_basis_of_algebraicIndependent (x : ι → K)
    (hx : AlgebraicIndependent k x)
    [Algebra.IsSeparable (IntermediateField.adjoin k (Set.range x)) K] :
    ∃ b : Module.Basis ι K (KaehlerDifferential k K), ∀ i, b i = D k K (x i) := by
  let P := MvPolynomial ι k
  let L := IntermediateField.adjoin k (Set.range x)
  let e₀ : FractionRing P ≃ₐ[k] L := hx.aevalEquivField
  let : Algebra P L :=
    (e₀.toRingHom.comp (algebraMap P (FractionRing P))).toAlgebra
  let e : FractionRing P ≃ₐ[P] L :=
    { e₀.toRingEquiv with commutes' := fun _ => rfl }
  let : IsFractionRing P L := IsFractionRing.of_algEquiv e
  let : Algebra P K := (aeval x).toRingHom.toAlgebra
  let : IsScalarTower k P K := IsScalarTower.of_algHom (aeval x)
  let : IsScalarTower P L K := IsScalarTower.of_algebraMap_eq fun f => by
    change aeval x f = (e₀ (algebraMap P (FractionRing P) f) : K)
    exact (hx.aevalEquivField_algebraMap_apply_coe f).symm
  obtain ⟨b, hb⟩ := exists_basis_of_fractionRing_separable k ι L K
  refine ⟨b, fun i => ?_⟩
  have hi := hb i
  change b i = D k K (aeval x (X i)) at hi
  simpa only [aeval_X] using hi

end KaehlerDifferential
