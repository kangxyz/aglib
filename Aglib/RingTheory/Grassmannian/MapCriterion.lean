module

public import Aglib.RingTheory.Grassmannian.Kernel
public import Aglib.RingTheory.Grassmannian.BaseChangeFormula

/-!
# Base change of a Grassmannian point through the image of the point

For an `R`-algebra map `f : A → B` and `N ∈ G(k, A ⊗[R] M; A)`, Mathlib's base change `map f N` is
the `B`-submodule generated by the image of `N` under `f ⊗ id`:

* `Module.Grassmannian.rTensor_mem_map`: `f ⊗ id` maps `N` into `map f N`;
* `Module.Grassmannian.map_toSubmodule_le`: `map f N` lies in every `B`-submodule containing that
  image;
* `Module.Grassmannian.map_eq_of_forall`: so `map f N = N'` as soon as `f ⊗ id` maps `N` into the
  point `N'` (`eq_of_le`). This reduces naturality of a family of points to an inclusion of
  submodules.
-/

@[expose] public section

open scoped TensorProduct

universe u v w

namespace Module.Grassmannian

/-- `f ⊗ id` maps a point of the Grassmannian into its base change along `f`. -/
theorem rTensor_mem_map {R : Type u} [CommRing R] {M : Type u} [AddCommGroup M] [Module R M]
    {k : ℕ} {A B : Type u} [CommRing A] [Algebra R A] [CommRing B] [Algebra R B]
    (f : A →ₐ[R] B) (N : Module.Grassmannian A (A ⊗[R] M) k) {y : A ⊗[R] M}
    (hy : y ∈ N.toSubmodule) : f.toLinearMap.rTensor M y ∈ (map f N).toSubmodule := by
  let : Algebra A B := f.toAlgebra
  let : IsScalarTower R A B :=
    IsScalarTower.of_algebraMap_eq' <| IsScalarTower.algebraMap_eq R A B
  rw [map_toSubmodule, LinearMap.mem_ker]
  have key : ∀ z : A ⊗[R] M, baseChangeMkQ B N.toSubmodule (f.toLinearMap.rTensor M z) =
      (1 : B) ⊗ₜ[A] N.toSubmodule.mkQ z := by
    intro z
    induction z using TensorProduct.inductionOn with
    | tmul a m =>
      rw [LinearMap.rTensor_tmul, baseChangeMkQ_tmul]
      change algebraMap A B a ⊗ₜ[A] _ = _
      rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul, ← map_smul,
        TensorProduct.smul_tmul', smul_eq_mul, mul_one]
    | add x y hx hy => rw [map_add, map_add, hx, hy, map_add, TensorProduct.tmul_add]
  rw [key, Submodule.mkQ_apply, (Submodule.Quotient.mk_eq_zero _).mpr hy, TensorProduct.tmul_zero]

/-- **Base change of a Grassmannian point is generated by the image of the point**: for an
`R`-algebra map `f : A → B`, `N ∈ G(k, A ⊗[R] M; A)` and a `B`-submodule `N''` of `B ⊗[R] M`
containing the image of `N` under `f ⊗ id`, Mathlib's base change `map f N` is contained in `N''`.
With `eq_of_le` this reduces naturality of a family of points to the inclusion of images. -/
theorem map_toSubmodule_le {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]
    {k : ℕ} {A B : Type w} [CommRing A] [Algebra R A] [CommRing B] [Algebra R B]
    (f : A →ₐ[R] B) (N : Module.Grassmannian A (A ⊗[R] M) k) (N'' : Submodule B (B ⊗[R] M))
    (h : ∀ x ∈ N.toSubmodule, f.toLinearMap.rTensor M x ∈ N'') :
    (map f N).toSubmodule ≤ N'' := by
  let : Algebra A B := f.toAlgebra
  let : IsScalarTower R A B :=
    IsScalarTower.of_algebraMap_eq' <| IsScalarTower.algebraMap_eq R A B
  rw [map_toSubmodule]
  let φ : A ⊗[R] M →ₗ[A] B ⊗[R] M :=
    TensorProduct.AlgebraTensorModule.rTensor R M (Algebra.linearMap A B)
  have hφ : ∀ x, φ x = f.toLinearMap.rTensor M x := fun x => by
    induction x using TensorProduct.inductionOn with
    | tmul a m => rfl
    | add x y hx hy => rw [map_add, map_add, hx, hy]
  let l : (A ⊗[R] M) ⧸ N.toSubmodule →ₗ[A] (B ⊗[R] M) ⧸ N'' :=
    N.toSubmodule.liftQ ((N''.mkQ.restrictScalars A) ∘ₗ φ) fun x hx => by
      simpa [hφ x, Submodule.Quotient.mk_eq_zero] using h x hx
  let ψ : B ⊗[A] ((A ⊗[R] M) ⧸ N.toSubmodule) →ₗ[B] (B ⊗[R] M) ⧸ N'' :=
    LinearMap.liftBaseChange B l
  have key : ∀ x, ψ (baseChangeMkQ B N.toSubmodule x) = N''.mkQ x := fun x => by
    induction x using TensorProduct.inductionOn with
    | tmul b m =>
      rw [baseChangeMkQ_tmul, LinearMap.liftBaseChange_tmul]
      change b • N''.mkQ (φ ((1 : A) ⊗ₜ[R] m)) = N''.mkQ (b ⊗ₜ[R] m)
      rw [← map_smul, hφ, LinearMap.rTensor_tmul, AlgHom.toLinearMap_apply, map_one,
        TensorProduct.smul_tmul', smul_eq_mul, mul_one]
    | add x y hx hy => rw [map_add, map_add, hx, hy, map_add]
  intro x hx
  have h0 : N''.mkQ x = 0 := by
    rw [← key x, LinearMap.mem_ker.mp hx, map_zero]
  simpa [Submodule.Quotient.mk_eq_zero] using h0

/-- **Naturality from inclusion**: if `f ⊗ id` maps the point `N` into the point `N'`, then
Mathlib's base change of `N` along `f` is `N'`. -/
theorem map_eq_of_forall {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]
    {k : ℕ} {A B : Type w} [CommRing A] [Algebra R A] [CommRing B] [Algebra R B]
    (f : A →ₐ[R] B) (N : Module.Grassmannian A (A ⊗[R] M) k)
    (N' : Module.Grassmannian B (B ⊗[R] M) k)
    (h : ∀ x ∈ N.toSubmodule, f.toLinearMap.rTensor M x ∈ N'.toSubmodule) :
    map f N = N' :=
  eq_of_le (map_toSubmodule_le f N N'.toSubmodule h)

end Module.Grassmannian
