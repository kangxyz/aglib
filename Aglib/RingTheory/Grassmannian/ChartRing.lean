module

public import Aglib.RingTheory.Grassmannian.Chart
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.Algebra.MvPolynomial.Basic

/-!
# The coordinate ring of a chart of the Grassmannian of a free module

Let `M = Fin n → R`. A linear section `φ : M → A^k` of the chart at `x : Fin k → M` is given by
its matrix `Φ a j = φ (e_j) a`, subject to `Φ X = 1`, where `X` is the `n × k` matrix whose
columns are the vectors `x b`. Hence the chart functor `chartFunctor R x` is corepresented by
the chart ring `ChartRing R x = R[Φ a j] ⧸ (entries of Φ X - 1)`.

For a coordinate tuple `x b = e_{i_b}` the relations say that the columns `i_1, …, i_k` of `Φ`
form the identity matrix, so `ChartRing R x` is the polynomial ring in the remaining
`k (n - k)` entries: this is the chart `U^I = Spec Z[X^I]` of Nitsure, *Construction of Hilbert
and Quot schemes* (arXiv:math/0504590v1), §1, "Construction of Grassmannian", p. 8, base-changed
to `R`, and the representability of the subfunctors `F_i` in Stacks, Tag 089T.

## Main definitions and results

- `Module.Grassmannian.chartIdeal`, `Module.Grassmannian.ChartRing`: the chart ring.
- `Module.Grassmannian.chartSectionsEquivAlgHom`: linear sections of the chart over `A` are
  `R`-algebra maps `ChartRing R x → A`; `algHomToChartSection_comp` gives naturality.
- `Module.Grassmannian.chartFunctorCorepresentableBy`: the chart functor is corepresented by
  `CommAlgCat.of R (ChartRing R x)`.
-/

@[expose] public section

noncomputable section

universe u w

open CategoryTheory MvPolynomial TensorProduct

namespace Module.Grassmannian

variable {R : Type u} [CommRing R] {k n : ℕ}

variable (R) in
/-- The `(a, b)` entry of `Φ X - 1`, where `Φ` is the generic `k × n` matrix and `X` is the
`n × k` matrix whose `b`-th column is `x b`. -/
def chartRelation (x : Fin k → Fin n → R) (a b : Fin k) : MvPolynomial (Fin k × Fin n) R :=
  ∑ j, x b j • X (a, j) - if a = b then 1 else 0

variable (R) in
/-- The ideal of the chart at `x`, generated by the entries of `Φ X - 1`. -/
def chartIdeal (x : Fin k → Fin n → R) : Ideal (MvPolynomial (Fin k × Fin n) R) :=
  Ideal.span (Set.range fun ab : Fin k × Fin k ↦ chartRelation R x ab.1 ab.2)

theorem chartRelation_mem_chartIdeal (x : Fin k → Fin n → R) (a b : Fin k) :
    chartRelation R x a b ∈ chartIdeal R x :=
  Ideal.subset_span ⟨(a, b), rfl⟩

variable (R) in
/-- The coordinate ring of the chart at `x` of the Grassmannian of `Fin n → R`. -/
abbrev ChartRing (x : Fin k → Fin n → R) : Type u :=
  MvPolynomial (Fin k × Fin n) R ⧸ chartIdeal R x

/-- The coordinate function `Φ a j` on the chart at `x`. -/
def chartCoordinate (x : Fin k → Fin n → R) (a : Fin k) (j : Fin n) : ChartRing R x :=
  Ideal.Quotient.mk _ (X (a, j))

theorem linearMap_apply_eq_sum_single {P : Type*} [AddCommGroup P] [Module R P]
    (φ : (Fin n → R) →ₗ[R] P) (v : Fin n → R) : φ v = ∑ j, v j • φ (Pi.single j 1) := by
  conv_lhs => rw [← Finset.univ_sum_single v]
  rw [map_sum]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  rw [← map_smul]
  congr 1
  ext j'
  by_cases h : j' = j
  · subst h
    simp
  · simp [h]

section Sections

variable {A : Type w} [CommRing A] [Algebra R A] {B : Type w} [CommRing B] [Algebra R B]

theorem aeval_chartSection_eq_zero {x : Fin k → Fin n → R}
    (φ : (Fin n → R) →ₗ[R] (Fin k → A)) (hφ : φ ∈ chartSections R A x) :
    ∀ p ∈ chartIdeal R x, aeval (fun aj : Fin k × Fin n ↦ φ (Pi.single aj.2 1) aj.1) p = 0 := by
  have hφ' : ∀ b, φ (x b) = Pi.single b 1 := hφ
  have hle : chartIdeal R x ≤
      RingHom.ker (aeval (R := R) fun aj : Fin k × Fin n ↦ φ (Pi.single aj.2 1) aj.1) := by
    rw [chartIdeal, Ideal.span_le]
    rintro _ ⟨⟨a, b⟩, rfl⟩
    have h := congrFun (hφ' b) a
    rw [linearMap_apply_eq_sum_single φ (x b)] at h
    simp only [Finset.sum_apply, Pi.smul_apply] at h
    by_cases hab : a = b
    · subst hab
      simp [chartRelation, h]
    · simp [chartRelation, h, hab]
  exact fun p hp ↦ hle hp

/-- The algebra map out of the chart ring attached to a linear section `φ`: it sends `Φ a j` to
`φ (e_j) a`. -/
def chartSectionToAlgHom {x : Fin k → Fin n → R} (φ : (Fin n → R) →ₗ[R] (Fin k → A))
    (hφ : φ ∈ chartSections R A x) : ChartRing R x →ₐ[R] A :=
  Ideal.Quotient.liftₐ (chartIdeal R x) (aeval fun aj ↦ φ (Pi.single aj.2 1) aj.1)
    (aeval_chartSection_eq_zero φ hφ)

@[simp]
theorem chartSectionToAlgHom_coordinate {x : Fin k → Fin n → R}
    (φ : (Fin n → R) →ₗ[R] (Fin k → A)) (hφ : φ ∈ chartSections R A x) (a : Fin k) (j : Fin n) :
    chartSectionToAlgHom φ hφ (chartCoordinate x a j) = φ (Pi.single j 1) a := by
  have h := AlgHom.congr_fun (Ideal.Quotient.liftₐ_comp (chartIdeal R x)
    (aeval fun aj : Fin k × Fin n ↦ φ (Pi.single aj.2 1) aj.1)
    (aeval_chartSection_eq_zero φ hφ)) (X (a, j))
  rw [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, aeval_X] at h
  exact h

variable (A) in
/-- The linear section attached to an algebra map `ψ` out of the chart ring: its matrix is
`ψ (Φ a j)`. -/
def algHomToChartSection (x : Fin k → Fin n → R) (ψ : ChartRing R x →ₐ[R] A) :
    (Fin n → R) →ₗ[R] (Fin k → A) :=
  LinearMap.pi fun a ↦
    ∑ j, (LinearMap.proj j : (Fin n → R) →ₗ[R] R).smulRight (ψ (chartCoordinate x a j))

@[simp]
theorem algHomToChartSection_apply (x : Fin k → Fin n → R) (ψ : ChartRing R x →ₐ[R] A)
    (v : Fin n → R) (a : Fin k) :
    algHomToChartSection A x ψ v a = ∑ j, v j • ψ (chartCoordinate x a j) := by
  simp [algHomToChartSection]

theorem algHomToChartSection_mem (x : Fin k → Fin n → R) (ψ : ChartRing R x →ₐ[R] A) :
    algHomToChartSection A x ψ ∈ chartSections R A x := by
  intro b
  ext a
  have h : (ψ.comp (Ideal.Quotient.mkₐ R (chartIdeal R x))) (chartRelation R x a b) = 0 := by
    rw [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk,
      Ideal.Quotient.eq_zero_iff_mem.mpr (chartRelation_mem_chartIdeal x a b), map_zero]
  rw [algHomToChartSection_apply]
  by_cases hab : a = b
  · subst hab
    simp only [chartRelation, ite_true, map_sub, map_sum, map_smul, map_one] at h
    simpa [chartCoordinate, sub_eq_zero] using h
  · simp only [chartRelation, hab, ite_false, map_sum, map_smul, sub_zero] at h
    simpa [chartCoordinate, hab] using h

theorem algHomToChartSection_chartSectionToAlgHom {x : Fin k → Fin n → R}
    (φ : (Fin n → R) →ₗ[R] (Fin k → A)) (hφ : φ ∈ chartSections R A x) :
    algHomToChartSection A x (chartSectionToAlgHom φ hφ) = φ := by
  refine LinearMap.ext fun v ↦ funext fun a ↦ ?_
  rw [algHomToChartSection_apply, linearMap_apply_eq_sum_single φ v]
  simp [Finset.sum_apply]

theorem chartSectionToAlgHom_algHomToChartSection (x : Fin k → Fin n → R)
    (ψ : ChartRing R x →ₐ[R] A) :
    chartSectionToAlgHom (algHomToChartSection A x ψ) (algHomToChartSection_mem x ψ) = ψ := by
  apply Ideal.Quotient.algHom_ext
  apply MvPolynomial.algHom_ext
  rintro ⟨a, j⟩
  have h := chartSectionToAlgHom_coordinate (algHomToChartSection A x ψ)
    (algHomToChartSection_mem x ψ) a j
  simp only [chartCoordinate] at h
  simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, h, algHomToChartSection_apply]
  rw [Finset.sum_eq_single j (fun j' _ hj' ↦ by simp [hj'])
    (fun h ↦ (h (Finset.mem_univ j)).elim)]
  simp [chartCoordinate]

variable (A) in
/-- The linear sections of the chart at `x` over `A` are the `R`-algebra maps out of the chart
ring. -/
def chartSectionsEquivAlgHom (x : Fin k → Fin n → R) :
    chartSections R A x ≃ (ChartRing R x →ₐ[R] A) where
  toFun φ := chartSectionToAlgHom φ.1 φ.2
  invFun ψ := ⟨algHomToChartSection A x ψ, algHomToChartSection_mem x ψ⟩
  left_inv φ := Subtype.ext (algHomToChartSection_chartSectionToAlgHom φ.1 φ.2)
  right_inv ψ := chartSectionToAlgHom_algHomToChartSection x ψ

theorem algHomToChartSection_comp (x : Fin k → Fin n → R) (ψ : ChartRing R x →ₐ[R] A)
    (f : A →ₐ[R] B) :
    algHomToChartSection B x (f.comp ψ) =
      f.toLinearMap.compLeft (Fin k) ∘ₗ algHomToChartSection A x ψ := by
  refine LinearMap.ext fun v ↦ funext fun a ↦ ?_
  simp [map_sum]

theorem map_ofChartSection_algHomToChartSection [BaseChangeMkQFormula.{u, u, w} R (Fin n → R)]
    (x : Fin k → Fin n → R)
    (ψ : ChartRing R x →ₐ[R] A) (f : A →ₐ[R] B) :
    map f (ofChartSection (algHomToChartSection A x ψ) (algHomToChartSection_mem x ψ)) =
      ofChartSection (algHomToChartSection B x (f.comp ψ)) (algHomToChartSection_mem x _) := by
  rw [map_ofChartSection]
  congr 1
  exact (algHomToChartSection_comp x ψ f).symm

end Sections

variable (R) in
/-- The chart functor at `x` is corepresented by the chart ring: an `R`-algebra map
`ChartRing R x → A` is the same as a point of `G(k, A ⊗[R] (Fin n → R); A)` in the chart at
`1 ⊗ x`. -/
def chartFunctorCorepresentableBy [BaseChangeMkQFormula.{u, u, u} R (Fin n → R)]
    (x : Fin k → Fin n → R) :
    (chartFunctor.{u, u, u} R x).toFunctor.CorepresentableBy
      (CommAlgCat.of R (ChartRing R x)) where
  homEquiv {A} :=
    { toFun f := (chartEquiv A x).symm ((chartSectionsEquivAlgHom A x).symm f.hom)
      invFun N := CommAlgCat.ofHom (chartSectionsEquivAlgHom A x (chartEquiv A x N))
      left_inv f := by simp
      right_inv N := by
        dsimp only
        rw [CommAlgCat.hom_ofHom, Equiv.symm_apply_apply]
        exact (chartEquiv _ x).symm_apply_apply N }
  homEquiv_comp {Y Y'} g f :=
    Subtype.ext (map_ofChartSection_algHomToChartSection x f.hom g.hom).symm

theorem chartFunctor_isCorepresentable [BaseChangeMkQFormula.{u, u, u} R (Fin n → R)]
    (x : Fin k → Fin n → R) :
    (chartFunctor.{u, u, u} R x).toFunctor.IsCorepresentable :=
  (chartFunctorCorepresentableBy R x).isCorepresentable

end Module.Grassmannian
