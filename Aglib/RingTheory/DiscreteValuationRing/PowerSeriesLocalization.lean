module

public import Aglib.RingTheory.DiscreteValuationRing.SameUniformizer
public import Mathlib.RingTheory.DiscreteValuationRing.TFAE
public import Mathlib.RingTheory.LocalRing.ResidueField.Ideal
public import Mathlib.RingTheory.Localization.Submodule
public import Mathlib.RingTheory.MvPowerSeries.Equiv
public import Mathlib.RingTheory.MvPowerSeries.Ideal
public import Mathlib.RingTheory.MvPowerSeries.NoZeroDivisors

/-!
# Power series localized at a coefficient uniformizer

For a DVR, the ideal generated by a constant uniformizer in the power-series ring
is prime. Its actual localization is a DVR, and its residue field is the fraction
field of the power-series ring over the original residue field. The quotient and
residue comparisons retain the literal coefficient-reduction maps.
-/

@[expose] public noncomputable section

open IsLocalRing

universe u v

namespace PowerSeriesLocalization

variable (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
  (ι : Type v) (p : R)

local instance : IsDomain (MvPowerSeries ι R) :=
  NoZeroDivisors.to_isDomain _

local instance : IsDomain (MvPowerSeries ι (ResidueField R)) :=
  NoZeroDivisors.to_isDomain _

/-- The principal coefficient ideal in the original power-series ring. -/
def coefficientIdeal : Ideal (MvPowerSeries ι R) := Ideal.span {MvPowerSeries.C p}

/-- Coefficient reduction has the expected principal kernel. -/
theorem ker_map_residue (hp : Irreducible p) :
    RingHom.ker (MvPowerSeries.map (residue R) :
      MvPowerSeries ι R →+* MvPowerSeries ι (ResidueField R)) =
        coefficientIdeal R ι p := by
  rw [MvPowerSeries.ker_map_of_fg _ (by rw [ker_residue]; exact Ideal.fg_of_isNoetherianRing _),
    ker_residue, hp.maximalIdeal_eq, Ideal.map_span, Set.image_singleton]
  rfl

/-- Reduction of coefficients is surjective, with coefficients lifted independently. -/
theorem map_residue_surjective : Function.Surjective
    (MvPowerSeries.map (residue R) : MvPowerSeries ι R →+* MvPowerSeries ι (ResidueField R)) := by
  intro f
  let g : MvPowerSeries ι R := fun d => Classical.choose (residue_surjective (f.coeff d))
  refine ⟨g, ?_⟩
  ext d
  exact Classical.choose_spec (residue_surjective (f.coeff d))

/-- The coefficient ideal is prime, without finiteness of the variable set. -/
theorem coefficientIdeal_isPrime (hp : Irreducible p) :
    (coefficientIdeal R ι p).IsPrime := by
  rw [← ker_map_residue R ι p hp]
  exact RingHom.ker_isPrime _

variable [Fact (Irreducible p)]

instance : (coefficientIdeal R ι p).IsPrime :=
  coefficientIdeal_isPrime R ι p (Fact.out : Irreducible p)

/-- The native localization at the actual coefficient prime. -/
abbrev Ring := Localization.AtPrime (coefficientIdeal R ι p)

/-- Its maximal ideal is generated by the original coefficient uniformizer. -/
theorem maximalIdeal_eq :
    maximalIdeal (Ring R ι p) = Ideal.span {algebraMap R (Ring R ι p) p} := by
  rw [← Localization.AtPrime.map_eq_maximalIdeal]
  change Ideal.map (algebraMap (MvPowerSeries ι R) (Ring R ι p))
    (Ideal.span {MvPowerSeries.C p}) = _
  rw [Ideal.map_span, Set.image_singleton]
  exact congrArg (fun x : Ring R ι p => Ideal.span {x})
    (IsScalarTower.algebraMap_apply R (MvPowerSeries ι R) (Ring R ι p) p).symm

/-- The original uniformizer remains nonzero in the localization. -/
theorem uniformizer_ne_zero : algebraMap R (Ring R ι p) p ≠ 0 := by
  rw [IsScalarTower.algebraMap_apply R (MvPowerSeries ι R) (Ring R ι p)]
  intro h
  apply (Fact.out : Irreducible p).ne_zero
  apply MvPowerSeries.C_injective
  apply FaithfulSMul.algebraMap_injective (MvPowerSeries ι R) (Ring R ι p)
  simpa [MvPowerSeries.algebraMap_apply] using h

/-- Principality and nonvanishing imply preservation of the uniformizer. -/
theorem uniformizer_irreducible : Irreducible (algebraMap R (Ring R ι p) p) :=
  IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal _
    (uniformizer_ne_zero R ι p) (maximalIdeal_eq R ι p)

/-- The actual coefficient map is local. -/
theorem algebraMap_isLocalHom : IsLocalHom (algebraMap R (Ring R ι p)) := by
  have hm : (maximalIdeal R).map (algebraMap R (Ring R ι p)) =
      maximalIdeal (Ring R ι p) := by
    rw [(Fact.out : Irreducible p).maximalIdeal_eq, maximalIdeal_eq,
      Ideal.map_span, Set.image_singleton]
  refine ⟨fun r hr => ?_⟩
  by_contra h
  have hmem := Ideal.mem_map_of_mem (algebraMap R (Ring R ι p))
    (show r ∈ maximalIdeal R from h)
  rw [hm] at hmem
  exact hmem hr

/-- Finite-variable power-series localization is a DVR with the same uniformizer. -/
theorem isDiscreteValuationRing [Finite ι] : IsDiscreteValuationRing (Ring R ι p) := by
  have hn : maximalIdeal (Ring R ι p) ≠ ⊥ := by
    rw [maximalIdeal_eq, ne_eq, Ideal.span_singleton_eq_bot]
    exact uniformizer_ne_zero R ι p
  have hf : ¬IsField (Ring R ι p) := isField_iff_maximalIdeal_eq.not.mpr hn
  apply ((IsDiscreteValuationRing.TFAE (Ring R ι p) hf).out 5 1).mp
  rw [maximalIdeal_eq]
  infer_instance

/-- The actual quotient is identified by reducing each original coefficient. -/
def quotientResidueEquiv :
    (MvPowerSeries ι R ⧸ coefficientIdeal R ι p) ≃+* MvPowerSeries ι (ResidueField R) :=
  (Ideal.quotEquivOfEq (ker_map_residue R ι p (Fact.out : Irreducible p)).symm).trans
    (RingHom.quotientKerEquivOfSurjective (map_residue_surjective R ι))

@[simp] theorem quotientResidueEquiv_mk (f : MvPowerSeries ι R) :
    quotientResidueEquiv R ι p (Ideal.Quotient.mk _ f) = MvPowerSeries.map (residue R) f := by
  simp [quotientResidueEquiv]

/-- The native residue field is the fraction field of the reduced power-series ring. -/
def residueFieldRingEquiv :
    ResidueField (Ring R ι p) ≃+* FractionRing (MvPowerSeries ι (ResidueField R)) :=
  IsFractionRing.ringEquivOfRingEquiv (quotientResidueEquiv R ι p)

@[simp] theorem residueFieldRingEquiv_series (f : MvPowerSeries ι R) :
    residueFieldRingEquiv R ι p
        (residue (Ring R ι p) (algebraMap (MvPowerSeries ι R) (Ring R ι p) f)) =
      algebraMap (MvPowerSeries ι (ResidueField R))
        (FractionRing (MvPowerSeries ι (ResidueField R))) (MvPowerSeries.map (residue R) f) := by
  change residueFieldRingEquiv R ι p
    (algebraMap (MvPowerSeries ι R ⧸ coefficientIdeal R ι p)
      (ResidueField (Ring R ι p)) (Ideal.Quotient.mk _ f)) = _
  rw [residueFieldRingEquiv, IsFractionRing.ringEquivOfRingEquiv_algebraMap,
    quotientResidueEquiv_mk]

attribute [local instance] algebraMap_isLocalHom

/-- The residue comparison preserves the canonical original residue-field scalars. -/
def residueFieldAlgEquiv :
    ResidueField (Ring R ι p) ≃ₐ[ResidueField R]
      FractionRing (MvPowerSeries ι (ResidueField R)) where
  __ := residueFieldRingEquiv R ι p
  commutes' r := by
    change residueFieldRingEquiv R ι p
      (algebraMap (ResidueField R) (ResidueField (Ring R ι p)) r) = _
    obtain ⟨r, rfl⟩ := residue_surjective r
    rw [ResidueField.algebraMap_residue]
    rw [IsScalarTower.algebraMap_apply R (MvPowerSeries ι R) (Ring R ι p)]
    rw [residueFieldRingEquiv_series]
    simp only [MvPowerSeries.algebraMap_apply, MvPowerSeries.map_C]
    exact (IsScalarTower.algebraMap_apply (ResidueField R)
      (MvPowerSeries ι (ResidueField R)) _ (residue R r)).symm

end PowerSeriesLocalization
