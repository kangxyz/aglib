module

public import Aglib.RingTheory.DiscreteValuationRing.SeparableResidueSquare
public import Aglib.RingTheory.Etale.DiagonalCentre
public import Mathlib.LinearAlgebra.TensorProduct.RightExactness

/-! # The actual separable tensor residue map and selected centre

No domain hypothesis is imposed on the source algebra or its étale tensor product.
The right residue kernel is absorbed by the left residue kernel using the original
uniformizer; the selected diagonal localization then has precisely the extended
original centre as its maximal ideal.
-/

@[expose] public noncomputable section

open IsLocalRing
open scoped TensorProduct

namespace SeparableResidueExtension

variable (R E : Type*) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
  [Field E] [Algebra (ResidueField R) E] [Module.Finite (ResidueField R) E]
  [Algebra.IsSeparable (ResidueField R) E]

/-- The base DVR acts on the specified residue extension through its residue map. -/
local instance tensorCentreResidueAlgebra : Algebra R E :=
  ((algebraMap (ResidueField R) E).comp (residue R)).toAlgebra

local instance : IsScalarTower R (ResidueField R) E :=
  IsScalarTower.of_algebraMap_eq' rfl

/-- The quotient on coefficients gives the actual change-of-base tensor equivalence. -/
def residueTensorEquiv : E ⊗[R] E ≃ₐ[E] E ⊗[ResidueField R] E := by
  letI : TensorProduct.CompatibleSMul R (ResidueField R) E E :=
    TensorProduct.CompatibleSMul.of_algebraMap_surjective E E
      (residue_surjective (R := R))
  exact Algebra.TensorProduct.equivOfCompatibleSMul (ResidueField R) R E E E

omit [Module.Finite (ResidueField R) E] [Algebra.IsSeparable (ResidueField R) E] in
@[simp] theorem residueTensorEquiv_tmul (x y : E) :
    residueTensorEquiv R E (x ⊗ₜ[R] y) = x ⊗ₜ[ResidueField R] y := rfl

/-- The constructed local residue point is surjective. -/
theorem localPoint_surjective : Function.Surjective (localPoint R E) := by
  intro x
  obtain ⟨y, hy⟩ := (residueEquiv R E).surjective x
  obtain ⟨a, ha⟩ := residue_surjective y
  exact ⟨a, by rw [← residueEquiv_residue, ha, hy]⟩

/-- Its kernel is the actual maximal ideal, not an assumed model. -/
theorem ker_localPoint : RingHom.ker (localPoint R E).toRingHom =
    maximalIdeal (Ring R E) :=
  Localization.ResiduePoint.ker_point (point R E).toRingHom

variable {B : Type*} [CommRing B] [Algebra R B] (f : B →ₐ[R] E)

/-- The actual tensor of both residue maps, with the residue base made explicit. -/
def tensorResidue : B ⊗[R] Ring R E →+* E ⊗[ResidueField R] E :=
  (residueTensorEquiv R E).toRingHom.comp
    (Algebra.TensorProduct.map f (localPoint R E)).toRingHom

@[simp] theorem tensorResidue_tmul (b : B) (a : Ring R E) :
    tensorResidue R E f (b ⊗ₜ[R] a) = f b ⊗ₜ[ResidueField R] localPoint R E a := rfl

/-- Both actual residue quotients are surjective. -/
theorem tensorResidue_surjective (hf : Function.Surjective f) :
    Function.Surjective (tensorResidue R E f) :=
  (residueTensorEquiv R E).surjective.comp
    (Algebra.TensorProduct.map_surjective f (localPoint R E) hf (localPoint_surjective R E))

/-- The right uniformizer kernel is already generated by the left residue kernel. -/
theorem right_residue_kernel_le :
    (RingHom.ker (localPoint R E).toRingHom).map
      (Algebra.TensorProduct.includeRight : Ring R E →ₐ[R] B ⊗[R] Ring R E) ≤
    (RingHom.ker f.toRingHom).map
      (Algebra.TensorProduct.includeLeft : B →ₐ[R] B ⊗[R] Ring R E) := by
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible R
  rw [ker_localPoint, Algebra.FormallyUnramified.maximalIdeal_eq_span_uniformizer
    R (Ring R E) hπ, Ideal.map_span, Set.image_singleton]
  apply Ideal.span_le.mpr
  rintro x (rfl : x = _)
  have hπf : algebraMap R B π ∈ RingHom.ker f.toRingHom := by
    change f (algebraMap R B π) = 0
    rw [f.commutes]
    change algebraMap (ResidueField R) E (residue R π) = 0
    have hz : residue R π = 0 := (residue_eq_zero_iff π).mpr (by
      rw [hπ.maximalIdeal_eq]
      exact Ideal.subset_span (Set.mem_singleton π))
    rw [hz, map_zero]
  have hbal :
      (Algebra.TensorProduct.includeRight : Ring R E →ₐ[R] B ⊗[R] Ring R E)
        (algebraMap R (Ring R E) π) =
      (Algebra.TensorProduct.includeLeft : B →ₐ[R] B ⊗[R] Ring R E)
        (algebraMap R B π) := by
    rw [AlgHom.commutes, AlgHom.commutes]
  rw [hbal]
  exact Ideal.mem_map_of_mem _ hπf

/-- The actual tensor residue kernel is precisely the extended original centre. -/
theorem ker_tensorResidue (hf : Function.Surjective f) :
    RingHom.ker (tensorResidue R E f) =
      (RingHom.ker f.toRingHom).map
        (Algebra.TensorProduct.includeLeft : B →ₐ[R] B ⊗[R] Ring R E) := by
  have hk : RingHom.ker (tensorResidue R E f) =
      RingHom.ker (Algebra.TensorProduct.map f (localPoint R E)).toRingHom := by
    ext x
    change residueTensorEquiv R E (Algebra.TensorProduct.map f (localPoint R E) x) = 0 ↔
      Algebra.TensorProduct.map f (localPoint R E) x = 0
    constructor
    · intro hx
      apply (residueTensorEquiv R E).injective
      simpa only [map_zero] using hx
    · intro hx
      rw [hx, map_zero]
  rw [hk]
  exact (Algebra.TensorProduct.map_ker f (localPoint R E) hf
    (localPoint_surjective R E)).trans
      (sup_eq_left.mpr (right_residue_kernel_le R E f))

/-- The actual prime localization selected by the diagonal residue point. -/
abbrev CentreRing :=
  SeparableTensorDiagonal.SourceRing (ResidueField R) E (tensorResidue R E f)

/-- The original centre extends to the entire maximal ideal at the selected component. -/
theorem map_residue_kernel_eq_maximalIdeal (hf : Function.Surjective f) :
    (RingHom.ker f.toRingHom).map
      ((algebraMap (B ⊗[R] Ring R E) (CentreRing R E f)).comp
        (Algebra.TensorProduct.includeLeft : B →ₐ[R] B ⊗[R] Ring R E).toRingHom) =
      maximalIdeal (CentreRing R E f) := by
  rw [← Ideal.map_map]
  change ((RingHom.ker f.toRingHom).map
    (Algebra.TensorProduct.includeLeft : B →ₐ[R] B ⊗[R] Ring R E)).map
      (algebraMap (B ⊗[R] Ring R E) (CentreRing R E f)) = _
  rw [← ker_tensorResidue R E f hf]
  exact SeparableTensorDiagonal.map_ker_eq_maximalIdeal (ResidueField R) E
    (tensorResidue R E f) (tensorResidue_surjective R E f hf)

end SeparableResidueExtension
