module

public import Aglib.RingTheory.DiscreteValuationRing.SameUniformizer
public import Mathlib.RingTheory.DiscreteValuationRing.TFAE
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.RingTheory.Localization.Submodule
public import Mathlib.RingTheory.Polynomial.Basic

/-!
# Parameter localization at the coefficient uniformizer

The polynomial ring localized at `(C p)` is a DVR with the same uniformizer.
Finiteness of the variable type is needed only for Noetherianity.
-/

@[expose] public section

noncomputable section

open IsLocalRing

universe u v

namespace ParameterLocalization

variable (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
  (ι : Type v) (p : R)

/-- The actual principal prime at which the parameter polynomial ring is localized. -/
def parameterIdeal : Ideal (MvPolynomial ι R) := Ideal.span {MvPolynomial.C p}

/-- Primality follows directly from native primality of constant polynomials. -/
theorem parameterIdeal_isPrime (hp : Irreducible p) : (parameterIdeal R ι p).IsPrime := by
  have hCp : Prime (MvPolynomial.C p : MvPolynomial ι R) :=
    (MvPolynomial.prime_C_iff ι).mpr hp.prime
  exact (Ideal.span_singleton_prime hCp.ne_zero).mpr hCp

variable [Fact (Irreducible p)]

instance : (parameterIdeal R ι p).IsPrime :=
  parameterIdeal_isPrime R ι p (Fact.out : Irreducible p)

/-- The native localization, not an abstract isomorphic DVR. -/
abbrev Ring := Localization.AtPrime (parameterIdeal R ι p)

/-- The maximal ideal is generated by the image of the original uniformizer. -/
theorem maximalIdeal_eq :
    maximalIdeal (Ring R ι p) = Ideal.span {algebraMap R (Ring R ι p) p} := by
  rw [← Localization.AtPrime.map_eq_maximalIdeal]
  change Ideal.map (algebraMap (MvPolynomial ι R) (Ring R ι p))
    (Ideal.span {MvPolynomial.C p}) = _
  rw [Ideal.map_span, Set.image_singleton]
  exact congrArg (fun x : Ring R ι p => Ideal.span {x})
    (IsScalarTower.algebraMap_apply R (MvPolynomial ι R) (Ring R ι p) p).symm

/-- The original uniformizer remains nonzero in the native localization. -/
theorem uniformizer_ne_zero : algebraMap R (Ring R ι p) p ≠ 0 := by
  rw [IsScalarTower.algebraMap_apply R (MvPolynomial ι R) (Ring R ι p)]
  intro h
  apply (Fact.out : Irreducible p).ne_zero
  apply MvPolynomial.C_injective
  apply FaithfulSMul.algebraMap_injective (MvPolynomial ι R) (Ring R ι p)
  simpa using h

/-- Principality and nonvanishing already imply irreducibility, before invoking DVR structure. -/
theorem uniformizer_irreducible : Irreducible (algebraMap R (Ring R ι p) p) :=
  IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal _
    (uniformizer_ne_zero R ι p) (maximalIdeal_eq R ι p)

/-- The coefficient map is local even without finiteness of the parameter set. -/
theorem algebraMap_isLocalHom : IsLocalHom (algebraMap R (Ring R ι p)) := by
  have hm : (maximalIdeal R).map (algebraMap R (Ring R ι p)) =
      maximalIdeal (Ring R ι p) := by
    rw [(Fact.out : Irreducible p).maximalIdeal_eq, maximalIdeal_eq,
      Ideal.map_span, Set.image_singleton]
  refine ⟨fun r hr => ?_⟩
  by_contra h
  have hmem := Ideal.mem_map_of_mem (algebraMap R (Ring R ι p))
    (show r ∈ maximalIdeal R from h)
  rw [hm] at hmem
  exact hmem hr

variable [Finite ι]

/-- The native parameter localization is a DVR; no regularity or height assumption is used. -/
theorem isDiscreteValuationRing : IsDiscreteValuationRing (Ring R ι p) := by
  have hn : maximalIdeal (Ring R ι p) ≠ ⊥ := by
    rw [maximalIdeal_eq, ne_eq, Ideal.span_singleton_eq_bot]
    exact uniformizer_ne_zero R ι p
  have hf : ¬IsField (Ring R ι p) := isField_iff_maximalIdeal_eq.not.mpr hn
  apply ((IsDiscreteValuationRing.TFAE (Ring R ι p) hf).out 5 1).mp
  rw [maximalIdeal_eq]
  infer_instance

/-- The original coefficient map is injective. -/
theorem algebraMap_injective : Function.Injective (algebraMap R (Ring R ι p)) := by
  let : IsDiscreteValuationRing (Ring R ι p) := isDiscreteValuationRing R ι p
  exact IsDiscreteValuationRing.injective_of_map_irreducible _
    (Fact.out : Irreducible p) (uniformizer_irreducible R ι p)

end ParameterLocalization
