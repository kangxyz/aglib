module

public import Mathlib.Algebra.Module.GradedModule
public import Mathlib.RingTheory.Finiteness.Basic

/-!
# Homogeneous submodules and bounded homogeneous generation

The construction uses the native internal decomposition and the original scalar
multiplication. Finite generation is converted into a bound on homogeneous
generators by taking all homogeneous components of a finite generating set.
-/

@[expose] public noncomputable section
set_option autoImplicit false
open DirectSum
universe u v w

namespace GradedModule
variable {A : Type u} {B : Type v} {M : Type w}
variable [CommRing A] [CommRing B] [Algebra A B]
variable [AddCommGroup M] [Module A M] [Module B M]
variable (G : ℕ → Submodule A B) (E : ℕ → Submodule A M)
variable [GradedAlgebra G] [DirectSum.Decomposition E] [SetLike.GradedSMul G E]

/-- Homogeneous multiplication, using the original module action. -/
abbrev homogeneousSMul {r n : ℕ} (a : G r) (x : E n) : E (r + n) :=
  ⟨(a : B) • (x : M), SetLike.GradedSMul.smul_mem a.property x.property⟩

/-- The base-linear submodule specified component by component. -/
def componentSubmodule (P : ∀ n, Submodule A (E n)) : Submodule A M where
  carrier := {x | ∀ n, decompose E x n ∈ P n}
  zero_mem' := by intro n; simp
  add_mem' := by
    intro x y hx hy n
    simpa using (P n).add_mem (hx n) (hy n)
  smul_mem' := by
    intro a x hx n
    simpa only [DirectSum.decompose_smul, DirectSum.smul_apply] using
      (P n).smul_mem a (hx n)

lemma homogeneous_mem_componentSubmodule (P : ∀ n, Submodule A (E n))
    {j : ℕ} (x : E j) (hx : x ∈ P j) : (x : M) ∈ componentSubmodule E P := by
  intro n
  by_cases h : j = n
  · subst n
    simpa only [decompose_coe, DirectSum.of_eq_same] using hx
  · simp only [decompose_coe, DirectSum.of_eq_of_ne _ _ _ (Ne.symm h)]
    exact (P n).zero_mem

/-- A family stable under homogeneous multiplication gives an actual submodule
of the original module over the original graded ring. -/
def gradedSubmodule (P : ∀ n, Submodule A (E n))
    (hP : ∀ r n (a : G r) (x : E n), x ∈ P n →
      homogeneousSMul G E a x ∈ P (r + n)) : Submodule B M where
  carrier := componentSubmodule E P
  zero_mem' := (componentSubmodule E P).zero_mem
  add_mem' := (componentSubmodule E P).add_mem
  smul_mem' := by
    classical
    intro a x hx
    rw [← DirectSum.sum_support_decompose G a, Finset.sum_smul]
    apply (componentSubmodule E P).sum_mem
    intro r hr
    rw [← DirectSum.sum_support_decompose E x, Finset.smul_sum]
    apply (componentSubmodule E P).sum_mem
    intro n hn
    exact homogeneous_mem_componentSubmodule E P
      (homogeneousSMul G E (decompose G a r) (decompose E x n))
      (hP r n _ _ (hx n))

lemma mem_gradedSubmodule (P : ∀ n, Submodule A (E n))
    (hP : ∀ r n (a : G r) (x : E n), x ∈ P n →
      homogeneousSMul G E a x ∈ P (r + n)) (x : M) :
    x ∈ gradedSubmodule G E P hP ↔ ∀ n, decompose E x n ∈ P n := Iff.rfl

omit [Algebra A B] in
/-- Taking the components of finitely many generators gives a finite homogeneous
generating set, all of whose elements remain in the original submodule. -/
theorem exists_finset_span_eq_and_homogeneous (N : Submodule B M) (hN : N.FG)
    (homogeneous : ∀ x ∈ N, ∀ n, (decompose E x n : M) ∈ N) :
    ∃ s : Finset M, Submodule.span B (s : Set M) = N ∧
      ∀ x ∈ s, ∃ n : ℕ, x ∈ E n := by
  classical
  obtain ⟨s, hs⟩ := hN
  let J := Σ x : s, (decompose E (x : M)).support
  let y : J → M := fun j => decompose E (j.1 : M) j.2
  refine ⟨Finset.univ.image y, le_antisymm ?_ ?_, ?_⟩
  · apply Submodule.span_le.mpr
    intro x hx
    obtain ⟨j, _, rfl⟩ := Finset.mem_image.mp hx
    apply homogeneous
    rw [← hs]
    exact Submodule.subset_span j.1.property
  · apply le_trans (le_of_eq hs.symm)
    apply Submodule.span_le.mpr
    intro x hx
    rw [← DirectSum.sum_support_decompose E x]
    apply Submodule.sum_mem
    intro n hn
    apply Submodule.subset_span
    exact Finset.mem_image.mpr ⟨⟨⟨x, hx⟩, ⟨n, hn⟩⟩, Finset.mem_univ _, rfl⟩
  · intro x hx
    obtain ⟨j, _, rfl⟩ := Finset.mem_image.mp hx
    exact ⟨j.2, (decompose E (j.1 : M) j.2).property⟩

omit [Algebra A B] in
/-- A finitely generated homogeneous submodule is generated by homogeneous
vectors in bounded degrees. No finite generation is assumed for the components. -/
theorem exists_bound_span_eq (N : Submodule B M) (hN : N.FG)
    (homogeneous : ∀ x ∈ N, ∀ n, (decompose E x n : M) ∈ N) :
    ∃ c : ℕ, Submodule.span B {x : M | ∃ n ≤ c, x ∈ E n ∧ x ∈ N} = N := by
  classical
  obtain ⟨s, hs⟩ := hN
  let c := s.sup fun x => (decompose E x).support.sup id
  refine ⟨c, le_antisymm ?_ ?_⟩
  · apply Submodule.span_le.mpr
    rintro x ⟨n, hn, hx, hxN⟩
    exact hxN
  · apply le_trans (le_of_eq hs.symm)
    apply Submodule.span_le.mpr
    intro x hx
    have hxN : x ∈ N := by rw [← hs]; exact Submodule.subset_span hx
    rw [← DirectSum.sum_support_decompose E x]
    apply Submodule.sum_mem
    intro n hn
    apply Submodule.subset_span
    refine ⟨n, ?_, (decompose E x n).property, homogeneous x hxN n⟩
    exact (Finset.le_sup (f := id) hn).trans
      (Finset.le_sup (f := fun y => (decompose E y).support.sup id) hx)

end GradedModule
