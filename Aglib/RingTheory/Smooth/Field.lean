module

public import Mathlib.Algebra.MvPolynomial.PDeriv
public import Mathlib.Algebra.MvPolynomial.Variables
public import Mathlib.RingTheory.Smooth.Field

/-!
# Formal smoothness of arbitrary fields over a perfect field

The canonical cotangent presentation detects each kernel class using a
polynomial with finitely many variables. The field generated by those
variables is formally smooth by the finite-type theorem. Its relation
square maps to the relation square of the original field, proving the
unrestricted vanishing of the first cotangent homology.
-/

@[expose] public noncomputable section

open MvPolynomial
open scoped TensorProduct

namespace Algebra.FormallySmooth

variable {F K : Type*} [Field F] [Field K] [Algebra F K]

private theorem relation_mem_square [FormallySmooth F K]
    (f : MvPolynomial K F) (hf : aeval (R := F) _root_.id f = 0)
    (hd : ∀ i : K, aeval (R := F) _root_.id (pderiv i f) = 0) :
    f ∈ (RingHom.ker (aeval (R := F) (_root_.id : K → K))) ^ 2 := by
  let P := Algebra.Generators.self F K
  let x : P.toExtension.ker := ⟨f, hf⟩
  have hx : P.toExtension.cotangentComplex (Algebra.Extension.Cotangent.mk x) = 0 := by
    apply P.cotangentSpaceBasis.repr.injective
    ext i
    rw [map_zero, Finsupp.zero_apply, Algebra.Extension.cotangentComplex_mk,
      Algebra.Generators.cotangentSpaceBasis_repr_one_tmul]
    exact hd i
  have hinj : Function.Injective P.toExtension.cotangentComplex :=
    (Algebra.Extension.subsingleton_h1Cotangent P.toExtension).mp
      (inferInstance : Subsingleton (Algebra.H1Cotangent F K))
  have hzero : Algebra.Extension.Cotangent.mk x = 0 :=
    hinj (hx.trans (map_zero _).symm)
  exact (Algebra.Extension.Cotangent.mk_eq_zero_iff x).mp hzero

private theorem aeval_rename_subtype (L : IntermediateField F K) (f : MvPolynomial L F) :
    aeval (R := F) _root_.id (rename ((↑) : L → K) f) =
      (aeval (R := F) _root_.id f : L) := by
  rw [aeval_rename]
  exact (MvPolynomial.comp_aeval_apply (_root_.id : L → L) L.val f).symm

/-- Formal smoothness of all finitely generated intermediate fields implies
formal smoothness of the original field. The proof descends each canonical
cotangent relation through its actual finite variable support. -/
theorem of_formallySmooth_finitelyGenerated_subfields
    (hfinite : ∀ L : IntermediateField F K, Algebra.EssFiniteType F L → FormallySmooth F L) :
    FormallySmooth F K := by
  classical
  refine ⟨inferInstance, ?_⟩
  let P := Algebra.Generators.self F K
  change Subsingleton P.toExtension.H1Cotangent
  rw [Algebra.Extension.subsingleton_h1Cotangent, ← LinearMap.ker_eq_bot,
    LinearMap.ker_eq_bot']
  intro x hx
  obtain ⟨⟨f, hf⟩, rfl⟩ := Algebra.Extension.Cotangent.mk_surjective x
  apply (Algebra.Extension.Cotangent.mk_eq_zero_iff _).mpr
  have hfzero : aeval (R := F) _root_.id f = 0 := hf
  have hderiv : ∀ i : K, aeval (R := F) _root_.id (pderiv i f) = 0 := by
    intro i
    have h := congrArg (fun y ↦ P.cotangentSpaceBasis.repr y i) hx
    have hself : P.val = (_root_.id : K → K) := rfl
    simpa only [Algebra.Extension.cotangentComplex_mk,
      Algebra.Generators.cotangentSpaceBasis_repr_one_tmul, hself,
      map_zero, Finsupp.zero_apply]
      using h
  let L : IntermediateField F K := IntermediateField.adjoin F (f.vars : Set K)
  have hfg : Algebra.EssFiniteType F L :=
    IntermediateField.essFiniteType_iff.mpr
      (IntermediateField.fg_adjoin_of_finite f.vars.finite_toSet)
  let : FormallySmooth F L := hfinite L hfg
  obtain ⟨g, hg⟩ := exists_rename_eq_of_vars_subset_range f ((↑) : L → K)
    Subtype.val_injective (by
      intro a ha
      exact ⟨⟨a, IntermediateField.subset_adjoin F (f.vars : Set K) ha⟩, rfl⟩)
  have hgzero : aeval (R := F) _root_.id g = 0 := by
    apply L.val.injective
    change ((aeval (R := F) (_root_.id : L → L) g : L) : K) = 0
    rw [← aeval_rename_subtype L, hg]
    exact hfzero
  have hgd : ∀ i : L, aeval (R := F) _root_.id (pderiv i g) = 0 := by
    intro i
    apply L.val.injective
    change ((aeval (R := F) (_root_.id : L → L) (pderiv i g) : L) : K) = 0
    rw [← aeval_rename_subtype L, ← pderiv_rename Subtype.val_injective, hg]
    exact hderiv i
  have hgsq := relation_mem_square g hgzero hgd
  let e : MvPolynomial L F →ₐ[F] MvPolynomial K F := rename ((↑) : L → K)
  have hker : (RingHom.ker (aeval (R := F) (_root_.id : L → L))).map e.toRingHom ≤
      RingHom.ker (aeval (R := F) (_root_.id : K → K)) := by
    apply Ideal.map_le_iff_le_comap.mpr
    intro a ha
    change aeval (R := F) _root_.id (rename ((↑) : L → K) a) = 0
    rw [aeval_rename_subtype L]
    change aeval (R := F) _root_.id a = 0 at ha
    rw [ha]
    rfl
  have hmap := Ideal.mem_map_of_mem e.toRingHom hgsq
  rw [Ideal.map_pow] at hmap
  have hresult := (Ideal.pow_right_mono hker 2) hmap
  change e g ∈ P.toExtension.ker ^ 2 at hresult
  change f ∈ P.toExtension.ker ^ 2
  exact hg ▸ hresult

/-- Every extension field of a perfect field is formally smooth, without
finite generation of the extension or a finite p-basis. -/
theorem field_of_perfectField [PerfectField F] : FormallySmooth F K := by
  apply of_formallySmooth_finitelyGenerated_subfields
  intro L hL
  let : Algebra.EssFiniteType F L := hL
  infer_instance

end Algebra.FormallySmooth
