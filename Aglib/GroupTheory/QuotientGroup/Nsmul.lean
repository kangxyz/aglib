module

public import Mathlib.Data.ZMod.QuotientGroup
public import Mathlib.Algebra.Exact.Basic

/-!
# Quotients by multiples and surjections with divisible kernel

A homomorphism induces the native quotient map modulo `n`. Identity, composition and commuting
squares are preserved. A surjection whose kernel is `n`-divisible induces an isomorphism.
For a surjection to the integers this identifies the quotient with `ZMod n` through its actual
integer value. No positive-level condition or selected lift is needed.
-/

@[expose] public noncomputable section

namespace QuotientAddGroup

variable {A B C D : Type*} [AddCommGroup A] [AddCommGroup B]
  [AddCommGroup C] [AddCommGroup D]

/-- The native quotient map induced by a homomorphism, modulo `n`-multiples. -/
def nsmulMap (f : A →+ B) (n : ℕ) :
    A ⧸ (nsmulAddMonoidHom (α := A) n).range →+
      B ⧸ (nsmulAddMonoidHom (α := B) n).range :=
  map _ _ f (by
    rintro a ⟨b, rfl⟩
    exact ⟨f b, (map_nsmul f n b).symm⟩)

/-- The quotient map preserves the original representative map. -/
@[simp] theorem nsmulMap_mk (f : A →+ B) (n : ℕ) (a : A) :
    nsmulMap f n (mk a) = mk (f a) := rfl

/-- The quotient construction preserves identity homomorphisms. -/
@[simp] theorem nsmulMap_id (n : ℕ) :
    nsmulMap (AddMonoidHom.id A) n = AddMonoidHom.id _ := by
  apply AddMonoidHom.ext
  intro a
  induction a using QuotientAddGroup.induction_on with
  | H a => rfl

/-- The whole quotient map preserves composition. -/
theorem nsmulMap_comp (g : B →+ C) (f : A →+ B) (n : ℕ) :
    (nsmulMap g n).comp (nsmulMap f n) = nsmulMap (g.comp f) n := by
  apply AddMonoidHom.ext
  intro a
  induction a using QuotientAddGroup.induction_on with
  | H a => rfl

/-- A commuting square of homomorphisms descends to the actual quotient maps. -/
theorem nsmulMap_naturality (f : A →+ B) (g : C →+ D) (a : A →+ C) (b : B →+ D)
    (h : b.comp f = g.comp a) (n : ℕ) :
    (nsmulMap b n).comp (nsmulMap f n) = (nsmulMap g n).comp (nsmulMap a n) := by
  rw [nsmulMap_comp, nsmulMap_comp, h]

/-- A surjective homomorphism induces a surjection modulo `n`. -/
theorem nsmulMap_surjective (f : A →+ B) (hf : Function.Surjective f) (n : ℕ) :
    Function.Surjective (nsmulMap f n) := by
  intro b
  induction b using QuotientAddGroup.induction_on with
  | H b =>
    obtain ⟨a, rfl⟩ := hf b
    exact ⟨mk a, rfl⟩

/-- A surjection with `n`-divisible kernel is injective modulo `n`. -/
theorem nsmulMap_injective_of_surjective_of_ker (f : A →+ B)
    (hf : Function.Surjective f) (n : ℕ)
    (hker : Function.Surjective (nsmulAddMonoidHom (α := f.ker) n)) :
    Function.Injective (nsmulMap f n) := by
  intro x y h
  induction x using QuotientAddGroup.induction_on with
  | H a =>
    induction y using QuotientAddGroup.induction_on with
    | H b =>
      obtain ⟨c, hc⟩ := (QuotientAddGroup.eq_iff_sub_mem).mp h
      change n • c = f a - f b at hc
      obtain ⟨d, hd⟩ := hf c
      let e : f.ker := ⟨a - b - n • d, by
        change f (a - b - n • d) = 0
        rw [map_sub, map_sub, map_nsmul, hd, hc, sub_self]⟩
      obtain ⟨t, ht⟩ := hker e
      apply QuotientAddGroup.eq_iff_sub_mem.mpr
      refine ⟨(t : A) + d, ?_⟩
      have ht' := congrArg (fun z : f.ker => (z : A)) ht
      change n • (t : A) = a - b - n • d at ht'
      change n • ((t : A) + d) = a - b
      rw [smul_add, ht', sub_add_cancel]

/-- The equivalence is the original quotient map, with no chosen section of the surjection. -/
def nsmulEquivOfSurjectiveOfKer (f : A →+ B) (hf : Function.Surjective f) (n : ℕ)
    (hker : Function.Surjective (nsmulAddMonoidHom (α := f.ker) n)) :
    A ⧸ (nsmulAddMonoidHom (α := A) n).range ≃+
      B ⧸ (nsmulAddMonoidHom (α := B) n).range :=
  AddEquiv.ofBijective (nsmulMap f n)
    ⟨nsmulMap_injective_of_surjective_of_ker f hf n hker, nsmulMap_surjective f hf n⟩

/-- The equivalence retains the whole original quotient homomorphism. -/
theorem nsmulEquivOfSurjectiveOfKer_toAddMonoidHom
    (f : A →+ B) (hf : Function.Surjective f) (n : ℕ)
    (hker : Function.Surjective (nsmulAddMonoidHom (α := f.ker) n)) :
    (nsmulEquivOfSurjectiveOfKer f hf n hker).toAddMonoidHom = nsmulMap f n := rfl

/-- Integer `n`-multiples are the native cyclic subgroup generated by `n`. -/
theorem int_nsmul_range (n : ℕ) :
    (nsmulAddMonoidHom (α := ℤ) n).range = AddSubgroup.zmultiples (n : ℤ) := by
  ext a
  rw [AddMonoidHom.mem_range, Int.mem_zmultiples_iff]
  constructor
  · rintro ⟨b, hb⟩
    refine ⟨b, ?_⟩
    simpa only [nsmulAddMonoidHom_apply, nsmul_eq_mul] using hb.symm
  · rintro ⟨b, hb⟩
    exact ⟨b, by simpa only [nsmulAddMonoidHom_apply, nsmul_eq_mul] using hb.symm⟩

/-- Degree modulo `n`, through the quotient of an arbitrary integer-valued surjection. -/
def nsmulEquivZMod (d : A →+ ℤ) (hd : Function.Surjective d) (n : ℕ)
    (hker : Function.Surjective (nsmulAddMonoidHom (α := d.ker) n)) :
    A ⧸ (nsmulAddMonoidHom (α := A) n).range ≃+ ZMod n :=
  (nsmulEquivOfSurjectiveOfKer d hd n hker).trans
    ((quotientAddEquivOfEq (int_nsmul_range n)).trans (Int.quotientZMultiplesNatEquivZMod n))

/-- The whole projection equation fixes the degree normalization. -/
theorem nsmulEquivZMod_comp_mk (d : A →+ ℤ) (hd : Function.Surjective d) (n : ℕ)
    (hker : Function.Surjective (nsmulAddMonoidHom (α := d.ker) n)) :
    (nsmulEquivZMod d hd n hker).toAddMonoidHom.comp
        (mk' (nsmulAddMonoidHom (α := A) n).range) = (Int.castAddHom (ZMod n)).comp d := rfl

/-- A representative maps to its integer value modulo `n`. -/
@[simp] theorem nsmulEquivZMod_mk (d : A →+ ℤ) (hd : Function.Surjective d) (n : ℕ)
    (hker : Function.Surjective (nsmulAddMonoidHom (α := d.ker) n)) (a : A) :
    nsmulEquivZMod d hd n hker (mk a) = (d a : ZMod n) := rfl

/-- The kernel of degree modulo `n` is exactly the subgroup of `n`-multiples. -/
theorem intCast_comp_ker_eq_nsmul_range (d : A →+ ℤ) (hd : Function.Surjective d) (n : ℕ)
    (hker : Function.Surjective (nsmulAddMonoidHom (α := d.ker) n)) :
    ((Int.castAddHom (ZMod n)).comp d).ker = (nsmulAddMonoidHom (α := A) n).range := by
  ext a
  change (d a : ZMod n) = 0 ↔ _
  let e := nsmulEquivZMod d hd n hker
  constructor
  · intro h
    have hx : e (mk a) = e 0 := by
      simpa only [e, nsmulEquivZMod_mk, map_zero] using h
    exact (QuotientAddGroup.eq_zero_iff a).mp (e.injective hx)
  · intro h
    have hx : (mk a : A ⧸ (nsmulAddMonoidHom (α := A) n).range) = 0 :=
      (QuotientAddGroup.eq_zero_iff a).mpr h
    have he := congrArg e hx
    simpa only [e, nsmulEquivZMod_mk, map_zero] using he

end QuotientAddGroup

namespace AddEquiv

variable {A B D : Type*} [AddCommGroup A] [AddCommGroup B] [AddCommGroup D]

/-- Transporting exactness of multiplication identifies the whole boundary kernel. -/
theorem ker_comp_eq_range_nsmul_of_exact (e : A ≃+ B) (p : B →+ B) (d : B →+ D)
    (n : ℕ) (hp : p = nsmulAddMonoidHom (α := B) n) (hd : Function.Exact p d) :
    (d.comp e.toAddMonoidHom).ker = (nsmulAddMonoidHom (α := A) n).range := by
  ext a
  change d (e a) = 0 ↔ ∃ b, n • b = a
  rw [hd]
  constructor
  · rintro ⟨b, hb⟩
    refine ⟨e.symm b, e.injective ?_⟩
    rw [map_nsmul, e.apply_symm_apply]
    simpa only [hp, nsmulAddMonoidHom_apply] using hb
  · rintro ⟨b, rfl⟩
    exact ⟨e b, by rw [hp, nsmulAddMonoidHom_apply, map_nsmul]⟩

end AddEquiv
