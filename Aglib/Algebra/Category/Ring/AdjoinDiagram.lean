module

public import Aglib.RingTheory.Localization.AdjoinMap
public import Mathlib.Algebra.Category.Ring.Basic
public import Mathlib.CategoryTheory.ConcreteCategory.EpiMono

/-! # The actual diagram of generated subalgebras

A natural map of commutative-ring diagrams and restriction-stable generator
subsets determine literal subalgebras of the original ambient rings. Their
maps restrict the original ring maps, and their inclusions detect the functor
laws and structural naturality.
-/

@[expose] public noncomputable section

open CategoryTheory

namespace CommRingCat.AdjoinDiagram

universe uC vC u

variable {C : Type uC} [Category.{vC} C] {R A : C ⥤ CommRingCat.{u}}
  (a : R ⟶ A) (s : ∀ U, Set (A.obj U))

/-- The literal subalgebra generated by the specified original elements. -/
def obj (U : C) : CommRingCat.{u} :=
  letI := (a.app U).hom.toAlgebra
  .of (Algebra.adjoin (R.obj U) (s U))

/-- The literal subalgebra inclusion into the original ambient ring. -/
def inclusion (U : C) : obj a s U ⟶ A.obj U :=
  letI := (a.app U).hom.toAlgebra
  CommRingCat.ofHom (Algebra.adjoin (R.obj U) (s U)).val.toRingHom

instance inclusion_mono (U : C) : Mono (inclusion a s U) :=
  ConcreteCategory.mono_of_injective _ (fun _ _ h => Subtype.ext h)

variable (hs : ∀ ⦃U V : C⦄ (f : U ⟶ V), ∀ x ∈ s U, A.map f x ∈ s V)

/-- Restrict the original map, using its natural square for the scalar towers. -/
def map {U V : C} (f : U ⟶ V) : obj a s U ⟶ obj a s V := by
  letI : Algebra (R.obj U) (A.obj U) := (a.app U).hom.toAlgebra
  letI : Algebra (R.obj V) (A.obj V) := (a.app V).hom.toAlgebra
  letI : Algebra (R.obj U) (R.obj V) := (R.map f).hom.toAlgebra
  letI : Algebra (A.obj U) (A.obj V) := (A.map f).hom.toAlgebra
  letI : Algebra (R.obj U) (A.obj V) := ((R.map f) ≫ a.app V).hom.toAlgebra
  haveI : IsScalarTower (R.obj U) (R.obj V) (A.obj V) :=
    IsScalarTower.of_algebraMap_eq' rfl
  haveI : IsScalarTower (R.obj U) (A.obj U) (A.obj V) :=
    IsScalarTower.of_algebraMap_eq' (by
      change ((R.map f) ≫ a.app V).hom = (a.app U ≫ A.map f).hom
      exact congrArg CommRingCat.Hom.hom (a.naturality f))
  exact CommRingCat.ofHom (Algebra.adjoinMap (R.obj U) (R.obj V) (A.obj U) (A.obj V)
    (s U) (s V) (fun x hx => Algebra.subset_adjoin (hs f x hx)))

/-- The restricted map keeps its original values after literal inclusion. -/
@[reassoc]
theorem map_inclusion {U V : C} (f : U ⟶ V) :
    map a s hs f ≫ inclusion a s V = inclusion a s U ≫ A.map f := by
  ext x
  rfl

/-- One diagram of the actual generated subalgebras. -/
def diagram : C ⥤ CommRingCat.{u} where
  obj U := obj a s U
  map f := map a s hs f
  map_id U := by
    apply (cancel_mono (inclusion a s U)).mp
    rw [map_inclusion]
    simp only [A.map_id, Category.comp_id, Category.id_comp]
  map_comp {U V W} f g := by
    apply (cancel_mono (inclusion a s W)).mp
    simp only [Category.assoc, map_inclusion, map_inclusion_assoc, A.map_comp]

/-- The original pointwise inclusions form a natural transformation. -/
def embedding : diagram a s hs ⟶ A where
  app U := inclusion a s U
  naturality {_U _V} f := map_inclusion a s hs f

/-- The original scalar map with codomain restricted to the literal adjoin. -/
def structuralApp (U : C) : R.obj U ⟶ obj a s U :=
  letI := (a.app U).hom.toAlgebra
  CommRingCat.ofHom (algebraMap (R.obj U) (Algebra.adjoin (R.obj U) (s U)))

@[reassoc]
theorem structuralApp_inclusion (U : C) :
    structuralApp a s U ≫ inclusion a s U = a.app U := by
  ext x
  rfl

/-- The original scalar maps are natural, as detected by the inclusions. -/
def structuralMap : R ⟶ diagram a s hs where
  app U := structuralApp a s U
  naturality {U V} f := by
    change R.map f ≫ structuralApp a s V = structuralApp a s U ≫ map a s hs f
    apply (cancel_mono (inclusion a s V)).mp
    calc
      (R.map f ≫ structuralApp a s V) ≫ inclusion a s V =
          R.map f ≫ (structuralApp a s V ≫ inclusion a s V) := Category.assoc ..
      _ = R.map f ≫ a.app V := by rw [structuralApp_inclusion]
      _ = a.app U ≫ A.map f := a.naturality f
      _ = (structuralApp a s U ≫ inclusion a s U) ≫ A.map f := by
        rw [structuralApp_inclusion]
      _ = structuralApp a s U ≫ (inclusion a s U ≫ A.map f) := Category.assoc ..
      _ = structuralApp a s U ≫ (map a s hs f ≫ inclusion a s V) := by
        rw [map_inclusion]
      _ = (structuralApp a s U ≫ map a s hs f) ≫ inclusion a s V :=
        (Category.assoc ..).symm

/-- The whole structural map includes to exactly the original natural map. -/
theorem structuralMap_embedding : structuralMap a s hs ≫ embedding a s hs = a := by
  apply NatTrans.ext
  funext U
  exact structuralApp_inclusion a s U

end CommRingCat.AdjoinDiagram
