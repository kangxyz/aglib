module

public import Mathlib.Algebra.Category.ModuleCat.Basic

/-! # Full scalar forgetting for rings generated by integers

Every additive morphism between modules over a ring generated by the image of
its integer cast is linear. The resulting fullness uses the literal original
additive map. This applies to all residue rings, including the integer ring.
-/

@[expose] public noncomputable section

open CategoryTheory

namespace ModuleCat

universe r w

/-- Scalar forgetting is full when every scalar is an integer cast. -/
theorem forget₂_full_of_surjective_intCast (R : Type r) [Ring R]
    (hR : Function.Surjective (fun n : ℤ => (n : R))) :
    (forget₂ (ModuleCat.{w} R) AddCommGrpCat.{w}).Full where
  map_surjective {M N} f := by
    let h : M →+ N := f.hom
    let g : M →ₗ[R] N := {
      h with
      map_smul' := fun a x => by
        obtain ⟨n, rfl⟩ := hR a
        exact map_intCast_smul h R R n x }
    exact ⟨ModuleCat.ofHom g, rfl⟩

end ModuleCat
