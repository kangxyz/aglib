module

public import Aglib.Algebra.Category.ModuleCat.KernelBaseChange

/-!
# Epimorphisms from actual scalar-extended ring kernels

The canonical scalar-extension map is surjective whenever the original kernel
maps onto generators of the actual target kernel. It does not require flatness
and does not assert that this canonical map is an isomorphism.
-/

@[expose] public noncomputable section

open CategoryTheory
open scoped ChangeOfRings

universe u

namespace ModuleCat

variable {R S R' S' : CommRingCat.{u}}

/-- The canonical extended kernel map on the original unit tensor. -/
theorem extendedKernelMap_one_tmul (φ : R ⟶ S) (φ' : R' ⟶ S')
    (b : R ⟶ R') (a : S ⟶ S') (h : φ ≫ a = b ≫ φ') (x : RingHom.ker φ.hom) :
    extendedKernelMap φ φ' b a h ((1 : R') ⊗ₜ[R,b.hom] x) =
      kernelMap φ φ' b a h x := by
  have H := ((extendRestrictScalarsAdj b.hom).homEquiv _ _).apply_symm_apply
    (kernelMap φ φ' b a h)
  exact congrArg (fun f => f x) H

/-- The original canonical extended kernel map is epi if the target kernel is
the ideal generated by the image of the original kernel. No flatness is used. -/
theorem extendedKernelMap_epi_of_ker_eq_map (φ : R ⟶ S) (φ' : R' ⟶ S')
    (b : R ⟶ R') (a : S ⟶ S') (h : φ ≫ a = b ≫ φ')
    (hker : RingHom.ker φ'.hom = (RingHom.ker φ.hom).map b.hom) :
    Epi (extendedKernelMap φ φ' b a h) := by
  let f := extendedKernelMap φ φ' b a h
  let L : Ideal R' := f.hom.range.map (RingHom.ker φ'.hom).subtype
  have hL : (RingHom.ker φ.hom).map b.hom ≤ L := by
    apply Ideal.map_le_iff_le_comap.mpr
    intro r hr
    change b.hom r ∈ f.hom.range.map (RingHom.ker φ'.hom).subtype
    refine Submodule.mem_map.mpr ⟨kernelMap φ φ' b a h ⟨r, hr⟩, ?_, rfl⟩
    refine ⟨(1 : R') ⊗ₜ[R,b.hom] (⟨r, hr⟩ : RingHom.ker φ.hom), ?_⟩
    exact extendedKernelMap_one_tmul φ φ' b a h ⟨r, hr⟩
  change Epi f
  apply (ModuleCat.epi_iff_surjective f).mpr
  intro y
  have hy : (y : R') ∈ L := hL (by rw [← hker]; exact y.property)
  obtain ⟨z, hz, hzy⟩ := Submodule.mem_map.mp hy
  obtain ⟨w, hw⟩ := hz
  exact ⟨w, hw.trans (Subtype.ext hzy)⟩

end ModuleCat
