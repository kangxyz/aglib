module

public import Mathlib.Algebra.Category.Grp.FilteredColimits
public import Mathlib.Algebra.Category.Grp.Colimits
public import Mathlib.CategoryTheory.Limits.Types.Filtered
public import Mathlib.GroupTheory.FiniteAbelian.Basic

/-! # Original abelian groups as filtered unions of generated subgroups

The diagram uses the native subgroup generated by each finite subset and its
actual inclusion. For a torsion abelian group every stage is finite. The
colimit map remains the literal original inclusion into the given group.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AddCommGrpCat

variable (A : Type u) [AddCommGroup A]

/-- The native subgroups generated by finite subsets, with their actual inclusions. -/
def finiteSubsetDiagram : Finset A ⥤ AddCommGrpCat.{u} where
  obj s := AddCommGrpCat.of (AddSubgroup.closure (s : Set A))
  map {s t} f := AddCommGrpCat.ofHom
    (AddSubgroup.inclusion (AddSubgroup.closure_mono (Finset.coe_subset.mpr (leOfHom f))))
  map_id _ := by ext x; rfl
  map_comp _ _ := by ext x; rfl

/-- The original inclusion cocone with vertex the original group. -/
def finiteSubsetCocone : Cocone (finiteSubsetDiagram A) where
  pt := AddCommGrpCat.of A
  ι.app s := AddCommGrpCat.ofHom (AddSubgroup.closure (s : Set A)).subtype
  ι.naturality _ _ _ := by ext x; rfl

/-- The original group is the filtered colimit of its actual finite-generated subgroups. -/
def finiteSubsetCoconeIsColimit : IsColimit (finiteSubsetCocone A) := by
  classical
  let : ReflectsColimitsOfShape (Finset A) (CategoryTheory.forget AddCommGrpCat.{u}) :=
    reflectsColimitsOfShape_of_reflectsIsomorphisms
  apply isColimitOfReflects (CategoryTheory.forget AddCommGrpCat.{u})
  apply Types.FilteredColimit.isColimitOf'
  · intro x
    refine ⟨{x}, ⟨x, AddSubgroup.subset_closure (Finset.mem_singleton_self x)⟩, rfl⟩
  · intro s x y h
    refine ⟨s, 𝟙 s, ?_⟩
    apply Subtype.ext
    exact h

/-- For a torsion group, every original finite-generated stage is finite. -/
theorem finite_finiteSubsetDiagram_of_isAddTorsion (hA : IsAddTorsion A) (s : Finset A) :
    Finite ((finiteSubsetDiagram A).obj s) := by
  change Finite (AddSubgroup.closure (s : Set A))
  apply AddCommGroup.finite_of_fg_isAddTorsion
  intro x
  obtain ⟨n, hn, hx⟩ := (hA x.val).exists_nsmul_eq_zero
  apply isOfFinAddOrder_iff_nsmul_eq_zero.mpr
  refine ⟨n, hn, ?_⟩
  apply Subtype.ext
  exact hx

end AddCommGrpCat
