module

public import Mathlib.CategoryTheory.Abelian.GrothendieckCategory.Basic
public import Mathlib.CategoryTheory.Subobject.HasCardinalLT

/-!
# Size-controlled lifting through an epimorphism

The first step of the small acyclic complex construction is Stacks 079J:
a quotient `N` of `M` is already covered by a subobject of `M` generated by
at most one copy of a separator for each subobject of `N`. The coproduct index
is shrunk to the Grothendieck universe, independently of the size of `M`.

This file constructs that covering subobject and transfers every strict
subobject-cardinality bound on the specified coproduct to it. It does not
assume or construct a family of small acyclic complexes or K-injective models.

## References

* [Stacks, Lemma 19.12.1](https://stacks.math.columbia.edu/tag/079J)
-/

@[expose] public noncomputable section

universe w v u

namespace CategoryTheory

open Limits Opposite

namespace Subobject

variable {C : Type u} [Category.{v} C] [Abelian C]

/-- An epimorphic quotient has no more subobjects than its source.
The cardinal universe is independent of the category universes. -/
lemma hasCardinalLT_of_epi {X Y : C} {κ : Cardinal.{w}}
    (h : HasCardinalLT (Subobject X) κ) (f : X ⟶ Y) [Epi f] :
    HasCardinalLT (Subobject Y) κ := by
  let eX := (Abelian.subobjectIsoSubobjectOp X).toEquiv
  let eY := (Abelian.subobjectIsoSubobjectOp Y).toEquiv
  exact h.of_injective (fun A ↦ eX.symm ((Subobject.map f.op).obj (eY A)))
    (eX.symm.injective.comp ((Subobject.map_obj_injective f.op).comp eY.injective))

end Subobject

namespace IsSeparator

variable {C : Type u} [Category.{v} C] [Abelian C] {G : C} (hG : IsSeparator G)

include hG

/-- A proper subobject of an epimorphic quotient misses the image of some
map from a separator into the original object. No projectivity is required. -/
lemma exists_not_factors_comp_of_epi {M N : C} (p : M ⟶ N) [Epi p]
    (A : Subobject N) (hA : A ≠ ⊤) :
    ∃ f : G ⟶ M, ¬ A.Factors (f ≫ p) := by
  by_contra! h
  have hp : p ≫ cokernel.π A.arrow = 0 := by
    apply hG.def _ 0
    intro f
    rw [comp_zero, ← Category.assoc,
      ← A.factorThru_arrow (f ≫ p) (h f), Category.assoc, cokernel.condition,
      comp_zero]
  have hz : cokernel.π A.arrow = 0 := by
    apply (cancel_epi p).1
    simpa using hp
  have : Epi A.arrow := Abelian.epi_of_cokernel_π_eq_zero _ hz
  exact hA ((Subobject.isIso_arrow_iff_eq_top A).1 (isIso_of_mono_of_epi A.arrow))

end IsSeparator

namespace IsGrothendieckAbelian

variable {C : Type u} [Category.{v} C] [Abelian C] [IsGrothendieckAbelian.{w} C]
  {G : C} (hG : IsSeparator G) {M N : C}

include hG

/-- An epimorphism can be covered by a coproduct of copies of a separator,
indexed by the subobjects of its target rather than by morphisms into its source. -/
lemma exists_epi_comp_from_subobject_coproduct (p : M ⟶ N) [Epi p] :
    ∃ a : (∐ fun _ : Shrink.{w} (Subobject N) ↦ G) ⟶ M, Epi (a ≫ p) := by
  classical
  let e := equivShrink.{w} (Subobject N)
  have h : ∀ A : Subobject N, ∃ f : G ⟶ M, A ≠ ⊤ → ¬ A.Factors (f ≫ p) := by
    intro A
    by_cases hA : A = ⊤
    · exact ⟨0, fun hn ↦ (hn hA).elim⟩
    · obtain ⟨f, hf⟩ := hG.exists_not_factors_comp_of_epi p A hA
      exact ⟨f, fun _ ↦ hf⟩
  choose f hf using h
  let a : (∐ fun _ : Shrink.{w} (Subobject N) ↦ G) ⟶ M :=
    Sigma.desc (fun i ↦ f (e.symm i))
  refine ⟨a, ?_⟩
  have htop : imageSubobject (a ≫ p) = ⊤ := by
    by_contra hn
    apply hf (imageSubobject (a ≫ p)) hn
    have hh := imageSubobject_factors_comp_self (a ≫ p)
      (Sigma.ι (fun _ : Shrink.{w} (Subobject N) ↦ G) (e (imageSubobject (a ≫ p))))
    simpa [a] using hh
  have : IsIso (imageSubobject (a ≫ p)).arrow :=
    (Subobject.isIso_arrow_iff_eq_top _).2 htop
  have hh : Epi (factorThruImageSubobject (a ≫ p) ≫ (imageSubobject (a ≫ p)).arrow) :=
    inferInstance
  simpa using hh

/-- The size-controlled lifting subobject: the size bound depends only on
`N`, the chosen separator, and the Grothendieck universe, not on `M`.
The bound measures the cardinality of the native type of subobjects. -/
lemma exists_subobject_epi_of_subobject_coproduct_bound (p : M ⟶ N) [Epi p]
    {κ : Cardinal.{w}}
    (hκ : HasCardinalLT
      (Subobject (∐ fun _ : Shrink.{w} (Subobject N) ↦ G)) κ) :
    ∃ A : Subobject M, Epi (A.arrow ≫ p) ∧ HasCardinalLT (Subobject (A : C)) κ := by
  obtain ⟨a, ha⟩ := exists_epi_comp_from_subobject_coproduct hG p
  have := ha
  refine ⟨imageSubobject a, ?_, ?_⟩
  · have hh : Epi (factorThruImageSubobject a ≫ (imageSubobject a).arrow ≫ p) := by
      simpa using ha
    have := hh
    exact epi_of_epi (factorThruImageSubobject a) ((imageSubobject a).arrow ≫ p)
  · exact Subobject.hasCardinalLT_of_epi hκ (factorThruImageSubobject a)

end IsGrothendieckAbelian

end CategoryTheory
