module

public import Aglib.Algebra.Homology.Koszul.Basic

/-!
# Degree zero and augmentation of finite Koszul complexes

The degree-zero term of the recursively constructed finite Koszul complex is
canonically isomorphic to the ring. Its actual quotient augmentation is always
exact at degree zero and induces an isomorphism there. The quotient is defined
by the range of the constructed differential; identifying the transported range
with the ideal generated by the input list is a separate comparison theorem.
No positive-degree exactness for an arbitrary list is asserted here.
-/

@[expose] public section

universe u

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory

namespace ChainComplex.Koszul

variable {R : Type u} [CommRing R]

/-- Projection from degree zero of a tensor complex onto its only summand. -/
noncomputable def tensorZeroDesc (K L : ChainComplex (ModuleCat R) ℕ) :
    (HomologicalComplex.tensorObj K L).X 0 ⟶ K.X 0 ⊗ L.X 0 :=
  HomologicalComplex.mapBifunctorDesc (fun i j h => eqToHom (by
    change i + j = 0 at h
    have hi : i = 0 := by omega
    have hj : j = 0 := by omega
    subst i j
    rfl))

/-- Nonnegative tensor complexes have just one degree-zero tensor summand. -/
noncomputable def tensorZeroIso (K L : ChainComplex (ModuleCat R) ℕ) :
    (HomologicalComplex.tensorObj K L).X 0 ≅ K.X 0 ⊗ L.X 0 where
  hom := tensorZeroDesc K L
  inv := HomologicalComplex.ιTensorObj K L 0 0 0 rfl
  hom_inv_id := by
    apply HomologicalComplex.mapBifunctor.hom_ext
    intro i j h
    change i + j = 0 at h
    have hi : i = 0 := by omega
    have hj : j = 0 := by omega
    subst i j
    simp [tensorZeroDesc]
  inv_hom_id := by simp [tensorZeroDesc]

/-- The actual degree-zero term is canonically the coefficient ring. -/
noncomputable def zeroComponentIso : (s : List R) → (chainComplex s).X 0 ≅ ModuleCat.of R R
  | [] => HomologicalComplex.singleObjXSelf (ComplexShape.down ℕ) 0 (𝟙_ (ModuleCat R))
  | a :: s => tensorZeroIso (singleComplex R a) (chainComplex s) ≪≫
      tensorIso (Iso.refl (ModuleCat.of R R)) (zeroComponentIso s) ≪≫
        (λ_ (ModuleCat.of R R))

/-- The literal quotient of degree zero by the image of the genuine differential. -/
abbrev HomologyZeroQuotient (s : List R) :=
  (chainComplex s).X 0 ⧸ LinearMap.range ((chainComplex s).d 1 0).hom

/-- Categorical homology agrees with the literal differential-range quotient. -/
noncomputable def homologyZeroIso (s : List R) :
    (chainComplex s).homology 0 ≅ ModuleCat.of R (HomologyZeroQuotient s) :=
  (chainComplex s).isoHomologyι₀ ≪≫
    (chainComplex s).opcyclesIsoSc' 1 0 0 (by simp) (by simp) ≪≫
    ((chainComplex s).sc' 1 0 0).moduleCatOpcyclesIso

/-- The quotient projection in degree zero. -/
noncomputable def augmentationMap (s : List R) :
    (chainComplex s).X 0 ⟶ ModuleCat.of R (HomologyZeroQuotient s) :=
  ModuleCat.ofHom (LinearMap.range ((chainComplex s).d 1 0).hom).mkQ

@[reassoc]
theorem d_augmentationMap (s : List R) :
    (chainComplex s).d 1 0 ≫ augmentationMap s = 0 :=
  ModuleCat.hom_ext
    (LinearMap.exact_map_mkQ_range ((chainComplex s).d 1 0).hom).linearMap_comp_eq_zero

/-- The actual quotient augmentation of the finite tensor Koszul complex. -/
noncomputable def augmentation (s : List R) :
    chainComplex s ⟶ (ChainComplex.single₀ (ModuleCat R)).obj
      (ModuleCat.of R (HomologyZeroQuotient s)) :=
  (ChainComplex.toSingle₀Equiv _ _).symm ⟨augmentationMap s, d_augmentationMap s⟩

@[simp]
theorem augmentation_f_zero (s : List R) : (augmentation s).f 0 = augmentationMap s :=
  ChainComplex.toSingle₀Equiv_symm_apply_f_zero _ _

/-- The augmented sequence is exact at degree zero, for every list. -/
theorem augmentation_exact (s : List R) :
    (ShortComplex.mk ((chainComplex s).d 1 0) (augmentationMap s)
      (d_augmentationMap s)).Exact := by
  rw [ShortComplex.ShortExact.moduleCat_exact_iff_function_exact]
  exact LinearMap.exact_map_mkQ_range ((chainComplex s).d 1 0).hom

instance augmentationMap_epi (s : List R) : Epi (augmentationMap s) :=
  (ModuleCat.epi_iff_surjective _).mpr (Submodule.mkQ_surjective _)

/-- This actual augmentation always induces an isomorphism on degree-zero homology. -/
theorem augmentation_quasiIsoAt_zero (s : List R) : QuasiIsoAt (augmentation s) 0 := by
  rw [ChainComplex.quasiIsoAt₀_iff, ShortComplex.quasiIso_iff_of_zeros']
  · exact ⟨augmentation_exact s, augmentationMap_epi s⟩
  · exact (chainComplex s).shape _ _ (by simp)
  · rfl
  · rfl

end ChainComplex.Koszul
