module

public import Aglib.Algebra.Homology.Koszul.Coefficient.Regular
public import Aglib.Algebra.Homology.Koszul.Single.Tensor.Quotient
public import Aglib.Algebra.Homology.Koszul.Ideal

/-!
# The genuine finite Koszul resolution of a regular sequence

Positive-degree exactness is proved by induction on a weakly regular sequence
on the coefficient module. The actual one-element tensor augmentation gives a
quasi-isomorphism to the literal scalar quotient complex, explicitly identified
with the Koszul complex on quotient coefficients. For ring coefficients, this
proves the actual ideal quotient augmentation is a quasi-isomorphism. Together
with the already constructed projective terms, it gives a projective resolution
of the genuine quotient by the ideal generated by the finite list.
-/

@[expose] public section

universe u

open CategoryTheory

namespace ChainComplex.Koszul

variable {R : Type u} [CommRing R]

/-- Weak regularity proves positive-degree exactness of the actual coefficient complex. -/
theorem coefficient_exactAt_succ_of_weaklyRegular (M : ModuleCat R) (s : List R)
    (hs : RingTheory.Sequence.IsWeaklyRegular M s) (n : ℕ) :
    (coefficientComplex M s).ExactAt (n + 1) := by
  induction s generalizing M with
  | nil => exact ChainComplex.exactAt_succ_single_obj M n
  | cons a s ih =>
    obtain ⟨ha, hs⟩ := (coefficient_isWeaklyRegular_cons_iff M a s).mp hs
    have := tensorAugmentation_quasiIso_of_regular a (coefficientComplex M s)
      (coefficientComplex_isSMulRegular M s a ha)
    have hq : (quotientComplex a (coefficientComplex M s)).ExactAt (n + 1) :=
      (ih ((scalarQuotientFunctor a).obj M) hs).of_iso (coefficientQuotientIso a M s).symm
    exact (exactAt_iff_of_quasiIsoAt
      (tensorAugmentation a (coefficientComplex M s)) (n + 1)).mpr hq

/-- Every positive degree of the finite ring Koszul complex is exact for a weakly regular list. -/
theorem exactAt_succ_of_weaklyRegular (s : List R)
    (hs : RingTheory.Sequence.IsWeaklyRegular R s) (n : ℕ) :
    (chainComplex s).ExactAt (n + 1) := by
  rw [← coefficientComplex_ring]
  exact coefficient_exactAt_succ_of_weaklyRegular (ModuleCat.of R R) s hs n

/-- The actual augmentation to the generated ideal quotient is a quasi-isomorphism. -/
theorem idealAugmentation_quasiIso_of_weaklyRegular (s : List R)
    (hs : RingTheory.Sequence.IsWeaklyRegular R s) : QuasiIso (idealAugmentation s) := by
  constructor
  intro n
  cases n with
  | zero => exact idealAugmentation_quasiIsoAt_zero s
  | succ n =>
    rw [quasiIsoAt_iff_exactAt' _ _ (ChainComplex.exactAt_succ_single_obj _ _)]
    exact exactAt_succ_of_weaklyRegular s hs n

/-- The constructed finite Koszul projective resolution of the genuine generated ideal quotient. -/
noncomputable def finiteProjectiveResolution (s : List R)
    (hs : RingTheory.Sequence.IsWeaklyRegular R s) :
    CategoryTheory.ProjectiveResolution (ModuleCat.of R (R ⧸ Ideal.ofList s)) where
  complex := chainComplex s
  π := idealAugmentation s
  quasiIso := idealAugmentation_quasiIso_of_weaklyRegular s hs

@[simp]
theorem finiteProjectiveResolution_complex (s : List R)
    (hs : RingTheory.Sequence.IsWeaklyRegular R s) :
    (finiteProjectiveResolution s hs).complex = chainComplex s := rfl

@[simp]
theorem finiteProjectiveResolution_π (s : List R)
    (hs : RingTheory.Sequence.IsWeaklyRegular R s) :
    (finiteProjectiveResolution s hs).π = idealAugmentation s := rfl

/-- In particular, every regular sequence has the constructed finite projective resolution. -/
noncomputable def regularProjectiveResolution (s : List R)
    (hs : RingTheory.Sequence.IsRegular R s) :
    CategoryTheory.ProjectiveResolution (ModuleCat.of R (R ⧸ Ideal.ofList s)) :=
  finiteProjectiveResolution s hs.toIsWeaklyRegular

end ChainComplex.Koszul
