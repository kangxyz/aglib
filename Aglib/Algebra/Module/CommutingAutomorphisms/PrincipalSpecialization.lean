open LaurentSupport
universe u
variable {R S : Type u} [CommRing R] [CommRing S] [Algebra R S]
/-- The actual Laurent coefficient map is surjective when the structural ring map is.

Supporting helper for the module's explicit original principal-face/local-coefficient
source mapping. -/
theorem laurentCoefficient_surjective (h : Function.Surjective (algebraMap R S)) :
    Function.Surjective (coefficientMap (algebraMap R S)) :=
  MonoidAlgebra.map_surjective (algebraMap R S).toAddMonoidHom h

/-- A principal coefficient kernel is the literal principal Laurent kernel. This is
coefficientwise and uses no flatness premise.

Source mapping: supporting local construction for
`K2-018#prop:k2018-arithmetic-characters`, source snapshot
`e73d98b1b5c1e5abcdebf7d058e436d792b87982`.
Encoded Grayson subset: the actual Laurent coefficient kernel is generated by the image
of t when ker(R -> S) = (t); no surjectivity or regularity is needed here. -/
theorem laurentCoefficient_ker_principal (t : R)
    (ht : RingHom.ker (algebraMap R S) = Ideal.span ({t} : Set R)) :
    RingHom.ker (coefficientMap (algebraMap R S)) =
      Ideal.span ({algebraMap R (Laurent R) t} : Set (Laurent R)) := by
  classical
  ext a
  constructor
  · intro ha
    have hz : ∀ m : Character, algebraMap R S (a.coeff m) = 0 := by
      intro m
      have hm := congrArg (fun b : Laurent S => b.coeff m) (RingHom.mem_ker.mp ha)
      simpa [coefficientMap] using hm
    have hd : ∀ m : Character, ∃ c : R, a.coeff m = t * c := by
      intro m
      exact Ideal.mem_span_singleton.mp (ht ▸ RingHom.mem_ker.mpr (hz m))
    let c : Character → R := fun m => if a.coeff m = 0 then 0 else Classical.choose (hd m)
    have hc : ∀ m, a.coeff m = t * c m := by
      intro m
      by_cases hm : a.coeff m = 0
      · simp [c, hm]
      · simpa [c, hm] using Classical.choose_spec (hd m)
    let b : Laurent R := MonoidAlgebra.ofCoeff (Finsupp.onFinset a.coeff.support c (by
      intro m hm
      rw [Finsupp.mem_support_iff]
      intro hz
      exact hm (by simp [c, hz])))
    rw [Ideal.mem_span_singleton]
    refine ⟨b, ?_⟩
    rw [← Algebra.smul_def]
    ext m
    simpa [b, MonoidAlgebra.coeff_smul, Finsupp.onFinset_apply] using hc m
  · rw [Ideal.mem_span_singleton]
    rintro ⟨b, rfl⟩
    apply RingHom.mem_ker.mpr
    have hz : algebraMap R S t = 0 :=
      RingHom.mem_ker.mp (ht.symm ▸ Ideal.subset_span (Set.mem_singleton t))
    simp [coefficientMap, map_mul, hz]

/-- Cokernel identification with the ORIGINAL scalar-extended object, linear for the full
source Laurent action. No regularity or length formula is a premise of this equivalence.

Source mapping: supporting local construction for
`K2-018#prop:k2018-arithmetic-characters`, source snapshot
`e73d98b1b5c1e5abcdebf7d058e436d792b87982`.
Encoded Grayson subset: surjective R -> S with kernel (t) identifies the original
principal quotient with X.baseChange S, preserving the full restricted Laurent R action. -/
def principalOriginalCokernelEquiv (X : Object R) (t : R)
    (h : Function.Surjective (algebraMap R S))
    (ht : RingHom.ker (algebraMap R S) = Ideal.span ({t} : Set R)) :
    letI : Module (Laurent R) (Realization (X.baseChange S)) :=
      Module.compHom _ (coefficientMap (algebraMap R S))
    (Realization X ⧸ LinearMap.range (originalScalarEnd X t)) ≃ₗ[Laurent R]
      Realization (X.baseChange S) := by
  letI : Module (Laurent R) (Realization (X.baseChange S)) :=
    Module.compHom _ (coefficientMap (algebraMap R S))
  letI : IsScalarTower (Laurent R) (Laurent S) (Realization (X.baseChange S)) :=
    IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  exact (Module.tensorSpecializationCokernelEquiv
    (B := Laurent S) (Realization X) (algebraMap R (Laurent R) t)
    (laurentCoefficient_surjective h) (laurentCoefficient_ker_principal t ht)).trans
      ((scalarLaurentModuleEquiv (S := S) X).restrictScalars (Laurent R))

/-- Cokernel of an endomorphism, with ring and group structures fixed before specializing to
a concrete localization.

Supporting helper for the module's explicit original principal-face/local-coefficient
source mapping. -/
abbrev EndCokernel {C V : Type*} [CommRing C] [AddCommGroup V] [Module C V]
    (f : V →ₗ[C] V) := V ⧸ LinearMap.range f

/-- The principal cokernel of the actual scalar action after Laurent localization.

Source mapping: supporting local construction for
`K2-018#prop:k2018-arithmetic-characters`, source snapshot
`e73d98b1b5c1e5abcdebf7d058e436d792b87982`.
Encoded local subset: the literal cokernel of the original scalar action at any prime Q
of Laurent R; no principal-map, regularity or finiteness premise is used in this
definition. -/
abbrev LocalPrincipalCokernel (X : Object R) (t : R)
    (Q : Ideal (Laurent R)) [Q.IsPrime] :=
  EndCokernel (C := Localization.AtPrime Q) (V := LocalRealization X Q)
    (localizedOriginalScalarEnd X t Q)

/-- Localization of the actual principal quotient is its literal local scalar cokernel. This
is constructed before asserting a coefficient identity.

Source mapping: supporting local construction for
`K2-018#prop:k2018-arithmetic-characters`, source snapshot
`e73d98b1b5c1e5abcdebf7d058e436d792b87982`.
Encoded local subset: at any source prime Q, the actual localized scalar quotient equals
localization of the original principal quotient, without principal-map or regularity
premises. -/
def localPrincipalCokernelEquiv (X : Object R) (t : R)
    (Q : Ideal (Laurent R)) [Q.IsPrime] :
    LocalPrincipalCokernel X t Q ≃ₗ[Localization.AtPrime Q]
      Localization.AtPrime Q ⊗[Laurent R]
        (Realization X ⧸ LinearMap.range (originalScalarEnd X t)) := by
  have hscalar : localizedOriginalScalarEnd X t Q =
      LinearMap.lsmul (Localization.AtPrime Q) (LocalRealization X Q)
        (algebraMap (Laurent R) (Localization.AtPrime Q)
          (algebraMap R (Laurent R) t)) := by
    apply LinearMap.ext
    intro z
    rw [localizedOriginalScalarEnd_apply]
    simp only [LinearMap.lsmul_apply]
    rw [← IsScalarTower.algebraMap_apply R (Laurent R) (Localization.AtPrime Q)]
  exact (Submodule.quotEquivOfEq (R := Localization.AtPrime Q)
    (M := LocalRealization X Q) _ _ (congrArg LinearMap.range hscalar)).trans
    (Module.principalCokernelBaseChangeEquiv
      (Realization X) (Localization.AtPrime Q) (algebraMap R (Laurent R) t)).symm

/-- Tensoring the original quotient isomorphism at Q identifies the literal local scalar
cokernel with the source-localized original face module.

Source mapping: supporting local construction for
`K2-018#prop:k2018-arithmetic-characters`, source snapshot
`e73d98b1b5c1e5abcdebf7d058e436d792b87982`.
Encoded local subset: at any source prime Q, surjective R -> S with kernel (t) gives the
source-localized original target-module equivalence. -/
def localizedPrincipalOriginalCokernelEquiv (X : Object R) (t : R)
    (h : Function.Surjective (algebraMap R S))
    (ht : RingHom.ker (algebraMap R S) = Ideal.span ({t} : Set R))
    (Q : Ideal (Laurent R)) [Q.IsPrime] :
    letI : Module (Laurent R) (Realization (X.baseChange S)) :=
      Module.compHom _ (coefficientMap (algebraMap R S))
    LocalPrincipalCokernel X t Q ≃ₗ[Localization.AtPrime Q]
      Localization.AtPrime Q ⊗[Laurent R] Realization (X.baseChange S) := by
  letI : Module (Laurent R) (Realization (X.baseChange S)) :=
    Module.compHom _ (coefficientMap (algebraMap R S))
  letI : IsScalarTower (Laurent R) (Laurent S) (Realization (X.baseChange S)) :=
    IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  exact (localPrincipalCokernelEquiv X t Q).trans
    ((principalOriginalCokernelEquiv (S := S) X t h ht).baseChange
      (Laurent R) (Localization.AtPrime Q) _ _)

/-- The actual local face coefficient is the local scalar-cokernel length. This theorem
assumes the literal surjective principal coefficient map, and neither the weighted cycle
equality nor an annihilator base-change equality.

Source mapping: supporting local construction for
`K2-018#prop:k2018-arithmetic-characters`, source snapshot
`e73d98b1b5c1e5abcdebf7d058e436d792b87982`.
Encoded local subset: for the actual surjective principal map and every target prime q,
the target ENat length equals the local scalar-cokernel length at Q = g^{-1}(q); no
finite-length premise is assumed. -/
theorem ambientLength_principal_baseChange (X : Object R) (t : R)
    (h : Function.Surjective (algebraMap R S))
    (ht : RingHom.ker (algebraMap R S) = Ideal.span ({t} : Set R))
    (q : Ideal (Laurent S)) [q.IsPrime] :
    ambientLength (X.baseChange S) q =
      Module.length (Localization.AtPrime (q.under (Laurent R)))
        (LocalPrincipalCokernel X t (q.under (Laurent R))) := by
  let : Module (Laurent R) (Realization (X.baseChange S)) :=
    Module.compHom _ (coefficientMap (algebraMap R S))
  let : IsScalarTower (Laurent R) (Laurent S) (Realization (X.baseChange S)) :=
    IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  let Q := q.under (Laurent R)
  let e := localizedPrincipalOriginalCokernelEquiv (S := S) X t h ht Q
  rw [LinearEquiv.length_eq (R := Localization.AtPrime Q)
    (M := LocalPrincipalCokernel X t Q)
    (N := Localization.AtPrime Q ⊗[Laurent R] Realization (X.baseChange S)) e]
  exact (length_localization_of_surjective (Realization (X.baseChange S))
    (laurentCoefficient_surjective h) q).symm

/-- The literal local endomorphism is multiplication by the localized scalar.

Supporting helper for the module's explicit original principal-face/local-coefficient
source mapping. -/
theorem localizedOriginalScalarEnd_eq_lsmul (X : Object R) (t : R)
    (Q : Ideal (Laurent R)) [Q.IsPrime] :
    localizedOriginalScalarEnd X t Q =
      LinearMap.lsmul (Localization.AtPrime Q) (LocalRealization X Q)
        (algebraMap R (Localization.AtPrime Q) t) := by
  apply LinearMap.ext
  exact localizedOriginalScalarEnd_apply X t Q
/-- The literal local scalar cokernel agrees with the quotient defined using scalar
multiplication at any source prime.

Supporting helper for the module's explicit original principal-face/local-coefficient
source mapping. -/
def localPrincipalCokernelScalarEquiv (X : Object R) (t : R)
    (Q : Ideal (Laurent R)) [Q.IsPrime] :
    LocalPrincipalCokernel X t Q ≃ₗ[Localization.AtPrime Q]
      EndCokernel (C := Localization.AtPrime Q) (V := LocalRealization X Q)
        (LinearMap.lsmul (Localization.AtPrime Q) (LocalRealization X Q)
          (algebraMap R (Localization.AtPrime Q) t)) :=
  Submodule.quotEquivOfEq (R := Localization.AtPrime Q) (M := LocalRealization X Q)
    _ _ (congrArg LinearMap.range (localizedOriginalScalarEnd_eq_lsmul X t Q))

/-- Regularity of the original base scalar kills the actual localized kernel. The hypothesis
concerns t in R, with no regularity premise on a point quotient.

Source mapping: supporting local construction for
`K2-018#prop:k2018-arithmetic-characters`, source snapshot
`e73d98b1b5c1e5abcdebf7d058e436d792b87982`.
Encoded regularity subset: IsRegular t in R gives zero scalar kernel on the localized
original realization at every source prime Q; no point-quotient regularity is assumed. -/
theorem localizedOriginalScalarEnd_ker_eq_bot (X : Object R) (t : R)
    (hr : IsRegular t) (Q : Ideal (Laurent R)) [Q.IsPrime] :
    LinearMap.ker (localizedOriginalScalarEnd X t Q) = ⊥ := by
  ext z
  simp only [LinearMap.mem_ker, Submodule.mem_bot]
  constructor
  · intro hz
    exact localizedOriginalScalarEnd_injective X t hr Q
      (hz.trans (map_zero (localizedOriginalScalarEnd X t Q)).symm)
  · rintro rfl
    exact map_zero _

/-- Regularity gives the integer cast of the target ENat coefficient length's toNat. At an
arbitrary prime this is a cast identity; finite-length interpretation uses the separate
finiteness conditions below.

Source mapping: supporting local construction for
`K2-018#prop:k2018-arithmetic-characters`, source snapshot
`e73d98b1b5c1e5abcdebf7d058e436d792b87982`.
Encoded Euler subset: the actual surjective principal map and IsRegular t in R give the
integer cast of the target ENat length's toNat at every q. The supplied finite-length corollary uses
S Noetherian and q minimal over the actual target support. -/
theorem principalEuler_local_original_baseChange (X : Object R) (t : R)
    (h : Function.Surjective (algebraMap R S))
    (ht : RingHom.ker (algebraMap R S) = Ideal.span ({t} : Set R))
    (hr : IsRegular t) (q : Ideal (Laurent S)) [q.IsPrime] :
    _root_.Module.principalEuler
      (A := Localization.AtPrime (q.under (Laurent R)))
      (N := LocalRealization X (q.under (Laurent R)))
      (algebraMap R (Localization.AtPrime (q.under (Laurent R))) t) =
        ((ambientLength (X.baseChange S) q).toNat : ℤ) := by
  let Q := q.under (Laurent R)
  have hp := _root_.Module.principalEuler_of_regular
    (A := Localization.AtPrime Q) (N := LocalRealization X Q)
    (algebraMap R (Localization.AtPrime Q) t) (localOriginalScalar_regular X t hr Q)
  have hl := Module.endCokernel_length_congr
    (A := Localization.AtPrime Q) (N := LocalRealization X Q)
    (localizedOriginalScalarEnd X t Q)
    (LinearMap.lsmul (Localization.AtPrime Q) (LocalRealization X Q)
      (algebraMap R (Localization.AtPrime Q) t))
    (localizedOriginalScalarEnd_eq_lsmul X t Q)
  have he := hl.symm.trans (ambientLength_principal_baseChange X t h ht q).symm
  exact hp.trans (congrArg (fun a : ℕ∞ => (a.toNat : ℤ)) he)

/-- At every actual minimal target component the local scalar cokernel has finite length. No
prime-filtration or cycle-comparison formula is a premise.

Source mapping: supporting local construction for
`K2-018#prop:k2018-arithmetic-characters`, source snapshot
`e73d98b1b5c1e5abcdebf7d058e436d792b87982`.
Encoded finite subset: for the actual surjective principal map, S Noetherian and q
minimal over supportIdeal(X.baseChange S) give finite local cokernel length; no
IsRegular t or Noetherian R premise is used. -/
theorem localPrincipalCokernel_length_ne_top [IsNoetherianRing S]
    (X : Object R) (t : R) (h : Function.Surjective (algebraMap R S))
    (ht : RingHom.ker (algebraMap R S) = Ideal.span ({t} : Set R))
    (q : Ideal (Laurent S)) [q.IsPrime]
    (hq : q ∈ (supportIdeal (X.baseChange S)).minimalPrimes) :
    Module.length (Localization.AtPrime (q.under (Laurent R)))
      (LocalPrincipalCokernel X t (q.under (Laurent R))) ≠ ⊤ := by
  rw [← ambientLength_principal_baseChange X t h ht q]
  exact ambientLength_ne_top (X.baseChange S) q hq

end Module.CommutingAutomorphisms
